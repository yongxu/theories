-- Standalone, Init only. Restates the repository's definitions (Weightings.lean:420-436, 718, 771, 1204).
namespace Sketch
variable {X : Type}
def IncludesOn (items : List X) (a b : X → Bool) : Prop := ∀ x, x ∈ items → b x = true → a x = true
def ExceedsOn (items : List X) (a b : X → Bool) : Prop := ∃ x, x ∈ items ∧ a x = true ∧ b x = false
def WidensOn (items : List X) (a b : X → Bool) : Prop := IncludesOn items a b ∧ ExceedsOn items a b
def WidensBy (items : List X) (x : X) (a b : X → Bool) : Prop :=
  IncludesOn items a b ∧ x ∈ items ∧ a x = true ∧ b x = false ∧
    ∀ y, y ∈ items → a y = true → b y = false → y = x
def IncreasingAt (items : List X) (O : (X → Bool) → (X → Bool) → Prop) (x : X) : Prop :=
  ∀ a b, WidensBy items x a b → O b a ∧ ¬ O a b
def Increasing (items : List X) (R : (X → Bool) → (X → Bool) → Prop) : Prop :=
  ∀ a b, WidensOn items a b → R b a

theorem exceeds_or_not (items : List X) (a b : X → Bool) :
    ExceedsOn items a b ∨ ∀ x, x ∈ items → a x = true → b x = true := by
  induction items with
  | nil => exact .inr fun _ h => nomatch h
  | cons y ys ih =>
    cases ha : a y <;> cases hb : b y
    · exact ih.elim (fun ⟨x, m, h1, h2⟩ => .inl ⟨x, .tail _ m, h1, h2⟩)
        (fun h => .inr fun x m hx => by
          cases m with
          | head => exact absurd (ha.symm.trans hx) (by decide)
          | tail _ m => exact h x m hx)
    · exact ih.elim (fun ⟨x, m, h1, h2⟩ => .inl ⟨x, .tail _ m, h1, h2⟩)
        (fun h => .inr fun x m hx => by
          cases m with
          | head => exact hb
          | tail _ m => exact h x m hx)
    · exact .inl ⟨y, .head _, ha, hb⟩
    · exact ih.elim (fun ⟨x, m, h1, h2⟩ => .inl ⟨x, .tail _ m, h1, h2⟩)
        (fun h => .inr fun x m hx => by
          cases m with
          | head => exact hb
          | tail _ m => exact h x m hx)

/-- Single-item increase at every listed item, with transitivity, gives increase at every
widening: the Pareto order is generated by its one-item steps. -/
theorem increasing_of_increasingAt [DecidableEq X] {items : List X}
    {O : (X → Bool) → (X → Bool) → Prop}
    (trans : ∀ {a b c}, O a b → O b c → O a c)
    (at_ : ∀ x, x ∈ items → IncreasingAt items O x) : Increasing items O := by
  intro a b w
  -- every extra item lies in `items`
  suffices key : ∀ (S : List X) (a : X → Bool), WidensOn items a b →
      (∀ y, y ∈ items → a y = true → b y = false → y ∈ S) → O b a from
    key items a w (fun y m _ _ => m)
  intro S
  induction S with
  | nil => intro a ⟨_, x, m, h1, h2⟩ sub; exact nomatch sub x m h1 h2
  | cons x S ih =>
    intro a ⟨inc, ex⟩ sub
    by_cases hx : x ∈ items ∧ a x = true ∧ b x = false
    · have xmem := hx.1
      have hx := hx.2
      let a' : X → Bool := fun y => if y = x then false else a y
      have inc' : IncludesOn items a' b := fun y m hb => by
        by_cases e : y = x
        · subst e; exact absurd (hx.2.symm.trans hb) (by decide)
        · simp only [a', e, ite_false]; exact inc y m hb
      have sub' : ∀ y, y ∈ items → a' y = true → b y = false → y ∈ S := fun y m ha hb => by
        by_cases e : y = x
        · simp [a', e] at ha
        · have h' : a y = true := by simpa [a', e] using ha
          cases sub y m h' hb with
          | head => exact absurd rfl e
          | tail _ t => exact t
      have top : WidensBy items x a a' :=
        ⟨fun y m h => by
            by_cases e : y = x
            · subst e; exact hx.1
            · simpa [a', e] using h,
         xmem, hx.1, by simp [a'],
         fun y m ha hb => by
            by_cases e : y = x
            · exact e
            · simp [a', e] at hb; exact absurd ha (by simp [hb])⟩
      cases exceeds_or_not items a' b with
      | inl ex' => exact trans (ih a' ⟨inc', ex'⟩ sub') ((at_ x xmem a a' top).1)
      | inr same =>
        have direct : WidensBy items x a b :=
          ⟨inc, xmem, hx.1, hx.2, fun y m ha hb => by
            by_cases e : y = x
            · exact e
            · have : a' y = true := by simpa [a', e] using ha
              exact absurd (same y m this) (by simp [hb])⟩
        exact (at_ x xmem a b direct).1
    · exact ih a ⟨inc, ex⟩ fun y m ha hb => by
        cases sub y m ha hb with
        | head => exact absurd ⟨m, ha, hb⟩ hx
        | tail _ t => exact t
end Sketch

#print axioms Sketch.increasing_of_increasingAt
