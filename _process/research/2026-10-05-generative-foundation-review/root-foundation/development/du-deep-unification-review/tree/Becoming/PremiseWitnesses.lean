import Becoming.GrammarScope
import Becoming.Extension

/-!
# Premises met and failed: the condition on the root, C and L

Board item DU. The ethics asserts no premise; each premise it names is a hypothesis of proved
conditionals. This module gives three of them what the premise card asks of every premise:
a model meeting it and one failing it, so that none is left as an unshown claim. It adds the one
law about widening that the review of C found to have content.

* **The condition on the root is decided by the net, not by the grammar.** On any carrier with
  an occurrence apart from a center, the full net (every occurrence a condition of every one)
  meets `«续无外»` and `«族无外»` at every center, and the empty net fails both
  (`«续无外由网定»`, `«族无外由网定»`). Both are statements about a net, its class and its
  centers, contingent as every such statement is; `«续无外则中心无缘»` already refutes the first
  along any acyclic net whose center has a condition.
* **C is not settled by a frame.** On any frame with an extension, reading better as extension
  meets C and reading nothing as better fails it (`Comparison.contingent`); so no statement whose
  truth does not change with the order entails C on such a frame (`ReadsNoOrder.not_entails`,
  the pattern of `ReadsOnlyDynamics.not_entails` for the condition). Immediate, since `Better` is
  free: it shows only that the root fixes no order.
* **L, lifting, is met and failed.** On a frame of two moves each leading to its own state, one
  move's outcome is better than the other's and not the reverse (`LiftWitness.contingent`).
* **Widening on a listing is generated by widening by one item.** With equality of items decided
  (a modelling assumption, stated), `a` widens `b` on the listed items exactly when a chain of
  widenings each by one listed item alone leads from `b` up to `a`
  (`Weighting.widensOn_iff_reach`); so an order transitive on courses ranks every widening above
  what it widens exactly when it so ranks every widening by one item
  (`Weighting.increasing_iff_by_one`). What C asks of a transitive order is asked item by item.

No definition of an earlier module changes. A leaf: its laws are witnesses and one law of
widening; the last moves below, beside `«广»`, at `Becoming.Weightings`' next change.
-/

namespace Becoming

open Generative

universe u

section Root

variable {Pos : Type} {α : Type u}

/-- The full net meets the condition on the root, along the net, at every center. -/
theorem «全网则续无外» (center : Pos → α) : «续无外» «一» «一» center :=
  fun _ _ => .inr (.one ⟨trivial, trivial⟩)

/-- In the empty net a line reaches only where it starts. -/
theorem «空网所及则同» {E : «际» α} {x y : α} (h : «所及» («非» «一») E x y) : x = y :=
  match h with
  | .inl same => same
  | .inr (.one c) => (c.1 trivial).elim
  | .inr (.more c _) => (c.1 trivial).elim

/-- The empty net fails the condition on the root wherever an occurrence lies apart from a center. -/
theorem «空网则续有外» {E : «际» α} {center : Pos → α} {p : Pos} {x : α}
    (apart : x ≠ center p) : ¬ «续无外» («非» «一») E center :=
  fun none => apart («空网所及则同» (none p x)).symm

/-- **The condition on the root, along the net, is decided by the net (续无外由网定).** Where an
occurrence lies apart from a center, the full net meets it and the empty net fails it. -/
theorem «续无外由网定» (center : Pos → α) {p : Pos} {x : α} (apart : x ≠ center p) :
    «续无外» «一» «一» center ∧ ¬ «续无外» («非» «一») «一» center :=
  ⟨«全网则续无外» center, «空网则续有外» apart⟩

/-- The full net meets the condition on the root, in families, at every center. -/
theorem «全网则族无外» (center : Pos → α) : «族无外» «一» «一» center :=
  fun _ _ => .step ⟨trivial, trivial⟩

/-- In the empty net a family holds only its one occurrence. -/
theorem «空网同族则同» {E : «际» α} {x y : α} (h : «同族» («非» «一») E x y) : x = y := by
  induction h with
  | refl _ => rfl
  | step c => exact (c.1 trivial).elim
  | symm _ ih => exact ih.symm
  | trans _ _ ih ih' => exact ih.trans ih'

/-- The empty net fails the condition in families wherever an occurrence lies apart from a center. -/
theorem «空网则族有外» {E : «际» α} {center : Pos → α} {p : Pos} {x : α}
    (apart : x ≠ center p) : ¬ «族无外» («非» «一») E center :=
  fun none => apart («空网同族则同» (none p x)).symm

/-- **The condition on the root, in families, is decided by the net (族无外由网定).** -/
theorem «族无外由网定» (center : Pos → α) {p : Pos} {x : α} (apart : x ≠ center p) :
    «族无外» «一» «一» center ∧ ¬ «族无外» («非» «一») «一» center :=
  ⟨«全网则族无外» center, «空网则族有外» apart⟩

end Root

section Frames

variable {S A C : Type}

/-- **C is not settled by a frame.** On a frame with an extension, reading better as extension
meets C, and reading nothing as better fails it. -/
theorem Comparison.contingent {F : Frame S A C} {living : C → Prop} {s t : S}
    (extension : Extension F living s t) :
    Comparison F living (Extension F living) ∧ ¬ Comparison F living (fun _ _ => False) :=
  ⟨fun _ _ extends_ => extends_, fun comparison => comparison s t extension⟩

/-- A statement about some data and an order on configurations reads no order when its truth
does not change with the order. -/
def ReadsNoOrder {D : Type} (law : D → (S → S → Prop) → Prop) : Prop :=
  ∀ d better better', law d better → law d better'

/-- **No statement reading no order entails C.** Where the frame a datum gives has an extension,
a statement reading no order that entails C there holds of that datum with no order. -/
theorem ReadsNoOrder.not_entails {D : Type} {law : D → (S → S → Prop) → Prop}
    (reads : ReadsNoOrder law) {frame : D → Frame S A C} {living : D → C → Prop}
    (entails : ∀ d better, law d better → Comparison (frame d) (living d) better)
    {d : D} {s t : S} (extension : Extension (frame d) (living d) s t)
    {better : S → S → Prop} : ¬ law d better :=
  fun holds => entails d _ (reads d better (fun _ _ => False) holds) s t extension

end Frames

namespace LiftWitness

/-- Two moves, each leading to its own state; no claim is realized. -/
def frame : Frame Bool Bool Unit := ⟨⟨fun _ move next => next = move⟩, fun _ _ => False⟩

/-- `true` is better than `false`, and nothing else is better. -/
def better : Bool → Bool → Prop := fun x y => x = true ∧ y = false

/-- The move to `true` is lifted above the move to `false`. -/
theorem meets (s : Bool) : LiftBetter frame better s true false :=
  fun _ reached _ reached' => ⟨reached, reached'⟩

/-- The move to `false` is not lifted above the move to `true`. -/
theorem fails (s : Bool) : ¬ LiftBetter frame better s false true :=
  fun lifted => Bool.noConfusion (lifted false rfl true rfl).1

/-- **L is met and failed** on one frame, by its two moves. -/
theorem contingent (s : Bool) :
    LiftBetter frame better s true false ∧ ¬ LiftBetter frame better s false true :=
  ⟨meets s, fails s⟩

end LiftWitness

namespace Weighting

variable {X : Type}

/-- One widening by one listed item alone: `a` widens `b` by some `x` alone. -/
def WidensByOne (items : List X) : «际» (X → Bool) := fun a b => ∃ x, WidensBy items x a b

/-- A chain extended by one step at its end. -/
theorem reach_snoc {β : Type} {R : «际» β} {x y : β} (chain : «及» R x y) :
    ∀ {z}, R y z → «及» R x z := by
  induction chain with
  | one r => exact fun s => .more r (.one s)
  | more r _ ih => exact fun s => .more r (ih s)

theorem or_true_right {p q : Bool} (h : q = true) : (p || q) = true := by
  cases p <;> cases q <;> first | rfl | exact Bool.noConfusion h

theorem or_true_left {p q : Bool} (h : p = true) : (p || q) = true := by
  cases p <;> cases q <;> first | rfl | exact Bool.noConfusion h

theorem or_true_cases {p q : Bool} (h : (p || q) = true) : p = true ∨ q = true := by
  cases p <;> cases q <;> first | exact .inl rfl | exact .inr rfl | exact Bool.noConfusion h

theorem or_false_left {p q : Bool} (h : (p || q) = false) : p = false := by
  cases p <;> cases q <;> first | rfl | exact Bool.noConfusion h

theorem or_false_right {p q : Bool} (h : (p || q) = false) : q = false := by
  cases p <;> cases q <;> first | rfl | exact Bool.noConfusion h

section Chains

variable [DecidableEq X]

/-- Where every item `a` admits beyond `b` is listed in `L`, a sublist of the items, either `b`
admits every listed item `a` admits or a chain of widenings by one item leads from `b` to `a`. -/
theorem reach_of_beyond {items : List X} {a : X → Bool} :
    ∀ (L : List X), (∀ z, z ∈ L → z ∈ items) → ∀ b, IncludesOn items a b →
      (∀ y, y ∈ items → a y = true → b y = false → y ∈ L) →
      IncludesOn items b a ∨ «及» (WidensByOne items) a b
  | [], _, b, _, beyond => .inl fun y listed admits => by
      cases held : b y with
      | true => rfl
      | false => exact nomatch beyond y listed admits held
  | z :: rest, sub, b, includes, beyond => by
      have sub' : ∀ w, w ∈ rest → w ∈ items := fun w mem => sub w (.tail z mem)
      cases ha : a z with
      | false =>
        refine reach_of_beyond rest sub' b includes fun y listed admits absent => ?_
        cases beyond y listed admits absent with
        | head => exact Bool.noConfusion (ha.symm.trans admits)
        | tail _ mem => exact mem
      | true =>
        cases hb : b z with
        | true =>
          refine reach_of_beyond rest sub' b includes fun y listed admits absent => ?_
          cases beyond y listed admits absent with
          | head => exact Bool.noConfusion (hb.symm.trans absent)
          | tail _ mem => exact mem
        | false =>
          let b' : X → Bool := fun y => b y || decide (y = z)
          have includes' : IncludesOn items a b' := fun y listed held =>
            match or_true_cases held with
            | .inl old => includes y listed old
            | .inr new => (of_decide_eq_true new).symm ▸ ha
          have beyond' : ∀ y, y ∈ items → a y = true → b' y = false → y ∈ rest := by
            intro y listed admits absent
            cases beyond y listed admits (or_false_left absent) with
            | head =>
              exact Bool.noConfusion ((or_false_right absent).symm.trans (decide_eq_true rfl))
            | tail _ mem => exact mem
          have last : WidensBy items z b' b :=
            ⟨fun _ _ held => or_true_left held, sub z (.head rest),
              or_true_right (decide_eq_true rfl), hb,
              fun y _ held absent => match or_true_cases held with
                | .inl old => Bool.noConfusion (old.symm.trans absent)
                | .inr new => of_decide_eq_true new⟩
          match reach_of_beyond rest sub' b' includes' beyond' with
          | .inl back =>
            exact .inr (.one ⟨z, includes, sub z (.head rest), ha, hb,
              fun y listed admits absent => match or_true_cases (back y listed admits) with
                | .inl old => Bool.noConfusion (old.symm.trans absent)
                | .inr new => of_decide_eq_true new⟩)
          | .inr chain => exact .inr (reach_snoc chain ⟨z, last⟩)

/-- **Widening on a listing is generated by widening by one item.** With equality of items
decided, `a` widens `b` on the listed items exactly when a chain of widenings, each by one listed
item alone, leads from `b` up to `a`. -/
theorem widensOn_iff_reach {items : List X} {a b : X → Bool} :
    WidensOn items a b ↔ «及» (WidensByOne items) a b :=
  ⟨fun widens =>
    match reach_of_beyond items (fun _ listed => listed) b widens.1
        (fun y listed _ _ => listed) with
    | .inl back => match widens.2 with
      | ⟨x, listed, admits, absent⟩ => Bool.noConfusion ((back x listed admits).symm.trans absent)
    | .inr chain => chain,
   fun chain => by
    induction chain with
    | one step => exact match step with | ⟨_, by_⟩ => widensOn_of_widensBy by_
    | more step _ ih => exact match step with | ⟨_, by_⟩ => (widensOn_of_widensBy by_).trans ih⟩

/-- **What C asks of a transitive order is asked item by item.** An order transitive on courses
ranks every widening above what it widens exactly when it ranks every widening by one listed
item above what it widens. -/
theorem increasing_iff_by_one {items : List X} {O : (X → Bool) → (X → Bool) → Prop}
    (transitive : ∀ {a b c}, O a b → O b c → O a c) :
    Increasing items O ↔ ∀ x a b, WidensBy items x a b → O b a :=
  ⟨fun increasing _ a b by_ => increasing a b (widensOn_of_widensBy by_),
   fun byOne a b widens => by
    have chain := widensOn_iff_reach.mp widens
    clear widens
    induction chain with
    | one step => exact match step with | ⟨x, by_⟩ => byOne x _ _ by_
    | more step _ ih => exact match step with | ⟨x, by_⟩ => transitive ih (byOne x _ _ by_)⟩

end Chains

end Weighting

end Becoming
