import Becoming.GrammarCases
import Becoming.Lifting

/-!
# Premises met and failed: the condition on the root, C and L

Board item DU. The ethics asserts no premise; each premise it names is a hypothesis of proved
conditionals. This module completes, for three of them, what the premise card asks: a model
meeting it and one failing it, or a theorem that no statement of a stated kind entails it. Most
of the models already exist; this module states the pairs. It adds one law of widening.

* **The condition on the root varies with the net.** At the one, the endless line of descent meets
  `«续无外»` at its first birth (`LineOfDescent.Endless.descent_no_outside`), and two family lines
  with no condition between them fail it at the first family's first birth
  (`TwoLines.other_center_outside`): `«续无外随网»`. In families, the line of descent meets
  `«族无外»` and a third thing apart from two joined families fails it (`«族无外随网»`). So no law
  holding of every net settles either; on one net they vary with the class as well
  (`LineOfDescent.Endless.member_outside`).
* **No statement reading no order, and holding at a datum with an extension, entails C**
  (`ReadsNoOrder.not_entails`), the pattern of `ReadsOnlyDynamics.not_entails` for the condition,
  with the order in the place of the significance. Immediate, since "better" is free: it shows that
  a frame fixes no order.
* **L, lifting, is met and failed on `LiftModel`'s frame**: the move reaching 3 is lifted above the
  move reaching 1, and not the reverse (`LiftModel.met_and_failed`). That the choice of the rule is
  substantive is `LiftModel.some_outcome_does_not_lift`.
* **Widening on a listing is generated by widening by one item.** With equality of items decided
  (a modelling assumption, stated), `a` widens `b` on the listed items exactly when a chain of
  widenings, each by one listed item alone, leads from `b` up to `a`
  (`Weighting.widensOn_iff_reach`). So an order transitive on courses is increasing in admission
  exactly when it ranks every widening by one item above what it widens
  (`Weighting.increasing_iff_by_one`). Read on a web's level paths, where an extension is a
  widening (`Web.paths_extension_iff_widens`), this is what C asks of a transitive order, asked
  item by item.

No definition of an earlier module changes. A leaf: its witnesses belong beside the models they
use, and its laws of widening in `Becoming.Weightings`, after `Weighting.widensOn_of_widensBy`
and `Weighting.widens_iff_every_increasing`, where they move at that module's next change.
-/

namespace Becoming

open Generative

namespace TwoLines

/-- **Two family lines with no condition between them fail the condition on the root at the one**:
the first family's first birth reaches no member of the other family. -/
theorem other_center_outside :
    ¬ «续无外» step «一» (fun (_ : Unit) => ((true, 0, false) : Occ)) :=
  fun none => other_line_outside (none () (false, 0, false))

end TwoLines

namespace ThirdThing

/-- **A third thing apart from two joined families fails the condition in families at the one**:
the first family's first member is not joined to it. -/
theorem first_member_outside : ¬ «族无外» step «一» (fun (_ : Unit) => Occ.a 0) :=
  fun none => fixed_class.2.2.1 (none () (.s 0))

end ThirdThing

/-- **The condition on the root, along the net, varies with the net (续无外随网).** At the one, the
endless line of descent meets it at its first birth, and two family lines with no condition between
them fail it at the first family's first birth. -/
theorem «续无外随网» :
    «续无外» LineOfDescent.Endless.step «一» (fun (_ : Unit) => ((0, false) : LineOfDescent.Endless.Occ)) ∧
      ¬ «续无外» TwoLines.step «一» (fun (_ : Unit) => ((true, 0, false) : TwoLines.Occ)) :=
  ⟨LineOfDescent.Endless.descent_no_outside, TwoLines.other_center_outside⟩

/-- **The condition on the root, in families, varies with the net (族无外随网).** -/
theorem «族无外随网» :
    «族无外» LineOfDescent.Endless.step «一» (fun (_ : Unit) => ((0, false) : LineOfDescent.Endless.Occ)) ∧
      ¬ «族无外» ThirdThing.step «一» (fun (_ : Unit) => ThirdThing.Occ.a 0) :=
  ⟨«续无外则族无外» LineOfDescent.Endless.descent_no_outside, ThirdThing.first_member_outside⟩

section Frames

variable {S A C : Type}

/-- A statement about some data and an order on configurations reads no order when its truth does
not change with the order: `ReadsOnlyDynamics`' pattern, with the order in the place of the
significance. -/
def ReadsNoOrder {D : Type} (law : D → (S → S → Prop) → Prop) : Prop :=
  ∀ d better better', law d better → law d better'

/-- **No statement reading no order, and holding at a datum with an extension, entails C.** Where
the frame a datum gives has an extension, a statement reading no order that entails C there fails at
that datum for every order. -/
theorem ReadsNoOrder.not_entails {D : Type} {law : D → (S → S → Prop) → Prop}
    (reads : ReadsNoOrder law) {frame : D → Frame S A C} {living : D → C → Prop}
    (entails : ∀ d better, law d better → Comparison (frame d) (living d) better)
    {d : D} {s t : S} (extension : Extension (frame d) (living d) s t)
    {better : S → S → Prop} : ¬ law d better :=
  fun holds => entails d _ (reads d better (fun _ _ => False) holds) s t extension

end Frames

namespace LiftModel

/-- **L is met and failed**: from configuration 0, the move reaching 3 is lifted above the move
reaching 1 by the larger configuration, and the move reaching 1 is not lifted above it. -/
theorem met_and_failed :
    LiftBetter frame larger 0 .high .low ∧ ¬ LiftBetter frame larger 0 .low .high :=
  ⟨fun _ high _ low => match high, low with
    | ⟨_, h⟩, ⟨_, l⟩ => h ▸ l ▸ Nat.lt_trans (Nat.lt_succ_self 1) (Nat.lt_succ_self 2),
   lift_needs_live_middle.2.2⟩

end LiftModel

namespace Weighting

variable {X : Type}

/-- One widening by one listed item alone: `a` widens `b` by some `x` alone. -/
def WidensByOne (items : List X) : «际» (X → Bool) := fun a b => ∃ x, WidensBy items x a b

section Chains

variable [DecidableEq X]

/-- Where `a` admits every listed item `b` admits, and every listed item `a` admits beyond `b` is in
`L`, whose members are listed, either `b` admits every listed item `a` admits or a chain of
widenings by one item leads from `b` up to `a`. -/
theorem reach_of_beyond {items : List X} {a : X → Bool} :
    ∀ (L : List X), (∀ z, z ∈ L → z ∈ items) → ∀ b, IncludesOn items a b →
      (∀ y, y ∈ items → a y = true → b y = false → y ∈ L) →
      IncludesOn items b a ∨ «及» (WidensByOne items) a b
  | [], _, b, _, beyond => .inl fun y listed admits => by
      cases held : b y with
      | true => rfl
      | false => exact nomatch beyond y listed admits held
  | z :: rest, sub, b, includes, beyond => by
      have sub' : ∀ w, w ∈ rest → w ∈ items := fun w mem => sub w (.tail z mem)
      cases ha : a z with
      | false =>
        refine reach_of_beyond rest sub' b includes fun y listed admits absent => ?_
        cases beyond y listed admits absent with
        | head => exact Bool.noConfusion (ha.symm.trans admits)
        | tail _ mem => exact mem
      | true =>
        cases hb : b z with
        | true =>
          refine reach_of_beyond rest sub' b includes fun y listed admits absent => ?_
          cases beyond y listed admits absent with
          | head => exact Bool.noConfusion (hb.symm.trans absent)
          | tail _ mem => exact mem
        | false =>
          let b' : X → Bool := fun y => b y || decide (y = z)
          have includes' : IncludesOn items a b' := fun y listed held =>
            match ListTests.or_true_iff.mp held with
            | .inl old => includes y listed old
            | .inr new => (of_decide_eq_true new).symm ▸ ha
          have beyond' : ∀ y, y ∈ items → a y = true → b' y = false → y ∈ rest := by
            intro y listed admits absent
            have old : b y = false := match hy : b y with
              | false => rfl
              | true => Bool.noConfusion
                  ((ListTests.or_true_iff.mpr (.inl hy)).symm.trans absent)
            cases beyond y listed admits old with
            | head =>
              exact Bool.noConfusion
                (absent.symm.trans (ListTests.or_true_iff.mpr (.inr (decide_eq_true rfl))))
            | tail _ mem => exact mem
          have last : WidensBy items z b' b :=
            ⟨fun _ _ held => ListTests.or_true_iff.mpr (.inl held), sub z (.head rest),
              ListTests.or_true_iff.mpr (.inr (decide_eq_true rfl)), hb,
              fun y _ held absent => match ListTests.or_true_iff.mp held with
                | .inl old => Bool.noConfusion (old.symm.trans absent)
                | .inr new => of_decide_eq_true new⟩
          match reach_of_beyond rest sub' b' includes' beyond' with
          | .inl back =>
            exact .inr (.one ⟨z, includes, sub z (.head rest), ha, hb,
              fun y listed admits absent => match ListTests.or_true_iff.mp (back y listed admits) with
                | .inl old => Bool.noConfusion (old.symm.trans absent)
                | .inr new => of_decide_eq_true new⟩)
          | .inr chain => exact .inr («及之传递» chain (.one ⟨z, last⟩))

/-- **Widening on a listing is generated by widening by one item.** With equality of items
decided, `a` widens `b` on the listed items exactly when a chain of widenings, each by one listed
item alone, leads from `b` up to `a`. -/
theorem widensOn_iff_reach {items : List X} {a b : X → Bool} :
    WidensOn items a b ↔ «及» (WidensByOne items) a b :=
  ⟨fun widens =>
    match reach_of_beyond items (fun _ listed => listed) b widens.1
        (fun _ listed _ _ => listed) with
    | .inl back => match widens.2 with
      | ⟨x, listed, admits, absent⟩ => Bool.noConfusion ((back x listed admits).symm.trans absent)
    | .inr chain => chain,
   fun chain => by
    induction chain with
    | one step => exact match step with | ⟨_, by_⟩ => widensOn_of_widensBy by_
    | more step _ ih => exact match step with | ⟨_, by_⟩ => (widensOn_of_widensBy by_).trans ih⟩

/-- **Being increasing in admission is asked item by item of a transitive order.** An order
transitive on courses ranks every widening above what it widens exactly when it ranks every
widening by one listed item above what it widens. -/
theorem increasing_iff_by_one {items : List X} {O : (X → Bool) → (X → Bool) → Prop}
    (transitive : ∀ {a b c}, O a b → O b c → O a c) :
    Increasing items O ↔ ∀ x a b, WidensBy items x a b → O b a :=
  ⟨fun increasing _ a b by_ => increasing a b (widensOn_of_widensBy by_),
   fun byOne a b widens => by
    have chain := widensOn_iff_reach.mp widens
    clear widens
    induction chain with
    | one step => exact match step with | ⟨x, by_⟩ => byOne x _ _ by_
    | more step _ ih => exact match step with | ⟨x, by_⟩ => transitive ih (byOne x _ _ by_)⟩

end Chains

end Weighting

end Becoming
