/-
A read-only audit of the compiled package, by the compiled terms and not by the words: statements
proved twice, definitions given twice, wrappers, binders a proof does not use, projections and private
declarations nothing reads, and declarations with no docstring. Run with LEAN_PATH at the package's
compiled modules: `lean --run EnvAudit.lean OUTDIR`. Periphery tool, imports Lean's own library.
-/
import Lean
open Lean Meta

namespace EnvAudit

def isThm : ConstantInfo → Bool
  | .thmInfo _ => true
  | _ => false

def foundation : List Name := [`GenerativeCore, `InquirySufficiency, `RelationalRenewal]

def moduleOf (env : Environment) (n : Name) : Option Name :=
  (env.getModuleIdxFor? n).map fun i => env.header.moduleNames[i.toNat]!

def inScope (env : Environment) (n : Name) : Bool :=
  match moduleOf env n with
  | some m => (`Becoming).isPrefixOf m || foundation.contains m
  | none => false

/-- Generated by Lean, not written. -/
def generated (env : Environment) (n : Name) : Bool :=
  let u := privateToUserName n
  u.isInternal || u.hasNum ||
  isMatcherCore env n || isAuxRecursor env n ||
  isCasesOnRecursor env n ||
  (match u with
   | .str _ s =>
     s.startsWith "match_" || s.startsWith "proof_" || s.startsWith "eq_" || s == "sizeOf_spec" ||
     s == "inj" || s == "injEq" || s == "toCtorIdx" || s == "ctorIdx" || s == "ofNat" || s == "ctorElim" ||
     s == "ctorElimType" || s == "noConfusionType" || s == "noConfusion" || s == "rec" || s == "recOn" || s == "casesOn" ||
     s.startsWith "instDecidableEq" || s == "brecOn" || s == "below" || s == "binductionOn" || s == "ibelow" ||
     s == "mk" || s.endsWith "_iff" && false
   | _ => false)

def canon (c : ConstantInfo) (e : Expr) : Expr :=
  let us := c.levelParams.zipIdx.map fun (_, i) => mkLevelParam (.num `u i)
  e.instantiateLevelParams c.levelParams us

partial def peelLam (e : Expr) (acc : Array (Name × BinderInfo × Expr) := #[]) :
    Array (Name × BinderInfo × Expr) × Expr :=
  match e with
  | .lam n t b bi => peelLam b (acc.push (n, bi, t))
  | .mdata _ b => peelLam b acc
  | _ => (acc, e)

partial def peelPi (e : Expr) (acc : Array (Name × BinderInfo × Expr) := #[]) :
    Array (Name × BinderInfo × Expr) × Expr :=
  match e with
  | .forallE n t b bi => peelPi b (acc.push (n, bi, t))
  | .mdata _ b => peelPi b acc
  | _ => (acc, e)

/-- The value is a constant applied to its own binders, in order: a wrapper. -/
def wrapped (value : Expr) : Option Name :=
  let (bs, body) := peelLam value
  let f := body.getAppFn
  let args := body.getAppArgs
  match f with
  | .const target _ =>
    let n := bs.size
    let vars := args.filter (fun a => a.isBVar)
    if args.size == vars.size && (args.zipIdx.all fun (a, i) => a.isBVar && a.bvarIdx! == n - 1 - i) && n == args.size
    then some target else none
  | _ => none

def tsv (xs : List String) : String := "\t".intercalate xs ++ "\n"

def shown (n : Name) : String := (privateToUserName n).toString (escape := false)

def isPriv (n : Name) : Bool := (privateToUserName? n).isSome

/-- Which of a declaration's binders nothing after them uses. -/
def unusedBinders (c : ConstantInfo) (value : Expr) :
    Array (Nat × Name × BinderInfo × Bool × Bool) :=
  Id.run do
    let (lams, body) := peelLam value
    let (pis, concl) := peelPi c.type
    let n := lams.size
    let mut out := #[]
    for i in [0:n] do
      let inValue := (Id.run do
        let mut used := body.hasLooseBVar (n - 1 - i)
        for j in [i+1:n] do
          if (lams[j]!.2.2).hasLooseBVar (j - 1 - i) then used := true
        return used)
      if !inValue then
        -- Does the statement use it, past this binder?
        let m := pis.size
        let inStatement := if i < m then (Id.run do
          let mut used := concl.hasLooseBVar (m - 1 - i)
          for j in [i+1:m] do
            if (pis[j]!.2.2).hasLooseBVar (j - 1 - i) then used := true
          return used) else true
        out := out.push (i, lams[i]!.1, lams[i]!.2.1, inStatement, true)
    return out

def binderKind : BinderInfo → String
  | .default => "explicit" | .implicit => "implicit" | .strictImplicit => "strict"
  | .instImplicit => "inst"

/-- Whether binder `i`'s type is a proposition. -/
def binderIsProp (value : Expr) (i : Nat) : MetaM Bool :=
  lambdaBoundedTelescope value (i + 1) fun xs _ => do
    if h : i < xs.size then
      isProp (← inferType xs[i]) else return false

structure Refs where
  used : NameSet := {}

def collect (env : Environment) : Array (Name × ConstantInfo) × NameSet :=
  Id.run do
    let mut items := #[]
    let mut refs : NameSet := {}
    for (n, c) in env.constants.toList do
      if inScope env n then
        items := items.push (n, c)
        for r in c.type.getUsedConstants do refs := refs.insert r
        if let some v := c.value? (allowOpaque := true) then
          for r in v.getUsedConstants do refs := refs.insert r
    return (items, refs)

def run (out : System.FilePath) : MetaM Unit := do
  let env ← getEnv
  let (items, refs) := collect env
  IO.println s!"constants in scope: {items.size}"
  let written := items.filter fun (n, _) => !generated env n
  IO.println s!"written: {written.size}"
  -- All names, for checking what the documents cite.
  IO.FS.writeFile (out / "names.tsv") <| String.join <| (written.toList.map fun (n, c) =>
    let kind := match c with
      | .thmInfo _ => "theorem" | .defnInfo _ => "def" | .inductInfo _ => "inductive"
      | .ctorInfo _ => "ctor" | .opaqueInfo _ => "opaque" | .axiomInfo _ => "axiom" | _ => "other"
    tsv [shown n, kind, toString (moduleOf env n |>.getD .anonymous), toString (isPriv n)])
  -- 1. The same statement twice.
  let mut byType : Std.HashMap Expr (Array Name) := {}
  for (n, c) in written do
    if (isThm c) then
      let key := canon c c.type
      byType := byType.insert key ((byType.getD key #[]).push n)
  let groups := byType.toList.filter (fun (_, ns) => ns.size > 1)
  IO.FS.writeFile (out / "dup_statements.tsv") <| String.join <| groups.map fun (_, ns) =>
    tsv (ns.toList.map fun n => s!"{shown n} [{moduleOf env n |>.getD .anonymous}]")
  IO.println s!"statements proved more than once: {groups.length} groups"
  -- 2. The same definition twice.
  let mut byDef : Std.HashMap (Expr × Expr) (Array Name) := {}
  for (n, c) in written do
    if let .defnInfo d := c then
      let key := (canon c c.type, canon c d.value)
      byDef := byDef.insert key ((byDef.getD key #[]).push n)
  let dg := byDef.toList.filter (fun (_, ns) => ns.size > 1)
  IO.FS.writeFile (out / "dup_defs.tsv") <| String.join <| dg.map fun (_, ns) =>
    tsv (ns.toList.map fun n => s!"{shown n} [{moduleOf env n |>.getD .anonymous}]")
  IO.println s!"definitions given more than once: {dg.length} groups"
  -- 2b. Definitions alike in their value with the type left out (same body, any carrier).
  let mut byBody : Std.HashMap Expr (Array Name) := {}
  for (n, c) in written do
    if let .defnInfo d := c then
      if d.value.approxDepth > 3 then
        let key := canon c d.value
        byBody := byBody.insert key ((byBody.getD key #[]).push n)
  let bg := byBody.toList.filter (fun (_, ns) => ns.size > 1)
  IO.FS.writeFile (out / "same_bodies.tsv") <| String.join <| bg.map fun (_, ns) =>
    tsv (ns.toList.map fun n => s!"{shown n} [{moduleOf env n |>.getD .anonymous}]")
  -- 3. Parallel structures: one constructor, the same fields.
  let mut byCtor : Std.HashMap Expr (Array Name) := {}
  for (n, c) in written do
    if let .inductInfo i := c then
      if let [ctor] := i.ctors then
        if let some (.ctorInfo k) := env.find? ctor then
          let (pis, _) := peelPi k.type
          if pis.size > i.numParams then
            let key := pis.foldr (fun (bn, bi, t) acc => .forallE bn t acc bi) (mkConst `Result)
            let key := canon c key
            byCtor := byCtor.insert key ((byCtor.getD key #[]).push n)
  let sg := byCtor.toList.filter (fun (_, ns) => ns.size > 1)
  IO.FS.writeFile (out / "same_structures.tsv") <| String.join <| sg.map fun (_, ns) =>
    tsv (ns.toList.map fun n => s!"{shown n} [{moduleOf env n |>.getD .anonymous}]")
  IO.println s!"structures with the same fields: {sg.length} groups"
  -- 4. Wrappers.
  let mut wrappers := ""
  for (n, c) in written do
    if let some v := c.value? (allowOpaque := true) then
      if let some target := wrapped v then
        if !generated env target then
          let same := match env.find? target with
            | some t => canon c c.type == canon t t.type
            | none => false
          let kind := if (isThm c) then "theorem" else "def"
          wrappers := wrappers ++ tsv [shown n, kind, shown target, toString same,
            toString (moduleOf env n |>.getD .anonymous), toString (moduleOf env target |>.getD .anonymous)]
  IO.FS.writeFile (out / "wrappers.tsv") wrappers
  -- 5. Binders nothing uses.
  let mut unused := ""
  let mut count := 0
  for (n, c) in written do
    if let some v := c.value? (allowOpaque := true) then
      for (i, name, bi, inStatement, _) in unusedBinders c v do
        if inStatement then continue
        let p ← try binderIsProp v i catch _ => pure false
        count := count + 1
        let kind := if (isThm c) then "theorem" else "def"
        unused := unused ++ tsv [shown n, kind, toString i, name.toString (escape := false), binderKind bi,
          toString p, toString (moduleOf env n |>.getD .anonymous)]
  IO.FS.writeFile (out / "unused_binders.tsv") unused
  IO.println s!"binders nothing uses: {count}"
  -- 6. Nothing reads it.
  let mut dead := ""
  for (n, c) in written do
    if !refs.contains n then
      let isProj := (env.isProjectionFn n)
      let kind := match c with
        | .thmInfo _ => "theorem" | .defnInfo _ => if isProj then "projection" else "def"
        | .inductInfo _ => "inductive" | .ctorInfo _ => "ctor" | _ => "other"
      if kind == "ctor" then continue
      dead := dead ++ tsv [shown n, kind, toString (isPriv n), toString (moduleOf env n |>.getD .anonymous)]
  IO.FS.writeFile (out / "unreferenced.tsv") dead
  -- 7. No docstring.
  let mut nodoc := ""
  for (n, c) in written do
    let wanted := match c with | .thmInfo _ | .defnInfo _ | .inductInfo _ => true | _ => false
    if wanted && !(env.isProjectionFn n) && !isPriv n then
      if (← findDocString? env n).isNone then
        let kind := if (isThm c) then "theorem" else if c.isInductive then "inductive" else "def"
        nodoc := nodoc ++ tsv [shown n, kind, toString (moduleOf env n |>.getD .anonymous)]
  IO.FS.writeFile (out / "no_docstring.tsv") nodoc
  -- 8. A statement whose conclusion is one of its hypotheses, or `True`, up to unfolding.
  let mut trivial := ""
  for (n, c) in written do
    if (isThm c) then
      try
        let line? ← withTheReader Core.Context (fun k => { k with maxHeartbeats := 400000 }) do
          forallTelescope c.type fun xs concl => do
            if concl.isConstOf ``True then return some "conclusion True"
            for x in xs do
              let t ← inferType x
              if (← isProp t) then
                if ← withReducibleAndInstances (isDefEq t concl) then
                  return some "conclusion is a hypothesis (reducible)"
            match concl.getAppFn, concl.getAppArgs with
            | .const ``Iff _, #[a, b] =>
              if ← withReducibleAndInstances (isDefEq a b) then return some "iff of the same (reducible)"
              if ← (isDefEq a b) then return some "iff of the same (by unfolding)"
            | .const ``Eq _, #[_, a, b] =>
              if ← withReducibleAndInstances (isDefEq a b) then return some "eq of the same (reducible)"
            | _, _ => pure ()
            return none
        if let some why := line? then
          trivial := trivial ++ tsv [shown n, why, toString (moduleOf env n |>.getD .anonymous)]
      catch _ => pure ()
  IO.FS.writeFile (out / "trivial.tsv") trivial
  -- 9. Modules nothing imports but the root.
  let mut importers : Std.HashMap Name Nat := {}
  for m in env.header.moduleData, name in env.header.moduleNames do
    if name != `Becoming then
      for imp in m.imports do
        importers := importers.insert imp.module ((importers.getD imp.module 0) + 1)
  let leaves := env.header.moduleNames.filter fun m =>
    (`Becoming).isPrefixOf m && m != `Becoming && (importers.getD m 0) == 0
  IO.FS.writeFile (out / "leaf_modules.tsv") <| String.join <| leaves.toList.map fun m => tsv [toString m]
  IO.println s!"leaf modules: {leaves.size}"

end EnvAudit

unsafe def main (args : List String) : IO UInt32 := do
  let out : System.FilePath := (args.headD "out")
  IO.FS.createDirAll out
  initSearchPath (← findSysroot)
  let env ← importModules #[{ module := `Becoming }] {} 0
  let core : Core.Context := { fileName := "<audit>", fileMap := default, maxHeartbeats := 0, maxRecDepth := 100000 }
  let state : Core.State := { env }
  let _ ← (EnvAudit.run out).run' {} {} |>.toIO core state
  return 0
