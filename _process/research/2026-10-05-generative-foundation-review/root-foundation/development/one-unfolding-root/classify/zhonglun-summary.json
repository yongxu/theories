 "rule_deviation": "按本次分派之明令，凡破相续、破三相（生住灭）为确立、破次第缘、破因果为确立关系之单元皆归己；其中有数单元同时含一条可作乙候选之律（如'相违不俱'ZL-01-151、ZL-07-017、ZL-07-201、ZL-07-222、ZL-21-025），按 BRIEF 之次序应归乙，此处归己并在 note 中写出所用之律。对方之说按其内容归类（定义归甲，条件之律归丙一，学说叙述归庚），note 皆标'对方'。registration 之'反读'用于龙树以对偶词（生/灭、一/异、成/坏、断/常、有为/无为）作破之偈与要句",
 "most_important": [
  {
   "id": "ZL-21-120",
   "line": "对方'生滅故不常，相續故不斷'：结构上即计划之答（细类 F 下生灭故不常，类 E 下相续故不断），而在本文中是被破之说"
  },
  {
   "id": "ZL-21-122",
   "line": "龙树之破：因灭而不复生则因断，不得相续；对计划之答的直接反驳，计划之回应（缘不需同在）列开放"
  },
  {
   "id": "ZL-21-115",
   "line": "对方之偈'因果相續故，不斷亦不常'（PLAN 已登记），内容为丙一，计划之续最近者"
  },
  {
   "id": "ZL-21-165",
   "line": "'三世中求有，相續不可得'：本品之结，相续之总破"
  },
  {
   "id": "ZL-21-170",
   "line": "青目：有有相续皆从愚痴颠倒故有，实中则无；二谛定域，且将相续归于颠倒，评价方向与计划相反"
  },
  {
   "id": "ZL-01-031",
   "line": "青目：若一则无缘，若异则无相续；中观两难，计划以相对于类之一异答，部分合"
  },
  {
   "id": "ZL-21-049",
   "line": "青目定义'不尽'为'念念生灭常相续不断'：计划之续（细类下生灭、粗类下不断）最近之古文定义，随即被归谬为'决定常住'"
  },
  {
   "id": "ZL-21-088",
   "line": "青目：从法生法若至若失皆不然；缘之同在两难最清楚之形（至则常，失则无因），正是 PLAN §一 之开放问"
  },
  {
   "id": "ZL-21-016",
   "line": "青目：成名众缘合，坏名众缘散；与金师子章成相/坏相相近，但为历时之合散"
  },
  {
   "id": "ZL-21-025",
   "line": "青目：成坏相违，云何一时有？直接反对 PLAN §一 成坏'一时之中的两读'"
  },
  {
   "id": "ZL-21-028",
   "line": "对方（分别法者）：成中常有坏，近计划；青目以'实有住'破之（ZL-21-031、032）"
  },
  {
   "id": "ZL-01-072",
   "line": "青目：若异，何故说谷芽、谷茎、谷叶？以类名'谷'贯通各阶段：计划'E 下同、F 下异'之世俗层例"
  },
  {
   "id": "ZL-02-111",
   "line": "青目：相续故名行，断故名止；行=续之进，止=续之尽，为被破者之定义"
  },
  {
   "id": "ZL-02-109",
   "line": "青目：行者，如从谷子相续至芽茎叶；续之例"
  },
  {
   "id": "ZL-07-029",
   "line": "龙树：'云何于一处，一时有三相？'（PLAN 已登记）；计划以四相无自立（乙）答，合于'一一'一支"
  },
  {
   "id": "ZL-07-017",
   "line": "青目：相违法一时则不然，如明暗不俱；全论反复所用之律"
  },
  {
   "id": "ZL-07-201",
   "line": "青目：二相相违法一时不然；与计划'孤立之事一类下生而亡'直接相违"
  },
  {
   "id": "ZL-07-051",
   "line": "龙树破生生与本生之互生；计划'缘可以互相、同时'所受最直接之破"
  },
  {
   "id": "ZL-07-066",
   "line": "龙树破同时互生（生生生时）；同上，@缘之同时"
  },
  {
   "id": "ZL-07-038",
   "line": "龙树：三相更有相则无穷；PLAN §4.6 已答不入此倒退"
  },
  {
   "id": "ZL-07-228",
   "line": "青目：无常有二，名老及死；老近计划之异，死近亡"
  },
  {
   "id": "ZL-01-127",
   "line": "龙树：因是法生果，是法名为缘（PLAN §5.2 引为相合），但其用是归谬破缘"
  },
  {
   "id": "ZL-01-132",
   "line": "青目：缘成由于果，以果后缘先故；相合，乙候选，而处破缘之论证中"
  },
  {
   "id": "ZL-01-154",
   "line": "龙树：果若未生时则不应有灭，灭法何能缘，故无次第缘；PLAN 已删等无间缘，但'灭法何能缘'及于一切跨时之缘"
  },
  {
   "id": "ZL-21-149",
   "line": "青目：初有未灭而有后有则一时二有；计划允许俱有之事，张力"
  }
 ],
 "wu_units": [
  {
   "id": "ZL-01-177",
   "line": "实法 / 随宜所说（二种说法之分）"
  },
  {
   "id": "ZL-02-129",
   "line": "人常法无常（归谬所设之人/法二分，低）"
  },
  {
   "id": "ZL-07-304",
   "line": "凡人 / 贤圣：语言同而心异（知者之分）"
  },
  {
   "id": "ZL-07-308",
   "line": "凡夫分别为有 / 智者推求不可得"
  },
  {
   "id": "ZL-21-084",
   "line": "见诸法性空者 / 凡夫（颠倒因缘得此眼）"
  }
 ],
