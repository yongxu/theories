Becoming.bounded {F Pos : Type} (region : Pos → F → Prop) : Pos → Nat → F → Prop
Becoming.Web.Retains {F C Pos : Type} (W : Becoming.Web F C) (sig : Pos → Nat → F → Prop) (p : Pos)
  (l l' : Nat → C → Nat) : Prop
Becoming.Web.Adds {F C Pos : Type} (W : Becoming.Web F C) (sig : Pos → Nat → F → Prop) (p : Pos)
  (l l' : Nat → C → Nat) : Prop
Becoming.Web.Retains.refl {F C Pos : Type} {W : Becoming.Web F C} (sig : Pos → Nat → F → Prop) (p : Pos)
  (l : Nat → C → Nat) : W.Retains sig p l l
Becoming.Web.Retains.trans {F C Pos : Type} {W : Becoming.Web F C} {sig : Pos → Nat → F → Prop} {p : Pos}
  {l l' l'' : Nat → C → Nat} (first : W.Retains sig p l l') (second : W.Retains sig p l' l'') : W.Retains sig p l l''
Becoming.Web.Retains.not_added {F C Pos : Type} {W : Becoming.Web F C} {sig : Pos → Nat → F → Prop} {p : Pos}
  {l l' : Nat → C → Nat} (retains : W.Retains sig p l l') : ¬W.Adds sig p l' l
Becoming.Web.Includes.retains {F C Pos : Type} {W : Becoming.Web F C} {l l' : Nat → C → Nat}
  (includes : W.Includes l l') (sig : Pos → Nat → F → Prop) (p : Pos) : W.Retains sig p l l'
Becoming.Web.Adds.exceeds {F C Pos : Type} {W : Becoming.Web F C} {sig : Pos → Nat → F → Prop} {p : Pos}
  {l l' : Nat → C → Nat} : W.Adds sig p l l' → W.Exceeds l l'
Becoming.Web.Retains.of_fewer {F C Pos : Type} {W : Becoming.Web F C} {sig sig' : Pos → Nat → F → Prop}
  (fewer : ∀ (p : Pos) (t : Nat) (f : F), sig' p t f → sig p t f) {p : Pos} {l l' : Nat → C → Nat}
  (retains : W.Retains sig p l l') : W.Retains sig' p l l'
Becoming.Web.retains_bounded_iff {F C Pos : Type} {W : Becoming.Web F C} {region : Pos → F → Prop} {p : Pos}
  {l l' : Nat → C → Nat} :
  W.Retains (Becoming.bounded region) p l l' ↔ ∀ (t : Nat), W.AdmitsWithin (region p) (l t) (l' t) t
Becoming.Web.exceeded_of_below {F C : Type} {W : Becoming.Web F C} {l : Nat → C → Nat} {s : Nat} {g : F} {c : C}
  (requires : W.requires s g c) (below : W.level s c < W.need s g c) (admits : W.Admits (l s) s g) : W.Exceeds l W.level
Becoming.Web.UnderminingOn.exceeded {F C : Type} {W : Becoming.Web F C} {l : Nat → C → Nat} {t : Nat} {f : F} {c : C}
  (undermining : Becoming.Web.UnderminingOn t f c)
  (holds : ∀ (g : F), W.requires t g c → W.requires (t + 1) g c ∧ W.need t g c ≤ W.need (t + 1) g c)
  (admits : ∀ (g : F), W.requires t g c → W.Admits (l (t + 1)) (t + 1) g) : W.Exceeds l W.level
Becoming.Web.Includes.not_undermining {F C : Type} {W : Becoming.Web F C} {l : Nat → C → Nat}
  (includes : W.Includes W.level l) {t : Nat} {f : F} {c : C}
  (holds : ∀ (g : F), W.requires t g c → W.requires (t + 1) g c ∧ W.need t g c ≤ W.need (t + 1) g c)
  (admits : ∀ (g : F), W.requires t g c → W.Admits (l (t + 1)) (t + 1) g) : ¬Becoming.Web.UnderminingOn t f c
Becoming.Web.UnderminingOn.not_retains {F C Pos : Type} {W : Becoming.Web F C} {l : Nat → C → Nat} {t : Nat} {f : F}
  {c : C} (undermining : Becoming.Web.UnderminingOn t f c)
  (holds : ∀ (g : F), W.requires t g c → W.requires (t + 1) g c ∧ W.need t g c ≤ W.need (t + 1) g c)
  (admits : ∀ (g : F), W.requires t g c → W.Admits (l (t + 1)) (t + 1) g) {sig : Pos → Nat → F → Prop} {p : Pos}
  (significant : ∀ (g : F), W.requires t g c → sig p (t + 1) g) : ¬W.Retains sig p W.level l
Becoming.Web.inactive_of_not_arising {F C : Type} {W : Becoming.Web F C} {f : F} (start : ¬W.active 0 f)
  (never : ∀ (t : Nat), ¬W.Arises t f) (t : Nat) : ¬W.active t f
Becoming.Flow.retains_iff_within_margin_at {F C Pos : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C} {l : Nat → C → Nat} (without : L.WithheldLevels part W l) {sig : Pos → Nat → F → Prop}
  {p : Pos}
  (balances :
    ∀ (t : Nat) (f : F),
      sig p t f → W.Admits (l t) t f → ∀ (c : C), W.requires t f c → ∀ (s : Nat), s < t → L.BalancesOn W [c] s) :
  W.Retains sig p W.level l ↔
    ∀ (t : Nat) (f : F),
      sig p t f →
        W.Admits (l t) t f →
          ∀ (c : C),
            W.requires t f c →
              (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c
Becoming.Flow.loses_iff_beyond_margin_at {F C Pos : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C} {l : Nat → C → Nat} (without : L.WithheldLevels part W l) {sig : Pos → Nat → F → Prop}
  {p : Pos}
  (balances :
    ∀ (t : Nat) (f : F),
      sig p t f → W.Admits (l t) t f → ∀ (c : C), W.requires t f c → ∀ (s : Nat), s < t → L.BalancesOn W [c] s) :
  W.Adds sig p l W.level ↔
    ∃ t f,
      sig p t f ∧
        W.Admits (l t) t f ∧
          ¬∀ (c : C),
              W.requires t f c →
                (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                  l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c
Becoming.Flow.adds_iff_within_margin_at {F C Pos : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C} {l : Nat → C → Nat} (without : L.WithheldLevels part W l) {sig : Pos → Nat → F → Prop}
  {p : Pos}
  (balances :
    ∀ (t : Nat) (f : F),
      sig p t f → ¬W.Admits (l t) t f → ∀ (c : C), W.requires t f c → ∀ (s : Nat), s < t → L.BalancesOn W [c] s) :
  W.Adds sig p W.level l ↔
    ∃ t f,
      sig p t f ∧
        (∀ (c : C),
            W.requires t f c →
              (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c) ∧
          ¬W.Admits (l t) t f
Becoming.Flow.Balances.retains_iff_within_margin {F C Pos : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C} (balances : L.Balances W) {l : Nat → C → Nat} (without : L.WithheldLevels part W l)
  {sig : Pos → Nat → F → Prop} {p : Pos} :
  W.Retains sig p W.level l ↔
    ∀ (t : Nat) (f : F),
      sig p t f →
        W.Admits (l t) t f →
          ∀ (c : C),
            W.requires t f c →
              (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c
Becoming.Flow.Balances.loses_iff_beyond_margin {F C Pos : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C} (balances : L.Balances W) {l : Nat → C → Nat} (without : L.WithheldLevels part W l)
  {sig : Pos → Nat → F → Prop} {p : Pos} :
  W.Adds sig p l W.level ↔
    ∃ t f,
      sig p t f ∧
        W.Admits (l t) t f ∧
          ¬∀ (c : C),
              W.requires t f c →
                (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                  l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c
Becoming.Flow.Balances.adds_iff_within_margin {F C Pos : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C} (balances : L.Balances W) {l : Nat → C → Nat} (without : L.WithheldLevels part W l)
  {sig : Pos → Nat → F → Prop} {p : Pos} :
  W.Adds sig p W.level l ↔
    ∃ t f,
      sig p t f ∧
        (∀ (c : C),
            W.requires t f c →
              (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c) ∧
          ¬W.Admits (l t) t f
Becoming.Flow.widens_iff_within_margin_at {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {W : Becoming.Web F C}
  {l : Nat → C → Nat} (without : L.WithheldLevels part W l)
  (balances : ∀ (t : Nat) (f : F) (c : C), W.requires t f c → ∀ (s : Nat), s < t → L.BalancesOn W [c] s) :
  W.Widens W.level l ↔
    (∀ (t : Nat) (f : F),
        W.Admits (l t) t f →
          ∀ (c : C),
            W.requires t f c →
              (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c) ∧
      ∃ t f,
        (∀ (c : C),
            W.requires t f c →
              (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c) ∧
          ¬W.Admits (l t) t f
Becoming.Flow.Balances.widens_iff_within_margin {F C : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C} (balances : L.Balances W) {l : Nat → C → Nat} (without : L.WithheldLevels part W l) :
  W.Widens W.level l ↔
    (∀ (t : Nat) (f : F),
        W.Admits (l t) t f →
          ∀ (c : C),
            W.requires t f c →
              (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c) ∧
      ∃ t f,
        (∀ (c : C),
            W.requires t f c →
              (W.need t f c + Becoming.total (Becoming.steps 0 t) fun s => L.partTaken part s c) ≤
                l t c + Becoming.total (Becoming.steps 0 t) fun s => L.partGiven part s c) ∧
          ¬W.Admits (l t) t f
Becoming.Flow.Balances.includes_of_renewed {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {W : Becoming.Web F C}
  (balances : L.Balances W) (taking : L.Taking W) {l : Nat → C → Nat} (without : L.WithheldLevels part W l)
  (renewed : ∀ (t : Nat) (f : F) (c : C), part f = true → W.draws t f c → W.Renewed c) : W.Includes W.level l
Becoming.Flow.Balances.not_narrows_of_renewed {F C : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C} (balances : L.Balances W) (taking : L.Taking W) {l : Nat → C → Nat}
  (without : L.WithheldLevels part W l)
  (renewed : ∀ (t : Nat) (f : F) (c : C), part f = true → W.draws t f c → W.Renewed c) : ¬W.Widens l W.level
Becoming.Flow.Balances.includes_of_renewingIn {F C : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C} (balances : L.Balances W) (taking : L.Taking W) {l : Nat → C → Nat}
  (without : L.WithheldLevels part W l) (renewing : ∀ (f : F), part f = true → W.RenewingIn f) : W.Includes W.level l
Becoming.Flow.Balances.narrows_of_consumed {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {W : Becoming.Web F C}
  (balances : L.Balances W) {l : Nat → C → Nat} (without : L.WithheldLevels part W l)
  (keeps : ∀ (t : Nat) (c : C), L.partGiven part t c ≤ L.partTaken part t c) {g : F} {c : C} {T t : Nat}
  (below : ∀ (t : Nat), T < t → W.level t c < W.need T g c) (later : T < t)
  (holds : W.requires t g c ∧ W.need T g c ≤ W.need t g c) (admits : W.Admits (l t) t g) : W.Widens l W.level
Becoming.Flow.Balances.keeps_of_inactive {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {W : Becoming.Web F C}
  (balances : L.Balances W) (taking : L.Taking W) (acting : L.Acting W) {l : Nat → C → Nat}
  (without : L.WithheldLevels part W l) (inactive : ∀ (t : Nat) (f : F), part f = true → ¬W.active t f) :
  W.Keeps W.level l
Becoming.Flow.Balances.keeps_of_not_arising {F C : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C} (balances : L.Balances W) (taking : L.Taking W) (acting : L.Acting W) {l : Nat → C → Nat}
  (without : L.WithheldLevels part W l) (start : ∀ (f : F), part f = true → ¬W.active 0 f)
  (never : ∀ (t : Nat) (f : F), part f = true → ¬W.Arises t f) : W.Keeps W.level l
