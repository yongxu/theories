  (whole : W.Whole parts w) (listed : W.Listed parts alive) (ends : ∀ (p : F), parts p → W.Ends p) {T : Nat}
  (persists : ∀ (t : Nat), T ≤ t → W.active t w) {l : List F} (within : ∀ (p : F), p ∈ l → parts p) (N : Nat) :
  ¬∀ (t : Nat), N ≤ t → ∀ (p : F), parts p → ¬p ∈ l → ¬W.Arises t p
Becoming.Web.Whole.ends_without_arising {F C : Type} {W : Becoming.Web F C} {parts : F → Prop} {w : F} {N : Nat}
  {alive : Nat → List F} (whole : W.Whole parts w) (listed : W.Listed parts alive)
  (ends : ∀ (p : F), parts p → W.Ends p) (quiet : ∀ (t : Nat), N ≤ t → ∀ (p : F), parts p → ¬W.Arises t p) : W.Ends w
Becoming.Web.Whole.family_excess_ends {F C : Type} {W : Becoming.Web F C} {parts : F → Prop} {w : F}
  {L : Becoming.Flow F C} {alive : Nat → List F} (whole : W.Whole parts w) (listed : W.Listed parts alive)
  (ends : ∀ (p : F), parts p → W.Ends p) (balances : L.Balances W) (acting : L.Acting W) (dependent : W.Dependent)
  {ds : List C} {m : Nat}
  (gated :
    ∀ (t : Nat) (f : F),
      f ∈ L.present t → ∀ (d : C), d ∈ ds → 0 < L.give t f d → ∃ e, e ∈ ds ∧ W.requires t f e ∧ m ≤ W.need t f e)
  (arising :
    ∀ (t : Nat) (p : F), parts p → W.Arises t p → ∃ e, e ∈ ds ∧ W.requires (t + 1) p e ∧ m ≤ W.need (t + 1) p e)
  {T n : Nat} (excess : ∀ (k : Nat), k < n → L.replenishment ds (T + k) < L.uptake ds (T + k))
  (start : W.stock ds T < n + m) : (∀ (t : Nat), T + n ≤ t → ∀ (p : F), parts p → ¬W.Arises t p) ∧ W.Ends w
Becoming.Web.Whole.joint_excess_ends {F C : Type} {W : Becoming.Web F C} {parts : F → Prop} {w : F}
  {L : Becoming.Flow F C} {alive : Nat → List F} (whole : W.Whole parts w) (listed : W.Listed parts alive)
  (ends : ∀ (p : F), parts p → W.Ends p) (balances : L.Balances W) (acting : L.Acting W) (dependent : W.Dependent)
  {c : C} {m : Nat}
  (gated : ∀ (t : Nat) (f : F), f ∈ L.present t → 0 < L.give t f c → W.requires t f c ∧ m ≤ W.need t f c)
  (arising : ∀ (t : Nat) (p : F), parts p → W.Arises t p → W.requires (t + 1) p c ∧ m ≤ W.need (t + 1) p c) {T n : Nat}
  (excess : ∀ (k : Nat), k < n → L.given (T + k) c < L.taken (T + k) c) (start : W.level T c < n + m) :
  (∀ (t : Nat), T + n ≤ t → ∀ (p : F), parts p → ¬W.Arises t p) ∧ W.Ends w
