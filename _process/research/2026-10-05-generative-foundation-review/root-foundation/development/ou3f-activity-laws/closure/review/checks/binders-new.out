  Becoming.Excluding.web.active t Becoming.Witnesses.Member.renewer ∧
    Becoming.Excluding.web.active t Becoming.Witnesses.Member.first ∧
      ¬Becoming.Excluding.web.active (t + 1) Becoming.Witnesses.Member.second
Becoming.Excluding.first_step :
  Becoming.Excluding.web.active 0 Becoming.Witnesses.Member.second ∧
    Becoming.Witnesses.Member.second ∈ Becoming.Excluding.flow.present 0 ∧
      0 < Becoming.Excluding.flow.take 0 Becoming.Witnesses.Member.second () ∧
        Becoming.Excluding.present 0 = Becoming.Exceeding.present 0 ∧
          Becoming.Excluding.level 0 = Becoming.Exceeding.level 0 ∧
            Becoming.Excluding.level 1 = Becoming.Exceeding.level 1
