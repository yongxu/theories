Becoming.ArisingDrawer.withheld :
  Becoming.ArisingDrawer.flow.WithheldLevels Becoming.ArisingDrawer.part Becoming.ArisingDrawer.web fun x x_1 => 1
Becoming.ArisingDrawer.arises_narrows {l : Nat → Unit → Nat}
  (without : Becoming.ArisingDrawer.flow.WithheldLevels Becoming.ArisingDrawer.part Becoming.ArisingDrawer.web l) :
  Becoming.ArisingDrawer.flow.Balances Becoming.ArisingDrawer.web ∧
    Becoming.ArisingDrawer.flow.Taking Becoming.ArisingDrawer.web ∧
      Becoming.ArisingDrawer.flow.Acting Becoming.ArisingDrawer.web ∧
        ¬Becoming.ArisingDrawer.web.active 0 true ∧
          Becoming.ArisingDrawer.web.Arises 0 true ∧
            Becoming.ArisingDrawer.web.Widens l Becoming.ArisingDrawer.web.level
