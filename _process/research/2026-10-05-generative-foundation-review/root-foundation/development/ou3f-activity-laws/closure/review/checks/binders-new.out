Becoming.WholeExceeding.web : Becoming.Web Becoming.Generations.Formation Unit
Becoming.WholeExceeding.flow : Becoming.Flow Becoming.Generations.Formation Unit
Becoming.WholeExceeding.balances : Becoming.WholeExceeding.flow.Balances Becoming.WholeExceeding.web
Becoming.WholeExceeding.acting : Becoming.WholeExceeding.flow.Acting Becoming.WholeExceeding.web
Becoming.WholeExceeding.dependent : Becoming.WholeExceeding.web.Dependent
Becoming.WholeExceeding.gated (t : Nat) (f : Becoming.Generations.Formation) :
  f ∈ Becoming.WholeExceeding.flow.present t →
    ∀ (d : Unit),
      d ∈ [()] →
        0 < Becoming.WholeExceeding.flow.give t f d →
          ∃ e, e ∈ [()] ∧ Becoming.WholeExceeding.web.requires t f e ∧ 1 ≤ Becoming.WholeExceeding.web.need t f e
Becoming.WholeExceeding.arising (t : Nat) (p : Becoming.Generations.Formation) :
  Becoming.Generations.parts p →
    Becoming.WholeExceeding.web.Arises t p →
      ∃ e,
        e ∈ [()] ∧ Becoming.WholeExceeding.web.requires (t + 1) p e ∧ 1 ≤ Becoming.WholeExceeding.web.need (t + 1) p e
Becoming.WholeExceeding.whole :
  Becoming.WholeExceeding.web.Whole Becoming.Generations.parts Becoming.Generations.Formation.lineage
Becoming.WholeExceeding.member_ne {i j : Nat} (other : i = j → False) :
  Becoming.Generations.Formation.member i = Becoming.Generations.Formation.member j → False
Becoming.WholeExceeding.lineage_ne {j : Nat} :
  Becoming.Generations.Formation.lineage = Becoming.Generations.Formation.member j → False
Becoming.WholeExceeding.not_mem_pair {a b c : Becoming.Generations.Formation} (first : a = b → False)
  (second : a = c → False) : ¬a ∈ [b, c]
Becoming.WholeExceeding.listed :
  Becoming.WholeExceeding.web.Listed Becoming.Generations.parts Becoming.WholeExceeding.alive
Becoming.WholeExceeding.ends (p : Becoming.Generations.Formation) :
  Becoming.Generations.parts p → Becoming.WholeExceeding.web.Ends p
Becoming.WholeExceeding.excess (k : Nat) :
  k < 2 → Becoming.WholeExceeding.flow.replenishment [()] (0 + k) < Becoming.WholeExceeding.flow.uptake [()] (0 + k)
Becoming.WholeExceeding.drawn :
  Becoming.WholeExceeding.web.Whole Becoming.Generations.parts Becoming.Generations.Formation.lineage ∧
    Becoming.WholeExceeding.web.Listed Becoming.Generations.parts Becoming.WholeExceeding.alive ∧
      (∀ (p : Becoming.Generations.Formation), Becoming.Generations.parts p → Becoming.WholeExceeding.web.Ends p) ∧
        Becoming.WholeExceeding.flow.Balances Becoming.WholeExceeding.web ∧
          Becoming.WholeExceeding.flow.Acting Becoming.WholeExceeding.web ∧
            Becoming.WholeExceeding.web.Dependent ∧
              (∀ (t : Nat), t < 3 → Becoming.WholeExceeding.web.active t Becoming.Generations.Formation.lineage) ∧
                (∀ (t : Nat),
                    2 ≤ t →
                      ∀ (p : Becoming.Generations.Formation),
                        Becoming.Generations.parts p → ¬Becoming.WholeExceeding.web.Arises t p) ∧
                  Becoming.WholeExceeding.web.Ends Becoming.Generations.Formation.lineage
Becoming.WholeWithin.web : Becoming.Web Becoming.Generations.Formation Unit
Becoming.WholeWithin.flow : Becoming.Flow Becoming.Generations.Formation Unit
Becoming.WholeWithin.balances : Becoming.WholeWithin.flow.Balances Becoming.WholeWithin.web
Becoming.WholeWithin.acting : Becoming.WholeWithin.flow.Acting Becoming.WholeWithin.web
Becoming.WholeWithin.dependent : Becoming.WholeWithin.web.Dependent
Becoming.WholeWithin.gated (t : Nat) (f : Becoming.Generations.Formation) :
  f ∈ Becoming.WholeWithin.flow.present t →
    ∀ (d : Unit),
      d ∈ [()] →
        0 < Becoming.WholeWithin.flow.give t f d →
          ∃ e, e ∈ [()] ∧ Becoming.WholeWithin.web.requires t f e ∧ 1 ≤ Becoming.WholeWithin.web.need t f e
Becoming.WholeWithin.arising (t : Nat) (p : Becoming.Generations.Formation) :
  Becoming.Generations.parts p →
    Becoming.WholeWithin.web.Arises t p →
      ∃ e, e ∈ [()] ∧ Becoming.WholeWithin.web.requires (t + 1) p e ∧ 1 ≤ Becoming.WholeWithin.web.need (t + 1) p e
Becoming.WholeWithin.kept :
  Becoming.WholeWithin.web.Whole Becoming.Generations.parts Becoming.Generations.Formation.lineage ∧
    Becoming.WholeWithin.web.Listed Becoming.Generations.parts Becoming.Generations.alive ∧
      (∀ (p : Becoming.Generations.Formation), Becoming.Generations.parts p → Becoming.WholeWithin.web.Ends p) ∧
        Becoming.WholeWithin.flow.Balances Becoming.WholeWithin.web ∧
          Becoming.WholeWithin.flow.Acting Becoming.WholeWithin.web ∧
            Becoming.WholeWithin.web.Dependent ∧
              (∀ (t : Nat), Becoming.WholeWithin.flow.WithinJoint t ()) ∧
                (∀ (t : Nat), Becoming.WholeWithin.web.active t Becoming.Generations.Formation.lineage) ∧
                  ∀ (t : Nat), Becoming.WholeWithin.web.Arises t (Becoming.Generations.Formation.member (t + 1))
Becoming.WholeUnending.web : Becoming.Web Bool Unit
Becoming.WholeUnending.flow : Becoming.Flow Bool Unit
Becoming.WholeUnending.balances : Becoming.WholeUnending.flow.Balances Becoming.WholeUnending.web
Becoming.WholeUnending.persists :
  Becoming.WholeUnending.web.Whole (fun x => x = true) false ∧
    (Becoming.WholeUnending.web.Listed (fun x => x = true) fun x => [true]) ∧
      Becoming.WholeUnending.flow.Balances Becoming.WholeUnending.web ∧
        Becoming.WholeUnending.flow.Acting Becoming.WholeUnending.web ∧
          Becoming.WholeUnending.web.Dependent ∧
            (∀ (t : Nat) (f : Bool),
                f ∈ Becoming.WholeUnending.flow.present t →
                  ∀ (d : Unit),
                    d ∈ [()] →
                      0 < Becoming.WholeUnending.flow.give t f d →
                        ∃ e,
                          e ∈ [()] ∧
                            Becoming.WholeUnending.web.requires t f e ∧ 1 ≤ Becoming.WholeUnending.web.need t f e) ∧
              (∀ (t : Nat) (p : Bool),
                  p = true →
                    Becoming.WholeUnending.web.Arises t p →
                      ∃ e,
                        e ∈ [()] ∧
                          Becoming.WholeUnending.web.requires (t + 1) p e ∧
                            1 ≤ Becoming.WholeUnending.web.need (t + 1) p e) ∧
                (∀ (k : Nat),
                    k < 1 →
                      Becoming.WholeUnending.flow.replenishment [()] (0 + k) <
                        Becoming.WholeUnending.flow.uptake [()] (0 + k)) ∧
                  Becoming.WholeUnending.web.stock [()] 0 < 1 + 1 ∧
                    (∀ (t : Nat), Becoming.WholeUnending.web.active t false) ∧ ¬Becoming.WholeUnending.web.Ends true
Becoming.WholeUngated.web : Becoming.Web Becoming.Generations.Formation Unit
Becoming.WholeUngated.flow : Becoming.Flow Becoming.Generations.Formation Unit
Becoming.WholeUngated.balances : Becoming.WholeUngated.flow.Balances Becoming.WholeUngated.web
Becoming.WholeUngated.persists :
  Becoming.WholeUngated.web.Whole Becoming.Generations.parts Becoming.Generations.Formation.lineage ∧
    Becoming.WholeUngated.web.Listed Becoming.Generations.parts Becoming.Generations.alive ∧
      (∀ (p : Becoming.Generations.Formation), Becoming.Generations.parts p → Becoming.WholeUngated.web.Ends p) ∧
        Becoming.WholeUngated.flow.Balances Becoming.WholeUngated.web ∧
          Becoming.WholeUngated.flow.Acting Becoming.WholeUngated.web ∧
            Becoming.WholeUngated.web.Dependent ∧
              (∀ (t : Nat) (f : Becoming.Generations.Formation),
                  f ∈ Becoming.WholeUngated.flow.present t →
                    ∀ (d : Unit),
                      d ∈ [()] →
                        0 < Becoming.WholeUngated.flow.give t f d →
                          ∃ e,
                            e ∈ [()] ∧
                              Becoming.WholeUngated.web.requires t f e ∧ 1 ≤ Becoming.WholeUngated.web.need t f e) ∧
                (∀ (k : Nat),
                    k < 1 →
                      Becoming.WholeUngated.flow.replenishment [()] (0 + k) <
                        Becoming.WholeUngated.flow.uptake [()] (0 + k)) ∧
                  Becoming.WholeUngated.web.stock [()] 0 < 1 + 1 ∧
                    (∀ (t : Nat), Becoming.WholeUngated.web.active t Becoming.Generations.Formation.lineage) ∧
                      ∀ (t : Nat), Becoming.WholeUngated.web.Arises t (Becoming.Generations.Formation.member (t + 1))
