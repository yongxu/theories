  (ended : ∀ (t : Nat), T ≤ t → ¬W.active t (chain 0)) (k : Nat) :
  k ≤ n → ∃ E, T ≤ E ∧ ∀ (t : Nat), E ≤ t → ¬W.active t (chain k)
