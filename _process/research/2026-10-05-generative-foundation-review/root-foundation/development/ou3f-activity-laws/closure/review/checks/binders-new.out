  {chain : Nat → X} {n T : Nat} (carries : ∀ (k t : Nat), k < n → T ≤ t → W.CarriesAcross r t (chain (k + 1)))
  (embodied : ∀ (k : Nat), k < n → W.Embodied (chain k))
  (bears :
    ∀ (k t : Nat), k < n → T ≤ t → W.requires t (chain (k + 1)) (chain k) ∧ 0 < W.need t (chain (k + 1)) (chain k))
  (ended : ∀ (t : Nat), T ≤ t → ¬W.active t (chain 0)) (k : Nat) :
  k ≤ n → ∃ E, T ≤ E ∧ ∀ (t : Nat), E ≤ t → ¬W.active t (chain k)
Becoming.Web.Carries.chain_ends_of_em {X : Type} {W : Becoming.Web X X} (em : ∀ (P : Prop), P ∨ ¬P) {r : Nat → X → Nat}
  (carries : W.Carries r) {chain : Nat → X} {n : Nat} (embodied : ∀ (k : Nat), k < n → W.Embodied (chain k)) {T : Nat}
  (bears :
