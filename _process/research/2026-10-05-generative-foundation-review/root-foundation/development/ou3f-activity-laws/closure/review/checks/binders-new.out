  {T : Nat} {g : F} {c : C} (fixed : ∀ (t : Nat), T < t → W.requires t g c ∧ W.need T g c ≤ W.need t g c)
  (below : ∀ (t : Nat), T < t → W.level t c < W.need T g c) : ¬∀ (N : Nat), ∃ t, N ≤ t ∧ W.active t g
