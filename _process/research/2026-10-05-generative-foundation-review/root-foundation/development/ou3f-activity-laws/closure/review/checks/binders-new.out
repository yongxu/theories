  (covered : W.Covered parts T) (listed : W.Listed parts alive) (ends : ∀ (p : F), parts p → W.Ends p) {l : List F}
  (within : ∀ (p : F), p ∈ l → parts p) (N : Nat) : ¬∀ (t : Nat), N ≤ t → ∀ (p : F), parts p → ¬p ∈ l → ¬W.Arises t p
