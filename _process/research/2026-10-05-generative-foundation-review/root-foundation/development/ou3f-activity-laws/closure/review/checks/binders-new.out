Becoming.Once.ind_and_le (b c : Bool) : Becoming.Once.ind (b && c) ≤ Becoming.Once.ind b
Becoming.Once.ind_fall (b c : Bool) : b = true → c = true → Becoming.Once.ind (b && !c) < Becoming.Once.ind b
Becoming.Once.web (s : Nat → Bool) : Becoming.Web Unit Unit
Becoming.Once.reserve (s : Nat → Bool) (t : Nat) : Unit → Nat
