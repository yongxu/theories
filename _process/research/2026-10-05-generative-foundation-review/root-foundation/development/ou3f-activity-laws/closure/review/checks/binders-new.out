  [(t : Nat) → Decidable (W.active t f)] (S N : Nat) :
  (∀ (t : Nat), S ≤ t → t < S + N → W.CarriesAcross r t f) →
    (∀ (t : Nat), S ≤ t → t < S + N → ¬W.Supported t f) →
      (r (S + N) f + Becoming.total (Becoming.steps S N) fun t => Becoming.mark (W.active t f)) ≤ r S f
Becoming.Web.Carries.lasts {F C : Type} {W : Becoming.Web F C} {r : Nat → F → Nat} (carries : W.Carries r) {f : F}
  [(t : Nat) → Decidable (W.active t f)] (S N : Nat) :
  (∀ (t : Nat), S ≤ t → ¬W.Supported t f) →
    (r (S + N) f + Becoming.total (Becoming.steps S N) fun t => Becoming.mark (W.active t f)) ≤ r S f
Becoming.Web.Carries.lasts_within {F C : Type} {W : Becoming.Web F C} {r : Nat → F → Nat} (carries : W.Carries r)
  {f : F} [(t : Nat) → Decidable (W.active t f)] {k : Nat} (capacity : ∀ (t : Nat), r t f ≤ k) (S N : Nat)
  (unsupported : ∀ (t : Nat), S ≤ t → ¬W.Supported t f) :
  (Becoming.total (Becoming.steps S N) fun t => Becoming.mark (W.active t f)) ≤ k
