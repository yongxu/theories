  {rest : List F} (distinct : Becoming.Distinct rest)
  (present : ∀ (j : Nat) (f : F), j < n → f ∈ rest → 0 < L.take (T + j) f c → f ∈ L.present (T + j))
  (outruns : ∀ (j : Nat), j < n → L.given (T + j) c < Becoming.total rest fun f => L.take (T + j) f c)
  (start : W.level T c < n + m) (k : Nat) (h : F) :
  W.requires (T + n + k) h c → m ≤ W.need (T + n + k) h c → ¬W.active (T + n + k) h
Becoming.Flow.outrun_reading_alike {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {L' : Becoming.Flow F C}
  {W' : Becoming.Web F C} (balances : L.Balances W) (acting : L.Acting W) (dependent : W.Dependent)
  (balances' : L'.Balances W') (acting' : L'.Acting W') (dependent' : W'.Dependent) {c : C}
  (gated : ∀ (t : Nat) (e : F), e ∈ L.present t → 0 < L.give t e c → W.requires t e c ∧ 1 ≤ W.need t e c)
  (gated' : ∀ (t : Nat) (e : F), e ∈ L'.present t → 0 < L'.give t e c → W'.requires t e c ∧ 1 ≤ W'.need t e c)
  {T n : Nat} {rest rest' : List F} (distinct : Becoming.Distinct rest) (distinct' : Becoming.Distinct rest')
  (present : ∀ (j : Nat) (f : F), j < n → f ∈ rest → 0 < L.take (T + j) f c → f ∈ L.present (T + j))
  (present' : ∀ (j : Nat) (f : F), j < n → f ∈ rest' → 0 < L'.take (T + j) f c → f ∈ L'.present (T + j))
  (outruns : ∀ (j : Nat), j < n → L.given (T + j) c < Becoming.total rest fun f => L.take (T + j) f c)
  (outruns' : ∀ (j : Nat), j < n → L'.given (T + j) c < Becoming.total rest' fun f => L'.take (T + j) f c)
  (start : W.level T c < n + 1) (start' : W'.level T c < n + 1) {score : (Nat → C → Nat) → Nat}
  (reads : ∀ (l l' : Nat → C → Nat), (∀ (k : Nat), l (T + n + k) c = l' (T + n + k) c) → score l = score l') :
  score W.level = score W'.level
