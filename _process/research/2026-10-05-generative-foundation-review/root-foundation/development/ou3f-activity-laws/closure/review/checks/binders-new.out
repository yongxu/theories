Becoming.Once.carries (s : Nat → Bool) : (Becoming.Once.web s).Carries (Becoming.Once.reserve s)
Becoming.Once.decided (s : Nat → Bool) (t : Nat) : Decidable ((Becoming.Once.web s).active t ())
