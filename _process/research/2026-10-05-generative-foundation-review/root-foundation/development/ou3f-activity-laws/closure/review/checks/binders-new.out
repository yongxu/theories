  (carries : W.Carries r) {f : F} {T : Nat} (unsupported : ∀ (t : Nat), T ≤ t → ¬W.Supported t f) :
  ¬∀ (N : Nat), ∃ t, N ≤ t ∧ W.Arises t f
Becoming.Web.decays_by_on {F C : Type} {W : Becoming.Web F C} {r : Nat → F → Nat} {f : F} {S : Nat} (n : Nat) :
  (∀ (t : Nat), S ≤ t → t < S + n → W.CarriesAcross r t f) →
    (∀ (t : Nat), S ≤ t → t < S + n → W.DecaysAcross r t f) →
      (∀ (t : Nat), S ≤ t → t < S + n → ¬W.Supported t f) → r (S + n) f + n ≤ r S f ∨ r (S + n) f = 0
Becoming.Web.decays_by_from {F C : Type} {W : Becoming.Web F C} {r : Nat → F → Nat} {f : F} {S : Nat}
  (carries : ∀ (t : Nat), S ≤ t → W.CarriesAcross r t f) (decays : ∀ (t : Nat), S ≤ t → W.DecaysAcross r t f)
  (unsupported : ∀ (t : Nat), S ≤ t → ¬W.Supported t f) (n : Nat) : r (S + n) f + n ≤ r S f ∨ r (S + n) f = 0
