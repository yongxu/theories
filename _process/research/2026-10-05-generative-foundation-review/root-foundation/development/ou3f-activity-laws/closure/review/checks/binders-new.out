Becoming.Web.InStep {F C : Type} (W : Becoming.Web F C) (parts : F → Prop) : Prop
Becoming.Web.allWhole_self {F C : Type} (W : Becoming.Web F C) (f : F) : W.AllWhole (fun x => x = f) f
Becoming.Web.AllWhole.inactive_of_part {F C : Type} {W : Becoming.Web F C} {parts : F → Prop} {w : F}
  (whole : W.AllWhole parts w) {p : F} (part : parts p) {t : Nat} (inactive : ¬W.active t p) : ¬W.active t w
Becoming.Web.AllWhole.ends_of_part {F C : Type} {W : Becoming.Web F C} {parts : F → Prop} {w : F}
  (whole : W.AllWhole parts w) {p : F} (part : parts p) (ends : W.Ends p) : W.Ends w
Becoming.Web.AllWhole.persists_iff {F C : Type} {W : Becoming.Web F C} {parts : F → Prop} {w : F}
  (whole : W.AllWhole parts w) {T : Nat} :
  (∀ (t : Nat), T ≤ t → W.active t w) ↔ ∀ (p : F), parts p → ∀ (t : Nat), T ≤ t → W.active t p
Becoming.Web.AllWhole.brief_of_part {F C : Type} {W : Becoming.Web F C} {parts : F → Prop} {w : F}
  (whole : W.AllWhole parts w) {p : F} (part : parts p) {d : Nat} (brief : W.Brief d p) : W.Brief d w
Becoming.Web.Whole.ceases_part {F C : Type} {W : Becoming.Web F C} {parts : F → Prop} {w : F} (whole : W.Whole parts w)
  {t : Nat} (ceases : W.Ceases t w) : ∃ p, parts p ∧ W.Ceases t p
Becoming.Web.AllWhole.active_whole {F C : Type} {W : Becoming.Web F C} {parts : F → Prop} {w v : F}
  (all : W.AllWhole parts v) (whole : W.Whole parts w) {p₀ : F} (part₀ : parts p₀) {t : Nat} (active : W.active t v) :
  W.active t w
Becoming.Web.Whole.same_iff_inStep {F C : Type} {W : Becoming.Web F C} {parts : F → Prop} {w v : F}
  (whole : W.Whole parts w) (all : W.AllWhole parts v) {p₀ : F} (part₀ : parts p₀) :
  (∀ (t : Nat), W.active t w ↔ W.active t v) ↔ W.InStep parts
Becoming.Web.AllWhole.active_of_none {F C : Type} {W : Becoming.Web F C} {parts : F → Prop} {w : F}
  (all : W.AllWhole parts w) (absent : ∀ (p : F), ¬parts p) (t : Nat) :
  W.active t w ∧ ∀ {v : F}, W.Whole parts v → ¬W.active t v
Becoming.Counts.lt_length_of_fails {α : Type} {q : α → Prop} {a : α} (fails : ¬q a) {as : List α} {n : Nat} :
  Becoming.Counts as q n → a ∈ as → n < as.length
Becoming.Counts.all_of_eq_length {α : Type} {q : α → Prop} {as : List α} {n : Nat} (counts : Becoming.Counts as q n)
  (all : n = as.length) (a : α) : a ∈ as → q a
Becoming.Web.Grade {F C : Type} (W : Becoming.Web F C) (ps : List F) (t n : Nat) : Prop
Becoming.Web.AtLeastWhole {F C : Type} (W : Becoming.Web F C) (j : Nat) (ps : List F) (w : F) : Prop
Becoming.Web.Diminished {F C : Type} (W : Becoming.Web F C) (ps : List F) (t : Nat) : Prop
Becoming.Web.Grade.pos_iff {F C : Type} {W : Becoming.Web F C} {ps : List F} {t n : Nat} (grade : W.Grade ps t n) :
  0 < n ↔ ∃ p, p ∈ ps ∧ W.active t p
Becoming.Web.Grade.eq_length_iff {F C : Type} {W : Becoming.Web F C} {ps : List F} {t n : Nat}
  (grade : W.Grade ps t n) : n = ps.length ↔ ∀ (p : F), p ∈ ps → W.active t p
Becoming.Web.Grade.lt_length_of_inactive {F C : Type} {W : Becoming.Web F C} {ps : List F} {t n : Nat}
  (grade : W.Grade ps t n) {p : F} (mem : p ∈ ps) (inactive : ¬W.active t p) : n < ps.length
Becoming.Web.Grade.across_step {F C : Type} {W : Becoming.Web F C} {ps : List F} {t n n' a c : Nat}
  (now : W.Grade ps t n) (next : W.Grade ps (t + 1) n') (arose : Becoming.Counts ps (W.Arises t) a)
  (ceased : Becoming.Counts ps (W.Ceases t) c) : n' + c = n + a
Becoming.Web.Grade.arises_of_lt {F C : Type} {W : Becoming.Web F C} {ps : List F} {t n n' : Nat} (now : W.Grade ps t n)
  (next : W.Grade ps (t + 1) n') (rises : n < n') : ∃ p, p ∈ ps ∧ W.Arises t p
Becoming.Web.Grade.ceases_of_lt {F C : Type} {W : Becoming.Web F C} {ps : List F} {t n n' : Nat} (now : W.Grade ps t n)
  (next : W.Grade ps (t + 1) n') (falls : n' < n) : ∃ p, p ∈ ps ∧ W.Ceases t p
