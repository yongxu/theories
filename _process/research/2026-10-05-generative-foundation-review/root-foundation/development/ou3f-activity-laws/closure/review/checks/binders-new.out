  Becoming.Excluding.web.active t Becoming.Witnesses.Member.second →
    Becoming.Witnesses.Member.second ∈ Becoming.Excluding.flow.present t ∧
      0 < Becoming.Excluding.flow.take t Becoming.Witnesses.Member.second ()
