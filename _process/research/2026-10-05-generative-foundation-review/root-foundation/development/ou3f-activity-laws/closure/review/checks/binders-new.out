  Becoming.Rafters.web.Ceases 0 Becoming.Rafters.Formation.house ∧
    Becoming.Rafters.web.Ceases 0 (Becoming.Rafters.Formation.rafter 0) ∧
      ∀ (t : Nat),
        0 < t →
          Becoming.Rafters.web.Grade Becoming.Rafters.rafters t 2 ∧
            Becoming.Rafters.web.Diminished Becoming.Rafters.rafters t ∧
              Becoming.Rafters.web.active t Becoming.Rafters.Formation.remains ∧
                ¬Becoming.Rafters.web.active t Becoming.Rafters.Formation.house
