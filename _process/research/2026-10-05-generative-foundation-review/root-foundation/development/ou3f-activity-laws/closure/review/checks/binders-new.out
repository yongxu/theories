  (whole : W.Whole parts w) (listed : W.Listed parts alive) (ends : ∀ (p : F), parts p → W.Ends p) {T : Nat}
  (persists : ∀ (t : Nat), T ≤ t → W.active t w) (N : Nat) : ¬∀ (t : Nat), N ≤ t → ∀ (p : F), parts p → ¬W.Arises t p
