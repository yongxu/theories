  (keeps : σ.KeepsActive (W.persisting h)) {f : F} (always : ∀ (t : Nat), h t f) (t : Nat) : σ.old t (σ.new 0 f) = f
Becoming.Web.renewingIn_held {F F' C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop} {σ : Becoming.Reidentify F F'}
  (keeps : σ.KeepsActive (W.persisting h)) {f : F} (always : ∀ (t : Nat), h t f) :
  (W.reidentify σ).RenewingIn (σ.new 0 f) ↔ W.RenewingIn f
Becoming.Web.consumingIn_held {F F' C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop} {σ : Becoming.Reidentify F F'}
  (keeps : σ.KeepsActive (W.persisting h)) {f : F} (always : ∀ (t : Nat), h t f) :
  (W.reidentify σ).ConsumingIn (σ.new 0 f) ↔ W.ConsumingIn f
Becoming.Web.persisting_census {F C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop} {R : Nat → F → F → Prop}
  [(t : Nat) → (f : F) → Decidable ((W.persisting h).active t f)]
  [(t : Nat) → (f : F) → Decidable ((W.persisting h).Continues R t f)]
  [(t : Nat) → (g : F) → Decidable ((W.persisting h).Continued R t g)] [(t : Nat) → (g f : F) → Decidable (R t g f)]
  {alive : Nat → List F} (census : (W.persisting h).Census alive) :
  ((W.persisting h).NoSplit R →
      (∀ (N : Nat), ∃ t g, N ≤ t ∧ (W.persisting h).CeasesFrom R t g) → (W.persisting h).UnceasingFrom R) ∧
    ((W.persisting h).NoMerge R →
      ∀ {T B : Nat},
        (∀ (t : Nat), T ≤ t → (alive t).length ≤ B) →
          (W.persisting h).UnceasingFrom R → ∀ (N : Nat), ∃ t g, N ≤ t ∧ (W.persisting h).CeasesFrom R t g)
