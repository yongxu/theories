  (carries : ∀ (t : Nat), T ≤ t → W.CarriesAcross r t f) (unsupported : ∀ (t : Nat), T ≤ t → ¬W.Supported t f) :
  ¬∀ (N : Nat), ∃ t, N ≤ t ∧ W.Arises t f
