  (hold : F → C) (balances : L.BalancesOn W [hold f] t) (unreplenished : ¬W.Supported t f → L.given t (hold f) = 0)
  (drawn : ¬W.Supported t f → W.active t f → 0 < L.taken t (hold f)) :
  W.CarriesAcross (fun t f => W.level t (hold f)) t f
