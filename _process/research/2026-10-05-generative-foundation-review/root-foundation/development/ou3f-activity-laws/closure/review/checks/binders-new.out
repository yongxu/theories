    ∀ (t : Nat),
      ∃ p s avail,
        Becoming.JointPlan.Realizes J (Becoming.Supports footprint) s p ∧
          (∀ (a : R), footprint s a → a ∈ avail) ∧ L.taken t c = p.draws.length ∧ avail.length ≤ L.given t c)
