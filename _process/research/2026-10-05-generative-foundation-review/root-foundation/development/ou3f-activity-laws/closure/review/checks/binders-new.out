  (fixed : ∀ (t : Nat), T < t → W.requires t g c ∧ W.need T g c ≤ W.need t g c)
  (below : ∀ (t : Nat), T < t → W.level t c < W.need T g c) (t : Nat) : T < t → ¬W.Supported t g
