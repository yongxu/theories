  (whole : W.AtLeastWhole j ps w) {t : Nat} (arises : W.Arises t w) : ∃ p, p ∈ ps ∧ W.Arises t p
Becoming.Web.AtLeastWhole.ceases_part {F C : Type} {W : Becoming.Web F C} {w : F} {ps : List F} {j : Nat}
  (whole : W.AtLeastWhole j ps w) {t : Nat} (ceases : W.Ceases t w) : ∃ p, p ∈ ps ∧ W.Ceases t p
Becoming.Web.AtLeastWhole.whole {F C : Type} {W : Becoming.Web F C} {w : F} {ps : List F}
  (whole : W.AtLeastWhole 1 ps w) : W.Whole (fun x => x ∈ ps) w
Becoming.Web.Whole.atLeastWhole {F C : Type} {W : Becoming.Web F C} {w : F} {ps : List F}
  (whole : W.Whole (fun x => x ∈ ps) w) (decided : ∀ (t : Nat) (p : F), p ∈ ps → Becoming.Decided (W.active t p)) :
  W.AtLeastWhole 1 ps w
Becoming.Web.AtLeastWhole.allWhole {F C : Type} {W : Becoming.Web F C} {w : F} {ps : List F}
  (whole : W.AtLeastWhole ps.length ps w) : W.AllWhole (fun x => x ∈ ps) w
Becoming.Web.AllWhole.atLeastWhole {F C : Type} {W : Becoming.Web F C} {w : F} {ps : List F}
  (all : W.AllWhole (fun x => x ∈ ps) w) (decided : ∀ (t : Nat) (p : F), p ∈ ps → Becoming.Decided (W.active t p)) :
  W.AtLeastWhole ps.length ps w
Becoming.Web.AllWhole.arises_part {F C : Type} {W : Becoming.Web F C} {w : F} {ps : List F}
  (all : W.AllWhole (fun x => x ∈ ps) w) (decided : ∀ (t : Nat) (p : F), p ∈ ps → Becoming.Decided (W.active t p))
  {t : Nat} (arises : W.Arises t w) : ∃ p, p ∈ ps ∧ W.Arises t p
Becoming.Web.AllWhole.ceases_part {F C : Type} {W : Becoming.Web F C} {w : F} {ps : List F}
  (all : W.AllWhole (fun x => x ∈ ps) w) (decided : ∀ (t : Nat) (p : F), p ∈ ps → Becoming.Decided (W.active t p))
  {t : Nat} (ceases : W.Ceases t w) : ∃ p, p ∈ ps ∧ W.Ceases t p
Becoming.Web.Grade.diminished_iff {F C : Type} {W : Becoming.Web F C} {w : F} {ps : List F} {v : F}
  (whole : W.Whole (fun x => x ∈ ps) w) (all : W.AllWhole (fun x => x ∈ ps) v) {t n : Nat} (grade : W.Grade ps t n) :
  0 < n ∧ n < ps.length ↔ W.active t w ∧ ¬W.active t v
Becoming.Web.diminished_iff {F C : Type} {W : Becoming.Web F C} {w : F} {ps : List F} {v : F}
  (whole : W.Whole (fun x => x ∈ ps) w) (all : W.AllWhole (fun x => x ∈ ps) v) {t : Nat}
  (decided : ∀ (p : F), p ∈ ps → Becoming.Decided (W.active t p)) : W.Diminished ps t ↔ W.active t w ∧ ¬W.active t v
Becoming.Generations.Formation : Type
Becoming.Generations.parts : Becoming.Generations.Formation → Prop
Becoming.Generations.web : Becoming.Web Becoming.Generations.Formation Unit
Becoming.Generations.alive : Nat → List Becoming.Generations.Formation
Becoming.Generations.whole :
  Becoming.Generations.web.Whole Becoming.Generations.parts Becoming.Generations.Formation.lineage
Becoming.Generations.listed : Becoming.Generations.web.Listed Becoming.Generations.parts Becoming.Generations.alive
Becoming.Generations.ends (p : Becoming.Generations.Formation) :
  Becoming.Generations.parts p → Becoming.Generations.web.Ends p
Becoming.Generations.brief (p : Becoming.Generations.Formation) :
  Becoming.Generations.parts p → Becoming.Generations.web.Brief 2 p
Becoming.Generations.generations :
  Becoming.Generations.web.Whole Becoming.Generations.parts Becoming.Generations.Formation.lineage ∧
    Becoming.Generations.web.Listed Becoming.Generations.parts Becoming.Generations.alive ∧
      (∀ (p : Becoming.Generations.Formation), Becoming.Generations.parts p → Becoming.Generations.web.Ends p) ∧
        (∀ (p : Becoming.Generations.Formation), Becoming.Generations.parts p → Becoming.Generations.web.Brief 2 p) ∧
          (∀ (t : Nat), Becoming.Generations.web.active t Becoming.Generations.Formation.lineage) ∧
            (∀ (t : Nat), Becoming.Generations.web.Arises t (Becoming.Generations.Formation.member (t + 1))) ∧
              ∀ (t : Nat), ¬Becoming.Generations.web.Arises t Becoming.Generations.Formation.lineage
Becoming.Shifts.odd_two (t : Nat) : Becoming.odd (t + 2) = Becoming.odd t
Becoming.Shifts.half_even (t : Nat) : Becoming.odd t = false → Becoming.Pulse.half (t + 1) = Becoming.Pulse.half t
Becoming.Shifts.web : Becoming.Web Becoming.Generations.Formation Unit
Becoming.Shifts.shifts :
  Becoming.Shifts.web.Whole Becoming.Generations.parts Becoming.Generations.Formation.lineage ∧
    (∀ (p : Becoming.Generations.Formation), Becoming.Generations.parts p → Becoming.Shifts.web.Brief 2 p) ∧
      (∀ (t : Nat), Becoming.Shifts.web.active t Becoming.Generations.Formation.lineage) ∧
        ∀ (t : Nat), Becoming.odd t = false → ∀ (p : Becoming.Generations.Formation), ¬Becoming.Shifts.web.Arises t p
Becoming.Immortal.web : Becoming.Web Bool Unit
Becoming.Immortal.immortal :
  Becoming.Immortal.web.Whole (fun x => x = true) false ∧
    (Becoming.Immortal.web.Listed (fun x => x = true) fun x => [true]) ∧
      (∀ (t : Nat), Becoming.Immortal.web.active t false) ∧
        (∀ (t : Nat) (p : Bool), ¬Becoming.Immortal.web.Arises t p) ∧ ¬Becoming.Immortal.web.Ends true
Becoming.Immortal.each_other :
  Becoming.Immortal.web.Whole (fun x => x = true) false ∧ Becoming.Immortal.web.Whole (fun x => x = false) true
Becoming.Countless.parts : Option Nat → Prop
Becoming.Countless.web : Becoming.Web (Option Nat) Unit
Becoming.Countless.whole : Becoming.Countless.web.Whole Becoming.Countless.parts none
Becoming.Countless.ends (p : Option Nat) : Becoming.Countless.parts p → Becoming.Countless.web.Ends p
Becoming.Countless.never (t : Nat) (p : Option Nat) : ¬Becoming.Countless.web.Arises t p
Becoming.Countless.countless :
  Becoming.Countless.web.Whole Becoming.Countless.parts none ∧
    (∀ (p : Option Nat), Becoming.Countless.parts p → Becoming.Countless.web.Ends p) ∧
      (∀ (t : Nat), Becoming.Countless.web.active t none) ∧
        (∀ (t : Nat) (p : Option Nat), ¬Becoming.Countless.web.Arises t p) ∧
          ¬∃ alive, Becoming.Countless.web.Listed Becoming.Countless.parts alive
Becoming.Gaps.alive (t : Nat) : List Becoming.Generations.Formation
Becoming.Gaps.web : Becoming.Web Becoming.Generations.Formation Unit
Becoming.Gaps.whole : Becoming.Gaps.web.Whole Becoming.Generations.parts Becoming.Generations.Formation.lineage
Becoming.Gaps.alive_odd {t : Nat} (h : Becoming.odd t = true) :
  Becoming.Gaps.alive t = [Becoming.Generations.Formation.member t]
Becoming.Gaps.alive_even {t : Nat} (h : Becoming.odd t = false) : Becoming.Gaps.alive t = []
Becoming.Gaps.listed : Becoming.Gaps.web.Listed Becoming.Generations.parts Becoming.Gaps.alive
Becoming.Gaps.ends (p : Becoming.Generations.Formation) : Becoming.Generations.parts p → Becoming.Gaps.web.Ends p
Becoming.Gaps.gaps :
  Becoming.Gaps.web.Whole Becoming.Generations.parts Becoming.Generations.Formation.lineage ∧
    Becoming.Gaps.web.Listed Becoming.Generations.parts Becoming.Gaps.alive ∧
      (∀ (p : Becoming.Generations.Formation), Becoming.Generations.parts p → Becoming.Gaps.web.Ends p) ∧
        (∀ (N : Nat), ∃ t p, N ≤ t ∧ Becoming.Generations.parts p ∧ Becoming.Gaps.web.Arises t p) ∧
          ∀ (t : Nat), Becoming.odd t = false → ¬Becoming.Gaps.web.active t Becoming.Generations.Formation.lineage
Becoming.Layered.composed :
  Becoming.Layered.web.Whole (fun x => x ≠ Becoming.Layered.Level.lineage) Becoming.Layered.Level.lineage
Becoming.Layered.brief (p : Becoming.Layered.Level) :
  p ≠ Becoming.Layered.Level.lineage → Becoming.Layered.web.Brief 1 p
Becoming.Layered.within (S : Nat) :
  ¬∀ (j : Nat),
      j < 1 →
        ∀ (p : Becoming.Layered.Level), p ≠ Becoming.Layered.Level.lineage → ¬Becoming.Layered.web.Arises (S + j) p
Becoming.Layered.arise_again :
  (∀ (t : Nat) (p : Becoming.Layered.Level),
      Becoming.Layered.web.Arises t p → p ∈ [Becoming.Layered.Level.first, Becoming.Layered.Level.second]) ∧
    ¬Becoming.Layered.web.Ends Becoming.Layered.Level.first ∧ ¬Becoming.Layered.web.Ends Becoming.Layered.Level.second
