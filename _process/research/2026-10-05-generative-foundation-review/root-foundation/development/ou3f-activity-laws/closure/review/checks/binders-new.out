  (decays : W.Decays r) {f : F} {S : Nat} (unsupported : ∀ (t : Nat), S ≤ t → ¬W.Supported t f) (n : Nat) :
  r (S + n) f + n ≤ r S f ∨ r (S + n) f = 0
Becoming.Web.ends_within_on {F C : Type} {W : Becoming.Web F C} {r : Nat → F → Nat} {f : F} {S n : Nat}
  (carries : ∀ (t : Nat), S ≤ t → t ≤ S + n → W.CarriesAcross r t f)
  (decays : ∀ (t : Nat), S ≤ t → t < S + n → W.DecaysAcross r t f)
  (unsupported : ∀ (t : Nat), S ≤ t → t ≤ S + n → ¬W.Supported t f) (spent : r S f ≤ n) :
  ¬W.active (S + n) f ∧ r (S + n) f = 0
Becoming.Web.ends_within_from {F C : Type} {W : Becoming.Web F C} {r : Nat → F → Nat} {f : F} {S : Nat}
  (carries : ∀ (t : Nat), S ≤ t → W.CarriesAcross r t f) (decays : ∀ (t : Nat), S ≤ t → W.DecaysAcross r t f)
  (unsupported : ∀ (t : Nat), S ≤ t → ¬W.Supported t f) {n : Nat} (spent : r S f ≤ n) : ¬W.active (S + n) f
Becoming.Web.ended_for_good {F C : Type} {W : Becoming.Web F C} {r : Nat → F → Nat} {f : F} {U : Nat}
  (inactive : ¬W.active U f) (spent : r U f = 0)
  (final : ∀ (t : Nat), U ≤ t → ¬W.active t f → r t f = 0 → ¬W.Arises t f ∧ r (t + 1) f = 0) (k : Nat) :
  ¬W.active (U + k) f ∧ r (U + k) f = 0
