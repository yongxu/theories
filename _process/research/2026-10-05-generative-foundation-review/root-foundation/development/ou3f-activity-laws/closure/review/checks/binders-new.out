  (keeps : σ.KeepsActive (W.persisting h)) : σ.KeepsTenure W
Becoming.Web.steady_held {F F' C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop} {σ : Becoming.Reidentify F F'}
  (keeps : σ.KeepsActive (W.persisting h)) {g : F} {s t : Nat} :
  (∀ (u : Nat), s ≤ u → u ≤ t → h u g) → ∀ (u : Nat), s ≤ u → u ≤ t → σ.new u g = σ.new t g
