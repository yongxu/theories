  (stands : ∀ (t : Nat), W.active t x → 0 < W.level t x) {T t : Nat} (le : T ≤ t) (absent : ¬0 < W.level T x)
  (active : W.active t x) : ¬∀ (s : Nat), T ≤ s → s < t → ¬W.ComesToStand s x
Becoming.Seed.wake : Nat → Nat
Becoming.Seed.reserve : Nat → Nat
Becoming.Seed.web : Becoming.Web Unit Unit
Becoming.Seed.decAwake (t : Nat) : Decidable (Becoming.Seed.web.active t ())
Becoming.Seed.dark (t : Nat) : ¬Becoming.Seed.web.Supported t ()
Becoming.Seed.carries : Becoming.Seed.web.Carries fun t x => Becoming.Seed.reserve t
Becoming.Seed.seed :
  ¬Becoming.Seed.web.Dependent ∧
    (Becoming.Seed.web.Carries fun t x => Becoming.Seed.reserve t) ∧
      Becoming.Seed.web.Arises 0 () ∧
        Becoming.Seed.web.Arises 2 () ∧
          (∀ (t : Nat), ¬Becoming.Seed.web.active (t + 4) ()) ∧
            (Becoming.total (Becoming.steps 0 4) fun t => Becoming.mark (Becoming.Seed.web.active t ())) =
              Becoming.Seed.reserve 0
Becoming.Seed.not_decays : ¬Becoming.Seed.web.Decays fun t x => Becoming.Seed.reserve t
Becoming.Seed.no_held (hold : Unit → Unit) : ¬Becoming.Seed.web.Carries fun t f => Becoming.Seed.web.level t (hold f)
Becoming.Viable.viability : Nat → Nat
Becoming.Viable.web : Becoming.Web Unit Unit
Becoming.Viable.dark (t : Nat) : ¬Becoming.Viable.web.Supported t ()
Becoming.Viable.carries : Becoming.Viable.web.Carries fun t x => Becoming.Viable.viability t
Becoming.Viable.decays : Becoming.Viable.web.Decays fun t x => Becoming.Viable.viability t
Becoming.Viable.viable :
  ¬Becoming.Viable.web.Dependent ∧
    (Becoming.Viable.web.Carries fun t x => Becoming.Viable.viability t) ∧
      (Becoming.Viable.web.Decays fun t x => Becoming.Viable.viability t) ∧
        Becoming.Viable.web.Arises 1 () ∧ ∀ (t : Nat), ¬Becoming.Viable.web.active (t + 3) ()
Becoming.Viable.no_held (hold : Unit → Unit) :
  ¬Becoming.Viable.web.Carries fun t f => Becoming.Viable.web.level t (hold f)
Becoming.Famine.Relatum : Type
Becoming.Famine.hare : Nat → Nat
Becoming.Famine.fat : Nat → Nat
Becoming.Famine.eats : Nat → Nat
Becoming.Famine.burns : Nat → Nat
Becoming.Famine.present : Nat → List Becoming.Famine.Relatum
Becoming.Famine.web : Becoming.Web Becoming.Famine.Relatum Becoming.Famine.Relatum
Becoming.Famine.flow : Becoming.Flow Becoming.Famine.Relatum Becoming.Famine.Relatum
Becoming.Famine.hold : Becoming.Famine.Relatum → Becoming.Famine.Relatum
Becoming.Famine.balances : Becoming.Famine.flow.Balances Becoming.Famine.web
Becoming.Famine.supported_of_ne_fox {t : Nat} (x : Becoming.Famine.Relatum) :
  ¬x = Becoming.Famine.Relatum.fox → Becoming.Famine.web.Supported t x
Becoming.Famine.fed : Becoming.Famine.web.Supported 0 Becoming.Famine.Relatum.fox
Becoming.Famine.carries : Becoming.Famine.web.Carries fun t x => Becoming.Famine.web.level t (Becoming.Famine.hold x)
Becoming.Famine.hare_embodied : Becoming.Famine.web.Embodied Becoming.Famine.Relatum.hare
Becoming.Famine.source : Nat → Becoming.Famine.Relatum
Becoming.Famine.transformed : Becoming.Web Becoming.Famine.Relatum Becoming.Famine.Relatum
Becoming.Famine.transformed_dependent : Becoming.Famine.transformed.Dependent
Becoming.Famine.decActive (t : Nat) : Decidable (Becoming.Famine.web.active t Becoming.Famine.Relatum.fox)
Becoming.Famine.undermines_one : Becoming.Web.UnderminingAt 1 Becoming.Famine.Relatum.fox
Becoming.Famine.transformed_not_undermining : ¬Becoming.Web.UnderminingAt 1 Becoming.Famine.Relatum.fox
Becoming.Famine.living_differs :
  (Becoming.Famine.web.active 1 Becoming.Famine.Relatum.fox ∧
      Becoming.Web.UnderminingAt 1 Becoming.Famine.Relatum.fox) ∧
    Becoming.Famine.transformed.active 1 Becoming.Famine.Relatum.fox ∧
      ¬Becoming.Web.UnderminingAt 1 Becoming.Famine.Relatum.fox
Becoming.Famine.famine :
  ¬Becoming.Famine.web.Dependent ∧
    (Becoming.Famine.web.Carries fun t x => Becoming.Famine.web.level t (Becoming.Famine.hold x)) ∧
      Becoming.Famine.web.Embodied Becoming.Famine.Relatum.hare ∧
        (∀ (t : Nat), 1 ≤ t → ¬Becoming.Famine.web.active t Becoming.Famine.Relatum.hare) ∧
          (∀ (t : Nat),
              1 ≤ t →
                Becoming.Famine.web.requires t Becoming.Famine.Relatum.fox Becoming.Famine.Relatum.hare ∧
                  0 < Becoming.Famine.web.need t Becoming.Famine.Relatum.fox Becoming.Famine.Relatum.hare) ∧
            Becoming.Famine.web.active 2 Becoming.Famine.Relatum.fox ∧
              (∀ (t : Nat), 3 ≤ t → ¬Becoming.Famine.web.active t Becoming.Famine.Relatum.fox) ∧
                (Becoming.total (Becoming.steps 1 2) fun t =>
                      Becoming.mark (Becoming.Famine.web.active t Becoming.Famine.Relatum.fox)) =
                    Becoming.Famine.web.level 1 (Becoming.Famine.hold Becoming.Famine.Relatum.fox) ∧
                  Becoming.Famine.transformed.Dependent
Becoming.Cascade.upto : Nat → Nat → Nat
Becoming.Cascade.upto_pos {t x : Nat} : 0 < Becoming.Cascade.upto t x ↔ t ≤ x
Becoming.Cascade.upto_le_one (t x : Nat) : Becoming.Cascade.upto t x ≤ 1
Becoming.Cascade.upto_after (x : Nat) : Becoming.Cascade.upto (x + 1) x = 0
Becoming.Cascade.upto_self (x : Nat) : Becoming.Cascade.upto x x = 1
Becoming.Cascade.web : Becoming.Web Nat Nat
Becoming.Cascade.embodied (x : Nat) : Becoming.Cascade.web.Embodied x
Becoming.Cascade.supported_of_le {t x : Nat} (le : t ≤ x) : Becoming.Cascade.web.Supported t (x + 1)
Becoming.Cascade.unsupported_late {t x : Nat} (unsupported : ¬Becoming.Cascade.web.Supported t x) : x ≤ t
Becoming.Cascade.reserve (t x : Nat) : Nat
Becoming.Cascade.falls {t x : Nat} (unsupported : ¬Becoming.Cascade.web.Supported t x) (active : t ≤ x) :
  Becoming.Cascade.reserve (t + 1) x < Becoming.Cascade.reserve t x
Becoming.Cascade.never_rises (t x : Nat) : Becoming.Cascade.reserve (t + 1) x ≤ Becoming.Cascade.reserve t x
Becoming.Cascade.carries : Becoming.Cascade.web.Carries Becoming.Cascade.reserve
Becoming.Cascade.decays : Becoming.Cascade.web.Decays Becoming.Cascade.reserve
Becoming.Cascade.ends (k : Nat) : Becoming.Web.chainEnd Becoming.Cascade.reserve (fun k => k) 1 k = k + 1
Becoming.Cascade.cascade :
  Becoming.Cascade.web.Carries Becoming.Cascade.reserve ∧
    Becoming.Cascade.web.Decays Becoming.Cascade.reserve ∧
      (∀ (x : Nat), Becoming.Cascade.web.Embodied x) ∧
        (∀ (k t : Nat), 1 ≤ t → Becoming.Cascade.web.requires t (k + 1) k ∧ 0 < Becoming.Cascade.web.need t (k + 1) k) ∧
          (∀ (t : Nat), 1 ≤ t → ¬Becoming.Cascade.web.active t 0) ∧
            ¬Becoming.Cascade.web.Dependent ∧
              ∀ (k : Nat),
                Becoming.Web.chainEnd Becoming.Cascade.reserve (fun k => k) 1 k = k + 1 ∧
                  Becoming.Cascade.web.active k k
Becoming.ShortCascade.web : Becoming.Web Nat Nat
Becoming.ShortCascade.unsupported {t x : Nat} (no : ¬Becoming.ShortCascade.web.Supported t x) :
  ¬Becoming.Cascade.web.Supported t x
Becoming.ShortCascade.carries : Becoming.ShortCascade.web.Carries Becoming.Cascade.reserve
Becoming.ShortCascade.decays : Becoming.ShortCascade.web.Decays Becoming.Cascade.reserve
Becoming.ShortCascade.ranked (t g c : Nat) : Becoming.ShortCascade.web.requires t g c → c < g ∧ g ≤ 2
Becoming.short_cascade :
  Becoming.ShortCascade.web.Carries Becoming.Cascade.reserve ∧
    Becoming.ShortCascade.web.Decays Becoming.Cascade.reserve ∧
      (∀ (t : Nat),
          Becoming.Web.chainEnd Becoming.Cascade.reserve (fun k => k) 1 2 ≤ t → ¬Becoming.ShortCascade.web.active t 2) ∧
        Becoming.Web.chainEnd Becoming.Cascade.reserve (fun k => k) 1 2 = 2 + 1 ∧
          Becoming.ShortCascade.web.active 2 2 ∧
            ∀ (chain : Nat → Nat) (T : Nat),
              ¬∀ (k t : Nat),
                  T ≤ t →
                    Becoming.ShortCascade.web.requires t (chain (k + 1)) (chain k) ∧
                      0 < Becoming.ShortCascade.web.need t (chain (k + 1)) (chain k)
