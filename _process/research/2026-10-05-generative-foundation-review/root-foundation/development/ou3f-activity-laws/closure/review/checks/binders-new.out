Becoming.Seed.held_readings :
  Becoming.Seed.web.Arises 0 () ∧
    Becoming.Seed.web.Arises 2 () ∧
      (∀ (t : Nat), (Becoming.Seed.web.persisting Becoming.Seed.web.Holds).active t ()) ∧
        (∀ (t : Nat), ¬(Becoming.Seed.web.persisting Becoming.Seed.web.Holds).Arises t ()) ∧
          (∀ (t : Nat),
              ¬(Becoming.Seed.web.persisting fun t f =>
                      Becoming.Seed.web.active t f ∨ 0 < Becoming.Seed.reserve t).Arises
                  t ()) ∧
            (Becoming.Seed.web.persisting fun t f => Becoming.Seed.web.active t f ∨ 0 < Becoming.Seed.reserve t).Ceases
              3 ()
Becoming.Sleeper.held_readings :
  Becoming.Sleeper.web.Unceasing ∧
    (∀ (N : Nat), ∃ t, N ≤ t ∧ Becoming.Sleeper.web.Ceases t ()) ∧
      ∀ (t : Nat),
        ¬(Becoming.Sleeper.web.persisting fun t x =>
                Becoming.Sleeper.web.active t x ∨ 0 < Becoming.Sleeper.web.level t x).Arises
            t ()
Becoming.World.reidentify (w : Becoming.World) {R' : Type} (σ : Becoming.Reidentify w.Relatum R') : Becoming.World
Becoming.World.Conserves (w : Becoming.World) (t : Nat) (g f : w.Relatum) : Prop
Becoming.World.reidentify_taken {w : Becoming.World} {R' : Type} (σ : Becoming.Reidentify w.Relatum R') (t : Nat)
  (y : R') : (w.reidentify σ).flow.taken t y = w.flow.taken t (σ.old t y)
Becoming.World.reidentify_given {w : Becoming.World} {R' : Type} (σ : Becoming.Reidentify w.Relatum R') (t : Nat)
  (y : R') : (w.reidentify σ).flow.given t y = w.flow.given t (σ.old t y)
Becoming.World.balanced_iff_conserves {w : Becoming.World} : w.Balanced ↔ ∀ (t : Nat) (c : w.Relatum), w.Conserves t c c
Becoming.World.balanced_reidentify_iff {w : Becoming.World} {R' : Type} (σ : Becoming.Reidentify w.Relatum R') :
  (w.reidentify σ).Balanced ↔ ∀ (t : Nat) (c : w.Relatum), w.Conserves t c (σ.old (t + 1) (σ.new t c))
Becoming.World.conserves_iff {w : Becoming.World} (balanced : w.Balanced) {t : Nat} {g f : w.Relatum} :
  w.Conserves t g f ↔ w.web.level (t + 1) f = w.web.level (t + 1) g
Becoming.World.balanced_reidentify_iff_alike {w : Becoming.World} {R' : Type} (balanced : w.Balanced)
  (σ : Becoming.Reidentify w.Relatum R') :
  (w.reidentify σ).Balanced ↔
    ∀ (t : Nat),
      Becoming.Alike (Becoming.exchangeFrame w.Relatum) (Becoming.exchangeFrame w.Relatum)
        (fun c => w.web.level (t + 1) (σ.old (t + 1) (σ.new t c))) (w.web.level (t + 1))
Becoming.World.standing_after {w : Becoming.World} {R' : Type} (balanced : w.Balanced)
  {σ : Becoming.Reidentify w.Relatum R'} (kept : (w.reidentify σ).Balanced) (t : Nat) (y : R') :
  w.web.level (t + 1) (σ.old (t + 1) y) = w.web.level (t + 1) (σ.old t y)
Becoming.World.kept_broken_reidentify {w : Becoming.World} {R' : Type} (balanced : w.Balanced)
  {σ : Becoming.Reidentify w.Relatum R'} (kept : (w.reidentify σ).Balanced) (t : Nat) (x y : R') :
  ((w.reidentify σ).web.Kept t x y ↔ w.web.Kept t (σ.old t x) (σ.old t y)) ∧
    ((w.reidentify σ).web.Broken t x y ↔ w.web.Broken t (σ.old t x) (σ.old t y))
Becoming.transpose {X : Type} [DecidableEq X] (c d x : X) : X
Becoming.transpose_left {X : Type} [DecidableEq X] (c d : X) : Becoming.transpose c d c = d
Becoming.transpose_right {X : Type} [DecidableEq X] (c d : X) : Becoming.transpose c d d = c
Becoming.transpose_other {X : Type} [DecidableEq X] {c d x : X} (not_c : ¬x = c) (not_d : ¬x = d) :
  Becoming.transpose c d x = x
Becoming.transpose_transpose {X : Type} [DecidableEq X] (c d x : X) :
  Becoming.transpose c d (Becoming.transpose c d x) = x
Becoming.transpose_alike {X : Type} [DecidableEq X] {q : X → Nat} {c d : X} (alike : q d = q c) (x : X) :
  q (Becoming.transpose c d x) = q x
Becoming.stepBeyond : Nat → Nat → Bool
Becoming.stepBeyond_self (t : Nat) : Becoming.stepBeyond t t = false
Becoming.stepBeyond_next (t : Nat) : Becoming.stepBeyond t (t + 1) = true
Becoming.stepBeyond_zero (t : Nat) : Becoming.stepBeyond t 0 = false
Becoming.stepBeyond_step (t s : Nat) : ¬s = t → Becoming.stepBeyond t (s + 1) = Becoming.stepBeyond t s
Becoming.Reidentify.exchangeAfter {X : Type} [DecidableEq X] (t : Nat) (c d : X) : Becoming.Reidentify X X
Becoming.Reidentify.exchangeAfter_at {X : Type} [DecidableEq X] (t : Nat) (c d x : X) :
  (Becoming.Reidentify.exchangeAfter t c d).old t x = x ∧ (Becoming.Reidentify.exchangeAfter t c d).new t x = x
Becoming.Reidentify.exchangeAfter_next {X : Type} [DecidableEq X] (t : Nat) (c d x : X) :
  (Becoming.Reidentify.exchangeAfter t c d).new (t + 1) x = Becoming.transpose c d x
Becoming.Reidentify.exchangeAfter_across {X : Type} [DecidableEq X] (t : Nat) (c d x : X) :
  (Becoming.Reidentify.exchangeAfter t c d).old (t + 1) ((Becoming.Reidentify.exchangeAfter t c d).new t x) =
    Becoming.transpose c d x
Becoming.Reidentify.exchangeAfter_elsewhere {X : Type} [DecidableEq X] {t s : Nat} (other : ¬s = t) (c d x : X) :
  (Becoming.Reidentify.exchangeAfter t c d).old (s + 1) ((Becoming.Reidentify.exchangeAfter t c d).new s x) = x
Becoming.World.exchangeAfter_balanced {w : Becoming.World} [dec : DecidableEq w.Relatum] (balanced : w.Balanced)
  {t : Nat} {c d : w.Relatum} (alike : w.web.level (t + 1) d = w.web.level (t + 1) c) :
  (w.reidentify (Becoming.Reidentify.exchangeAfter t c d)).Balanced
Becoming.World.fixed_iff {w : Becoming.World} [dec : DecidableEq w.Relatum] (balanced : w.Balanced) (t : Nat)
  (c : w.Relatum) :
  (∀ (σ : Becoming.Reidentify w.Relatum w.Relatum), (w.reidentify σ).Balanced → σ.old (t + 1) (σ.new t c) = c) ↔
    ∀ (d : w.Relatum), w.web.level (t + 1) d = w.web.level (t + 1) c → d = c
Becoming.World.arises_fixed_iff {w : Becoming.World} [dec : DecidableEq w.Relatum] (balanced : w.Balanced) (t : Nat)
  (f : w.Relatum) :
  (∀ (σ : Becoming.Reidentify w.Relatum w.Relatum),
      (w.reidentify σ).Balanced → (w.reidentify σ).web.Arises t (σ.new (t + 1) f)) ↔
    w.web.ArisesFrom w.Conserves t f
Becoming.World.ceases_fixed_iff {w : Becoming.World} [dec : DecidableEq w.Relatum] (balanced : w.Balanced) (t : Nat)
  (g : w.Relatum) :
  (∀ (σ : Becoming.Reidentify w.Relatum w.Relatum),
      (w.reidentify σ).Balanced → (w.reidentify σ).web.Ceases t (σ.new t g)) ↔
    w.web.CeasesFrom w.Conserves t g
Becoming.World.conserves_noSplit {w : Becoming.World} (balanced : w.Balanced)
  (apart :
    ∀ (t : Nat) (f f' : w.Relatum),
      w.web.active (t + 1) f → w.web.active (t + 1) f' → w.web.level (t + 1) f = w.web.level (t + 1) f' → f = f') :
  w.web.NoSplit w.Conserves
Becoming.World.conserves_noMerge {w : Becoming.World} (balanced : w.Balanced)
  (apart :
    ∀ (t : Nat) (g g' : w.Relatum),
      w.web.active t g → w.web.active t g' → w.web.level (t + 1) g = w.web.level (t + 1) g' → g = g') :
  w.web.NoMerge w.Conserves
Becoming.World.still_of_apart {w : Becoming.World} {R' : Type} (balanced : w.Balanced)
  (apart : ∀ (t : Nat) (c d : w.Relatum), w.web.level (t + 1) c = w.web.level (t + 1) d → c = d)
  {σ : Becoming.Reidentify w.Relatum R'} (kept : (w.reidentify σ).Balanced) (t : Nat) (x : R') :
  σ.old (t + 1) x = σ.old t x
Becoming.Reidentify.old_still {F F' : Type} {σ : Becoming.Reidentify F F'}
  (still : ∀ (t : Nat) (x : F'), σ.old (t + 1) x = σ.old t x) (t : Nat) (x : F') : σ.old t x = σ.old 0 x
Becoming.World.renewed_still {w : Becoming.World} {R' : Type} {σ : Becoming.Reidentify w.Relatum R'}
  (still : ∀ (t : Nat) (x : R'), σ.old (t + 1) x = σ.old t x) (y : R') :
  (w.reidentify σ).web.Renewed y ↔ w.web.Renewed (σ.old 0 y)
Becoming.World.consumed_still {w : Becoming.World} {R' : Type} {σ : Becoming.Reidentify w.Relatum R'}
  (still : ∀ (t : Nat) (x : R'), σ.old (t + 1) x = σ.old t x) (y : R') :
  (w.reidentify σ).web.Consumed y ↔ w.web.Consumed (σ.old 0 y)
Becoming.World.classes_still {w : Becoming.World} {R' : Type} {σ : Becoming.Reidentify w.Relatum R'}
  (still : ∀ (t : Nat) (x : R'), σ.old (t + 1) x = σ.old t x) (x : R') :
  ((w.reidentify σ).web.RenewingIn x ↔ w.web.RenewingIn (σ.old 0 x)) ∧
    ((w.reidentify σ).web.ConsumingIn x ↔ w.web.ConsumingIn (σ.old 0 x)) ∧
      ∀ (t : Nat), (w.reidentify σ).web.Arises t x ↔ w.web.Arises t (σ.old 0 x)
Becoming.World.classes_fixed {w : Becoming.World} {R' : Type} (balanced : w.Balanced)
  (apart : ∀ (t : Nat) (c d : w.Relatum), w.web.level (t + 1) c = w.web.level (t + 1) d → c = d)
  {σ : Becoming.Reidentify w.Relatum R'} (kept : (w.reidentify σ).Balanced) (x : R') :
  ((w.reidentify σ).web.RenewingIn x ↔ w.web.RenewingIn (σ.old 0 x)) ∧
    ((w.reidentify σ).web.ConsumingIn x ↔ w.web.ConsumingIn (σ.old 0 x)) ∧
      ∀ (t : Nat), (w.reidentify σ).web.Arises t x ↔ w.web.Arises t (σ.old 0 x)
Becoming.Reidentify.roles {F F' C : Type} (σ : Becoming.Reidentify F F') : Becoming.Reidentify (F ⊕ C) (F' ⊕ C)
Becoming.World.ofRoles_reidentify_balanced {F F' C : Type} (L : Becoming.Flow F C) (W : Becoming.Web F C)
  (σ : Becoming.Reidentify F F') : ((Becoming.World.ofRoles L W).reidentify σ.roles).Balanced ↔ L.Balances W
Becoming.World.ofRoles_reidentify_arises {F F' C : Type} (L : Becoming.Flow F C) (W : Becoming.Web F C)
  (σ : Becoming.Reidentify F F') (t : Nat) (x : F') :
  ((Becoming.World.ofRoles L W).reidentify σ.roles).web.Arises t (Sum.inl x) ↔ (W.reidentify σ).Arises t x
Becoming.World.ofRoles_reidentify_unceasing {F F' C : Type} (L : Becoming.Flow F C) (W : Becoming.Web F C)
  (σ : Becoming.Reidentify F F') :
  ((Becoming.World.ofRoles L W).reidentify σ.roles).web.Unceasing ↔ (W.reidentify σ).Unceasing
Becoming.World.ofRoles_reidentify_renewed {F F' C : Type} (L : Becoming.Flow F C) (W : Becoming.Web F C)
  (σ : Becoming.Reidentify F F') (c : C) :
  ((Becoming.World.ofRoles L W).reidentify σ.roles).web.Renewed (Sum.inr c) ↔ W.Renewed c
Becoming.World.ofRoles_reidentify_renewed_formation {F F' C : Type} (L : Becoming.Flow F C) (W : Becoming.Web F C)
  (σ : Becoming.Reidentify F F') (f : F') : ((Becoming.World.ofRoles L W).reidentify σ.roles).web.Renewed (Sum.inl f)
Becoming.World.ofRoles_reidentify_consumed {F F' C : Type} (L : Becoming.Flow F C) (W : Becoming.Web F C)
  (σ : Becoming.Reidentify F F') (c : C) :
  ((Becoming.World.ofRoles L W).reidentify σ.roles).web.Consumed (Sum.inr c) ↔ W.Consumed c
Becoming.World.ofRoles_reidentify_renewingIn {F F' C : Type} (L : Becoming.Flow F C) (W : Becoming.Web F C)
  (σ : Becoming.Reidentify F F') (x : F') :
  ((Becoming.World.ofRoles L W).reidentify σ.roles).web.RenewingIn (Sum.inl x) ↔ (W.reidentify σ).RenewingIn x
Becoming.World.ofRoles_reidentify_consumingIn {F F' C : Type} (L : Becoming.Flow F C) (W : Becoming.Web F C)
  (σ : Becoming.Reidentify F F') (x : F') :
  ((Becoming.World.ofRoles L W).reidentify σ.roles).web.ConsumingIn (Sum.inl x) ↔ (W.reidentify σ).ConsumingIn x
Becoming.Shuttle.holder_only (t : Nat) (g : Bool) : 0 < Becoming.Shuttle.stands g t → g = Becoming.Shuttle.holder t
Becoming.Shuttle.asOne : Becoming.Reidentify Bool Bool
Becoming.Shuttle.conserved :
  (∀ (t : Nat),
      Becoming.World.shuttle.web.ArisesFrom Becoming.World.shuttle.Conserves t (Becoming.Shuttle.holder (t + 1))) ∧
    (∀ (σ : Becoming.Reidentify Bool Bool),
        (Becoming.World.shuttle.reidentify σ).Balanced → (Becoming.World.shuttle.reidentify σ).web.Unceasing) ∧
      Becoming.Shuttle.asOne.KeepsActive Becoming.World.shuttle.web ∧
        ¬(Becoming.World.shuttle.reidentify Becoming.Shuttle.asOne).Balanced
Becoming.Shuttle.alternates (t : Nat) :
  Becoming.Shuttle.even t = 1 ∧ Becoming.Shuttle.even (t + 1) = 0 ∨
    Becoming.Shuttle.even t = 0 ∧ Becoming.Shuttle.even (t + 1) = 1
Becoming.Shuttle.apart (t : Nat) (c d : Bool) :
  Becoming.Shuttle.stands c (t + 1) = Becoming.Shuttle.stands d (t + 1) → c = d
Becoming.Shuttle.named_as_themselves {σ : Becoming.Reidentify Bool Bool}
  (kept : (Becoming.World.shuttle.reidentify σ).Balanced) :
  (∀ (t : Nat) (x : Bool), σ.old t x = σ.old 0 x) ∧
    ∀ (x : (Becoming.World.shuttle.reidentify σ).Relatum) (t : Nat),
      (Becoming.World.shuttle.reidentify σ).web.Arises t x ↔ Becoming.World.shuttle.web.Arises t (σ.old 0 x)
Becoming.Lineage.world_readings :
  (Becoming.World.ofRoles Becoming.Flow.still Becoming.Lineage.web).Balanced ∧
    ((Becoming.World.ofRoles Becoming.Flow.still Becoming.Lineage.web).reidentify Becoming.Lineage.one.roles).Balanced ∧
      (Becoming.World.ofRoles Becoming.Flow.still Becoming.Lineage.web).web.Unceasing ∧
        (∀ (t : Nat)
            (x :
              ((Becoming.World.ofRoles Becoming.Flow.still Becoming.Lineage.web).reidentify
                  Becoming.Lineage.one.roles).Relatum),
            ¬((Becoming.World.ofRoles Becoming.Flow.still Becoming.Lineage.web).reidentify
                      Becoming.Lineage.one.roles).web.Arises
                t x) ∧
          ∀ (t : Nat) (x : (Becoming.World.ofRoles Becoming.Flow.still Becoming.Lineage.web).Relatum),
            ¬(Becoming.World.ofRoles Becoming.Flow.still Becoming.Lineage.web).web.ArisesFrom
                (Becoming.World.ofRoles Becoming.Flow.still Becoming.Lineage.web).Conserves t x
Becoming.Hibernation.world_readings :
  (Becoming.World.ofRoles Becoming.Flow.still Becoming.Hibernation.web).Balanced ∧
    ((Becoming.World.ofRoles Becoming.Flow.still Becoming.Hibernation.web).reidentify
          Becoming.Hibernation.exchange.roles).Balanced ∧
      (Becoming.World.ofRoles Becoming.Flow.still Becoming.Hibernation.web).web.RenewingIn
          (Sum.inl Becoming.Hibernation.Formation.hibernator) ∧
        ((Becoming.World.ofRoles Becoming.Flow.still Becoming.Hibernation.web).reidentify
                  Becoming.Hibernation.exchange.roles).web.ConsumingIn
            (Sum.inl Becoming.Hibernation.Formation.hibernator) ∧
          ¬((Becoming.World.ofRoles Becoming.Flow.still Becoming.Hibernation.web).reidentify
                    Becoming.Hibernation.exchange.roles).web.RenewingIn
              (Sum.inl Becoming.Hibernation.Formation.hibernator)
Becoming.Web.stateClass {F C : Type} (W : Becoming.Web F C) (h : Nat → F → Prop) : Becoming.«际» (Nat × F)
Becoming.Web.stateClass_class {F C : Type} (W : Becoming.Web F C) (h : Nat → F → Prop) : Becoming.«类» (W.stateClass h)
Becoming.Web.stateClass_finer {F C : Type} (W : Becoming.Web F C) (h : Nat → F → Prop) :
  Becoming.«则» (W.stateClass h) (W.persisting h).activityClass
Becoming.Web.wang_state_of_change {F C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop} {t : Nat} {f : F}
  (change : ¬(W.active t f ↔ W.active (t + 1) f)) :
  Becoming.«亡» (Becoming.Web.continuationStep fun x g f => g = f) (W.stateClass h) (t, f)
Becoming.Web.sheng_state_of_change {F C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop} {t : Nat} {f : F}
  (change : ¬(W.active t f ↔ W.active (t + 1) f)) :
  Becoming.«生» (Becoming.Web.continuationStep fun x g f => g = f) (W.stateClass h) (t + 1, f)
Becoming.Web.ceases_iff_wang_state {F C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop}
  (within : ∀ (t : Nat) (f : F), W.active t f → h t f) {t : Nat} {f : F} :
  W.Ceases t f ↔ W.active t f ∧ Becoming.«亡» (Becoming.Web.continuationStep fun x g f => g = f) (W.stateClass h) (t, f)
Becoming.Web.arises_iff_sheng_state {F C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop}
  (within : ∀ (t : Nat) (f : F), W.active t f → h t f) {t : Nat} {f : F} :
  W.Arises t f ↔
    W.active (t + 1) f ∧ Becoming.«生» (Becoming.Web.continuationStep fun x g f => g = f) (W.stateClass h) (t + 1, f)
Becoming.Web.ceases_of_persisting_ceases {F C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop}
  (within : ∀ (t : Nat) (f : F), W.active t f → h t f) {t : Nat} {f : F} (ceases : (W.persisting h).Ceases t f)
  (before : W.active t f) : W.Ceases t f
Becoming.Web.arises_of_persisting_arises {F C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop}
  (within : ∀ (t : Nat) (f : F), W.active t f → h t f) {t : Nat} {f : F} (arises : (W.persisting h).Arises t f)
  (after : W.active (t + 1) f) : W.Arises t f
Becoming.Web.fallsDormant_alters {F C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop}
  (within : ∀ (t : Nat) (f : F), W.active t f → h t f) {t : Nat} {f : F} (before : W.active t f)
  (dormant : ¬W.active (t + 1) f) (held : h (t + 1) f) :
  Becoming.«亡» (Becoming.Web.continuationStep fun x g f => g = f) (W.stateClass h) (t, f) ∧
    Becoming.«异» (Becoming.Web.continuationStep fun x g f => g = f) (W.persisting h).activityClass (W.stateClass h)
      (t, f) (t + 1, f)
Becoming.Web.wakes_alters {F C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop}
  (within : ∀ (t : Nat) (f : F), W.active t f → h t f) {t : Nat} {f : F} (held : h t f) (dormant : ¬W.active t f)
  (after : W.active (t + 1) f) :
  Becoming.«生» (Becoming.Web.continuationStep fun x g f => g = f) (W.stateClass h) (t + 1, f) ∧
    Becoming.«异» (Becoming.Web.continuationStep fun x g f => g = f) (W.persisting h).activityClass (W.stateClass h)
      (t, f) (t + 1, f)
Becoming.Web.names_line_same {F : Type} {E : Becoming.«际» (Nat × F)} {x y : Nat × F}
  (line : Becoming.«相续» (Becoming.Web.continuationStep fun x g f => g = f) E x y) : x.snd = y.snd
Becoming.Web.unending_of_holds {F C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop} {f : F}
  (always : ∀ (s : Nat), h s f) (t : Nat) :
  Becoming.«不穷» (Becoming.Web.continuationStep fun x g f => g = f) (W.persisting h).activityClass (t, f)
Becoming.World.arises_fixed_iff_sheng {w : Becoming.World} [dec : DecidableEq w.Relatum] (balanced : w.Balanced)
  (t : Nat) (f : w.Relatum) :
  (∀ (σ : Becoming.Reidentify w.Relatum w.Relatum),
      (w.reidentify σ).Balanced → (w.reidentify σ).web.Arises t (σ.new (t + 1) f)) ↔
    w.web.active (t + 1) f ∧ Becoming.«生» (Becoming.Web.continuationStep w.Conserves) w.web.activityClass (t + 1, f)
Becoming.World.ceases_fixed_iff_wang {w : Becoming.World} [dec : DecidableEq w.Relatum] (balanced : w.Balanced)
  (t : Nat) (g : w.Relatum) :
  (∀ (σ : Becoming.Reidentify w.Relatum w.Relatum),
      (w.reidentify σ).Balanced → (w.reidentify σ).web.Ceases t (σ.new t g)) ↔
    w.web.active t g ∧ Becoming.«亡» (Becoming.Web.continuationStep w.Conserves) w.web.activityClass (t, g)
Becoming.Hibernation.positions :
  Becoming.«则» (Becoming.Hibernation.web.stateClass Becoming.Hibernation.web.Holds)
      (Becoming.Hibernation.web.persisting Becoming.Hibernation.web.Holds).activityClass ∧
    Becoming.«亡» (Becoming.Web.continuationStep fun x g f => g = f)
        (Becoming.Hibernation.web.stateClass Becoming.Hibernation.web.Holds)
        (0, Becoming.Hibernation.Formation.hibernator) ∧
      ¬Becoming.«亡» (Becoming.Web.continuationStep fun x g f => g = f)
            (Becoming.Hibernation.web.persisting Becoming.Hibernation.web.Holds).activityClass
            (0, Becoming.Hibernation.Formation.hibernator) ∧
        Becoming.«住» (Becoming.Web.continuationStep fun x g f => g = f)
            (Becoming.Hibernation.web.persisting Becoming.Hibernation.web.Holds).activityClass
            (1, Becoming.Hibernation.Formation.hibernator) ∧
          Becoming.«生» (Becoming.Web.continuationStep fun x g f => g = f)
              (Becoming.Hibernation.web.stateClass Becoming.Hibernation.web.Holds)
              (1, Becoming.Hibernation.Formation.hibernator) ∧
            Becoming.«亡» (Becoming.Web.continuationStep fun x g f => g = f)
                (Becoming.Hibernation.web.stateClass Becoming.Hibernation.web.Holds)
                (1, Becoming.Hibernation.Formation.hibernator) ∧
              Becoming.«不穷» (Becoming.Web.continuationStep fun x g f => g = f)
                (Becoming.Hibernation.web.persisting Becoming.Hibernation.web.Holds).activityClass
                (0, Becoming.Hibernation.Formation.hibernator)
Becoming.Seed.held_classes :
  (∀ (t : Nat),
      Becoming.«不穷» (Becoming.Web.continuationStep fun x g f => g = f)
        (Becoming.Seed.web.persisting Becoming.Seed.web.Holds).activityClass (t, ())) ∧
    Becoming.«亡» (Becoming.Web.continuationStep fun x g f => g = f)
      (Becoming.Seed.web.persisting fun t f => Becoming.Seed.web.active t f ∨ 0 < Becoming.Seed.reserve t).activityClass
      (3, ())
