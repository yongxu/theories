  (whole : W.Whole parts w) (arising : ∀ (S : Nat), T ≤ S → ∃ j p, j < d ∧ parts p ∧ W.Arises (S + j) p)
  (lasts : ∀ (t : Nat) (p : F), parts p → W.Arises t p → ∀ (i : Nat), i < d → W.active (t + 1 + i) p) (t : Nat) :
  T + d ≤ t → W.active t w
