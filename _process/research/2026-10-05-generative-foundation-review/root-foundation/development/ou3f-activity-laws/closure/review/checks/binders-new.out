  Becoming.ArisingGiver.flow.Balances Becoming.ArisingGiver.web ∧
    Becoming.ArisingGiver.flow.Taking Becoming.ArisingGiver.web ∧
      Becoming.ArisingGiver.flow.Acting Becoming.ArisingGiver.web ∧
        ¬Becoming.ArisingGiver.web.active 0 true ∧
