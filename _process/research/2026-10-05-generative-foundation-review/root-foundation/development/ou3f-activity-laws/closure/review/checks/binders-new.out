Becoming.Web.chainEnd_ge {X : Type} (r : Nat → X → Nat) (chain : Nat → X) (T k : Nat) :
  T ≤ Becoming.Web.chainEnd r chain T k
Becoming.Web.chainEnd_zero {X : Type} (chain : Nat → X) (T k : Nat) :
  Becoming.Web.chainEnd (fun x x_1 => 0) chain T k = T
Becoming.Web.chain_ends_from {X : Type} {W : Becoming.Web X X} {r : Nat → X → Nat} {chain : Nat → X} {n T : Nat}
  (carries : ∀ (k t : Nat), k < n → T ≤ t → W.CarriesAcross r t (chain (k + 1)))
  (decays : ∀ (k t : Nat), k < n → T ≤ t → W.DecaysAcross r t (chain (k + 1)))
  (embodied : ∀ (k : Nat), k < n → W.Embodied (chain k))
  (bears :
    ∀ (k t : Nat), k < n → T ≤ t → W.requires t (chain (k + 1)) (chain k) ∧ 0 < W.need t (chain (k + 1)) (chain k))
  (ended : ∀ (t : Nat), T ≤ t → ¬W.active t (chain 0)) (k : Nat) :
  k ≤ n → ∀ (t : Nat), Becoming.Web.chainEnd r chain T k ≤ t → ¬W.active t (chain k)
