  {y g : X} (embodied : W.Embodied y) {T : Nat} (bears : ∀ (t : Nat), T ≤ t → W.requires t g y ∧ 0 < W.need t g y)
  (ended : ∀ (t : Nat), T ≤ t → ¬W.active t y) : ¬∀ (N : Nat), ∃ t, N ≤ t ∧ W.active t g
