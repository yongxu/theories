  (ranked : ∀ (t : Nat) (g c : X), W.requires t g c → ρ c < ρ g ∧ ρ g ≤ K) {chain : Nat → X} {T : Nat}
  (bears : ∀ (k t : Nat), T ≤ t → W.requires t (chain (k + 1)) (chain k) ∧ 0 < W.need t (chain (k + 1)) (chain k)) :
  False
