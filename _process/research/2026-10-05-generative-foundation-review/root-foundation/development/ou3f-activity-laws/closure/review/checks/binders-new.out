  (carries : ∀ (t : Nat), S ≤ t → t ≤ S + n → W.CarriesAcross r t f)
  (decays : ∀ (t : Nat), S ≤ t → t < S + n → W.DecaysAcross r t f)
  (unsupported : ∀ (t : Nat), S ≤ t → t ≤ S + n → ¬W.Supported t f) (spent : r S f ≤ n)
  (final : ∀ (t : Nat), S + n ≤ t → ¬W.active t f → r t f = 0 → ¬W.Arises t f ∧ r (t + 1) f = 0) (k : Nat) :
  ¬W.active (S + n + k) f
