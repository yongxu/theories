@bounded : {F Pos : Type} → (Pos → F → Prop) → Pos → Nat → F → Prop
@Web.Retains : {F C Pos : Type} → Web F C → (Pos → Nat → F → Prop) → Pos → (Nat → C → Nat) → (Nat → C → Nat) → Prop
@Web.Adds : {F C Pos : Type} → Web F C → (Pos → Nat → F → Prop) → Pos → (Nat → C → Nat) → (Nat → C → Nat) → Prop
@Web.Retains.refl : ∀ {F C Pos : Type} {W : Web F C} (sig : Pos → Nat → F → Prop) (p : Pos) (l : Nat → C → Nat),
  W.Retains sig p l l
@Web.Retains.trans : ∀ {F C Pos : Type} {W : Web F C} {sig : Pos → Nat → F → Prop} {p : Pos} {l l' l'' : Nat → C → Nat},
  W.Retains sig p l l' → W.Retains sig p l' l'' → W.Retains sig p l l''
@Web.Retains.not_added : ∀ {F C Pos : Type} {W : Web F C} {sig : Pos → Nat → F → Prop} {p : Pos} {l l' : Nat → C → Nat},
  W.Retains sig p l l' → ¬W.Adds sig p l' l
@Web.Includes.retains : ∀ {F C Pos : Type} {W : Web F C} {l l' : Nat → C → Nat},
  W.Includes l l' → ∀ (sig : Pos → Nat → F → Prop) (p : Pos), W.Retains sig p l l'
@Web.Adds.exceeds : ∀ {F C Pos : Type} {W : Web F C} {sig : Pos → Nat → F → Prop} {p : Pos} {l l' : Nat → C → Nat},
  W.Adds sig p l l' → W.Exceeds l l'
@Web.Retains.of_fewer : ∀ {F C Pos : Type} {W : Web F C} {sig sig' : Pos → Nat → F → Prop},
  (∀ (p : Pos) (t : Nat) (f : F), sig' p t f → sig p t f) →
    ∀ {p : Pos} {l l' : Nat → C → Nat}, W.Retains sig p l l' → W.Retains sig' p l l'
@Web.retains_bounded_iff : ∀ {F C Pos : Type} {W : Web F C} {region : Pos → F → Prop} {p : Pos} {l l' : Nat → C → Nat},
  W.Retains (bounded region) p l l' ↔ ∀ (t : Nat), W.AdmitsWithin (region p) (l t) (l' t) t
@Web.exceeded_of_below : ∀ {F C : Type} {W : Web F C} {l : Nat → C → Nat} {s : Nat} {g : F} {c : C},
  W.requires s g c → W.level s c < W.need s g c → W.Admits (l s) s g → W.Exceeds l W.level
@Web.UnderminingOn.exceeded : ∀ {F C : Type} {W : Web F C} {l : Nat → C → Nat} {t : Nat} {f : F} {c : C},
  Web.UnderminingOn t f c →
    (∀ (g : F), W.requires t g c → W.requires (t + 1) g c ∧ W.need t g c ≤ W.need (t + 1) g c) →
      (∀ (g : F), W.requires t g c → W.Admits (l (t + 1)) (t + 1) g) → W.Exceeds l W.level
@Web.Includes.not_undermining : ∀ {F C : Type} {W : Web F C} {l : Nat → C → Nat},
  W.Includes W.level l →
    ∀ {t : Nat} {f : F} {c : C},
      (∀ (g : F), W.requires t g c → W.requires (t + 1) g c ∧ W.need t g c ≤ W.need (t + 1) g c) →
        (∀ (g : F), W.requires t g c → W.Admits (l (t + 1)) (t + 1) g) → ¬Web.UnderminingOn t f c
@Web.UnderminingOn.not_retains : ∀ {F C Pos : Type} {W : Web F C} {l : Nat → C → Nat} {t : Nat} {f : F} {c : C},
  Web.UnderminingOn t f c →
    (∀ (g : F), W.requires t g c → W.requires (t + 1) g c ∧ W.need t g c ≤ W.need (t + 1) g c) →
      (∀ (g : F), W.requires t g c → W.Admits (l (t + 1)) (t + 1) g) →
        ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
          (∀ (g : F), W.requires t g c → sig p (t + 1) g) → ¬W.Retains sig p W.level l
@Web.inactive_of_not_arising : ∀ {F C : Type} {W : Web F C} {f : F},
  ¬W.active 0 f → (∀ (t : Nat), ¬W.Arises t f) → ∀ (t : Nat), ¬W.active t f
@Flow.retains_iff_within_margin_at : ∀ {F C Pos : Type} {L : Flow F C} {part : F → Bool} {W : Web F C}
  {l : Nat → C → Nat},
  L.WithheldLevels part W l →
    ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
      (∀ (t : Nat) (f : F),
          sig p t f → W.Admits (l t) t f → ∀ (c : C), W.requires t f c → ∀ (s : Nat), s < t → L.BalancesOn W [c] s) →
        (W.Retains sig p W.level l ↔
          ∀ (t : Nat) (f : F),
            sig p t f →
              W.Admits (l t) t f →
                ∀ (c : C),
                  W.requires t f c →
                    (W.need t f c + total (steps 0 t) fun s => L.partTaken part s c) ≤
                      l t c + total (steps 0 t) fun s => L.partGiven part s c)
@Flow.loses_iff_beyond_margin_at : ∀ {F C Pos : Type} {L : Flow F C} {part : F → Bool} {W : Web F C}
  {l : Nat → C → Nat},
  L.WithheldLevels part W l →
    ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
      (∀ (t : Nat) (f : F),
          sig p t f → W.Admits (l t) t f → ∀ (c : C), W.requires t f c → ∀ (s : Nat), s < t → L.BalancesOn W [c] s) →
        (W.Adds sig p l W.level ↔
          ∃ t f,
            sig p t f ∧
              W.Admits (l t) t f ∧
                ¬∀ (c : C),
                    W.requires t f c →
                      (W.need t f c + total (steps 0 t) fun s => L.partTaken part s c) ≤
                        l t c + total (steps 0 t) fun s => L.partGiven part s c)
@Flow.adds_iff_within_margin_at : ∀ {F C Pos : Type} {L : Flow F C} {part : F → Bool} {W : Web F C} {l : Nat → C → Nat},
  L.WithheldLevels part W l →
    ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
      (∀ (t : Nat) (f : F),
          sig p t f → ¬W.Admits (l t) t f → ∀ (c : C), W.requires t f c → ∀ (s : Nat), s < t → L.BalancesOn W [c] s) →
        (W.Adds sig p W.level l ↔
          ∃ t f,
            sig p t f ∧
              (∀ (c : C),
                  W.requires t f c →
                    (W.need t f c + total (steps 0 t) fun s => L.partTaken part s c) ≤
                      l t c + total (steps 0 t) fun s => L.partGiven part s c) ∧
                ¬W.Admits (l t) t f)
@Flow.Balances.retains_iff_within_margin : ∀ {F C Pos : Type} {L : Flow F C} {part : F → Bool} {W : Web F C},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
          W.Retains sig p W.level l ↔
            ∀ (t : Nat) (f : F),
              sig p t f →
                W.Admits (l t) t f →
                  ∀ (c : C),
                    W.requires t f c →
                      (W.need t f c + total (steps 0 t) fun s => L.partTaken part s c) ≤
                        l t c + total (steps 0 t) fun s => L.partGiven part s c
@Flow.Balances.loses_iff_beyond_margin : ∀ {F C Pos : Type} {L : Flow F C} {part : F → Bool} {W : Web F C},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
          W.Adds sig p l W.level ↔
            ∃ t f,
              sig p t f ∧
                W.Admits (l t) t f ∧
                  ¬∀ (c : C),
                      W.requires t f c →
                        (W.need t f c + total (steps 0 t) fun s => L.partTaken part s c) ≤
                          l t c + total (steps 0 t) fun s => L.partGiven part s c
@Flow.Balances.adds_iff_within_margin : ∀ {F C Pos : Type} {L : Flow F C} {part : F → Bool} {W : Web F C},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
          W.Adds sig p W.level l ↔
            ∃ t f,
              sig p t f ∧
                (∀ (c : C),
                    W.requires t f c →
                      (W.need t f c + total (steps 0 t) fun s => L.partTaken part s c) ≤
                        l t c + total (steps 0 t) fun s => L.partGiven part s c) ∧
                  ¬W.Admits (l t) t f
@Flow.widens_iff_within_margin_at : ∀ {F C : Type} {L : Flow F C} {part : F → Bool} {W : Web F C} {l : Nat → C → Nat},
  L.WithheldLevels part W l →
    (∀ (t : Nat) (f : F) (c : C), W.requires t f c → ∀ (s : Nat), s < t → L.BalancesOn W [c] s) →
      (W.Widens W.level l ↔
        (∀ (t : Nat) (f : F),
            W.Admits (l t) t f →
              ∀ (c : C),
                W.requires t f c →
                  (W.need t f c + total (steps 0 t) fun s => L.partTaken part s c) ≤
                    l t c + total (steps 0 t) fun s => L.partGiven part s c) ∧
          ∃ t f,
            (∀ (c : C),
                W.requires t f c →
                  (W.need t f c + total (steps 0 t) fun s => L.partTaken part s c) ≤
                    l t c + total (steps 0 t) fun s => L.partGiven part s c) ∧
              ¬W.Admits (l t) t f)
@Flow.Balances.widens_iff_within_margin : ∀ {F C : Type} {L : Flow F C} {part : F → Bool} {W : Web F C},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        (W.Widens W.level l ↔
          (∀ (t : Nat) (f : F),
              W.Admits (l t) t f →
                ∀ (c : C),
                  W.requires t f c →
                    (W.need t f c + total (steps 0 t) fun s => L.partTaken part s c) ≤
                      l t c + total (steps 0 t) fun s => L.partGiven part s c) ∧
            ∃ t f,
              (∀ (c : C),
                  W.requires t f c →
                    (W.need t f c + total (steps 0 t) fun s => L.partTaken part s c) ≤
                      l t c + total (steps 0 t) fun s => L.partGiven part s c) ∧
                ¬W.Admits (l t) t f)
@Flow.Balances.includes_of_renewed : ∀ {F C : Type} {L : Flow F C} {part : F → Bool} {W : Web F C},
  L.Balances W →
    L.Taking W →
      ∀ {l : Nat → C → Nat},
        L.WithheldLevels part W l →
          (∀ (t : Nat) (f : F) (c : C), part f = true → W.draws t f c → W.Renewed c) → W.Includes W.level l
@Flow.Balances.not_narrows_of_renewed : ∀ {F C : Type} {L : Flow F C} {part : F → Bool} {W : Web F C},
  L.Balances W →
    L.Taking W →
      ∀ {l : Nat → C → Nat},
        L.WithheldLevels part W l →
          (∀ (t : Nat) (f : F) (c : C), part f = true → W.draws t f c → W.Renewed c) → ¬W.Widens l W.level
@Flow.Balances.includes_of_renewingIn : ∀ {F C : Type} {L : Flow F C} {part : F → Bool} {W : Web F C},
  L.Balances W →
    L.Taking W →
      ∀ {l : Nat → C → Nat},
        L.WithheldLevels part W l → (∀ (f : F), part f = true → W.RenewingIn f) → W.Includes W.level l
@Flow.Balances.narrows_of_consumed : ∀ {F C : Type} {L : Flow F C} {part : F → Bool} {W : Web F C},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        (∀ (t : Nat) (c : C), L.partGiven part t c ≤ L.partTaken part t c) →
          ∀ {g : F} {c : C} {T t : Nat},
            (∀ (t : Nat), T < t → W.level t c < W.need T g c) →
              T < t → W.requires t g c ∧ W.need T g c ≤ W.need t g c → W.Admits (l t) t g → W.Widens l W.level
@Flow.Balances.keeps_of_inactive : ∀ {F C : Type} {L : Flow F C} {part : F → Bool} {W : Web F C},
  L.Balances W →
    L.Taking W →
      L.Acting W →
        ∀ {l : Nat → C → Nat},
          L.WithheldLevels part W l → (∀ (t : Nat) (f : F), part f = true → ¬W.active t f) → W.Keeps W.level l
@Flow.Balances.keeps_of_not_arising : ∀ {F C : Type} {L : Flow F C} {part : F → Bool} {W : Web F C},
  L.Balances W →
    L.Taking W →
      L.Acting W →
        ∀ {l : Nat → C → Nat},
          L.WithheldLevels part W l →
            (∀ (f : F), part f = true → ¬W.active 0 f) →
              (∀ (t : Nat) (f : F), part f = true → ¬W.Arises t f) → W.Keeps W.level l
Preemption.flow : Flow Bool Unit
Preemption.web : Web Bool Unit
Preemption.drawerPart : Bool → Bool
Preemption.withheld : Preemption.flow.WithheldLevels Preemption.drawerPart Preemption.web fun x x_1 => 1
@Preemption.within_renewal_yet_loses : ∀ {l : Nat → Unit → Nat},
  Preemption.flow.WithheldLevels Preemption.drawerPart Preemption.web l →
    Web.RenewingAt 0 true ∧ ¬Web.UnderminingAt 0 true ∧ ¬Preemption.web.Includes Preemption.web.level l
@Preemption.renewingAt_consuming_narrows : ∀ {l : Nat → Unit → Nat},
  Preemption.flow.WithheldLevels Preemption.drawerPart Preemption.web l →
    Web.RenewingAt 0 true ∧
      Preemption.web.ConsumingIn true ∧ ¬Preemption.web.RenewingIn true ∧ Preemption.web.Widens l Preemption.web.level
Untaken.flow : Flow Unit Unit
Untaken.web : Web Unit Unit
Untaken.part : Unit → Bool
@Untaken.consuming_keeps : ∀ {l : Nat → Unit → Nat},
  Untaken.flow.WithheldLevels Untaken.part Untaken.web l →
    Untaken.flow.Balances Untaken.web ∧
      Untaken.flow.Taking Untaken.web ∧ Untaken.web.ConsumingIn () ∧ Untaken.web.Keeps Untaken.web.level l
ArisingDrawer.flow : Flow Bool Unit
ArisingDrawer.web : Web Bool Unit
ArisingDrawer.part : Bool → Bool
ArisingDrawer.withheld : ArisingDrawer.flow.WithheldLevels ArisingDrawer.part ArisingDrawer.web fun x x_1 => 1
@ArisingDrawer.arises_narrows : ∀ {l : Nat → Unit → Nat},
  ArisingDrawer.flow.WithheldLevels ArisingDrawer.part ArisingDrawer.web l →
    ArisingDrawer.flow.Balances ArisingDrawer.web ∧
      ArisingDrawer.flow.Taking ArisingDrawer.web ∧
        ArisingDrawer.flow.Acting ArisingDrawer.web ∧
          ¬ArisingDrawer.web.active 0 true ∧
            ArisingDrawer.web.Arises 0 true ∧ ArisingDrawer.web.Widens l ArisingDrawer.web.level
ArisingGiver.flow : Flow Bool Unit
ArisingGiver.web : Web Bool Unit
ArisingGiver.part : Bool → Bool
ArisingGiver.withheld : ArisingGiver.flow.WithheldLevels ArisingGiver.part ArisingGiver.web fun x x_1 => 0
@ArisingGiver.arises_widens : ∀ {l : Nat → Unit → Nat},
  ArisingGiver.flow.WithheldLevels ArisingGiver.part ArisingGiver.web l →
    ArisingGiver.flow.Balances ArisingGiver.web ∧
      ArisingGiver.flow.Taking ArisingGiver.web ∧
        ArisingGiver.flow.Acting ArisingGiver.web ∧
          ¬ArisingGiver.web.active 0 true ∧
            ArisingGiver.web.Arises 0 true ∧ ArisingGiver.web.Widens ArisingGiver.web.level l
@Web.Whole : {F C : Type} → Web F C → (F → Prop) → F → Prop
@Web.Listed : {F C : Type} → Web F C → (F → Prop) → (Nat → List F) → Prop
@Web.Ends : {F C : Type} → Web F C → F → Prop
@Web.Brief : {F C : Type} → Web F C → Nat → F → Prop
@Web.Covered : {F C : Type} → Web F C → (F → Prop) → Nat → Prop
@Web.whole_self : ∀ {F C : Type} (W : Web F C) (f : F), W.Whole (fun x => x = f) f
@Web.Whole.arises_part : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F},
  W.Whole parts w → ∀ {t : Nat}, W.Arises t w → ∃ p, parts p ∧ W.Arises t p
@Web.Whole.parts_unceasing : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F},
  W.Whole parts w → (∀ (N : Nat), ∃ t, N ≤ t ∧ W.Arises t w) → ∀ (N : Nat), ∃ t p, N ≤ t ∧ parts p ∧ W.Arises t p
@Web.Ends.all : ∀ {F C : Type} {W : Web F C} {l : List F},
  (∀ (f : F), f ∈ l → W.Ends f) → ∃ M, ∀ (f : F), f ∈ l → ∀ (t : Nat), M ≤ t → ¬W.active t f
@Web.active_back : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {S k : Nat},
  (∀ (j : Nat), j < k → ∀ (p : F), parts p → ¬W.Arises (S + j) p) →
    ∀ {p : F}, parts p → W.active (S + k) p → ¬¬W.active S p
@Web.Covered.arises_within : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {d T : Nat},
  W.Covered parts T →
    (∀ (p : F), parts p → W.Brief d p) →
      ∀ {S : Nat}, T ≤ S → ¬∀ (j : Nat), j < d → ∀ (p : F), parts p → ¬W.Arises (S + j) p
@Web.Listed.end_without_arising : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {N : Nat} {alive : Nat → List F},
  W.Listed parts alive →
    (∀ (p : F), parts p → W.Ends p) →
      (∀ (t : Nat), N ≤ t → ∀ (p : F), parts p → ¬W.Arises t p) →
        ∃ M, ∀ (t : Nat), M ≤ t → ∀ (p : F), parts p → ¬W.active t p
@Web.Covered.needs_arising : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {T : Nat} {alive : Nat → List F},
  W.Covered parts T →
    W.Listed parts alive →
      (∀ (p : F), parts p → W.Ends p) → ∀ (N : Nat), ¬∀ (t : Nat), N ≤ t → ∀ (p : F), parts p → ¬W.Arises t p
@Web.Covered.needs_new : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {T : Nat} {alive : Nat → List F},
  W.Covered parts T →
    W.Listed parts alive →
      (∀ (p : F), parts p → W.Ends p) →
        ∀ {l : List F},
          (∀ (p : F), p ∈ l → parts p) → ∀ (N : Nat), ¬∀ (t : Nat), N ≤ t → ∀ (p : F), parts p → ¬p ∈ l → ¬W.Arises t p
@Web.Whole.covered : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F},
  W.Whole parts w → ∀ {T : Nat}, (∀ (t : Nat), T ≤ t → W.active t w) → W.Covered parts T
@Web.Whole.arises_within : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F} {d : Nat},
  W.Whole parts w →
    (∀ (p : F), parts p → W.Brief d p) →
      ∀ {T : Nat},
        (∀ (t : Nat), T ≤ t → W.active t w) →
          ∀ {S : Nat}, T ≤ S → ¬∀ (j : Nat), j < d → ∀ (p : F), parts p → ¬W.Arises (S + j) p
@Web.Whole.persists_of_arising : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F} {d T : Nat},
  W.Whole parts w →
    (∀ (S : Nat), T ≤ S → ∃ j p, j < d ∧ parts p ∧ W.Arises (S + j) p) →
      (∀ (t : Nat) (p : F), parts p → W.Arises t p → ∀ (i : Nat), i < d → W.active (t + 1 + i) p) →
        ∀ (S : Nat), T ≤ S → W.active (S + d) w
@Web.Whole.persists_from : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F} {d T : Nat},
  W.Whole parts w →
    (∀ (S : Nat), T ≤ S → ∃ j p, j < d ∧ parts p ∧ W.Arises (S + j) p) →
      (∀ (t : Nat) (p : F), parts p → W.Arises t p → ∀ (i : Nat), i < d → W.active (t + 1 + i) p) →
        ∀ (t : Nat), T + d ≤ t → W.active t w
@Web.Whole.needs_arising : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F} {alive : Nat → List F},
  W.Whole parts w →
    W.Listed parts alive →
      (∀ (p : F), parts p → W.Ends p) →
        ∀ {T : Nat},
          (∀ (t : Nat), T ≤ t → W.active t w) → ∀ (N : Nat), ¬∀ (t : Nat), N ≤ t → ∀ (p : F), parts p → ¬W.Arises t p
@Web.Whole.needs_new : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F} {alive : Nat → List F},
  W.Whole parts w →
    W.Listed parts alive →
      (∀ (p : F), parts p → W.Ends p) →
        ∀ {T : Nat},
          (∀ (t : Nat), T ≤ t → W.active t w) →
            ∀ {l : List F},
              (∀ (p : F), p ∈ l → parts p) →
                ∀ (N : Nat), ¬∀ (t : Nat), N ≤ t → ∀ (p : F), parts p → ¬p ∈ l → ¬W.Arises t p
@Web.Whole.ends_without_arising : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F} {N : Nat}
  {alive : Nat → List F},
  W.Whole parts w →
    W.Listed parts alive →
      (∀ (p : F), parts p → W.Ends p) → (∀ (t : Nat), N ≤ t → ∀ (p : F), parts p → ¬W.Arises t p) → W.Ends w
@Web.Whole.family_excess_ends : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F} {L : Flow F C}
  {alive : Nat → List F},
  W.Whole parts w →
    W.Listed parts alive →
      (∀ (p : F), parts p → W.Ends p) →
        L.Balances W →
          L.Acting W →
            W.Dependent →
              ∀ {ds : List C} {m : Nat},
                (∀ (t : Nat) (f : F),
                    f ∈ L.present t →
                      ∀ (d : C), d ∈ ds → 0 < L.give t f d → ∃ e, e ∈ ds ∧ W.requires t f e ∧ m ≤ W.need t f e) →
                  (∀ (t : Nat) (p : F),
                      parts p → W.Arises t p → ∃ e, e ∈ ds ∧ W.requires (t + 1) p e ∧ m ≤ W.need (t + 1) p e) →
                    ∀ {T n : Nat},
                      (∀ (k : Nat), k < n → L.replenishment ds (T + k) < L.uptake ds (T + k)) →
                        W.stock ds T < n + m → (∀ (t : Nat), T + n ≤ t → ∀ (p : F), parts p → ¬W.Arises t p) ∧ W.Ends w
@Web.Whole.joint_excess_ends : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F} {L : Flow F C}
  {alive : Nat → List F},
  W.Whole parts w →
    W.Listed parts alive →
      (∀ (p : F), parts p → W.Ends p) →
        L.Balances W →
          L.Acting W →
            W.Dependent →
              ∀ {c : C} {m : Nat},
                (∀ (t : Nat) (f : F), f ∈ L.present t → 0 < L.give t f c → W.requires t f c ∧ m ≤ W.need t f c) →
                  (∀ (t : Nat) (p : F), parts p → W.Arises t p → W.requires (t + 1) p c ∧ m ≤ W.need (t + 1) p c) →
                    ∀ {T n : Nat},
                      (∀ (k : Nat), k < n → L.given (T + k) c < L.taken (T + k) c) →
                        W.level T c < n + m → (∀ (t : Nat), T + n ≤ t → ∀ (p : F), parts p → ¬W.Arises t p) ∧ W.Ends w
@Web.AllWhole : {F C : Type} → Web F C → (F → Prop) → F → Prop
@Web.InStep : {F C : Type} → Web F C → (F → Prop) → Prop
@Web.allWhole_self : ∀ {F C : Type} (W : Web F C) (f : F), W.AllWhole (fun x => x = f) f
@Web.AllWhole.inactive_of_part : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F},
  W.AllWhole parts w → ∀ {p : F}, parts p → ∀ {t : Nat}, ¬W.active t p → ¬W.active t w
@Web.AllWhole.ends_of_part : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F},
  W.AllWhole parts w → ∀ {p : F}, parts p → W.Ends p → W.Ends w
