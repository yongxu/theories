@add_le_total_of_mem : ∀ {α : Type} {q : α → Nat} {as : List α} {a b : α},
  a ≠ b → a ∈ as → b ∈ as → q a + q b ≤ total as q
@Web.active_before : ∀ {F C : Type} {W : Web F C} {g : F} {T j : Nat},
  (∀ (i : Nat), W.active (T + i + 1) g → W.active (T + i) g) →
    ∀ {s : Nat}, j ≤ s → W.active (T + s) g → W.active (T + j) g
@Flow.TakesAll : {F C : Type} → Flow F C → Nat → F → C → Prop
@Flow.rest_le_taken : ∀ {F C : Type} {L : Flow F C} {t : Nat} {c : C} {rest : List F},
  Distinct rest →
    (∀ (f : F), f ∈ rest → 0 < L.take t f c → f ∈ L.present t) → (total rest fun f => L.take t f c) ≤ L.taken t c
@Flow.outrun_excess : ∀ {F C : Type} {L : Flow F C} {t : Nat} {c : C} {rest : List F},
  Distinct rest →
    (∀ (f : F), f ∈ rest → 0 < L.take t f c → f ∈ L.present t) →
      (L.given t c < total rest fun f => L.take t f c) → L.given t c < L.taken t c
@Flow.outrun_below : ∀ {F C : Type} {L : Flow F C} {W : Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {c : C} {m : Nat},
          (∀ (t : Nat) (e : F), e ∈ L.present t → 0 < L.give t e c → W.requires t e c ∧ m ≤ W.need t e c) →
            ∀ {T n : Nat} {rest : List F},
              Distinct rest →
                (∀ (j : Nat) (f : F), j < n → f ∈ rest → 0 < L.take (T + j) f c → f ∈ L.present (T + j)) →
                  (∀ (j : Nat), j < n → L.given (T + j) c < total rest fun f => L.take (T + j) f c) →
                    W.level T c < n + m → ∀ (k : Nat), W.level (T + n + k) c < m
@Flow.outrun_ends : ∀ {F C : Type} {L : Flow F C} {W : Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {c : C} {m : Nat},
          (∀ (t : Nat) (e : F), e ∈ L.present t → 0 < L.give t e c → W.requires t e c ∧ m ≤ W.need t e c) →
            ∀ {T n : Nat} {rest : List F},
              Distinct rest →
                (∀ (j : Nat) (f : F), j < n → f ∈ rest → 0 < L.take (T + j) f c → f ∈ L.present (T + j)) →
                  (∀ (j : Nat), j < n → L.given (T + j) c < total rest fun f => L.take (T + j) f c) →
                    W.level T c < n + m →
                      ∀ (k : Nat) (h : F),
                        W.requires (T + n + k) h c → m ≤ W.need (T + n + k) h c → ¬W.active (T + n + k) h
@Flow.outrun_reading_alike : ∀ {F C : Type} {L : Flow F C} {W : Web F C} {L' : Flow F C} {W' : Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        L'.Balances W' →
          L'.Acting W' →
            W'.Dependent →
              ∀ {c : C},
                (∀ (t : Nat) (e : F), e ∈ L.present t → 0 < L.give t e c → W.requires t e c ∧ 1 ≤ W.need t e c) →
                  (∀ (t : Nat) (e : F), e ∈ L'.present t → 0 < L'.give t e c → W'.requires t e c ∧ 1 ≤ W'.need t e c) →
                    ∀ {T n : Nat} {rest rest' : List F},
                      Distinct rest →
                        Distinct rest' →
                          (∀ (j : Nat) (f : F), j < n → f ∈ rest → 0 < L.take (T + j) f c → f ∈ L.present (T + j)) →
                            (∀ (j : Nat) (f : F),
                                j < n → f ∈ rest' → 0 < L'.take (T + j) f c → f ∈ L'.present (T + j)) →
                              (∀ (j : Nat), j < n → L.given (T + j) c < total rest fun f => L.take (T + j) f c) →
                                (∀ (j : Nat), j < n → L'.given (T + j) c < total rest' fun f => L'.take (T + j) f c) →
                                  W.level T c < n + 1 →
                                    W'.level T c < n + 1 →
                                      ∀ {score : (Nat → C → Nat) → Nat},
                                        (∀ (l l' : Nat → C → Nat),
                                            (∀ (k : Nat), l (T + n + k) c = l' (T + n + k) c) → score l = score l') →
                                          score W.level = score W'.level
@Flow.excess_of_takesAll : ∀ {F C : Type} {L : Flow F C} {t : Nat} {f g : F} {c : C},
  f ≠ g → L.TakesAll t f c → g ∈ L.present t → 0 < L.take t g c → L.given t c < L.taken t c
@Flow.full_taking_ends_at : ∀ {F C : Type} {L : Flow F C} {W : Web F C} {c : C} {m T n k : Nat} {f g h : F},
  f ≠ g →
    (∀ (j : Nat), j < n + k → L.BalancesOn W [c] (T + j)) →
      (∀ (j : Nat) (e : F),
          j < n + k →
            e ∈ L.present (T + j) → 0 < L.give (T + j) e c → W.requires (T + j) e c ∧ m ≤ W.need (T + j) e c) →
        (∀ (j : Nat), j < n + k → L.GiversSupported W (T + j) c) →
          (∀ (j : Nat), j < n → L.TakesAll (T + j) f c) →
            (∀ (j : Nat), j < n → g ∈ L.present (T + j) ∧ 0 < L.take (T + j) g c) →
              W.level T c < n + m →
                (W.active (T + n + k) h → W.Supported (T + n + k) h) →
                  W.requires (T + n + k) h c → m ≤ W.need (T + n + k) h c → ¬W.active (T + n + k) h
@Flow.full_taking_ends : ∀ {F C : Type} {L : Flow F C} {W : Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {c : C} {m : Nat},
          (∀ (t : Nat) (e : F), e ∈ L.present t → 0 < L.give t e c → W.requires t e c ∧ m ≤ W.need t e c) →
            ∀ {T n : Nat} {f g : F},
              f ≠ g →
                (∀ (j : Nat), j < n → L.TakesAll (T + j) f c) →
                  (∀ (j : Nat), j < n → g ∈ L.present (T + j) ∧ 0 < L.take (T + j) g c) →
                    W.level T c < n + m →
                      ∀ (k : Nat) (h : F),
                        W.requires (T + n + k) h c → m ≤ W.need (T + n + k) h c → ¬W.active (T + n + k) h
@Flow.continuing_excludes : ∀ {F C : Type} {L : Flow F C} {W : Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {c : C} {m : Nat},
          (∀ (t : Nat) (e : F), e ∈ L.present t → 0 < L.give t e c → W.requires t e c ∧ m ≤ W.need t e c) →
            ∀ {f g : F},
              f ≠ g →
                (∀ (t : Nat), L.TakesAll t f c) →
                  (∀ (t : Nat), W.requires t f c ∧ m ≤ W.need t f c) →
                    (∀ (t : Nat), W.active t f) →
                      ∀ (T : Nat), ¬∀ (j : Nat), j < W.level T c + 1 → g ∈ L.present (T + j) ∧ 0 < L.take (T + j) g c
@Flow.continuing_excludes_active : ∀ {F C : Type} {L : Flow F C} {W : Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {c : C} {m : Nat},
          (∀ (t : Nat) (e : F), e ∈ L.present t → 0 < L.give t e c → W.requires t e c ∧ m ≤ W.need t e c) →
            ∀ {f g : F},
              f ≠ g →
                (∀ (t : Nat), L.TakesAll t f c) →
                  (∀ (t : Nat), W.requires t f c ∧ m ≤ W.need t f c) →
                    (∀ (t : Nat), W.active t f) →
                      (∀ (t : Nat), W.active t g → g ∈ L.present t ∧ 0 < L.take t g c) →
                        ∀ (T : Nat), ¬∀ (j : Nat), j < W.level T c + 1 → W.active (T + j) g
@Flow.continuing_ends_taker : ∀ {F C : Type} {L : Flow F C} {W : Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {c : C} {m : Nat},
          (∀ (t : Nat) (e : F), e ∈ L.present t → 0 < L.give t e c → W.requires t e c ∧ m ≤ W.need t e c) →
            ∀ {f g : F},
              f ≠ g →
                (∀ (t : Nat), L.TakesAll t f c) →
                  (∀ (t : Nat), W.requires t f c ∧ m ≤ W.need t f c) →
                    (∀ (t : Nat), W.active t f) →
                      (∀ (t : Nat), W.active t g → g ∈ L.present t ∧ 0 < L.take t g c) →
                        ∀ {T : Nat},
                          (∀ (j : Nat), W.active (T + j + 1) g → W.active (T + j) g) →
                            ∀ (k : Nat), ¬W.active (T + (W.level T c + k)) g
@Flow.alongside_not_all : ∀ {F C : Type} {L : Flow F C} {W : Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {c : C} {m : Nat},
          (∀ (t : Nat) (e : F), e ∈ L.present t → 0 < L.give t e c → W.requires t e c ∧ m ≤ W.need t e c) →
            ∀ {f g : F},
              f ≠ g →
                (∀ (t : Nat), g ∈ L.present t ∧ 0 < L.take t g c) →
                  (∀ (t : Nat), W.requires t f c ∧ m ≤ W.need t f c) →
                    (∀ (t : Nat), W.active t f) →
                      ∀ (T : Nat), ¬∀ (j : Nat), j < W.level T c + 1 → L.TakesAll (T + j) f c
@Flow.level_kept : ∀ {F C : Type} {L : Flow F C} {W : Web F C},
  L.Balances W → ∀ {c : C}, (∀ (t : Nat), L.WithinJoint t c) → ∀ (t : Nat), W.level 0 c ≤ W.level t c
@Flow.distinct_of_nodup : ∀ {α : Type} {l : List α}, l.Nodup → Distinct l
@Flow.withinJoint_of_plan : ∀ {F C : Type} {L : Flow F C} {S R : Type} {footprint : S → R → Prop}
  {J : S → S → S → Prop},
  PartsWithin footprint J →
    PartsApart footprint J →
      ∀ (p : JointPlan (List R)) {s : S},
        JointPlan.Realizes J (Supports footprint) s p →
          ∀ {avail : List R},
            (∀ (a : R), footprint s a → a ∈ avail) →
              ∀ {t : Nat} {c : C}, L.taken t c = p.draws.length → avail.length ≤ L.given t c → L.WithinJoint t c
@Flow.level_kept_of_plans : ∀ {F C : Type} {L : Flow F C} {W : Web F C},
  L.Balances W →
    ∀ {S R : Type} {footprint : S → R → Prop} {J : S → S → S → Prop},
      PartsWithin footprint J →
        PartsApart footprint J →
          ∀ {c : C},
            (∀ (t : Nat),
                ∃ p s avail,
                  JointPlan.Realizes J (Supports footprint) s p ∧
                    (∀ (a : R), footprint s a → a ∈ avail) ∧
                      L.taken t c = p.draws.length ∧ avail.length ≤ L.given t c) →
              ∀ (t : Nat), W.level 0 c ≤ W.level t c
@Flow.supported_of_within : ∀ {F C : Type} {L : Flow F C} {W : Web F C},
  L.Balances W →
    ∀ {c : C},
      (∀ (t : Nat), L.WithinJoint t c) →
        (∀ (t : Nat) (e : F) (d : C), W.requires t e d → d = c) →
          (∀ (t : Nat) (e : F), W.requires t e c → W.need t e c ≤ W.level 0 c) → ∀ (t : Nat) (e : F), W.Supported t e
Excluding.level : Nat → Nat
Excluding.present : Nat → List Exceeding.Member
Excluding.flow : Flow Exceeding.Member Unit
Excluding.web : Web Exceeding.Member Unit
Excluding.balances : Excluding.flow.Balances Excluding.web
Excluding.acting : Excluding.flow.Acting Excluding.web
Excluding.level_two : ∀ (t : Nat), 2 ≤ Excluding.level t
Excluding.dependent : Excluding.web.Dependent
Excluding.gated : ∀ (t : Nat) (f : Exceeding.Member),
  f ∈ Excluding.flow.present t →
    0 < Excluding.flow.give t f () → Excluding.web.requires t f () ∧ 1 ≤ Excluding.web.need t f ()
Excluding.takes_all : ∀ (t : Nat), Excluding.flow.TakesAll t Witnesses.Member.first ()
Excluding.continues : ∀ (t : Nat),
  Excluding.web.active t Witnesses.Member.renewer ∧
    Excluding.web.active t Witnesses.Member.first ∧ ¬Excluding.web.active (t + 1) Witnesses.Member.second
Excluding.first_step : Excluding.web.active 0 Witnesses.Member.second ∧
  Witnesses.Member.second ∈ Excluding.flow.present 0 ∧
    0 < Excluding.flow.take 0 Witnesses.Member.second () ∧
      Excluding.present 0 = Exceeding.present 0 ∧
        Excluding.level 0 = Exceeding.level 0 ∧ Excluding.level 1 = Exceeding.level 1
Excluding.second_lives : ∀ (t : Nat),
  Excluding.web.active t Witnesses.Member.second →
    Witnesses.Member.second ∈ Excluding.flow.present t ∧ 0 < Excluding.flow.take t Witnesses.Member.second ()
Excluding.second_lasting : ∀ (j : Nat),
  Excluding.web.active (0 + j + 1) Witnesses.Member.second → Excluding.web.active (0 + j) Witnesses.Member.second
Excluding.ends_by_law : ∀ (k : Nat), ¬Excluding.web.active (0 + (Excluding.web.level 0 () + k)) Witnesses.Member.second
Sharing.flow : Flow Exceeding.Member Unit
Sharing.web : Web Exceeding.Member Unit
Sharing.balances : Sharing.flow.Balances Sharing.web
Sharing.within : ∀ (t : Nat), Sharing.flow.WithinJoint t ()
Sharing.dependent : Sharing.web.Dependent
Sharing.neither_all : ∀ (t : Nat),
  ¬Sharing.flow.TakesAll t Witnesses.Member.first () ∧ ¬Sharing.flow.TakesAll t Witnesses.Member.second ()
Sharing.full_taking_needed : (∀ (t : Nat),
    Sharing.web.active t Witnesses.Member.second →
      Witnesses.Member.second ∈ Sharing.flow.present t ∧ 0 < Sharing.flow.take t Witnesses.Member.second ()) ∧
  ∀ (t : Nat), Sharing.web.active t Witnesses.Member.first ∧ Sharing.web.active t Witnesses.Member.second
Excluding.admits_all : ∀ (t : Nat) (f : Exceeding.Member), Excluding.web.Admits (Excluding.web.level t) t f
Excluding.admission_alike : Excluding.web.Includes Sharing.web.level Excluding.web.level ∧
  Excluding.web.Includes Excluding.web.level Sharing.web.level ∧
    (∀ (t : Nat) (f : Exceeding.Member), Excluding.web.Admits (Excluding.web.level t) t f) ∧
      ¬Excluding.web.active 1 Witnesses.Member.second ∧ ∀ (t : Nat), Sharing.web.active t Witnesses.Member.second
Excluding.three_courses : (∀ (n : Nat) (f : Exceeding.Member), ¬Exceeding.web.active (2 + n) f) ∧
  (Excluding.flow.Balances Excluding.web ∧
      Excluding.web.Dependent ∧
        ∀ (t : Nat),
          Excluding.flow.TakesAll t Witnesses.Member.first () ∧
            Excluding.web.active t Witnesses.Member.renewer ∧
              Excluding.web.active t Witnesses.Member.first ∧ ¬Excluding.web.active (t + 1) Witnesses.Member.second) ∧
    Sharing.flow.Balances Sharing.web ∧
      Sharing.web.Dependent ∧
        ∀ (t : Nat),
          Sharing.flow.WithinJoint t () ∧
            (∀ (f : Exceeding.Member), Sharing.web.active t f) ∧ ¬Sharing.flow.TakesAll t Witnesses.Member.first ()
@Web.Carries : {F C : Type} → Web F C → (Nat → F → Nat) → Prop
@Web.Decays : {F C : Type} → Web F C → (Nat → F → Nat) → Prop
@Web.CarriesAcross : {F C : Type} → Web F C → (Nat → F → Nat) → Nat → F → Prop
@Web.DecaysAcross : {F C : Type} → Web F C → (Nat → F → Nat) → Nat → F → Prop
@Web.carries_zero_across : ∀ {F C : Type} {W : Web F C} {t : Nat} {f : F},
  W.CarriesAcross (fun x x_1 => 0) t f ↔ W.active t f → W.Supported t f
@Web.carries_zero : ∀ {F C : Type} {W : Web F C}, (W.Carries fun x x_1 => 0) ↔ W.Dependent
@Web.CarriesAcross.pos : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat} {t : Nat} {f : F},
  W.CarriesAcross r t f → W.active t f → ¬W.Supported t f → 0 < r t f
@Web.Carries.pos : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat},
  W.Carries r → ∀ {t : Nat} {f : F}, W.active t f → ¬W.Supported t f → 0 < r t f
@Web.active_not_recurring_from : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat} {f : F} {T : Nat},
  (∀ (t : Nat), T ≤ t → W.CarriesAcross r t f) →
    (∀ (t : Nat), T ≤ t → ¬W.Supported t f) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ W.active t f
@Web.Carries.active_not_recurring : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat},
  W.Carries r → ∀ {f : F} {T : Nat}, (∀ (t : Nat), T ≤ t → ¬W.Supported t f) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ W.active t f
@Web.CarriesAcross.step : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat} {t : Nat} {f : F}
  [inst : Decidable (W.active t f)],
  W.CarriesAcross r t f → ¬W.Supported t f → r (t + 1) f + mark (W.active t f) ≤ r t f
@Web.Carries.step : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat},
  W.Carries r →
    ∀ {t : Nat} {f : F} [inst : Decidable (W.active t f)], ¬W.Supported t f → r (t + 1) f + mark (W.active t f) ≤ r t f
@Web.lasts_on : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat} {f : F} [inst : (t : Nat) → Decidable (W.active t f)]
  (S N : Nat),
  (∀ (t : Nat), S ≤ t → t < S + N → W.CarriesAcross r t f) →
    (∀ (t : Nat), S ≤ t → t < S + N → ¬W.Supported t f) →
      (r (S + N) f + total (steps S N) fun t => mark (W.active t f)) ≤ r S f
@Web.Carries.lasts : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat},
  W.Carries r →
    ∀ {f : F} [inst : (t : Nat) → Decidable (W.active t f)] (S N : Nat),
      (∀ (t : Nat), S ≤ t → ¬W.Supported t f) → (r (S + N) f + total (steps S N) fun t => mark (W.active t f)) ≤ r S f
@Web.Carries.lasts_within : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat},
  W.Carries r →
    ∀ {f : F} [inst : (t : Nat) → Decidable (W.active t f)] {k : Nat},
      (∀ (t : Nat), r t f ≤ k) →
        ∀ (S N : Nat), (∀ (t : Nat), S ≤ t → ¬W.Supported t f) → (total (steps S N) fun t => mark (W.active t f)) ≤ k
@Web.arising_not_recurring_from : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat} {f : F} {T : Nat},
  (∀ (t : Nat), T ≤ t → W.CarriesAcross r t f) →
    (∀ (t : Nat), T ≤ t → ¬W.Supported t f) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ W.Arises t f
@Web.Carries.arising_not_recurring : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat},
  W.Carries r → ∀ {f : F} {T : Nat}, (∀ (t : Nat), T ≤ t → ¬W.Supported t f) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ W.Arises t f
@Web.decays_by_on : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat} {f : F} {S : Nat} (n : Nat),
  (∀ (t : Nat), S ≤ t → t < S + n → W.CarriesAcross r t f) →
    (∀ (t : Nat), S ≤ t → t < S + n → W.DecaysAcross r t f) →
      (∀ (t : Nat), S ≤ t → t < S + n → ¬W.Supported t f) → r (S + n) f + n ≤ r S f ∨ r (S + n) f = 0
@Web.decays_by_from : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat} {f : F} {S : Nat},
  (∀ (t : Nat), S ≤ t → W.CarriesAcross r t f) →
    (∀ (t : Nat), S ≤ t → W.DecaysAcross r t f) →
      (∀ (t : Nat), S ≤ t → ¬W.Supported t f) → ∀ (n : Nat), r (S + n) f + n ≤ r S f ∨ r (S + n) f = 0
@Web.Carries.decays_by : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat},
  W.Carries r →
    W.Decays r →
      ∀ {f : F} {S : Nat},
        (∀ (t : Nat), S ≤ t → ¬W.Supported t f) → ∀ (n : Nat), r (S + n) f + n ≤ r S f ∨ r (S + n) f = 0
@Web.ends_within_on : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat} {f : F} {S n : Nat},
  (∀ (t : Nat), S ≤ t → t ≤ S + n → W.CarriesAcross r t f) →
    (∀ (t : Nat), S ≤ t → t < S + n → W.DecaysAcross r t f) →
      (∀ (t : Nat), S ≤ t → t ≤ S + n → ¬W.Supported t f) → r S f ≤ n → ¬W.active (S + n) f ∧ r (S + n) f = 0
@Web.ends_within_from : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat} {f : F} {S : Nat},
  (∀ (t : Nat), S ≤ t → W.CarriesAcross r t f) →
    (∀ (t : Nat), S ≤ t → W.DecaysAcross r t f) →
      (∀ (t : Nat), S ≤ t → ¬W.Supported t f) → ∀ {n : Nat}, r S f ≤ n → ¬W.active (S + n) f
@Web.ended_for_good : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat} {f : F} {U : Nat},
  ¬W.active U f →
    r U f = 0 →
      (∀ (t : Nat), U ≤ t → ¬W.active t f → r t f = 0 → ¬W.Arises t f ∧ r (t + 1) f = 0) →
        ∀ (k : Nat), ¬W.active (U + k) f ∧ r (U + k) f = 0
@Web.late_return_finds_none : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat} {f : F} {S n : Nat},
  (∀ (t : Nat), S ≤ t → t ≤ S + n → W.CarriesAcross r t f) →
    (∀ (t : Nat), S ≤ t → t < S + n → W.DecaysAcross r t f) →
      (∀ (t : Nat), S ≤ t → t ≤ S + n → ¬W.Supported t f) →
        r S f ≤ n →
          (∀ (t : Nat), S + n ≤ t → ¬W.active t f → r t f = 0 → ¬W.Arises t f ∧ r (t + 1) f = 0) →
            ∀ (k : Nat), ¬W.active (S + n + k) f
@Web.Carries.ends_within : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat},
  W.Carries r →
    W.Decays r →
      ∀ {f : F} {S : Nat}, (∀ (t : Nat), S ≤ t → ¬W.Supported t f) → ∀ {n : Nat}, r S f ≤ n → ¬W.active (S + n) f
@Web.unsupported_after_loss : ∀ {F C : Type} {W : Web F C} {T : Nat} {g : F} {c : C},
  (∀ (t : Nat), T < t → W.requires t g c ∧ W.need T g c ≤ W.need t g c) →
    (∀ (t : Nat), T < t → W.level t c < W.need T g c) → ∀ (t : Nat), T < t → ¬W.Supported t g
@Web.Carries.consumed_lasts : ∀ {F C : Type} {W : Web F C} {r : Nat → F → Nat},
  W.Carries r →
    ∀ {T : Nat} {g : F} {c : C},
      (∀ (t : Nat), T < t → W.requires t g c ∧ W.need T g c ≤ W.need t g c) →
        (∀ (t : Nat), T < t → W.level t c < W.need T g c) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ W.active t g
@Flow.carriesAcross_of_held : ∀ {F C : Type} {L : Flow F C} {W : Web F C} {t : Nat} {f : F} (hold : F → C),
  L.BalancesOn W [hold f] t →
    (¬W.Supported t f → L.given t (hold f) = 0) →
      (¬W.Supported t f → W.active t f → 0 < L.taken t (hold f)) → W.CarriesAcross (fun t f => W.level t (hold f)) t f
@Flow.carries_of_held : ∀ {F C : Type} {L : Flow F C} {W : Web F C},
  L.Balances W →
    ∀ (hold : F → C),
      (∀ (t : Nat) (f : F), ¬W.Supported t f → L.given t (hold f) = 0) →
        (∀ (t : Nat) (f : F), ¬W.Supported t f → W.active t f → 0 < L.taken t (hold f)) →
          W.Carries fun t f => W.level t (hold f)
@Flow.carries_of_own : ∀ {F C : Type} {L : Flow F C} {W : Web F C},
  L.Balances W →
    ∀ (hold : F → C),
      (∀ (t : Nat) (f : F), ¬W.Supported t f → L.given t (hold f) = 0) →
        (∀ (t : Nat) (f : F), ¬W.Supported t f → W.active t f → f ∈ L.present t ∧ 0 < L.take t f (hold f)) →
          W.Carries fun t f => W.level t (hold f)
@Web.redirect : {F C : Type} → (W : Web F C) → [(t : Nat) → (f : F) → Decidable (W.Supported t f)] → (F → C) → Web F C
@Web.redirect_same : ∀ {F C : Type} {W : Web F C} [inst : (t : Nat) → (f : F) → Decidable (W.Supported t f)]
  (hold : F → C),
  (W.redirect hold).level = W.level ∧ (W.redirect hold).active = W.active ∧ (W.redirect hold).draws = W.draws
@Web.redirect_supported_at : ∀ {F C : Type} {W : Web F C} [inst : (t : Nat) → (f : F) → Decidable (W.Supported t f)]
  {hold : F → C} {t : Nat} {f : F},
  W.CarriesAcross (fun t f => W.level t (hold f)) t f → W.active t f → (W.redirect hold).Supported t f
@Web.redirect_dependent : ∀ {F C : Type} {W : Web F C} [inst : (t : Nat) → (f : F) → Decidable (W.Supported t f)]
  {hold : F → C}, (W.Carries fun t f => W.level t (hold f)) → (W.redirect hold).Dependent
@Web.unsupported_after_end : ∀ {X : Type} {W : Web X X} {y g : X},
  W.Embodied y →
    ∀ {T : Nat},
      (∀ (t : Nat), T ≤ t → W.requires t g y ∧ 0 < W.need t g y) →
        (∀ (t : Nat), T ≤ t → ¬W.active t y) → ∀ (t : Nat), T ≤ t → ¬W.Supported t g
