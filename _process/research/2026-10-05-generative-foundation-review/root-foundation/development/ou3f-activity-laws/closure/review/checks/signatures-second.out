  W.AllWhole parts w →
    ∀ {T : Nat}, (∀ (t : Nat), T ≤ t → W.active t w) ↔ ∀ (p : F), parts p → ∀ (t : Nat), T ≤ t → W.active t p
@Web.AllWhole.brief_of_part : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F},
  W.AllWhole parts w → ∀ {p : F}, parts p → ∀ {d : Nat}, W.Brief d p → W.Brief d w
