PatternRelay.fire_shape : «则» PatternRelay.shifted.carrierClass PatternRelay.shifted.activityClass ∧
  «亡» (Web.continuationStep (Web.passingContinuation PatternRelay.passesOdd)) PatternRelay.shifted.carrierClass (1, 0) ∧
    ¬«亡» (Web.continuationStep (Web.passingContinuation PatternRelay.passesOdd)) PatternRelay.shifted.activityClass
        (1, 0)
PatternRelay.stopped_relay : ∀ (T : Nat),
  (PatternRelay.stopped T).ByPassing (PatternRelay.passesUntil T) ∧
    (∀ (n : Nat), (PatternRelay.stopped T).Brief 2 n) ∧
      (∀ (t : Nat), T ≤ t → ¬(PatternRelay.stopped T).PassesAt (PatternRelay.passesUntil T) t) ∧
        (∀ (t : Nat), t ≤ T + 1 → (PatternRelay.stopped T).Present t) ∧
          ∀ (t : Nat), T + 2 ≤ t → ¬(PatternRelay.stopped T).Present t
@Web.Holds : {F C : Type} → Web F C → Nat → F → Prop
@Web.persisting : {F C : Type} → Web F C → (Nat → F → Prop) → Web F C
@Web.arises_persisting_iff : ∀ {F C : Type} {W : Web F C} {h : Nat → F → Prop},
  (∀ (t : Nat) (f : F), W.active t f → h t f) →
    ∀ {t : Nat} {f : F}, (W.persisting h).Arises t f ∧ W.active (t + 1) f ↔ W.Arises t f ∧ ¬h t f
@Web.waking_not_arising : ∀ {F C : Type} {W : Web F C} {h : Nat → F → Prop} {t : Nat} {f : F},
  h t f → ¬(W.persisting h).Arises t f
@Web.ceases_persisting_iff : ∀ {F C : Type} {W : Web F C} {h : Nat → F → Prop},
  (∀ (t : Nat) (f : F), W.active t f → h t f) →
    ∀ {t : Nat} {f : F}, (W.persisting h).Ceases t f ∧ W.active t f ↔ W.Ceases t f ∧ ¬h (t + 1) f
@Web.arisesFrom_of_arises : ∀ {F C : Type} {W : Web F C} {R : Nat → F → F → Prop} {t : Nat} {f : F},
  (∀ (g : F), W.active t g → R t g f → g = f) → W.Arises t f → W.ArisesFrom R t f
@Web.keepsActive_of_held : ∀ {F F' C : Type} {W : Web F C} {h : Nat → F → Prop} {σ : Reidentify F F'},
  (∀ (t : Nat) (f : F), W.active t f → h t f) → σ.KeepsActive (W.persisting h) → σ.KeepsActive W
@Web.keepsTenure_of_held : ∀ {F F' C : Type} {W : Web F C} {h : Nat → F → Prop} {σ : Reidentify F F'},
  (∀ (t : Nat) (f : F) (c : C), W.requires t f c → h t f) → σ.KeepsActive (W.persisting h) → σ.KeepsTenure W
@Web.steady_held : ∀ {F F' C : Type} {W : Web F C} {h : Nat → F → Prop} {σ : Reidentify F F'},
  σ.KeepsActive (W.persisting h) →
    ∀ {g : F} {s t : Nat}, (∀ (u : Nat), s ≤ u → u ≤ t → h u g) → ∀ (u : Nat), s ≤ u → u ≤ t → σ.new u g = σ.new t g
@Web.named_throughout : ∀ {F F' C : Type} {W : Web F C} {h : Nat → F → Prop} {σ : Reidentify F F'},
  σ.KeepsActive (W.persisting h) → ∀ {f : F}, (∀ (t : Nat), h t f) → ∀ (t : Nat), σ.old t (σ.new 0 f) = f
@Web.renewingIn_held : ∀ {F F' C : Type} {W : Web F C} {h : Nat → F → Prop} {σ : Reidentify F F'},
  σ.KeepsActive (W.persisting h) →
    ∀ {f : F}, (∀ (t : Nat), h t f) → ((W.reidentify σ).RenewingIn (σ.new 0 f) ↔ W.RenewingIn f)
@Web.consumingIn_held : ∀ {F F' C : Type} {W : Web F C} {h : Nat → F → Prop} {σ : Reidentify F F'},
  σ.KeepsActive (W.persisting h) →
    ∀ {f : F}, (∀ (t : Nat), h t f) → ((W.reidentify σ).ConsumingIn (σ.new 0 f) ↔ W.ConsumingIn f)
@Web.persisting_census : ∀ {F C : Type} {W : Web F C} {h : Nat → F → Prop} {R : Nat → F → F → Prop}
  [(t : Nat) → (f : F) → Decidable ((W.persisting h).active t f)]
  [(t : Nat) → (f : F) → Decidable ((W.persisting h).Continues R t f)]
  [(t : Nat) → (g : F) → Decidable ((W.persisting h).Continued R t g)] [(t : Nat) → (g f : F) → Decidable (R t g f)]
  {alive : Nat → List F},
  (W.persisting h).Census alive →
    ((W.persisting h).NoSplit R →
        (∀ (N : Nat), ∃ t g, N ≤ t ∧ (W.persisting h).CeasesFrom R t g) → (W.persisting h).UnceasingFrom R) ∧
      ((W.persisting h).NoMerge R →
        ∀ {T B : Nat},
          (∀ (t : Nat), T ≤ t → (alive t).length ≤ B) →
            (W.persisting h).UnceasingFrom R → ∀ (N : Nat), ∃ t g, N ≤ t ∧ (W.persisting h).CeasesFrom R t g)
Hibernation.Formation : Type
Hibernation.Condition : Type
Hibernation.awake : Nat → Prop
Hibernation.asleep : Nat → Prop
Hibernation.first : Nat → Prop
Hibernation.foraging : Nat → Prop
Hibernation.fromSecond : Nat → Bool
Hibernation.web : Web Hibernation.Formation Hibernation.Condition
Hibernation.swap : Hibernation.Formation → Hibernation.Formation
Hibernation.swap_swap : ∀ (f : Hibernation.Formation), Hibernation.swap (Hibernation.swap f) = f
Hibernation.exchange : Reidentify Hibernation.Formation Hibernation.Formation
Hibernation.holds_always : ∀ (t : Nat), Hibernation.web.Holds t Hibernation.Formation.hibernator
Hibernation.pool_consumed : Hibernation.web.Consumed Hibernation.Condition.pool
Hibernation.pool_not_renewed : ¬Hibernation.web.Renewed Hibernation.Condition.pool
Hibernation.renewing : Hibernation.web.RenewingIn Hibernation.Formation.hibernator
Hibernation.exchanged_consuming : (Hibernation.web.reidentify Hibernation.exchange).ConsumingIn
  Hibernation.Formation.hibernator
Hibernation.exchanged_not_renewing : ¬(Hibernation.web.reidentify Hibernation.exchange).RenewingIn
    Hibernation.Formation.hibernator
Hibernation.readings : Hibernation.web.Dependent ∧
  ¬Hibernation.web.active 1 Hibernation.Formation.hibernator ∧
    Hibernation.web.Holds 1 Hibernation.Formation.hibernator ∧
      Hibernation.web.Arises 1 Hibernation.Formation.hibernator ∧
        ¬(Hibernation.web.persisting Hibernation.web.Holds).Arises 1 Hibernation.Formation.hibernator ∧
          Hibernation.web.Arises 1 Hibernation.Formation.forager ∧
            (Hibernation.web.persisting Hibernation.web.Holds).Arises 1 Hibernation.Formation.forager ∧
              Hibernation.exchange.KeepsActive Hibernation.web ∧
                Hibernation.exchange.back.KeepsActive (Hibernation.web.reidentify Hibernation.exchange) ∧
                  Hibernation.exchange.KeepsTenure Hibernation.web ∧
                    Hibernation.exchange.back.KeepsTenure (Hibernation.web.reidentify Hibernation.exchange) ∧
                      ¬Hibernation.exchange.KeepsActive (Hibernation.web.persisting Hibernation.web.Holds) ∧
                        Hibernation.web.RenewingIn Hibernation.Formation.hibernator ∧
                          (Hibernation.web.reidentify Hibernation.exchange).ConsumingIn
                              Hibernation.Formation.hibernator ∧
                            ¬(Hibernation.web.reidentify Hibernation.exchange).RenewingIn
                                  Hibernation.Formation.hibernator ∧
                              ∀ (σ : Reidentify Hibernation.Formation Hibernation.Formation),
                                σ.KeepsActive (Hibernation.web.persisting Hibernation.web.Holds) →
                                  (Hibernation.web.reidentify σ).RenewingIn (σ.new 0 Hibernation.Formation.hibernator)
Dormancy.held_both : Dormancy.join.KeepsActive (Dormancy.web.persisting Dormancy.web.Holds) ∧
  Dormancy.join.back.KeepsActive ((Dormancy.web.persisting Dormancy.web.Holds).reidentify Dormancy.join) ∧
    Dormancy.web.RenewingIn Dormancy.Formation.early ∧ ¬Dormancy.joined.RenewingIn Dormancy.Formation.early
Seed.held_readings : Seed.web.Arises 0 () ∧
  Seed.web.Arises 2 () ∧
    (∀ (t : Nat), (Seed.web.persisting Seed.web.Holds).active t ()) ∧
      (∀ (t : Nat), ¬(Seed.web.persisting Seed.web.Holds).Arises t ()) ∧
        (∀ (t : Nat), ¬(Seed.web.persisting fun t f => Seed.web.active t f ∨ 0 < Seed.reserve t).Arises t ()) ∧
          (Seed.web.persisting fun t f => Seed.web.active t f ∨ 0 < Seed.reserve t).Ceases 3 ()
Sleeper.held_readings : Sleeper.web.Unceasing ∧
  (∀ (N : Nat), ∃ t, N ≤ t ∧ Sleeper.web.Ceases t ()) ∧
    ∀ (t : Nat), ¬(Sleeper.web.persisting fun t x => Sleeper.web.active t x ∨ 0 < Sleeper.web.level t x).Arises t ()
World.reidentify : (w : World) → {R' : Type} → Reidentify w.Relatum R' → World
World.Conserves : (w : World) → Nat → w.Relatum → w.Relatum → Prop
@World.reidentify_taken : ∀ {w : World} {R' : Type} (σ : Reidentify w.Relatum R') (t : Nat) (y : R'),
  (w.reidentify σ).flow.taken t y = w.flow.taken t (σ.old t y)
@World.reidentify_given : ∀ {w : World} {R' : Type} (σ : Reidentify w.Relatum R') (t : Nat) (y : R'),
  (w.reidentify σ).flow.given t y = w.flow.given t (σ.old t y)
@World.balanced_iff_conserves : ∀ {w : World}, w.Balanced ↔ ∀ (t : Nat) (c : w.Relatum), w.Conserves t c c
@World.balanced_reidentify_iff : ∀ {w : World} {R' : Type} (σ : Reidentify w.Relatum R'),
  (w.reidentify σ).Balanced ↔ ∀ (t : Nat) (c : w.Relatum), w.Conserves t c (σ.old (t + 1) (σ.new t c))
@World.conserves_iff : ∀ {w : World},
  w.Balanced → ∀ {t : Nat} {g f : w.Relatum}, w.Conserves t g f ↔ w.web.level (t + 1) f = w.web.level (t + 1) g
@World.balanced_reidentify_iff_alike : ∀ {w : World} {R' : Type},
  w.Balanced →
    ∀ (σ : Reidentify w.Relatum R'),
      (w.reidentify σ).Balanced ↔
        ∀ (t : Nat),
          Alike (exchangeFrame w.Relatum) (exchangeFrame w.Relatum)
            (fun c => w.web.level (t + 1) (σ.old (t + 1) (σ.new t c))) (w.web.level (t + 1))
@World.standing_after : ∀ {w : World} {R' : Type},
  w.Balanced →
    ∀ {σ : Reidentify w.Relatum R'},
      (w.reidentify σ).Balanced →
        ∀ (t : Nat) (y : R'), w.web.level (t + 1) (σ.old (t + 1) y) = w.web.level (t + 1) (σ.old t y)
@World.kept_broken_reidentify : ∀ {w : World} {R' : Type},
  w.Balanced →
    ∀ {σ : Reidentify w.Relatum R'},
      (w.reidentify σ).Balanced →
        ∀ (t : Nat) (x y : R'),
          ((w.reidentify σ).web.Kept t x y ↔ w.web.Kept t (σ.old t x) (σ.old t y)) ∧
            ((w.reidentify σ).web.Broken t x y ↔ w.web.Broken t (σ.old t x) (σ.old t y))
@transpose : {X : Type} → [DecidableEq X] → X → X → X → X
@transpose_left : ∀ {X : Type} [inst : DecidableEq X] (c d : X), transpose c d c = d
@transpose_right : ∀ {X : Type} [inst : DecidableEq X] (c d : X), transpose c d d = c
@transpose_other : ∀ {X : Type} [inst : DecidableEq X] {c d x : X}, ¬x = c → ¬x = d → transpose c d x = x
@transpose_transpose : ∀ {X : Type} [inst : DecidableEq X] (c d x : X), transpose c d (transpose c d x) = x
@transpose_alike : ∀ {X : Type} [inst : DecidableEq X] {q : X → Nat} {c d : X},
  q d = q c → ∀ (x : X), q (transpose c d x) = q x
stepBeyond : Nat → Nat → Bool
stepBeyond_self : ∀ (t : Nat), stepBeyond t t = false
stepBeyond_next : ∀ (t : Nat), stepBeyond t (t + 1) = true
stepBeyond_zero : ∀ (t : Nat), stepBeyond t 0 = false
stepBeyond_step : ∀ (t s : Nat), ¬s = t → stepBeyond t (s + 1) = stepBeyond t s
@Reidentify.exchangeAfter : {X : Type} → [DecidableEq X] → Nat → X → X → Reidentify X X
@Reidentify.exchangeAfter_at : ∀ {X : Type} [inst : DecidableEq X] (t : Nat) (c d x : X),
  (Reidentify.exchangeAfter t c d).old t x = x ∧ (Reidentify.exchangeAfter t c d).new t x = x
@Reidentify.exchangeAfter_next : ∀ {X : Type} [inst : DecidableEq X] (t : Nat) (c d x : X),
  (Reidentify.exchangeAfter t c d).new (t + 1) x = transpose c d x
@Reidentify.exchangeAfter_across : ∀ {X : Type} [inst : DecidableEq X] (t : Nat) (c d x : X),
  (Reidentify.exchangeAfter t c d).old (t + 1) ((Reidentify.exchangeAfter t c d).new t x) = transpose c d x
@Reidentify.exchangeAfter_elsewhere : ∀ {X : Type} [inst : DecidableEq X] {t s : Nat},
  ¬s = t → ∀ (c d x : X), (Reidentify.exchangeAfter t c d).old (s + 1) ((Reidentify.exchangeAfter t c d).new s x) = x
@World.exchangeAfter_balanced : ∀ {w : World} [dec : DecidableEq w.Relatum],
  w.Balanced →
    ∀ {t : Nat} {c d : w.Relatum},
      w.web.level (t + 1) d = w.web.level (t + 1) c → (w.reidentify (Reidentify.exchangeAfter t c d)).Balanced
@World.fixed_iff : ∀ {w : World} [dec : DecidableEq w.Relatum],
  w.Balanced →
    ∀ (t : Nat) (c : w.Relatum),
      (∀ (σ : Reidentify w.Relatum w.Relatum), (w.reidentify σ).Balanced → σ.old (t + 1) (σ.new t c) = c) ↔
        ∀ (d : w.Relatum), w.web.level (t + 1) d = w.web.level (t + 1) c → d = c
@World.arises_fixed_iff : ∀ {w : World} [dec : DecidableEq w.Relatum],
  w.Balanced →
    ∀ (t : Nat) (f : w.Relatum),
      (∀ (σ : Reidentify w.Relatum w.Relatum),
          (w.reidentify σ).Balanced → (w.reidentify σ).web.Arises t (σ.new (t + 1) f)) ↔
        w.web.ArisesFrom w.Conserves t f
@World.ceases_fixed_iff : ∀ {w : World} [dec : DecidableEq w.Relatum],
  w.Balanced →
    ∀ (t : Nat) (g : w.Relatum),
      (∀ (σ : Reidentify w.Relatum w.Relatum), (w.reidentify σ).Balanced → (w.reidentify σ).web.Ceases t (σ.new t g)) ↔
        w.web.CeasesFrom w.Conserves t g
@World.conserves_noSplit : ∀ {w : World},
  w.Balanced →
    (∀ (t : Nat) (f f' : w.Relatum),
        w.web.active (t + 1) f → w.web.active (t + 1) f' → w.web.level (t + 1) f = w.web.level (t + 1) f' → f = f') →
      w.web.NoSplit w.Conserves
@World.conserves_noMerge : ∀ {w : World},
  w.Balanced →
    (∀ (t : Nat) (g g' : w.Relatum),
        w.web.active t g → w.web.active t g' → w.web.level (t + 1) g = w.web.level (t + 1) g' → g = g') →
      w.web.NoMerge w.Conserves
@World.still_of_apart : ∀ {w : World} {R' : Type},
  w.Balanced →
    (∀ (t : Nat) (c d : w.Relatum), w.web.level (t + 1) c = w.web.level (t + 1) d → c = d) →
      ∀ {σ : Reidentify w.Relatum R'}, (w.reidentify σ).Balanced → ∀ (t : Nat) (x : R'), σ.old (t + 1) x = σ.old t x
@Reidentify.old_still : ∀ {F F' : Type} {σ : Reidentify F F'},
  (∀ (t : Nat) (x : F'), σ.old (t + 1) x = σ.old t x) → ∀ (t : Nat) (x : F'), σ.old t x = σ.old 0 x
@World.renewed_still : ∀ {w : World} {R' : Type} {σ : Reidentify w.Relatum R'},
  (∀ (t : Nat) (x : R'), σ.old (t + 1) x = σ.old t x) →
    ∀ (y : R'), (w.reidentify σ).web.Renewed y ↔ w.web.Renewed (σ.old 0 y)
@World.consumed_still : ∀ {w : World} {R' : Type} {σ : Reidentify w.Relatum R'},
  (∀ (t : Nat) (x : R'), σ.old (t + 1) x = σ.old t x) →
    ∀ (y : R'), (w.reidentify σ).web.Consumed y ↔ w.web.Consumed (σ.old 0 y)
@World.classes_still : ∀ {w : World} {R' : Type} {σ : Reidentify w.Relatum R'},
  (∀ (t : Nat) (x : R'), σ.old (t + 1) x = σ.old t x) →
    ∀ (x : R'),
      ((w.reidentify σ).web.RenewingIn x ↔ w.web.RenewingIn (σ.old 0 x)) ∧
        ((w.reidentify σ).web.ConsumingIn x ↔ w.web.ConsumingIn (σ.old 0 x)) ∧
          ∀ (t : Nat), (w.reidentify σ).web.Arises t x ↔ w.web.Arises t (σ.old 0 x)
@World.classes_fixed : ∀ {w : World} {R' : Type},
  w.Balanced →
    (∀ (t : Nat) (c d : w.Relatum), w.web.level (t + 1) c = w.web.level (t + 1) d → c = d) →
      ∀ {σ : Reidentify w.Relatum R'},
        (w.reidentify σ).Balanced →
          ∀ (x : R'),
            ((w.reidentify σ).web.RenewingIn x ↔ w.web.RenewingIn (σ.old 0 x)) ∧
              ((w.reidentify σ).web.ConsumingIn x ↔ w.web.ConsumingIn (σ.old 0 x)) ∧
                ∀ (t : Nat), (w.reidentify σ).web.Arises t x ↔ w.web.Arises t (σ.old 0 x)
@Reidentify.roles : {F F' C : Type} → Reidentify F F' → Reidentify (F ⊕ C) (F' ⊕ C)
@World.ofRoles_reidentify_balanced : ∀ {F F' C : Type} (L : Flow F C) (W : Web F C) (σ : Reidentify F F'),
  ((World.ofRoles L W).reidentify σ.roles).Balanced ↔ L.Balances W
@World.ofRoles_reidentify_arises : ∀ {F F' C : Type} (L : Flow F C) (W : Web F C) (σ : Reidentify F F') (t : Nat)
  (x : F'), ((World.ofRoles L W).reidentify σ.roles).web.Arises t (Sum.inl x) ↔ (W.reidentify σ).Arises t x
@World.ofRoles_reidentify_unceasing : ∀ {F F' C : Type} (L : Flow F C) (W : Web F C) (σ : Reidentify F F'),
  ((World.ofRoles L W).reidentify σ.roles).web.Unceasing ↔ (W.reidentify σ).Unceasing
@World.ofRoles_reidentify_renewed : ∀ {F F' C : Type} (L : Flow F C) (W : Web F C) (σ : Reidentify F F') (c : C),
  ((World.ofRoles L W).reidentify σ.roles).web.Renewed (Sum.inr c) ↔ W.Renewed c
@World.ofRoles_reidentify_renewed_formation : ∀ {F F' C : Type} (L : Flow F C) (W : Web F C) (σ : Reidentify F F')
  (f : F'), ((World.ofRoles L W).reidentify σ.roles).web.Renewed (Sum.inl f)
@World.ofRoles_reidentify_consumed : ∀ {F F' C : Type} (L : Flow F C) (W : Web F C) (σ : Reidentify F F') (c : C),
  ((World.ofRoles L W).reidentify σ.roles).web.Consumed (Sum.inr c) ↔ W.Consumed c
@World.ofRoles_reidentify_renewingIn : ∀ {F F' C : Type} (L : Flow F C) (W : Web F C) (σ : Reidentify F F') (x : F'),
  ((World.ofRoles L W).reidentify σ.roles).web.RenewingIn (Sum.inl x) ↔ (W.reidentify σ).RenewingIn x
@World.ofRoles_reidentify_consumingIn : ∀ {F F' C : Type} (L : Flow F C) (W : Web F C) (σ : Reidentify F F') (x : F'),
  ((World.ofRoles L W).reidentify σ.roles).web.ConsumingIn (Sum.inl x) ↔ (W.reidentify σ).ConsumingIn x
Shuttle.holder_only : ∀ (t : Nat) (g : Bool), 0 < Shuttle.stands g t → g = Shuttle.holder t
Shuttle.asOne : Reidentify Bool Bool
Shuttle.conserved : (∀ (t : Nat), World.shuttle.web.ArisesFrom World.shuttle.Conserves t (Shuttle.holder (t + 1))) ∧
  (∀ (σ : Reidentify Bool Bool), (World.shuttle.reidentify σ).Balanced → (World.shuttle.reidentify σ).web.Unceasing) ∧
    Shuttle.asOne.KeepsActive World.shuttle.web ∧ ¬(World.shuttle.reidentify Shuttle.asOne).Balanced
Shuttle.alternates : ∀ (t : Nat),
  Shuttle.even t = 1 ∧ Shuttle.even (t + 1) = 0 ∨ Shuttle.even t = 0 ∧ Shuttle.even (t + 1) = 1
Shuttle.apart : ∀ (t : Nat) (c d : Bool), Shuttle.stands c (t + 1) = Shuttle.stands d (t + 1) → c = d
@Shuttle.named_as_themselves : ∀ {σ : Reidentify Bool Bool},
  (World.shuttle.reidentify σ).Balanced →
    (∀ (t : Nat) (x : Bool), σ.old t x = σ.old 0 x) ∧
      ∀ (x : (World.shuttle.reidentify σ).Relatum) (t : Nat),
        (World.shuttle.reidentify σ).web.Arises t x ↔ World.shuttle.web.Arises t (σ.old 0 x)
Lineage.world_readings : (World.ofRoles Flow.still Lineage.web).Balanced ∧
  ((World.ofRoles Flow.still Lineage.web).reidentify Lineage.one.roles).Balanced ∧
    (World.ofRoles Flow.still Lineage.web).web.Unceasing ∧
      (∀ (t : Nat) (x : ((World.ofRoles Flow.still Lineage.web).reidentify Lineage.one.roles).Relatum),
          ¬((World.ofRoles Flow.still Lineage.web).reidentify Lineage.one.roles).web.Arises t x) ∧
        ∀ (t : Nat) (x : (World.ofRoles Flow.still Lineage.web).Relatum),
          ¬(World.ofRoles Flow.still Lineage.web).web.ArisesFrom (World.ofRoles Flow.still Lineage.web).Conserves t x
Hibernation.world_readings : (World.ofRoles Flow.still Hibernation.web).Balanced ∧
  ((World.ofRoles Flow.still Hibernation.web).reidentify Hibernation.exchange.roles).Balanced ∧
    (World.ofRoles Flow.still Hibernation.web).web.RenewingIn (Sum.inl Hibernation.Formation.hibernator) ∧
      ((World.ofRoles Flow.still Hibernation.web).reidentify Hibernation.exchange.roles).web.ConsumingIn
          (Sum.inl Hibernation.Formation.hibernator) ∧
        ¬((World.ofRoles Flow.still Hibernation.web).reidentify Hibernation.exchange.roles).web.RenewingIn
            (Sum.inl Hibernation.Formation.hibernator)
@Web.stateClass : {F C : Type} → Web F C → (Nat → F → Prop) → «际» (Nat × F)
@Web.stateClass_class : ∀ {F C : Type} (W : Web F C) (h : Nat → F → Prop), «类» (W.stateClass h)
@Web.stateClass_finer : ∀ {F C : Type} (W : Web F C) (h : Nat → F → Prop),
  «则» (W.stateClass h) (W.persisting h).activityClass
@Web.wang_state_of_change : ∀ {F C : Type} {W : Web F C} {h : Nat → F → Prop} {t : Nat} {f : F},
  ¬(W.active t f ↔ W.active (t + 1) f) → «亡» (Web.continuationStep fun x g f => g = f) (W.stateClass h) (t, f)
@Web.sheng_state_of_change : ∀ {F C : Type} {W : Web F C} {h : Nat → F → Prop} {t : Nat} {f : F},
  ¬(W.active t f ↔ W.active (t + 1) f) → «生» (Web.continuationStep fun x g f => g = f) (W.stateClass h) (t + 1, f)
@Web.ceases_iff_wang_state : ∀ {F C : Type} {W : Web F C} {h : Nat → F → Prop},
  (∀ (t : Nat) (f : F), W.active t f → h t f) →
    ∀ {t : Nat} {f : F},
      W.Ceases t f ↔ W.active t f ∧ «亡» (Web.continuationStep fun x g f => g = f) (W.stateClass h) (t, f)
@Web.arises_iff_sheng_state : ∀ {F C : Type} {W : Web F C} {h : Nat → F → Prop},
  (∀ (t : Nat) (f : F), W.active t f → h t f) →
    ∀ {t : Nat} {f : F},
      W.Arises t f ↔ W.active (t + 1) f ∧ «生» (Web.continuationStep fun x g f => g = f) (W.stateClass h) (t + 1, f)
@Web.ceases_of_persisting_ceases : ∀ {F C : Type} {W : Web F C} {h : Nat → F → Prop},
  (∀ (t : Nat) (f : F), W.active t f → h t f) →
    ∀ {t : Nat} {f : F}, (W.persisting h).Ceases t f → W.active t f → W.Ceases t f
@Web.arises_of_persisting_arises : ∀ {F C : Type} {W : Web F C} {h : Nat → F → Prop},
  (∀ (t : Nat) (f : F), W.active t f → h t f) →
    ∀ {t : Nat} {f : F}, (W.persisting h).Arises t f → W.active (t + 1) f → W.Arises t f
@Web.fallsDormant_alters : ∀ {F C : Type} {W : Web F C} {h : Nat → F → Prop},
  (∀ (t : Nat) (f : F), W.active t f → h t f) →
    ∀ {t : Nat} {f : F},
      W.active t f →
        ¬W.active (t + 1) f →
          h (t + 1) f →
            «亡» (Web.continuationStep fun x g f => g = f) (W.stateClass h) (t, f) ∧
              «异» (Web.continuationStep fun x g f => g = f) (W.persisting h).activityClass (W.stateClass h) (t, f)
                (t + 1, f)
@Web.wakes_alters : ∀ {F C : Type} {W : Web F C} {h : Nat → F → Prop},
  (∀ (t : Nat) (f : F), W.active t f → h t f) →
    ∀ {t : Nat} {f : F},
      h t f →
        ¬W.active t f →
          W.active (t + 1) f →
            «生» (Web.continuationStep fun x g f => g = f) (W.stateClass h) (t + 1, f) ∧
              «异» (Web.continuationStep fun x g f => g = f) (W.persisting h).activityClass (W.stateClass h) (t, f)
                (t + 1, f)
@Web.names_line_same : ∀ {F : Type} {E : «际» (Nat × F)} {x y : Nat × F},
  «相续» (Web.continuationStep fun x g f => g = f) E x y → x.snd = y.snd
@Web.unending_of_holds : ∀ {F C : Type} {W : Web F C} {h : Nat → F → Prop} {f : F},
  (∀ (s : Nat), h s f) →
    ∀ (t : Nat), «不穷» (Web.continuationStep fun x g f => g = f) (W.persisting h).activityClass (t, f)
@World.arises_fixed_iff_sheng : ∀ {w : World} [dec : DecidableEq w.Relatum],
  w.Balanced →
    ∀ (t : Nat) (f : w.Relatum),
      (∀ (σ : Reidentify w.Relatum w.Relatum),
          (w.reidentify σ).Balanced → (w.reidentify σ).web.Arises t (σ.new (t + 1) f)) ↔
        w.web.active (t + 1) f ∧ «生» (Web.continuationStep w.Conserves) w.web.activityClass (t + 1, f)
@World.ceases_fixed_iff_wang : ∀ {w : World} [dec : DecidableEq w.Relatum],
  w.Balanced →
    ∀ (t : Nat) (g : w.Relatum),
      (∀ (σ : Reidentify w.Relatum w.Relatum), (w.reidentify σ).Balanced → (w.reidentify σ).web.Ceases t (σ.new t g)) ↔
        w.web.active t g ∧ «亡» (Web.continuationStep w.Conserves) w.web.activityClass (t, g)
Hibernation.positions : «则» (Hibernation.web.stateClass Hibernation.web.Holds)
    (Hibernation.web.persisting Hibernation.web.Holds).activityClass ∧
  «亡» (Web.continuationStep fun x g f => g = f) (Hibernation.web.stateClass Hibernation.web.Holds)
      (0, Hibernation.Formation.hibernator) ∧
    ¬«亡» (Web.continuationStep fun x g f => g = f) (Hibernation.web.persisting Hibernation.web.Holds).activityClass
          (0, Hibernation.Formation.hibernator) ∧
      «住» (Web.continuationStep fun x g f => g = f) (Hibernation.web.persisting Hibernation.web.Holds).activityClass
          (1, Hibernation.Formation.hibernator) ∧
        «生» (Web.continuationStep fun x g f => g = f) (Hibernation.web.stateClass Hibernation.web.Holds)
            (1, Hibernation.Formation.hibernator) ∧
          «亡» (Web.continuationStep fun x g f => g = f) (Hibernation.web.stateClass Hibernation.web.Holds)
              (1, Hibernation.Formation.hibernator) ∧
            «不穷» (Web.continuationStep fun x g f => g = f)
              (Hibernation.web.persisting Hibernation.web.Holds).activityClass (0, Hibernation.Formation.hibernator)
Seed.held_classes : (∀ (t : Nat),
    «不穷» (Web.continuationStep fun x g f => g = f) (Seed.web.persisting Seed.web.Holds).activityClass (t, ())) ∧
  «亡» (Web.continuationStep fun x g f => g = f)
    (Seed.web.persisting fun t f => Seed.web.active t f ∨ 0 < Seed.reserve t).activityClass (3, ())
