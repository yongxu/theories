  W.Whole parts w → ∀ {t : Nat}, W.Ceases t w → ∃ p, parts p ∧ W.Ceases t p
@Web.AllWhole.active_whole : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w v : F},
  W.AllWhole parts v → W.Whole parts w → ∀ {p₀ : F}, parts p₀ → ∀ {t : Nat}, W.active t v → W.active t w
@Web.Whole.same_iff_inStep : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w v : F},
  W.Whole parts w →
    W.AllWhole parts v → ∀ {p₀ : F}, parts p₀ → ((∀ (t : Nat), W.active t w ↔ W.active t v) ↔ W.InStep parts)
@Web.AllWhole.active_of_none : ∀ {F C : Type} {W : Web F C} {parts : F → Prop} {w : F},
  W.AllWhole parts w → (∀ (p : F), ¬parts p) → ∀ (t : Nat), W.active t w ∧ ∀ {v : F}, W.Whole parts v → ¬W.active t v
@Counts.lt_length_of_fails : ∀ {α : Type} {q : α → Prop} {a : α},
  ¬q a → ∀ {as : List α} {n : Nat}, Counts as q n → a ∈ as → n < as.length
@Counts.all_of_eq_length : ∀ {α : Type} {q : α → Prop} {as : List α} {n : Nat},
  Counts as q n → n = as.length → ∀ (a : α), a ∈ as → q a
@Web.Grade : {F C : Type} → Web F C → List F → Nat → Nat → Prop
@Web.AtLeastWhole : {F C : Type} → Web F C → Nat → List F → F → Prop
@Web.Diminished : {F C : Type} → Web F C → List F → Nat → Prop
@Web.Grade.pos_iff : ∀ {F C : Type} {W : Web F C} {ps : List F} {t n : Nat},
  W.Grade ps t n → (0 < n ↔ ∃ p, p ∈ ps ∧ W.active t p)
@Web.Grade.eq_length_iff : ∀ {F C : Type} {W : Web F C} {ps : List F} {t n : Nat},
  W.Grade ps t n → (n = ps.length ↔ ∀ (p : F), p ∈ ps → W.active t p)
@Web.Grade.lt_length_of_inactive : ∀ {F C : Type} {W : Web F C} {ps : List F} {t n : Nat},
  W.Grade ps t n → ∀ {p : F}, p ∈ ps → ¬W.active t p → n < ps.length
@Web.Grade.across_step : ∀ {F C : Type} {W : Web F C} {ps : List F} {t n n' a c : Nat},
  W.Grade ps t n → W.Grade ps (t + 1) n' → Counts ps (W.Arises t) a → Counts ps (W.Ceases t) c → n' + c = n + a
@Web.Grade.arises_of_lt : ∀ {F C : Type} {W : Web F C} {ps : List F} {t n n' : Nat},
  W.Grade ps t n → W.Grade ps (t + 1) n' → n < n' → ∃ p, p ∈ ps ∧ W.Arises t p
@Web.Grade.ceases_of_lt : ∀ {F C : Type} {W : Web F C} {ps : List F} {t n n' : Nat},
  W.Grade ps t n → W.Grade ps (t + 1) n' → n' < n → ∃ p, p ∈ ps ∧ W.Ceases t p
@Web.AtLeastWhole.arises_part : ∀ {F C : Type} {W : Web F C} {w : F} {ps : List F} {j : Nat},
  W.AtLeastWhole j ps w → ∀ {t : Nat}, W.Arises t w → ∃ p, p ∈ ps ∧ W.Arises t p
@Web.AtLeastWhole.ceases_part : ∀ {F C : Type} {W : Web F C} {w : F} {ps : List F} {j : Nat},
  W.AtLeastWhole j ps w → ∀ {t : Nat}, W.Ceases t w → ∃ p, p ∈ ps ∧ W.Ceases t p
@Web.AtLeastWhole.whole : ∀ {F C : Type} {W : Web F C} {w : F} {ps : List F},
  W.AtLeastWhole 1 ps w → W.Whole (fun x => x ∈ ps) w
@Web.Whole.atLeastWhole : ∀ {F C : Type} {W : Web F C} {w : F} {ps : List F},
  W.Whole (fun x => x ∈ ps) w → (∀ (t : Nat) (p : F), p ∈ ps → Decided (W.active t p)) → W.AtLeastWhole 1 ps w
@Web.AtLeastWhole.allWhole : ∀ {F C : Type} {W : Web F C} {w : F} {ps : List F},
  W.AtLeastWhole ps.length ps w → W.AllWhole (fun x => x ∈ ps) w
@Web.AllWhole.atLeastWhole : ∀ {F C : Type} {W : Web F C} {w : F} {ps : List F},
  W.AllWhole (fun x => x ∈ ps) w →
    (∀ (t : Nat) (p : F), p ∈ ps → Decided (W.active t p)) → W.AtLeastWhole ps.length ps w
@Web.AllWhole.arises_part : ∀ {F C : Type} {W : Web F C} {w : F} {ps : List F},
  W.AllWhole (fun x => x ∈ ps) w →
    (∀ (t : Nat) (p : F), p ∈ ps → Decided (W.active t p)) → ∀ {t : Nat}, W.Arises t w → ∃ p, p ∈ ps ∧ W.Arises t p
@Web.AllWhole.ceases_part : ∀ {F C : Type} {W : Web F C} {w : F} {ps : List F},
  W.AllWhole (fun x => x ∈ ps) w →
    (∀ (t : Nat) (p : F), p ∈ ps → Decided (W.active t p)) → ∀ {t : Nat}, W.Ceases t w → ∃ p, p ∈ ps ∧ W.Ceases t p
@Web.Grade.diminished_iff : ∀ {F C : Type} {W : Web F C} {w : F} {ps : List F} {v : F},
  W.Whole (fun x => x ∈ ps) w →
    W.AllWhole (fun x => x ∈ ps) v →
      ∀ {t n : Nat}, W.Grade ps t n → (0 < n ∧ n < ps.length ↔ W.active t w ∧ ¬W.active t v)
@Web.diminished_iff : ∀ {F C : Type} {W : Web F C} {w : F} {ps : List F} {v : F},
  W.Whole (fun x => x ∈ ps) w →
    W.AllWhole (fun x => x ∈ ps) v →
      ∀ {t : Nat}, (∀ (p : F), p ∈ ps → Decided (W.active t p)) → (W.Diminished ps t ↔ W.active t w ∧ ¬W.active t v)
