  (σ : Becoming.Reidentify F F') {t : Nat} {x : F'} {u : Nat} {y : F'} :
  (W.reidentify σ).Continuing (σ.carry R) t x u y ↔ W.Continuing R t (σ.old t x) u (σ.old u y)
Becoming.Web.renewingAlong_reidentify {F F' C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop}
  (σ : Becoming.Reidentify F F') {t : Nat} {x : F'} :
  (W.reidentify σ).RenewingAlong (σ.carry R) t x ↔ W.RenewingAlong R t (σ.old t x)
