  Becoming.Web.Linked Becoming.Web.itself s h t g → s ≤ t ∧ h = g
Becoming.Web.Linked.itself_steps {F : Type} {g : F} (k s : Nat) : Becoming.Web.Linked Becoming.Web.itself s g (s + k) g
Becoming.Web.Linked.itself_of_le {F : Type} {s t : Nat} {g : F} (later : s ≤ t) :
