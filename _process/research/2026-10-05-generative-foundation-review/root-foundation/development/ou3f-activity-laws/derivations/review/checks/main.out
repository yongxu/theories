  {g g' f : F} (before : W.active t g) (before' : W.active t g') (r : R t g f) (r' : R t g' f)
  (after : W.active (t + 1) f) (consuming : W.ConsumingAlong R (t + 1) f) :
  W.ConsumingAlong R t g ∧ W.ConsumingAlong R t g'
