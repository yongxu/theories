  {t : Nat} {g : F} :
  Becoming.Web.Linked (W.holdingOn R c) s h t g →
    (s, h) = (t, g) ∨
      W.requires s h c ∧ Becoming.«相续» (Becoming.Web.continuationStep R) (W.dependenceClass c) (s, h) (t, g)
Becoming.Web.line_held {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {c : C} {x y : Nat × F}
  (line : Becoming.«及» (Becoming.«续» (Becoming.Web.continuationStep R) (W.dependenceClass c)) x y) :
  W.requires x.fst x.snd c → Becoming.Web.Linked (W.holdingOn R c) x.fst x.snd y.fst y.snd
Becoming.Web.held_iff_line {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {c : C} {s : Nat} {h : F}
  {t : Nat} {g : F} (held : W.requires s h c) :
  Becoming.Web.Linked (W.holdingOn R c) s h t g ↔
    (s, h) = (t, g) ∨ Becoming.«相续» (Becoming.Web.continuationStep R) (W.dependenceClass c) (s, h) (t, g)
Becoming.Web.metAboveAlong_iff_line {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {t : Nat} {g : F}
  {c : C} {m : Nat} :
  W.MetAboveAlong R t g c m ↔
    ∃ s h,
      ((s, h) = (t, g) ∨ Becoming.«相续» (Becoming.Web.continuationStep R) (W.dependenceClass c) (s, h) (t, g)) ∧
        W.requires s h c ∧ W.need s h c ≤ W.level s c ∧ m < W.need s h c
Becoming.Web.line_image {α β : Type} {R₁ E₁ : Becoming.«际» α} {R₂ E₂ : Becoming.«际» β} (φ : α → β)
  (step : ∀ (x y : α), Becoming.«续» R₁ E₁ x y → Becoming.«续» R₂ E₂ (φ x) (φ y)) {x y : α}
  (line : Becoming.«相续» R₁ E₁ x y) : Becoming.«相续» R₂ E₂ (φ x) (φ y)
Becoming.Web.carry_step_iff {F F' C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop}
  (σ : Becoming.Reidentify F F') {x y : Nat × F'} :
  Becoming.«续» (Becoming.Web.continuationStep (σ.carry R)) (W.reidentify σ).activityClass x y ↔
    Becoming.«续» (Becoming.Web.continuationStep R) W.activityClass (x.fst, σ.old x.fst x.snd) (y.fst, σ.old y.fst y.snd)
Becoming.Web.line_reidentify {F F' C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop}
  (σ : Becoming.Reidentify F F') {t u : Nat} {x y : F'} :
  Becoming.«相续» (Becoming.Web.continuationStep (σ.carry R)) (W.reidentify σ).activityClass (t, x) (u, y) ↔
    Becoming.«相续» (Becoming.Web.continuationStep R) W.activityClass (t, σ.old t x) (u, σ.old u y)
Becoming.MergeClass.candles :
  Becoming.«续» (Becoming.Web.continuationStep Becoming.MergeClass.merge) Becoming.MergeClass.web.activityClass
      (0, Becoming.MergeClass.Formation.first) (1, Becoming.MergeClass.Formation.merged) ∧
    Becoming.«续» (Becoming.Web.continuationStep Becoming.MergeClass.merge) Becoming.MergeClass.web.activityClass
        (0, Becoming.MergeClass.Formation.second) (1, Becoming.MergeClass.Formation.merged) ∧
      Becoming.«同族» (Becoming.Web.continuationStep Becoming.MergeClass.merge) Becoming.MergeClass.web.activityClass
        (0, Becoming.MergeClass.Formation.first) (0, Becoming.MergeClass.Formation.second)
Becoming.MergeClass.both_consume_along :
  Becoming.MergeClass.web.ConsumingAlong Becoming.MergeClass.merge 0 Becoming.MergeClass.Formation.first ∧
    Becoming.MergeClass.web.ConsumingAlong Becoming.MergeClass.merge 0 Becoming.MergeClass.Formation.second
Becoming.Bud.fission :
  Becoming.«相续» (Becoming.Web.continuationStep Becoming.Bud.bud) Becoming.Bud.web.activityClass
      (0, Becoming.Bud.Formation.old) (1, Becoming.Bud.Formation.old) ∧
    Becoming.«相续» (Becoming.Web.continuationStep Becoming.Bud.bud) Becoming.Bud.web.activityClass
        (0, Becoming.Bud.Formation.old) (1, Becoming.Bud.Formation.fresh) ∧
      ¬Becoming.«相续» (Becoming.Web.continuationStep Becoming.Bud.bud) Becoming.Bud.web.activityClass
            (1, Becoming.Bud.Formation.old) (1, Becoming.Bud.Formation.fresh) ∧
        ¬Becoming.«相续» (Becoming.Web.continuationStep Becoming.Bud.bud) Becoming.Bud.web.activityClass
              (1, Becoming.Bud.Formation.fresh) (1, Becoming.Bud.Formation.old) ∧
          (1, Becoming.Bud.Formation.old) ≠ (1, Becoming.Bud.Formation.fresh) ∧
            Becoming.«同族» (Becoming.Web.continuationStep Becoming.Bud.bud) Becoming.Bud.web.activityClass
              (1, Becoming.Bud.Formation.old) (1, Becoming.Bud.Formation.fresh)
Becoming.Web.carrying {F C : Type} (W : Becoming.Web F C) (carries : Nat → F → Prop) : Becoming.Web F C
Becoming.Web.carrying_active {F C : Type} (W : Becoming.Web F C) (carries : Nat → F → Prop) {t : Nat} {a : F}
  (active : (W.carrying carries).active t a) : W.active t a
Becoming.Web.carrying_iff {F C : Type} (W : Becoming.Web F C) {carries : Nat → F → Prop}
  (carried : ∀ (t : Nat) (a : F), carries t a → W.active t a) (t : Nat) (a : F) :
  (W.carrying carries).active t a ↔ carries t a
Becoming.Web.Present {F C : Type} (V : Becoming.Web F C) (t : Nat) : Prop
Becoming.Web.PassesAt {F C : Type} (V : Becoming.Web F C) (passes : Nat → F → F → Prop) (t : Nat) : Prop
Becoming.Web.ByPassing {F C : Type} (V : Becoming.Web F C) (passes : Nat → F → F → Prop) : Prop
Becoming.Web.begins_within {F C : Type} {V : Becoming.Web F C} {d T : Nat} (present : ∀ (t : Nat), T ≤ t → V.Present t)
  (brief : ∀ (a : F), V.Brief d a) {S : Nat} (after : T ≤ S) : ¬∀ (j : Nat), j < d → ∀ (a : F), ¬V.Arises (S + j) a
Becoming.Web.ByPassing.begins_passed {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop}
  (by_passing : V.ByPassing passes) {t : Nat} {a : F} (begins : V.Arises t a) : ∃ b, V.active t b ∧ passes t b a
Becoming.Web.ByPassing.trace {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop}
  (by_passing : V.ByPassing passes) {S k : Nat} {a : F} :
  V.active (S + k) a → V.active S a ∨ ∃ j, j < k ∧ V.PassesAt passes (S + j)
Becoming.Web.ByPassing.passes_within {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop}
  (by_passing : V.ByPassing passes) {d T : Nat} (present : ∀ (t : Nat), T ≤ t → V.Present t)
  (brief : ∀ (a : F), V.Brief d a) {S : Nat} (after : T ≤ S) : ∃ j, j < d ∧ V.PassesAt passes (S + j)
Becoming.Web.ByPassing.present_back {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop}
  (by_passing : V.ByPassing passes) {t : Nat} (present : V.Present (t + 1)) : V.Present t
Becoming.Web.ByPassing.present_earlier {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop}
  (by_passing : V.ByPassing passes) {t k : Nat} : V.Present (t + k) → V.Present t
Becoming.Web.ByPassing.present_of_le {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop}
  (by_passing : V.ByPassing passes) {t t' : Nat} (le : t ≤ t') (present : V.Present t') : V.Present t
Becoming.Web.ByPassing.empty_stays {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop}
  (by_passing : V.ByPassing passes) {t : Nat} (empty : ¬V.Present t) {t' : Nat} (later : t ≤ t') : ¬V.Present t'
Becoming.Web.ByPassing.ends_within {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop}
  (by_passing : V.ByPassing passes) {d T : Nat} (brief : ∀ (a : F), V.Brief d a)
  (stopped : ∀ (t : Nat), T ≤ t → ¬V.PassesAt passes t) {t : Nat} (later : T + d ≤ t) : ¬V.Present t
Becoming.PatternRelay.web : Becoming.Web Nat Unit
Becoming.PatternRelay.passes (t b a : Nat) : Prop
Becoming.PatternRelay.brief (n : Nat) : Becoming.PatternRelay.web.Brief 2 n
Becoming.PatternRelay.relay :
  Becoming.PatternRelay.web.ByPassing Becoming.PatternRelay.passes ∧
    (∀ (n : Nat), Becoming.PatternRelay.web.Brief 2 n) ∧
      (∀ (n : Nat), Becoming.PatternRelay.web.Ends n) ∧
        (∀ (t : Nat), Becoming.PatternRelay.web.Present t) ∧
          ∀ (t : Nat), Becoming.PatternRelay.web.PassesAt Becoming.PatternRelay.passes t
Becoming.PatternRelay.stopped (T : Nat) : Becoming.Web Nat Unit
Becoming.PatternRelay.passesUntil (T t b a : Nat) : Prop
Becoming.PatternRelay.stopped_by_passing (T : Nat) :
  (Becoming.PatternRelay.stopped T).ByPassing (Becoming.PatternRelay.passesUntil T)
Becoming.PatternRelay.stopped_brief (T n : Nat) : (Becoming.PatternRelay.stopped T).Brief 2 n
Becoming.PatternRelay.stopped_quiet (T t : Nat) :
  T ≤ t → ¬(Becoming.PatternRelay.stopped T).PassesAt (Becoming.PatternRelay.passesUntil T) t
Becoming.PatternRelay.stopped_relay (T : Nat) :
  (Becoming.PatternRelay.stopped T).ByPassing (Becoming.PatternRelay.passesUntil T) ∧
    (∀ (n : Nat), (Becoming.PatternRelay.stopped T).Brief 2 n) ∧
      (∀ (t : Nat), T ≤ t → ¬(Becoming.PatternRelay.stopped T).PassesAt (Becoming.PatternRelay.passesUntil T) t) ∧
        (∀ (t : Nat), t ≤ T + 1 → (Becoming.PatternRelay.stopped T).Present t) ∧
          ∀ (t : Nat), T + 2 ≤ t → ¬(Becoming.PatternRelay.stopped T).Present t
Becoming.PatternRelay.half_odd (t : Nat) :
  Becoming.odd t = true → Becoming.Pulse.half (t + 1) = Becoming.Pulse.half t + 1
Becoming.PatternRelay.shifted : Becoming.Web Nat Unit
Becoming.PatternRelay.passesOdd (t b a : Nat) : Prop
Becoming.PatternRelay.shifts :
  Becoming.PatternRelay.shifted.ByPassing Becoming.PatternRelay.passesOdd ∧
    (∀ (n : Nat), Becoming.PatternRelay.shifted.Brief 2 n) ∧
      (∀ (t : Nat), Becoming.PatternRelay.shifted.Present t) ∧
        (∀ (t : Nat),
            Becoming.odd t = false → ¬Becoming.PatternRelay.shifted.PassesAt Becoming.PatternRelay.passesOdd t) ∧
          ∀ (t : Nat), Becoming.odd t = false → ∀ (n : Nat), ¬Becoming.PatternRelay.shifted.Arises t n
Becoming.Web.passingContinuation {F : Type} (passes : Nat → F → F → Prop) (t : Nat) (b a : F) : Prop
Becoming.Web.sameFormation {F : Type} : Becoming.«际» (Nat × F)
Becoming.Web.carrierClass {F C : Type} (V : Becoming.Web F C) : Becoming.«际» (Nat × F)
Becoming.Web.carrierClass_class {F C : Type} (V : Becoming.Web F C) : Becoming.«类» V.carrierClass
Becoming.Web.carrierClass_finer {F C : Type} (V : Becoming.Web F C) : Becoming.«则» V.carrierClass V.activityClass
Becoming.Web.byPassing_iff_continues {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop} :
  V.ByPassing passes ↔
    ∀ (t : Nat) (a : F), V.active (t + 1) a → V.Continues (Becoming.Web.passingContinuation passes) t a
Becoming.Web.byPassing_iff_hasPred {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop} :
  V.ByPassing passes ↔
    ∀ (t : Nat) (a : F),
      V.active (t + 1) a →
        Becoming.«有前» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.activityClass
          (t + 1, a)
Becoming.Web.arises_iff_sheng_carrier {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop} {t : Nat}
  {a : F} :
  V.Arises t a ↔
    V.active (t + 1) a ∧
      Becoming.«生» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.carrierClass (t + 1, a)
Becoming.Web.ceases_iff_wang_carrier {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop} {t : Nat}
  {b : F} :
  V.Ceases t b ↔
    V.active t b ∧
      Becoming.«亡» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.carrierClass (t, b)
Becoming.Web.passesAt_of_alters {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop} {x y : Nat × F}
  (carrying : V.active x.fst x.snd)
  (alters :
    Becoming.«异» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.activityClass
      V.carrierClass x y) :
  V.PassesAt passes x.fst
Becoming.Web.alters_of_passes {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop} {t : Nat} {b a : F}
  (carrier : V.active t b) (given : passes t b a) (carried : V.active (t + 1) a) (other : ¬b = a) :
  Becoming.«异» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.activityClass V.carrierClass
    (t, b) (t + 1, a)
Becoming.Web.passing_fire {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop} {t : Nat} {b a : F}
  (ceases : V.Ceases t b) (given : passes t b a) (carried : V.active (t + 1) a) :
  Becoming.«亡» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.carrierClass (t, b) ∧
    ¬Becoming.«亡» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.activityClass (t, b) ∧
      Becoming.«异» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.activityClass
        V.carrierClass (t, b) (t + 1, a)
Becoming.Web.ceases_of_pattern_ends {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop} {t : Nat} {b : F}
  (carrying : V.active t b)
  (ends :
    Becoming.«亡» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.activityClass (t, b)) :
  V.Ceases t b
Becoming.Web.ByPassing.line_back {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop}
  (byPassing : V.ByPassing passes) {S k : Nat} {a : F} :
  V.active (S + (k + 1)) a →
    ∃ b,
      V.active S b ∧
        Becoming.«相续» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.activityClass (S, b)
          (S + (k + 1), a)
Becoming.Web.ByPassing.passes_within_by_line {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop}
  (byPassing : V.ByPassing passes) {d T : Nat} (present : ∀ (t : Nat), T ≤ t → V.Present t)
  (brief : ∀ (a : F), V.Brief d a) {S : Nat} (after : T ≤ S) : ∃ j, j < d ∧ V.PassesAt passes (S + j)
Becoming.Web.ByPassing.begins_passed_by_grammar {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop}
  (byPassing : V.ByPassing passes) {t : Nat} {a : F} (begins : V.Arises t a) : ∃ b, V.active t b ∧ passes t b a
Becoming.PatternRelay.shifted_fire (t : Nat) (parity : Becoming.odd t = true) :
  Becoming.«亡» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation Becoming.PatternRelay.passesOdd))
      Becoming.PatternRelay.shifted.carrierClass (t, Becoming.Pulse.half t) ∧
    ¬Becoming.«亡» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation Becoming.PatternRelay.passesOdd))
          Becoming.PatternRelay.shifted.activityClass (t, Becoming.Pulse.half t) ∧
      Becoming.«异» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation Becoming.PatternRelay.passesOdd))
        Becoming.PatternRelay.shifted.activityClass Becoming.PatternRelay.shifted.carrierClass
        (t, Becoming.Pulse.half t) (t + 1, Becoming.Pulse.half t + 1)
Becoming.PatternRelay.fire_shape :
  Becoming.«则» Becoming.PatternRelay.shifted.carrierClass Becoming.PatternRelay.shifted.activityClass ∧
    Becoming.«亡» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation Becoming.PatternRelay.passesOdd))
        Becoming.PatternRelay.shifted.carrierClass (1, 0) ∧
      ¬Becoming.«亡» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation Becoming.PatternRelay.passesOdd))
          Becoming.PatternRelay.shifted.activityClass (1, 0)
