Becoming.Web.Continuing {F C : Type} (W : Becoming.Web F C) (R : Nat → F → F → Prop) : Nat → F → Nat → F → Prop
Becoming.Web.RenewingAlong {F C : Type} (W : Becoming.Web F C) (R : Nat → F → F → Prop) (t : Nat) (g : F) : Prop
Becoming.Web.ConsumingAlong {F C : Type} (W : Becoming.Web F C) (R : Nat → F → F → Prop) (t : Nat) (g : F) : Prop
Becoming.Web.renewingAlong_not_consumingAlong {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {t : Nat}
  {g : F} (renewing : W.RenewingAlong R t g) : ¬W.ConsumingAlong R t g
Becoming.Web.renewingAlong_iff {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {t : Nat} {g : F} :
  W.RenewingAlong R t g ↔
    (∀ (c : C), W.Participates t g c → W.Renewed c) ∧
      ∀ (f : F), W.active t g → R t g f → W.active (t + 1) f → W.RenewingAlong R (t + 1) f
Becoming.Web.RenewingAlong.branch {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {t : Nat} {g f : F}
  (renewing : W.RenewingAlong R t g) (before : W.active t g) (continues : R t g f) (after : W.active (t + 1) f) :
  W.RenewingAlong R (t + 1) f
Becoming.Web.consumingAlong_iff {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {t : Nat} {g : F} :
  W.ConsumingAlong R t g ↔
    (∃ c, W.draws t g c ∧ W.Consumed c) ∨
      ∃ f, W.active t g ∧ R t g f ∧ W.active (t + 1) f ∧ W.ConsumingAlong R (t + 1) f
Becoming.Web.ConsumingAlong.merged {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {t : Nat} {g f : F}
  (consuming : W.ConsumingAlong R (t + 1) f) (before : W.active t g) (continues : R t g f)
  (after : W.active (t + 1) f) : W.ConsumingAlong R t g
