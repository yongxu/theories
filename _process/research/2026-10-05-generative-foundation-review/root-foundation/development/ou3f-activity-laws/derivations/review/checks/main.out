Becoming.Web.line_continuing {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {x y : Nat × F}
  (line : Becoming.«及» (Becoming.«续» (Becoming.Web.continuationStep R) W.activityClass) x y) :
  W.active x.fst x.snd → W.Continuing R x.fst x.snd y.fst y.snd
Becoming.Web.Continuing.line {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {t : Nat} {g : F} {u : Nat}
  {h : F} :
  W.Continuing R t g u h →
    (t, g) = (u, h) ∨ W.active t g ∧ Becoming.«相续» (Becoming.Web.continuationStep R) W.activityClass (t, g) (u, h)
Becoming.Web.continuing_iff_line {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {t : Nat} {g : F}
  {u : Nat} {h : F} :
  W.Continuing R t g u h ↔
    (t, g) = (u, h) ∨ W.active t g ∧ Becoming.«相续» (Becoming.Web.continuationStep R) W.activityClass (t, g) (u, h)
Becoming.Web.Continuing.mono_by_reach {F C : Type} {W : Becoming.Web F C} {R S : Nat → F → F → Prop}
  (within : ∀ (t : Nat) (g f : F), R t g f → S t g f) {t : Nat} {g : F} {u : Nat} {h : F}
  (continuing : W.Continuing R t g u h) : W.Continuing S t g u h
Becoming.Web.renewingAlong_iff_line {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {t : Nat} {g : F} :
  W.RenewingAlong R t g ↔
    ∀ (y : Nat × F),
      (t, g) = y ∨ W.active t g ∧ Becoming.«相续» (Becoming.Web.continuationStep R) W.activityClass (t, g) y →
        ∀ (c : C), W.Participates y.fst y.snd c → W.Renewed c
Becoming.Web.consumingAlong_iff_line {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {t : Nat} {g : F} :
  W.ConsumingAlong R t g ↔
    ∃ y,
      ((t, g) = y ∨ W.active t g ∧ Becoming.«相续» (Becoming.Web.continuationStep R) W.activityClass (t, g) y) ∧
        ∃ c, W.draws y.fst y.snd c ∧ W.Consumed c
Becoming.Web.RenewingAlong.branches {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {t : Nat} {g f f' : F}
  (renewing : W.RenewingAlong R t g) (before : W.active t g) (r : R t g f) (r' : R t g f') (after : W.active (t + 1) f)
  (after' : W.active (t + 1) f') (apart : f ≠ f') :
  W.RenewingAlong R (t + 1) f ∧
    W.RenewingAlong R (t + 1) f' ∧
      ¬Becoming.«相续» (Becoming.Web.continuationStep R) W.activityClass (t + 1, f) (t + 1, f') ∧
        ¬Becoming.«相续» (Becoming.Web.continuationStep R) W.activityClass (t + 1, f') (t + 1, f)
