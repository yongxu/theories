Becoming.Web.linked_iff_line {F : Type} {R : Nat → F → F → Prop} {t : Nat} {g : F} {u : Nat} {h : F} :
  Becoming.Web.Linked R t g u h ↔
    (t, g) = (u, h) ∨ Becoming.«相续» (Becoming.Web.continuationStep R) Becoming.«一» (t, g) (u, h)
