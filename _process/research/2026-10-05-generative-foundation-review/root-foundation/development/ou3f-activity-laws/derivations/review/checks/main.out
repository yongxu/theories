Becoming.Web.includesAcross_itself_iff {F C : Type} {W : Becoming.Web F C} {l : Nat → C → Nat} {T U : Nat}
  (later : T ≤ U) : W.IncludesAcross Becoming.Web.itself l T U ↔ ∀ (f : F), W.Admits (l T) T f → W.Admits (l U) U f
Becoming.Web.exceedsAcross_itself_iff {F C : Type} {W : Becoming.Web F C} {l : Nat → C → Nat} {T U : Nat}
  (later : T ≤ U) : W.ExceedsAcross Becoming.Web.itself l T U ↔ ∃ g, W.Admits (l U) U g ∧ ¬W.Admits (l T) T g
