  let targets : NameSet := [`Becoming.Web.Lineage.unique, `Becoming.Web.Lineage.origin, `Becoming.Web.Lineage.split, `Becoming.Web.Lineage.through, `Becoming.Web.Lineage.onward, `Becoming.Web.Lineage.back, `Becoming.Web.Lineage.ends, `Becoming.Web.lineages_apart, `Becoming.Web.steps_iff_lineage, `Becoming.Web.steps_start_active, `Becoming.Web.activityFrom, `Becoming.Web.steps_advance, `Becoming.Web.Lineage].foldl (·.insert ·) {}
