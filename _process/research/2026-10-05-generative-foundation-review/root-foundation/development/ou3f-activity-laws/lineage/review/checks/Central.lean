import Becoming
import Lean

/-! Reviewer's check, not for landing: does any declaration named in COVERAGE.json (the central
declarations, their instances and the master laws' anchors) depend, transitively, on the lineage
laws, the bridge or `steps_advance`? Run against the tree's build of the whole package. -/

open Lean Meta Elab Command

partial def reviewHits (env : Environment) (targets : NameSet) (n : Name) : StateM (Std.HashMap Name NameSet) NameSet := do
  if let some r := (← get).get? n then return r
  modify (·.insert n {})
  let mut acc : NameSet := if targets.contains n then ({} : NameSet).insert n else {}
  if let some ci := env.find? n then
    let cs := ci.type.getUsedConstants ++ ((ci.value? (allowOpaque := true)).map (·.getUsedConstants)).getD #[]
    for c in cs do
      for t in (← reviewHits env targets c).toList do
        acc := acc.insert t
  modify (·.insert n acc)
  return acc

