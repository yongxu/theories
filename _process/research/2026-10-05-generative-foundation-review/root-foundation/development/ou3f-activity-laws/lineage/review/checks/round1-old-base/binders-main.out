      N ≤ s → ∀ (g g' f : F), W.active s g → W.active s g' → R s g f → R s g' f → W.active (s + 1) f → g = g')
  {t d : Nat} {f₁ f₂ h : F} (from_ : N ≤ t) (arises₂ : W.ArisesFrom R (t + 1 + d) f₂) {k₁ k₂ : Nat}
  (lineage₁ : W.Lineage R (t + 1) f₁ k₁ h) (lineage₂ : W.Lineage R (t + 1 + d + 1) f₂ k₂ h)
