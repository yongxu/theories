Becoming.Web.line_advances {F : Type} {R : Nat → F → F → Prop} {E : Becoming.«际» (Nat × F)} {x y : Nat × F}
  (h : Becoming.«相续» (Becoming.Web.continuationStep R) E x y) : x.fst < y.fst
Becoming.Web.line_lineage {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {x y : Nat × F}
  (line : Becoming.«及» (Becoming.«续» (Becoming.Web.continuationStep R) W.activityClass) x y) :
