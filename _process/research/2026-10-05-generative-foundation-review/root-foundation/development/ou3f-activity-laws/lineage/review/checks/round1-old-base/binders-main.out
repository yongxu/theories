Becoming.Web.keeping_of_carried_on {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {x : Nat × F} {S : Nat}
  (start : W.active x.fst x.snd) (endless : Becoming.«不穷» (Becoming.Web.continuationStep R) W.activityClass x)
  (on : ∀ (s : Nat) (f : F), S ≤ s → W.active (s + 1) f → W.active s f ∧ R s f f) :
