  [(t : Nat) → (f : F) → Decidable (W.Continues R t f)] {L : Becoming.Flow F C} {cs : List C} {alive : Nat → List F}
  (census : W.Census alive) (distinct : ∀ (t : Nat), Becoming.Distinct (L.present t)) (taking : L.Taking W)
  (more : L.More cs) (noSplit : W.NoSplit R) : W.UnceasingFrom R
