  [decide : (t : Nat) → (f : F) → Decidable (W.active t f)] {L : Becoming.Flow F C} {cs : List C} {alive : Nat → List F}
  (census : W.Census alive) (distinct : ∀ (t : Nat), Becoming.Distinct (L.present t)) (taking : L.Taking W)
  (more : L.More cs) (σ : Becoming.Reidentify F F') : (W.reidentify σ).Unceasing
