  {cs : List C} {S : Nat} (decided : (s : Nat) → (f : F) → S ≤ s → Decidable (W.active s f))
  (covered : ∀ (N : Nat), ∃ M l, N ≤ M ∧ ∀ (f : F), W.active M f → f ∈ l)
  (distinct : ∀ (t : Nat), S ≤ t → Becoming.Distinct (L.present t))
  (taking : ∀ (t : Nat) (f : F) (c : C), S ≤ t → f ∈ L.present t → 0 < L.take t f c → W.active t f) (more : L.More cs)
  (σ : Becoming.Reidentify F F') : (W.reidentify σ).Unceasing
