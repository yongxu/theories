  Becoming.Distinct before →
    ∀ (g f f' : F), Becoming.paired before after g f → Becoming.paired before after g f' → f = f'
Becoming.total_reidentify {F F' : Type} (σ : Becoming.Reidentify F F') (t : Nat) (q : F → Nat) (fs : List F) :
  (Becoming.total (List.map (σ.new t) fs) fun x => q (σ.old t x)) = Becoming.total fs q
Becoming.turn {F : Type} (swap : F → F) : Bool → F → F
Becoming.turn_fixed {F : Type} {swap : F → F} {f : F} (fixed : swap f = f) (b : Bool) : Becoming.turn swap b f = f
Becoming.turn_turn {F : Type} {swap : F → F} (twice : ∀ (f : F), swap (swap f) = f) (b : Bool) (f : F) :
  Becoming.turn swap b (Becoming.turn swap b f) = f
