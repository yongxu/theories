  {new_old : ∀ (t : Nat) (x : F'), @Eq.{1} F' (new t (old t x)) x} {old_1 : Nat → F' → F} {new_1 : Nat → F → F'}
  {old_new_1 : ∀ (t : Nat) (f : F), @Eq.{1} F (old_1 t (new_1 t f)) f}
  {new_old_1 : ∀ (t : Nat) (x : F'), @Eq.{1} F' (new_1 t (old_1 t x)) x},
  @Eq.{1} (Becoming.Reidentify F F') (@Becoming.Reidentify.mk F F' old new old_new new_old)
      (@Becoming.Reidentify.mk F F' old_1 new_1 old_new_1 new_old_1) →
    And (@Eq.{1} (Nat → F' → F) old old_1) (@Eq.{1} (Nat → F → F') new new_1)
theorem Becoming.Reidentify.mk.injEq : ∀ {F F' : Type} (old : Nat → F' → F) (new : Nat → F → F') (old_new : ∀ (t : Nat) (f : F), @Eq.{1} F (old t (new t f)) f)
  (new_old : ∀ (t : Nat) (x : F'), @Eq.{1} F' (new t (old t x)) x) (old_1 : Nat → F' → F) (new_1 : Nat → F → F')
  (old_new_1 : ∀ (t : Nat) (f : F), @Eq.{1} F (old_1 t (new_1 t f)) f)
  (new_old_1 : ∀ (t : Nat) (x : F'), @Eq.{1} F' (new_1 t (old_1 t x)) x),
  @Eq.{1} Prop
    (@Eq.{1} (Becoming.Reidentify F F') (@Becoming.Reidentify.mk F F' old new old_new new_old)
      (@Becoming.Reidentify.mk F F' old_1 new_1 old_new_1 new_old_1))
    (And (@Eq.{1} (Nat → F' → F) old old_1) (@Eq.{1} (Nat → F → F') new new_1))
def Becoming.Reidentify.mk.noConfusion : {F F' : Type} →
  {P : Sort u} →
    {old : Nat → F' → F} →
      {new : Nat → F → F'} →
        {old_new : ∀ (t : Nat) (f : F), @Eq.{1} F (old t (new t f)) f} →
          {new_old : ∀ (t : Nat) (x : F'), @Eq.{1} F' (new t (old t x)) x} →
            {old' : Nat → F' → F} →
              {new' : Nat → F → F'} →
                {old_new' : ∀ (t : Nat) (f : F), @Eq.{1} F (old' t (new' t f)) f} →
                  {new_old' : ∀ (t : Nat) (x : F'), @Eq.{1} F' (new' t (old' t x)) x} →
                    (eq :
                        @Eq.{1} (Becoming.Reidentify F F') (@Becoming.Reidentify.mk F F' old new old_new new_old)
                          (@Becoming.Reidentify.mk F F' old' new' old_new' new_old')) →
                      (k :
                          (old_eq : @HEq.{1} (Nat → F' → F) old (Nat → F' → F) old') →
                            (new_eq : @HEq.{1} (Nat → F → F') new (Nat → F → F') new') → P) →
                        P
  := fun {F F' : Type} {P : Sort u} {old : Nat → F' → F} {new : Nat → F → F'}
    {old_new : ∀ (t : Nat) (f : F), @Eq.{1} F (old t (new t f)) f}
    {new_old : ∀ (t : Nat) (x : F'), @Eq.{1} F' (new t (old t x)) x} {old' : Nat → F' → F} {new' : Nat → F → F'}
    {old_new' : ∀ (t : Nat) (f : F), @Eq.{1} F (old' t (new' t f)) f}
    {new_old' : ∀ (t : Nat) (x : F'), @Eq.{1} F' (new' t (old' t x)) x}
    (eq :
      @Eq.{1} (Becoming.Reidentify F F') (@Becoming.Reidentify.mk F F' old new old_new new_old)
        (@Becoming.Reidentify.mk F F' old' new' old_new' new_old'))
    (k :
      (old_eq : @HEq.{1} (Nat → F' → F) old (Nat → F' → F) old') →
        (new_eq : @HEq.{1} (Nat → F → F') new (Nat → F → F') new') → P) =>
  @id.{u} P
    (@Becoming.Reidentify.noConfusion.{u} P F F' (@Becoming.Reidentify.mk F F' old new old_new new_old) F F'
      (@Becoming.Reidentify.mk F F' old' new' old_new' new_old') (@Eq.refl.{2} Type F) (@Eq.refl.{2} Type F')
      (@heq_of_eq.{1} (Becoming.Reidentify F F') (@Becoming.Reidentify.mk F F' old new old_new new_old)
        (@Becoming.Reidentify.mk F F' old' new' old_new' new_old') eq)
      k)
