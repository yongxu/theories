def Becoming.TideFlip.flip : Becoming.Reidentify Becoming.Tide.Formation Becoming.Tide.Formation
  := @Becoming.Reidentify.exchanging Becoming.Tide.Formation Becoming.odd Becoming.TideFlip.swap Becoming.TideFlip.swap_swap
def Becoming.TideFlip.flipped : Becoming.Web Becoming.Tide.Formation Unit
  := @Becoming.Web.reidentify Becoming.Tide.Formation Becoming.Tide.Formation Unit Becoming.Tide.still Becoming.TideFlip.flip
theorem Becoming.TideFlip.naming_meets_premises : And
  (∀ (t : Nat) (f : Becoming.Tide.Formation),
    Not (@Becoming.Web.Arises Becoming.Tide.Formation Unit Becoming.Tide.still t f))
  (And
    (Not
      (@Becoming.Reidentify.KeepsActive Becoming.Tide.Formation Becoming.Tide.Formation Unit Becoming.TideFlip.flip
        Becoming.Tide.still))
    (And (@Becoming.Web.Dependent Becoming.Tide.Formation Unit Becoming.TideFlip.flipped)
      (And (@Becoming.Web.RenewedBy Becoming.Tide.Formation Unit Becoming.TideFlip.flipped Becoming.TideFlip.renews)
        (And
          (@Becoming.Web.Depletes Becoming.Tide.Formation Unit Becoming.TideFlip.flipped
            (@List.cons.{0} Unit Unit.unit (@List.nil.{0} Unit)) fun (t : Nat) =>
            @Exists.{1} Becoming.Tide.Formation fun (x : Becoming.Tide.Formation) =>
              @Becoming.Web.Arises Becoming.Tide.Formation Unit Becoming.TideFlip.flipped t x)
          (And (@Becoming.Web.Unceasing Becoming.Tide.Formation Unit Becoming.TideFlip.flipped)
            (∀ (T : Nat),
              Not
                (∀ (t : Nat),
                  @LE.le.{0} Nat instLENat T t →
                    ∀ (x : Becoming.Tide.Formation),
                      Not
                        (@Becoming.Web.ActiveRenewer Becoming.Tide.Formation Unit Becoming.TideFlip.flipped
                          Becoming.TideFlip.renews (@List.cons.{0} Unit Unit.unit (@List.nil.{0} Unit)) t x))))))))
