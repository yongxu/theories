def Becoming.Reidentify.recOn : {F F' : Type} →
  {motive : (t : Becoming.Reidentify F F') → Sort u} →
    (t : Becoming.Reidentify F F') →
      (mk :
          (old : Nat → F' → F) →
            (new : Nat → F → F') →
              (old_new : ∀ (t : Nat) (f : F), @Eq.{1} F (old t (new t f)) f) →
                (new_old : ∀ (t : Nat) (x : F'), @Eq.{1} F' (new t (old t x)) x) →
                  motive (@Becoming.Reidentify.mk F F' old new old_new new_old)) →
        motive t
  := fun {F F' : Type} {motive : (t : Becoming.Reidentify F F') → Sort u} (t : Becoming.Reidentify F F')
    (mk :
      (old : Nat → F' → F) →
        (new : Nat → F → F') →
