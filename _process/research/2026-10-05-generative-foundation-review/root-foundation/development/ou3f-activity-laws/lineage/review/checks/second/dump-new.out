def Becoming.Reidentify.noConfusion : {P : Sort u} →
  {F F' : Type} →
    {t : Becoming.Reidentify F F'} →
      {F'_1 F'' : Type} →
        {t' : Becoming.Reidentify F'_1 F''} →
          (eq_1 : @Eq.{2} Type F F'_1) →
            (eq_2 : @Eq.{2} Type F' F'') →
              (eq_3 : @HEq.{1} (Becoming.Reidentify F F') t (Becoming.Reidentify F'_1 F'') t') →
                @Becoming.Reidentify.noConfusionType.{u} P F F' t F'_1 F'' t'
  := fun {P : Sort u} {F F' : Type} {t : Becoming.Reidentify F F'} {F'_1 F'' : Type} {t' : Becoming.Reidentify F'_1 F''}
    (eq_1 : @Eq.{2} Type F F'_1) (eq_2 : @Eq.{2} Type F' F'')
    (eq_3 : @HEq.{1} (Becoming.Reidentify F F') t (Becoming.Reidentify F'_1 F'') t') =>
  @Eq.ndrec.{u, 2} Type F
    (fun {F'_2 : Type} =>
      {t' : Becoming.Reidentify F'_2 F''} →
        (eq_3 : @HEq.{1} (Becoming.Reidentify F F') t (Becoming.Reidentify F'_2 F'') t') →
          @Becoming.Reidentify.noConfusionType.{u} P F F' t F'_2 F'' t')
    (fun {t' : Becoming.Reidentify F F''}
        (eq_3 : @HEq.{1} (Becoming.Reidentify F F') t (Becoming.Reidentify F F'') t') =>
      @Eq.ndrec.{u, 2} Type F'
        (fun {F'' : Type} =>
          {t' : Becoming.Reidentify F F''} →
            (eq_3 : @HEq.{1} (Becoming.Reidentify F F') t (Becoming.Reidentify F F'') t') →
              @Becoming.Reidentify.noConfusionType.{u} P F F' t F F'' t')
        (fun {t' : Becoming.Reidentify F F'}
            (eq_3 : @HEq.{1} (Becoming.Reidentify F F') t (Becoming.Reidentify F F') t') =>
          @Eq.ndrec.{u, 1} (Becoming.Reidentify F F') t
            (fun {t' : Becoming.Reidentify F F'} => @Becoming.Reidentify.noConfusionType.{u} P F F' t F F' t')
            (@Becoming.Reidentify.casesOn.{u} F F'
              (fun {t : Becoming.Reidentify F F'} => @Becoming.Reidentify.noConfusionType.{u} P F F' t F F' t) t
              fun (old : Nat → F' → F) (new : Nat → F → F')
                (old_new : ∀ (t : Nat) (f : F), @Eq.{1} F (old t (new t f)) f)
                (new_old : ∀ (t : Nat) (x : F'), @Eq.{1} F' (new t (old t x)) x)
                (k :
                  (old_eq : @HEq.{1} (Nat → F' → F) old (Nat → F' → F) old) →
                    (new_eq : @HEq.{1} (Nat → F → F') new (Nat → F → F') new) → P) =>
              k (@HEq.refl.{1} (Nat → F' → F) old) (@HEq.refl.{1} (Nat → F → F') new))
            t' (@eq_of_heq.{1} (Becoming.Reidentify F F') t t' eq_3))
        F'' eq_2 t' eq_3)
    F'_1 eq_1 t' eq_3
def Becoming.Reidentify.noConfusionType : (P : Sort u) →
  {F F' : Type} → (t : Becoming.Reidentify F F') → {F' F'' : Type} → (t' : Becoming.Reidentify F' F'') → Sort u
  := fun (P : Sort u) {F F' : Type} (t : Becoming.Reidentify F F') {F'_1 F'' : Type} (t' : Becoming.Reidentify F'_1 F'') =>
  @Becoming.Reidentify.casesOn.{u + 1} F F' (fun (t : Becoming.Reidentify F F') => Sort u) t
    fun (old : Nat → F' → F) (new : Nat → F → F') (old_new : ∀ (t : Nat) (f : F), @Eq.{1} F (old t (new t f)) f)
      (new_old : ∀ (t : Nat) (x : F'), @Eq.{1} F' (new t (old t x)) x) =>
    @Becoming.Reidentify.casesOn.{u + 1} F'_1 F'' (fun (t : Becoming.Reidentify F'_1 F'') => Sort u) t'
      fun (old_1 : Nat → F'' → F'_1) (new_1 : Nat → F'_1 → F'')
        (old_new : ∀ (t : Nat) (f : F'_1), @Eq.{1} F'_1 (old_1 t (new_1 t f)) f)
        (new_old : ∀ (t : Nat) (x : F''), @Eq.{1} F'' (new_1 t (old_1 t x)) x) =>
      ((old_eq : @HEq.{1} (Nat → F' → F) old (Nat → F'' → F'_1) old_1) →
          (new_eq : @HEq.{1} (Nat → F → F') new (Nat → F'_1 → F'') new_1) → P) →
        P
