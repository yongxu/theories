    (mk :
      (old : Nat → F' → F) →
        (new : Nat → F → F') →
          (old_new : ∀ (t : Nat) (f : F), @Eq.{1} F (old t (new t f)) f) →
            (new_old : ∀ (t : Nat) (x : F'), @Eq.{1} F' (new t (old t x)) x) →
              motive (@Becoming.Reidentify.mk F F' old new old_new new_old)) =>
  @Becoming.Reidentify.rec.{u} F F' motive
    (fun (old : Nat → F' → F) (new : Nat → F → F') (old_new : ∀ (t : Nat) (f : F), @Eq.{1} F (old t (new t f)) f)
        (new_old : ∀ (t : Nat) (x : F'), @Eq.{1} F' (new t (old t x)) x) =>
      mk old new old_new new_old)
    t
def Becoming.Reidentify.continuation : {F F' : Type} → (σ : Becoming.Reidentify F F') → (t : Nat) → (g f : F) → Prop
