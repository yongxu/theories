  (named : ∀ (x : F'), p (@Becoming.Reidentify.old F F' σ t x)) (f : F), p f
def Becoming.Reidentify.exchanging : {F : Type} →
  (when : Nat → Bool) → (swap : F → F) → (twice : ∀ (f : F), @Eq.{1} F (swap (swap f)) f) → Becoming.Reidentify F F
  := fun {F : Type} (when : Nat → Bool) (swap : F → F) (twice : ∀ (f : F), @Eq.{1} F (swap (swap f)) f) =>
  @Becoming.Reidentify.mk F F (fun (t : Nat) => @Becoming.turn F swap (when t))
    (fun (t : Nat) => @Becoming.turn F swap (when t)) (@Becoming.Reidentify.exchanging._proof_1 F when swap twice)
    (@Becoming.Reidentify.exchanging._proof_1 F when swap twice)
theorem Becoming.Reidentify.exchanging._proof_1 : ∀ {F : Type} (when : Nat → Bool) (swap : F → F) (twice : ∀ (f : F), @Eq.{1} F (swap (swap f)) f) (t : Nat) (f : F),
  @Eq.{1} F (@Becoming.turn F swap (when t) (@Becoming.turn F swap (when t) f)) f
