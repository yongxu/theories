    (@Prod.mk.{0, 0} Becoming.Expansion.Kind Nat Becoming.Expansion.Kind.renewer
      (@Prod.snd.{0, 0} Becoming.Expansion.Kind Nat g))
theorem Becoming.Merge.merging : And
  (@Becoming.Dependence.active.{0} Nat (Prod.{0, 0} Becoming.Expansion.Kind Nat) Unit Becoming.Expansion.web
    (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))
    (@Prod.mk.{0, 0} Becoming.Expansion.Kind Nat Becoming.Expansion.Kind.renewer
      (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))))
  (And
    (@Becoming.Dependence.active.{0} Nat (Prod.{0, 0} Becoming.Expansion.Kind Nat) Unit Becoming.Expansion.web
      (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))
      (@Prod.mk.{0, 0} Becoming.Expansion.Kind Nat Becoming.Expansion.Kind.grower
        (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))))
    (And
      (Becoming.Merge.merges (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))
        (@Prod.mk.{0, 0} Becoming.Expansion.Kind Nat Becoming.Expansion.Kind.renewer
          (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0))))
        (@Prod.mk.{0, 0} Becoming.Expansion.Kind Nat Becoming.Expansion.Kind.renewer
          (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))))
      (And
        (Becoming.Merge.merges (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))
          (@Prod.mk.{0, 0} Becoming.Expansion.Kind Nat Becoming.Expansion.Kind.grower
            (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0))))
          (@Prod.mk.{0, 0} Becoming.Expansion.Kind Nat Becoming.Expansion.Kind.renewer
            (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))))
        (And
          (@Becoming.Dependence.active.{0} Nat (Prod.{0, 0} Becoming.Expansion.Kind Nat) Unit Becoming.Expansion.web
            (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))
            (@Prod.mk.{0, 0} Becoming.Expansion.Kind Nat Becoming.Expansion.Kind.renewer
              (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))))
          (And
            (@Ne.{1} (Prod.{0, 0} Becoming.Expansion.Kind Nat)
              (@Prod.mk.{0, 0} Becoming.Expansion.Kind Nat Becoming.Expansion.Kind.renewer
                (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0))))
              (@Prod.mk.{0, 0} Becoming.Expansion.Kind Nat Becoming.Expansion.Kind.grower
                (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))))
            (@Becoming.Web.UnceasingFrom (Prod.{0, 0} Becoming.Expansion.Kind Nat) Unit Becoming.Expansion.web
              Becoming.Merge.merges))))))
theorem Becoming.Merge.noSplit : @Becoming.Web.NoSplit (Prod.{0, 0} Becoming.Expansion.Kind Nat) Unit Becoming.Expansion.web Becoming.Merge.merges
inductive Becoming.Reidentify : (F F' : Type) → Type
def Becoming.Reidentify.KeepsActive : {F F' C : Type} → (σ : Becoming.Reidentify F F') → (W : Becoming.Web F C) → Prop
  := fun {F F' C : Type} (σ : Becoming.Reidentify F F') (W : Becoming.Web F C) =>
  ∀ (t : Nat) (f : F),
    @Becoming.Dependence.active.{0} Nat F C W t f →
      @Becoming.Dependence.active.{0} Nat F C W
          (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) t
            (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
          f →
        @Eq.{1} F'
          (@Becoming.Reidentify.new F F' σ
            (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) t
              (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
            f)
          (@Becoming.Reidentify.new F F' σ t f)
def Becoming.Reidentify.KeepsTenure : {F F' C : Type} → (σ : Becoming.Reidentify F F') → (W : Becoming.Web F C) → Prop
  := fun {F F' C : Type} (σ : Becoming.Reidentify F F') (W : Becoming.Web F C) =>
  ∀ (t : Nat) (g : F) (c : C),
    @Becoming.Dependence.requires.{0} Nat F C W t g c →
      @Becoming.Dependence.requires.{0} Nat F C W
          (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) t
            (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
          g c →
        @Eq.{1} F'
          (@Becoming.Reidentify.new F F' σ
            (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) t
              (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
            g)
          (@Becoming.Reidentify.new F F' σ t g)
def Becoming.Reidentify._sizeOf_1 : {F F' : Type} → [SizeOf.{1} F] → [SizeOf.{1} F'] → (t : Becoming.Reidentify F F') → Nat
def Becoming.Reidentify._sizeOf_inst : (F F' : Type) → [SizeOf.{1} F] → [SizeOf.{1} F'] → SizeOf.{1} (Becoming.Reidentify F F')
def Becoming.Reidentify.back : {F F' : Type} → (σ : Becoming.Reidentify F F') → Becoming.Reidentify F' F
  := fun {F F' : Type} (σ : Becoming.Reidentify F F') =>
  @Becoming.Reidentify.mk F' F (@Becoming.Reidentify.new F F' σ) (@Becoming.Reidentify.old F F' σ)
    (@Becoming.Reidentify.new_old F F' σ) (@Becoming.Reidentify.old_new F F' σ)
def Becoming.Reidentify.casesOn : {F F' : Type} →
  {motive : (t : Becoming.Reidentify F F') → Sort u} →
