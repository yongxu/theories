+theorem GrammarLaws.uncrossed_iff_notGoingOut {R : «际» α} {p : α → Bool} :
+    (∀ x y, R x y → p x = p y) ↔
+      «不出» R (fun x => p x = true) ∧ «不出» («逆» R) (fun x => p x = true) :=
