+/-- A member of a list paired with a step is the step with a member of the list. -/
+theorem mem_map_prodMk {t : Nat} : ∀ {zs : List α} {y : Nat × α}, y ∈ zs.map (fun a => (t, a)) →
+    y.1 = t ∧ y.2 ∈ zs
