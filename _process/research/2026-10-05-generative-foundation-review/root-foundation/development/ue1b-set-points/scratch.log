== 5. The comparison script (dump_types.lean; the before run adds 'import Becoming.SetPointOptimum'),
run as: LEAN_PATH=<tree>/.build lean dump_types.lean, Lean 4.29.1
import Lean
import Becoming.Optimum
import Becoming.RegimeMargin

open Lean

/-- Every binder name erased: alpha-equivalent types print alike. -/
partial def eraseNames : Expr → Expr
  | .forallE _ t b bi => .forallE `x (eraseNames t) (eraseNames b) bi
  | .lam _ t b bi => .lam `x (eraseNames t) (eraseNames b) bi
  | .app f a => .app (eraseNames f) (eraseNames a)
  | .letE _ t v b nd => .letE `x (eraseNames t) (eraseNames v) (eraseNames b) nd
  | .mdata m e => .mdata m (eraseNames e)
  | .proj s i e => .proj s i (eraseNames e)
  | e => e

def kindOf : ConstantInfo → String
  | .thmInfo _ => "theorem" | .defnInfo _ => "def" | .axiomInfo _ => "axiom"
  | .opaqueInfo _ => "opaque" | .quotInfo _ => "quot" | .inductInfo _ => "inductive"
  | .ctorInfo _ => "ctor" | .recInfo _ => "rec"

def dumpModule (env : Environment) (mod : Name) : IO Unit := do
  let some idx := env.getModuleIdx? mod | throw <| IO.userError s!"module {mod} not found"
  let md := env.header.moduleData[idx.toNat]!
  let mut lines : Array String := #[]
  for ci in md.constants do
    lines := lines.push s!"{mod}\t{kindOf ci}\t{ci.name}\tRAW\t{ci.type.dbgToString}"
    lines := lines.push s!"{mod}\t{kindOf ci}\t{ci.name}\tNORM\t{(eraseNames ci.type).dbgToString}"
  for line in lines.qsort (· < ·) do
    IO.println line

def dumpNamed (env : Environment) (n : Name) : IO Unit := do
  match env.find? n with
  | some ci =>
    let mod := match env.getModuleIdxFor? n with
      | some i => env.header.moduleNames[i.toNat]!
      | none => `here
    IO.println s!"MOVED\t{n}\t{mod}\tNORM\t{(eraseNames ci.type).dbgToString}"
  | none => IO.println s!"MOVED\t{n}\tMISSING"

#eval show CoreM Unit from do
  let env ← getEnv
  dumpModule env `Becoming.Optimum
  dumpModule env `Becoming.RegimeMargin
  for n in [`Becoming.Optimum.Above.full_of_ranked, `Becoming.Optimum.Above.floor_or_full_of_ranked,
      `Becoming.Optimum.beyond_of_ranked] do
    dumpNamed env n
