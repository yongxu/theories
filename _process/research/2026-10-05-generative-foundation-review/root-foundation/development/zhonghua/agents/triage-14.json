{
 "chunk": 14,
 "n_lines": 240,
 "verdicts": [
  {
   "id": "LC2-WB-C09-R01",
   "c": "C11",
   "k": "a",
   "s": [
    "C04"
   ],
   "w": "持而又盈：越界无余量则倾危（过调）"
  },
  {
   "id": "LC2-WB-C09-R02",
   "c": "C03",
   "k": "a",
   "s": [],
   "w": "功成则移：成而继以更替，四时相续"
  },
  {
   "id": "LC2-WB-C12-R01",
   "c": "C02",
   "k": "a",
   "s": [
    "C10"
   ],
   "w": "以物养己（依存得养）对以物役己"
  },
  {
   "id": "LC2-WB-C13-R01",
   "c": "C10",
   "k": "a",
   "s": [
    "C13"
   ],
   "w": "不为宠辱所移：选择不被奖惩捕获方可托付"
  },
  {
   "id": "LC2-WB-C14-R01",
   "c": "C01",
   "k": "d",
   "s": [
    "C07"
   ],
   "w": "万物同由无形无名之宗：立先在之本"
  },
  {
   "id": "LC2-WB-C15-R01",
   "c": "C04",
   "k": "a",
   "s": [
    "C11"
   ],
   "w": "浊以静之得清：静置趋于停息而澄"
  },
  {
   "id": "LC2-WB-C16-R01",
   "c": "C05",
   "k": "d",
   "s": [
    "C01",
    "C04"
   ],
   "w": "动起于静、终复归虚静：以虚静为本且必归"
  },
  {
   "id": "LC2-WB-C16-R02",
   "c": "C10",
   "k": "a",
   "s": [],
   "w": "包通无遗则无偏：所通愈广愈去其偏"
  },
  {
   "id": "LC2-WB-C17-R01",
   "c": "C10",
   "k": "a",
   "s": [
    "C13",
    "C02"
   ],
   "w": "失其所依则病生，智术不能补已失之信"
  },
  {
   "id": "LC2-WB-C17-R02",
   "c": "C10",
   "k": "a",
   "s": [
    "C08"
   ],
   "w": "作用经不显之耦合，成而受者不识其由"
  },
  {
   "id": "LC2-WB-C18-R01",
   "c": "C11",
   "k": "a",
   "s": [
    "C10",
    "C08"
   ],
   "w": "察则避、避则伪滋：监察引起规避的回路"
  },
  {
   "id": "LC2-WB-C19-R01",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "LC2-WB-C20-R01",
   "c": "C06",
   "k": "d",
   "s": [
    "C04"
   ],
   "w": "自然已足益之则忧：以性分为定量"
  },
  {
   "id": "LC2-WB-C21-R01",
   "c": "C06",
   "k": "a",
   "s": [
    "C04"
   ],
   "w": "以空为德：留有余地方能随所通而动"
  },
  {
   "id": "LC2-WB-C21-R02",
   "c": "C08",
   "k": "a",
   "s": [],
   "w": "信释为信验：可验之征"
  },
  {
   "id": "LC2-WB-C22-R01",
   "c": "C02",
   "k": "a",
   "s": [
    "C08"
   ],
   "w": "多而远根则惑：离所依愈远愈失"
  },
  {
   "id": "LC2-WB-C23-R01",
   "c": "C01",
   "k": "d",
   "s": [],
   "w": "道以无形无为成济万物：道为成物之主"
  },
  {
   "id": "LC2-WB-C24-R01",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "LC2-WB-C26-R01",
   "c": "C11",
   "k": "d",
   "s": [
    "C04"
   ],
   "w": "不动者制动、静为躁君：立单一主控"
  },
  {
   "id": "LC2-WB-C27-R01",
   "c": "C10",
   "k": "a",
   "s": [
    "C08"
   ],
   "w": "自任其智不因物：不经耦合于物之知成迷"
  },
  {
   "id": "LC2-WB-C28-R01",
   "c": "C01",
   "k": "s",
   "s": [
    "C03"
   ],
   "w": "朴散为殊类：一中分化可合，原初纯一不取"
  },
  {
   "id": "LC2-WB-C29-R01",
   "c": "C03",
   "k": "a",
   "s": [
    "C07"
   ],
   "w": "物有往来，执之则失：执一态违其变"
  },
  {
   "id": "LC2-WB-C30-R01",
   "c": "C13",
   "k": "a",
   "s": [
    "C15"
   ],
   "w": "果以济难而止，不转向取强"
  },
  {
   "id": "LC2-WB-C32-R01",
   "c": "C09",
   "k": "s",
   "s": [
    "C13"
   ],
   "w": "名分不可不立亦须知止；定尊卑则相分"
  },
  {
   "id": "LC2-WB-C33-R01",
   "c": "C05",
   "k": "a",
   "s": [
    "C08",
    "C02"
   ],
   "w": "自察量力、不失所依则久"
  },
  {
   "id": "LC2-WB-C34-R01",
   "c": "C10",
   "k": "a",
   "s": [
    "C01"
   ],
   "w": "生而不知所由：成物之耦合不为所成者识"
  },
  {
   "id": "LC2-WB-C35-R01",
   "c": "C05",
   "k": "a",
   "s": [
    "C07"
   ],
   "w": "淡而不悦、用之不穷：不即时吸引而可久"
  },
  {
   "id": "LC2-WB-C36-R01",
   "c": "C11",
   "k": "a",
   "s": [
    "C10"
   ],
   "w": "因物之性理物，不假外加刑制"
  },
  {
   "id": "LC2-WB-C37-R01",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "LC2-WB-C39-R01",
   "c": "C06",
   "k": "a",
   "s": [],
   "w": "守致清之所由非执已成之清：保其生成条件"
  },
  {
   "id": "LC2-WB-C41-R01",
   "c": "C01",
   "k": "a",
   "s": [
    "C09"
   ],
   "w": "有声则有分：定于一者不能统众"
  },
  {
   "id": "LC2-WB-C42-R01",
   "c": "C09",
   "k": "a",
   "s": [
    "C01"
   ],
   "w": "言一则一与言为二：名入所计而数生"
  },
  {
   "id": "LC2-WB-C43-R01",
   "c": "C11",
   "k": "s",
   "s": [],
   "w": "至柔无所不通而不折：耐受而复"
  },
  {
   "id": "LC2-WB-C44-R01",
   "c": "C04",
   "k": "a",
   "s": [
    "C13"
   ],
   "w": "藏而不与物通散，引众求而厚亡：截留致失"
  },
  {
   "id": "LC2-WB-C45-R01",
   "c": "C04",
   "k": "s",
   "s": [
    "C11"
   ],
   "w": "静全物之真、躁犯物之性：扰动越所容则伤"
  },
  {
   "id": "LC2-WB-C46-R01",
   "c": "C13",
   "k": "a",
   "s": [
    "C04"
   ],
   "w": "贪欲无厌、各求于外：无界汲取致相争"
  },
  {
   "id": "LC2-WB-C47-R01",
   "c": "C10",
   "k": "a",
   "s": [
    "C07"
   ],
   "w": "明物之性而因之：见其所依而顺成"
  },
  {
   "id": "LC2-WB-C48-R01",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "LC2-WB-C49-R01",
   "c": "C11",
   "k": "a",
   "s": [
    "C13"
   ],
   "w": "以察临物，物以其明应之：相互适应升级"
  },
  {
   "id": "LC2-WB-C49-R02",
   "c": "C06",
   "k": "a",
   "s": [
    "C10"
   ],
   "w": "法网繁则径塞：可行之域收窄"
  },
  {
   "id": "LC2-WB-C50-R01",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "LC2-WB-C50-R02",
   "c": "C07",
   "k": "a",
   "s": [
    "C06"
   ],
   "w": "厚于求生为甘饵引入无生之地：被吸入吸收区"
  },
  {
   "id": "LC2-WB-C52-R01",
   "c": "C02",
   "k": "a",
   "s": [
    "C06"
   ],
   "w": "得本知末而守本：末依于本不可舍所依"
  },
  {
   "id": "LC2-WB-C53-R01",
   "c": "C04",
   "k": "a",
   "s": [
    "C02"
   ],
   "w": "设一而众害生：一处过取致根基匮竭"
  },
  {
   "id": "LC2-WB-C54-R01",
   "c": "C13",
   "k": "a",
   "s": [
    "C10"
   ],
   "w": "以身及人、修之不废而所施转大：沿耦合外传"
  },
  {
   "id": "LC2-WB-C55-R01",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "LC2-WB-C56-R01",
   "c": "C13",
   "k": "a",
   "s": [],
   "w": "无所特显则物无偏争：无突出之的则不起争夺"
  },
  {
   "id": "LC2-WB-C58-R01",
   "c": "C13",
   "k": "a",
   "s": [
    "C09"
   ],
   "w": "立刑名赏罚、殊类分析则民争竞：排序诱竞"
  },
  {
   "id": "LC2-WB-C58-R02",
   "c": "C02",
   "k": "a",
   "s": [],
   "w": "崇本息末：治其所由而不攻其末"
  },
  {
   "id": "LC2-WB-C59-R01",
   "c": "C04",
   "k": "s",
   "s": [],
   "w": "啬：节用并除荒病之由；去殊归一不取"
  },
  {
   "id": "LC2-WB-C60-R01",
   "c": "C11",
   "k": "a",
   "s": [],
   "w": "治大国若烹小鲜：少扰则少害"
  },
  {
   "id": "LC2-WB-C61-R01",
   "c": "C13",
   "k": "a",
   "s": [
    "C17"
   ],
   "w": "大者宜为下：居下而众所归"
  },
  {
   "id": "LC2-WB-C62-R01",
   "c": "C14",
   "k": "a",
   "s": [
    "C15"
   ],
   "w": "不以不善弃人：不善者亦有所保"
  },
  {
   "id": "LC2-WB-C63-R01",
   "c": "C13",
   "k": "a",
   "s": [
    "C09"
   ],
   "w": "顺天下之所同为德：以共同所向为准"
  },
  {
   "id": "LC2-WB-C64-R01",
   "c": "C11",
   "k": "a",
   "s": [
    "C07"
   ],
   "w": "微而不散则生大：小积越阈，宜慎于始"
  },
  {
   "id": "LC2-WB-C65-R01",
   "c": "C11",
   "k": "a",
   "s": [
    "C10"
   ],
   "w": "以巧术防伪，民知而避，奸伪益滋：规避回路"
  },
  {
   "id": "LC2-WB-C67-R01",
   "c": "C04",
   "k": "a",
   "s": [
    "C06"
   ],
   "w": "俭而不匮故能广：少耗方能持续扩展"
  },
  {
   "id": "LC2-WB-C68-R01",
   "c": "C13",
   "k": "a",
   "s": [
    "C17"
   ],
   "w": "不居其下则人力不为用：协作依关系之位"
  },
  {
   "id": "LC2-WB-C69-R01",
   "c": "C13",
   "k": "a",
   "s": [],
   "w": "谦退不为取强，至无敌即祸：不竞胜"
  },
  {
   "id": "LC2-WB-C70-R01",
   "c": "C10",
   "k": "a",
   "s": [
    "C07"
   ],
   "w": "迷于荣利则不能行：为奖赏所捕获"
  },
  {
   "id": "LC2-WB-C71-R01",
   "c": "C08",
   "k": "a",
   "s": [
    "C16"
   ],
   "w": "不知所知之不足恃则病：识之有界"
  },
  {
   "id": "LC2-WB-C72-R01",
   "c": "C11",
   "k": "a",
   "s": [],
   "w": "弃谦任威则扰民、威失其效而溃：过压失控"
  },
  {
   "id": "LC2-WB-C73-R01",
   "c": "C07",
   "k": "a",
   "s": [
    "C17"
   ],
   "w": "未召先谋、安不忘危：于关节之前察之"
  },
  {
   "id": "LC2-WB-C74-R01",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "LC2-WB-C75-R01",
   "c": "C10",
   "k": "a",
   "s": [
    "C13"
   ],
   "w": "民之僻由上之施治：规则设定所选"
  },
  {
   "id": "LC2-WB-C76-R01",
   "c": "C13",
   "k": "a",
   "s": [],
   "w": "以暴强于天下为物所恶而不胜：支配招致反作用"
  },
  {
   "id": "LC2-WB-C77-R01",
   "c": "C01",
   "k": "s",
   "s": [],
   "w": "无身无私方合天地：去独立自我之执"
  },
  {
   "id": "LC2-WB-C78-R01",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "LC2-WB-C79-R01",
   "c": "C05",
   "k": "a",
   "s": [
    "C15"
   ],
   "w": "伤不复，事后之和仍有余怨：已失不可复原"
  },
  {
   "id": "LC2-WB-C80-R01",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "LC2-WB-C81-R01",
   "c": "C04",
   "k": "a",
   "s": [
    "C13"
   ],
   "w": "不积而任物：不截留，随物流通"
  },
  {
   "id": "IN2-R0001",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "IN2-R0002",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "IN2-R0003",
   "c": "C07",
   "k": "d",
   "s": [],
   "w": "心虚而理实：理为先在实有"
  },
  {
   "id": "IN2-R0004",
   "c": "C07",
   "k": "d",
   "s": [
    "C15"
   ],
   "w": "湛然虚明万理具足：理先在完备于心"
  },
  {
   "id": "IN2-R0005",
   "c": "C07",
   "k": "d",
   "s": [],
   "w": "空中须有实理：以理为实在之底"
  },
  {
   "id": "IN2-R0006",
   "c": "C08",
   "k": "s",
   "s": [
    "C07"
   ],
   "w": "格物致知以见实理：察而得理可合，理作定实相分"
  },
  {
   "id": "IN2-R0007",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "IN2-R0008",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "IN2-R0009",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "IN2-R0010",
   "c": "C09",
   "k": "a",
   "s": [],
   "w": "字同而工夫异：同名不定同义"
  },
  {
   "id": "IN2-R0011",
   "c": "C07",
   "k": "d",
   "s": [],
   "w": "功用不出性外：以先定之性为本"
  },
  {
   "id": "IN2-R0012",
   "c": "C07",
   "k": "d",
   "s": [],
   "w": "性用须相管：以先定之性统其用"
  },
  {
   "id": "IN2-R0013",
   "c": "C07",
   "k": "s",
   "s": [
    "C11"
   ],
   "w": "防于未萌、克于方萌：于关节处护；天理为先定"
  },
  {
   "id": "IN2-R0014",
   "c": "C08",
   "k": "d",
   "s": [],
   "w": "本来面目即良知：先天完备之知"
  },
  {
   "id": "IN2-R0015",
   "c": "C16",
   "k": "a",
   "s": [
    "C08"
   ],
   "w": "方便之说只为未识者设：说法有适用范围"
  },
  {
   "id": "IN2-R0016",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "IN2-R0017",
   "c": "C11",
   "k": "a",
   "s": [
    "C04"
   ],
   "w": "刻意求静反令念愈生：压制激起反弹"
  },
  {
   "id": "IN2-R0018",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "IN2-R0019",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "IN2-R0020",
   "c": "C08",
   "k": "a",
   "s": [
    "C03"
   ],
   "w": "应物如镜：随来而照，读而不留"
  },
  {
   "id": "IN2-R0021",
   "c": "C08",
   "k": "a",
   "s": [
    "C03"
   ],
   "w": "无所住而应物：应而无所执"
  },
  {
   "id": "RU1-DX-01-R01",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "RU1-DX-01-R02",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "RU1-DX-01-R03",
   "c": "C15",
   "k": "d",
   "s": [],
   "w": "止于至善：以至善为固定终点"
  },
  {
   "id": "RU1-DX-01-R04",
   "c": "C02",
   "k": "a",
   "s": [
    "C08"
   ],
   "w": "知止而后有定：先知其界而后能定"
  },
  {
   "id": "RU1-DX-01-R05",
   "c": "C02",
   "k": "a",
   "s": [],
   "w": "定而后能静：前者为后者之条件"
  },
  {
   "id": "RU1-DX-01-R06",
   "c": "C02",
   "k": "a",
   "s": [],
   "w": "静而后能安：前者为后者之条件"
  },
  {
   "id": "RU1-DX-01-R07",
   "c": "C02",
   "k": "a",
   "s": [],
   "w": "安而后能虑：前者为后者之条件"
  },
  {
   "id": "RU1-DX-01-R08",
   "c": "C02",
   "k": "a",
   "s": [],
   "w": "虑而后能得：前者为后者之条件"
  },
  {
   "id": "RU1-DX-01-R09",
   "c": "C08",
   "k": "a",
   "s": [],
   "w": "物格而后知至：知经与物相接而至"
