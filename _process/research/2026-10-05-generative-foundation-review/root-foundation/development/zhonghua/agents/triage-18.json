  {
   "id": "ZH1-C02-R-06",
   "c": "C10",
   "k": "a",
   "s": [
    "C16"
   ],
   "w": "不执一偶而居环中以应无穷"
  },
  {
   "id": "ZH1-C02-R-07",
   "c": "C01",
   "k": "a",
   "s": [
    "C07"
   ],
   "w": "道行之而成：律由展开读出非先在"
  },
  {
   "id": "ZH1-C02-R-08",
   "c": "C09",
   "k": "a",
   "s": [
    "C16"
   ],
   "w": "物谓之而然：然否由称谓约定而立"
  },
  {
   "id": "ZH1-C02-R-09",
   "c": "C03",
   "k": "a",
   "s": [
    "C01"
   ],
   "w": "分即成：同一变化之两种读法"
  },
  {
   "id": "ZH1-C02-R-10",
   "c": "C03",
   "k": "a",
   "s": [
    "C01"
   ],
   "w": "成即毁，复通为一：生灭为一变之读"
  },
  {
   "id": "ZH1-C02-R-11",
   "c": "C09",
   "k": "a",
   "s": [
    "C08"
   ],
   "w": "名实未亏而喜怒异：实同而读法异"
  },
  {
   "id": "ZH1-C02-R-12",
   "c": "C16",
   "k": "a",
   "s": [
    "C11"
   ],
   "w": "和是非而休天均：两读并行不定于一"
