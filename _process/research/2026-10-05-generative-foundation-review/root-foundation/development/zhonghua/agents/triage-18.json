  },
  {
   "id": "ZH1-C03-R-05",
   "c": "C17",
   "k": "a",
   "s": [
    "C03"
   ],
   "w": "来去皆时，安时处顺则哀乐不入"
  },
  {
   "id": "ZH1-C04-R-01",
   "c": "C10",
   "k": "a",
   "s": [
    "C11"
   ],
