  {
   "id": "ZH1-C02-R-13",
   "c": "C09",
   "k": "a",
   "s": [
    "C01"
   ],
   "w": "称一则一与言成二：称谓本身计入所计"
  },
  {
   "id": "ZH1-C02-R-14",
   "c": "C08",
   "k": "a",
   "s": [
    "C15"
   ],
   "w": "知止于所不知：识有其范围"
