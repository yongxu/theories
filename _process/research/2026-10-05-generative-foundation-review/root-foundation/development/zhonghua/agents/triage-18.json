  {
   "id": "ZH1-C02-R-15",
   "c": "C09",
   "k": "a",
   "s": [
    "C14"
   ],
   "w": "异类无共同正处正味：无跨情境之定准"
  },
  {
   "id": "ZH1-C02-R-16",
   "c": "C16",
   "k": "a",
   "s": [],
