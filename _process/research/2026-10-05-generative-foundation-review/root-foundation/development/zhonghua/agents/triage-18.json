   "id": "ZH1-C13-R-09",
   "c": "C12",
   "k": "a",
   "s": [
    "C09"
   ],
   "w": "可言者传而所得不传：传递有失"
  },
  {
   "id": "ZH1-C17-R-01",
   "c": "C08",
   "k": "a",
   "s": [
    "C17"
   ],
   "w": "所见范围受处所、时与教所限"
  },
  {
   "id": "ZH1-C17-R-02",
   "c": "C08",
   "k": "a",
   "s": [
    "C06"
   ],
   "w": "出涯涘观大海：范围扩展而知其限"
