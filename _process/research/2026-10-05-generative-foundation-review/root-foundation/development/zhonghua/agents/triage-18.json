  {
   "id": "ZH1-C02-R-19",
   "c": "C03",
   "k": "a",
   "s": [
    "C12"
   ],
   "w": "周蝶有分而化：同一展开中之转换"
  },
  {
   "id": "ZH1-C03-R-01",
   "c": "C08",
   "k": "a",
   "s": [
    "C04"
   ],
   "w": "以有涯之识随无涯之知则殆"
  },
  {
   "id": "ZH1-C03-R-02",
   "c": "C07",
   "k": "a",
   "s": [],
   "w": "依乎天理：循对象之结构而行"
