  {
   "id": "ZH1-C17-R-07",
   "c": "C09",
   "k": "a",
   "s": [
    "C14"
   ],
   "w": "以俗观之贵贱由约定，不在己"
  },
  {
   "id": "ZH1-C17-R-08",
   "c": "C02",
   "k": "a",
   "s": [
    "C07"
   ],
   "w": "东西相反而不可相无：对待互依"
  },
  {
   "id": "ZH1-C17-R-09",
   "c": "C17",
   "k": "a",
   "s": [],
   "w": "争让之效随时而异，未可为常"
  },
  {
   "id": "ZH1-C17-R-10",
   "c": "C17",
   "k": "a",
   "s": [
    "C02"
   ],
   "w": "殊器殊技殊性：能依所对而异"
  },
  {
   "id": "ZH1-C17-R-11",
   "c": "C07",
   "k": "a",
   "s": [],
   "w": "知道者必达于理：理为结构变化之律"
