  {
   "id": "CT1-R-ZL01",
   "c": "C01",
   "k": "a",
   "s": [
    "C04"
   ],
   "w": "求静于动，静不离动：静为变化之一读，非停"
  },
  {
   "id": "CT1-R-ZL02",
   "c": "C03",
   "k": "a",
   "s": [
    "C01"
   ],
   "w": "同一条件（昔物不至今）读作动与静：一变多读"
  },
  {
   "id": "CT1-R-ZL03",
   "c": "C03",
   "k": "s",
   "s": [
    "C05"
   ],
   "w": "昔自在昔今自在今：无实体跨步迁移；但否认延续之关联"
  },
  {
   "id": "CT1-R-ZL04",
   "c": "C09",
   "k": "a",
   "s": [
    "C10"
   ],
   "w": "言去之用在破常想：名言之功能非指实体"
  },
  {
   "id": "CT1-R-ZL05",
   "c": "C09",
   "k": "a",
   "s": [
    "C10"
   ],
   "w": "称住之用在释往执：名言为对治，不立实体"
  },
  {
   "id": "CT1-R-ZL06",
   "c": "C17",
   "k": "a",
   "s": [
    "C09"
   ],
   "w": "因所滞之情境而异其教：说法随情境"
  },
  {
   "id": "CT1-R-ZL07",
   "c": "C01",
   "k": "a",
   "s": [
    "C09"
   ],
   "w": "不迁与流动两说依用而异，会归一致：诸读成一"
  },
  {
   "id": "CT1-R-ZL08",
   "c": "C02",
   "k": "a",
   "s": [
    "C03"
   ],
   "w": "因因而果，果不俱因：依存沿步序先后"
  },
  {
   "id": "CT1-R-ZL09",
   "c": "C03",
   "k": "s",
   "s": [
    "C05"
   ],
   "w": "果依于因故因不昔灭：所生者承其所依"
  },
  {
   "id": "CT1-R-ZL10",
   "c": "C03",
   "k": "s",
   "s": [
    "C17"
   ],
   "w": "果不俱因故因不来今：各步自在其位"
  },
  {
   "id": "CT1-R-ZL11",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "CT1-R-ZL12",
   "c": "C01",
   "k": "a",
   "s": [
    "C10"
   ],
   "w": "只空心而不及物：偏于主体一边，非一元"
  },
  {
   "id": "CT1-R-ZL13",
   "c": "C02",
   "k": "s",
   "s": [
    "C01"
   ],
   "w": "色不自色：形非自立，依他而成"
  },
  {
   "id": "CT1-R-ZL14",
   "c": "C01",
   "k": "a",
   "s": [
    "C16"
   ],
   "w": "好无之谈：以无为实亦偏，非有非真有非无非真无"
  },
  {
   "id": "CT1-R-ZL15",
   "c": "C01",
   "k": "a",
   "s": [],
   "w": "非有非无不须涤除万物：无现象外之另一实在"
  },
  {
   "id": "CT1-R-ZL16",
   "c": "C01",
   "k": "a",
   "s": [
    "C02"
   ],
   "w": "性空非败空：即物而空，不待毁物"
  },
  {
   "id": "CT1-R-ZL17",
   "c": "C01",
   "k": "a",
   "s": [
    "C09"
   ],
   "w": "二谛不二于物：两读一物"
  },
  {
   "id": "CT1-R-ZL18",
   "c": "C02",
   "k": "a",
   "s": [],
   "w": "待缘而后有故非自有：依存者无自立之有"
  },
  {
   "id": "CT1-R-ZL19",
   "c": "C02",
   "k": "a",
   "s": [
    "C03"
   ],
   "w": "缘起故非无：既起则有所依之生"
  },
  {
   "id": "CT1-R-ZL20",
   "c": "C09",
   "k": "a",
   "s": [],
   "w": "假有之名以明非无：名为用，不立实体"
  },
  {
   "id": "CT1-R-ZL21",
   "c": "C09",
   "k": "a",
   "s": [],
   "w": "借无之名以辨非有：名之功能"
  },
  {
   "id": "CT1-R-ZL22",
   "c": "C01",
   "k": "a",
   "s": [
    "C02"
   ],
   "w": "象已形而非真生：有形而无自立实体"
  },
  {
   "id": "CT1-R-ZL23",
   "c": "C09",
   "k": "a",
   "s": [],
   "w": "名不当实实不当名：名实非固定对应"
  },
  {
   "id": "CT1-R-ZL24",
   "c": "C09",
   "k": "a",
   "s": [
    "C16",
    "C17"
   ],
   "w": "彼此之名随所立之位互换，无必然之定名"
  },
  {
   "id": "CT1-R-ZL25",
   "c": "C09",
   "k": "a",
   "s": [],
   "w": "万物假号：名为约定，非实体之标"
  },
  {
   "id": "CT1-R-ZL26",
   "c": "C01",
   "k": "a",
   "s": [],
   "w": "立处即真，触事而真：无两个实在"
  },
  {
