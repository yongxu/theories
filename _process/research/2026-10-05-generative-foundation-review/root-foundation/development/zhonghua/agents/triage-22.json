   "c": "C01",
   "k": "a",
   "s": [
    "C02"
   ],
   "w": "种子、本识、果不一不异：一关系项之诸角色"
  },
  {
   "id": "FO1-R-CY13",
   "c": "C09",
   "k": "s",
   "s": [],
   "w": "种子实有仅依世俗说：定域之读"
  },
  {
   "id": "FO1-R-CY14",
   "c": "C02",
   "k": "a",
   "s": [
    "C12"
   ],
   "w": "唯本有则转识不得为因缘：交互须能成其条件"
  },
  {
   "id": "FO1-R-CY15",
   "c": "C12",
   "k": "s",
   "s": [
    "C06"
   ],
   "w": "唯始起则无漏无因：新生须有所承之生成者"
  },
  {
   "id": "FO1-R-CY16",
   "c": "C12",
   "k": "d",
   "s": [
    "C01"
   ],
   "w": "本有种法尔而有、无始而定：先在固定之性"
  },
  {
   "id": "FO1-R-CY17",
   "c": "C03",
   "k": "a",
   "s": [
    "C02",
    "C06"
   ],
   "w": "剎那灭方有生用，常法无转变不能生：生成须变"
  },
  {
   "id": "FO1-R-CY18",
   "c": "C03",
   "k": "s",
   "s": [
    "C02"
   ],
   "w": "种现同时与种种前后：两种次序区分"
  },
  {
   "id": "FO1-R-CY19",
   "c": "C02",
   "k": "a",
   "s": [],
   "w": "待众缘故非恒顿生果：条件未齐则不生"
  },
  {
   "id": "FO1-R-CY20",
   "c": "C09",
   "k": "s",
   "s": [
    "C12"
   ],
   "w": "外种仅假名为种：同名不同义"
  },
  {
   "id": "FO1-R-CY21",
   "c": "C02",
   "k": "s",
   "s": [],
   "w": "所熏须四条件共具"
  },
  {
   "id": "FO1-R-CY22",
   "c": "C02",
   "k": "a",
   "s": [
    "C03"
   ],
   "w": "能熏须有生灭有增减：唯变化者能致差别"
  },
  {
   "id": "FO1-R-CY23",
   "c": "C02",
   "k": "a",
   "s": [
    "C11"
   ],
   "w": "能所熏俱生俱灭而令种子生长：相互依存"
  },
  {
   "id": "FO1-R-CY24",
   "c": "C11",
   "k": "a",
   "s": [
    "C02"
   ],
   "w": "现行从种生又反熏成种：闭合之环"
  },
  {
   "id": "FO1-R-CY25",
   "c": "C11",
   "k": "a",
   "s": [
    "C12"
   ],
   "w": "能熏于所熏反熏成种：环路回到其生成者"
  },
  {
   "id": "FO1-R-CY26",
   "c": "C08",
   "k": "s",
   "s": [
