  },
  {
   "id": "FO1-R-CY06",
   "c": "C08",
   "k": "a",
   "s": [],
   "w": "识即了别：所读所辨"
  },
  {
   "id": "FO1-R-CY07",
   "c": "C01",
   "k": "d",
   "s": [
    "C08",
    "C09"
   ],
   "w": "我法皆依识变假施：以识为唯一所依，立识为先在之本"
  },
  {
   "id": "FO1-R-CY08",
   "c": "C08",
   "k": "d",
   "s": [
    "C01"
   ],
   "w": "外境非有如识、内识非无：内外不对称，识独有实"
  },
  {
   "id": "FO1-R-CY09",
   "c": "C02",
   "k": "s",
   "s": [
    "C01"
   ],
   "w": "藏识与杂染互为缘，然被立为摄持因果之中心"
  },
  {
   "id": "FO1-R-CY10",
   "c": "C05",
   "k": "s",
   "s": [
    "C12"
   ],
   "w": "持种令不失：保存后续生起之条件"
  },
  {
   "id": "FO1-R-CY11",
   "c": "C12",
   "k": "s",
   "s": [
    "C06"
   ],
   "w": "种子为亲生自果之功能：生起同类之能"
