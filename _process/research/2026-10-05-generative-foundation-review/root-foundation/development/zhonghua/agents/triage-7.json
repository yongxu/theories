   "id": "WP-XG-C01-S06-R01",
   "c": "C07",
   "k": "d",
   "s": [
    "C13"
   ],
   "w": "讼必有众起：卦对之间序作必然"
  },
  {
   "id": "WP-XG-C01-S06-R02",
   "c": "-",
   "k": "-",
