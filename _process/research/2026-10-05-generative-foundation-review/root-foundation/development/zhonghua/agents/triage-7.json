   ],
   "w": "有天地然后万物生：条件先成而物生于其间"
  },
  {
   "id": "WP-XG-C01-S02-R01",
   "c": "C01",
   "k": "a",
   "s": [
    "C07"
   ],
   "w": "盈天地之间者唯万物：无物外之另一实"
  },
  {
   "id": "WP-XG-C01-S02-R02",
   "c": "-",
   "k": "-",
   "s": []
  },
  {
   "id": "WP-XG-C01-S02-R03",
   "c": "C03",
   "k": "a",
   "s": [],
   "w": "屯为物之始生：生起之初段"
  },
  {
   "id": "WP-XG-C01-S03-R01",
   "c": "C07",
   "k": "s",
   "s": [
    "C03"
   ],
   "w": "屯受之以蒙：卦对内反转相承，律只在对内给出"
  },
  {
   "id": "WP-XG-C01-S03-R02",
   "c": "C03",
   "k": "s",
   "s": [],
   "w": "蒙为物之稚：生成阶段之读"
  },
  {
   "id": "WP-XG-C01-S03-R03",
   "c": "C10",
   "k": "s",
   "s": [
    "C08"
   ],
   "w": "物生必蒙：初生识未及，“必”作普遍则越界"
  },
  {
   "id": "WP-XG-C01-S04-R01",
   "c": "C07",
   "k": "d",
   "s": [
    "C02"
   ],
   "w": "序卦以“必”接卦对之间：列表之序非律之行"
  },
  {
   "id": "WP-XG-C01-S04-R02",
   "c": "C02",
   "k": "a",
   "s": [
    "C04"
   ],
   "w": "需为饮食之道：生者汲取所养"
  },
  {
   "id": "WP-XG-C01-S04-R03",
   "c": "C02",
   "k": "a",
   "s": [
    "C06"
   ],
   "w": "物稚不可不养：形成依存于供给"
  },
  {
   "id": "WP-XG-C01-S05-R01",
   "c": "C13",
   "k": "d",
   "s": [
    "C07"
   ],
   "w": "饮食必有讼：以争为必然，序非律所给"
  },
  {
   "id": "WP-XG-C01-S05-R02",
   "c": "C13",
   "k": "d",
   "s": [
    "C04"
   ],
   "w": "饮食必有讼：以争为必然之结构"
  },
