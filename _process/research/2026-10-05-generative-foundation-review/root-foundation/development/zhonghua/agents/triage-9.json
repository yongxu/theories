   "c": "C07",
   "k": "s",
   "s": [],
   "w": "阳卦多阴以奇偶归并：奇偶为律之归并"
  },
  {
   "id": "WP-XCX-C03-S02-R02",
   "c": "C13",
   "k": "d",
   "s": [],
