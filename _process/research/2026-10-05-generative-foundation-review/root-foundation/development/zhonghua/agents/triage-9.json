  },
  {
   "id": "WP-XCX-C04-S03-R01",
   "c": "C03",
   "k": "a",
   "s": [],
   "w": "往者屈：同一变化之收缩一读"
  },
  {
   "id": "WP-XCX-C04-S03-R02",
   "c": "C03",
   "k": "a",
   "s": [],
   "w": "来者信：同一变化之伸展一读"
  },
  {
   "id": "WP-XCX-C04-S03-R03",
   "c": "C03",
   "k": "a",
   "s": [
    "C02"
   ],
   "w": "屈信相感而利生：相反两相交互而有所生"
  },
