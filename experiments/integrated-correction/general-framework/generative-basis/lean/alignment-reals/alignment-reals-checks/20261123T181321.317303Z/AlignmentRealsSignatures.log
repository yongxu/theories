                                          dist (π t) q_k ≤ sim.β * max d₀ (sim.ε / (1 - sim.α)) + sim.η) ∧
                      Becoming.Viability.Kernel P guardS s₀
@Becoming.AlignmentReals.discrete_absorb_of_metric : ∀ {S : Type u_1} {A : Type u_2} {Q : Type u_3} {B : Type u_4}
  {P : Generative.Process S A} {R : Generative.Process Q B} {π : S → Q} {σ : ℕ → ℕ} [inst : PseudoMetricSpace Q]
  (sim : Becoming.AlignmentReals.MetricLaxSim P R π σ) (δ : ℝ) (hδ : 0 < δ),
  have ε_nat := ⌈sim.ε / δ⌉₊;
  have Δ_nat := ⌈↑ε_nat / (1 - sim.α)⌉₊;
  (Becoming.AlignmentReals.toDiscreteLaxSim sim δ hδ).α Δ_nat + (Becoming.AlignmentReals.toDiscreteLaxSim sim δ hδ).ε ≤
    Δ_nat
@Becoming.AlignmentReals.metric_to_discrete_kernel : ∀ {S : Type u_1} {A : Type u_2} {Q : Type u_3} {B : Type u_4}
  {P : Generative.Process S A} {R : Generative.Process Q B} {π : S → Q} {σ : ℕ → ℕ} [inst : PseudoMetricSpace Q]
  (sim : Becoming.AlignmentReals.MetricLaxSim P R π σ) (δ : ℝ),
  0 < δ →
    ∀ {guardQ K : Q → Prop} {guardS : S → Prop},
      Becoming.Viability.Certificate R guardQ K →
        (∀ (q : Q) (u : S),
            guardQ q → dist (π u) q ≤ δ * (↑⌈sim.β * ↑⌈↑⌈sim.ε / δ⌉₊ / (1 - sim.α)⌉₊⌉₊ + ↑⌈sim.η / δ⌉₊) → guardS u) →
          ∀ {s₀ : S}, sim.Epoch (σ 0) s₀ → K (π s₀) → Becoming.Viability.Kernel P guardS s₀
@Becoming.AlignmentReals.strict_margin_discretization_step : ∀ {S : Type u_1} {A : Type u_2} {Q : Type u_3}
  {B : Type u_4} {P : Generative.Process S A} {R : Generative.Process Q B} {π : S → Q} {σ : ℕ → ℕ}
  [inst : PseudoMetricSpace Q] (sim : Becoming.AlignmentReals.MetricLaxSim P R π σ) {R_tube : ℝ},
  sim.β * (sim.ε / (1 - sim.α)) + sim.η < R_tube →
    ∃ δ, 0 < δ ∧ δ * (↑⌈sim.β * ↑⌈↑⌈sim.ε / δ⌉₊ / (1 - sim.α)⌉₊⌉₊ + ↑⌈sim.η / δ⌉₊) ≤ R_tube
@Becoming.AlignmentReals.metric_to_discrete_kernel_of_strict_margin : ∀ {S : Type u_1} {A : Type u_2} {Q : Type u_3}
  {B : Type u_4} {P : Generative.Process S A} {R : Generative.Process Q B} {π : S → Q} {σ : ℕ → ℕ}
  [inst : PseudoMetricSpace Q] (sim : Becoming.AlignmentReals.MetricLaxSim P R π σ) {R_tube : ℝ},
  sim.β * (sim.ε / (1 - sim.α)) + sim.η < R_tube →
    ∀ {guardQ K : Q → Prop} {guardS : S → Prop},
      Becoming.Viability.Certificate R guardQ K →
        (∀ (q : Q) (u : S), guardQ q → dist (π u) q ≤ R_tube → guardS u) →
          ∀ {s₀ : S}, sim.Epoch (σ 0) s₀ → K (π s₀) → Becoming.Viability.Kernel P guardS s₀
@Becoming.AlignmentReals.linear_fa_margin_shift : ∀ {d : ℕ} (φ_safe φ_warn : Fin d → ℝ) (η : ℝ) (δ : ℕ → ℝ)
  (θ₀ : Fin d → ℝ) (t : ℕ),
  Becoming.AlignmentReals.faSafeUpdate φ_safe η δ θ₀ t ⬝ᵥ φ_warn =
    θ₀ ⬝ᵥ φ_warn + η * φ_safe ⬝ᵥ φ_warn * ∑ k ∈ Finset.range t, δ k
@Becoming.AlignmentReals.linear_fa_tabular_invariant : ∀ {d : ℕ} (φ_safe φ_warn : Fin d → ℝ),
  φ_safe ⬝ᵥ φ_warn = 0 →
    ∀ (η : ℝ) (δ : ℕ → ℝ) (θ₀ : Fin d → ℝ) (t : ℕ),
      Becoming.AlignmentReals.faSafeUpdate φ_safe η δ θ₀ t ⬝ᵥ φ_warn = θ₀ ⬝ᵥ φ_warn
@Becoming.AlignmentReals.linear_fa_warn_eq : ∀ {d : ℕ} (φ_warn : Fin d → ℝ) (η : ℝ) (p : ℕ → ℝ) (θ_enter : Fin d → ℝ)
  (m : ℕ),
  Becoming.AlignmentReals.faWarnUpdate φ_warn η p θ_enter m ⬝ᵥ φ_warn =
    θ_enter ⬝ᵥ φ_warn - η * φ_warn ⬝ᵥ φ_warn * ∑ k ∈ Finset.range m, p k
@Becoming.AlignmentReals.linear_fa_warn_lower : ∀ {d : ℕ} (φ_warn : Fin d → ℝ) (η p_max : ℝ),
  0 ≤ η →
    ∀ (p : ℕ → ℝ),
      (∀ (k : ℕ), p k ≤ p_max) →
        ∀ (θ_enter : Fin d → ℝ) (m : ℕ),
          θ_enter ⬝ᵥ φ_warn - ↑m * (η * p_max * φ_warn ⬝ᵥ φ_warn) ≤
            Becoming.AlignmentReals.faWarnUpdate φ_warn η p θ_enter m ⬝ᵥ φ_warn
@Becoming.AlignmentReals.linear_fa_leakage_hysteresis : ∀ {d : ℕ} (φ_safe φ_warn : Fin d → ℝ)
  (η p_max v_rest d_agg d_rest R x_warn x_crit : ℝ),
  0 ≤ η →
    0 ≤ p_max →
      ∀ (δ p : ℕ → ℝ),
        (∀ (k : ℕ), p k ≤ p_max) →
          ∀ (θ₀ : Fin d → ℝ) (T_safe M_delay : ℕ),
            0 < M_delay →
              (φ_safe ⬝ᵥ φ_warn = 0 →
                  θ₀ ⬝ᵥ φ_warn ≤ v_rest →
                    Becoming.AlignmentReals.faSafeUpdate φ_safe η δ θ₀ T_safe ⬝ᵥ φ_warn ≤ v_rest) ∧
                (v_rest <
                    θ₀ ⬝ᵥ φ_warn + η * φ_safe ⬝ᵥ φ_warn * ∑ k ∈ Finset.range T_safe, δ k -
                      ↑(M_delay - 1) * (η * p_max * φ_warn ⬝ᵥ φ_warn) →
                  have θ_enter := Becoming.AlignmentReals.faSafeUpdate φ_safe η δ θ₀ T_safe;
                  (∀ m < M_delay, v_rest < Becoming.AlignmentReals.faWarnUpdate φ_warn η p θ_enter m ⬝ᵥ φ_warn) ∧
                    (∀ m ≤ M_delay,
                        Becoming.AlignmentReals.warnStock d_agg d_rest R φ_warn v_rest η p θ_enter x_warn m =
                          x_warn - ↑m * (d_agg - R)) ∧
                      (x_warn - x_crit < (d_agg - R) * ↑M_delay →
                        Becoming.AlignmentReals.warnStock d_agg d_rest R φ_warn v_rest η p θ_enter x_warn M_delay <
                          x_crit))
