  (law : Becoming.AlignmentReals.FiniteLaw S) (D : Ω → ℕ) {A U R O : Type} {fA : A → R → A} {need : U → ℕ}
  {kids : R → U → List U} {giving : ℕ → ℕ} {use : U → ℕ} {N Y H₁ H₂ y₂ x₀ : ℕ} {x_o y_o : O},
  2 ≤ N →
    x_o ≠ y_o →
      Becoming.RegimeMargin.FromNothing giving →
        Becoming.RegimeMargin.AtMost giving Y →
          Y < H₁ →
            H₁ ≤ H₂ + y₂ →
              Becoming.RegimeMargin.Short giving H₂ y₂ →
                (∀ (u : U), 0 < need u ∧ need u ≤ H₂ + y₂) →
                  ∀ {g_bad : R} {w₀ : List U},
                    Becoming.PacedStock.LowerDrawWhileMet H₁ need kids giving use g_bad w₀ x₀ (2 * N - 1) →
                      (∀ (w : List U), w ≠ [] → H₂ ≤ Becoming.LineOnAStock.taken use w) →
                        H₂ + y₂ < x₀ →
                          (∀ (δ : ℝ),
                              0 < δ →
                                (law.expect fun ω => ↑(D ω) * (↑H₁ - ↑Y)) / δ ≤ ↑x₀ - ↑(H₂ + y₂) →
                                  1 - δ ≤ law.prob fun ω => ↑(D ω) * (↑H₁ - ↑Y) ≤ ↑x₀ - ↑(H₂ + y₂)) ∧
                            (∀ (M : ℕ) (p_fail : ℝ),
                                ↑x₀ - ↑(H₂ + y₂) < ↑M * (↑H₁ - ↑Y) →
                                  (p_fail ≤ law.prob fun ω => ↑M * (↑H₁ - ↑Y) ≤ ↑(D ω) * (↑H₁ - ↑Y)) →
                                    (law.prob fun ω => ↑(D ω) * (↑H₁ - ↑Y) ≤ ↑x₀ - ↑(H₂ + y₂)) ≤ 1 - p_fail) ∧
                              (∀ (ω : Ω),
                                  ↑x₀ - ↑(H₂ + y₂) < ↑(D ω) * (↑H₁ - ↑Y) →
                                    ∃ k ≤ D ω,
                                      (Becoming.Law.run (Becoming.RegimeMargin.step giving H₁) x₀).state k < H₂ + y₂) ∧
                                (x₀ < H₂ + y₂ + (H₁ - Y) * (2 * N - 1) →
                                    ∀ (ω : Ω) (σ : ℕ → ℕ) (reads : ℕ → Bool)
                                      (h : Becoming.PacedStock.StockState A U → R → R) (a₀ : A),
                                      2 * N - 1 ≤ D ω →
                                        σ 0 = 0 →
                                          σ 1 = D ω →
                                            Becoming.Strict σ →
