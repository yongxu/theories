                                                      (Becoming.PacedStock.pacedCourse fA need kids giving use h reads
                                                            ((a₀, w₀, x₀), g_bad) t).1.2) ∧
                                  ∀ (n k : ℕ) (p Δ slack : ℝ) (hp0 : 0 ≤ p) (hp1 : p ≤ 1),
                                    0 < Δ →
                                      ↑k * Δ ≤ slack →
                                        slack < ↑(k + 1) * Δ →
                                          ((Becoming.AlignmentReals.productBoolLaw n p hp0 hp1).prob fun ω =>
                                              ↑(Becoming.AlignmentReals.spikeCount ω) * Δ ≤ slack) =
                                            Becoming.AlignmentReals.survProb n k p
