@Becoming.RegimeMargin.step_zero : ∀ {g : Nat → Nat} (H : Nat),
  Becoming.RegimeMargin.FromNothing g → Becoming.RegimeMargin.step g H 0 = 0
@Becoming.RegimeMargin.step_of_lt : ∀ {g : Nat → Nat} {H x : Nat},
  Becoming.RegimeMargin.FromNothing g → x < H → Becoming.RegimeMargin.step g H x = 0
Becoming.RegimeMargin.step_ge : ∀ (g : Nat → Nat) (H x : Nat), x ≤ Becoming.RegimeMargin.step g H x + H
@Becoming.RegimeMargin.step_falls : ∀ {g : Nat → Nat} {H y x : Nat},
  Becoming.RegimeMargin.Short g H y →
    Becoming.RegimeMargin.FromNothing g → 0 < x → x < H + y → Becoming.RegimeMargin.step g H x < x
@Becoming.RegimeMargin.step_below : ∀ {g : Nat → Nat} {H y x : Nat},
  Becoming.RegimeMargin.Short g H y →
    Becoming.RegimeMargin.FromNothing g → x < H + y → Becoming.RegimeMargin.step g H x < H + y
@Becoming.RegimeMargin.orbit_bound : ∀ {g : Nat → Nat} {H y x : Nat},
  Becoming.RegimeMargin.Short g H y →
    Becoming.RegimeMargin.FromNothing g →
      x < H + y →
        ∀ (n : Nat),
          Becoming.Law.orbit (Becoming.RegimeMargin.step g H) x n < H + y ∧
            Becoming.Law.orbit (Becoming.RegimeMargin.step g H) x n ≤ x - n
@Becoming.RegimeMargin.ends_below : ∀ {g : Nat → Nat} {H y x : Nat},
  Becoming.RegimeMargin.Short g H y →
    Becoming.RegimeMargin.FromNothing g → x < H + y → (Becoming.Law.run (Becoming.RegimeMargin.step g H) x).state x = 0
@Becoming.RegimeMargin.orbit_from_zero : ∀ {g : Nat → Nat} (H : Nat),
  Becoming.RegimeMargin.FromNothing g → ∀ (k : Nat), Becoming.Law.orbit (Becoming.RegimeMargin.step g H) 0 k = 0
@Becoming.RegimeMargin.stays_ended : ∀ {g : Nat → Nat} {H y x : Nat},
  Becoming.RegimeMargin.Short g H y →
    Becoming.RegimeMargin.FromNothing g →
      x < H + y → ∀ (k : Nat), (Becoming.Law.run (Becoming.RegimeMargin.step g H) x).state (x + k) = 0
@Becoming.RegimeMargin.ends_beyond_giving : ∀ {g : Nat → Nat} {H : Nat},
  (∀ (z : Nat), g z < H) →
    Becoming.RegimeMargin.FromNothing g → ∀ (x : Nat), (Becoming.Law.run (Becoming.RegimeMargin.step g H) x).state x = 0
@Becoming.RegimeMargin.step_holds : ∀ {g : Nat → Nat} {H y hi x : Nat},
  Becoming.RegimeMargin.Meets g H y hi → H + y ≤ x → x ≤ hi → x ≤ Becoming.RegimeMargin.step g H x
@Becoming.RegimeMargin.holds : ∀ {g : Nat → Nat} {H y hi x : Nat},
  Becoming.RegimeMargin.Meets g H y hi →
    Becoming.RegimeMargin.Keeps g H hi →
      H + y ≤ x →
        x ≤ hi →
          ∀ (n : Nat),
            x ≤ (Becoming.Law.run (Becoming.RegimeMargin.step g H) x).state n ∧
              (Becoming.Law.run (Becoming.RegimeMargin.step g H) x).state n ≤ hi
@Becoming.RegimeMargin.ends_iff_below : ∀ {g : Nat → Nat} {H y hi x : Nat},
  0 < H + y →
    Becoming.RegimeMargin.Short g H y →
      Becoming.RegimeMargin.FromNothing g →
        Becoming.RegimeMargin.Meets g H y hi →
          Becoming.RegimeMargin.Keeps g H hi →
            x ≤ hi → ((∃ n, (Becoming.Law.run (Becoming.RegimeMargin.step g H) x).state n = 0) ↔ x < H + y)
@Becoming.RegimeMargin.root_above_need : ∀ {g : Nat → Nat} {m H y : Nat},
  Becoming.RegimeMargin.Gated g m → 0 < H → H ≤ g y → m ≤ y
@Becoming.RegimeMargin.beyond_draw_iff : ∀ {g : Nat → Nat} {m H y : Nat},
  Becoming.RegimeMargin.Gated g m → 0 < H → Becoming.RegimeMargin.Root g H y → (m < y ↔ g m < H)
@Becoming.RegimeMargin.root_mono : ∀ {g g' : Nat → Nat} {H H' y y' : Nat},
  Becoming.RegimeMargin.Root g H y →
    Becoming.RegimeMargin.Root g' H' y' → H ≤ H' → Becoming.RegimeMargin.Lowered g' g → y ≤ y'
@Becoming.RegimeMargin.rises_by_draw : ∀ {g g' : Nat → Nat} {H H' y y' : Nat},
  Becoming.RegimeMargin.Root g H y →
    Becoming.RegimeMargin.Root g' H' y' → H ≤ H' → Becoming.RegimeMargin.Lowered g' g → H + y + (H' - H) ≤ H' + y'
@Becoming.RegimeMargin.lowered_raises : ∀ {g g' : Nat → Nat} {H y y' : Nat},
  Becoming.RegimeMargin.Root g H y → Becoming.RegimeMargin.Root g' H y' → Becoming.RegimeMargin.Lowered g' g → y ≤ y'
@Becoming.RegimeMargin.lowered_raises_strictly : ∀ {g g' : Nat → Nat} {H y y' : Nat},
  Becoming.RegimeMargin.Root g H y →
    Becoming.RegimeMargin.Root g' H y' → Becoming.RegimeMargin.Lowered g' g → (y < y' ↔ g' y < H)
@Becoming.RegimeMargin.harms_superadditive : ∀ {g₁ g₂ g : Nat → Nat} {m H₁ H₂ a b c : Nat},
  Becoming.RegimeMargin.SubadditiveAbove g m →
    Becoming.RegimeMargin.Lowered g g₁ →
      Becoming.RegimeMargin.Lowered g g₂ →
        Becoming.RegimeMargin.Root g₁ H₁ (m + a) →
          Becoming.RegimeMargin.Root g₂ H₂ (m + b) → Becoming.RegimeMargin.Root g (H₁ + H₂) (m + c) → a + b ≤ c + 1
Becoming.RegimeMargin.orbit_ge : ∀ (g : Nat → Nat) (H x n : Nat),
  x ≤ (Becoming.Law.run (Becoming.RegimeMargin.step g H) x).state n + H * n
Becoming.RegimeMargin.not_before : ∀ (g : Nat → Nat) {H x b n : Nat},
  b + H * n ≤ x → b ≤ (Becoming.Law.run (Becoming.RegimeMargin.step g H) x).state n
@Becoming.RegimeMargin.step_falls_by : ∀ {g : Nat → Nat} {H Y x : Nat},
  Becoming.RegimeMargin.AtMost g Y → Y ≤ H → H ≤ x → Becoming.RegimeMargin.step g H x + (H - Y) ≤ x
@Becoming.RegimeMargin.falls_or_bound : ∀ {g : Nat → Nat} {H Y b x : Nat},
  Becoming.RegimeMargin.AtMost g Y →
    Y ≤ H →
      H ≤ b →
        ∀ (n : Nat),
          (∃ k, k ≤ n ∧ (Becoming.Law.run (Becoming.RegimeMargin.step g H) x).state k < b) ∨
            (Becoming.Law.run (Becoming.RegimeMargin.step g H) x).state n + (H - Y) * n ≤ x ∧
              b ≤ (Becoming.Law.run (Becoming.RegimeMargin.step g H) x).state n
@Becoming.RegimeMargin.falls_within : ∀ {g : Nat → Nat} {H Y b x n : Nat},
  Becoming.RegimeMargin.AtMost g Y →
    Y ≤ H → H ≤ b → x < b + (H - Y) * n → ∃ k, k ≤ n ∧ (Becoming.Law.run (Becoming.RegimeMargin.step g H) x).state k < b
@Becoming.RegimeMargin.below_spec : ∀ {f : Nat → Bool} {n : Nat},
  Becoming.RegimeMargin.below f n = true → ∀ (z : Nat), z < n → f z = true
@Becoming.RegimeMargin.short_of_below : ∀ {g : Nat → Nat} {H y : Nat},
  Becoming.RegimeMargin.below (fun z => decide (g z < H)) y = true → Becoming.RegimeMargin.Short g H y
@Becoming.RegimeMargin.meets_of_below : ∀ {g : Nat → Nat} {H y hi : Nat},
  Becoming.RegimeMargin.below (fun z => !(decide (y ≤ z) && decide (z + H ≤ hi)) || decide (H ≤ g z)) (hi + 1) = true →
    Becoming.RegimeMargin.Meets g H y hi
@Becoming.RegimeMargin.keeps_of_below : ∀ {g : Nat → Nat} {H hi : Nat},
  Becoming.RegimeMargin.below (fun x => decide (Becoming.RegimeMargin.step g H x ≤ hi)) (hi + 1) = true →
    Becoming.RegimeMargin.Keeps g H hi
Becoming.RegimeMargin.Concave.roots : Becoming.RegimeMargin.Root Becoming.RegimeMargin.Concave.giving 4 2 ∧
  Becoming.RegimeMargin.Root Becoming.RegimeMargin.Concave.giving 8 6
Becoming.RegimeMargin.Peaked.fromNothing : Becoming.RegimeMargin.FromNothing Becoming.RegimeMargin.Peaked.giving
Becoming.RegimeMargin.Peaked.min_le_left' : ∀ (a b : Nat), min a b ≤ a
Becoming.RegimeMargin.Peaked.min_le_right' : ∀ (a b : Nat), min a b ≤ b
Becoming.RegimeMargin.Peaked.atMost : Becoming.RegimeMargin.AtMost Becoming.RegimeMargin.Peaked.giving 4
@Becoming.RegimeMargin.Peaked.each_holds : ∀ {x : Nat},
  6 ≤ x →
    x ≤ 8 →
      ∀ (n : Nat), x ≤ (Becoming.Law.run (Becoming.RegimeMargin.step Becoming.RegimeMargin.Peaked.giving 3) x).state n
Becoming.RegimeMargin.Peaked.together_ends : ∀ (x : Nat),
  (Becoming.Law.run (Becoming.RegimeMargin.step Becoming.RegimeMargin.Peaked.giving (3 + 3)) x).state x = 0
