@Becoming.Optimum.Exceeds.total_lt : ∀ {C : Type} {o o' : C → Nat} {ds : List C},
  Becoming.Optimum.Exceeds ds o' o → Becoming.total ds o < Becoming.total ds o'
@Becoming.Optimum.rising_total : ∀ {C : Type} (ds : List C),
  Becoming.Optimum.Rising ds fun o' o => Becoming.total ds o < Becoming.total ds o'
@Becoming.Optimum.Rising.mono : ∀ {C : Type} {ds : List C} {better : (C → Nat) → (C → Nat) → Prop},
  Becoming.Optimum.Rising ds better →
    ∀ {better' : (C → Nat) → (C → Nat) → Prop},
      (∀ (o' o : C → Nat), better o' o → better' o' o) → Becoming.Optimum.Rising ds better'
@Becoming.Optimum.least_iff : ∀ {C : Type} {ds rest : List C} {eligible : (C → Nat) → Prop},
  (∀ (better : (C → Nat) → (C → Nat) → Prop),
      Becoming.Optimum.Rising ds better →
        ∀ (o : C → Nat), Becoming.Requirement.Frontier eligible better o → Becoming.Optimum.Least rest eligible o) ↔
    ∀ (o o' : C → Nat),
      eligible o →
        eligible o' → ∀ (c : C), c ∈ rest → o' c < o c → ¬¬∃ o'', eligible o'' ∧ Becoming.Optimum.Exceeds ds o'' o
@Becoming.Optimum.least_of_room : ∀ {C : Type} {ds rest : List C} {eligible : (C → Nat) → Prop}
  {better : (C → Nat) → (C → Nat) → Prop},
  Becoming.Optimum.Rising ds better →
    Becoming.Optimum.Room ds rest eligible →
      ∀ {o : C → Nat}, Becoming.Requirement.Frontier eligible better o → Becoming.Optimum.Least rest eligible o
@Becoming.Optimum.transfer_exceeds : ∀ {C : Type} {ds : List C} [inst : DecidableEq C] {c d : C},
  ¬c ∈ ds → d ∈ ds → ∀ (o : C → Nat), Becoming.Optimum.Exceeds ds (Becoming.Optimum.transfer c d o) o
@Becoming.Optimum.Shared.room : ∀ {C : Type} {ds rest : List C} {eligible : (C → Nat) → Prop} [inst : DecidableEq C],
  (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
    ∀ {d : C}, d ∈ ds → Becoming.Optimum.Shared ds rest eligible → Becoming.Optimum.Room ds rest eligible
@Becoming.Optimum.least_of_shared : ∀ {C : Type} {ds rest : List C} {eligible : (C → Nat) → Prop}
  {better : (C → Nat) → (C → Nat) → Prop} [inst : DecidableEq C],
  Becoming.Optimum.Rising ds better →
    (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
      ∀ {d : C},
        d ∈ ds →
          Becoming.Optimum.Shared ds rest eligible →
            ∀ {o : C → Nat}, Becoming.Requirement.Frontier eligible better o → Becoming.Optimum.Least rest eligible o
@Becoming.Web.optimum_broken_iff : ∀ {F C : Type} {W : Becoming.Web F C} {ds rest : List C}
  {eligible : (C → Nat) → Prop} {better : (C → Nat) → (C → Nat) → Prop} {dep : C → F} {t : Nat},
  Becoming.Optimum.Rising ds better →
    Becoming.Optimum.Room ds rest eligible →
      Becoming.Requirement.Frontier eligible better (W.level (t + 1)) →
        W.MetOn dep rest t → ∀ {c : C}, c ∈ rest → (W.Broken t (dep c) c ↔ ∃ o, eligible o ∧ o c < W.need t (dep c) c)
@Becoming.Web.optimum_ends_beyond : ∀ {F C : Type} {W : Becoming.Web F C} {ds rest : List C}
  {eligible : (C → Nat) → Prop} {better : (C → Nat) → (C → Nat) → Prop} {dep : C → F} {t : Nat} {obs : F → C → Prop}
  {members : F → Prop},
  Becoming.Optimum.Rising ds better →
    Becoming.Optimum.Room ds rest eligible →
      Becoming.Requirement.Frontier eligible better (W.level (t + 1)) →
        W.MetOn dep rest t →
          W.Dependent →
            (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
              (∀ (h : F) (c : C), members h → W.CoupledInto obs h c → c ∈ ds) →
                ∀ {c : C},
                  c ∈ rest →
                    ∀ {o : C → Nat},
                      eligible o →
                        o c < W.need t (dep c) c →
                          W.requires (t + 1) (dep c) c ∧ W.need t (dep c) c ≤ W.need (t + 1) (dep c) c →
                            W.Broken t (dep c) c ∧
                              ¬W.active (t + 1) (dep c) ∧
                                ¬members (dep c) ∧ ∀ (h : F), members h → ¬W.CoupledInto obs h c
@Becoming.Flow.Balances.family_le_iff : ∀ {F C : Type} {ds rest : List C} {t : Nat} {L L' : Becoming.Flow F C}
  {W W' : Becoming.Web F C},
  L.Balances W →
    L'.Balances W' →
      L.GainlessOn (ds ++ rest) t →
        L'.GainlessOn (ds ++ rest) t →
          W.stock ds t + W.stock rest t = W'.stock ds t + W'.stock rest t →
            (W.stock ds (t + 1) ≤ W'.stock ds (t + 1) ↔
              W'.stock rest (t + 1) + L'.lost (ds ++ rest) t ≤ W.stock rest (t + 1) + L.lost (ds ++ rest) t)
@Becoming.Flow.top_iff_least : ∀ {F C : Type} {ds rest : List C} {t : Nat} {A : Type} {L : A → Becoming.Flow F C}
  {W : A → Becoming.Web F C},
  (∀ (a : A), (L a).Balances (W a)) →
    (∀ (a : A), (L a).GainlessOn (ds ++ rest) t) →
      (∀ (a b : A), (W a).stock ds t + (W a).stock rest t = (W b).stock ds t + (W b).stock rest t) →
        ∀ (a : A),
          (∀ (b : A), (W b).stock ds (t + 1) ≤ (W a).stock ds (t + 1)) ↔
            ∀ (b : A),
              (W a).stock rest (t + 1) + (L a).lost (ds ++ rest) t ≤
                (W b).stock rest (t + 1) + (L b).lost (ds ++ rest) t
@Becoming.Flow.keeping_optimum_takes_slack : ∀ {F C : Type} {ds rest : List C} {t : Nat} {L : Becoming.Flow F C}
  {W : Becoming.Web F C} {eligible : (C → Nat) → Prop} {better : (C → Nat) → (C → Nat) → Prop} {dep : C → F},
  L.Balances W →
    L.GainlessOn (ds ++ rest) t →
      W.MetOn dep rest t →
        Becoming.Optimum.Rising ds better →
          (Becoming.Optimum.Room ds rest fun o => eligible o ∧ ∀ (c : C), c ∈ rest → W.need t (dep c) c ≤ o c) →
            (∀ (c : C),
                c ∈ rest →
                  ∃ o, (eligible o ∧ ∀ (c : C), c ∈ rest → W.need t (dep c) c ≤ o c) ∧ o c ≤ W.need t (dep c) c) →
              Becoming.Requirement.Frontier (fun o => eligible o ∧ ∀ (c : C), c ∈ rest → W.need t (dep c) c ≤ o c)
                  better (W.level (t + 1)) →
                (∀ (c : C), c ∈ rest → ¬W.Broken t (dep c) c) ∧
                  W.stock ds (t + 1) + L.lost (ds ++ rest) t = W.stock ds t + W.slack dep rest t
Becoming.Optimum.Drain.storeOrder_rising : Becoming.Optimum.Rising [Becoming.Diversion.Place.store]
  Becoming.Optimum.Drain.storeOrder
Becoming.Optimum.Drain.split_shared : Becoming.Optimum.Shared [Becoming.Diversion.Place.store]
  [Becoming.Diversion.Place.source] Becoming.Optimum.Drain.Split
Becoming.Optimum.Drain.drained_optimum : Becoming.Requirement.Frontier Becoming.Optimum.Drain.Split
  Becoming.Optimum.Drain.storeOrder ((Becoming.Diversion.web Becoming.Optimum.Drain.drainedLevel).level 1)
Becoming.Optimum.Drain.taker_couples_store : ∀ (level : Nat → Becoming.Diversion.Place → Nat)
  (h : Becoming.Diversion.Formation) (c : Becoming.Diversion.Place),
  h = Becoming.Diversion.Formation.taker →
    (Becoming.Diversion.web level).CoupledInto Becoming.Diversion.gauge h c → c ∈ [Becoming.Diversion.Place.store]
Becoming.Optimum.Drain.drained_ends : (Becoming.Diversion.web Becoming.Optimum.Drain.drainedLevel).Broken 0
    Becoming.Diversion.Formation.dweller Becoming.Diversion.Place.source ∧
  ¬(Becoming.Diversion.web Becoming.Optimum.Drain.drainedLevel).active 1 Becoming.Diversion.Formation.dweller ∧
    ¬Becoming.DrawnBeyond.dwellerOn Becoming.Diversion.Place.source = Becoming.Diversion.Formation.taker ∧
      ¬(Becoming.Diversion.web Becoming.Optimum.Drain.drainedLevel).CoupledInto Becoming.Diversion.gauge
          Becoming.Diversion.Formation.taker Becoming.Diversion.Place.source
@Becoming.Optimum.Drain.counted_after_drains : ∀ {o : Becoming.Diversion.Place → Nat},
  Becoming.Requirement.Frontier Becoming.Optimum.Drain.Split Becoming.Optimum.Drain.countedAfter o →
    o Becoming.Diversion.Place.source = 0
Becoming.Optimum.Drain.satisficing_either : ¬Becoming.Optimum.Rising [Becoming.Diversion.Place.store]
      Becoming.Optimum.Drain.satisficing ∧
  Becoming.Requirement.Frontier Becoming.Optimum.Drain.Split Becoming.Optimum.Drain.satisficing
      Becoming.Optimum.Drain.keptLevel ∧
    Becoming.Requirement.Frontier Becoming.Optimum.Drain.Split Becoming.Optimum.Drain.satisficing
        ((Becoming.Diversion.web Becoming.Optimum.Drain.drainedLevel).level 1) ∧
      (Becoming.Diversion.web Becoming.DrawnBeyond.WithinSlack.level).need 0 Becoming.Diversion.Formation.dweller
            Becoming.Diversion.Place.source ≤
          Becoming.Optimum.Drain.keptLevel Becoming.Diversion.Place.source ∧
        (Becoming.Diversion.web Becoming.Optimum.Drain.drainedLevel).level 1 Becoming.Diversion.Place.source <
          (Becoming.Diversion.web Becoming.Optimum.Drain.drainedLevel).need 0 Becoming.Diversion.Formation.dweller
            Becoming.Diversion.Place.source
Becoming.Optimum.Drain.room_needed : Becoming.Requirement.Frontier Becoming.Optimum.Drain.Spilling
    Becoming.Optimum.Drain.storeOrder (Becoming.Optimum.Drain.drainedLevel 0) ∧
  ¬Becoming.Optimum.Least [Becoming.Diversion.Place.source] Becoming.Optimum.Drain.Spilling
      (Becoming.Optimum.Drain.drainedLevel 0)
Becoming.Optimum.Drain.keeping_room : Becoming.Optimum.Room [Becoming.Diversion.Place.store]
  [Becoming.Diversion.Place.source] Becoming.Optimum.Drain.Keeping
Becoming.Optimum.Drain.kept_takes_slack : Becoming.Requirement.Frontier Becoming.Optimum.Drain.Keeping
    Becoming.Optimum.Drain.storeOrder ((Becoming.Diversion.web Becoming.DrawnBeyond.WithinSlack.level).level 1) ∧
  (∀ (c : Becoming.Diversion.Place),
      c ∈ [Becoming.Diversion.Place.source] →
        ¬(Becoming.Diversion.web Becoming.DrawnBeyond.WithinSlack.level).Broken 0 (Becoming.DrawnBeyond.dwellerOn c)
            c) ∧
    (Becoming.Diversion.web Becoming.DrawnBeyond.WithinSlack.level).stock [Becoming.Diversion.Place.store] 1 +
        Becoming.Diversion.diverting.lost ([Becoming.Diversion.Place.store] ++ [Becoming.Diversion.Place.source]) 0 =
      (Becoming.Diversion.web Becoming.DrawnBeyond.WithinSlack.level).stock [Becoming.Diversion.Place.store] 0 +
        (Becoming.Diversion.web Becoming.DrawnBeyond.WithinSlack.level).slack Becoming.DrawnBeyond.dwellerOn
          [Becoming.Diversion.Place.source] 0
