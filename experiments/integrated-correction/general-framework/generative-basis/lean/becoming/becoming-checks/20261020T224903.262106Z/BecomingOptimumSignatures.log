@Becoming.Optimum.Exceeds.total_lt : ∀ {C : Type} {o o' : C → Nat} {ds : List C},
  Becoming.Optimum.Exceeds ds o' o → Becoming.total ds o < Becoming.total ds o'
@Becoming.Optimum.rising_total : ∀ {C : Type} (ds : List C),
  Becoming.Optimum.Rising ds fun o' o => Becoming.total ds o < Becoming.total ds o'
@Becoming.Optimum.Rising.mono : ∀ {C : Type} {ds : List C} {better : (C → Nat) → (C → Nat) → Prop},
  Becoming.Optimum.Rising ds better →
    ∀ {better' : (C → Nat) → (C → Nat) → Prop},
      (∀ (o' o : C → Nat), better o' o → better' o' o) → Becoming.Optimum.Rising ds better'
@Becoming.Optimum.least_iff : ∀ {C : Type} {ds rest : List C} {eligible : (C → Nat) → Prop},
  (∀ (better : (C → Nat) → (C → Nat) → Prop),
      Becoming.Optimum.Rising ds better →
        ∀ (o : C → Nat), Becoming.Requirement.Frontier eligible better o → Becoming.Optimum.Least rest eligible o) ↔
    ∀ (o o' : C → Nat),
      eligible o →
        eligible o' → ∀ (c : C), c ∈ rest → o' c < o c → ¬¬∃ o'', eligible o'' ∧ Becoming.Optimum.Exceeds ds o'' o
@Becoming.Optimum.least_of_room : ∀ {C : Type} {ds rest : List C} {eligible : (C → Nat) → Prop}
  {better : (C → Nat) → (C → Nat) → Prop},
  Becoming.Optimum.Rising ds better →
    Becoming.Optimum.Room ds rest eligible →
      ∀ {o : C → Nat}, Becoming.Requirement.Frontier eligible better o → Becoming.Optimum.Least rest eligible o
@Becoming.Optimum.transfer_exceeds : ∀ {C : Type} {ds : List C} [inst : DecidableEq C] {c d : C},
  ¬c ∈ ds → d ∈ ds → ∀ (o : C → Nat), Becoming.Optimum.Exceeds ds (Becoming.Optimum.transfer c d o) o
@Becoming.Optimum.Shared.room : ∀ {C : Type} {ds rest : List C} {eligible : (C → Nat) → Prop} [inst : DecidableEq C],
  (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
    ∀ {d : C}, d ∈ ds → Becoming.Optimum.Shared ds rest eligible → Becoming.Optimum.Room ds rest eligible
@Becoming.Optimum.least_of_shared : ∀ {C : Type} {ds rest : List C} {eligible : (C → Nat) → Prop}
  {better : (C → Nat) → (C → Nat) → Prop} [inst : DecidableEq C],
  Becoming.Optimum.Rising ds better →
    (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
      ∀ {d : C},
        d ∈ ds →
          Becoming.Optimum.Shared ds rest eligible →
            ∀ {o : C → Nat}, Becoming.Requirement.Frontier eligible better o → Becoming.Optimum.Least rest eligible o
@Becoming.Web.optimum_broken_iff : ∀ {F C : Type} {W : Becoming.Web F C} {ds rest : List C}
  {eligible : (C → Nat) → Prop} {better : (C → Nat) → (C → Nat) → Prop} {dep : C → F} {t : Nat},
  Becoming.Optimum.Rising ds better →
    Becoming.Optimum.Room ds rest eligible →
      Becoming.Requirement.Frontier eligible better (W.level (t + 1)) →
        W.MetOn dep rest t → ∀ {c : C}, c ∈ rest → (W.Broken t (dep c) c ↔ ∃ o, eligible o ∧ o c < W.need t (dep c) c)
@Becoming.Web.optimum_ends_beyond : ∀ {F C : Type} {W : Becoming.Web F C} {ds rest : List C}
  {eligible : (C → Nat) → Prop} {better : (C → Nat) → (C → Nat) → Prop} {dep : C → F} {t : Nat} {obs : F → C → Prop}
  {members : F → Prop},
  Becoming.Optimum.Rising ds better →
    Becoming.Optimum.Room ds rest eligible →
      Becoming.Requirement.Frontier eligible better (W.level (t + 1)) →
        W.MetOn dep rest t →
          W.Dependent →
            (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
              (∀ (h : F) (c : C), members h → W.CoupledInto obs h c → c ∈ ds) →
                ∀ {c : C},
                  c ∈ rest →
                    ∀ {o : C → Nat},
                      eligible o →
                        o c < W.need t (dep c) c →
                          W.requires (t + 1) (dep c) c ∧ W.need t (dep c) c ≤ W.need (t + 1) (dep c) c →
                            W.Broken t (dep c) c ∧
                              ¬W.active (t + 1) (dep c) ∧
                                ¬members (dep c) ∧ ∀ (h : F), members h → ¬W.CoupledInto obs h c
@Becoming.Flow.Balances.family_le_iff : ∀ {F C : Type} {ds rest : List C} {t : Nat} {L L' : Becoming.Flow F C}
  {W W' : Becoming.Web F C},
  L.Balances W →
    L'.Balances W' →
      L.GainlessOn (ds ++ rest) t →
        L'.GainlessOn (ds ++ rest) t →
          W.stock ds t + W.stock rest t = W'.stock ds t + W'.stock rest t →
            (W.stock ds (t + 1) ≤ W'.stock ds (t + 1) ↔
              W'.stock rest (t + 1) + L'.lost (ds ++ rest) t ≤ W.stock rest (t + 1) + L.lost (ds ++ rest) t)
@Becoming.Flow.top_iff_least : ∀ {F C : Type} {ds rest : List C} {t : Nat} {A : Type} {L : A → Becoming.Flow F C}
  {W : A → Becoming.Web F C},
  (∀ (a : A), (L a).Balances (W a)) →
    (∀ (a : A), (L a).GainlessOn (ds ++ rest) t) →
      (∀ (a b : A), (W a).stock ds t + (W a).stock rest t = (W b).stock ds t + (W b).stock rest t) →
        ∀ (a : A),
          (∀ (b : A), (W b).stock ds (t + 1) ≤ (W a).stock ds (t + 1)) ↔
            ∀ (b : A),
              (W a).stock rest (t + 1) + (L a).lost (ds ++ rest) t ≤
                (W b).stock rest (t + 1) + (L b).lost (ds ++ rest) t
@Becoming.Flow.keeping_optimum_takes_slack : ∀ {F C : Type} {ds rest : List C} {t : Nat} {L : Becoming.Flow F C}
  {W : Becoming.Web F C} {eligible : (C → Nat) → Prop} {better : (C → Nat) → (C → Nat) → Prop} {dep : C → F},
  L.Balances W →
    L.GainlessOn (ds ++ rest) t →
      W.MetOn dep rest t →
        Becoming.Optimum.Rising ds better →
          (Becoming.Optimum.Room ds rest fun o => eligible o ∧ ∀ (c : C), c ∈ rest → W.need t (dep c) c ≤ o c) →
            (∀ (c : C),
                c ∈ rest →
                  ∃ o, (eligible o ∧ ∀ (c : C), c ∈ rest → W.need t (dep c) c ≤ o c) ∧ o c ≤ W.need t (dep c) c) →
              Becoming.Requirement.Frontier (fun o => eligible o ∧ ∀ (c : C), c ∈ rest → W.need t (dep c) c ≤ o c)
                  better (W.level (t + 1)) →
                (∀ (c : C), c ∈ rest → ¬W.Broken t (dep c) c) ∧
                  W.stock ds (t + 1) + L.lost (ds ++ rest) t = W.stock ds t + W.slack dep rest t
Becoming.Optimum.Drain.storeOrder_rising : Becoming.Optimum.Rising [Becoming.Diversion.Place.store]
  Becoming.Optimum.Drain.storeOrder
Becoming.Optimum.Drain.split_shared : Becoming.Optimum.Shared [Becoming.Diversion.Place.store]
  [Becoming.Diversion.Place.source] Becoming.Optimum.Drain.Split
Becoming.Optimum.Drain.drained_optimum : Becoming.Requirement.Frontier Becoming.Optimum.Drain.Split
  Becoming.Optimum.Drain.storeOrder ((Becoming.Diversion.web Becoming.Optimum.Drain.drainedLevel).level 1)
Becoming.Optimum.Drain.taker_couples_store : ∀ (level : Nat → Becoming.Diversion.Place → Nat)
  (h : Becoming.Diversion.Formation) (c : Becoming.Diversion.Place),
  h = Becoming.Diversion.Formation.taker →
    (Becoming.Diversion.web level).CoupledInto Becoming.Diversion.gauge h c → c ∈ [Becoming.Diversion.Place.store]
Becoming.Optimum.Drain.drained_ends : (Becoming.Diversion.web Becoming.Optimum.Drain.drainedLevel).Broken 0
    Becoming.Diversion.Formation.dweller Becoming.Diversion.Place.source ∧
  ¬(Becoming.Diversion.web Becoming.Optimum.Drain.drainedLevel).active 1 Becoming.Diversion.Formation.dweller ∧
    ¬Becoming.DrawnBeyond.dwellerOn Becoming.Diversion.Place.source = Becoming.Diversion.Formation.taker ∧
      ¬(Becoming.Diversion.web Becoming.Optimum.Drain.drainedLevel).CoupledInto Becoming.Diversion.gauge
          Becoming.Diversion.Formation.taker Becoming.Diversion.Place.source
@Becoming.Optimum.Drain.counted_after_drains : ∀ {o : Becoming.Diversion.Place → Nat},
  Becoming.Requirement.Frontier Becoming.Optimum.Drain.Split Becoming.Optimum.Drain.countedAfter o →
    o Becoming.Diversion.Place.source = 0
Becoming.Optimum.Drain.satisficing_either : ¬Becoming.Optimum.Rising [Becoming.Diversion.Place.store]
      Becoming.Optimum.Drain.satisficing ∧
  Becoming.Requirement.Frontier Becoming.Optimum.Drain.Split Becoming.Optimum.Drain.satisficing
      Becoming.Optimum.Drain.keptLevel ∧
    Becoming.Requirement.Frontier Becoming.Optimum.Drain.Split Becoming.Optimum.Drain.satisficing
        ((Becoming.Diversion.web Becoming.Optimum.Drain.drainedLevel).level 1) ∧
      (Becoming.Diversion.web Becoming.DrawnBeyond.WithinSlack.level).need 0 Becoming.Diversion.Formation.dweller
            Becoming.Diversion.Place.source ≤
          Becoming.Optimum.Drain.keptLevel Becoming.Diversion.Place.source ∧
        (Becoming.Diversion.web Becoming.Optimum.Drain.drainedLevel).level 1 Becoming.Diversion.Place.source <
          (Becoming.Diversion.web Becoming.Optimum.Drain.drainedLevel).need 0 Becoming.Diversion.Formation.dweller
            Becoming.Diversion.Place.source
Becoming.Optimum.Drain.room_needed : Becoming.Requirement.Frontier Becoming.Optimum.Drain.Spilling
    Becoming.Optimum.Drain.storeOrder (Becoming.Optimum.Drain.drainedLevel 0) ∧
  ¬Becoming.Optimum.Least [Becoming.Diversion.Place.source] Becoming.Optimum.Drain.Spilling
      (Becoming.Optimum.Drain.drainedLevel 0)
Becoming.Optimum.Drain.keeping_room : Becoming.Optimum.Room [Becoming.Diversion.Place.store]
  [Becoming.Diversion.Place.source] Becoming.Optimum.Drain.Keeping
Becoming.Optimum.Drain.kept_takes_slack : Becoming.Requirement.Frontier Becoming.Optimum.Drain.Keeping
    Becoming.Optimum.Drain.storeOrder ((Becoming.Diversion.web Becoming.DrawnBeyond.WithinSlack.level).level 1) ∧
  (∀ (c : Becoming.Diversion.Place),
      c ∈ [Becoming.Diversion.Place.source] →
        ¬(Becoming.Diversion.web Becoming.DrawnBeyond.WithinSlack.level).Broken 0 (Becoming.DrawnBeyond.dwellerOn c)
            c) ∧
    (Becoming.Diversion.web Becoming.DrawnBeyond.WithinSlack.level).stock [Becoming.Diversion.Place.store] 1 +
        Becoming.Diversion.diverting.lost ([Becoming.Diversion.Place.store] ++ [Becoming.Diversion.Place.source]) 0 =
      (Becoming.Diversion.web Becoming.DrawnBeyond.WithinSlack.level).stock [Becoming.Diversion.Place.store] 0 +
        (Becoming.Diversion.web Becoming.DrawnBeyond.WithinSlack.level).slack Becoming.DrawnBeyond.dwellerOn
          [Becoming.Diversion.Place.source] 0
@Becoming.total_raise_at : ∀ {α : Type} {p q : α → Nat} {a : α},
  p a = q a + 1 →
    (∀ (x : α), ¬x = a → p x = q x) →
      ∀ {l : List α}, Becoming.Distinct l → a ∈ l → Becoming.total l p = Becoming.total l q + 1
@Becoming.total_split : ∀ {α : Type} (part : α → Bool) (f : α → Nat) (l : List α),
  Becoming.total l f =
    (Becoming.total l fun a => bif part a then 0 else f a) + Becoming.total l fun a => bif part a then f a else 0
Becoming.sub_lt_self_iff : ∀ (n k : Nat), n - k < n ↔ 0 < k ∧ 0 < n
@Becoming.Flow.Outcome.of_balances : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {W : Becoming.Web F C}
  {cap : F → C → Nat} {cs : List C} {t : Nat},
  L.Balances W → L.ActsWithin part cap cs t L → L.Outcome part (W.level t) cap cs t (W.level (t + 1))
@Becoming.Flow.capacity_eq_zero : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat} {t : Nat}
  {c : C}, (∀ (h : F), h ∈ L.present t → part h = true → cap h c = 0) → L.capacity part cap t c = 0
@Becoming.Flow.ActsWithin.taken_eq : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat}
  {cs : List C} {t : Nat} {L' : Becoming.Flow F C},
  L.ActsWithin part cap cs t L' →
    ∀ (c : C),
      L'.taken t c = L.restTaken part t c + Becoming.total (L.present t) fun h => bif part h then L'.take t h c else 0
@Becoming.Flow.ActsWithin.given_eq : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat}
  {cs : List C} {t : Nat} {L' : Becoming.Flow F C},
  L.ActsWithin part cap cs t L' →
    ∀ (c : C),
      L'.given t c = L.restGiven part t c + Becoming.total (L.present t) fun h => bif part h then L'.give t h c else 0
@Becoming.Flow.ActsWithin.part_taken_le : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat}
  {cs : List C} {t : Nat} {L' : Becoming.Flow F C},
  L.ActsWithin part cap cs t L' →
    ∀ (c : C), (Becoming.total (L.present t) fun h => bif part h then L'.take t h c else 0) ≤ L.capacity part cap t c
@Becoming.Flow.other_of_out : ∀ {F : Type} {part : F → Bool} {h : F}, part h = true → ∀ {g : F}, part g = false → ¬g = h
@Becoming.Flow.moveUnit_take : ∀ {F C : Type} {t : Nat} {L' : Becoming.Flow F C} [inst : DecidableEq F]
  [inst_1 : DecidableEq C] {h : F} {c d : C} (g : F) (x : C),
  (L'.moveUnit t h c d).take t g x = if g = h ∧ x = c then L'.take t g x + 1 else L'.take t g x
@Becoming.Flow.moveUnit_give : ∀ {F C : Type} {t : Nat} {L' : Becoming.Flow F C} [inst : DecidableEq F]
  [inst_1 : DecidableEq C] {h : F} {c d : C} (g : F) (x : C),
  (L'.moveUnit t h c d).give t g x = if g = h ∧ x = d then L'.give t g x + 1 else L'.give t g x
@Becoming.Flow.redirect_give : ∀ {F C : Type} {t : Nat} {L' : Becoming.Flow F C} [inst : DecidableEq F]
  [inst_1 : DecidableEq C] {h : F} {c d : C} (g : F) (x : C),
  (L'.redirect t h c d).give t g x =
    if g = h ∧ x = c then L'.give t g x - 1 else if g = h ∧ x = d then L'.give t g x + 1 else L'.give t g x
@Becoming.Flow.moveUnit_taken_at : ∀ {F C : Type} {t : Nat} {L' : Becoming.Flow F C} [inst : DecidableEq F]
  [inst_1 : DecidableEq C] {h : F} {c d : C},
  Becoming.Distinct (L'.present t) → h ∈ L'.present t → (L'.moveUnit t h c d).taken t c = L'.taken t c + 1
@Becoming.Flow.moveUnit_taken_off : ∀ {F C : Type} {t : Nat} {L' : Becoming.Flow F C} [inst : DecidableEq F]
  [inst_1 : DecidableEq C] {h : F} {c d x : C}, ¬x = c → (L'.moveUnit t h c d).taken t x = L'.taken t x
@Becoming.Flow.moveUnit_given_at : ∀ {F C : Type} {t : Nat} {L' : Becoming.Flow F C} [inst : DecidableEq F]
  [inst_1 : DecidableEq C] {h : F} {c d : C},
  Becoming.Distinct (L'.present t) → h ∈ L'.present t → (L'.moveUnit t h c d).given t d = L'.given t d + 1
@Becoming.Flow.moveUnit_given_off : ∀ {F C : Type} {t : Nat} {L' : Becoming.Flow F C} [inst : DecidableEq F]
  [inst_1 : DecidableEq C] {h : F} {c d x : C}, ¬x = d → (L'.moveUnit t h c d).given t x = L'.given t x
@Becoming.Flow.redirect_given_at : ∀ {F C : Type} {t : Nat} {L' : Becoming.Flow F C} [inst : DecidableEq F]
  [inst_1 : DecidableEq C] {h : F} {c d : C},
  Becoming.Distinct (L'.present t) →
    h ∈ L'.present t → 0 < L'.give t h c → (L'.redirect t h c d).given t c + 1 = L'.given t c
@Becoming.Flow.redirect_given_to : ∀ {F C : Type} {t : Nat} {L' : Becoming.Flow F C} [inst : DecidableEq F]
  [inst_1 : DecidableEq C] {h : F} {c d : C},
  Becoming.Distinct (L'.present t) → h ∈ L'.present t → ¬c = d → (L'.redirect t h c d).given t d = L'.given t d + 1
@Becoming.Flow.redirect_given_off : ∀ {F C : Type} {t : Nat} {L' : Becoming.Flow F C} [inst : DecidableEq F]
  [inst_1 : DecidableEq C] {h : F} {c d x : C}, ¬x = c → ¬x = d → (L'.redirect t h c d).given t x = L'.given t x
@Becoming.Flow.moveUnit_balances : ∀ {F C : Type} {t : Nat} {L' : Becoming.Flow F C} [inst : DecidableEq F]
  [inst_1 : DecidableEq C] {h : F} {c d : C} {l o : C → Nat},
  Becoming.Distinct (L'.present t) →
    h ∈ L'.present t →
      ¬c = d →
        0 < o c →
          (∀ (x : C), o x + L'.taken t x = l x + L'.given t x) →
            ∀ (x : C),
              Becoming.Optimum.transfer c d o x + (L'.moveUnit t h c d).taken t x =
                l x + (L'.moveUnit t h c d).given t x
@Becoming.Flow.redirect_balances : ∀ {F C : Type} {t : Nat} {L' : Becoming.Flow F C} [inst : DecidableEq F]
  [inst_1 : DecidableEq C] {h : F} {c d : C} {l o : C → Nat},
  Becoming.Distinct (L'.present t) →
    h ∈ L'.present t →
      ¬c = d →
        0 < o c →
          0 < L'.give t h c →
            (∀ (x : C), o x + L'.taken t x = l x + L'.given t x) →
              ∀ (x : C),
                Becoming.Optimum.transfer c d o x + (L'.redirect t h c d).taken t x =
                  l x + (L'.redirect t h c d).given t x
@Becoming.Flow.ActsWithin.moveUnit : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat}
  {cs : List C} {t : Nat} {L' : Becoming.Flow F C} [inst : DecidableEq F] [inst_1 : DecidableEq C] {h : F} {c d : C},
  L.ActsWithin part cap cs t L' →
    part h = true →
      L'.take t h c < cap h c →
        Becoming.Distinct cs → c ∈ cs → d ∈ cs → L.ActsWithin part cap cs t (L'.moveUnit t h c d)
@Becoming.Flow.ActsWithin.redirect : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat}
  {cs : List C} {t : Nat} {L' : Becoming.Flow F C} [inst : DecidableEq F] [inst_1 : DecidableEq C] {h : F} {c d : C},
  L.ActsWithin part cap cs t L' →
    part h = true →
      Becoming.Distinct cs →
        c ∈ cs → d ∈ cs → ¬c = d → 0 < L'.give t h c → L.ActsWithin part cap cs t (L'.redirect t h c d)
@Becoming.Optimum.transfer_above : ∀ {C : Type} {ds rest : List C} [inst : DecidableEq C] {floor o : C → Nat} {c d : C},
  (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
    d ∈ ds →
      floor c < o c →
        (∀ (x : C), x ∈ rest → floor x ≤ o x) → ∀ (x : C), x ∈ rest → floor x ≤ Becoming.Optimum.transfer c d o x
@Becoming.Optimum.Above.transfer : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat}
  {t : Nat} {l : C → Nat} {ds rest : List C} [DecidableEq F] [inst : DecidableEq C] {floor o : C → Nat}
  {L' : Becoming.Flow F C},
  Becoming.Distinct (L.present t) →
    Becoming.Distinct (ds ++ rest) →
      (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
        ∀ {c d : C},
          c ∈ rest →
            d ∈ ds →
              L.ActsWithin part cap (ds ++ rest) t L' →
                (∀ (x : C), o x + L'.taken t x = l x + L'.given t x) →
                  (∀ (x : C), x ∈ rest → floor x ≤ o x) →
                    floor c < o c →
                      ∀ {h : F},
                        h ∈ L.present t →
                          part h = true →
                            L'.take t h c < cap h c ∨ 0 < L'.give t h c →
                              Becoming.Optimum.Above L part l cap ds rest t floor (Becoming.Optimum.transfer c d o)
@Becoming.Optimum.member_below : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat} {t : Nat}
  {L₁ L₂ : Becoming.Flow F C} {cs : List C},
  L.ActsWithin part cap cs t L₁ →
    L.ActsWithin part cap cs t L₂ →
      ∀ {q₁ q₂ : F → Nat},
        Becoming.total (L₁.present t) q₁ < Becoming.total (L₂.present t) q₂ →
          (∀ (g : F), part g = false → q₁ g = q₂ g) → ∃ g, g ∈ L.present t ∧ part g = true ∧ q₁ g < q₂ g
@Becoming.Optimum.Above.room : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat} {t : Nat}
  {l : C → Nat} {ds rest : List C} [DecidableEq F] [DecidableEq C],
  Becoming.Distinct (L.present t) →
    Becoming.Distinct (ds ++ rest) →
      (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
        ∀ {d : C},
          d ∈ ds →
            ∀ (floor : C → Nat), Becoming.Optimum.Room ds rest (Becoming.Optimum.Above L part l cap ds rest t floor)
@Becoming.Optimum.Above.full : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat} {t : Nat}
  {l : C → Nat} {ds rest : List C} {better : (C → Nat) → (C → Nat) → Prop} [DecidableEq F] [DecidableEq C]
  {floor o : C → Nat} {L' : Becoming.Flow F C},
  Becoming.Distinct (L.present t) →
    Becoming.Distinct (ds ++ rest) →
      (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
        ∀ {d : C},
          d ∈ ds →
            Becoming.Optimum.Rising ds better →
              Becoming.Requirement.Frontier (Becoming.Optimum.Above L part l cap ds rest t floor) better o →
                L.ActsWithin part cap (ds ++ rest) t L' →
                  (∀ (x : C), o x + L'.taken t x = l x + L'.given t x) →
                    ∀ {c : C},
                      c ∈ rest →
                        floor c < o c →
                          ∀ {h : F}, h ∈ L.present t → part h = true → L'.take t h c = cap h c ∧ L'.give t h c = 0
@Becoming.Optimum.Above.floor_or_full : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat}
  {t : Nat} {l : C → Nat} {ds rest : List C} {better : (C → Nat) → (C → Nat) → Prop} [DecidableEq F] [DecidableEq C]
  {floor o : C → Nat},
  Becoming.Distinct (L.present t) →
    Becoming.Distinct (ds ++ rest) →
      (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
        ∀ {d : C},
          d ∈ ds →
            Becoming.Optimum.Rising ds better →
              Becoming.Requirement.Frontier (Becoming.Optimum.Above L part l cap ds rest t floor) better o →
                ∀ {c : C},
                  c ∈ rest →
                    o c = floor c ∨ o c + L.restTaken part t c + L.capacity part cap t c = l c + L.restGiven part t c
@Becoming.Optimum.above_nothing : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat} {t : Nat}
  {l : C → Nat} {ds rest : List C} {better : (C → Nat) → (C → Nat) → Prop} {o : C → Nat},
  Becoming.Requirement.Frontier (L.Outcome part l cap (ds ++ rest) t) better o →
    Becoming.Requirement.Frontier (Becoming.Optimum.Above L part l cap ds rest t fun x => 0) better o
@Becoming.Optimum.optimum_beyond : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat}
  {t : Nat} {l : C → Nat} {ds rest : List C} {better : (C → Nat) → (C → Nat) → Prop} [DecidableEq F] [DecidableEq C],
  Becoming.Distinct (L.present t) →
    Becoming.Distinct (ds ++ rest) →
      (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
        ∀ {d : C},
          d ∈ ds →
            Becoming.Optimum.Rising ds better →
              ∀ {o : C → Nat},
                Becoming.Requirement.Frontier (L.Outcome part l cap (ds ++ rest) t) better o →
                  ∀ {c : C},
                    c ∈ rest → o c = l c + L.restGiven part t c - L.restTaken part t c - L.capacity part cap t c
@Becoming.Optimum.optimum_untouched : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat}
  {t : Nat} {l : C → Nat} {ds rest : List C} {better : (C → Nat) → (C → Nat) → Prop} [DecidableEq F] [DecidableEq C],
  Becoming.Distinct (L.present t) →
    Becoming.Distinct (ds ++ rest) →
      (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
        ∀ {d : C},
          d ∈ ds →
            Becoming.Optimum.Rising ds better →
              ∀ {o : C → Nat},
                Becoming.Requirement.Frontier (L.Outcome part l cap (ds ++ rest) t) better o →
                  ∀ {c : C},
                    c ∈ rest →
                      (∀ (h : F), h ∈ L.present t → part h = true → cap h c = 0) →
                        o c = l c + L.restGiven part t c - L.restTaken part t c
@Becoming.Optimum.optimum_lowers_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat}
  {t : Nat} {l : C → Nat} {ds rest : List C} {better : (C → Nat) → (C → Nat) → Prop} [DecidableEq F] [DecidableEq C],
  Becoming.Distinct (L.present t) →
    Becoming.Distinct (ds ++ rest) →
      (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
        ∀ {d : C},
          d ∈ ds →
            Becoming.Optimum.Rising ds better →
              ∀ {o : C → Nat},
                Becoming.Requirement.Frontier (L.Outcome part l cap (ds ++ rest) t) better o →
                  ∀ {c : C},
                    c ∈ rest →
                      (o c < l c + L.restGiven part t c - L.restTaken part t c ↔
                        0 < L.capacity part cap t c ∧ 0 < l c + L.restGiven part t c - L.restTaken part t c)
@Becoming.Web.optimum_broken_iff_capacity : ∀ {F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {cap : F → C → Nat}
  {t : Nat} {ds rest : List C} {better : (C → Nat) → (C → Nat) → Prop} [DecidableEq F] [DecidableEq C]
  {W : Becoming.Web F C} {dep : C → F},
  Becoming.Distinct (L.present t) →
    Becoming.Distinct (ds ++ rest) →
      (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
        ∀ {d : C},
          d ∈ ds →
            Becoming.Optimum.Rising ds better →
              Becoming.Requirement.Frontier (L.Outcome part (W.level t) cap (ds ++ rest) t) better (W.level (t + 1)) →
                W.MetOn dep rest t →
                  ∀ {c : C},
                    c ∈ rest →
                      (W.Broken t (dep c) c ↔
                        W.level t c + L.restGiven part t c - L.restTaken part t c - L.capacity part cap t c <
                          W.need t (dep c) c)
