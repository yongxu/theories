@Becoming.Optimum.alone_self : ∀ {F : Type} [inst : DecidableEq F] (h : F), Becoming.Optimum.alone h h = true
@Becoming.Optimum.MutualBest.full : ∀ {F C : Type} {L : Becoming.Flow F C} {optimizer : F → Bool} {l : C → Nat}
  {cap : F → C → Nat} {ds rest : F → List C} {better : F → (C → Nat) → (C → Nat) → Prop} {t : Nat} {o : C → Nat}
  [inst : DecidableEq F] [DecidableEq C],
  Becoming.Distinct (L.present t) →
    (∀ (h : F), optimizer h = true → Becoming.Distinct (ds h ++ rest h)) →
      (∀ (h : F), optimizer h = true → ∀ (c : C), c ∈ rest h → ¬c ∈ ds h) →
        (∀ (h : F), optimizer h = true → ∃ d, d ∈ ds h) →
          (∀ (h : F), optimizer h = true → Becoming.Optimum.Rising (ds h) (better h)) →
            Becoming.Optimum.MutualBest L optimizer l cap ds rest better t o →
              (∀ (x : C), o x + L.taken t x = l x + L.given t x) →
                ∀ {h : F},
                  h ∈ L.present t →
                    optimizer h = true → ∀ {c : C}, c ∈ rest h → 0 < o c → L.take t h c = cap h c ∧ L.give t h c = 0
@Becoming.Optimum.mutual_beyond : ∀ {F C : Type} {L : Becoming.Flow F C} {optimizer : F → Bool} {l : C → Nat}
  {cap : F → C → Nat} {ds rest : F → List C} {better : F → (C → Nat) → (C → Nat) → Prop} {t : Nat} {o : C → Nat}
  [inst : DecidableEq F] [DecidableEq C],
  Becoming.Distinct (L.present t) →
    (∀ (h : F), optimizer h = true → Becoming.Distinct (ds h ++ rest h)) →
      (∀ (h : F), optimizer h = true → ∀ (c : C), c ∈ rest h → ¬c ∈ ds h) →
        (∀ (h : F), optimizer h = true → ∃ d, d ∈ ds h) →
          (∀ (h : F), optimizer h = true → Becoming.Optimum.Rising (ds h) (better h)) →
            Becoming.Optimum.MutualBest L optimizer l cap ds rest better t o →
              (∀ (x : C), o x + L.taken t x = l x + L.given t x) →
                ∀ {c : C},
                  (∀ (h : F), h ∈ L.present t → optimizer h = true → c ∈ rest h) →
                    o c = l c + L.restGiven optimizer t c - L.restTaken optimizer t c - L.capacity optimizer cap t c
@Becoming.Optimum.mutual_as_one : ∀ {F C : Type} {L : Becoming.Flow F C} {optimizer : F → Bool} {l : C → Nat}
  {cap : F → C → Nat} {ds rest : F → List C} {better : F → (C → Nat) → (C → Nat) → Prop} {t : Nat} {o : C → Nat}
  [inst : DecidableEq F] [DecidableEq C],
  Becoming.Distinct (L.present t) →
    (∀ (h : F), optimizer h = true → Becoming.Distinct (ds h ++ rest h)) →
      (∀ (h : F), optimizer h = true → ∀ (c : C), c ∈ rest h → ¬c ∈ ds h) →
        (∀ (h : F), optimizer h = true → ∃ d, d ∈ ds h) →
          (∀ (h : F), optimizer h = true → Becoming.Optimum.Rising (ds h) (better h)) →
            Becoming.Optimum.MutualBest L optimizer l cap ds rest better t o →
              (∀ (x : C), o x + L.taken t x = l x + L.given t x) →
                ∀ {c : C},
                  (∀ (h : F), h ∈ L.present t → optimizer h = true → c ∈ rest h) →
                    ∀ {dsJ restJ : List C},
                      Becoming.Distinct (dsJ ++ restJ) →
                        (∀ (c : C), c ∈ restJ → ¬c ∈ dsJ) →
                          ∀ {dJ : C},
                            dJ ∈ dsJ →
                              ∀ {betterJ : (C → Nat) → (C → Nat) → Prop},
                                Becoming.Optimum.Rising dsJ betterJ →
                                  ∀ {o' : C → Nat},
                                    Becoming.Requirement.Frontier (L.Outcome optimizer l cap (dsJ ++ restJ) t) betterJ
                                        o' →
                                      c ∈ restJ → o c = o' c
@Becoming.Optimum.mutual_lowers_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {optimizer : F → Bool} {l : C → Nat}
  {cap : F → C → Nat} {ds rest : F → List C} {better : F → (C → Nat) → (C → Nat) → Prop} {t : Nat} {o : C → Nat}
  [inst : DecidableEq F] [DecidableEq C],
  Becoming.Distinct (L.present t) →
    (∀ (h : F), optimizer h = true → Becoming.Distinct (ds h ++ rest h)) →
      (∀ (h : F), optimizer h = true → ∀ (c : C), c ∈ rest h → ¬c ∈ ds h) →
        (∀ (h : F), optimizer h = true → ∃ d, d ∈ ds h) →
          (∀ (h : F), optimizer h = true → Becoming.Optimum.Rising (ds h) (better h)) →
            Becoming.Optimum.MutualBest L optimizer l cap ds rest better t o →
              (∀ (x : C), o x + L.taken t x = l x + L.given t x) →
                ∀ {c : C},
                  (∀ (h : F), h ∈ L.present t → optimizer h = true → c ∈ rest h) →
                    (o c < l c + L.restGiven optimizer t c - L.restTaken optimizer t c ↔
                      0 < L.capacity optimizer cap t c ∧
                        0 < l c + L.restGiven optimizer t c - L.restTaken optimizer t c)
@Becoming.Web.mutual_broken_iff_capacity : ∀ {F C : Type} [inst : DecidableEq F] [DecidableEq C] {W : Becoming.Web F C}
  {L : Becoming.Flow F C} {optimizer : F → Bool} {cap : F → C → Nat} {ds rest : F → List C}
  {better : F → (C → Nat) → (C → Nat) → Prop} {t : Nat} {g : F} {c : C},
  Becoming.Distinct (L.present t) →
    (∀ (h : F), optimizer h = true → Becoming.Distinct (ds h ++ rest h)) →
      (∀ (h : F), optimizer h = true → ∀ (c : C), c ∈ rest h → ¬c ∈ ds h) →
        (∀ (h : F), optimizer h = true → ∃ d, d ∈ ds h) →
          (∀ (h : F), optimizer h = true → Becoming.Optimum.Rising (ds h) (better h)) →
            Becoming.Optimum.MutualBest L optimizer (W.level t) cap ds rest better t (W.level (t + 1)) →
              (∀ (x : C), W.level (t + 1) x + L.taken t x = W.level t x + L.given t x) →
                (∀ (h : F), h ∈ L.present t → optimizer h = true → c ∈ rest h) →
                  W.requires t g c →
                    W.need t g c ≤ W.level t c →
                      (W.Broken t g c ↔
                        W.level t c + L.restGiven optimizer t c - L.restTaken optimizer t c -
                            L.capacity optimizer cap t c <
                          W.need t g c)
