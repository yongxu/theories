        (∀ (h : F), optimizer h = true → ∃ d, d ∈ ds h) →
          (∀ (h : F), optimizer h = true → Becoming.Optimum.Rising (ds h) (better h)) →
            Becoming.Optimum.MutualBest L optimizer (W.level t) cap ds rest better t (W.level (t + 1)) →
