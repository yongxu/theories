    (∀ (h : F), optimizer h = true → Becoming.Distinct (dsOf h ++ restOf h)) →
      (∀ (h : F), optimizer h = true → ∀ (c : C), c ∈ restOf h → ¬c ∈ dsOf h) →
        (∀ (h : F), optimizer h = true → ∃ e, e ∈ dsOf h) →
