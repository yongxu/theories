@Becoming.Optimum.course_beyond : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {part : F → Bool}
  {cap : F → C → Nat} {ds rest : List C} {better : (C → Nat) → (C → Nat) → Prop} [DecidableEq F] [DecidableEq C],
  (∀ (t : Nat), Becoming.Distinct (L.present t)) →
    Becoming.Distinct (ds ++ rest) →
      (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
        ∀ {e : C},
          e ∈ ds →
            Becoming.Optimum.Rising ds better →
              Becoming.Optimum.Reoptimizes L W part cap ds rest better →
                ∀ {c : C},
                  c ∈ rest →
