@Becoming.Web.mutual_broken_iff_capacity : ∀ {F C : Type} [inst : DecidableEq F] [DecidableEq C] {W : Becoming.Web F C}
  {L : Becoming.Flow F C} {optimizer : F → Bool} {cap : F → C → Nat} {ds rest : F → List C}
  {better : F → (C → Nat) → (C → Nat) → Prop} {t : Nat} {g : F} {c : C},
