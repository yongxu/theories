            (∀ (t : Nat), x' (t + 1) = x' t + g' t - d' t) →
              (∀ (t : Nat), m ≤ x' t → g' t = r) →
                (∀ (t : Nat), d' t = r) →
                  m ≤ x' 0 →
                    ∀ {n : Nat},
                      x 0 + r * x 0 < r * n →
                        Becoming.Amounts.whole.sum (Becoming.Optimum.drawnAt x g) 0 n <
                          Becoming.Amounts.whole.sum (Becoming.Optimum.drawnAt x' g') 0 n
