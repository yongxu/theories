@Becoming.Optimum.Renewing.joint_store_eq_sum : ∀ {r s₀ : Nat} (n : Nat),
  Becoming.Optimum.Renewing.jointStore r s₀ n =
    Becoming.Amounts.whole.sum
      (Becoming.Optimum.drawnAt (Becoming.Optimum.Renewing.jointSource r s₀) fun t =>
        Becoming.Optimum.Renewing.renewal r (Becoming.Optimum.Renewing.jointSource r s₀ t))
      0 n
@Becoming.Optimum.Renewing.joint_store_bounded : ∀ {r s₀ : Nat},
  r < 2 → ∀ (n : Nat), Becoming.Optimum.Renewing.jointStore r s₀ n ≤ s₀ + r * s₀
@Becoming.Optimum.Renewing.restrained_course_balances : ∀ {s₀ : Nat},
  2 ≤ s₀ →
    (Becoming.Optimum.Renewing.restrainedCourse s₀).Balances
      (Becoming.Optimum.Renewing.jointWeb (Becoming.Optimum.Renewing.restrainedLevel s₀))
@Becoming.Optimum.Renewing.restrained_course_not_best : ∀ {s₀ : Nat},
  2 ≤ s₀ →
    ∀ (t : Nat),
      ¬Becoming.Optimum.MutualBest (Becoming.Optimum.Renewing.restrainedCourse s₀) Becoming.Optimum.TwoTakers.takers
          (Becoming.Optimum.Renewing.restrainedLevel s₀ t) Becoming.Optimum.TwoTakers.capOf
          (fun x => [Becoming.Diversion.Place.store]) (fun x => [Becoming.Diversion.Place.source])
          (fun x => Becoming.Optimum.Drain.storeOrder) t (Becoming.Optimum.Renewing.restrainedLevel s₀ (t + 1))
@Becoming.Optimum.Renewing.restraint_holds_more : ∀ {s₀ n : Nat},
  s₀ + s₀ < n →
    (Becoming.Optimum.Renewing.jointWeb (Becoming.Optimum.Renewing.jointLevel 1 s₀)).level n
        Becoming.Diversion.Place.store <
      (Becoming.Optimum.Renewing.jointWeb (Becoming.Optimum.Renewing.restrainedLevel s₀)).level n
        Becoming.Diversion.Place.store
