  {cap : F → C → Nat} {ds rest : F → List C} {better : F → (C → Nat) → (C → Nat) → Prop} {t : Nat} {o : C → Nat}
  [inst : DecidableEq F] [DecidableEq C],
  Becoming.Distinct (L.present t) →
    (∀ (h : F), optimizer h = true → Becoming.Distinct (ds h ++ rest h)) →
      (∀ (h : F), optimizer h = true → ∀ (c : C), c ∈ rest h → ¬c ∈ ds h) →
        (∀ (h : F), optimizer h = true → ∃ d, d ∈ ds h) →
          (∀ (h : F), optimizer h = true → Becoming.Optimum.Rising (ds h) (better h)) →
            Becoming.Optimum.MutualBest L optimizer l cap ds rest better t o →
              (∀ (x : C), o x + L.taken t x = l x + L.given t x) →
                ∀ {c : C},
                  (∀ (h : F), h ∈ L.present t → optimizer h = true → c ∈ rest h) →
                    o c = l c + L.restGiven optimizer t c - L.restTaken optimizer t c - L.capacity optimizer cap t c
