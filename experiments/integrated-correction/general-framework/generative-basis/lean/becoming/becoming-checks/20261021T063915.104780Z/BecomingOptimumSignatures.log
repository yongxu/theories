@Becoming.Optimum.outpaced_above : ∀ {w R : Nat → Nat} {n : Nat},
  (∀ (t : Nat), t < n → ∀ (z : Nat), 0 < z → w (t + 1) * (z + R z) < w t * z) →
    ∀ (t : Nat), t < n → ∀ (z : Nat), 1 ≤ z → w (t + 1) * (z + R z) + w t * 0 < w (t + 1) * (0 + R 0) + w t * z
@Becoming.Optimum.exhausting_frontier : ∀ {w R : Nat → Nat} {k s n : Nat},
  (∀ (t : Nat), t < n → ∀ (z : Nat), 0 < z → w (t + 1) * (z + R z) ≤ w t * z) →
    s + R s ≤ k →
      R 0 ≤ k →
        0 < n →
          Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse R k s)
            (fun b a => Becoming.Optimum.weightedOver w R a (n + 1) < Becoming.Optimum.weightedOver w R b (n + 1))
            (Becoming.Optimum.holding s 0 n)
@Becoming.Optimum.frontier_exhausts : ∀ {w R : Nat → Nat} {k s n : Nat} {better : (Nat → Nat) → (Nat → Nat) → Prop},
  (∀ (a b : Nat → Nat),
      Becoming.Optimum.weightedOver w R a (n + 1) < Becoming.Optimum.weightedOver w R b (n + 1) → better b a) →
    (∀ (t : Nat), t < n → ∀ (z : Nat), 0 < z → w (t + 1) * (z + R z) < w t * z) →
      s + R s ≤ k →
        R 0 ≤ k →
          0 < n →
            ∀ {x : Nat → Nat},
              Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse R k s) better x →
                ∀ (t : Nat), t < n → x (t + 1) = 0
@Becoming.Optimum.ended_outdrawn : ∀ {w R : Nat → Nat} {s y n : Nat} {x : Nat → Nat},
  (∀ (t : Nat), x (t + 1) ≤ x t + R (x t)) →
    x 0 = s →
      (∀ (t : Nat), t < n → x (t + 1) = 0) →
        y ≤ s + R s →
          (∀ (t : Nat), t < n → w (t + 1) * (0 + R 0) + w t * y < w (t + 1) * (y + R y)) →
            0 < n →
              Becoming.Optimum.weightedOver w R x (n + 1) <
                Becoming.Optimum.weightedOver w R (Becoming.Optimum.holding s y n) (n + 1)
@Becoming.Optimum.stays_empty : ∀ {R x : Nat → Nat},
  (∀ (t : Nat), x (t + 1) ≤ x t + R (x t)) → R 0 = 0 → x 1 = 0 → ∀ (t : Nat), x (t + 1) = 0
@Becoming.Optimum.frontier_leaves : ∀ {w R : Nat → Nat} {k s y n : Nat} {better : (Nat → Nat) → (Nat → Nat) → Prop},
  (∀ (a b : Nat → Nat),
      Becoming.Optimum.weightedOver w R a (n + 1) < Becoming.Optimum.weightedOver w R b (n + 1) → better b a) →
    R 0 = 0 →
      (∀ (t : Nat), t < n → w t * y < w (t + 1) * (y + R y)) →
        y ≤ s + R s →
          s + R s ≤ y + k →
            y + R y ≤ k →
              0 < n →
                ∀ {x : Nat → Nat}, Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse R k s) better x → 0 < x 1
@Becoming.Web.frontier_broken_weighted : ∀ {F C : Type} {W : Becoming.Web F C} {c : C} {f : F} {w R : Nat → Nat}
  {k s m n : Nat} {better : (Nat → Nat) → (Nat → Nat) → Prop},
  (∀ (a b : Nat → Nat),
      Becoming.Optimum.weightedOver w R a (n + 1) < Becoming.Optimum.weightedOver w R b (n + 1) → better b a) →
    ∀ {h : Nat → Nat},
      Becoming.Optimum.OpenCourse R k s h →
        h (n + 1) = 0 →
          (∀ (t : Nat),
              t < n →
                ∀ (z : Nat),
                  w (t + 1) * (z + R z) + w t * h (t + 1) ≤ w (t + 1) * (h (t + 1) + R (h (t + 1))) + w t * z) →
            (∀ (t : Nat),
                t < n →
                  ∀ (z : Nat),
                    m ≤ z →
                      w (t + 1) * (z + R z) + w t * h (t + 1) < w (t + 1) * (h (t + 1) + R (h (t + 1))) + w t * z) →
              0 < n →
                (Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse R k s) better fun t => W.level t c) →
                  W.requires 0 f c → W.need 0 f c ≤ W.level 0 c → m ≤ W.need 0 f c → W.Broken 0 f c
@Becoming.Web.frontier_exhausts : ∀ {F C : Type} {W : Becoming.Web F C} {c : C} {f : F} {w R : Nat → Nat} {k s n : Nat}
  {better : (Nat → Nat) → (Nat → Nat) → Prop},
  (∀ (a b : Nat → Nat),
      Becoming.Optimum.weightedOver w R a (n + 1) < Becoming.Optimum.weightedOver w R b (n + 1) → better b a) →
    (∀ (t : Nat), t < n → ∀ (z : Nat), 0 < z → w (t + 1) * (z + R z) < w t * z) →
      s + R s ≤ k →
        R 0 ≤ k →
          0 < n →
            (Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse R k s) better fun t => W.level t c) →
              W.requires 0 f c →
                W.need 0 f c ≤ W.level 0 c →
                  0 < W.need 0 f c → W.Broken 0 f c ∧ ∀ (t : Nat), t < n → W.level (t + 1) c = 0
@Becoming.Web.frontier_leaves : ∀ {F C : Type} {W : Becoming.Web F C} {c : C} {w R : Nat → Nat} {k s y n : Nat}
  {better : (Nat → Nat) → (Nat → Nat) → Prop},
  (∀ (a b : Nat → Nat),
      Becoming.Optimum.weightedOver w R a (n + 1) < Becoming.Optimum.weightedOver w R b (n + 1) → better b a) →
    R 0 = 0 →
      (∀ (t : Nat), t < n → w t * y < w (t + 1) * (y + R y)) →
        y ≤ s + R s →
          s + R s ≤ y + k →
            y + R y ≤ k →
              0 < n →
                (Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse R k s) better fun t => W.level t c) →
                  0 < W.level 1 c
Becoming.Optimum.Holding.logistic_le_self : ∀ (z : Nat), Becoming.Optimum.Holding.logistic z ≤ z
@Becoming.Optimum.Holding.logistic_outpaced_le : ∀ {a b : Nat},
  2 * b ≤ a → ∀ (z : Nat), 0 < z → b * (z + Becoming.Optimum.Holding.logistic z) ≤ a * z
@Becoming.Optimum.Holding.logistic_outpaced : ∀ {a b : Nat},
  2 * b < a → ∀ (z : Nat), 0 < z → b * (z + Becoming.Optimum.Holding.logistic z) < a * z
@Becoming.Optimum.Holding.logistic_beyond_gain : ∀ {a b : Nat},
  b ≤ a →
    ∀ (z : Nat),
      b * (z + 2 + Becoming.Optimum.Holding.logistic (z + 2)) + a * 1 + a ≤
        b * (1 + Becoming.Optimum.Holding.logistic 1) + a * (z + 2)
@Becoming.Optimum.Holding.logistic_gain_le : ∀ {a b : Nat},
  b ≤ a →
    a ≤ 2 * b →
      ∀ (z : Nat),
        b * (z + Becoming.Optimum.Holding.logistic z) + a * 1 ≤ b * (1 + Becoming.Optimum.Holding.logistic 1) + a * z
@Becoming.Optimum.Holding.logistic_gain_lt : ∀ {a b : Nat},
  b ≤ a →
    0 < b →
      ∀ (z : Nat),
        2 ≤ z →
          b * (z + Becoming.Optimum.Holding.logistic z) + a * 1 < b * (1 + Becoming.Optimum.Holding.logistic 1) + a * z
@Becoming.Optimum.Holding.logistic_gain_zero : ∀ {a b : Nat},
  a < 2 * b →
    b * (0 + Becoming.Optimum.Holding.logistic 0) + a * 1 < b * (1 + Becoming.Optimum.Holding.logistic 1) + a * 0
@Becoming.Optimum.Holding.pos_of_lt_two_mul : ∀ {a b : Nat}, a < 2 * b → 0 < b
Becoming.Optimum.Holding.logistic_weighted : ∀ (n : Nat) (w : Nat → Nat),
  ((∀ (t : Nat), t < n + 1 → 2 * w (t + 1) < w t) →
      Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse Becoming.Optimum.Holding.logistic 2 2)
          (fun b a =>
            Becoming.Optimum.weightedOver w Becoming.Optimum.Holding.logistic a (n + 1 + 1) <
              Becoming.Optimum.weightedOver w Becoming.Optimum.Holding.logistic b (n + 1 + 1))
          (Becoming.Optimum.holding 2 0 (n + 1)) ∧
        ∀ (x : Nat → Nat),
          Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse Becoming.Optimum.Holding.logistic 2 2)
              (fun b a =>
                Becoming.Optimum.weightedOver w Becoming.Optimum.Holding.logistic a (n + 1 + 1) <
                  Becoming.Optimum.weightedOver w Becoming.Optimum.Holding.logistic b (n + 1 + 1))
              x →
            (Becoming.Diversion.web (Becoming.Optimum.Holding.onSource x)).Broken 0 Becoming.Diversion.Formation.dweller
                Becoming.Diversion.Place.source ∧
              ∀ (t : Nat),
                t < n + 1 →
                  (Becoming.Diversion.web (Becoming.Optimum.Holding.onSource x)).level (t + 1)
                      Becoming.Diversion.Place.source =
                    0) ∧
    ((∀ (t : Nat), t < n + 1 → w t = 2 * w (t + 1)) →
        Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse Becoming.Optimum.Holding.logistic 2 2)
            (fun b a =>
              Becoming.Optimum.weightedOver w Becoming.Optimum.Holding.logistic a (n + 1 + 1) <
                Becoming.Optimum.weightedOver w Becoming.Optimum.Holding.logistic b (n + 1 + 1))
            (Becoming.Optimum.holding 2 0 (n + 1)) ∧
          Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse Becoming.Optimum.Holding.logistic 2 2)
            (fun b a =>
              Becoming.Optimum.weightedOver w Becoming.Optimum.Holding.logistic a (n + 1 + 1) <
                Becoming.Optimum.weightedOver w Becoming.Optimum.Holding.logistic b (n + 1 + 1))
            (Becoming.Optimum.holding 2 1 (n + 1))) ∧
      ((∀ (t : Nat), t < n + 1 → w (t + 1) ≤ w t ∧ w t < 2 * w (t + 1)) →
        Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse Becoming.Optimum.Holding.logistic 2 2)
            (fun b a =>
              Becoming.Optimum.weightedOver w Becoming.Optimum.Holding.logistic a (n + 1 + 1) <
                Becoming.Optimum.weightedOver w Becoming.Optimum.Holding.logistic b (n + 1 + 1))
            (Becoming.Optimum.holding 2 1 (n + 1)) ∧
          ∀ (x : Nat → Nat),
            Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse Becoming.Optimum.Holding.logistic 2 2)
                (fun b a =>
                  Becoming.Optimum.weightedOver w Becoming.Optimum.Holding.logistic a (n + 1 + 1) <
                    Becoming.Optimum.weightedOver w Becoming.Optimum.Holding.logistic b (n + 1 + 1))
                x →
              (Becoming.Diversion.web (Becoming.Optimum.Holding.onSource x)).Broken 0
                  Becoming.Diversion.Formation.dweller Becoming.Diversion.Place.source ∧
                ∀ (t : Nat),
                  t < n + 1 →
                    (Becoming.Diversion.web (Becoming.Optimum.Holding.onSource x)).level (t + 1)
                        Becoming.Diversion.Place.source =
                      1)
