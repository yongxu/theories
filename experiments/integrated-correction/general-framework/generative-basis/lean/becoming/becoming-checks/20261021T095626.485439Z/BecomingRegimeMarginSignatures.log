@Becoming.RegimeMargin.Adjusted.fixed_iff : ∀ {A : Nat → Nat → Nat} {g : Nat → Nat} {H : Nat} {p : Nat × Nat},
  Becoming.RegimeMargin.Adjusted.RestsAtDraw A g H →
    (Becoming.RegimeMargin.Adjusted.step A H p = p ↔ Becoming.RegimeMargin.Adjusted.AtRest A g H p)
@Becoming.RegimeMargin.Adjusted.rests_from : ∀ {A : Nat → Nat → Nat} {H hi : Nat},
  Becoming.RegimeMargin.Adjusted.Rises A →
    Becoming.RegimeMargin.Adjusted.Band A H hi →
      ∀ (d : Nat) (p : Nat × Nat),
        Becoming.RegimeMargin.Adjusted.unordered H p ≤ d →
          p.snd ≤ p.fst →
            p.fst ≤ hi →
              ∃ N,
                N ≤ d + (hi + hi) ∧
