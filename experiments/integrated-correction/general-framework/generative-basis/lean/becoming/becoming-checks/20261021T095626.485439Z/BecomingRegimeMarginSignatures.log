@Becoming.RegimeMargin.Adjusted.comes_to_rest : ∀ {A : Nat → Nat → Nat} {g : Nat → Nat} {H hi x r : Nat},
  Becoming.RegimeMargin.Adjusted.Rises A →
    Becoming.RegimeMargin.Adjusted.RestsAtDraw A g H →
