                          A 0 ((Becoming.Law.run (Becoming.RegimeMargin.Adjusted.step A H) (x, r)).state N).snd =
                            ((Becoming.Law.run (Becoming.RegimeMargin.Adjusted.step A H) (x, r)).state N).snd) ∧
                    (Becoming.RegimeMargin.Adjusted.threshold A H hi r ≤ x →
