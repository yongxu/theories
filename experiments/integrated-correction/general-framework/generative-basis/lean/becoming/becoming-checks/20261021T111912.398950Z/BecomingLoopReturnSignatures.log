@Becoming.LoopReturn.below_of_falls : ∀ {f : Nat → Nat} {d n : Nat}, (Becoming.Law.run f d).state n < d → ∃ y, f y < y
@Becoming.LoopReturn.link_below_of_below : ∀ {links : List (Nat → Nat)} {x : Nat},
  Becoming.LoopReturn.returnMap links x < x → ∃ g, g ∈ links ∧ ∃ y, g y < y
