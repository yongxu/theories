Becoming.Hexagram.starts_return : ∀ (q : Becoming.Hexagram × Nat),
  q ∈ Becoming.Hexagram.orbitStarts →
    (Becoming.Law.run Becoming.Hexagram.waxWane q.fst).state q.snd = q.fst ∧
      ∀ (p : Nat), 0 < p → p < q.snd → (Becoming.Law.run Becoming.Hexagram.waxWane q.fst).state p ≠ q.fst
Becoming.Hexagram.orbitIndex_waxWane : ∀ (s : Becoming.Hexagram), s.waxWane.orbitIndex = s.orbitIndex
Becoming.Hexagram.orbitIndex_lumped : Becoming.Learning.Lumped Becoming.Hexagram.orbitIndex fun s =>
  s.waxWane.orbitIndex
Becoming.Hexagram.orbitIndex_goAlike : Becoming.GoAlike (Becoming.Law.process Becoming.Hexagram.waxWane)
  Becoming.Hexagram.orbitIndex
Becoming.Hexagram.orbitIndex_invariant : ∀ (i : Nat),
  Becoming.Invariant (Becoming.Law.process Becoming.Hexagram.waxWane) fun x => x.orbitIndex = i
@Becoming.Hexagram.reach_keeps_orbit : ∀ {s t : Becoming.Hexagram},
  Becoming.Reach (Becoming.Law.process Becoming.Hexagram.waxWane) s t → t.orbitIndex = s.orbitIndex
Becoming.Hexagram.orbit_census : List.map (fun q => q.fst.orbitIndex) Becoming.Hexagram.orbitStarts =
    [0, 1, 2, 3, 4, 5] ∧
  List.map (fun q => (List.filter (fun s => s.orbitIndex.beq q.fst.orbitIndex) Becoming.Hexagram.order).length)
        Becoming.Hexagram.orbitStarts =
      [12, 12, 12, 12, 4, 12] ∧
    List.map (fun q => q.fst.changesAround) Becoming.Hexagram.orbitStarts = [1, 3, 3, 3, 3, 5]
