@Becoming.Web.unceasingFrom_self : ∀ {F C : Type} (W : Becoming.Web F C),
  (W.UnceasingFrom fun x g f => g = f) ↔ W.Unceasing
@Becoming.Web.arisesFrom_of_more : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop},
  W.NoSplit R →
    ∀ {t : Nat} [(f : F) → Decidable (W.Continues R t f)] {before after : List F},
      (∀ (f : F), W.active t f → f ∈ before) →
        Becoming.Distinct after →
          (∀ (f : F), f ∈ after → W.active (t + 1) f) →
            before.length < after.length → ∃ f, f ∈ after ∧ W.ArisesFrom R t f
