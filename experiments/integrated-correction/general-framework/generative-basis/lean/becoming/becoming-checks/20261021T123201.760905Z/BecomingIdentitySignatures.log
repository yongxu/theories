    ∀ (t : Nat) (f : F), W.ArisesFrom σ.continuation t f ↔ (W.reidentify σ).Arises t (σ.new (t + 1) f)
@Becoming.forces_iff_noSplit : ∀ {F : Type} [DecidableEq F] {S : F → F → Prop},
  (∀ (before after : List F),
      Becoming.Distinct after → before.length < after.length → ¬∀ (f : F), f ∈ after → ∃ g, g ∈ before ∧ S g f) ↔
    ∀ (g f f' : F), S g f → S g f' → f = f'
@Becoming.paired_mem : ∀ {F : Type} {before after : List F} {x y : F}, Becoming.paired before after x y → x ∈ before
@Becoming.paired_noSplit : ∀ {F : Type} {before after : List F},
