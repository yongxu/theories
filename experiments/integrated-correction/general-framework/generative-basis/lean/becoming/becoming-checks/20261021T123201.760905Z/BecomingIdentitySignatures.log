    ∀ (g f f' : F), Becoming.paired before after g f → Becoming.paired before after g f' → f = f'
@Becoming.paired_covers : ∀ {F : Type} {before after : List F},
  after.length ≤ before.length → ∀ (f : F), f ∈ after → ∃ g, g ∈ before ∧ Becoming.paired before after g f
@Becoming.forced_iff_more : ∀ {F : Type} {before after : List F},
  Becoming.Distinct before →
    Becoming.Distinct after →
      ((∀ (S : F → F → Prop),
          (∀ (g f f' : F), S g f → S g f' → f = f') → ¬∀ (f : F), f ∈ after → ∃ g, g ∈ before ∧ S g f) ↔
        before.length < after.length)
@Becoming.Web.ceasesFrom_self : ∀ {F C : Type} (W : Becoming.Web F C) (t : Nat) (g : F),
  W.CeasesFrom (fun x g f => g = f) t g ↔ W.Ceases t g
@Becoming.Web.self_one_to_one : ∀ {F C : Type} (W : Becoming.Web F C),
  (W.NoSplit fun x g f => g = f) ∧ W.NoMerge fun x g f => g = f
@Becoming.Web.Census.balanceFrom_at : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop}
  [inst : (t : Nat) → (f : F) → Decidable (W.active t f)] [inst_1 : (t : Nat) → (f : F) → Decidable (W.Continues R t f)]
  [inst_2 : (t : Nat) → (g : F) → Decidable (W.Continued R t g)] [(t : Nat) → (g f : F) → Decidable (R t g f)]
  {alive : Nat → List F} {t : Nat},
  (Becoming.Distinct (alive t) ∧ ∀ (f : F), W.active t f ↔ f ∈ alive t) →
    (Becoming.Distinct (alive (t + 1)) ∧ ∀ (f : F), W.active (t + 1) f ↔ f ∈ alive (t + 1)) →
      ((∀ (g f f' : F), W.active t g → R t g f → R t g f' → W.active (t + 1) f → W.active (t + 1) f' → f = f') →
          ((alive (t + 1)).length + Becoming.total (alive t) fun g => Becoming.mark (W.CeasesFrom R t g)) ≤
            (alive t).length + Becoming.total (alive (t + 1)) fun f => Becoming.mark (W.ArisesFrom R t f)) ∧
        ((∀ (g g' f : F), W.active t g → W.active t g' → R t g f → R t g' f → W.active (t + 1) f → g = g') →
          ((alive t).length + Becoming.total (alive (t + 1)) fun f => Becoming.mark (W.ArisesFrom R t f)) ≤
            (alive (t + 1)).length + Becoming.total (alive t) fun g => Becoming.mark (W.CeasesFrom R t g))
@Becoming.Web.Census.balanceFrom : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop}
  [inst : (t : Nat) → (f : F) → Decidable (W.active t f)] [inst_1 : (t : Nat) → (f : F) → Decidable (W.Continues R t f)]
  [inst_2 : (t : Nat) → (g : F) → Decidable (W.Continued R t g)] [(t : Nat) → (g f : F) → Decidable (R t g f)]
  {alive : Nat → List F},
  W.Census alive →
    ∀ (t : Nat),
      (W.NoSplit R →
          ((alive (t + 1)).length + Becoming.total (alive t) fun g => Becoming.mark (W.CeasesFrom R t g)) ≤
            (alive t).length + Becoming.total (alive (t + 1)) fun f => Becoming.mark (W.ArisesFrom R t f)) ∧
        (W.NoMerge R →
          ((alive t).length + Becoming.total (alive (t + 1)) fun f => Becoming.mark (W.ArisesFrom R t f)) ≤
            (alive (t + 1)).length + Becoming.total (alive t) fun g => Becoming.mark (W.CeasesFrom R t g))
@Becoming.Web.Census.balanceFrom_eq_at : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop}
  [inst : (t : Nat) → (f : F) → Decidable (W.active t f)] [inst_1 : (t : Nat) → (f : F) → Decidable (W.Continues R t f)]
  [inst_2 : (t : Nat) → (g : F) → Decidable (W.Continued R t g)] [(t : Nat) → (g f : F) → Decidable (R t g f)]
  {alive : Nat → List F} {t : Nat},
  (Becoming.Distinct (alive t) ∧ ∀ (f : F), W.active t f ↔ f ∈ alive t) →
    (Becoming.Distinct (alive (t + 1)) ∧ ∀ (f : F), W.active (t + 1) f ↔ f ∈ alive (t + 1)) →
      (∀ (g f f' : F), W.active t g → R t g f → R t g f' → W.active (t + 1) f → W.active (t + 1) f' → f = f') →
        (∀ (g g' f : F), W.active t g → W.active t g' → R t g f → R t g' f → W.active (t + 1) f → g = g') →
          ((alive (t + 1)).length + Becoming.total (alive t) fun g => Becoming.mark (W.CeasesFrom R t g)) =
            (alive t).length + Becoming.total (alive (t + 1)) fun f => Becoming.mark (W.ArisesFrom R t f)
@Becoming.Web.Census.balanceFrom_eq : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop}
  [inst : (t : Nat) → (f : F) → Decidable (W.active t f)] [inst_1 : (t : Nat) → (f : F) → Decidable (W.Continues R t f)]
  [inst_2 : (t : Nat) → (g : F) → Decidable (W.Continued R t g)] [(t : Nat) → (g f : F) → Decidable (R t g f)]
  {alive : Nat → List F},
  W.Census alive →
    ∀ (t : Nat),
      W.NoSplit R →
        W.NoMerge R →
          ((alive (t + 1)).length + Becoming.total (alive t) fun g => Becoming.mark (W.CeasesFrom R t g)) =
            (alive t).length + Becoming.total (alive (t + 1)) fun f => Becoming.mark (W.ArisesFrom R t f)
@Becoming.Web.Census.arisingFrom_of_ceasingFrom_from : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop}
  [(t : Nat) → (f : F) → Decidable (W.active t f)] [(t : Nat) → (f : F) → Decidable (W.Continues R t f)]
  [(t : Nat) → (g : F) → Decidable (W.Continued R t g)] [(t : Nat) → (g f : F) → Decidable (R t g f)]
  {alive : Nat → List F} {T : Nat},
  (∀ (s : Nat), T ≤ s → Becoming.Distinct (alive s) ∧ ∀ (f : F), W.active s f ↔ f ∈ alive s) →
    (∀ (s : Nat),
        T ≤ s → ∀ (g f f' : F), W.active s g → R s g f → R s g f' → W.active (s + 1) f → W.active (s + 1) f' → f = f') →
      (∀ (N : Nat), ∃ t g, N ≤ t ∧ W.CeasesFrom R t g) → W.UnceasingFrom R
@Becoming.Web.Census.arisingFrom_of_ceasingFrom : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop}
  [(t : Nat) → (f : F) → Decidable (W.active t f)] [(t : Nat) → (f : F) → Decidable (W.Continues R t f)]
  [(t : Nat) → (g : F) → Decidable (W.Continued R t g)] [(t : Nat) → (g f : F) → Decidable (R t g f)]
  {alive : Nat → List F},
  W.Census alive → W.NoSplit R → (∀ (N : Nat), ∃ t g, N ≤ t ∧ W.CeasesFrom R t g) → W.UnceasingFrom R
@Becoming.Web.Census.ceasingFrom_of_arisingFrom_from : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop}
  [(t : Nat) → (f : F) → Decidable (W.active t f)] [(t : Nat) → (f : F) → Decidable (W.Continues R t f)]
  [(t : Nat) → (g : F) → Decidable (W.Continued R t g)] [(t : Nat) → (g f : F) → Decidable (R t g f)]
  {alive : Nat → List F} {T B : Nat},
  (∀ (s : Nat), T ≤ s → Becoming.Distinct (alive s) ∧ ∀ (f : F), W.active s f ↔ f ∈ alive s) →
    (∀ (s : Nat),
        T ≤ s → ∀ (g g' f : F), W.active s g → W.active s g' → R s g f → R s g' f → W.active (s + 1) f → g = g') →
      (∀ (t : Nat), T ≤ t → (alive t).length ≤ B) → W.UnceasingFrom R → ∀ (N : Nat), ∃ t g, N ≤ t ∧ W.CeasesFrom R t g
@Becoming.Web.Census.ceasingFrom_of_arisingFrom : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop}
  [(t : Nat) → (f : F) → Decidable (W.active t f)] [(t : Nat) → (f : F) → Decidable (W.Continues R t f)]
  [(t : Nat) → (g : F) → Decidable (W.Continued R t g)] [(t : Nat) → (g f : F) → Decidable (R t g f)]
  {alive : Nat → List F},
  W.Census alive →
    W.NoMerge R →
      ∀ {T B : Nat},
        (∀ (t : Nat), T ≤ t → (alive t).length ≤ B) → W.UnceasingFrom R → ∀ (N : Nat), ∃ t g, N ≤ t ∧ W.CeasesFrom R t g
@Becoming.Web.Lineage.unique : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {M : Nat} {g : F},
  (∀ (s : Nat),
      M ≤ s → ∀ (g f f' : F), W.active s g → R s g f → R s g f' → W.active (s + 1) f → W.active (s + 1) f' → f = f') →
    ∀ {k : Nat} {h h' : F}, W.Lineage R M g k h → W.Lineage R M g k h' → h = h'
@Becoming.Web.Lineage.through : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {M : Nat} {g : F}
  {k : Nat} (i : Nat) {h' : F},
  W.Lineage R M g (k + 1 + i) h' → ∃ h₁ h₂, W.Lineage R M g k h₁ ∧ R (M + k) h₁ h₂ ∧ W.active (M + k + 1) h₂
@Becoming.Web.Lineage.ends : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {M : Nat} {g : F},
  (∀ (s : Nat),
      M ≤ s → ∀ (g f f' : F), W.active s g → R s g f → R s g f' → W.active (s + 1) f → W.active (s + 1) f' → f = f') →
    ∀ {k : Nat} {h : F},
      W.Lineage R M g k h → W.CeasesFrom R (M + k) h → ∀ (i : Nat) {h' : F}, ¬W.Lineage R M g (k + 1 + i) h'
@Becoming.Web.Lineage.back : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {M : Nat} {l : List F},
  (∀ (f : F), W.active M f → f ∈ l) →
    (∀ (s : Nat) (f : F), M ≤ s → ¬W.ArisesFrom R s f) →
      ∀ (k : Nat) (h : F), W.active (M + k) h → ¬¬∃ g, g ∈ l ∧ W.Lineage R M g k h
@Becoming.Web.ceasingFrom_found : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop},
  (∀ (N : Nat), ∃ t g, N ≤ t ∧ W.CeasesFrom R t g) →
    ∀ (n N : Nat),
      ∃ ps, Becoming.Distinct ps ∧ ps.length = n ∧ ∀ (p : Nat × F), p ∈ ps → N ≤ p.fst ∧ W.CeasesFrom R p.fst p.snd
@Becoming.Web.not_not_arisingFrom_covered : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {M : Nat}
  {l : List F},
  (∀ (f : F), W.active M f → f ∈ l) →
    (∀ (s : Nat),
        M ≤ s → ∀ (g f f' : F), W.active s g → R s g f → R s g f' → W.active (s + 1) f → W.active (s + 1) f' → f = f') →
      (∀ (N : Nat), ∃ t g, N ≤ t ∧ W.CeasesFrom R t g) → ¬¬∃ s f, M ≤ s ∧ W.ArisesFrom R s f
@Becoming.Web.arisingFrom_not_stopping_covered : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop}
  {T : Nat},
  (∀ (N : Nat), ∃ M l, N ≤ M ∧ ∀ (f : F), W.active M f → f ∈ l) →
    (∀ (s : Nat),
        T ≤ s → ∀ (g f f' : F), W.active s g → R s g f → R s g f' → W.active (s + 1) f → W.active (s + 1) f' → f = f') →
      (∀ (N : Nat), ∃ t g, N ≤ t ∧ W.CeasesFrom R t g) → ¬∃ N, ∀ (t : Nat) (f : F), N ≤ t → ¬W.ArisesFrom R t f
@Becoming.Web.Lineage.active : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {M : Nat} {g : F},
  W.active M g → ∀ {k : Nat} {h : F}, W.Lineage R M g k h → W.active (M + k) h
@Becoming.Web.Lineage.split : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {M : Nat} {g : F} {j : Nat}
  (i : Nat) {h : F}, W.Lineage R M g (j + i) h → ∃ x, W.Lineage R M g j x ∧ W.Lineage R (M + j) x i h
@Becoming.Web.Lineage.origin : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {M : Nat},
  (∀ (s : Nat),
      M ≤ s → ∀ (g g' f : F), W.active s g → W.active s g' → R s g f → R s g' f → W.active (s + 1) f → g = g') →
    ∀ {k : Nat} {g g' h : F}, W.Lineage R M g k h → W.Lineage R M g' k h → g = g'
@Becoming.Web.Lineage.onward : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {N M : Nat},
  N ≤ M →
    ∀ {g : F},
      (∀ (t : Nat) (g : F), N ≤ t → ¬W.CeasesFrom R t g) → W.active M g → ∀ (k : Nat), ¬¬∃ h, W.Lineage R M g k h
@Becoming.Web.arisingFrom_found : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop},
  W.UnceasingFrom R →
    ∀ (n N : Nat),
      ∃ ps, Becoming.Distinct ps ∧ ps.length = n ∧ ∀ (p : Nat × F), p ∈ ps → N ≤ p.fst ∧ W.ArisesFrom R p.fst p.snd
@Becoming.Web.lineages_apart : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {N : Nat},
  (∀ (s : Nat),
      N ≤ s → ∀ (g g' f : F), W.active s g → W.active s g' → R s g f → R s g' f → W.active (s + 1) f → g = g') →
    ∀ {t d : Nat} {f₁ f₂ h : F},
      N ≤ t →
        W.ArisesFrom R (t + 1 + d) f₂ →
          ∀ {k₁ k₂ : Nat},
            W.Lineage R (t + 1) f₁ k₁ h → W.Lineage R (t + 1 + d + 1) f₂ k₂ h → t + 1 + k₁ = t + 1 + d + 1 + k₂ → False
@Becoming.Web.ceasingFrom_not_stopping_covered : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop}
  {T : Nat} {L : List F},
  (∀ (t : Nat), T ≤ t → ∀ (f : F), W.active t f → f ∈ L) →
    (∀ (s : Nat),
        T ≤ s → ∀ (g g' f : F), W.active s g → W.active s g' → R s g f → R s g' f → W.active (s + 1) f → g = g') →
      W.UnceasingFrom R → ¬∃ N, ∀ (t : Nat) (g : F), N ≤ t → ¬W.CeasesFrom R t g
