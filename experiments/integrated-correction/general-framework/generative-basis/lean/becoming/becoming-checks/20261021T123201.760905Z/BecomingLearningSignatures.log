@Becoming.Learning.lumped_determines : ∀ {I : Type u_1} {V : Type u_2} {K : Type u_3} {π : I → K} {D : I → Prop}
  {x : I}, (∃ d, D d ∧ π d = π x) → Becoming.Learning.Determines (Becoming.Learning.Lumped π) D x
@Becoming.Learning.determines_lumped_iff : ∀ {I : Type u_1} {V : Type u_2} {K : Type u_3} [DecidableEq K] {π : I → K}
  {data : List I} {x : I} {y z : V},
  y ≠ z → (Becoming.Learning.Determines (Becoming.Learning.Lumped π) (fun x => x ∈ data) x ↔ ∃ d, d ∈ data ∧ π d = π x)
@Becoming.Learning.lumped_right_iff : ∀ {I : Type u_1} {V : Type u_2} {K : Type u_3} {π : I → K} {D : I → Prop}
  {f g : I → V} {x d : I},
  Becoming.Learning.Lumped π g → (∀ (i : I), D i → g i = f i) → D d → π d = π x → (g x = f x ↔ f d = f x)
@Becoming.Learning.lumped_world_right : ∀ {I : Type u_1} {V : Type u_2} {K : Type u_3} {π : I → K} {D : I → Prop}
  {f g : I → V} {x d : I},
  Becoming.Learning.Lumped π f →
    Becoming.Learning.Lumped π g → (∀ (i : I), D i → g i = f i) → D d → π d = π x → g x = f x
@Becoming.Learning.free_determines_iff : ∀ {I : Type u_1} {V : Type u_2} {C : (I → V) → Prop} {D : I → Prop} {x : I},
  Becoming.Learning.Free C D x → (Becoming.Learning.Determines C D x ↔ ∀ (g g' : I → V), C g → C g' → g x = g' x)
@Becoming.Learning.every_free : ∀ {I : Type u_1} {V : Type u_2} [DecidableEq I] {D : I → Prop} {x : I},
  ¬D x → Becoming.Learning.Free (fun x => True) D x
@Becoming.Learning.every_determines_nothing : ∀ {I : Type u_1} {V : Type u_2} [DecidableEq I] {D : I → Prop} {x : I},
  ¬D x → ∀ {y z : V}, y ≠ z → ¬Becoming.Learning.Determines (fun x => True) D x
@Becoming.Learning.Training.web_selectsThrough_iff : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop} {f : F}
  {t : Nat} {select : (Nat → C → Nat) → Prop},
  W.SelectsThrough obs f t select ↔
    Becoming.Learning.Training.Through (fun l l' => W.AlikeThroughUpTo obs f l l' t) select
@Becoming.Learning.Training.loss_through : ∀ {I : Type u_1} {V : Type u_2} {D : I → Prop} {L : Type u_3}
  (loss : (I → V) → L),
  (∀ (g g' : I → V), Becoming.Learning.Training.AgreeOn D g g' → loss g = loss g') →
    ∀ (choose : L → Prop),
      Becoming.Learning.Training.Through (Becoming.Learning.Training.AgreeOn D) fun g => choose (loss g)
@Becoming.Learning.Training.unselected_beyond_data : ∀ {I : Type u_1} {V : Type u_2} {C : (I → V) → Prop} {D : I → Prop}
  {x : I} {select : (I → V) → Prop},
  Becoming.Learning.Training.Through (Becoming.Learning.Training.AgreeOn D) select →
    Becoming.Learning.Free C D x →
      ∀ {g g' : I → V},
        C g → C g' → select g → ∃ h, C h ∧ select h ∧ Becoming.Learning.Training.AgreeOn D h g ∧ h x = g' x
@Becoming.Learning.Training.fit_right_iff : ∀ {I : Type u_1} {V : Type u_2} {C : (I → V) → Prop} {D : I → Prop} {x : I},
  (∀ (f g : I → V), C f → C g → Becoming.Learning.Training.AgreeOn D g f → g x = f x) ↔
    Becoming.Learning.Determines C D x
@Becoming.Learning.selects_through_lumping : ∀ {K : Type u_1} {V : Type u_2} [inst : DecidableEq K]
  {select : (K → V) → K → Prop},
  Becoming.Relabel.Equivariant select →
    ∀ (r : K → V), Becoming.Learning.Training.Through (fun i i' => r i = r i') (select r)
@Becoming.Learning.values_lumped : ∀ {K : Type u_1} {V : Type u_2} {W : Type u_3} [inst : DecidableEq K]
  {value : (K → V) → K → W},
  Becoming.Relabel.EquivariantValue value → ∀ (r : K → V), Becoming.Learning.Lumped r (value r)
@Becoming.Learning.selects_right_through : ∀ {K : Type u_1} {V : Type u_2} [inst : DecidableEq K]
  {select : (K → V) → K → Prop},
  Becoming.Relabel.Equivariant select →
    ∀ {r : K → V} {p : K → Prop},
      (∀ (i : K), select r i ↔ p i) → Becoming.Learning.Training.Through (fun i i' => r i = r i') p
@Becoming.Learning.selects_not_right_of_parted : ∀ {K : Type u_1} {V : Type u_2} [inst : DecidableEq K]
  {select : (K → V) → K → Prop},
  Becoming.Relabel.Equivariant select →
    ∀ {r : K → V} {p : K → Prop} {j k : K}, r j = r k → p j → ¬p k → ¬∀ (i : K), select r i ↔ p i
@Becoming.Learning.selects_right_of_reads : ∀ {K : Type u_1} {V : Type u_2} [inst : DecidableEq K] {r : K → V}
  {p : K → Prop} (q : V → Prop),
  (∀ (i : K), p i ↔ q (r i)) → (Becoming.Relabel.Equivariant fun r' i => q (r' i)) ∧ ∀ (i : K), q (r i) ↔ p i
@Becoming.Learning.values_right_lumped : ∀ {K : Type u_1} {V : Type u_2} {W : Type u_3} [inst : DecidableEq K]
  {value : (K → V) → K → W},
  Becoming.Relabel.EquivariantValue value →
    ∀ {r : K → V} {f : K → W}, (∀ (i : K), value r i = f i) → Becoming.Learning.Lumped r f
@Becoming.Learning.values_not_right_of_parted : ∀ {K : Type u_1} {V : Type u_2} {W : Type u_3} [inst : DecidableEq K]
  {value : (K → V) → K → W},
  Becoming.Relabel.EquivariantValue value →
    ∀ {r : K → V} {f : K → W} {j k : K}, r j = r k → f j ≠ f k → ¬∀ (i : K), value r i = f i
@Becoming.Learning.values_right_of_reads : ∀ {K : Type u_1} {V : Type u_2} {W : Type u_3} [inst : DecidableEq K]
  {r : K → V} {f : K → W} (h : V → W),
  (∀ (i : K), f i = h (r i)) → (Becoming.Relabel.EquivariantValue fun r' i => h (r' i)) ∧ ∀ (i : K), h (r i) = f i
Becoming.Learning.Shift.determines : Becoming.Learning.Determines
  (Becoming.Learning.Lumped Becoming.Learning.Shift.content) (fun x => x ∈ Becoming.Learning.Shift.data) (true, true)
Becoming.Learning.Shift.every_nothing : ¬Becoming.Learning.Determines (fun x => True)
    (fun x => x ∈ Becoming.Learning.Shift.data) (true, true)
Becoming.Learning.Shift.right_same : Becoming.Learning.Shift.content (true, true) =
  Becoming.Learning.Shift.same (true, true)
Becoming.Learning.Shift.wrong_both : (Becoming.Learning.Lumped Becoming.Learning.Shift.content fun x => false) ∧
  (∀ (i : Bool × Bool), i ∈ Becoming.Learning.Shift.data → (fun x => false) i = Becoming.Learning.Shift.both i) ∧
    (fun x => false) (true, true) ≠ Becoming.Learning.Shift.both (true, true)
Becoming.Learning.Alternate.repeats : Becoming.Learning.Lasso Becoming.Learning.Alternate.course 0 1
Becoming.Learning.Alternate.index_three : Becoming.Learning.index Becoming.Learning.lassos
    Becoming.Learning.Alternate.course 3 =
  2
Becoming.Learning.Alternate.rests : ∀ (t : Nat),
  3 ≤ t →
    Becoming.Learning.byElimination Becoming.Learning.lassos
        (Becoming.Learning.prefixOf Becoming.Learning.Alternate.course t) =
      some (Becoming.Learning.Alternate.course t)
