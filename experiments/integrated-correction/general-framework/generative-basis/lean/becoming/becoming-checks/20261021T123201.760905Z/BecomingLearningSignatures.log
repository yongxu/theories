  {t : Nat},
  ¬Becoming.Learning.MissesAt (Becoming.Learning.byElimination H) o t →
    Becoming.Learning.index H o (t + 1) = Becoming.Learning.index H o t
@Becoming.Learning.index_succ_le : ∀ {O : Type u_1} [inst : DecidableEq O] {H : Nat → List O → Option O} {o : Nat → O}
  (t : Nat), Becoming.Learning.index H o (t + 1) ≤ Becoming.Learning.index H o t + 1
@Becoming.Learning.index_le_succ : ∀ {O : Type u_1} [inst : DecidableEq O] {H : Nat → List O → Option O} {o : Nat → O}
  (t : Nat), Becoming.Learning.index H o t ≤ Becoming.Learning.index H o (t + 1)
@Becoming.Learning.index_mono : ∀ {O : Type u_1} [inst : DecidableEq O] {H : Nat → List O → Option O} {o : Nat → O}
  (t d : Nat), Becoming.Learning.index H o t ≤ Becoming.Learning.index H o (t + d)
@Becoming.Learning.index_mono_le : ∀ {O : Type u_1} [inst : DecidableEq O] {H : Nat → List O → Option O} {o : Nat → O}
  {T t : Nat}, T ≤ t → Becoming.Learning.index H o T ≤ Becoming.Learning.index H o t
@Becoming.Learning.index_le_of_accords : ∀ {O : Type u_1} [inst : DecidableEq O] {H : Nat → List O → Option O}
  {o : Nat → O} {j : Nat}, Becoming.Learning.Accords (H j) o → ∀ (t : Nat), Becoming.Learning.index H o t ≤ j
@Becoming.Learning.missed_before : ∀ {O : Type u_1} [inst : DecidableEq O] {H : Nat → List O → Option O} {o : Nat → O}
  (t k : Nat),
