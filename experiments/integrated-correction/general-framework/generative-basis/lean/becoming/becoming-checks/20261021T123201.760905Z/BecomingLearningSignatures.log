@Becoming.Learning.merged_unrested : ∀ {O : Type u_1} [inst : DecidableEq O] (G : Nat → Nat → List O → Option O)
  {other : O → O},
  (∀ (v : O), other v ≠ v) →
    ∀ (x : O),
      ¬∃ T,
          ∀ (t : Nat),
