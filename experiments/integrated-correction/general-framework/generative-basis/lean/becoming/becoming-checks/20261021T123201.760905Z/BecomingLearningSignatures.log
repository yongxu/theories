          Becoming.Learning.prefixOf (Becoming.Learning.holdFrom o t y) t = Becoming.Learning.prefixOf o t ∧
            Becoming.Learning.holdFrom o t x t = x ∧
              Becoming.Learning.holdFrom o t y t = y ∧
