@Becoming.Flow.BalancesOn.arises_iff : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X} {xs : List X}
  {t : Nat} {x : X},
  L.BalancesOn W xs t →
    x ∈ xs →
      (W.active t x ↔ 0 < W.level t x) →
        (W.active (t + 1) x ↔ 0 < W.level (t + 1) x) → (W.Arises t x ↔ W.level t x = 0 ∧ L.taken t x < L.given t x)
@Becoming.Flow.BalancesOn.arises_given : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X} {xs : List X}
  {t : Nat} {x : X},
  L.BalancesOn W xs t →
    x ∈ xs →
      (W.active t x ↔ 0 < W.level t x) →
        (W.active (t + 1) x ↔ 0 < W.level (t + 1) x) →
          (∀ (f : X), f ∈ L.present t → 0 < L.give t f x → W.active t f) →
            W.Arises t x → ∃ f, W.active t f ∧ f ∈ L.present t ∧ 0 < L.give t f x ∧ f ≠ x
@Becoming.accumulates_or : ∀ {q : Nat → Nat} {R : Prop},
  (∀ (N : Nat), ∃ t, N ≤ t ∧ (0 < q t ∨ R)) → ∀ (N K : Nat), R ∨ ∃ n, K ≤ Becoming.total (Becoming.steps N n) q
