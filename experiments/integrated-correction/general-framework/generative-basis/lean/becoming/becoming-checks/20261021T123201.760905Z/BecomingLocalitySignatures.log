@Becoming.Listed.covered : ∀ {α : Type} {p : α → Nat → Prop} {l : Nat → List α},
  Becoming.Listed p l → ∀ (M : Nat), ∃ N L, M ≤ N ∧ Becoming.Covers p L N
@Becoming.ceases_once : ∀ {α : Type} {p : α → Nat → Prop} {N n : Nat},
  Becoming.NoneComes p N n → ∀ {a : α} {t t' : Nat}, N ≤ t → t' < N + n → t < t' → Becoming.CeasesToBe (p a) t → ¬p a t'
@Becoming.Covers.ceasing_steps_within : ∀ {α : Type} {p : α → Nat → Prop} {L : List α} {N n : Nat},
  Becoming.Covers p L N →
    Becoming.NoneComes p N n →
      ∀ {E : List Nat},
        Becoming.Distinct E →
          (∀ (t : Nat), t ∈ E → N ≤ t ∧ t < N + n ∧ ∃ a, Becoming.CeasesToBe (p a) t) → E.length ≤ L.length
@Becoming.ceasing_steps_found : ∀ {α : Type} {p : α → Nat → Prop},
  (∀ (M : Nat), ∃ t a, M ≤ t ∧ Becoming.CeasesToBe (p a) t) →
    ∀ (N k : Nat),
      ∃ E U,
        Becoming.Distinct E ∧
          E.length = k ∧ N ≤ U ∧ ∀ (t : Nat), t ∈ E → N ≤ t ∧ t < U ∧ ∃ a, Becoming.CeasesToBe (p a) t
@Becoming.ceasing_steps_unrefuted : ∀ {α : Type} {p : α → Nat → Prop},
  (∀ (M : Nat), ¬¬∃ t a, M ≤ t ∧ Becoming.CeasesToBe (p a) t) →
    ∀ (N k : Nat),
      ¬¬∃ E U,
