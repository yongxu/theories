        (stand (T + n)).length + Becoming.count (Becoming.steps T n) (Becoming.fall fun t => W.stock (stand t) t) ≤
          W.stock (stand T) T
@Becoming.Flow.runsDown_change_bound : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {stand : Nat → List C},
  W.StandingCensus stand →
    ∀ {T : Nat},
      (∀ (t : Nat), T ≤ t → ¬¬L.RunsDown W t) →
