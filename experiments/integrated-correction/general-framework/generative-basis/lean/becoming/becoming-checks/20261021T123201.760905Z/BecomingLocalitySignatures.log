  {N n : Nat}, Becoming.Covers p L N → Becoming.NoneComes p N n → ∀ {k : Nat}, k ≤ n → Becoming.Covers p L (N + k)
@Becoming.cohort_closes_iff : ∀ {α : Type} {p : α → Nat → Prop} [inst : (a : α) → (t : Nat) → Decidable (p a t)]
