@Becoming.pos_iff_lt : ∀ {a b d : Nat}, a + b = d → (0 < a ↔ b < d)
@Becoming.exists_lt_of_total_lt : ∀ {α : Type} {p q : α → Nat} {as : List α},
  Becoming.total as p < Becoming.total as q → ∃ a, a ∈ as ∧ p a < q a
Becoming.rises_or_le : ∀ (r : Nat → Nat) (N n : Nat), r (N + n) ≤ r N ∨ ∃ s, N ≤ s ∧ r s < r (s + 1)
@Becoming.unmet_or_lower : ∀ {r : Nat → Nat} {E Q : Nat → Prop},
  (∀ (t : Nat), Q t → E t → r (t + 1) < r t) →
    (∀ (t : Nat), Q t → r (t + 1) ≤ r t) →
      (∀ (t : Nat), r t < r (t + 1) → E t) →
        (∀ (N : Nat), ∃ t, N ≤ t ∧ E t) → ∀ (N : Nat), (∃ t, N ≤ t ∧ ¬Q t ∧ E t) ∨ ∃ t, N ≤ t ∧ r (t + 1) < r N
@Becoming.unmet_from : ∀ {r : Nat → Nat} {E Q : Nat → Prop},
  (∀ (t : Nat), Q t → E t → r (t + 1) < r t) →
    (∀ (t : Nat), Q t → r (t + 1) ≤ r t) →
      (∀ (t : Nat), r t < r (t + 1) → E t) →
        (∀ (N : Nat), ∃ t, N ≤ t ∧ E t) → ∀ (k N : Nat), r N ≤ k → ∃ t, N ≤ t ∧ ¬Q t ∧ E t
@Becoming.recurs_iff_unmet : ∀ {r : Nat → Nat} {E Q : Nat → Prop},
  (∀ (t : Nat), Q t → E t → r (t + 1) < r t) →
    (∀ (t : Nat), Q t → r (t + 1) ≤ r t) →
      (∀ (t : Nat), r t < r (t + 1) → E t) → ((∀ (N : Nat), ∃ t, N ≤ t ∧ E t) ↔ ∀ (N : Nat), ∃ t, N ≤ t ∧ ¬Q t ∧ E t)
@Becoming.Web.StandingCensus.stock_eq : ∀ {F C : Type} {W : Becoming.Web F C} {stand : Nat → List C},
  W.StandingCensus stand →
    ∀ {es : List C},
      Becoming.Distinct es → ∀ {t : Nat}, (∀ (c : C), c ∈ stand t → c ∈ es) → W.stock (stand t) t = W.stock es t
@Becoming.Web.StandingCensus.length_le_stock : ∀ {F C : Type} {W : Becoming.Web F C} {stand : Nat → List C},
  W.StandingCensus stand → ∀ (t : Nat), (stand t).length ≤ W.stock (stand t) t
@Becoming.Flow.BalancesOn.comesToStand_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {cs : List C}
  {t : Nat} {c : C}, L.BalancesOn W cs t → c ∈ cs → (W.ComesToStand t c ↔ W.level t c = 0 ∧ L.taken t c < L.given t c)
@Becoming.Flow.BalancesOn.ceasesToStand_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {cs : List C} {t : Nat} {c : C},
  L.BalancesOn W cs t → c ∈ cs → (W.CeasesToStand t c ↔ 0 < W.level t c ∧ L.taken t c = W.level t c + L.given t c)
@Becoming.Flow.RunsDownOn.changes_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {es : List C}, L.RunsDownOn W es t → ((∃ c, W.Rises t c ∨ W.Falls t c) ↔ W.stock es (t + 1) < W.stock es t)
@Becoming.Flow.RunsDownOn.exchanges_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {es : List C},
  L.RunsDownOn W es t →
    L.ClosedAt es t →
      ((∃ f c, f ∈ L.present t ∧ (0 < L.take t f c ∨ 0 < L.give t f c)) ↔ W.stock es (t + 1) < W.stock es t)
@Becoming.Flow.RunsDownOn.stock_eq : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {es : List C} {stand : Nat → List C},
  W.StandingCensus stand →
    L.RunsDownOn W es t → W.stock (stand t) t = W.stock es t ∧ W.stock (stand (t + 1)) (t + 1) = W.stock es (t + 1)
@Becoming.Flow.RunsDown.standing_le : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {stand : Nat → List C},
  W.StandingCensus stand → L.RunsDown W t → W.stock (stand (t + 1)) (t + 1) ≤ W.stock (stand t) t
@Becoming.Flow.RunsDown.changes_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {stand : Nat → List C},
  W.StandingCensus stand →
    L.RunsDown W t → ((∃ c, W.Rises t c ∨ W.Falls t c) ↔ W.stock (stand (t + 1)) (t + 1) < W.stock (stand t) t)
@Becoming.Flow.RunsDownClosed.exchanges_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {stand : Nat → List C},
  W.StandingCensus stand →
    L.RunsDownClosed W t →
      ((∃ f c, f ∈ L.present t ∧ (0 < L.take t f c ∨ 0 < L.give t f c)) ↔
        W.stock (stand (t + 1)) (t + 1) < W.stock (stand t) t)
@Becoming.Flow.rise_of_standing : ∀ {F C : Type} {W : Becoming.Web F C} {t : Nat} {stand : Nat → List C},
  W.StandingCensus stand → W.stock (stand t) t < W.stock (stand (t + 1)) (t + 1) → ∃ c, W.Rises t c
@Becoming.Flow.RunsDownClosed.runsDown : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat},
  L.RunsDownClosed W t → L.RunsDown W t
@Becoming.Flow.change_recurs_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {stand : Nat → List C},
  W.StandingCensus stand →
    ((∀ (N : Nat), ∃ t, N ≤ t ∧ ∃ c, W.Rises t c ∨ W.Falls t c) ↔
      ∀ (N : Nat), ∃ t, N ≤ t ∧ ¬L.RunsDown W t ∧ ∃ c, W.Rises t c ∨ W.Falls t c)
@Becoming.Flow.exchange_recurs_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {stand : Nat → List C},
  W.StandingCensus stand →
    ((∀ (N : Nat),
        ∃ t,
          N ≤ t ∧ ((∃ f c, f ∈ L.present t ∧ (0 < L.take t f c ∨ 0 < L.give t f c)) ∨ ∃ c, W.Rises t c ∨ W.Falls t c)) ↔
      ∀ (N : Nat),
        ∃ t,
          N ≤ t ∧
            ¬L.RunsDownClosed W t ∧
              ((∃ f c, f ∈ L.present t ∧ (0 < L.take t f c ∨ 0 < L.give t f c)) ∨ ∃ c, W.Rises t c ∨ W.Falls t c))
@Becoming.Flow.RunsDown.rise_zero : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {stand : Nat → List C}, W.StandingCensus stand → L.RunsDown W t → Becoming.rise (fun t => W.stock (stand t) t) t = 0
@Becoming.Flow.RunsDown.fall_pos_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {stand : Nat → List C},
  W.StandingCensus stand →
    L.RunsDown W t → (0 < Becoming.fall (fun t => W.stock (stand t) t) t ↔ ∃ c, W.Rises t c ∨ W.Falls t c)
@Becoming.Flow.RunsDownOn.takers_le_fall : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {es : List C} {stand : Nat → List C},
  W.StandingCensus stand → L.RunsDownOn W es t → L.takers es t ≤ Becoming.fall (fun t => W.stock (stand t) t) t
@Becoming.Flow.standing_bounds_change : ∀ {F C : Type} {W : Becoming.Web F C} {stand : Nat → List C},
  W.StandingCensus stand →
    ∀ (T n : Nat),
      (stand (T + n)).length + Becoming.count (Becoming.steps T n) (Becoming.fall fun t => W.stock (stand t) t) ≤
        W.stock (stand T) T + Becoming.total (Becoming.steps T n) (Becoming.rise fun t => W.stock (stand t) t)
@Becoming.Flow.RunsDown.lowers_mark : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {stand : Nat → List C},
  W.StandingCensus stand →
    L.RunsDown W t →
      ∀ {q : Nat},
        (0 < q → ∃ c, W.Rises t c ∨ W.Falls t c) →
          W.stock (stand (t + 1)) (t + 1) + Becoming.mark (0 < q) ≤ W.stock (stand t) t
@Becoming.Flow.runsDown_bounds_change : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {stand : Nat → List C},
  W.StandingCensus stand →
    ∀ {T n : Nat},
