  Becoming.Covers p L N →
    (∀ (n : Nat), Becoming.NoneComes p N n) → ¬∀ (M : Nat), ∃ t a, M ≤ t ∧ Becoming.CeasesToBe (p a) t
@Becoming.Covers.not_not_coming_from : ∀ {α : Type} {p : α → Nat → Prop} {L : List α} {N : Nat},
  Becoming.Covers p L N →
    (∀ (M : Nat), ¬¬∃ t a, M ≤ t ∧ Becoming.CeasesToBe (p a) t) → ¬¬∃ s a, N ≤ s ∧ Becoming.ComesToBe (p a) s
