Becoming.Swap.tally : ∀ (s : Nat → Bool), Becoming.Tally (fun x => 1) (Becoming.Swap.change s) (Becoming.Swap.change s)
Becoming.Swap.change_bound : ∀ (s : Nat → Bool),
  Becoming.ChangeBound 0 2 (fun x => 1) (Becoming.Swap.change s) (Becoming.Swap.change s)
Becoming.Swap.at_first : ∀ (s : Nat → Bool) {m : Nat},
  Becoming.clear s m = true → s m = true → Becoming.Swap.change s m = 1
Becoming.Swap.decide_of_end : ∀ (s : Nat → Bool) {E : Nat},
  (∀ (m : Nat), E ≤ m → Becoming.clear s m = true → s m = true → False) → (∃ n, s n = true) ∨ ∀ (n : Nat), s n = false
Becoming.ChangeBound.lpo_of_ends : (∀ (n c a : Nat → Nat),
    Becoming.Tally n c a →
      (∀ (t : Nat), 0 < a t → 0 < n t) →
        (∃ B, Becoming.ChangeBound 0 B n c a) → ∃ E, ∀ (t : Nat), E ≤ t → c t + a t = 0) →
  Becoming.LPO
@Becoming.Web.DependenceCensus.forming_of_dissolving : ∀ {F C : Type} {W : Becoming.Web F C}
  [(t : Nat) → (g : F) → (c : C) → Decidable (W.requires t g c)] {deps : Nat → List (F × C)},
  W.DependenceCensus deps →
    (∀ (N : Nat), ∃ t g c, N ≤ t ∧ W.Dissolves t g c) → ∀ (N : Nat), ∃ t g c, N ≤ t ∧ W.Forms t g c
@Becoming.Web.DependenceCensus.forming_iff_dissolving : ∀ {F C : Type} {W : Becoming.Web F C}
  [(t : Nat) → (g : F) → (c : C) → Decidable (W.requires t g c)] {deps : Nat → List (F × C)},
  W.DependenceCensus deps →
    ∀ {T B : Nat},
      (∀ (t : Nat), T ≤ t → (deps t).length ≤ B) →
        ((∀ (N : Nat), ∃ t g c, N ≤ t ∧ W.Forms t g c) ↔ ∀ (N : Nat), ∃ t g c, N ≤ t ∧ W.Dissolves t g c)
@Becoming.Web.DependenceCensus.over_stretch : ∀ {F C : Type} {W : Becoming.Web F C}
  [inst : (t : Nat) → (g : F) → (c : C) → Decidable (W.requires t g c)] {deps : Nat → List (F × C)},
  W.DependenceCensus deps →
    ∀ (S n : Nat),
      ((deps (S + n)).length +
          Becoming.total (Becoming.steps S n) fun t =>
            Becoming.total (deps t) fun d => Becoming.mark (W.Dissolves t d.fst d.snd)) =
        (deps S).length +
          Becoming.total (Becoming.steps S n) fun t =>
            Becoming.total (deps (t + 1)) fun d => Becoming.mark (W.Forms t d.fst d.snd)
@Becoming.Web.arises_of_more : ∀ {F C : Type} (W : Becoming.Web F C) [(t : Nat) → (f : F) → Decidable (W.active t f)]
  {t : Nat} {before after : List F},
  (∀ (f : F), W.active t f → f ∈ before) →
    Becoming.Distinct after →
      (∀ (f : F), f ∈ after → W.active (t + 1) f) → before.length < after.length → ∃ f, f ∈ after ∧ W.Arises t f
@Becoming.Web.unceasing_of_growth : ∀ {F C : Type} (W : Becoming.Web F C)
  [(t : Nat) → (f : F) → Decidable (W.active t f)] {alive : Nat → List F},
  W.Census alive → (∀ (N K : Nat), ∃ t, N ≤ t ∧ K < (alive t).length) → W.Unceasing
@Becoming.Web.unceasing_iff_bounded : ∀ {F C : Type} (W : Becoming.Web F C)
  [(t : Nat) → (f : F) → Decidable (W.active t f)] {alive : Nat → List F},
  W.Census alive →
    ∀ {T B : Nat},
      (∀ (t : Nat), T ≤ t → (alive t).length ≤ B) → (W.Unceasing ↔ ∀ (N : Nat), ∃ t f, N ≤ t ∧ W.Ceases t f)
@Becoming.Web.Census.over_stretch : ∀ {F C : Type} (W : Becoming.Web F C)
  [inst : (t : Nat) → (f : F) → Decidable (W.active t f)] {alive : Nat → List F},
  W.Census alive →
    ∀ (S n : Nat),
      ((alive (S + n)).length +
          Becoming.total (Becoming.steps S n) fun t => Becoming.total (alive t) fun f => Becoming.mark (W.Ceases t f)) =
        (alive S).length +
          Becoming.total (Becoming.steps S n) fun t =>
            Becoming.total (alive (t + 1)) fun f => Becoming.mark (W.Arises t f)
@Becoming.Flow.takers_le_covering : ∀ {F C : Type} {W : Becoming.Web F C} {L : Becoming.Flow F C} {cs : List C}
  {t : Nat} {l : List F},
  Becoming.Distinct (L.present t) →
    (∀ (f : F) (c : C), f ∈ L.present t → 0 < L.take t f c → W.active t f) →
      (∀ (f : F), W.active t f → f ∈ l) → L.takers cs t ≤ l.length
@Becoming.Flow.More.grows_covering : ∀ {F C : Type} {W : Becoming.Web F C} {L : Becoming.Flow F C} {cs : List C}
  {S : Nat} {l : Nat → List F},
  (∀ (t : Nat), S ≤ t → ∀ (f : F), W.active t f → f ∈ l t) →
    (∀ (t : Nat), S ≤ t → Becoming.Distinct (L.present t)) →
      (∀ (t : Nat) (f : F) (c : C), S ≤ t → f ∈ L.present t → 0 < L.take t f c → W.active t f) →
        L.More cs → ∀ (N K : Nat), ∃ t, N ≤ t ∧ K < (l t).length
@Becoming.Flow.More.grows : ∀ {F C : Type} {W : Becoming.Web F C} {L : Becoming.Flow F C} {cs : List C}
  {alive : Nat → List F},
  W.Census alive →
    (∀ (t : Nat), Becoming.Distinct (L.present t)) →
      L.Taking W → L.More cs → ∀ (N K : Nat), ∃ t, N ≤ t ∧ K < (alive t).length
@Becoming.Flow.More.arising_never_stops_covering : ∀ {F C : Type} {W : Becoming.Web F C} {L : Becoming.Flow F C}
  {cs : List C} {S : Nat},
  (∀ (N : Nat), ∃ M l, N ≤ M ∧ ∀ (f : F), W.active M f → f ∈ l) →
    (∀ (t : Nat), S ≤ t → Becoming.Distinct (L.present t)) →
      (∀ (t : Nat) (f : F) (c : C), S ≤ t → f ∈ L.present t → 0 < L.take t f c → W.active t f) →
        L.More cs → ¬∃ N, ∀ (t : Nat) (f : F), N ≤ t → ¬W.Arises t f
@Becoming.Flow.More.unceasing_covering : ∀ {F C : Type} {W : Becoming.Web F C} {L : Becoming.Flow F C} {cs : List C}
  {S : Nat} (decided : (s : Nat) → (f : F) → S ≤ s → Decidable (W.active s f)),
  (∀ (N : Nat), ∃ M l, N ≤ M ∧ ∀ (f : F), W.active M f → f ∈ l) →
    (∀ (t : Nat), S ≤ t → Becoming.Distinct (L.present t)) →
      (∀ (t : Nat) (f : F) (c : C), S ≤ t → f ∈ L.present t → 0 < L.take t f c → W.active t f) → L.More cs → W.Unceasing
@Becoming.Flow.More.unceasing : ∀ {F C : Type} {W : Becoming.Web F C} [(t : Nat) → (f : F) → Decidable (W.active t f)]
  {L : Becoming.Flow F C} {cs : List C} {alive : Nat → List F},
  W.Census alive → (∀ (t : Nat), Becoming.Distinct (L.present t)) → L.Taking W → L.More cs → W.Unceasing
Becoming.Expansion.distinct : ∀ (t : Nat), Becoming.Distinct (Becoming.Expansion.present t)
Becoming.Expansion.listed : ∀ (t : Nat) (f : Becoming.Expansion.Kind × Nat),
  f.snd < t → f ∈ Becoming.Expansion.present t
Becoming.Expansion.census : Becoming.Expansion.web.Census Becoming.Expansion.present
Becoming.Expansion.counted : Becoming.Expansion.web.Census Becoming.Expansion.present ∧
  (∀ (t : Nat), Becoming.Distinct (Becoming.Expansion.flow.present t)) ∧
    Becoming.Expansion.flow.Taking Becoming.Expansion.web ∧ Becoming.Expansion.flow.More [()]
Becoming.Cycle.distinct : ∀ (t : Nat), Becoming.Distinct (Becoming.Cycle.present t)
Becoming.Cycle.listed : ∀ (t n : Nat), n < t → n ∈ Becoming.Cycle.present t
Becoming.Cycle.census : Becoming.Cycle.web.Census Becoming.Cycle.present
Becoming.Cycle.counted : Becoming.Cycle.web.Census Becoming.Cycle.present ∧
  (∀ (t : Nat), Becoming.Distinct (Becoming.Cycle.flow.present t)) ∧
    Becoming.Cycle.flow.Taking Becoming.Cycle.web ∧ Becoming.Cycle.flow.More [()]
Becoming.Oscillation.pair : Becoming.Distinct
  [Becoming.Oscillation.Formation.source, Becoming.Oscillation.Formation.oscillator]
Becoming.Oscillation.census : Becoming.Oscillation.web.Census Becoming.Oscillation.alive
Becoming.Oscillation.counted : Becoming.Oscillation.web.Census Becoming.Oscillation.alive ∧
  (∀ (t : Nat), Becoming.Distinct (Becoming.Oscillation.flow.present t)) ∧
    Becoming.Oscillation.flow.Taking Becoming.Oscillation.web ∧
      Becoming.Oscillation.web.Unceasing ∧ ¬Becoming.Oscillation.flow.More [()]
Becoming.Dormant.more_without_arising : Becoming.Expansion.flow.Balances Becoming.Dormant.web ∧
  Becoming.Expansion.flow.Acting Becoming.Dormant.web ∧
    Becoming.Expansion.flow.Taking Becoming.Dormant.web ∧
      Becoming.Expansion.flow.Capacity [()] 1 ∧
        Becoming.Dormant.web.Dependent ∧
          Becoming.Expansion.flow.More [()] ∧
            ∀ (t : Nat) (f : Becoming.Expansion.Kind × Nat), ¬Becoming.Dormant.web.Arises t f
Becoming.Repeated.ones : ∀ (n : Nat), (Becoming.total (Becoming.Repeated.rep n) fun x => 1) = n
Becoming.Repeated.census : Becoming.Repeated.web.Census fun x => [()]
Becoming.Repeated.more_without_arising : (Becoming.Repeated.web.Census fun x => [()]) ∧
  Becoming.Repeated.flow.Balances Becoming.Repeated.web ∧
    Becoming.Repeated.flow.Acting Becoming.Repeated.web ∧
      Becoming.Repeated.flow.Taking Becoming.Repeated.web ∧
        Becoming.Repeated.flow.More [()] ∧
          (¬∀ (t : Nat), Becoming.Distinct (Becoming.Repeated.flow.present t)) ∧
            ∀ (t : Nat) (f : Unit), ¬Becoming.Repeated.web.Arises t f
@Becoming.Inactive.ones : ∀ {q : Nat → Nat},
  q 0 = 0 → (∀ (m : Nat), q (m + 1) = 1) → ∀ (n : Nat), Becoming.total (Becoming.Inactive.present n) q = n
Becoming.Inactive.gives : ∀ (t n : Nat),
  (Becoming.total (Becoming.Inactive.present n) fun m => Becoming.Inactive.flow.give t m ()) = t
Becoming.Inactive.present_le : ∀ (n m : Nat), m ∈ Becoming.Inactive.present n → m ≤ n
Becoming.Inactive.distinct : ∀ (n : Nat), Becoming.Distinct (Becoming.Inactive.present n)
Becoming.Inactive.more_without_arising : Becoming.Inactive.flow.Balances Becoming.Inactive.web ∧
  Becoming.Inactive.flow.Acting Becoming.Inactive.web ∧
    Becoming.Inactive.web.Census Becoming.Inactive.alive ∧
      (∀ (t : Nat), Becoming.Distinct (Becoming.Inactive.flow.present t)) ∧
        Becoming.Inactive.flow.More [()] ∧
          ¬Becoming.Inactive.flow.Taking Becoming.Inactive.web ∧ ∀ (t f : Nat), ¬Becoming.Inactive.web.Arises t f
Becoming.Unrecorded.drawing_without_taking : Becoming.Unrecorded.flow.Balances Becoming.Cycle.web ∧
  Becoming.Unrecorded.flow.Acting Becoming.Cycle.web ∧
    Becoming.Unrecorded.flow.Taking Becoming.Cycle.web ∧
      Becoming.Cycle.web.Dependent ∧
        (∀ (K : Nat),
            ∃ T,
              ∀ (t : Nat),
                T ≤ t →
                  ∀ (n : Nat),
                    n < K →
                      Becoming.Cycle.web.active t n ∧
                        Becoming.Cycle.web.requires t n () ∧ Becoming.Cycle.web.draws t n ()) ∧
          ¬Becoming.Unrecorded.flow.More [()]
