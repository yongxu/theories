  (∀ (t : Nat), stopping.needG ≤ stopping.level t ∧ stopping.needF ≤ stopping.level t) →
    ∀ (e : RelationalRenewal.Law.Part × Nat),
      Becoming.Ranking.wholeRun (Becoming.Ranking.restraint stopping overdrawing) Becoming.Ranking.Restraint.stops e ∧
        Becoming.Ranking.stepwise (Becoming.Ranking.restraint stopping overdrawing) Becoming.Ranking.Restraint.stops e
@Becoming.Ranking.restraint_ranks : ∀ {stopping overdrawing : RelationalRenewal.Law},
  (∀ (t : Nat), stopping.needG ≤ stopping.level t ∧ stopping.needF ≤ stopping.level t) →
    0 < overdrawing.needG →
      overdrawing.needF ≤ overdrawing.needG →
        ∀ {T0 : Nat},
          (∀ (t : Nat), T0 ≤ t → overdrawing.renew + overdrawing.contrib t < overdrawing.draw t) →
            Becoming.Ranking.ExtendsUnder (Becoming.Ranking.wholeRun (Becoming.Ranking.restraint stopping overdrawing))
                Becoming.Ranking.Restraint.overdraws Becoming.Ranking.Restraint.stops ∧
              Becoming.Ranking.ExtendsUnder
                  (Becoming.Ranking.stepwise (Becoming.Ranking.restraint stopping overdrawing))
                  Becoming.Ranking.Restraint.overdraws Becoming.Ranking.Restraint.stops ∧
                (∀ (Better : Becoming.Ranking.Restraint → Becoming.Ranking.Restraint → Prop),
                    Becoming.Ranking.ComparisonUnder
                        (Becoming.Ranking.wholeRun (Becoming.Ranking.restraint stopping overdrawing)) Better →
                      Better Becoming.Ranking.Restraint.overdraws Becoming.Ranking.Restraint.stops) ∧
                  ∀ (Better : Becoming.Ranking.Restraint → Becoming.Ranking.Restraint → Prop),
                    Becoming.Ranking.ComparisonUnder
                        (Becoming.Ranking.stepwise (Becoming.Ranking.restraint stopping overdrawing)) Better →
                      Better Becoming.Ranking.Restraint.overdraws Becoming.Ranking.Restraint.stops
