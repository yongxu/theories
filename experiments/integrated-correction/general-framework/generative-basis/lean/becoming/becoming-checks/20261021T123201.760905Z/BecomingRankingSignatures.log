@Becoming.Ranking.extendsUnder_iff_of_exact : ∀ {W E : Type} {reading : W → E → Prop} {w w' : W} {A : E → Prop},
  (∀ (e : E), reading w' e ↔ A e) →
    (Becoming.Ranking.ExtendsUnder reading w w' ↔ (∀ (e : E), reading w e → A e) ∧ ∃ e, A e ∧ ¬reading w e)
@Becoming.Ranking.wholeRun_of_renewed : ∀ {W F C : Type} {U : W → Becoming.Web F C} {w : W},
  (∀ (c : C), (U w).Renewed c) → ∀ (e : F × Nat), Becoming.Ranking.wholeRun U w e ↔ (U w).active e.snd e.fst
@Becoming.Ranking.stepwise_of_renewed : ∀ {W F C : Type} {U : W → Becoming.Web F C} {w : W},
  (∀ (c : C), (U w).Renewed c) → ∀ (e : F × Nat), Becoming.Ranking.stepwise U w e ↔ (U w).active e.snd e.fst
@Becoming.Ranking.renewed_extends_iff : ∀ {W F C : Type} {U : W → Becoming.Web F C} {w w' : W},
  (∀ (c : C), (U w').Renewed c) →
    (Becoming.Ranking.ExtendsUnder (Becoming.Ranking.wholeRun U) w w' ↔
        (∀ (e : F × Nat), Becoming.Ranking.wholeRun U w e → (U w').active e.snd e.fst) ∧
          ∃ e, (U w').active e.snd e.fst ∧ ¬Becoming.Ranking.wholeRun U w e) ∧
      (Becoming.Ranking.ExtendsUnder (Becoming.Ranking.stepwise U) w w' ↔
        (∀ (e : F × Nat), Becoming.Ranking.stepwise U w e → (U w').active e.snd e.fst) ∧
          ∃ e, (U w').active e.snd e.fst ∧ ¬Becoming.Ranking.stepwise U w e)
@Becoming.Ranking.renewed_active_extends_iff : ∀ {W F C : Type} {U : W → Becoming.Web F C} {w w' : W},
  (∀ (c : C), (U w').Renewed c) →
    (∀ (t : Nat) (f : F), (U w').active t f) →
      (Becoming.Ranking.ExtendsUnder (Becoming.Ranking.wholeRun U) w w' ↔ ∃ e, ¬Becoming.Ranking.wholeRun U w e) ∧
        (Becoming.Ranking.ExtendsUnder (Becoming.Ranking.stepwise U) w w' ↔ ∃ e, ¬Becoming.Ranking.stepwise U w e)
@Becoming.Ranking.active_of_renewed : ∀ {F C : Type} {U : Becoming.Web F C},
  Becoming.Ranking.ActiveWhereSupported U → (∀ (c : C), U.Renewed c) → ∀ (t : Nat) (f : F), U.active t f
@Becoming.Ranking.wholeRun_mono : ∀ {W F C : Type} {U : W → Becoming.Web F C} {w w' : W},
  (U w).Dependent →
    Becoming.Ranking.ActiveWhereSupported (U w') →
      Becoming.Ranking.Eases (U w) (U w') →
        ∀ {e : F × Nat}, Becoming.Ranking.wholeRun U w e → Becoming.Ranking.wholeRun U w' e
@Becoming.Ranking.wholeRun_extends_iff_of_eases : ∀ {W F C : Type} {U : W → Becoming.Web F C} {w w' : W},
  (U w).Dependent →
    Becoming.Ranking.ActiveWhereSupported (U w') →
      Becoming.Ranking.Eases (U w) (U w') →
        (Becoming.Ranking.ExtendsUnder (Becoming.Ranking.wholeRun U) w w' ↔
          ∃ e, Becoming.Ranking.wholeRun U w' e ∧ ¬Becoming.Ranking.wholeRun U w e)
Becoming.Ranking.undisturbed_sustains : ∀ (L : RelationalRenewal.Law),
  L.needG ≤ L.start → ∀ (t : Nat), L.start ≤ Becoming.Ranking.undisturbed L t
Becoming.Ranking.absent_sustains : ∀ (L : RelationalRenewal.Law),
  L.needG ≤ L.start →
    ∀ (t : Nat),
      (Becoming.Ranking.course L Becoming.Ranking.Course.absent).active t RelationalRenewal.Law.Part.sustaining
Becoming.Ranking.absent_renews : ∀ (L : RelationalRenewal.Law),
  L.needF ≤ L.needG →
    L.needG ≤ L.start → ∀ (c : Unit), (Becoming.Ranking.course L Becoming.Ranking.Course.absent).Renewed c
@Becoming.Ranking.withheld_of_extends : ∀ {L : RelationalRenewal.Law}
  {reading : Becoming.Ranking.Course → RelationalRenewal.Law.Part × Nat → Prop},
  (∀ (w : Becoming.Ranking.Course) (e : RelationalRenewal.Law.Part × Nat),
      reading w e → (Becoming.Ranking.course L w).active e.snd e.fst) →
    Becoming.Ranking.ExtendsUnder reading Becoming.Ranking.Course.occurs Becoming.Ranking.Course.absent →
      ∀ (t : Nat), ¬reading Becoming.Ranking.Course.occurs (RelationalRenewal.Law.Part.focal, t)
Becoming.Ranking.whole_run_extends : ∀ (L : RelationalRenewal.Law),
  0 < L.needG →
    L.needF ≤ L.needG →
      L.needG ≤ L.start →
        ∀ {T0 : Nat},
          (∀ (t : Nat), T0 ≤ t → L.renew + L.contrib t < L.draw t) →
            Becoming.Ranking.ExtendsUnder (Becoming.Ranking.wholeRun (Becoming.Ranking.course L))
              Becoming.Ranking.Course.occurs Becoming.Ranking.Course.absent
Becoming.Ranking.whole_run_ranks : ∀ (L : RelationalRenewal.Law),
  0 < L.needG →
    L.needF ≤ L.needG →
      L.needG ≤ L.start →
        ∀ {T0 : Nat},
          (∀ (t : Nat), T0 ≤ t → L.renew + L.contrib t < L.draw t) →
            ∀ {Better : Becoming.Ranking.Course → Becoming.Ranking.Course → Prop},
              Becoming.Ranking.ComparisonUnder (Becoming.Ranking.wholeRun (Becoming.Ranking.course L)) Better →
                Better Becoming.Ranking.Course.occurs Becoming.Ranking.Course.absent
Becoming.Ranking.included_before_loss : ∀ (L : RelationalRenewal.Law) {t : Nat},
  L.needF ≤ L.level t →
    L.needG ≤ L.level (t + 1) →
      L.needF ≤ L.level (t + 1) →
        Becoming.Ranking.stepwise (Becoming.Ranking.course L) Becoming.Ranking.Course.occurs
          (RelationalRenewal.Law.Part.focal, t)
Becoming.Ranking.stepwise_unranked : ∀ (L : RelationalRenewal.Law),
  0 < L.needG →
    L.needF ≤ L.needG →
      L.needG ≤ L.start →
        ∀ {T0 : Nat},
          (∀ (t : Nat), T0 ≤ t → L.renew + L.contrib t < L.draw t) →
            ∀ {t : Nat},
              Becoming.Ranking.stepwise (Becoming.Ranking.course L) Becoming.Ranking.Course.occurs
                  (RelationalRenewal.Law.Part.focal, t) →
                ¬Becoming.Ranking.ExtendsUnder (Becoming.Ranking.stepwise (Becoming.Ranking.course L))
                      Becoming.Ranking.Course.occurs Becoming.Ranking.Course.absent ∧
                  ¬Becoming.Ranking.ExtendsUnder (Becoming.Ranking.stepwise (Becoming.Ranking.course L))
                      Becoming.Ranking.Course.absent Becoming.Ranking.Course.occurs
@Becoming.Ranking.preferOccurs_only : ∀ {reading : Becoming.Ranking.Course → RelationalRenewal.Law.Part × Nat → Prop},
  ¬Becoming.Ranking.ExtendsUnder reading Becoming.Ranking.Course.occurs Becoming.Ranking.Course.absent →
    ∀ {w w' : Becoming.Ranking.Course},
      Becoming.Ranking.preferOccurs reading w w' →
        w = Becoming.Ranking.Course.absent ∧ w' = Becoming.Ranking.Course.occurs
@Becoming.Ranking.admits_occurrence : ∀ {reading : Becoming.Ranking.Course → RelationalRenewal.Law.Part × Nat → Prop},
  ¬Becoming.Ranking.ExtendsUnder reading Becoming.Ranking.Course.occurs Becoming.Ranking.Course.absent →
    Becoming.Ranking.ComparisonUnder reading (Becoming.Ranking.preferOccurs reading) ∧
      Becoming.Ranking.preferOccurs reading Becoming.Ranking.Course.absent Becoming.Ranking.Course.occurs ∧
        ¬Becoming.Ranking.preferOccurs reading Becoming.Ranking.Course.occurs Becoming.Ranking.Course.absent ∧
          (∀ (w : Becoming.Ranking.Course), ¬Becoming.Ranking.preferOccurs reading w w) ∧
            ∀ (w w' w'' : Becoming.Ranking.Course),
              Becoming.Ranking.preferOccurs reading w w' →
                Becoming.Ranking.preferOccurs reading w' w'' → Becoming.Ranking.preferOccurs reading w w''
Becoming.Ranking.readings_rank_differently : ∀ (L : RelationalRenewal.Law),
  0 < L.needG →
    L.needF ≤ L.needG →
      L.needG ≤ L.start →
        ∀ {T0 : Nat},
          (∀ (t : Nat), T0 ≤ t → L.renew + L.contrib t < L.draw t) →
            ∀ {t : Nat},
              L.needF ≤ L.level t →
                L.needG ≤ L.level (t + 1) →
                  L.needF ≤ L.level (t + 1) →
                    (∀ (Better : Becoming.Ranking.Course → Becoming.Ranking.Course → Prop),
                        Becoming.Ranking.ComparisonUnder (Becoming.Ranking.wholeRun (Becoming.Ranking.course L))
                            Better →
                          Better Becoming.Ranking.Course.occurs Becoming.Ranking.Course.absent) ∧
                      ¬Becoming.Ranking.ExtendsUnder (Becoming.Ranking.stepwise (Becoming.Ranking.course L))
                            Becoming.Ranking.Course.occurs Becoming.Ranking.Course.absent ∧
                        ¬Becoming.Ranking.ExtendsUnder (Becoming.Ranking.stepwise (Becoming.Ranking.course L))
                              Becoming.Ranking.Course.absent Becoming.Ranking.Course.occurs ∧
                          Becoming.Ranking.ComparisonUnder (Becoming.Ranking.stepwise (Becoming.Ranking.course L))
                              (Becoming.Ranking.preferOccurs (Becoming.Ranking.stepwise (Becoming.Ranking.course L))) ∧
                            Becoming.Ranking.preferOccurs (Becoming.Ranking.stepwise (Becoming.Ranking.course L))
                              Becoming.Ranking.Course.absent Becoming.Ranking.Course.occurs
Becoming.Ranking.malignant_ranking : (∀ (Better : Becoming.Ranking.Course → Becoming.Ranking.Course → Prop),
    Becoming.Ranking.ComparisonUnder
        (Becoming.Ranking.wholeRun (Becoming.Ranking.course RelationalRenewal.Law.malignant)) Better →
      Better Becoming.Ranking.Course.occurs Becoming.Ranking.Course.absent) ∧
  ¬Becoming.Ranking.ExtendsUnder (Becoming.Ranking.stepwise (Becoming.Ranking.course RelationalRenewal.Law.malignant))
        Becoming.Ranking.Course.occurs Becoming.Ranking.Course.absent ∧
    ¬Becoming.Ranking.ExtendsUnder (Becoming.Ranking.stepwise (Becoming.Ranking.course RelationalRenewal.Law.malignant))
          Becoming.Ranking.Course.absent Becoming.Ranking.Course.occurs ∧
      Becoming.Ranking.ComparisonUnder
          (Becoming.Ranking.stepwise (Becoming.Ranking.course RelationalRenewal.Law.malignant))
          (Becoming.Ranking.preferOccurs
            (Becoming.Ranking.stepwise (Becoming.Ranking.course RelationalRenewal.Law.malignant))) ∧
        Becoming.Ranking.preferOccurs
          (Becoming.Ranking.stepwise (Becoming.Ranking.course RelationalRenewal.Law.malignant))
          Becoming.Ranking.Course.absent Becoming.Ranking.Course.occurs
