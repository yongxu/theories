  ¬Becoming.Branching.Reachable P n s → ∀ (k : Nat), ¬Becoming.Branching.Reachable P (n + k) s
@Becoming.Branching.trace_last : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} {x s : S} {as : List A},
  Generative.Trace P x as s → x = s ∨ ∃ y a, Becoming.Reach P x y ∧ P.step y a s
@Becoming.Branching.Returns.pred : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} {s : S},
  Becoming.Branching.Returns P s → ∃ x a, P.step x a s ∧ Becoming.Branching.Returns P x
