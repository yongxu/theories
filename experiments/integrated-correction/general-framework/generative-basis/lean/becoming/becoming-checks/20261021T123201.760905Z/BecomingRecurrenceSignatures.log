@Becoming.split_at_head : ∀ {S : Type u_1} {g : Nat → S} {a : S} {l : List S} (K : Nat),
  (∀ (n : Nat), n ≤ K → g n = a ∨ g n ∈ l) →
    (∃ i j, i < j ∧ j ≤ K ∧ g i = g j) ∨
      (∀ (n : Nat), n ≤ K → g n ∈ l) ∨ ∃ m, m ≤ K ∧ g m = a ∧ ∀ (n : Nat), n ≤ K → n ≠ m → g n ∈ l
@Becoming.revisits_within : ∀ {S : Type u_1} (l : List S) (g : Nat → S),
  (∀ (n : Nat), n ≤ l.length → g n ∈ l) → ∃ i j, i < j ∧ j ≤ l.length ∧ g i = g j
@Becoming.revisits_of_held : ∀ {S : Type u_1} {g : Nat → S} {l : List S}, (∀ (n : Nat), g n ∈ l) → Becoming.Revisits g
@Becoming.revisits_from : ∀ {S : Type u_1} {g : Nat → S} {l : List S},
  (∀ (n : Nat), g n ∈ l) → ∀ (T : Nat), ∃ i j, T ≤ i ∧ i < j ∧ g i = g j
@Becoming.unheld_of_new : ∀ {S : Type u_1} {g : Nat → S},
  (∀ (i j : Nat), i < j → g i ≠ g j) → ∀ (l : List S), ¬∀ (n : Nat), n ≤ l.length → g n ∈ l
@Becoming.unlisted_of_new : ∀ {S : Type u_1} {g : Nat → S},
  (∀ (i j : Nat), i < j → g i ≠ g j) → ¬∃ l, ∀ (n : Nat), g n ∈ l
@Becoming.le_sumOver : ∀ {S : Type u_1} (q : S → Nat) {s : S} {l : List S}, s ∈ l → q s ≤ Becoming.sumOver q l
@Becoming.never_falls_over : ∀ {S : Type u_1} {q : S → Nat} {g : Nat → S},
  (∀ (n : Nat), q (g n) ≤ q (g (n + 1))) → ∀ (T k : Nat), q (g T) ≤ q (g (T + k))
@Becoming.Marks.mono : ∀ {S : Type u_1} {q : S → Nat} {g : Nat → S},
  Becoming.Marks q g → ∀ (T k : Nat), q (g T) ≤ q (g (T + k))
@Becoming.Marks.change_not_recurring : ∀ {S : Type u_1} {q : S → Nat} {g : Nat → S},
  Becoming.Marks q g → ∀ {l : List S}, (∀ (n : Nat), g n ∈ l) → ¬∀ (T : Nat), ∃ k, T ≤ k ∧ g (k + 1) ≠ g k
@Becoming.not_marks : ∀ {S : Type u_1} {g : Nat → S} {l : List S},
  (∀ (n : Nat), g n ∈ l) → (∀ (T : Nat), ∃ k, T ≤ k ∧ g (k + 1) ≠ g k) → ∀ (q : S → Nat), ¬Becoming.Marks q g
@Becoming.Law.orbit_add : ∀ {S : Type u_1} (next : S → S) (s : S) (m n : Nat),
  Becoming.Law.orbit next s (m + n) = Becoming.Law.orbit next (Becoming.Law.orbit next s m) n
