  Becoming.Branching.Returns P s →
    ∀ (n : Nat), ∃ x as, as.length = n ∧ Generative.Trace P x as s ∧ Becoming.Branching.Returns P x
@Becoming.Branching.Returns.reachable : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} {s : S},
  Becoming.Branching.Returns P s → ∀ (n : Nat), Becoming.Branching.Reachable P n s
