@Becoming.le_succ_cases : ∀ {n K : Nat}, n ≤ K + 1 → n ≤ K ∨ n = K + 1
@Becoming.gap_of_lt : ∀ {i j : Nat}, i < j → ∃ d, j = i + (d + 1)
