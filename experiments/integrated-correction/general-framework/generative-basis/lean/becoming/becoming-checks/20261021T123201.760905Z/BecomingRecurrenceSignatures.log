  (Becoming.Law.run next s).state = Becoming.Law.orbit next s
@Becoming.Branching.Merges.not_lossless : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A},
  Becoming.Branching.Merges P → ¬Becoming.Branching.Lossless P
@Becoming.Branching.Reachable.earlier : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} {n : Nat} {s : S},
  Becoming.Branching.Reachable P (n + 1) s → Becoming.Branching.Reachable P n s
