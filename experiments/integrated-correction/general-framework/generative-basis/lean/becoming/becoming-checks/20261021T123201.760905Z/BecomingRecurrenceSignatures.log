  Becoming.Branching.Lossless P →
    ∀ (r : Becoming.Run P) {l : List S}, (∀ (n : Nat), r.state n ∈ l) → ∃ d, 0 < d ∧ r.state d = r.state 0
@Becoming.Branching.Lossless.recurs : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A},
  Becoming.Branching.Lossless P →
    ∀ (r : Becoming.Run P) {l : List S},
      (∀ (n : Nat), r.state n ∈ l) → ∀ (i : Nat), ∃ d, 0 < d ∧ r.state (i + d) = r.state i
