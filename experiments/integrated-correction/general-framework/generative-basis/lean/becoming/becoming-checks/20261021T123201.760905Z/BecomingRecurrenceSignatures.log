  Becoming.Law.orbit next s (n + 1) = Becoming.Law.orbit next (next s) n
@Becoming.Law.orbit_mul : ∀ {S : Type u_1} {next : S → S} {s : S} {p : Nat},
  Becoming.Law.orbit next s p = s → ∀ (k : Nat), Becoming.Law.orbit next s (p * k) = s
Becoming.Branching.units_length : ∀ (n : Nat), (List.replicate n ()).length = n
@Becoming.Branching.law_trace_of : ∀ {S : Type u_1} {next : S → S} (as : List Unit) (x t : S),
  Becoming.Law.orbit next x as.length = t → Generative.Trace (Becoming.Law.process next) x as t
