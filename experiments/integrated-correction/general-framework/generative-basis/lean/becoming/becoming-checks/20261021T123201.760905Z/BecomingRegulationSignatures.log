  {c : C},
  L.BalancesOn W [c] t → (L.WithinGap W m t c ↔ Becoming.Regulation.Between m (W.level t c) (W.level (t + 1) c))
@Becoming.Flow.gap_le_of_within : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {m t : Nat} {c : C},
  L.BalancesOn W [c] t → L.WithinGap W m t c → Becoming.gap (W.level (t + 1) c) m ≤ Becoming.gap (W.level t c) m
@Becoming.Flow.gap_falls : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {m t : Nat} {c : C},
  L.BalancesOn W [c] t →
    L.WithinGap W m t c →
      L.Opposes W m t c → W.level t c ≠ m → Becoming.gap (W.level (t + 1) c) m + 1 ≤ Becoming.gap (W.level t c) m
@Becoming.Flow.regulates_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {m T : Nat} {c : C}
  (n : Nat),
  (∀ (k : Nat), k < n → L.BalancesOn W [c] (T + k)) →
    (∀ (k : Nat), k < n → L.WithinGap W m (T + k) c) →
      (∀ (k : Nat), k < n → L.Opposes W m (T + k) c) →
        Becoming.gap (W.level (T + n) c) m ≤ Becoming.gap (W.level T c) m - n
@Becoming.Flow.settles_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {m T : Nat} {c : C},
  (∀ (k : Nat), L.BalancesOn W [c] (T + k)) →
    (∀ (k : Nat), L.WithinGap W m (T + k) c) →
      (∀ (k : Nat), L.Opposes W m (T + k) c) → ∀ (j : Nat), W.level (T + Becoming.gap (W.level T c) m + j) c = m
@Becoming.Flow.settles_from : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {m T : Nat} {c : C},
  (∀ (k : Nat), L.BalancesOn W [c] (T + k)) →
    (∀ (k : Nat), L.WithinGap W m (T + k) c) →
      (∀ (k : Nat), L.Opposes W m (T + k) c) → ∀ {t : Nat}, T + Becoming.gap (W.level T c) m ≤ t → W.level t c = m
@Becoming.Flow.stays_between_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {m T : Nat} {c : C}
  (n : Nat),
  (∀ (k : Nat), k < n → L.BalancesOn W [c] (T + k)) →
    (∀ (k : Nat), k < n → L.WithinGap W m (T + k) c) → Becoming.Regulation.Between m (W.level T c) (W.level (T + n) c)
@Becoming.Flow.regulates : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    ∀ {m T : Nat} {c : C} (n : Nat),
      (∀ (k : Nat), k < n → L.WithinGap W m (T + k) c) →
        (∀ (k : Nat), k < n → L.Opposes W m (T + k) c) →
          Becoming.gap (W.level (T + n) c) m ≤ Becoming.gap (W.level T c) m - n
@Becoming.Flow.settles : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    ∀ {m T : Nat} {c : C},
      (∀ (k : Nat), L.WithinGap W m (T + k) c) →
        (∀ (k : Nat), L.Opposes W m (T + k) c) → ∀ {t : Nat}, T + Becoming.gap (W.level T c) m ≤ t → W.level t c = m
@Becoming.Flow.restores_exactly : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    ∀ {m T : Nat} {c : C},
      W.level T c ≤ m →
        (∀ (k : Nat), L.WithinGap W m (T + k) c) →
          (∀ (k : Nat), L.Opposes W m (T + k) c) → ∀ {t : Nat}, T + (m - W.level T c) ≤ t → W.level t c = m
@Becoming.Flow.withinGap_iff_of_above : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {m t : Nat}
  {c : C}, L.BalancesOn W [c] t → L.Opposes W m t c → m < W.level t c → (L.WithinGap W m t c ↔ m ≤ W.level (t + 1) c)
@Becoming.Flow.withinGap_iff_of_below : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {m t : Nat}
  {c : C}, L.BalancesOn W [c] t → L.Opposes W m t c → W.level t c < m → (L.WithinGap W m t c ↔ W.level (t + 1) c ≤ m)
@Becoming.Flow.withinGap_iff_of_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {m t : Nat} {c : C},
  L.BalancesOn W [c] t → W.level t c = m → (L.WithinGap W m t c ↔ W.level (t + 1) c = m)
@Becoming.Flow.crosses_of_above : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {m t : Nat} {c : C},
  L.BalancesOn W [c] t → L.Opposes W m t c → m < W.level t c → ¬L.WithinGap W m t c → W.level (t + 1) c < m
@Becoming.Flow.crosses_of_below : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {m t : Nat} {c : C},
  L.BalancesOn W [c] t → L.Opposes W m t c → W.level t c < m → ¬L.WithinGap W m t c → m < W.level (t + 1) c
Becoming.Regulation.Overshooting.taken_eq : ∀ (t : Nat),
  Becoming.Regulation.Overshooting.flow.taken t () =
    Becoming.Regulation.Overshooting.amount (Becoming.Regulation.Overshooting.high t)
Becoming.Regulation.Overshooting.given_eq : ∀ (t : Nat),
  Becoming.Regulation.Overshooting.flow.given t () =
    Becoming.Regulation.Overshooting.back (Becoming.Regulation.Overshooting.high t)
Becoming.Regulation.Overshooting.balances : Becoming.Regulation.Overshooting.flow.Balances
  Becoming.Regulation.Overshooting.web
Becoming.Regulation.Overshooting.opposes : ∀ (t : Nat),
  Becoming.Regulation.Overshooting.flow.Opposes Becoming.Regulation.Overshooting.web 1 t ()
Becoming.Regulation.Overshooting.beyond : ∀ (t : Nat),
