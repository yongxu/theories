@Becoming.Regulation.gap_of_le : ∀ {x m : Nat}, m ≤ x → Becoming.gap x m = x - m
@Becoming.Regulation.gap_of_ge : ∀ {x m : Nat}, x ≤ m → Becoming.gap x m = m - x
