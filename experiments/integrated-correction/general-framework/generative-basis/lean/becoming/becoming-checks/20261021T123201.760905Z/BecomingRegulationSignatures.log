Becoming.Regulation.OneSided.balances : Becoming.Regulation.OneSided.flow.Balances Becoming.Regulation.OneSided.web
Becoming.Regulation.OneSided.within : ∀ (t : Nat),
  Becoming.Regulation.OneSided.flow.WithinGap Becoming.Regulation.OneSided.web 1 t ()
Becoming.Regulation.OneSided.opposes_below : ∀ (t : Nat),
  Becoming.Regulation.OneSided.web.level t () < 1 →
    Becoming.Regulation.OneSided.flow.taken t () < Becoming.Regulation.OneSided.flow.given t ()
