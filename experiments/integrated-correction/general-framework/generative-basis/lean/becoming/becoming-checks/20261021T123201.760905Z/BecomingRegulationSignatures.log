  y + k = x + g → (k ≤ g + (x - m) ∧ g ≤ k + (m - x) ↔ Becoming.Regulation.Between m x y)
@Becoming.Regulation.Between.gap_le : ∀ {m x y : Nat},
  Becoming.Regulation.Between m x y → Becoming.gap y m ≤ Becoming.gap x m
@Becoming.Regulation.sub_succ_le_of_lt : ∀ {m y x : Nat}, m ≤ y → y < x → y - m + 1 ≤ x - m
@Becoming.Regulation.sub_succ_le_of_gt : ∀ {m y x : Nat}, y ≤ m → x < y → m - y + 1 ≤ m - x
