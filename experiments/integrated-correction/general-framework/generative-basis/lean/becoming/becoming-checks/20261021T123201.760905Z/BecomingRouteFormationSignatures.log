@Becoming.RouteFormation.develop_course_removed : ∀ {y : Becoming.RouteFormation.Apparatus},
  Generative.Trace Becoming.RouteFormation.formationProcess (Becoming.RouteFormation.prepared 18 4)
      [Becoming.RouteFormation.FormationMove.develop] y →
