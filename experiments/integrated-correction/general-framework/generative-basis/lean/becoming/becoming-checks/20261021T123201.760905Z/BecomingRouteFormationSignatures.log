@Becoming.RouteFormation.replicate_append : ∀ {α : Type} (x : α) (n m : Nat),
  List.replicate m x ++ List.replicate n x = List.replicate (m + n) x
@Becoming.RouteFormation.not_mem_of_all : ∀ {α : Type} [inst : DecidableEq α] {x : α} {l : List α},
  (l.all fun y => decide (x ≠ y)) = true → ¬x ∈ l
Becoming.RouteFormation.programFor_operates : ∀ (c : Becoming.CodeAcquisition.Code) (e : Becoming.CodeAcquisition.Expr),
  Becoming.RouteFormation.operate (Becoming.RouteFormation.programFor c) e = Becoming.CodeAcquisition.eval c e
Becoming.RouteFormation.two_socket_routes : Becoming.RouteFormation.generatedRoutes 2 =
  [[false, false], [false, true], [true, false], [true, true]]
@Becoming.RouteFormation.mem_two_socket : ∀ {route : Becoming.RouteFormation.Route},
  route ∈ Becoming.RouteFormation.generatedRoutes 2 →
    route = [false, false] ∨ route = [false, true] ∨ route = [true, false] ∨ route = [true, true]
Becoming.RouteFormation.own_program_fits : ∀ (c : Becoming.CodeAcquisition.Code),
  Becoming.RouteFormation.fits (Becoming.RouteFormation.programFor c) (Becoming.CodeAcquisition.trialRecords c) = true
Becoming.RouteFormation.fits_agrees : ∀ (p : Becoming.RouteFormation.Program)
  (samples : List (Becoming.CodeAcquisition.Expr × List Bool)),
  Becoming.RouteFormation.fits p samples = true →
    ∀ (e : Becoming.CodeAcquisition.Expr) (answer : List Bool),
      (e, answer) ∈ samples → Becoming.RouteFormation.operate p e = answer
Becoming.RouteFormation.probe_identifies_route : ∀ (c : Becoming.CodeAcquisition.Code)
  (route : Becoming.RouteFormation.Route),
  c.first ≠ c.second →
    route ∈ Becoming.RouteFormation.generatedRoutes 2 →
      Becoming.RouteFormation.dispatch route [c.first] [c.second] =
          Becoming.CodeAcquisition.eval c Becoming.CodeAcquisition.orderProbe →
        route = Becoming.RouteFormation.routeFor c
Becoming.RouteFormation.accepted_transfers : ∀ (c : Becoming.CodeAcquisition.Code)
  (route : Becoming.RouteFormation.Route),
  c.first ≠ c.second →
    route ∈ Becoming.RouteFormation.generatedRoutes 2 →
      Becoming.RouteFormation.fits { first := c.first, second := c.second, route := route }
            (Becoming.CodeAcquisition.trialRecords c) =
          true →
        ∀ (e : Becoming.CodeAcquisition.Expr),
          Becoming.RouteFormation.operate { first := c.first, second := c.second, route := route } e =
            Becoming.CodeAcquisition.eval c e
Becoming.RouteFormation.equal_primitives_repeat : ∀ (c : Becoming.CodeAcquisition.Code),
  c.second = c.first →
    ∀ (e : Becoming.CodeAcquisition.Expr),
      Becoming.CodeAcquisition.eval c e = List.replicate (Becoming.RouteFormation.extent e) c.first
Becoming.RouteFormation.reversal_unseen : ∀ (b r : Bool) (e : Becoming.CodeAcquisition.Expr),
  Becoming.CodeAcquisition.eval { first := b, second := b, reversed := r } e =
    Becoming.CodeAcquisition.eval { first := b, second := b, reversed := !r } e
Becoming.RouteFormation.extended_transfers : ∀ (c : Becoming.CodeAcquisition.Code)
  (route : Becoming.RouteFormation.Route),
  route ∈ Becoming.RouteFormation.generatedRoutes 2 →
    Becoming.RouteFormation.fits { first := c.first, second := c.second, route := route }
          (Becoming.CodeAcquisition.trialRecords c ++
            [(Becoming.CodeAcquisition.novel, Becoming.CodeAcquisition.eval c Becoming.CodeAcquisition.novel)]) =
        true →
      ∀ (e : Becoming.CodeAcquisition.Expr),
        Becoming.RouteFormation.operate { first := c.first, second := c.second, route := route } e =
          Becoming.CodeAcquisition.eval c e
Becoming.RouteFormation.place_stock : ∀ (socket : Bool) (s : Becoming.RouteFormation.Apparatus),
  (Becoming.RouteFormation.place socket s).stock + (Becoming.RouteFormation.place socket s).drawn = s.stock + s.drawn
