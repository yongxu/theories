  (s : Becoming.RouteFormation.Apparatus),
  Generative.Trace Becoming.RouteFormation.formationProcess s ms (List.foldl Becoming.RouteFormation.formationStep s ms)
@Becoming.RouteFormation.trace_iff : ∀ {s t : Becoming.RouteFormation.Apparatus}
  {ms : List Becoming.RouteFormation.FormationMove},
  Generative.Trace Becoming.RouteFormation.formationProcess s ms t ↔
    t = List.foldl Becoming.RouteFormation.formationStep s ms
