  (m : Becoming.RouteFormation.FormationMove),
  (Becoming.RouteFormation.formationStep s m).stock + (Becoming.RouteFormation.formationStep s m).drawn =
    s.stock + s.drawn
@Becoming.RouteFormation.course_stock : ∀ {s t : Becoming.RouteFormation.Apparatus}
  {ms : List Becoming.RouteFormation.FormationMove},
  Generative.Trace Becoming.RouteFormation.formationProcess s ms t → t.stock + t.drawn = s.stock + s.drawn
@Becoming.RouteFormation.place_step_parts : ∀ {s t : Becoming.RouteFormation.Apparatus} {socket : Bool},
  Becoming.RouteFormation.formationProcess.step s (Becoming.RouteFormation.FormationMove.place socket) t →
    t.parts + t.usedParts = s.parts + s.usedParts
@Becoming.RouteFormation.inspect_installed : ∀ {s t : Becoming.RouteFormation.Apparatus}
  {e : Becoming.CodeAcquisition.Evidence},
  Becoming.RouteFormation.formationProcess.step s (Becoming.RouteFormation.FormationMove.inspect e) t →
    s.blocked = false →
      1 ≤ s.stock →
        t.installed =
          bif Becoming.RouteFormation.fits { first := e.first, second := e.second, route := s.wires } s.samples then
            some { first := e.first, second := e.second, route := s.wires }
          else none
@Becoming.RouteFormation.installed_of_test : ∀ {b : Bool} {p q : Becoming.RouteFormation.Program},
  (bif b then some p else none) = some q → b = true ∧ q = p
@Becoming.RouteFormation.inspection_transfers : ∀ {s t : Becoming.RouteFormation.Apparatus}
  {c : Becoming.CodeAcquisition.Code} {o : List Bool} {q : Becoming.RouteFormation.Program},
  Becoming.RouteFormation.formationProcess.step s
      (Becoming.RouteFormation.FormationMove.inspect { first := c.first, second := c.second, ordered := o }) t →
    s.blocked = false →
      1 ≤ s.stock →
        s.samples = Becoming.CodeAcquisition.trialRecords c →
          s.wires ∈ Becoming.RouteFormation.generatedRoutes 2 →
            c.first ≠ c.second →
              t.installed = some q →
                ∀ (x : Becoming.CodeAcquisition.Expr),
                  Becoming.RouteFormation.operate q x = Becoming.CodeAcquisition.eval c x
@Becoming.RouteFormation.extended_inspection_transfers : ∀ {s t : Becoming.RouteFormation.Apparatus}
  {c : Becoming.CodeAcquisition.Code} {o : List Bool} {q : Becoming.RouteFormation.Program},
  Becoming.RouteFormation.formationProcess.step s
      (Becoming.RouteFormation.FormationMove.inspect { first := c.first, second := c.second, ordered := o }) t →
    s.blocked = false →
      1 ≤ s.stock →
        s.samples =
            Becoming.CodeAcquisition.trialRecords c ++
              [(Becoming.CodeAcquisition.novel, Becoming.CodeAcquisition.eval c Becoming.CodeAcquisition.novel)] →
          s.wires ∈ Becoming.RouteFormation.generatedRoutes 2 →
            t.installed = some q →
              ∀ (x : Becoming.CodeAcquisition.Expr),
                Becoming.RouteFormation.operate q x = Becoming.CodeAcquisition.eval c x
@Becoming.RouteFormation.inspection_installs_own : ∀ {s t : Becoming.RouteFormation.Apparatus}
  {c : Becoming.CodeAcquisition.Code} {o : List Bool},
  Becoming.RouteFormation.formationProcess.step s
      (Becoming.RouteFormation.FormationMove.inspect { first := c.first, second := c.second, ordered := o }) t →
    s.blocked = false →
      1 ≤ s.stock →
        s.samples = Becoming.CodeAcquisition.trialRecords c →
          s.wires = Becoming.RouteFormation.routeFor c → t.installed = some (Becoming.RouteFormation.programFor c)
