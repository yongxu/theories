  (Becoming.RouteFormation.search e rs s).stock + (Becoming.RouteFormation.search e rs s).drawn = s.stock + s.drawn
Becoming.RouteFormation.develop_stock : ∀ (s : Becoming.RouteFormation.Apparatus),
  (Becoming.RouteFormation.develop s).stock + (Becoming.RouteFormation.develop s).drawn = s.stock + s.drawn
@Becoming.RouteFormation.sub_add_add : ∀ {k n : Nat}, k ≤ n → ∀ (d : Nat), n - k + (d + k) = n + d
Becoming.RouteFormation.encounter_stock : ∀ (c : Becoming.CodeAcquisition.Code) (e : Becoming.CodeAcquisition.Expr)
  (s : Becoming.RouteFormation.Apparatus),
  (Becoming.RouteFormation.encounter c e s).stock + (Becoming.RouteFormation.encounter c e s).drawn = s.stock + s.drawn
Becoming.RouteFormation.reconsider_stock : ∀ (s : Becoming.RouteFormation.Apparatus),
  (Becoming.RouteFormation.reconsider s).stock + (Becoming.RouteFormation.reconsider s).drawn = s.stock + s.drawn
