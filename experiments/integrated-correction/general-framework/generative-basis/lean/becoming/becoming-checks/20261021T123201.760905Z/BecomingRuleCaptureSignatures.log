@Becoming.RuleCapture.CarrierCounts.always_step : ∀
  {hR : Becoming.RuleCapture.CarrierCounts → Becoming.RuleCapture.CarrierCounts → Becoming.RuleCapture.CarrierCounts}
  (c : Becoming.RuleCapture.CarrierCounts × Becoming.RuleCapture.CarrierCounts) (t : Nat),
  (Becoming.Pace.paced Becoming.RuleCapture.CarrierCounts.select hR (fun x => true) c (t + 1)).fst.carrier =
      (Becoming.Pace.paced Becoming.RuleCapture.CarrierCounts.select hR (fun x => true) c t).fst.carrier *
        (Becoming.Pace.paced Becoming.RuleCapture.CarrierCounts.select hR (fun x => true) c t).snd.carrier ∧
    (Becoming.Pace.paced Becoming.RuleCapture.CarrierCounts.select hR (fun x => true) c (t + 1)).fst.other =
        (Becoming.Pace.paced Becoming.RuleCapture.CarrierCounts.select hR (fun x => true) c t).fst.other *
          (Becoming.Pace.paced Becoming.RuleCapture.CarrierCounts.select hR (fun x => true) c t).snd.other ∧
      (Becoming.Pace.paced Becoming.RuleCapture.CarrierCounts.select hR (fun x => true) c (t + 1)).snd =
        hR (Becoming.Pace.paced Becoming.RuleCapture.CarrierCounts.select hR (fun x => true) c t).fst
          (Becoming.Pace.paced Becoming.RuleCapture.CarrierCounts.select hR (fun x => true) c t).snd
Becoming.RuleCapture.Alternating.course_step : ∀ (t : Nat),
  (Becoming.RuleCapture.Alternating.course (t + 1)).fst.carrier =
      (Becoming.RuleCapture.Alternating.course t).fst.carrier *
        (Becoming.RuleCapture.Alternating.course t).snd.carrier ∧
    (Becoming.RuleCapture.Alternating.course (t + 1)).fst.other =
        (Becoming.RuleCapture.Alternating.course t).fst.other * (Becoming.RuleCapture.Alternating.course t).snd.other ∧
      (Becoming.RuleCapture.Alternating.course (t + 1)).snd =
        Becoming.RuleCapture.CarrierCounts.hi.threshold Becoming.RuleCapture.CarrierCounts.lo
          (Becoming.RuleCapture.Alternating.course t).fst (Becoming.RuleCapture.Alternating.course t).snd
