@Becoming.RuleCapture.Alternating.from_even : ∀ {k : Nat},
  (Becoming.RuleCapture.Alternating.course (2 * k)).fst.carrier =
        (Becoming.RuleCapture.Alternating.course (2 * k)).fst.other * 2 ∧
      (Becoming.RuleCapture.Alternating.course (2 * k)).snd = Becoming.RuleCapture.CarrierCounts.lo →
    (Becoming.RuleCapture.Alternating.course (2 * k)).fst.favours ∧
      (Becoming.RuleCapture.Alternating.course (2 * k + 1)).fst.carrier =
          (Becoming.RuleCapture.Alternating.course (2 * k)).fst.other * 2 ∧
        (Becoming.RuleCapture.Alternating.course (2 * k + 1)).fst.other =
            (Becoming.RuleCapture.Alternating.course (2 * k)).fst.other * 4 ∧
          (Becoming.RuleCapture.Alternating.course (2 * k + 1)).snd = Becoming.RuleCapture.CarrierCounts.hi ∧
            ¬(Becoming.RuleCapture.Alternating.course (2 * k + 1)).fst.favours
Becoming.RuleCapture.Alternating.even : ∀ (k : Nat),
  (Becoming.RuleCapture.Alternating.course (2 * k)).fst.carrier =
      (Becoming.RuleCapture.Alternating.course (2 * k)).fst.other * 2 ∧
    (Becoming.RuleCapture.Alternating.course (2 * k)).snd = Becoming.RuleCapture.CarrierCounts.lo
Becoming.RuleCapture.Alternating.odd : ∀ (k : Nat),
  (Becoming.RuleCapture.Alternating.course (2 * k + 1)).fst.other =
      (Becoming.RuleCapture.Alternating.course (2 * k + 1)).fst.carrier * 2 ∧
    (Becoming.RuleCapture.Alternating.course (2 * k + 1)).snd = Becoming.RuleCapture.CarrierCounts.hi
Becoming.RuleCapture.Alternating.alternates : ∀ (k : Nat),
  ¬Becoming.RuleCapture.CarrierCounts.order.le (Becoming.RuleCapture.Alternating.course (2 * k)).fst
        (Becoming.RuleCapture.Alternating.course (2 * k + 1)).fst ∧
    ¬Becoming.RuleCapture.CarrierCounts.order.le (Becoming.RuleCapture.Alternating.course (2 * k + 1)).snd
        (Becoming.RuleCapture.Alternating.course (2 * k + 2)).snd
Becoming.RuleCapture.Alternating.never_locked : ∀ (k : Nat),
  (¬Becoming.RuleCapture.Locked Becoming.RuleCapture.CarrierCounts.order Becoming.RuleCapture.CarrierCounts.favours
          (Becoming.RuleCapture.CarrierCounts.hi.threshold Becoming.RuleCapture.CarrierCounts.lo)
          (Becoming.RuleCapture.Alternating.course (2 * k)) ∧
      ¬Becoming.RuleCapture.Locked (Becoming.RuleCapture.reverse Becoming.RuleCapture.CarrierCounts.order)
          Becoming.RuleCapture.CarrierCounts.disfavours
          (Becoming.RuleCapture.CarrierCounts.hi.threshold Becoming.RuleCapture.CarrierCounts.lo)
          (Becoming.RuleCapture.Alternating.course (2 * k))) ∧
    ¬Becoming.RuleCapture.Locked Becoming.RuleCapture.CarrierCounts.order Becoming.RuleCapture.CarrierCounts.favours
          (Becoming.RuleCapture.CarrierCounts.hi.threshold Becoming.RuleCapture.CarrierCounts.lo)
          (Becoming.RuleCapture.Alternating.course (2 * k + 1)) ∧
      ¬Becoming.RuleCapture.Locked (Becoming.RuleCapture.reverse Becoming.RuleCapture.CarrierCounts.order)
          Becoming.RuleCapture.CarrierCounts.disfavours
          (Becoming.RuleCapture.CarrierCounts.hi.threshold Becoming.RuleCapture.CarrierCounts.lo)
          (Becoming.RuleCapture.Alternating.course (2 * k + 1))
Becoming.RuleCapture.Reversed.locked_down : Becoming.RuleCapture.Locked
  (Becoming.RuleCapture.reverse Becoming.RuleCapture.CarrierCounts.order) Becoming.RuleCapture.CarrierCounts.disfavours
  (Becoming.RuleCapture.CarrierCounts.hi.threshold Becoming.RuleCapture.CarrierCounts.lo)
  (Becoming.RuleCapture.Reversed.course 1)
Becoming.RuleCapture.Reversed.not_absorbed : Becoming.RuleCapture.Locked Becoming.RuleCapture.CarrierCounts.order
    Becoming.RuleCapture.CarrierCounts.favours
    (Becoming.RuleCapture.CarrierCounts.hi.threshold Becoming.RuleCapture.CarrierCounts.lo)
    (Becoming.RuleCapture.CarrierCounts.twoToOne, Becoming.RuleCapture.CarrierCounts.hi) ∧
  (∀ (k : Nat),
      Becoming.RuleCapture.CarrierCounts.order.le (Becoming.RuleCapture.Reversed.course (1 + k + 1)).fst
          (Becoming.RuleCapture.Reversed.course (1 + k)).fst ∧
        Becoming.RuleCapture.CarrierCounts.order.le (Becoming.RuleCapture.Reversed.course (1 + k + 1)).snd
          (Becoming.RuleCapture.Reversed.course (1 + k)).snd) ∧
    ¬Becoming.RuleCapture.CarrierCounts.order.le Becoming.RuleCapture.CarrierCounts.hi
        (Becoming.RuleCapture.Reversed.course 2).snd
Becoming.RuleCapture.Second.second_exact : ¬Becoming.RuleCapture.Locked Becoming.RuleCapture.CarrierCounts.order
      Becoming.RuleCapture.CarrierCounts.favours
      (Becoming.RuleCapture.CarrierCounts.hi.threshold Becoming.RuleCapture.CarrierCounts.twoToOne)
      (Becoming.RuleCapture.Second.course 1) ∧
  ¬Becoming.RuleCapture.CarrierCounts.order.le (Becoming.RuleCapture.Second.course 1).snd
        (Becoming.RuleCapture.Second.course 2).snd ∧
    Becoming.RuleCapture.Locked Becoming.RuleCapture.CarrierCounts.order Becoming.RuleCapture.CarrierCounts.favours
      (Becoming.RuleCapture.CarrierCounts.hi.threshold Becoming.RuleCapture.CarrierCounts.twoToOne)
      (Becoming.RuleCapture.Second.course 2)
