@Becoming.Pace.paced_shift : ∀ {S : Type u_1} {R : Type u_2} {f : S → R → S} {h : S → R → R} {reads : Nat → Bool}
  (c : S × R) (a k : Nat),
  Becoming.Pace.paced f h reads c (a + k) =
    Becoming.Pace.paced f h (fun u => reads (a + u)) (Becoming.Pace.paced f h reads c a) k
@Becoming.Pace.paced_fast_succ : ∀ {S : Type u_1} {R : Type u_2} {f : S → R → S} {h : S → R → R} {reads : Nat → Bool}
  (c : S × R) (t : Nat),
  (Becoming.Pace.paced f h reads c (t + 1)).fst =
    f (Becoming.Pace.paced f h reads c t).fst (Becoming.Pace.paced f h reads c t).snd
@Becoming.RuleCapture.ReadsShare.reverse : ∀ {S : Type u_1} {R : Type u_2} {P : Becoming.Ideals.Preorder S}
  {M : Becoming.Ideals.Preorder R} {h : S → R → R},
  Becoming.RuleCapture.ReadsShare P M h →
    Becoming.RuleCapture.ReadsShare (Becoming.RuleCapture.reverse P) (Becoming.RuleCapture.reverse M) h
@Becoming.RuleCapture.turn_locked : ∀ {S : Type u_1} {R : Type u_2} {P : Becoming.Ideals.Preorder S}
  {M : Becoming.Ideals.Preorder R} {favours : R → Prop} {f : S → R → S} {h : S → R → R},
  Becoming.RuleCapture.Raises P favours f →
    Becoming.RuleCapture.ReadsShare P M h →
      (∀ {g g' : R}, M.le g g' → favours g → favours g') →
        ∀ (b : Bool) (p : S × R),
          Becoming.RuleCapture.Locked M favours h p →
            Becoming.RuleCapture.Locked M favours h (Becoming.Pace.turn f h b p) ∧
              P.le p.fst (Becoming.Pace.turn f h b p).fst ∧ M.le p.snd (Becoming.Pace.turn f h b p).snd
@Becoming.RuleCapture.locked_stays : ∀ {S : Type u_1} {R : Type u_2} {P : Becoming.Ideals.Preorder S}
  {M : Becoming.Ideals.Preorder R} {favours : R → Prop} {f : S → R → S} {h : S → R → R} {reads : Nat → Bool},
  Becoming.RuleCapture.Raises P favours f →
    Becoming.RuleCapture.ReadsShare P M h →
      (∀ {g g' : R}, M.le g g' → favours g → favours g') →
        ∀ {c : S × R} {t : Nat},
          Becoming.RuleCapture.Locked M favours h (Becoming.Pace.paced f h reads c t) →
            ∀ (k : Nat), Becoming.RuleCapture.Locked M favours h (Becoming.Pace.paced f h reads c (t + k))
@Becoming.RuleCapture.locked_rises : ∀ {S : Type u_1} {R : Type u_2} {P : Becoming.Ideals.Preorder S}
  {M : Becoming.Ideals.Preorder R} {favours : R → Prop} {f : S → R → S} {h : S → R → R} {reads : Nat → Bool},
  Becoming.RuleCapture.Raises P favours f →
    Becoming.RuleCapture.ReadsShare P M h →
      (∀ {g g' : R}, M.le g g' → favours g → favours g') →
        ∀ {c : S × R} {t : Nat},
          Becoming.RuleCapture.Locked M favours h (Becoming.Pace.paced f h reads c t) →
            ∀ (k : Nat),
              P.le (Becoming.Pace.paced f h reads c (t + k)).fst (Becoming.Pace.paced f h reads c (t + k + 1)).fst ∧
                M.le (Becoming.Pace.paced f h reads c (t + k)).snd (Becoming.Pace.paced f h reads c (t + k + 1)).snd
@Becoming.RuleCapture.locked_not_below : ∀ {S : Type u_1} {R : Type u_2} {P : Becoming.Ideals.Preorder S}
  {M : Becoming.Ideals.Preorder R} {favours : R → Prop} {f : S → R → S} {h : S → R → R} {reads : Nat → Bool},
  Becoming.RuleCapture.Raises P favours f →
    Becoming.RuleCapture.ReadsShare P M h →
      (∀ {g g' : R}, M.le g g' → favours g → favours g') →
        ∀ {c : S × R} {t : Nat},
          Becoming.RuleCapture.Locked M favours h (Becoming.Pace.paced f h reads c t) →
            ∀ (k : Nat),
              P.le (Becoming.Pace.paced f h reads c t).fst (Becoming.Pace.paced f h reads c (t + k)).fst ∧
                M.le (Becoming.Pace.paced f h reads c t).snd (Becoming.Pace.paced f h reads c (t + k)).snd
@Becoming.RuleCapture.perturbation_invariant : ∀ {S : Type u_1} {R : Type u_2} {P : Becoming.Ideals.Preorder S}
  {M : Becoming.Ideals.Preorder R} {favours : R → Prop} {f : S → R → S} {h : S → R → R} {reads : Nat → Bool},
  Becoming.RuleCapture.Raises P favours f →
    Becoming.RuleCapture.ReadsShare P M h →
      (∀ {g g' : R}, M.le g g' → favours g → favours g') →
        ∀ {x : S} {g g' : R},
          Becoming.RuleCapture.Locked M favours h (x, g) →
            favours g' →
              ∀ (t : Nat),
                favours (Becoming.Pace.paced f h reads (x, g') t).snd ∧
                  P.le x (Becoming.Pace.paced f h reads (x, g') t).fst ∧
                    M.le g
                      (h (Becoming.Pace.paced f h reads (x, g') t).fst (Becoming.Pace.paced f h reads (x, g') t).snd)
@Becoming.RuleCapture.perturbation_absorbed : ∀ {S : Type u_1} {R : Type u_2} {P : Becoming.Ideals.Preorder S}
  {M : Becoming.Ideals.Preorder R} {favours : R → Prop} {f : S → R → S} {h : S → R → R} {reads : Nat → Bool},
  Becoming.RuleCapture.Raises P favours f →
    Becoming.RuleCapture.ReadsShare P M h →
      (∀ {g g' : R}, M.le g g' → favours g → favours g') →
        ∀ {x : S} {g g' : R},
          Becoming.RuleCapture.Locked M favours h (x, g) →
            favours g' →
              ∀ {r : Nat},
                reads r = true →
                  M.le g (Becoming.Pace.paced f h reads (x, g') (r + 1)).snd ∧
                    Becoming.RuleCapture.Locked M favours h (Becoming.Pace.paced f h reads (x, g') (r + 1))
@Becoming.RuleCapture.favours_after_reading : ∀ {S : Type u_1} {R : Type u_2} {favours : R → Prop} {f : S → R → S}
  {h : S → R → R} {reads : Nat → Bool},
  (∀ (x : S) (g : R), favours (h x g)) →
    ∀ {c : S × R} {r : Nat}, reads r = true → ∀ (k : Nat), favours (Becoming.Pace.paced f h reads c (r + 1 + k)).snd
@Becoming.RuleCapture.uniform_locks : ∀ {S : Type u_1} {R : Type u_2} {P : Becoming.Ideals.Preorder S}
  {M : Becoming.Ideals.Preorder R} {favours : R → Prop} {f : S → R → S} {h : S → R → R} {reads : Nat → Bool},
  Becoming.RuleCapture.Raises P favours f →
    Becoming.RuleCapture.ReadsShare P M h →
      (∀ (x : S) (g : R), favours (h x g)) →
        ∀ {c : S × R} {r r' : Nat},
          reads r = true →
            reads r' = true →
              r < r' → Becoming.RuleCapture.Locked M favours h (Becoming.Pace.paced f h reads c (r' + 1))
@Becoming.RuleCapture.favours_throughout : ∀ {S : Type u_1} {R : Type u_2} {favours : R → Prop} {f : S → R → S}
  {h : S → R → R} {reads : Nat → Bool},
  (∀ (x : S) (g : R), favours (h x g)) →
    ∀ {c : S × R}, favours c.snd → ∀ (t : Nat), favours (Becoming.Pace.paced f h reads c t).snd
@Becoming.RuleCapture.favouring_locks : ∀ {S : Type u_1} {R : Type u_2} {P : Becoming.Ideals.Preorder S}
  {M : Becoming.Ideals.Preorder R} {favours : R → Prop} {f : S → R → S} {h : S → R → R} {reads : Nat → Bool},
  Becoming.RuleCapture.Raises P favours f →
    Becoming.RuleCapture.ReadsShare P M h →
      (∀ (x : S) (g : R), favours (h x g)) →
        ∀ {c : S × R},
          favours c.snd →
            (∀ (t : Nat), P.le (Becoming.Pace.paced f h reads c t).fst (Becoming.Pace.paced f h reads c (t + 1)).fst) ∧
              ∀ (r : Nat),
                reads r = true → Becoming.RuleCapture.Locked M favours h (Becoming.Pace.paced f h reads c (r + 1))
@Becoming.RuleCapture.order_kept : ∀ {S : Type u_1} {R : Type u_2} {P : Becoming.Ideals.Preorder S}
  {M : Becoming.Ideals.Preorder R} {f : S → R → S} {h : S → R → R} {reads : Nat → Bool},
  (∀ (x y : S) (g g' : R), P.le x y → M.le g g' → P.le (f x g) (f y g')) →
    Becoming.RuleCapture.ReadsShare P M h →
      ∀ {c c' : S × R},
        P.le c.fst c'.fst →
          M.le c.snd c'.snd →
            ∀ (t : Nat),
              P.le (Becoming.Pace.paced f h reads c t).fst (Becoming.Pace.paced f h reads c' t).fst ∧
                M.le (Becoming.Pace.paced f h reads c t).snd (Becoming.Pace.paced f h reads c' t).snd
@Becoming.RuleCapture.perturbation_keeps_below : ∀ {S : Type u_1} {R : Type u_2} {P : Becoming.Ideals.Preorder S}
  {M : Becoming.Ideals.Preorder R} {f : S → R → S} {h : S → R → R} {reads : Nat → Bool},
  (∀ (x y : S) (g g' : R), P.le x y → M.le g g' → P.le (f x g) (f y g')) →
    Becoming.RuleCapture.ReadsShare P M h →
      ∀ {c : S × R} {a : Nat} {g' : R},
        M.le g' (Becoming.Pace.paced f h reads c a).snd →
          ∀ (k : Nat),
            P.le (Becoming.Pace.paced f h (fun u => reads (a + u)) ((Becoming.Pace.paced f h reads c a).fst, g') k).fst
                (Becoming.Pace.paced f h reads c (a + k)).fst ∧
              M.le
                (Becoming.Pace.paced f h (fun u => reads (a + u)) ((Becoming.Pace.paced f h reads c a).fst, g') k).snd
                (Becoming.Pace.paced f h reads c (a + k)).snd
