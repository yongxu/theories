@Becoming.RuleCapture.CarrierCounts.share_not_lower_counts : ∀ {α : Type} {kids : α → List α} {ms es : List α}
  {a b : Nat},
  (∀ (p : α), p ∈ ms → a ≤ (kids p).length) →
    (∀ (p : α), p ∈ es → (kids p).length ≤ b) →
      b ≤ a →
        ∀ (present : 0 < es.length) (present' : 0 < Becoming.offspringCount es kids),
          Becoming.RuleCapture.CarrierCounts.order.le { carrier := ms.length, other := es.length, other_pos := present }
            { carrier := Becoming.offspringCount ms kids, other := Becoming.offspringCount es kids,
              other_pos := present' }
