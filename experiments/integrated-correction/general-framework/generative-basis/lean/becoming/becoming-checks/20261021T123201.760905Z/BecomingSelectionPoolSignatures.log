  {select : (Nat → C → Nat) → Prop},
  W.SelectsThroughAll obs (fun x => x = o ∨ x = a) t select → W.SelectsThrough (W.ReadsCouplings obs o a) o t select
@Becoming.Web.anticipates_iff : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop} {o a : F} {t : Nat}
  {obs' : F → C → Prop},
  (∀ (select : (Nat → C → Nat) → Prop), W.SelectsThrough obs a t select → W.SelectsThrough obs' o t select) ↔
    ∀ (l l' : Nat → C → Nat), W.AlikeThroughUpTo obs' o l l' t → W.AlikeThroughUpTo obs a l l' t
@Becoming.Web.anticipation_misses : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop} {o a : F}
  {l l' : Nat → C → Nat} {t : Nat} {obs' : F → C → Prop},
  W.AlikeThroughUpTo obs' o l l' t →
    ¬W.AlikeThroughUpTo obs a l l' t → ∃ select, W.SelectsThrough obs a t select ∧ ¬W.SelectsThrough obs' o t select
@Becoming.Web.SelectsThrough.read : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop} {o a : F} {t : Nat}
  {select : (Nat → C → Nat) → Prop},
  W.SelectsThrough obs a t select → W.SelectsThrough (W.ReadsCouplings obs o a) o t select
@Becoming.ExchangeLaw.Through.widen : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C} {W : Becoming.Web F C}
  {obs obs' : F → C → Prop} {part : F → Bool},
  (∀ (g : F) (c : C), obs g c → obs' g c) → law.Through W obs part → law.Through W obs' part
@Becoming.ExchangeLaw.Through.anticipated : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C} {W : Becoming.Web F C}
  {obs obs' : F → C → Prop} {part : F → Bool} {o a : F} {l l' : Nat → C → Nat} {t : Nat},
  law.Through W obs part →
    part a = false →
      (∀ (m m' : Nat → C → Nat), W.AlikeThroughUpTo obs' o m m' t → W.AlikeThroughUpTo obs a m m' t) →
        W.AlikeThroughUpTo obs' o l l' t → ∀ (s : Nat), s ≤ t → law.GivesAlike s a l l'
@Becoming.WithinClosure.of_reads : ∀ {F : Type} {rel rel' : F → F → Prop} {o a g : F},
  (∀ (g h : F), rel' g h → rel g h ∨ g = o ∧ rel a h) →
    Becoming.WithinClosure rel' o g → Becoming.WithinClosureOf rel (fun x => x = o ∨ x = a) g
@Becoming.WithinClosureOf.to_reads : ∀ {F : Type} {rel rel' : F → F → Prop} {o a g : F},
  (∀ (g h : F), rel g h → rel' g h) →
    Becoming.WithinClosure rel' o a →
      Becoming.WithinClosureOf rel (fun x => x = o ∨ x = a) g → Becoming.WithinClosure rel' o g
@Becoming.Flow.CoupledFrom.of_reads : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {obs : F → C → Prop}
  {o a g h : F},
  L.CoupledFrom W (W.ReadsCouplings obs o a) g h → L.CoupledFrom W obs g h ∨ g = o ∧ L.CoupledFrom W obs a h
@Becoming.Flow.withinCoupling_reads : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {obs : F → C → Prop}
  {o a g : F}, L.WithinCoupling W (W.ReadsCouplings obs o a) o g → L.WithinPoolCoupling W obs (fun x => x = o ∨ x = a) g
@Becoming.Flow.withinCoupling_reads_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {obs : F → C → Prop} {o a : F},
  (∃ c, W.CoupledInto obs a c ∧ L.Exchanges a c) →
    ∀ {g : F}, L.WithinCoupling W (W.ReadsCouplings obs o a) o g ↔ L.WithinPoolCoupling W obs (fun x => x = o ∨ x = a) g
@Becoming.Flow.unselected_beyond_reads : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {obs : F → C → Prop} {o a : F} {part : F → Bool} {l : Nat → C → Nat},
  L.WithheldLevels part W l →
    (∀ (t : Nat) (g : F) (c : C),
        L.WithinPoolCoupling W obs (fun x => x = o ∨ x = a) g → W.CoupledInto obs g c → L.BalancesOn W [c] t) →
      (∀ (h : F), part h = true → ¬L.WithinPoolCoupling W obs (fun x => x = o ∨ x = a) h) →
        ∀ {t : Nat} {select : (Nat → C → Nat) → Prop},
          W.SelectsThrough (W.ReadsCouplings obs o a) o t select → (select W.level ↔ select l)
@Becoming.Flow.act_unselected_reads : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C} {L L' : Becoming.Flow F C}
  {W W' : Becoming.Web F C} {obs : F → C → Prop} {part : F → Bool} {o a : F} {select : (Nat → C → Nat) → Prop},
  law.Through W (W.ReadsCouplings obs o a) part →
    L.Follows law part W.level →
      L'.Follows law part W'.level →
        L.Balances W →
          L'.Balances W' →
            (∀ (t : Nat), L.present t = L'.present t) →
              (∀ (c : C), W.level 0 c = W'.level 0 c) →
                (L.ActsAlikeOnPoolCoupled L' W obs part fun x => x = o ∨ x = a) →
                  ∀ {t : Nat},
                    W.SelectsThrough (W.ReadsCouplings obs o a) o t select → (select W.level ↔ select W'.level)
