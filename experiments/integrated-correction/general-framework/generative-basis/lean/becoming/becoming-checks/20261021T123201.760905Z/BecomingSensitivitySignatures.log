Becoming.Pointer.readsFinitely : Becoming.Pointer.law.ReadsFinitely
Becoming.Pointer.lt_beyond : ∀ (cs : List Nat) {c : Nat}, c ∈ cs → c < Becoming.Pointer.beyond cs
Becoming.Pointer.beyond_ne_zero : ∀ (cs : List Nat), Becoming.Pointer.beyond cs ≠ 0
Becoming.Pointer.no_list : ¬∃ cs, ∀ (t : Nat) (l : Nat → Nat → Nat), Becoming.Pointer.law.ReadsWithin t () l cs
