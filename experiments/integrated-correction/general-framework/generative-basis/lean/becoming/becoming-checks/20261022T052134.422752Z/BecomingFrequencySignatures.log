        (∀ (t : Nat) (c : C), Becoming.inflow cs part k present t c ≤ M) →
          (∀ (t : Nat) (c : C), on t = false → Becoming.inflow cs part k present t c = 0) →
            ∀ {law : Becoming.ExchangeLaw F C} {L L' : Becoming.Flow F C} {W W' : Becoming.Web F C},
              law.Nonanticipating →
                L.Balances W →
                  L'.Balances W' →
                    (∀ (t : Nat), L.present t = present t) →
                      (∀ (t : Nat), L'.present t = present t) →
                        L.Follows law part W.level →
                          L'.Follows law part W'.level →
                            (∀ (t : Nat) (h : F) (c : C) (s : Nat) (d : C),
                                part h = false → s ≤ t → law.RespondsWithin t h c s d (k t h c s d)) →
                              (∀ (t : Nat) (h : F) (c : C), part h = true → L.exchangeGap L' t h c ≤ 0) →
                                (∀ (c : C), Becoming.gap (W.level 0 c) (W'.level 0 c) ≤ δ c) →
                                  ∀ (t : Nat) (c : C),
                                    Becoming.gap (W.level t c) (W'.level t c) ≤
                                      D * (1 + M) ^ Becoming.Frequency.count on t
@Becoming.Saturation.Antitone.zeroFrom : ∀ {F C : Type} {sat : Nat → Nat → F → C → Nat → C → Nat} {d c : C} {A : Nat},
  Becoming.Saturation.Antitone sat d c →
    (∀ (t : Nat) (h : F) (s : Nat), sat A t h c s d = 0) → Becoming.Saturation.ZeroFrom sat d c A
@Becoming.Saturation.passingAt_congr : ∀ {F C : Type} {part : F → Bool} {present : Nat → List F} {l : Nat → C → Nat}
  {d c : C} {k : Nat → F → C → Nat → C → Nat} {l' : Nat → C → Nat} {t : Nat},
  (∀ (s : Nat), s ≤ t → l s d = l' s d) →
    Becoming.Saturation.passingAt part k present l t d c = Becoming.Saturation.passingAt part k present l' t d c
@Becoming.Saturation.passed_congr : ∀ {F C : Type} {part : F → Bool} {present : Nat → List F}
  {sat : Nat → Nat → F → C → Nat → C → Nat} {l : Nat → C → Nat} {d c : C} {l' : Nat → C → Nat} {t : Nat},
  (∀ (s : Nat), s < t → l s d = l' s d) →
    Becoming.Saturation.passed part sat present l d c t = Becoming.Saturation.passed part sat present l' d c t
@Becoming.Saturation.readsBefore : ∀ {F C : Type} {part : F → Bool} {present : Nat → List F}
  {sat : Nat → Nat → F → C → Nat → C → Nat}, Becoming.ReadsBefore (Becoming.Saturation.strengths part sat present)
@Becoming.Saturation.passed_le_succ : ∀ {F C : Type} {part : F → Bool} {present : Nat → List F}
  {sat : Nat → Nat → F → C → Nat → C → Nat} {l : Nat → C → Nat} {d c : C} (t : Nat),
  Becoming.Saturation.passed part sat present l d c t ≤ Becoming.Saturation.passed part sat present l d c (t + 1)
@Becoming.Saturation.passed_le_add : ∀ {F C : Type} {part : F → Bool} {present : Nat → List F}
  {sat : Nat → Nat → F → C → Nat → C → Nat} {l : Nat → C → Nat} {d c : C} (t k : Nat),
  Becoming.Saturation.passed part sat present l d c t ≤ Becoming.Saturation.passed part sat present l d c (t + k)
@Becoming.Saturation.passed_mono : ∀ {F C : Type} {part : F → Bool} {present : Nat → List F}
  {sat : Nat → Nat → F → C → Nat → C → Nat} {l : Nat → C → Nat} {d c : C} {t t' : Nat},
  t ≤ t' → Becoming.Saturation.passed part sat present l d c t ≤ Becoming.Saturation.passed part sat present l d c t'
@Becoming.Saturation.passingAt_zero : ∀ {F C : Type} {part : F → Bool} {present : Nat → List F}
  {sat : Nat → Nat → F → C → Nat → C → Nat} {l : Nat → C → Nat} {d c : C} {a t : Nat},
  (∀ (h : F) (s : Nat), sat a t h c s d = 0) → Becoming.Saturation.passingAt part (sat a) present l t d c = 0
@Becoming.Saturation.one_le_passingAt : ∀ {F C : Type} {part : F → Bool} {present : Nat → List F} {l : Nat → C → Nat}
  {d c : C} {k : Nat → F → C → Nat → C → Nat} {t : Nat} {h : F},
  h ∈ present t →
    part h = false → 0 < k t h c t d → 0 < l t d → 1 ≤ Becoming.Saturation.passingAt part k present l t d c
@Becoming.Saturation.stops : ∀ {F C : Type} {cs : List C} {part : F → Bool} {present : Nat → List F}
  {sat : Nat → Nat → F → C → Nat → C → Nat} {l : Nat → C → Nat} {d c : C} {A N : Nat},
  Becoming.Saturation.ZeroFrom sat d c A →
    A ≤ Becoming.Saturation.passed part sat present l d c N →
      Becoming.StopsBy cs part (Becoming.Saturation.strengths part sat present l) present d c N
@Becoming.Saturation.not_recurs : ∀ {F C : Type} {cs : List C} {part : F → Bool} {present : Nat → List F}
  {sat : Nat → Nat → F → C → Nat → C → Nat} {l : Nat → C → Nat} {d c : C} {A N : Nat},
  Becoming.Saturation.ZeroFrom sat d c A →
    A ≤ Becoming.Saturation.passed part sat present l d c N →
      ¬Becoming.CouplingRecurs cs part (Becoming.Saturation.strengths part sat present l) present d c
@Becoming.Saturation.exact : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {present : Nat → List F} {sat : Nat → Nat → F → C → Nat → C → Nat} {l : Nat → C → Nat} {N : Nat},
  (∀ (d e : C), ∃ A, Becoming.Saturation.ZeroFrom sat d e A ∧ A ≤ Becoming.Saturation.passed part sat present l d e N) →
    ∀ (δ : C → Nat) (t : Nat) (e : C),
      Becoming.carriedWithin cs part σ (Becoming.Saturation.strengths part sat present l) present δ N t e =
        Becoming.carried cs part σ (Becoming.Saturation.strengths part sat present l) present δ t e
@Becoming.Saturation.passed_from : ∀ {F C : Type} {part : F → Bool} {present : Nat → List F}
  {sat : Nat → Nat → F → C → Nat → C → Nat} {l : Nat → C → Nat} {d c : C} {A N : Nat},
  Becoming.Saturation.ZeroFrom sat d c A →
    A ≤ Becoming.Saturation.passed part sat present l d c N →
      ∀ (k : Nat),
        Becoming.Saturation.passed part sat present l d c (N + k) = Becoming.Saturation.passed part sat present l d c N
@Becoming.Saturation.passed_lt : ∀ {F C : Type} {part : F → Bool} {present : Nat → List F}
  {sat : Nat → Nat → F → C → Nat → C → Nat} {l : Nat → C → Nat} {d c : C} {A m : Nat},
  Becoming.Saturation.ZeroFrom sat d c A →
    0 < A →
      (∀ (t : Nat),
          Becoming.Saturation.passingAt part (sat (Becoming.Saturation.passed part sat present l d c t)) present l t d
              c ≤
            m) →
        ∀ (t : Nat), Becoming.Saturation.passed part sat present l d c t < A + m
@Becoming.Saturation.climbs : ∀ {F C : Type} {part : F → Bool} {present : Nat → List F}
  {sat : Nat → Nat → F → C → Nat → C → Nat} {l : Nat → C → Nat} {d c : C} {P : Nat → Prop},
  (∀ (a : Nat), P a ∨ ¬P a) →
    (∀ (a a' : Nat), a ≤ a' → P a → P a') →
      (∀ (t a : Nat), ¬P a → ∃ h, h ∈ present t ∧ part h = false ∧ 0 < sat a t h c t d) →
        (∀ (t : Nat), 0 < l t d) →
          ∀ (t : Nat),
            t ≤ Becoming.Saturation.passed part sat present l d c t ∨
              P (Becoming.Saturation.passed part sat present l d c t)
@Becoming.Saturation.stops_by : ∀ {F C : Type} {cs : List C} {part : F → Bool} {present : Nat → List F}
  {sat : Nat → Nat → F → C → Nat → C → Nat} {l : Nat → C → Nat} {d c : C} {A : Nat},
  Becoming.Saturation.ZeroFrom sat d c A →
    (∀ (t a : Nat), a < A → ∃ h, h ∈ present t ∧ part h = false ∧ 0 < sat a t h c t d) →
      (∀ (t : Nat), 0 < l t d) →
        A ≤ Becoming.Saturation.passed part sat present l d c A ∧
          Becoming.StopsBy cs part (Becoming.Saturation.strengths part sat present l) present d c A
@Becoming.Saturation.stops_by_zero : ∀ {F C : Type} {cs : List C} {part : F → Bool} {present : Nat → List F}
  {l : Nat → C → Nat} {d c : C} {f : Nat → Nat} {k : Nat → F → C → Nat → C → Nat} {A : Nat},
  (∀ (a a' : Nat), a ≤ a' → f a' ≤ f a) →
    (∀ (t : Nat), ∃ h, h ∈ present t ∧ part h = false ∧ 0 < k t h c t d) →
      (∀ (t : Nat), 0 < l t d) →
        f A = 0 →
          Becoming.StopsBy cs part (Becoming.Saturation.strengths part (Becoming.Saturation.scaled f k) present l)
            present d c A
@Becoming.Saturation.stops_iff : ∀ {F C : Type} {cs : List C} {part : F → Bool} {present : Nat → List F}
  {l : Nat → C → Nat} {d c : C} {f : Nat → Nat} {k : Nat → F → C → Nat → C → Nat},
  (∀ (a a' : Nat), a ≤ a' → f a' ≤ f a) →
    d ∈ cs →
      (∀ (t : Nat), ∃ h, h ∈ present t ∧ part h = false ∧ 0 < k t h c t d) →
        (∀ (t : Nat), 0 < l t d) →
          ((∃ N,
              Becoming.StopsBy cs part (Becoming.Saturation.strengths part (Becoming.Saturation.scaled f k) present l)
                present d c N) ↔
            ∃ A, f A = 0)
@Becoming.Saturation.floored : ∀ {F C : Type} {cs : List C} {part : F → Bool} {present : Nat → List F}
  {l : Nat → C → Nat} {d c : C} {f : Nat → Nat} {k : Nat → F → C → Nat → C → Nat},
  (∀ (a : Nat), 0 < f a) →
    d ∈ cs →
      (∀ (t : Nat), ∃ h, h ∈ present t ∧ part h = false ∧ 0 < k t h c t d) →
        (∀ (t : Nat), 0 < l t d) →
          Becoming.CouplingRecurs cs part
              (Becoming.Saturation.strengths part (Becoming.Saturation.scaled f k) present l) present d c ∧
            ∀ (t : Nat), t ≤ Becoming.Saturation.passed part (Becoming.Saturation.scaled f k) present l d c t
@Becoming.Saturation.floored_inexact : ∀ {F C : Type} {cs : List C} {part : F → Bool} {present : Nat → List F}
  {l : Nat → C → Nat} {c : C} {f : Nat → Nat} {k : Nat → F → C → Nat → C → Nat},
  (∀ (a : Nat), 0 < f a) →
    c ∈ cs →
      (∀ (t : Nat), ∃ h, h ∈ present t ∧ part h = false ∧ 0 < k t h c t c) →
        (∀ (t : Nat), 0 < l t c) →
          ¬∃ J,
              ∀ (t : Nat),
                ¬Becoming.CoupledIntoBy cs part
                    (Becoming.Saturation.strengths part (Becoming.Saturation.scaled f k) present l) present (J + 1) t c
@Becoming.Saturation.carriedGive_split : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  (k : Nat → F → C → Nat → C → Nat) (l : Nat → C → Nat) (t : Nat) (h : F) (e : C),
  Becoming.carriedGive cs part σ k t h e l =
    (bif part h then σ t h e else 0) +
      Becoming.total cs fun d =>
        bif part h then 0 else Becoming.total (Becoming.steps 0 (t + 1)) fun s => k t h e s d * l s d
@Becoming.Saturation.total_carriedGive : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {present : Nat → List F} (k : Nat → F → C → Nat → C → Nat) (l : Nat → C → Nat) (t : Nat) (e : C),
  (Becoming.total (present t) fun h => Becoming.carriedGive cs part σ k t h e l) =
    (Becoming.total (present t) fun h => bif part h then σ t h e else 0) +
      Becoming.total cs fun d => Becoming.Saturation.passingAt part k present l t d e
@Becoming.Saturation.course_succ : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {present : Nat → List F} {sat : Nat → Nat → F → C → Nat → C → Nat} {δ : C → Nat} (t : Nat) (e : C),
  Becoming.formedCourse cs part σ (Becoming.Saturation.strengths part sat present) present δ (t + 1) e =
    (Becoming.formedCourse cs part σ (Becoming.Saturation.strengths part sat present) present δ t e +
        Becoming.total (present t) fun h => bif part h then σ t h e else 0) +
      Becoming.total cs fun d =>
        Becoming.Saturation.passingAt part
          (sat
            (Becoming.Saturation.passed part sat present
              (Becoming.formedCourse cs part σ (Becoming.Saturation.strengths part sat present) present δ) d e t))
          present (Becoming.formedCourse cs part σ (Becoming.Saturation.strengths part sat present) present δ) t d e
@Becoming.Saturation.course_stands : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {present : Nat → List F} {sat : Nat → Nat → F → C → Nat → C → Nat} {d : C} {δ : C → Nat},
  0 < δ d →
    ∀ (t : Nat), 0 < Becoming.formedCourse cs part σ (Becoming.Saturation.strengths part sat present) present δ t d
@Becoming.Saturation.course_stops_by : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {present : Nat → List F} {sat : Nat → Nat → F → C → Nat → C → Nat} {d c : C} {δ : C → Nat} {A : Nat},
  Becoming.Saturation.ZeroFrom sat d c A →
    (∀ (t a : Nat), a < A → ∃ h, h ∈ present t ∧ part h = false ∧ 0 < sat a t h c t d) →
      0 < δ d →
        Becoming.StopsBy cs part
            (Becoming.Saturation.strengths part sat present
              (Becoming.formedCourse cs part σ (Becoming.Saturation.strengths part sat present) present δ))
            present d c A ∧
          ¬Becoming.CouplingRecurs cs part
                (Becoming.Saturation.strengths part sat present
                  (Becoming.formedCourse cs part σ (Becoming.Saturation.strengths part sat present) present δ))
                present d c ∧
            ∀ (k : Nat),
              Becoming.Saturation.passed part sat present
                  (Becoming.formedCourse cs part σ (Becoming.Saturation.strengths part sat present) present δ) d c
                  (A + k) =
                Becoming.Saturation.passed part sat present
                  (Becoming.formedCourse cs part σ (Becoming.Saturation.strengths part sat present) present δ) d c A
@Becoming.Saturation.course_stops_iff : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {present : Nat → List F} {d c : C} {f : Nat → Nat} {k : Nat → F → C → Nat → C → Nat} {δ : C → Nat},
  (∀ (a a' : Nat), a ≤ a' → f a' ≤ f a) →
    d ∈ cs →
      (∀ (t : Nat), ∃ h, h ∈ present t ∧ part h = false ∧ 0 < k t h c t d) →
        0 < δ d →
          ((∃ N,
              Becoming.StopsBy cs part
                (Becoming.Saturation.strengths part (Becoming.Saturation.scaled f k) present
                  (Becoming.formedCourse cs part σ
                    (Becoming.Saturation.strengths part (Becoming.Saturation.scaled f k) present) present δ))
                present d c N) ↔
            ∃ A, f A = 0)
@Becoming.Saturation.wearing_stops : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {present : Nat → List F} {d c : C} {δ : C → Nat} {A : Nat} {k : Nat → F → C → Nat → C → Nat},
  (∀ (t : Nat), ∃ h, h ∈ present t ∧ part h = false ∧ 0 < k t h c t d) →
    0 < δ d →
      Becoming.StopsBy cs part
        (Becoming.Saturation.strengths part (Becoming.Saturation.scaled (fun x => A - x) k) present
          (Becoming.formedCourse cs part σ
            (Becoming.Saturation.strengths part (Becoming.Saturation.scaled (fun x => A - x) k) present) present δ))
        present d c A
