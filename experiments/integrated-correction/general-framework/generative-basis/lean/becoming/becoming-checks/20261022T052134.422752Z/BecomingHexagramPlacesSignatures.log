  ((Becoming.Law.run Becoming.Hexagram.waxWane s).state n).opposition = (true, true, true) →
    List.map (fun i => ((Becoming.Law.run Becoming.Hexagram.waxWane s).state (n + i)).opposition) (List.range 7) =
      [(true, true, true), (false, true, true), (false, false, true), (false, false, false), (true, false, false),
        (true, true, false), (true, true, true)]
Becoming.Hexagram.changes_run_phase : ∀ (r : Becoming.Run Becoming.Hexagram.changes) (n : Nat),
  (r.state (n + 1)).inPhase (r.act n) = !(r.state n).inPhase (r.act n) ∧
    (∀ (k : Becoming.Hexagram.Place), r.act n ≠ k → (r.state (n + 1)).inPhase k = (r.state n).inPhase k) ∧
      ((r.state (n + 1)).phaseCount + 1 = (r.state n).phaseCount ∨
        (r.state n).phaseCount + 1 = (r.state (n + 1)).phaseCount)
Becoming.Hexagram.changes_run_opposition : ∀ (r : Becoming.Run Becoming.Hexagram.changes) (n : Nat),
  (r.state (n + 1)).opposed (Becoming.Hexagram.heightOf (r.act n)) =
      !(r.state n).opposed (Becoming.Hexagram.heightOf (r.act n)) ∧
    ∀ (h : Becoming.Hexagram.Height),
      Becoming.Hexagram.heightOf (r.act n) ≠ h → (r.state (n + 1)).opposed h = (r.state n).opposed h
Becoming.Hexagram.backward_run : ∀ (s : Becoming.Hexagram) (n : Nat),
  (Becoming.Law.run Becoming.Hexagram.unwaxWane s.reverse).state n =
    ((Becoming.Law.run Becoming.Hexagram.waxWane s).state n).reverse
Becoming.Hexagram.backward_relations : ∀ (s : Becoming.Hexagram) (n : Nat),
  (∀ (k : Becoming.Hexagram.Place),
      ((Becoming.Law.run Becoming.Hexagram.unwaxWane s.reverse).state n).line k.mirror =
        ((Becoming.Law.run Becoming.Hexagram.waxWane s).state n).line k) ∧
    (∀ (k : Becoming.Hexagram.Place),
        ((Becoming.Law.run Becoming.Hexagram.unwaxWane s.reverse).state n).inPhase k.mirror =
          !((Becoming.Law.run Becoming.Hexagram.waxWane s).state n).inPhase k) ∧
      ((Becoming.Law.run Becoming.Hexagram.unwaxWane s.reverse).state n).phaseCount +
            ((Becoming.Law.run Becoming.Hexagram.waxWane s).state n).phaseCount =
          6 ∧
        (∀ (h : Becoming.Hexagram.Height),
            ((Becoming.Law.run Becoming.Hexagram.unwaxWane s.reverse).state n).opposed h.mirror =
              ((Becoming.Law.run Becoming.Hexagram.waxWane s).state n).opposed h) ∧
          ∀ (j : Becoming.Hexagram.Seam),
            ((Becoming.Law.run Becoming.Hexagram.unwaxWane s.reverse).state n).rises j.mirror =
              ((Becoming.Law.run Becoming.Hexagram.waxWane s).state n).falls j
@Becoming.Hexagram.shown_along_run : ∀ {A : Type} {P : Generative.Process Becoming.Hexagram A} (r : Becoming.Run P)
  (n : Nat),
  (∀ (h : Becoming.Hexagram.Height),
      (r.state n).opposed h =
        Becoming.Hexagram.same ((r.state n).inPhase (Becoming.Hexagram.place Becoming.Hexagram.Half.lower h))
          ((r.state n).inPhase (Becoming.Hexagram.place Becoming.Hexagram.Half.upper h))) ∧
    ((r.state n).inPhase Becoming.Hexagram.Place.p2 = true →
        (r.state n).inPhase Becoming.Hexagram.Place.p5 = true →
          (r.state n).opposed Becoming.Hexagram.Height.mid = true) ∧
      ((∀ (k : Becoming.Hexagram.Place), (r.state n).inPhase k = true) →
          ∀ (h : Becoming.Hexagram.Height), (r.state n).opposed h = true) ∧
        ((∀ (k : Becoming.Hexagram.Place), (r.state n).inPhase k = false) →
            ∀ (h : Becoming.Hexagram.Height), (r.state n).opposed h = true) ∧
          (r.state n).middleUnbrokenOpposed = (r.state n).opposed Becoming.Hexagram.Height.mid ∧
            (r.state n).middleBrokenOpposed = (r.state n).opposed Becoming.Hexagram.Height.mid ∧
              (r.state n).riseCount + (r.state n).l1.toNat = (r.state n).fallCount + (r.state n).l6.toNat
