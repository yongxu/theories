  w.Dissipative → Becoming.World.InAmounts.Dissipative Becoming.Amounts.whole w.wholeAmounts
@Becoming.World.arisingEmbodied_whole : ∀ {w : Becoming.World},
  w.ArisingEmbodied → Becoming.World.InAmounts.ArisingEmbodied Becoming.Amounts.whole w.wholeAmounts
@Becoming.World.embodied_whole : ∀ {w : Becoming.World},
  w.Embodied → Becoming.World.InAmounts.Embodied Becoming.Amounts.whole w.wholeAmounts
@Becoming.World.enclosed_whole : ∀ {w : Becoming.World} {t : Nat},
  w.flow.Enclosed t → Becoming.World.InAmounts.Enclosed Becoming.Amounts.whole w.wholeAmounts t
@Becoming.World.rests_unrefuted : ∀ {w : Becoming.World},
  w.Finite → w.Balanced → w.Dissipative → w.ArisingEmbodied → ¬¬∃ N, w.RestsFrom N
@Becoming.World.rests_unrefuted_enclosed : ∀ {w : Becoming.World},
  w.Counted →
    w.Embodied →
      w.Balanced → w.Dissipative → ∀ {T : Nat}, (∀ (t : Nat), T ≤ t → w.flow.Enclosed t) → ¬¬∃ N, w.RestsFrom N
@Becoming.Pass.at_self : ∀ {A : Type} {M : Becoming.Amounts A} (h : Bool) (s : A), Becoming.Pass.at_ M h h s = s
@Becoming.Pass.at_other : ∀ {A : Type} {M : Becoming.Amounts A} {h x : Bool},
  ¬x = h → ∀ (s : A), Becoming.Pass.at_ M h x s = M.zero
Becoming.Pass.not_self : ∀ (h : Bool), ¬(!h) = h
Becoming.Pass.decide_eq : ∀ (p x : Bool), x = p ∨ ¬x = p
Becoming.Pass.decide_mem : ∀ (h : Bool) (ds : List Bool), h ∈ ds ∨ ¬h ∈ ds
Becoming.Pass.member : ∀ (x : Bool), x ∈ [true, false]
Becoming.Pass.pair_distinct : Becoming.Distinct [true, false]
@Becoming.Pass.positive : ∀ {A : Type} {M : Becoming.Amounts A} {d : Nat → A},
  (∀ (t : Nat), ¬M.le (d t) (d (t + 1))) → ∀ (t : Nat), ¬M.le (d t) M.zero
@Becoming.Pass.stands_iff : ∀ {A : Type} {M : Becoming.Amounts A} (h x : Bool) {s : A},
  ¬M.le s M.zero → (x = h ↔ ¬M.le (Becoming.Pass.at_ M h x s) M.zero)
@Becoming.Pass.present_holder : ∀ {t : Nat} {f : Bool},
  f ∈ Becoming.Pass.world.flow.present t → f = Becoming.Pass.even t
@Becoming.Pass.take_of_present : ∀ {A : Type} {M : Becoming.Amounts A} {d : Nat → A} {t : Nat} {f : Bool},
  f ∈ Becoming.Pass.world.flow.present t →
    ∀ (c : Bool), (Becoming.Pass.amounts M d).take t f c = Becoming.Pass.at_ M (Becoming.Pass.even t) c (d t)
@Becoming.Pass.give_of_present : ∀ {A : Type} {M : Becoming.Amounts A} {d : Nat → A} {t : Nat} {f : Bool},
  f ∈ Becoming.Pass.world.flow.present t →
    ∀ (c : Bool), (Becoming.Pass.amounts M d).give t f c = Becoming.Pass.at_ M (!Becoming.Pass.even t) c (d (t + 1))
Becoming.Pass.census : Becoming.Pass.world.web.Census Becoming.Pass.alive
@Becoming.Pass.embodied : ∀ {A : Type} {M : Becoming.Amounts A} {d : Nat → A},
  (∀ (t : Nat), ¬M.le (d t) (d (t + 1))) → Becoming.World.InAmounts.Embodied M (Becoming.Pass.amounts M d)
@Becoming.Pass.balanced : ∀ {A : Type} {M : Becoming.Amounts A} {d : Nat → A},
  Becoming.World.InAmounts.Balanced M (Becoming.Pass.amounts M d)
@Becoming.Pass.dissipative : ∀ {A : Type} {M : Becoming.Amounts A} {d : Nat → A},
  (∀ (t : Nat), M.le (d (t + 1)) (d t)) →
    (∀ (t : Nat), ¬M.le (d t) (d (t + 1))) → Becoming.World.InAmounts.Dissipative M (Becoming.Pass.amounts M d)
@Becoming.Pass.closed : ∀ {A : Type} {M : Becoming.Amounts A} {d : Nat → A} (t : Nat),
  Becoming.World.InAmounts.ClosedAt M (Becoming.Pass.amounts M d) [true, false] t
@Becoming.Pass.enclosed : ∀ {A : Type} {M : Becoming.Amounts A} {d : Nat → A} (t : Nat),
  Becoming.World.InAmounts.Enclosed M (Becoming.Pass.amounts M d) t
Becoming.Pass.arises : ∀ (t : Nat), Becoming.Pass.world.web.Arises t !Becoming.Pass.even t
Becoming.Pass.ceases : ∀ (t : Nat), Becoming.Pass.world.web.Ceases t (Becoming.Pass.even t)
Becoming.Pass.never_rests : ∀ (N : Nat), ¬Becoming.Pass.world.RestsFrom N
@Becoming.Pass.endless_keeps_from_rest : ∀ {A : Type} {M : Becoming.Amounts A} {d : Nat → A},
  (∀ (t : Nat), M.le (d (t + 1)) (d t)) →
    (∀ (t : Nat), ¬M.le (d t) (d (t + 1))) →
      Becoming.Pass.world.web.Census Becoming.Pass.alive ∧
        Becoming.World.InAmounts.Embodied M (Becoming.Pass.amounts M d) ∧
          Becoming.World.InAmounts.Balanced M (Becoming.Pass.amounts M d) ∧
            Becoming.World.InAmounts.Dissipative M (Becoming.Pass.amounts M d) ∧
              (∀ (t : Nat), Becoming.World.InAmounts.Enclosed M (Becoming.Pass.amounts M d) t) ∧
                ∀ (N : Nat), ¬Becoming.Pass.world.RestsFrom N
@Becoming.Pass.levels_unlisted : ∀ {A : Type} {M : Becoming.Amounts A} {d : Nat → A},
  (∀ (t : Nat), M.le (d (t + 1)) (d t)) →
    (∀ (t : Nat), ¬M.le (d t) (d (t + 1))) → ¬∃ ls, ∀ (t : Nat), (Becoming.Pass.amounts M d).level t ∈ ls
@Becoming.Amounts.worldsRest_of_noEndlessFall : ∀ {A : Type} {M : Becoming.Amounts A}, M.NoEndlessFall → M.WorldsRest
@Becoming.Amounts.not_endlessFall_of_worldsRest : ∀ {A : Type} {M : Becoming.Amounts A}, M.WorldsRest → ¬M.EndlessFall
Becoming.Amounts.whole_worldsRest : Becoming.Amounts.whole.WorldsRest
