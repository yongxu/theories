@Becoming.Web.carrying_active : ∀ {F C : Type} (W : Becoming.Web F C) (carries : Nat → F → Prop) {t : Nat} {a : F},
  (W.carrying carries).active t a → W.active t a
@Becoming.Web.carrying_iff : ∀ {F C : Type} (W : Becoming.Web F C) {carries : Nat → F → Prop},
  (∀ (t : Nat) (a : F), carries t a → W.active t a) → ∀ (t : Nat) (a : F), (W.carrying carries).active t a ↔ carries t a
@Becoming.Web.begins_within : ∀ {F C : Type} {V : Becoming.Web F C} {d T : Nat},
  (∀ (t : Nat), T ≤ t → V.Present t) →
    (∀ (a : F), V.Brief d a) → ∀ {S : Nat}, T ≤ S → ¬∀ (j : Nat), j < d → ∀ (a : F), ¬V.Arises (S + j) a
@Becoming.Web.ByPassing.begins_passed : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop},
  V.ByPassing passes → ∀ {t : Nat} {a : F}, V.Arises t a → ∃ b, V.active t b ∧ passes t b a
@Becoming.Web.ByPassing.trace : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop},
  V.ByPassing passes → ∀ {S k : Nat} {a : F}, V.active (S + k) a → V.active S a ∨ ∃ j, j < k ∧ V.PassesAt passes (S + j)
@Becoming.Web.ByPassing.passes_within : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop},
  V.ByPassing passes →
    ∀ {d T : Nat},
      (∀ (t : Nat), T ≤ t → V.Present t) →
        (∀ (a : F), V.Brief d a) → ∀ {S : Nat}, T ≤ S → ∃ j, j < d ∧ V.PassesAt passes (S + j)
@Becoming.Web.ByPassing.present_back : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop},
  V.ByPassing passes → ∀ {t : Nat}, V.Present (t + 1) → V.Present t
@Becoming.Web.ByPassing.present_earlier : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop},
  V.ByPassing passes → ∀ {t k : Nat}, V.Present (t + k) → V.Present t
@Becoming.Web.ByPassing.present_of_le : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop},
  V.ByPassing passes → ∀ {t t' : Nat}, t ≤ t' → V.Present t' → V.Present t
@Becoming.Web.ByPassing.empty_stays : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop},
  V.ByPassing passes → ∀ {t : Nat}, ¬V.Present t → ∀ {t' : Nat}, t ≤ t' → ¬V.Present t'
@Becoming.Web.ByPassing.ends_within : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop},
  V.ByPassing passes →
    ∀ {d T : Nat},
      (∀ (a : F), V.Brief d a) → (∀ (t : Nat), T ≤ t → ¬V.PassesAt passes t) → ∀ {t : Nat}, T + d ≤ t → ¬V.Present t
Becoming.PatternRelay.brief : ∀ (n : Nat), Becoming.PatternRelay.web.Brief 2 n
Becoming.PatternRelay.relay : Becoming.PatternRelay.web.ByPassing Becoming.PatternRelay.passes ∧
  (∀ (n : Nat), Becoming.PatternRelay.web.Brief 2 n) ∧
    (∀ (n : Nat), Becoming.PatternRelay.web.Ends n) ∧
      (∀ (t : Nat), Becoming.PatternRelay.web.Present t) ∧
        ∀ (t : Nat), Becoming.PatternRelay.web.PassesAt Becoming.PatternRelay.passes t
Becoming.PatternRelay.stopped_by_passing : ∀ (T : Nat),
  (Becoming.PatternRelay.stopped T).ByPassing (Becoming.PatternRelay.passesUntil T)
Becoming.PatternRelay.stopped_brief : ∀ (T n : Nat), (Becoming.PatternRelay.stopped T).Brief 2 n
Becoming.PatternRelay.stopped_quiet : ∀ (T t : Nat),
  T ≤ t → ¬(Becoming.PatternRelay.stopped T).PassesAt (Becoming.PatternRelay.passesUntil T) t
Becoming.PatternRelay.stopped_relay : ∀ (T : Nat),
  (Becoming.PatternRelay.stopped T).ByPassing (Becoming.PatternRelay.passesUntil T) ∧
    (∀ (n : Nat), (Becoming.PatternRelay.stopped T).Brief 2 n) ∧
      (∀ (t : Nat), T ≤ t → ¬(Becoming.PatternRelay.stopped T).PassesAt (Becoming.PatternRelay.passesUntil T) t) ∧
        (∀ (t : Nat), t ≤ T + 1 → (Becoming.PatternRelay.stopped T).Present t) ∧
          ∀ (t : Nat), T + 2 ≤ t → ¬(Becoming.PatternRelay.stopped T).Present t
Becoming.PatternRelay.half_odd : ∀ (t : Nat),
  Becoming.odd t = true → Becoming.Pulse.half (t + 1) = Becoming.Pulse.half t + 1
Becoming.PatternRelay.shifts : Becoming.PatternRelay.shifted.ByPassing Becoming.PatternRelay.passesOdd ∧
  (∀ (n : Nat), Becoming.PatternRelay.shifted.Brief 2 n) ∧
    (∀ (t : Nat), Becoming.PatternRelay.shifted.Present t) ∧
      (∀ (t : Nat),
          Becoming.odd t = false → ¬Becoming.PatternRelay.shifted.PassesAt Becoming.PatternRelay.passesOdd t) ∧
        ∀ (t : Nat), Becoming.odd t = false → ∀ (n : Nat), ¬Becoming.PatternRelay.shifted.Arises t n
