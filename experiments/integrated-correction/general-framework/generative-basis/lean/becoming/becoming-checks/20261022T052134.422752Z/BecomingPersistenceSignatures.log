  (σ : Becoming.Reidentify F F') (x : F'),
  ((Becoming.World.ofRoles L W).reidentify σ.roles).web.RenewingIn (Sum.inl x) ↔ (W.reidentify σ).RenewingIn x
@Becoming.World.ofRoles_reidentify_consumingIn : ∀ {F F' C : Type} (L : Becoming.Flow F C) (W : Becoming.Web F C)
  (σ : Becoming.Reidentify F F') (x : F'),
  ((Becoming.World.ofRoles L W).reidentify σ.roles).web.ConsumingIn (Sum.inl x) ↔ (W.reidentify σ).ConsumingIn x
