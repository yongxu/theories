      (∀ (σ : Becoming.Reidentify w.Relatum w.Relatum), (w.reidentify σ).Balanced → σ.old (t + 1) (σ.new t c) = c) ↔
        ∀ (d : w.Relatum), w.web.level (t + 1) d = w.web.level (t + 1) c → d = c
@Becoming.World.arises_fixed_iff : ∀ {w : Becoming.World} [dec : DecidableEq w.Relatum],
