      w.web.level (t + 1) d = w.web.level (t + 1) c → (w.reidentify (Becoming.Reidentify.exchangeAfter t c d)).Balanced
@Becoming.World.fixed_iff : ∀ {w : Becoming.World} [dec : DecidableEq w.Relatum],
  w.Balanced →
