@Becoming.Web.arises_persisting_iff : ∀ {F C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop},
  (∀ (t : Nat) (f : F), W.active t f → h t f) →
    ∀ {t : Nat} {f : F}, (W.persisting h).Arises t f ∧ W.active (t + 1) f ↔ W.Arises t f ∧ ¬h t f
@Becoming.Web.waking_not_arising : ∀ {F C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop} {t : Nat} {f : F},
  h t f → ¬(W.persisting h).Arises t f
@Becoming.Web.ceases_persisting_iff : ∀ {F C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop},
  (∀ (t : Nat) (f : F), W.active t f → h t f) →
    ∀ {t : Nat} {f : F}, (W.persisting h).Ceases t f ∧ W.active t f ↔ W.Ceases t f ∧ ¬h (t + 1) f
@Becoming.Web.arisesFrom_of_arises : ∀ {F C : Type} {W : Becoming.Web F C} {R : Nat → F → F → Prop} {t : Nat} {f : F},
  (∀ (g : F), W.active t g → R t g f → g = f) → W.Arises t f → W.ArisesFrom R t f
@Becoming.Web.keepsActive_of_held : ∀ {F F' C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop}
  {σ : Becoming.Reidentify F F'},
  (∀ (t : Nat) (f : F), W.active t f → h t f) → σ.KeepsActive (W.persisting h) → σ.KeepsActive W
@Becoming.Web.keepsTenure_of_held : ∀ {F F' C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop}
  {σ : Becoming.Reidentify F F'},
  (∀ (t : Nat) (f : F) (c : C), W.requires t f c → h t f) → σ.KeepsActive (W.persisting h) → σ.KeepsTenure W
@Becoming.Web.steady_held : ∀ {F F' C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop}
  {σ : Becoming.Reidentify F F'},
  σ.KeepsActive (W.persisting h) →
    ∀ {g : F} {s t : Nat}, (∀ (u : Nat), s ≤ u → u ≤ t → h u g) → ∀ (u : Nat), s ≤ u → u ≤ t → σ.new u g = σ.new t g
@Becoming.Web.named_throughout : ∀ {F F' C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop}
  {σ : Becoming.Reidentify F F'},
  σ.KeepsActive (W.persisting h) → ∀ {f : F}, (∀ (t : Nat), h t f) → ∀ (t : Nat), σ.old t (σ.new 0 f) = f
@Becoming.Web.renewingIn_held : ∀ {F F' C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop}
  {σ : Becoming.Reidentify F F'},
  σ.KeepsActive (W.persisting h) →
    ∀ {f : F}, (∀ (t : Nat), h t f) → ((W.reidentify σ).RenewingIn (σ.new 0 f) ↔ W.RenewingIn f)
@Becoming.Web.consumingIn_held : ∀ {F F' C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop}
  {σ : Becoming.Reidentify F F'},
  σ.KeepsActive (W.persisting h) →
    ∀ {f : F}, (∀ (t : Nat), h t f) → ((W.reidentify σ).ConsumingIn (σ.new 0 f) ↔ W.ConsumingIn f)
@Becoming.Web.persisting_census : ∀ {F C : Type} {W : Becoming.Web F C} {h : Nat → F → Prop} {R : Nat → F → F → Prop}
  [(t : Nat) → (f : F) → Decidable ((W.persisting h).active t f)]
  [(t : Nat) → (f : F) → Decidable ((W.persisting h).Continues R t f)]
  [(t : Nat) → (g : F) → Decidable ((W.persisting h).Continued R t g)] [(t : Nat) → (g f : F) → Decidable (R t g f)]
  {alive : Nat → List F},
  (W.persisting h).Census alive →
    ((W.persisting h).NoSplit R →
        (∀ (N : Nat), ∃ t g, N ≤ t ∧ (W.persisting h).CeasesFrom R t g) → (W.persisting h).UnceasingFrom R) ∧
      ((W.persisting h).NoMerge R →
        ∀ {T B : Nat},
          (∀ (t : Nat), T ≤ t → (alive t).length ≤ B) →
            (W.persisting h).UnceasingFrom R → ∀ (N : Nat), ∃ t g, N ≤ t ∧ (W.persisting h).CeasesFrom R t g)
Becoming.Hibernation.swap_swap : ∀ (f : Becoming.Hibernation.Formation),
  Becoming.Hibernation.swap (Becoming.Hibernation.swap f) = f
Becoming.Hibernation.holds_always : ∀ (t : Nat),
  Becoming.Hibernation.web.Holds t Becoming.Hibernation.Formation.hibernator
Becoming.Hibernation.pool_consumed : Becoming.Hibernation.web.Consumed Becoming.Hibernation.Condition.pool
Becoming.Hibernation.pool_not_renewed : ¬Becoming.Hibernation.web.Renewed Becoming.Hibernation.Condition.pool
Becoming.Hibernation.renewing : Becoming.Hibernation.web.RenewingIn Becoming.Hibernation.Formation.hibernator
Becoming.Hibernation.exchanged_consuming : (Becoming.Hibernation.web.reidentify
      Becoming.Hibernation.exchange).ConsumingIn
  Becoming.Hibernation.Formation.hibernator
Becoming.Hibernation.exchanged_not_renewing : ¬(Becoming.Hibernation.web.reidentify
        Becoming.Hibernation.exchange).RenewingIn
    Becoming.Hibernation.Formation.hibernator
Becoming.Hibernation.readings : Becoming.Hibernation.web.Dependent ∧
  ¬Becoming.Hibernation.web.active 1 Becoming.Hibernation.Formation.hibernator ∧
    Becoming.Hibernation.web.Holds 1 Becoming.Hibernation.Formation.hibernator ∧
      Becoming.Hibernation.web.Arises 1 Becoming.Hibernation.Formation.hibernator ∧
        ¬(Becoming.Hibernation.web.persisting Becoming.Hibernation.web.Holds).Arises 1
              Becoming.Hibernation.Formation.hibernator ∧
          Becoming.Hibernation.web.Arises 1 Becoming.Hibernation.Formation.forager ∧
            (Becoming.Hibernation.web.persisting Becoming.Hibernation.web.Holds).Arises 1
                Becoming.Hibernation.Formation.forager ∧
              Becoming.Hibernation.exchange.KeepsActive Becoming.Hibernation.web ∧
                Becoming.Hibernation.exchange.back.KeepsActive
                    (Becoming.Hibernation.web.reidentify Becoming.Hibernation.exchange) ∧
                  Becoming.Hibernation.exchange.KeepsTenure Becoming.Hibernation.web ∧
                    Becoming.Hibernation.exchange.back.KeepsTenure
                        (Becoming.Hibernation.web.reidentify Becoming.Hibernation.exchange) ∧
                      ¬Becoming.Hibernation.exchange.KeepsActive
                            (Becoming.Hibernation.web.persisting Becoming.Hibernation.web.Holds) ∧
                        Becoming.Hibernation.web.RenewingIn Becoming.Hibernation.Formation.hibernator ∧
                          (Becoming.Hibernation.web.reidentify Becoming.Hibernation.exchange).ConsumingIn
                              Becoming.Hibernation.Formation.hibernator ∧
                            ¬(Becoming.Hibernation.web.reidentify Becoming.Hibernation.exchange).RenewingIn
                                  Becoming.Hibernation.Formation.hibernator ∧
                              ∀ (σ : Becoming.Reidentify Becoming.Hibernation.Formation Becoming.Hibernation.Formation),
                                σ.KeepsActive (Becoming.Hibernation.web.persisting Becoming.Hibernation.web.Holds) →
                                  (Becoming.Hibernation.web.reidentify σ).RenewingIn
                                    (σ.new 0 Becoming.Hibernation.Formation.hibernator)
Becoming.Dormancy.held_both : Becoming.Dormancy.join.KeepsActive
    (Becoming.Dormancy.web.persisting Becoming.Dormancy.web.Holds) ∧
  Becoming.Dormancy.join.back.KeepsActive
      ((Becoming.Dormancy.web.persisting Becoming.Dormancy.web.Holds).reidentify Becoming.Dormancy.join) ∧
    Becoming.Dormancy.web.RenewingIn Becoming.Dormancy.Formation.early ∧
      ¬Becoming.Dormancy.joined.RenewingIn Becoming.Dormancy.Formation.early
Becoming.Seed.held_readings : Becoming.Seed.web.Arises 0 () ∧
  Becoming.Seed.web.Arises 2 () ∧
    (∀ (t : Nat), (Becoming.Seed.web.persisting Becoming.Seed.web.Holds).active t ()) ∧
      (∀ (t : Nat), ¬(Becoming.Seed.web.persisting Becoming.Seed.web.Holds).Arises t ()) ∧
        (∀ (t : Nat),
            ¬(Becoming.Seed.web.persisting fun t f => Becoming.Seed.web.active t f ∨ 0 < Becoming.Seed.reserve t).Arises
                t ()) ∧
          (Becoming.Seed.web.persisting fun t f => Becoming.Seed.web.active t f ∨ 0 < Becoming.Seed.reserve t).Ceases 3
            ()
Becoming.Sleeper.held_readings : Becoming.Sleeper.web.Unceasing ∧
  (∀ (N : Nat), ∃ t, N ≤ t ∧ Becoming.Sleeper.web.Ceases t ()) ∧
    ∀ (t : Nat),
      ¬(Becoming.Sleeper.web.persisting fun t x =>
              Becoming.Sleeper.web.active t x ∨ 0 < Becoming.Sleeper.web.level t x).Arises
          t ()
@Becoming.World.reidentify_taken : ∀ {w : Becoming.World} {R' : Type} (σ : Becoming.Reidentify w.Relatum R') (t : Nat)
  (y : R'), (w.reidentify σ).flow.taken t y = w.flow.taken t (σ.old t y)
@Becoming.World.reidentify_given : ∀ {w : Becoming.World} {R' : Type} (σ : Becoming.Reidentify w.Relatum R') (t : Nat)
  (y : R'), (w.reidentify σ).flow.given t y = w.flow.given t (σ.old t y)
@Becoming.World.balanced_iff_conserves : ∀ {w : Becoming.World},
  w.Balanced ↔ ∀ (t : Nat) (c : w.Relatum), w.Conserves t c c
@Becoming.World.balanced_reidentify_iff : ∀ {w : Becoming.World} {R' : Type} (σ : Becoming.Reidentify w.Relatum R'),
  (w.reidentify σ).Balanced ↔ ∀ (t : Nat) (c : w.Relatum), w.Conserves t c (σ.old (t + 1) (σ.new t c))
@Becoming.World.conserves_iff : ∀ {w : Becoming.World},
  w.Balanced → ∀ {t : Nat} {g f : w.Relatum}, w.Conserves t g f ↔ w.web.level (t + 1) f = w.web.level (t + 1) g
@Becoming.World.balanced_reidentify_iff_alike : ∀ {w : Becoming.World} {R' : Type},
  w.Balanced →
    ∀ (σ : Becoming.Reidentify w.Relatum R'),
      (w.reidentify σ).Balanced ↔
        ∀ (t : Nat),
          Becoming.Alike (Becoming.exchangeFrame w.Relatum) (Becoming.exchangeFrame w.Relatum)
            (fun c => w.web.level (t + 1) (σ.old (t + 1) (σ.new t c))) (w.web.level (t + 1))
@Becoming.World.standing_after : ∀ {w : Becoming.World} {R' : Type},
  w.Balanced →
    ∀ {σ : Becoming.Reidentify w.Relatum R'},
      (w.reidentify σ).Balanced →
        ∀ (t : Nat) (y : R'), w.web.level (t + 1) (σ.old (t + 1) y) = w.web.level (t + 1) (σ.old t y)
@Becoming.World.kept_broken_reidentify : ∀ {w : Becoming.World} {R' : Type},
  w.Balanced →
    ∀ {σ : Becoming.Reidentify w.Relatum R'},
      (w.reidentify σ).Balanced →
        ∀ (t : Nat) (x y : R'),
          ((w.reidentify σ).web.Kept t x y ↔ w.web.Kept t (σ.old t x) (σ.old t y)) ∧
            ((w.reidentify σ).web.Broken t x y ↔ w.web.Broken t (σ.old t x) (σ.old t y))
@Becoming.transpose_left : ∀ {X : Type} [inst : DecidableEq X] (c d : X), Becoming.transpose c d c = d
@Becoming.transpose_right : ∀ {X : Type} [inst : DecidableEq X] (c d : X), Becoming.transpose c d d = c
@Becoming.transpose_other : ∀ {X : Type} [inst : DecidableEq X] {c d x : X},
  ¬x = c → ¬x = d → Becoming.transpose c d x = x
@Becoming.transpose_transpose : ∀ {X : Type} [inst : DecidableEq X] (c d x : X),
  Becoming.transpose c d (Becoming.transpose c d x) = x
@Becoming.transpose_alike : ∀ {X : Type} [inst : DecidableEq X] {q : X → Nat} {c d : X},
  q d = q c → ∀ (x : X), q (Becoming.transpose c d x) = q x
