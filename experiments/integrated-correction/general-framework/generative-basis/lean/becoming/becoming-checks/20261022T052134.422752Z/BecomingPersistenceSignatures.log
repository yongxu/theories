@Becoming.Reidentify.exchangeAfter_at : ∀ {X : Type} [inst : DecidableEq X] (t : Nat) (c d x : X),
  (Becoming.Reidentify.exchangeAfter t c d).old t x = x ∧ (Becoming.Reidentify.exchangeAfter t c d).new t x = x
@Becoming.Reidentify.exchangeAfter_next : ∀ {X : Type} [inst : DecidableEq X] (t : Nat) (c d x : X),
  (Becoming.Reidentify.exchangeAfter t c d).new (t + 1) x = Becoming.transpose c d x
@Becoming.Reidentify.exchangeAfter_across : ∀ {X : Type} [inst : DecidableEq X] (t : Nat) (c d x : X),
  (Becoming.Reidentify.exchangeAfter t c d).old (t + 1) ((Becoming.Reidentify.exchangeAfter t c d).new t x) =
    Becoming.transpose c d x
@Becoming.Reidentify.exchangeAfter_elsewhere : ∀ {X : Type} [inst : DecidableEq X] {t s : Nat},
