          ∀ (t : Nat), (w.reidentify σ).web.Arises t x ↔ w.web.Arises t (σ.old 0 x)
@Becoming.World.classes_fixed : ∀ {w : Becoming.World} {R' : Type},
  w.Balanced →
    (∀ (t : Nat) (c d : w.Relatum), w.web.level (t + 1) c = w.web.level (t + 1) d → c = d) →
      ∀ {σ : Becoming.Reidentify w.Relatum R'},
