          (w.reidentify σ).Balanced → (w.reidentify σ).web.Ceases t (σ.new t g)) ↔
        w.web.CeasesFrom w.Conserves t g
@Becoming.World.conserves_noSplit : ∀ {w : Becoming.World},
  w.Balanced →
    (∀ (t : Nat) (f f' : w.Relatum),
        w.web.active (t + 1) f → w.web.active (t + 1) f' → w.web.level (t + 1) f = w.web.level (t + 1) f' → f = f') →
      w.web.NoSplit w.Conserves
@Becoming.World.conserves_noMerge : ∀ {w : Becoming.World},
  w.Balanced →
    (∀ (t : Nat) (g g' : w.Relatum),
        w.web.active t g → w.web.active t g' → w.web.level (t + 1) g = w.web.level (t + 1) g' → g = g') →
      w.web.NoMerge w.Conserves
