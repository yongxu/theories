  Becoming.BranchingTest.Holds J.retainedFrame [x] (Becoming.BranchingTest.can (0, 0) Becoming.BranchingTest.top) ↔
    J.SelfJoinable x
@Becoming.Joining.retained_apart : ∀ {F : Type u_1} {G : Type u_2} {J : Becoming.Joining F} {K : Becoming.Joining G}
  {x : F} {y : G},
  J.SelfJoinable x → ¬K.SelfJoinable y → ¬Becoming.SameBranchingTests J.retainedFrame K.retainedFrame [x] [y]
@Becoming.Joining.retained_codes_apart : ∀ {F : Type u_1} {K : Type u_2} {J : Becoming.Joining F} {π : List F → K},
  (∀ (xs ys : List F), π xs = π ys → Becoming.SameBranchingTests J.retainedFrame J.retainedFrame xs ys) →
    ∀ {x y : F}, J.SelfJoinable x → ¬J.SelfJoinable y → π [x] ≠ π [y]
@Becoming.Joining.FiniteOutcomes.retained_outcomes : ∀ {F : Type u_1} {J : Becoming.Joining F},
  J.FiniteOutcomes → ∀ (xs : List F) (ij : Nat × Nat), ∃ l, ∀ (ys : List F), J.retainedFrame.P.step xs ij ys ↔ ys ∈ l
@Becoming.Joining.FiniteOutcomes.retained_alike_iff : ∀ {F : Type u_1} {G : Type u_2},
  (∀ (p : Prop), Becoming.Decided p) →
    ∀ {J : Becoming.Joining F} {K : Becoming.Joining G},
      J.FiniteOutcomes →
        K.FiniteOutcomes →
          ∀ {xs : List F} {ys : List G},
            Becoming.Alike J.retainedFrame K.retainedFrame xs ys ↔
              Becoming.SameBranchingTests J.retainedFrame K.retainedFrame xs ys
@Becoming.Joining.retained_history_matches_of_em : ∀ {F : Type u_1} {G : Type u_2},
  (∀ (p : Prop), Becoming.Decided p) →
    ∀ {J : Becoming.Joining F} {K : Becoming.Joining G},
      J.FiniteOutcomes →
        K.FiniteOutcomes →
          ∀ {xs : List F} {ys : List G},
            Becoming.SameBranchingTests J.retainedFrame K.retainedFrame xs ys →
              xs.length = ys.length →
                ∀ {cmds : List (Nat × Nat)} {finish : List F},
                  Generative.Trace J.retainedFrame.P xs cmds finish →
                    ∃ finish',
                      Generative.Trace K.retainedFrame.P ys cmds finish' ∧
                        Becoming.SameBranchingTests J.retainedFrame K.retainedFrame finish finish' ∧
                          finish.length = finish'.length ∧ ∃ added, finish' = ys ++ added
