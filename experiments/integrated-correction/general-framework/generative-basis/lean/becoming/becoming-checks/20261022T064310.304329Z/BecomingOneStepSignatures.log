      ∀ (t : Nat), Becoming.OneStep.Closed (P t) (k t) (e t) ∧ Becoming.OneStep.Givers (P t) (r t)
Becoming.OneStep.run_runsDownClosed_givers_iff : ∀ (P : Nat → List Becoming.Passage) (k r : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.RunRealizedGivers (fun w t es => w.flow.RunsDownOn w.web es t ∧ w.flow.ClosedAt es t) P k r e ↔
    Becoming.OneStep.Chained P ∧
      ∀ (t : Nat), Becoming.OneStep.RunsDownClosed (P t) (k t) (e t) ∧ Becoming.OneStep.Givers (P t) (r t) ∧ r t ≤ k t
Becoming.OneStep.step_every_iff : ∀ (P : Nat → List Becoming.Passage) (k r : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.StepRealized (fun x x_1 x_2 => True) P k r e ↔
    ∀ (t : Nat), Becoming.OneStep.Every (P t) (k t) (e t) ∧ Becoming.OneStep.Givers (P t) (r t)
Becoming.OneStep.step_balance_iff : ∀ (P : Nat → List Becoming.Passage) (k r : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.StepRealized (fun w t es => w.flow.BalancesOn w.web es t) P k r e ↔
