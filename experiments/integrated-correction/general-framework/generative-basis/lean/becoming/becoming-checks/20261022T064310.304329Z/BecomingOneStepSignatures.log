Becoming.OneStep.step_closed_iff : ∀ (P : Nat → List Becoming.Passage) (k r : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.StepRealized (fun w t es => w.flow.ClosedAt es t) P k r e ↔
    ∀ (t : Nat), Becoming.OneStep.Closed (P t) (k t) (e t) ∧ Becoming.OneStep.Givers (P t) (r t)
Becoming.OneStep.step_runsDown_iff : ∀ (P : Nat → List Becoming.Passage) (k r : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.StepRealized (fun w t es => w.flow.RunsDownOn w.web es t) P k r e ↔
    Becoming.OneStep.Continues P ∧
      ∀ (t : Nat), Becoming.OneStep.RunsDown (P t) (k t) (e t) ∧ Becoming.OneStep.Givers (P t) (r t) ∧ r t ≤ k t
Becoming.OneStep.step_runsDownClosed_iff : ∀ (P : Nat → List Becoming.Passage) (k r : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.StepRealized (fun w t es => w.flow.RunsDownOn w.web es t ∧ w.flow.ClosedAt es t) P k r e ↔
    Becoming.OneStep.Continues P ∧
      ∀ (t : Nat), Becoming.OneStep.RunsDownClosed (P t) (k t) (e t) ∧ Becoming.OneStep.Givers (P t) (r t) ∧ r t ≤ k t
@Becoming.OneStep.stepRun_iff_givers : ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop}
  {P : Nat → List Becoming.Passage} {k : Nat → Nat} {e : Nat → Prop},
  Becoming.OneStep.StepRunRealized cond P k e ↔ ∃ r, Becoming.OneStep.StepRealized cond P k r e
Becoming.OneStep.givers_sign : ∀ (Q : List Becoming.Passage),
  Becoming.OneStep.Givers Q (Becoming.sign (Becoming.total Q Becoming.Passage.given))
@Becoming.OneStep.RunsDown.sign_given_le : ∀ {Q : List Becoming.Passage} {k' : Nat} {e' : Prop},
  Becoming.OneStep.RunsDown Q k' e' → Becoming.sign (Becoming.total Q Becoming.Passage.given) ≤ k'
@Becoming.OneStep.stepRun_runsDown_iff : ∀ {P : Nat → List Becoming.Passage} {k : Nat → Nat} {e : Nat → Prop},
  Becoming.OneStep.StepRunRealized (fun w t es => w.flow.RunsDownOn w.web es t) P k e ↔
