          (∀ (p : Becoming.Passage), p ∈ P t → p.Balanced) →
            (∀ (a : Nat),
                Becoming.OneStep.Chain.entry (g t) a + Becoming.sign (Becoming.OneStep.Chain.entry (d t) a) ≤
                  Becoming.OneStep.Chain.entry (d t) a) →
              (∀ (c : Becoming.OneStep.Chain.Site o),
                  0 < (Becoming.OneStep.Chain.web σ ρ P o).level t c → c ∈ Becoming.OneStep.Chain.family ρ P o t) →
                (∀ (j : Nat), 0 < (Becoming.OneStep.Witness.pick (P (t + 1)) j).before → ∃ i, ρ t j = some i) →
                  (Becoming.OneStep.Chain.flow σ ρ P d g o).RunsDownOn (Becoming.OneStep.Chain.web σ ρ P o)
                    (Becoming.OneStep.Chain.family ρ P o t) t
Becoming.OneStep.Chain.unlinked_links : ∀ (P : Nat → List Becoming.Passage),
  Becoming.OneStep.Chain.Links Becoming.OneStep.Chain.unlinked Becoming.OneStep.Chain.unlinked P
@Becoming.OneStep.Chain.identical_links : ∀ {P : Nat → List Becoming.Passage},
  Becoming.OneStep.Chained P →
    Becoming.OneStep.Chain.Links Becoming.OneStep.Chain.identical Becoming.OneStep.Chain.identical P
Becoming.OneStep.Chain.origin_identical : ∀ (t j : Nat),
  Becoming.OneStep.Chain.origin Becoming.OneStep.Chain.identical t j = (0, j)
@Becoming.OneStep.Chain.family_identical : ∀ {P : Nat → List Becoming.Passage} {o : Nat → Prop},
  Becoming.OneStep.Chained P →
    ∀ (t : Nat),
      Becoming.OneStep.Chain.family Becoming.OneStep.Chain.identical P o t =
        List.map (fun j => Becoming.OneStep.Chain.Site.node (0, j)) (Becoming.steps 0 (P 0).length)
@Becoming.OneStep.Chain.guard_some : ∀ {a j j' : Nat}, Becoming.OneStep.Chain.guard a j = some j' → 0 < a ∧ j = j'
@Becoming.OneStep.Chain.guard_pos : ∀ {a : Nat} (j : Nat), 0 < a → Becoming.OneStep.Chain.guard a j = some j
@Becoming.OneStep.Chain.below_succ : ∀ {q : Becoming.Passage → Nat} {v : Nat} (p : Becoming.Passage)
  (Q : List Becoming.Passage) (i : Nat),
  Becoming.OneStep.Chain.below q (p :: Q) v (i + 1) =
    Becoming.OneStep.Witness.hit (q p) v + Becoming.OneStep.Chain.below q Q v i
@Becoming.OneStep.Chain.nth_spec : ∀ {q : Becoming.Passage → Nat} {v : Nat} (Q : List Becoming.Passage) (n : Nat),
  n < Becoming.OneStep.Chain.tally q Q v →
    Becoming.OneStep.Chain.nth q v Q n < Q.length ∧
      q (Becoming.OneStep.Witness.pick Q (Becoming.OneStep.Chain.nth q v Q n)) = v ∧
        Becoming.OneStep.Chain.below q Q v (Becoming.OneStep.Chain.nth q v Q n) = n
@Becoming.OneStep.Chain.nth_below : ∀ {q : Becoming.Passage → Nat} {v : Nat} (Q : List Becoming.Passage) (i : Nat),
  i < Q.length →
    q (Becoming.OneStep.Witness.pick Q i) = v →
      Becoming.OneStep.Chain.nth q v Q (Becoming.OneStep.Chain.below q Q v i) = i
@Becoming.OneStep.Chain.below_lt_tally : ∀ {q : Becoming.Passage → Nat} {v : Nat} (Q : List Becoming.Passage) (i : Nat),
  i < Q.length →
    q (Becoming.OneStep.Witness.pick Q i) = v →
      Becoming.OneStep.Chain.below q Q v i < Becoming.OneStep.Chain.tally q Q v
@Becoming.OneStep.Chain.match_back : ∀ {q q' : Becoming.Passage → Nat},
  q Becoming.Passage.idle = 0 →
    ∀ {Q Q' : List Becoming.Passage},
      (∀ (v : Nat), 0 < v → Becoming.OneStep.Chain.tally q Q v = Becoming.OneStep.Chain.tally q' Q' v) →
        ∀ {i j : Nat},
          Becoming.OneStep.Chain.guard (q (Becoming.OneStep.Witness.pick Q i))
                (Becoming.OneStep.Chain.nth q' (q (Becoming.OneStep.Witness.pick Q i)) Q'
                  (Becoming.OneStep.Chain.below q Q (q (Becoming.OneStep.Witness.pick Q i)) i)) =
              some j →
            Becoming.OneStep.Chain.guard (q' (Becoming.OneStep.Witness.pick Q' j))
                  (Becoming.OneStep.Chain.nth q (q' (Becoming.OneStep.Witness.pick Q' j)) Q
                    (Becoming.OneStep.Chain.below q' Q' (q' (Becoming.OneStep.Witness.pick Q' j)) j)) =
                some i ∧
              q (Becoming.OneStep.Witness.pick Q i) = q' (Becoming.OneStep.Witness.pick Q' j)
@Becoming.OneStep.Chained.continues : ∀ {P : Nat → List Becoming.Passage},
  Becoming.OneStep.Chained P → Becoming.OneStep.Continues P
@Becoming.OneStep.Chain.rank_links : ∀ {P : Nat → List Becoming.Passage},
  Becoming.OneStep.Continues P →
    Becoming.OneStep.Chain.Links (Becoming.OneStep.Chain.rankNext P) (Becoming.OneStep.Chain.rankPrev P) P
Becoming.OneStep.Chain.rankNext_onward : ∀ (P : Nat → List Becoming.Passage) (s i : Nat),
  0 < (Becoming.OneStep.Witness.pick (P s) i).after → ∃ j, Becoming.OneStep.Chain.rankNext P s i = some j
Becoming.OneStep.Chain.rankPrev_backward : ∀ (P : Nat → List Becoming.Passage) (t j : Nat),
  0 < (Becoming.OneStep.Witness.pick (P (t + 1)) j).before → ∃ i, Becoming.OneStep.Chain.rankPrev P t j = some i
@Becoming.OneStep.Chain.covered_tally : ∀ {X : Type} {lev : X → Nat} {l m : List X},
  Becoming.Distinct l →
    Becoming.Distinct m →
      (∀ (c : X), 0 < lev c → c ∈ l) →
        (∀ (c : X), 0 < lev c → c ∈ m) →
          ∀ {v : Nat},
            0 < v →
              (Becoming.total l fun c => Becoming.OneStep.Witness.hit (lev c) v) =
                Becoming.total m fun c => Becoming.OneStep.Witness.hit (lev c) v
@Becoming.OneStep.Chain.pos_or_none : ∀ {X k x : Nat}, Becoming.sign X ≤ k → (X = 0 → x = 0) → 0 < k ∨ x = 0
@Becoming.OneStep.Chain.excess_of_zero : ∀ {X : Nat} (y : Nat), X = 0 → Becoming.excess X y = 0
@Becoming.OneStep.Chain.taking_shares : ∀ {X k : Nat},
  Becoming.sign X ≤ k →
    k ≤ X →
      (Becoming.total (Becoming.OneStep.Chain.lift [] k (Becoming.excess X k)) fun y => y) = X ∧
        (Becoming.count (Becoming.OneStep.Chain.lift [] k (Becoming.excess X k)) fun y => y) = k
@Becoming.OneStep.Chain.running_shares : ∀ {X Y k : Nat} {gl : List Nat},
  Becoming.sign X ≤ k →
    gl.length ≤ k →
      (Becoming.total gl fun y => y) = Y →
        Y + k ≤ X →
          (Becoming.total (Becoming.OneStep.Chain.lift gl k (Becoming.excess X (Y + k))) fun y => y) = X ∧
            (Becoming.count (Becoming.OneStep.Chain.lift gl k (Becoming.excess X (Y + k))) fun y => y) = k ∧
              ∀ (a : Nat),
                Becoming.OneStep.Chain.entry gl a +
                    Becoming.sign
                      (Becoming.OneStep.Chain.entry (Becoming.OneStep.Chain.lift gl k (Becoming.excess X (Y + k))) a) ≤
                  Becoming.OneStep.Chain.entry (Becoming.OneStep.Chain.lift gl k (Becoming.excess X (Y + k))) a
@Becoming.OneStep.Chain.self_le_mul : ∀ {Y r : Nat}, Becoming.sign Y ≤ r → Y ≤ Y * r
@Becoming.OneStep.Chain.solo_shows : ∀ {P : List Becoming.Passage} {d g : List Nat} {o : Prop},
  (Becoming.total d fun y => y) = Becoming.total P Becoming.Passage.taken →
    (Becoming.total g fun y => y) = Becoming.total P Becoming.Passage.given →
      Becoming.Distinct ((Becoming.OneStep.Chain.solo P d g o).flow.present 0) ∧
        (Becoming.OneStep.Chain.solo P d g o).flow.RealizesGivers (Becoming.OneStep.Chain.solo P d g o).web 0
          (Becoming.OneStep.Chain.soloFamily P o) P (Becoming.count d fun y => y) (Becoming.count g fun y => y)
          (0 < Becoming.total P Becoming.Passage.taken ∨ 0 < Becoming.total P Becoming.Passage.given ∨ o)
@Becoming.OneStep.Chain.solo_balancesOn : ∀ {P : List Becoming.Passage} {d g : List Nat} {o : Prop},
  (Becoming.total d fun y => y) = Becoming.total P Becoming.Passage.taken →
    (Becoming.total g fun y => y) = Becoming.total P Becoming.Passage.given →
      (∀ (p : Becoming.Passage), p ∈ P → p.Balanced) →
        (Becoming.OneStep.Chain.solo P d g o).flow.BalancesOn (Becoming.OneStep.Chain.solo P d g o).web
          (Becoming.OneStep.Chain.soloFamily P o) 0
@Becoming.OneStep.Chain.solo_runsDownOn : ∀ {P : List Becoming.Passage} {d g : List Nat} {o : Prop},
  (Becoming.total d fun y => y) = Becoming.total P Becoming.Passage.taken →
    (Becoming.total g fun y => y) = Becoming.total P Becoming.Passage.given →
      (∀ (p : Becoming.Passage), p ∈ P → p.Balanced) →
        (∀ (a : Nat),
            Becoming.OneStep.Chain.entry g a + Becoming.sign (Becoming.OneStep.Chain.entry d a) ≤
              Becoming.OneStep.Chain.entry d a) →
          (Becoming.OneStep.Chain.solo P d g o).flow.RunsDownOn (Becoming.OneStep.Chain.solo P d g o).web
            (Becoming.OneStep.Chain.soloFamily P o) 0
@Becoming.OneStep.Chain.solo_capacityAt : ∀ {P : List Becoming.Passage} {d g : List Nat} {o : Prop},
  (Becoming.total g fun y => y) = Becoming.total P Becoming.Passage.given →
    ∀ {cap : Nat},
      (∀ (a : Nat), Becoming.OneStep.Chain.entry g a ≤ cap) →
        (Becoming.OneStep.Chain.solo P d g o).flow.CapacityAt (Becoming.OneStep.Chain.soloFamily P o) 0 cap
Becoming.OneStep.Chain.solo_closedAt : ∀ (P : List Becoming.Passage) (d g : List Nat),
  (Becoming.OneStep.Chain.solo P d g False).flow.ClosedAt (Becoming.OneStep.Chain.soloFamily P False) 0
Becoming.OneStep.Chain.solo_active : ∀ (P : List Becoming.Passage) (d g : List Nat) (o : Prop),
  (Becoming.OneStep.Chain.solo P d g o).flow.ActingAt (Becoming.OneStep.Chain.solo P d g o).web 0 ∧
    (Becoming.OneStep.Chain.solo P d g o).flow.TakingAt (Becoming.OneStep.Chain.solo P d g o).web 0
@Becoming.OneStep.RealizedGivers.weaken : ∀ {cond cond' : (w : Becoming.World) → Nat → List w.Relatum → Prop},
  (∀ (w : Becoming.World) (t : Nat) (es : List w.Relatum), cond w t es → cond' w t es) →
    ∀ {P : List Becoming.Passage} {k r : Nat} {e : Prop},
      Becoming.OneStep.RealizedGivers cond P k r e → Becoming.OneStep.RealizedGivers cond' P k r e
Becoming.OneStep.realized_iff_givers : ∀ (cond : (w : Becoming.World) → Nat → List w.Relatum → Prop)
  (P : List Becoming.Passage) (k : Nat) (e : Prop),
  Becoming.OneStep.Realized cond P k e ↔ ∃ r, Becoming.OneStep.RealizedGivers cond P k r e
@Becoming.OneStep.Chain.realizedOnce : ∀ {P : List Becoming.Passage} {k r : Nat} {e : Prop} {d g : List Nat},
  (Becoming.total d fun y => y) = Becoming.total P Becoming.Passage.taken →
    (Becoming.total g fun y => y) = Becoming.total P Becoming.Passage.given →
      (Becoming.count d fun y => y) = k →
        (Becoming.count g fun y => y) = r →
          ∀ (o : Prop),
            (0 < Becoming.total P Becoming.Passage.taken ∨ 0 < Becoming.total P Becoming.Passage.given ∨ o ↔ e) →
              ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop},
                cond (Becoming.OneStep.Chain.solo P d g o) 0 (Becoming.OneStep.Chain.soloFamily P o) →
                  Becoming.OneStep.RealizedGivers cond P k r e
@Becoming.OneStep.Chain.realizedOpen : ∀ {P : List Becoming.Passage} {k r : Nat} {e : Prop},
  Becoming.OneStep.Every P k e →
    Becoming.OneStep.Givers P r →
      ∀ {cap : Nat},
        Becoming.total P Becoming.Passage.given ≤ cap * r →
          ∀ (o : Prop),
            (0 < Becoming.total P Becoming.Passage.taken ∨ 0 < Becoming.total P Becoming.Passage.given ∨ o ↔ e) →
              ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop},
                (∀ (d g : List Nat),
                    (Becoming.total d fun y => y) = Becoming.total P Becoming.Passage.taken →
                      (Becoming.total g fun y => y) = Becoming.total P Becoming.Passage.given →
                        (∀ (a : Nat), Becoming.OneStep.Chain.entry g a ≤ cap) →
                          cond (Becoming.OneStep.Chain.solo P d g o) 0 (Becoming.OneStep.Chain.soloFamily P o)) →
                  Becoming.OneStep.RealizedGivers cond P k r e
@Becoming.OneStep.Chain.realizedRunning : ∀ {P : List Becoming.Passage} {k r : Nat} {e : Prop},
  Becoming.OneStep.RunsDown P k e →
    Becoming.OneStep.Givers P r →
      r ≤ k →
        ∀ {cap : Nat},
          Becoming.total P Becoming.Passage.given ≤ cap * r →
            ∀ (o : Prop),
              (0 < Becoming.total P Becoming.Passage.taken ∨ 0 < Becoming.total P Becoming.Passage.given ∨ o ↔ e) →
                ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop},
                  (∀ (d g : List Nat),
                      (Becoming.total d fun y => y) = Becoming.total P Becoming.Passage.taken →
                        (Becoming.total g fun y => y) = Becoming.total P Becoming.Passage.given →
                          (∀ (a : Nat), Becoming.OneStep.Chain.entry g a ≤ cap) →
                            (∀ (a : Nat),
                                Becoming.OneStep.Chain.entry g a + Becoming.sign (Becoming.OneStep.Chain.entry d a) ≤
                                  Becoming.OneStep.Chain.entry d a) →
                              cond (Becoming.OneStep.Chain.solo P d g o) 0 (Becoming.OneStep.Chain.soloFamily P o)) →
                    Becoming.OneStep.RealizedGivers cond P k r e
Becoming.OneStep.every_givers_iff : ∀ (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers (fun x x_1 x_2 => True) P k r e ↔
    Becoming.OneStep.Every P k e ∧ Becoming.OneStep.Givers P r
Becoming.OneStep.balance_givers_iff : ∀ (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers (fun w t es => w.flow.BalancesOn w.web es t) P k r e ↔
    Becoming.OneStep.Balance P k e ∧ Becoming.OneStep.Givers P r
Becoming.OneStep.runsDown_givers_iff : ∀ (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers (fun w t es => w.flow.RunsDownOn w.web es t) P k r e ↔
    Becoming.OneStep.RunsDown P k e ∧ Becoming.OneStep.Givers P r ∧ r ≤ k
Becoming.OneStep.closed_givers_iff : ∀ (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers (fun w t es => w.flow.ClosedAt es t) P k r e ↔
    Becoming.OneStep.Closed P k e ∧ Becoming.OneStep.Givers P r
Becoming.OneStep.runsDownClosed_givers_iff : ∀ (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers (fun w t es => w.flow.RunsDownOn w.web es t ∧ w.flow.ClosedAt es t) P k r e ↔
    Becoming.OneStep.RunsDownClosed P k e ∧ Becoming.OneStep.Givers P r ∧ r ≤ k
Becoming.OneStep.every_capacity_iff : ∀ (cap : Nat) (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers (fun w t es => w.flow.CapacityAt es t cap) P k r e ↔
    Becoming.OneStep.Every P k e ∧ Becoming.OneStep.Givers P r ∧ Becoming.total P Becoming.Passage.given ≤ cap * r
Becoming.OneStep.balance_capacity_iff : ∀ (cap : Nat) (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers (fun w t es => w.flow.BalancesOn w.web es t ∧ w.flow.CapacityAt es t cap) P k r e ↔
    Becoming.OneStep.Balance P k e ∧ Becoming.OneStep.Givers P r ∧ Becoming.total P Becoming.Passage.given ≤ cap * r
Becoming.OneStep.runsDown_capacity_iff : ∀ (cap : Nat) (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers (fun w t es => w.flow.RunsDownOn w.web es t ∧ w.flow.CapacityAt es t cap) P k r e ↔
    Becoming.OneStep.RunsDown P k e ∧
      Becoming.OneStep.Givers P r ∧ r ≤ k ∧ Becoming.total P Becoming.Passage.given ≤ cap * r
Becoming.OneStep.closed_capacity_iff : ∀ (cap : Nat) (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers (fun w t es => w.flow.ClosedAt es t ∧ w.flow.CapacityAt es t cap) P k r e ↔
    Becoming.OneStep.Closed P k e ∧ Becoming.OneStep.Givers P r ∧ Becoming.total P Becoming.Passage.given ≤ cap * r
Becoming.OneStep.runsDownClosed_capacity_iff : ∀ (cap : Nat) (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers
      (fun w t es => (w.flow.RunsDownOn w.web es t ∧ w.flow.ClosedAt es t) ∧ w.flow.CapacityAt es t cap) P k r e ↔
    Becoming.OneStep.RunsDownClosed P k e ∧
      Becoming.OneStep.Givers P r ∧ r ≤ k ∧ Becoming.total P Becoming.Passage.given ≤ cap * r
Becoming.OneStep.every_active_iff : ∀ (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers (fun w t x => w.flow.ActingAt w.web t ∧ w.flow.TakingAt w.web t) P k r e ↔
    Becoming.OneStep.Every P k e ∧ Becoming.OneStep.Givers P r
Becoming.OneStep.balance_active_iff : ∀ (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers
      (fun w t es => w.flow.BalancesOn w.web es t ∧ w.flow.ActingAt w.web t ∧ w.flow.TakingAt w.web t) P k r e ↔
    Becoming.OneStep.Balance P k e ∧ Becoming.OneStep.Givers P r
Becoming.OneStep.runsDown_active_iff : ∀ (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers
      (fun w t es => w.flow.RunsDownOn w.web es t ∧ w.flow.ActingAt w.web t ∧ w.flow.TakingAt w.web t) P k r e ↔
    Becoming.OneStep.RunsDown P k e ∧ Becoming.OneStep.Givers P r ∧ r ≤ k
Becoming.OneStep.closed_active_iff : ∀ (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers
      (fun w t es => w.flow.ClosedAt es t ∧ w.flow.ActingAt w.web t ∧ w.flow.TakingAt w.web t) P k r e ↔
    Becoming.OneStep.Closed P k e ∧ Becoming.OneStep.Givers P r
Becoming.OneStep.runsDownClosed_active_iff : ∀ (P : List Becoming.Passage) (k r : Nat) (e : Prop),
  Becoming.OneStep.RealizedGivers
      (fun w t es =>
        (w.flow.RunsDownOn w.web es t ∧ w.flow.ClosedAt es t) ∧ w.flow.ActingAt w.web t ∧ w.flow.TakingAt w.web t)
      P k r e ↔
    Becoming.OneStep.RunsDownClosed P k e ∧ Becoming.OneStep.Givers P r ∧ r ≤ k
@Becoming.OneStep.laws_givers : ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop}
  {Law : List Becoming.Passage → Nat → Nat → Prop → Prop},
  (∀ (P : List Becoming.Passage) (k r : Nat) (e : Prop), Becoming.OneStep.RealizedGivers cond P k r e ↔ Law P k r e) →
    ∀ {Q : List Becoming.Passage → Nat → Nat → Prop → Prop},
      Becoming.OneStep.RespectsGivers Q →
        ((∀ (w : Becoming.World) (t : Nat) (es : List w.Relatum),
            cond w t es →
              Becoming.Distinct (w.flow.present t) →
                Q (List.map (w.flow.passage w.web t) es) (w.flow.takers es t) (w.flow.renewers es t)
                  (w.flow.ExchangesAt t)) ↔
          ∀ (P : List Becoming.Passage) (k r : Nat) (e : Prop), Law P k r e → Q P k r e)
@Becoming.OneStep.RunRealizedGivers.run : ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop}
  {P : Nat → List Becoming.Passage} {k r : Nat → Nat} {e : Nat → Prop},
  Becoming.OneStep.RunRealizedGivers cond P k r e → Becoming.OneStep.RunRealized cond P k e
@Becoming.OneStep.RunRealizedGivers.steps : ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop}
  {P : Nat → List Becoming.Passage} {k r : Nat → Nat} {e : Nat → Prop},
  Becoming.OneStep.RunRealizedGivers cond P k r e → Becoming.OneStep.StepRealized cond P k r e
@Becoming.OneStep.StepRealized.continues : ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop}
  {P : Nat → List Becoming.Passage} {k r : Nat → Nat} {e : Nat → Prop},
  (∀ (w : Becoming.World) (t : Nat) (es : List w.Relatum), cond w t es → w.flow.RunsDownOn w.web es t) →
    Becoming.OneStep.StepRealized cond P k r e → Becoming.OneStep.Continues P
@Becoming.OneStep.Chain.showsAll : ∀ {σ ρ : Nat → Nat → Option Nat} {P : Nat → List Becoming.Passage},
  Becoming.OneStep.Chain.Links σ ρ P →
    ∀ {k r : Nat → Nat} {e : Nat → Prop} {d g : Nat → List Nat},
      (∀ (t : Nat), (Becoming.total (d t) fun y => y) = Becoming.total (P t) Becoming.Passage.taken) →
        (∀ (t : Nat), (Becoming.total (g t) fun y => y) = Becoming.total (P t) Becoming.Passage.given) →
          (∀ (t : Nat), (Becoming.count (d t) fun y => y) = k t) →
            (∀ (t : Nat), (Becoming.count (g t) fun y => y) = r t) →
              ∀ (o : Nat → Prop),
                (∀ (t : Nat),
                    0 < Becoming.total (P t) Becoming.Passage.taken ∨
                        0 < Becoming.total (P t) Becoming.Passage.given ∨ o t ↔
                      e t) →
                  ∀ (t : Nat),
                    Becoming.Distinct ((Becoming.OneStep.Chain.world σ ρ P d g o).flow.present t) ∧
                      (Becoming.OneStep.Chain.world σ ρ P d g o).flow.RealizesGivers
                        (Becoming.OneStep.Chain.world σ ρ P d g o).web t
                        (List.map Sum.inr (Becoming.OneStep.Chain.family ρ P o t)) (P t) (k t) (r t) (e t)
@Becoming.OneStep.Chain.openTaken_spec : ∀ {P : Nat → List Becoming.Passage} {k : Nat → Nat} {e : Nat → Prop},
  (∀ (t : Nat), Becoming.OneStep.Every (P t) (k t) (e t)) →
    ∀ (t : Nat),
      (Becoming.total (Becoming.OneStep.Chain.openTaken P k t) fun y => y) =
          Becoming.total (P t) Becoming.Passage.taken ∧
        (Becoming.count (Becoming.OneStep.Chain.openTaken P k t) fun y => y) = k t
@Becoming.OneStep.Chain.openGiven_spec : ∀ {P : Nat → List Becoming.Passage} {r : Nat → Nat},
  (∀ (t : Nat), Becoming.OneStep.Givers (P t) (r t)) →
    ∀ (t : Nat),
      (Becoming.total (Becoming.OneStep.Chain.openGiven P r t) fun y => y) =
          Becoming.total (P t) Becoming.Passage.given ∧
        (Becoming.count (Becoming.OneStep.Chain.openGiven P r t) fun y => y) = r t
@Becoming.OneStep.Chain.runningTaken_spec : ∀ {P : Nat → List Becoming.Passage} {k r : Nat → Nat} {e : Nat → Prop},
  (∀ (t : Nat), Becoming.OneStep.RunsDown (P t) (k t) (e t)) →
    (∀ (t : Nat), Becoming.OneStep.Givers (P t) (r t)) →
      (∀ (t : Nat), r t ≤ k t) →
        ∀ (t : Nat),
          (Becoming.total (Becoming.OneStep.Chain.runningTaken P k r t) fun y => y) =
              Becoming.total (P t) Becoming.Passage.taken ∧
            (Becoming.count (Becoming.OneStep.Chain.runningTaken P k r t) fun y => y) = k t ∧
              ∀ (a : Nat),
                Becoming.OneStep.Chain.entry (Becoming.OneStep.Chain.openGiven P r t) a +
                    Becoming.sign (Becoming.OneStep.Chain.entry (Becoming.OneStep.Chain.runningTaken P k r t) a) ≤
                  Becoming.OneStep.Chain.entry (Becoming.OneStep.Chain.runningTaken P k r t) a
@Becoming.OneStep.Chain.realizedSteps : ∀ {P : Nat → List Becoming.Passage} {k r : Nat → Nat} {e : Nat → Prop}
  {d g : Nat → List Nat},
  (∀ (t : Nat), (Becoming.total (d t) fun y => y) = Becoming.total (P t) Becoming.Passage.taken) →
    (∀ (t : Nat), (Becoming.total (g t) fun y => y) = Becoming.total (P t) Becoming.Passage.given) →
      (∀ (t : Nat), (Becoming.count (d t) fun y => y) = k t) →
        (∀ (t : Nat), (Becoming.count (g t) fun y => y) = r t) →
          ∀ (o : Nat → Prop),
            (∀ (t : Nat),
                0 < Becoming.total (P t) Becoming.Passage.taken ∨
                    0 < Becoming.total (P t) Becoming.Passage.given ∨ o t ↔
                  e t) →
              ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop} {σ ρ : Nat → Nat → Option Nat},
                Becoming.OneStep.Chain.Links σ ρ P →
                  (∀ (t : Nat),
                      cond (Becoming.OneStep.Chain.world σ ρ P d g o) t
                        (List.map Sum.inr (Becoming.OneStep.Chain.family ρ P o t))) →
                    Becoming.OneStep.StepRealized cond P k r e
@Becoming.OneStep.Chain.realizedRun : ∀ {P : Nat → List Becoming.Passage} {k r : Nat → Nat} {e : Nat → Prop}
  {d g : Nat → List Nat},
  (∀ (t : Nat), (Becoming.total (d t) fun y => y) = Becoming.total (P t) Becoming.Passage.taken) →
    (∀ (t : Nat), (Becoming.total (g t) fun y => y) = Becoming.total (P t) Becoming.Passage.given) →
      (∀ (t : Nat), (Becoming.count (d t) fun y => y) = k t) →
        (∀ (t : Nat), (Becoming.count (g t) fun y => y) = r t) →
          ∀ (o : Nat → Prop),
            (∀ (t : Nat),
                0 < Becoming.total (P t) Becoming.Passage.taken ∨
                    0 < Becoming.total (P t) Becoming.Passage.given ∨ o t ↔
                  e t) →
              ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop},
                Becoming.OneStep.Chained P →
                  (∀ (t : Nat),
                      cond
                        (Becoming.OneStep.Chain.world Becoming.OneStep.Chain.identical Becoming.OneStep.Chain.identical
                          P d g o)
                        t (List.map Sum.inr (Becoming.OneStep.Chain.family Becoming.OneStep.Chain.identical P o t))) →
                    Becoming.OneStep.RunRealizedGivers cond P k r e
Becoming.OneStep.run_every_givers_iff : ∀ (P : Nat → List Becoming.Passage) (k r : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.RunRealizedGivers (fun x x_1 x_2 => True) P k r e ↔
    Becoming.OneStep.Chained P ∧
      ∀ (t : Nat), Becoming.OneStep.Every (P t) (k t) (e t) ∧ Becoming.OneStep.Givers (P t) (r t)
Becoming.OneStep.run_balance_givers_iff : ∀ (P : Nat → List Becoming.Passage) (k r : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.RunRealizedGivers (fun w t es => w.flow.BalancesOn w.web es t) P k r e ↔
    Becoming.OneStep.Chained P ∧
      ∀ (t : Nat), Becoming.OneStep.Balance (P t) (k t) (e t) ∧ Becoming.OneStep.Givers (P t) (r t)
Becoming.OneStep.run_runsDown_givers_iff : ∀ (P : Nat → List Becoming.Passage) (k r : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.RunRealizedGivers (fun w t es => w.flow.RunsDownOn w.web es t) P k r e ↔
    Becoming.OneStep.Chained P ∧
      ∀ (t : Nat), Becoming.OneStep.RunsDown (P t) (k t) (e t) ∧ Becoming.OneStep.Givers (P t) (r t) ∧ r t ≤ k t
Becoming.OneStep.run_closed_givers_iff : ∀ (P : Nat → List Becoming.Passage) (k r : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.RunRealizedGivers (fun w t es => w.flow.ClosedAt es t) P k r e ↔
