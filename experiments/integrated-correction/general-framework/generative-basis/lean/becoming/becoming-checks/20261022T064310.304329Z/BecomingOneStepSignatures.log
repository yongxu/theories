@Becoming.steps_succ_map : ∀ {α : Type} (g : Nat → α) (T n : Nat),
  List.map g (Becoming.steps (T + 1) n) = List.map (fun i => g (i + 1)) (Becoming.steps T n)
@Becoming.sign_eq_one : ∀ {n : Nat}, 0 < n → Becoming.sign n = 1
@Becoming.sign_total_le : ∀ {α : Type} (q : α → Nat) (as : List α),
  Becoming.sign (Becoming.total as q) ≤ Becoming.total as fun a => Becoming.sign (q a)
@Becoming.pos_of_sign_le : ∀ {n k : Nat}, Becoming.sign n ≤ k → 0 < n → 0 < k
@Becoming.Passage.ext_of : ∀ {p q : Becoming.Passage},
  p.before = q.before → p.after = q.after → p.taken = q.taken → p.given = q.given → p = q
@Becoming.Passage.Balanced.given_pos : ∀ {p : Becoming.Passage}, p.Balanced → p.before < p.after → 0 < p.given
@Becoming.Passage.Balanced.taken_pos : ∀ {p : Becoming.Passage}, p.Balanced → p.after < p.before → 0 < p.taken
@Becoming.Passage.balanced_total : ∀ {P : List Becoming.Passage},
  (∀ (p : Becoming.Passage), p ∈ P → p.Balanced) →
    Becoming.total P Becoming.Passage.after + Becoming.total P Becoming.Passage.taken =
      Becoming.total P Becoming.Passage.before + Becoming.total P Becoming.Passage.given
@Becoming.Flow.sign_uptake_le_takers : ∀ {F C : Type} {L : Becoming.Flow F C} (cs : List C) (t : Nat),
  Becoming.sign (L.uptake cs t) ≤ L.takers cs t
@Becoming.Flow.exchangesAt_of_uptake : ∀ {F C : Type} {L : Becoming.Flow F C} {cs : List C} {t : Nat},
  0 < L.uptake cs t → L.ExchangesAt t
@Becoming.Flow.exchangesAt_of_replenishment : ∀ {F C : Type} {L : Becoming.Flow F C} {cs : List C} {t : Nat},
  0 < L.replenishment cs t → L.ExchangesAt t
@Becoming.Flow.BalancesOn.taken_le : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {cs : List C}
  {t : Nat} {c : C}, L.BalancesOn W cs t → c ∈ cs → L.taken t c ≤ W.level t c + L.given t c
@Becoming.Flow.ExchangesAt.closed : ∀ {F C : Type} {L : Becoming.Flow F C} {es : List C} {t : Nat},
  L.ClosedAt es t → L.ExchangesAt t → 0 < L.uptake es t ∨ 0 < L.replenishment es t
@Becoming.Flow.RunsDownOn.taken_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {es : List C}
  {t : Nat}, L.RunsDownOn W es t → ((∃ c, c ∈ es ∧ 0 < L.taken t c) ↔ W.stock es (t + 1) < W.stock es t)
@Becoming.Flow.Realizes.total_eq : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat} {es : List C}
  {P : List Becoming.Passage} {k : Nat} {e : Prop},
  L.Realizes W t es P k e →
    ∀ (q : Becoming.Passage → Nat), Becoming.total P q = Becoming.total es fun c => q (L.passage W t c)
@Becoming.Flow.Realizes.uptake : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat} {es : List C}
  {P : List Becoming.Passage} {k : Nat} {e : Prop},
  L.Realizes W t es P k e → Becoming.total P Becoming.Passage.taken = L.uptake es t
@Becoming.Flow.Realizes.replenishment : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {es : List C} {P : List Becoming.Passage} {k : Nat} {e : Prop},
  L.Realizes W t es P k e → Becoming.total P Becoming.Passage.given = L.replenishment es t
@Becoming.Flow.Realizes.stock_before : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {es : List C} {P : List Becoming.Passage} {k : Nat} {e : Prop},
  L.Realizes W t es P k e → Becoming.total P Becoming.Passage.before = W.stock es t
@Becoming.Flow.Realizes.stock_after : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {es : List C} {P : List Becoming.Passage} {k : Nat} {e : Prop},
  L.Realizes W t es P k e → Becoming.total P Becoming.Passage.after = W.stock es (t + 1)
@Becoming.Flow.Realizes.member : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat} {es : List C}
  {P : List Becoming.Passage} {k : Nat} {e : Prop},
  L.Realizes W t es P k e → ∀ {p : Becoming.Passage}, p ∈ P → ∃ c, c ∈ es ∧ L.passage W t c = p
@Becoming.OneStep.fall_iff_given : ∀ {P : List Becoming.Passage} {k : Nat},
  (∀ (p : Becoming.Passage), p ∈ P → p.Balanced) →
    (Becoming.total P Becoming.Passage.after + k ≤ Becoming.total P Becoming.Passage.before ↔
      Becoming.total P Becoming.Passage.given + k ≤ Becoming.total P Becoming.Passage.taken)
@Becoming.Flow.Realizes.every : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat} {es : List C}
  {P : List Becoming.Passage} {k : Nat} {e : Prop}, L.Realizes W t es P k e → Becoming.OneStep.Every P k e
@Becoming.Flow.Realizes.balance : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat} {es : List C}
  {P : List Becoming.Passage} {k : Nat} {e : Prop},
  L.Realizes W t es P k e → L.BalancesOn W es t → Becoming.OneStep.Balance P k e
@Becoming.Flow.Realizes.runsDown : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat} {es : List C}
  {P : List Becoming.Passage} {k : Nat} {e : Prop},
  L.Realizes W t es P k e → L.RunsDownOn W es t → Becoming.OneStep.RunsDown P k e
@Becoming.Flow.Realizes.closed : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat} {es : List C}
  {P : List Becoming.Passage} {k : Nat} {e : Prop},
  L.Realizes W t es P k e → L.ClosedAt es t → Becoming.OneStep.Closed P k e
@Becoming.Flow.Realizes.runsDownClosed : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {es : List C} {P : List Becoming.Passage} {k : Nat} {e : Prop},
  L.Realizes W t es P k e → L.RunsDownOn W es t → L.ClosedAt es t → Becoming.OneStep.RunsDownClosed P k e
@Becoming.Flow.roles_passage : ∀ {F C : Type} (L : Becoming.Flow F C) (W : Becoming.Web F C) (t : Nat) (c : C),
  L.roles.passage W.roles t (Sum.inr c) = L.passage W t c
@Becoming.Flow.roles_exchangesAt : ∀ {F C : Type} {L : Becoming.Flow F C} {t : Nat},
  L.roles.ExchangesAt t ↔ L.ExchangesAt t
@Becoming.Flow.Realizes.roles : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat} {es : List C}
  {P : List Becoming.Passage} {k : Nat} {e : Prop},
  L.Realizes W t es P k e → L.roles.Realizes W.roles t (List.map Sum.inr es) P k e
@Becoming.Flow.BalancesOn.roles : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat} {es : List C},
  L.BalancesOn W es t → L.roles.BalancesOn W.roles (List.map Sum.inr es) t
@Becoming.Flow.DissipatesOn.roles : ∀ {F C : Type} {L : Becoming.Flow F C} {t : Nat} {es : List C},
  L.DissipatesOn es t → L.roles.DissipatesOn (List.map Sum.inr es) t
@Becoming.Flow.RunsDownOn.roles : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat} {es : List C},
  L.RunsDownOn W es t → L.roles.RunsDownOn W.roles (List.map Sum.inr es) t
@Becoming.Flow.ClosedAt.roles : ∀ {F C : Type} {L : Becoming.Flow F C} {t : Nat} {es : List C},
  L.ClosedAt es t → L.roles.ClosedAt (List.map Sum.inr es) t
@Becoming.OneStep.Chained.lengths : ∀ {P : Nat → List Becoming.Passage},
  Becoming.OneStep.Chained P → ∀ (t : Nat), (P t).length = (P 0).length
Becoming.OneStep.Witness.pick_steps : ∀ (P : List Becoming.Passage),
  List.map (Becoming.OneStep.Witness.pick P) (Becoming.steps 0 P.length) = P
Becoming.OneStep.Witness.total_pick : ∀ (P : List Becoming.Passage) (q : Becoming.Passage → Nat),
  (Becoming.total (Becoming.steps 0 P.length) fun i => q (Becoming.OneStep.Witness.pick P i)) = Becoming.total P q
@Becoming.OneStep.Witness.pick_lt : ∀ {q : Becoming.Passage → Nat},
  q Becoming.Passage.idle = 0 →
    ∀ (P : List Becoming.Passage) (i : Nat), 0 < q (Becoming.OneStep.Witness.pick P i) → i < P.length
Becoming.OneStep.Witness.pick_mem : ∀ (P : List Becoming.Passage) (i : Nat),
  i < P.length → Becoming.OneStep.Witness.pick P i ∈ P
Becoming.OneStep.Witness.pick_beyond : ∀ (P : List Becoming.Passage) (i : Nat),
  P.length ≤ i → Becoming.OneStep.Witness.pick P i = Becoming.Passage.idle
@Becoming.OneStep.Witness.pick_map : ∀ {f g : Becoming.Passage → Nat},
  f Becoming.Passage.idle = g Becoming.Passage.idle →
    ∀ (P Q : List Becoming.Passage),
      List.map f P = List.map g Q →
        ∀ (i : Nat), f (Becoming.OneStep.Witness.pick P i) = g (Becoming.OneStep.Witness.pick Q i)
Becoming.OneStep.Witness.least_excess : ∀ (a b : Nat), Becoming.OneStep.Witness.least a b + Becoming.excess a b = a
Becoming.OneStep.Witness.excess_zero : ∀ (a : Nat), Becoming.excess a 0 = a
Becoming.OneStep.Witness.least_excess_other : ∀ (a b : Nat),
  Becoming.OneStep.Witness.least a b + Becoming.excess b a = b
@Becoming.OneStep.Witness.excess_le_of : ∀ {u x y : Nat}, u ≤ x + y → Becoming.excess u x ≤ y
Becoming.OneStep.Witness.rest_units : ∀ (P : List Becoming.Passage) (u i : Nat),
  Becoming.OneStep.Witness.rest P u i + Becoming.OneStep.Witness.units P u i = (Becoming.OneStep.Witness.pick P i).taken
Becoming.OneStep.Witness.total_rest_units : ∀ (P : List Becoming.Passage) (u : Nat),
  Becoming.total (Becoming.steps 0 P.length) (Becoming.OneStep.Witness.rest P u) +
      Becoming.total (Becoming.steps 0 P.length) (Becoming.OneStep.Witness.units P u) =
    Becoming.total P Becoming.Passage.taken
Becoming.OneStep.Witness.total_units : ∀ (P : List Becoming.Passage) (u : Nat),
  u ≤ Becoming.total P Becoming.Passage.taken →
    Becoming.total (Becoming.steps 0 P.length) (Becoming.OneStep.Witness.units P u) = u
Becoming.OneStep.Witness.unitList_length : ∀ (P : List Becoming.Passage) (u : Nat),
  u ≤ Becoming.total P Becoming.Passage.taken → (Becoming.OneStep.Witness.unitList P u).length = u
Becoming.OneStep.Witness.unitList_units : ∀ (P : List Becoming.Passage) (u : Nat) (f : Becoming.OneStep.Witness.Part),
  f ∈ Becoming.OneStep.Witness.unitList P u → ∃ i j, f = Becoming.OneStep.Witness.Part.unit i j ∧ i < P.length
Becoming.OneStep.Witness.unitTake_up_zero : ∀ (g : Becoming.OneStep.Witness.Part),
  Becoming.OneStep.Witness.unitTake g.up 0 = 0
Becoming.OneStep.Witness.unitTake_up_succ : ∀ (c : Nat) (g : Becoming.OneStep.Witness.Part),
  Becoming.OneStep.Witness.unitTake g.up (c + 1) = Becoming.OneStep.Witness.unitTake g c
Becoming.OneStep.Witness.total_unitTake : ∀ (P : List Becoming.Passage) (u c : Nat),
  (Becoming.total (Becoming.OneStep.Witness.unitList P u) fun f => Becoming.OneStep.Witness.unitTake f c) =
    Becoming.OneStep.Witness.units P u c
Becoming.OneStep.Witness.hit_self : ∀ (i : Nat), Becoming.OneStep.Witness.hit i i = 1
Becoming.OneStep.Witness.hit_pos : ∀ (s t : Nat), 0 < Becoming.OneStep.Witness.hit s t → s = t
Becoming.OneStep.Witness.unit_injective : ∀ (i j j' : Nat),
  Becoming.OneStep.Witness.Part.unit i j = Becoming.OneStep.Witness.Part.unit i j' → j = j'
@Becoming.OneStep.Witness.up_unit_injective : ∀ {i j i' j' : Nat},
  Becoming.OneStep.Witness.Part.unit (i + 1) j = Becoming.OneStep.Witness.Part.unit (i' + 1) j' →
    Becoming.OneStep.Witness.Part.unit i j = Becoming.OneStep.Witness.Part.unit i' j'
Becoming.OneStep.Witness.distinct_unitList : ∀ (P : List Becoming.Passage) (u : Nat),
  Becoming.Distinct (Becoming.OneStep.Witness.unitList P u)
Becoming.OneStep.Witness.distinct_present : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop)
  (t : Nat), Becoming.Distinct ((Becoming.OneStep.Witness.flow P u o).present t)
@Becoming.OneStep.Witness.member_injective : ∀ {o : Nat → Prop} (i j : Nat),
  Becoming.OneStep.Witness.Place.member i = Becoming.OneStep.Witness.Place.member j → i = j
Becoming.OneStep.Witness.distinct_family : ∀ (m : Nat) (o : Nat → Prop),
  Becoming.Distinct (Becoming.OneStep.Witness.family m o)
Becoming.OneStep.Witness.total_family : ∀ (m : Nat) {o : Nat → Prop} (q : Becoming.OneStep.Witness.Place o → Nat),
  Becoming.total (Becoming.OneStep.Witness.family m o) q =
    Becoming.total (Becoming.steps 0 m) fun i => q (Becoming.OneStep.Witness.Place.member i)
@Becoming.OneStep.Witness.member_mem : ∀ {m i : Nat} {o : Nat → Prop},
  i < m → Becoming.OneStep.Witness.Place.member i ∈ Becoming.OneStep.Witness.family m o
@Becoming.OneStep.Witness.of_mem_family : ∀ {m : Nat} {o : Nat → Prop} {c : Becoming.OneStep.Witness.Place o},
  c ∈ Becoming.OneStep.Witness.family m o → ∃ i, i < m ∧ c = Becoming.OneStep.Witness.Place.member i
@Becoming.OneStep.Witness.whole_count : ∀ {M X k : Nat},
  Becoming.sign X ≤ k → k ≤ X → M + k.pred = X → Becoming.sign M + k.pred = k
Becoming.OneStep.Witness.whole_total : ∀ (Q : List Becoming.Passage) {k : Nat},
  k ≤ Becoming.total Q Becoming.Passage.taken →
    Becoming.total (Becoming.steps 0 Q.length) (Becoming.OneStep.Witness.rest Q k.pred) + k.pred =
      Becoming.total Q Becoming.Passage.taken
@Becoming.OneStep.Witness.whole_bound : ∀ {X Y M k : Nat},
  Becoming.sign X ≤ k → Y + k ≤ X → M + k.pred = X → Y + Becoming.sign M ≤ M
Becoming.OneStep.Witness.take_units : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop) (t i : Nat),
  (Becoming.total (Becoming.OneStep.Witness.unitList (P t) (u t)) fun f =>
      (Becoming.OneStep.Witness.flow P u o).take t f (Becoming.OneStep.Witness.Place.member i)) =
    Becoming.OneStep.Witness.units (P t) (u t) i
Becoming.OneStep.Witness.give_units : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop) (t i : Nat),
  (Becoming.total (Becoming.OneStep.Witness.unitList (P t) (u t)) fun f =>
      (Becoming.OneStep.Witness.flow P u o).give t f (Becoming.OneStep.Witness.Place.member i)) =
    0
Becoming.OneStep.Witness.taken_member : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop)
  (t i : Nat),
  (Becoming.OneStep.Witness.flow P u o).taken t (Becoming.OneStep.Witness.Place.member i) =
    (Becoming.OneStep.Witness.pick (P t) i).taken
Becoming.OneStep.Witness.given_member : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop)
  (t i : Nat),
  (Becoming.OneStep.Witness.flow P u o).given t (Becoming.OneStep.Witness.Place.member i) =
    (Becoming.OneStep.Witness.pick (P t) i).given
Becoming.OneStep.Witness.level_after : ∀ (P : Nat → List Becoming.Passage) (o : Nat → Prop) (t : Nat),
  List.map Becoming.Passage.after (P t) = List.map Becoming.Passage.before (P (t + 1)) →
    ∀ (i : Nat),
      (Becoming.OneStep.Witness.web P o).level (t + 1) (Becoming.OneStep.Witness.Place.member i) =
        (Becoming.OneStep.Witness.pick (P t) i).after
Becoming.OneStep.Witness.passage_member : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop)
  (t : Nat),
  List.map Becoming.Passage.after (P t) = List.map Becoming.Passage.before (P (t + 1)) →
    ∀ (i : Nat),
      (Becoming.OneStep.Witness.flow P u o).passage (Becoming.OneStep.Witness.web P o) t
          (Becoming.OneStep.Witness.Place.member i) =
        Becoming.OneStep.Witness.pick (P t) i
Becoming.OneStep.Witness.passages : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop) (t : Nat),
  List.map Becoming.Passage.after (P t) = List.map Becoming.Passage.before (P (t + 1)) →
    List.map ((Becoming.OneStep.Witness.flow P u o).passage (Becoming.OneStep.Witness.web P o) t)
        (Becoming.OneStep.Witness.family (P t).length o) =
      P t
Becoming.OneStep.Witness.uptake_family : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop) (t : Nat),
  (Becoming.OneStep.Witness.flow P u o).uptake (Becoming.OneStep.Witness.family (P t).length o) t =
    Becoming.total (P t) Becoming.Passage.taken
Becoming.OneStep.Witness.replenishment_family : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop)
  (t : Nat),
  (Becoming.OneStep.Witness.flow P u o).replenishment (Becoming.OneStep.Witness.family (P t).length o) t =
    Becoming.total (P t) Becoming.Passage.given
Becoming.OneStep.Witness.takers_eq : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop) (t : Nat),
  u t ≤ Becoming.total (P t) Becoming.Passage.taken →
    (Becoming.OneStep.Witness.flow P u o).takers (Becoming.OneStep.Witness.family (P t).length o) t =
      Becoming.sign (Becoming.total (Becoming.steps 0 (P t).length) (Becoming.OneStep.Witness.rest (P t) (u t))) + u t
Becoming.OneStep.Witness.takers_count : ∀ (P : Nat → List Becoming.Passage) (o : Nat → Prop) (t : Nat) {k : Nat → Nat},
  Becoming.sign (Becoming.total (P t) Becoming.Passage.taken) ≤ k t →
    k t ≤ Becoming.total (P t) Becoming.Passage.taken →
      (Becoming.OneStep.Witness.flow P (fun s => (k s).pred) o).takers (Becoming.OneStep.Witness.family (P t).length o)
          t =
        k t
Becoming.OneStep.Witness.outer_mem : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop) (t : Nat),
  Becoming.OneStep.Witness.Part.outer ∈ (Becoming.OneStep.Witness.flow P u o).present t
Becoming.OneStep.Witness.beyond_moves : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop) (t : Nat)
  (f : Becoming.OneStep.Witness.Part) {s : Nat} {h : o s},
  0 < (Becoming.OneStep.Witness.flow P u o).take t f (Becoming.OneStep.Witness.Place.beyond s h) ∨
      0 < (Becoming.OneStep.Witness.flow P u o).give t f (Becoming.OneStep.Witness.Place.beyond s h) →
    s = t
Becoming.OneStep.Witness.exchangesAt_iff : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop)
  (t : Nat),
  (Becoming.OneStep.Witness.flow P u o).ExchangesAt t ↔
    0 < Becoming.total (P t) Becoming.Passage.taken ∨ 0 < Becoming.total (P t) Becoming.Passage.given ∨ o t
Becoming.OneStep.Witness.balancesOn : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop) (t : Nat),
  List.map Becoming.Passage.after (P t) = List.map Becoming.Passage.before (P (t + 1)) →
    (∀ (p : Becoming.Passage), p ∈ P t → p.Balanced) →
      (Becoming.OneStep.Witness.flow P u o).BalancesOn (Becoming.OneStep.Witness.web P o)
        (Becoming.OneStep.Witness.family (P t).length o) t
Becoming.OneStep.Witness.stands_before : ∀ (P : Nat → List Becoming.Passage) (o : Nat → Prop) (t : Nat)
  {c : Becoming.OneStep.Witness.Place o},
  0 < (Becoming.OneStep.Witness.web P o).level t c → c ∈ Becoming.OneStep.Witness.family (P t).length o
Becoming.OneStep.Witness.stands_after : ∀ (P : Nat → List Becoming.Passage) (o : Nat → Prop) (t : Nat),
  List.map Becoming.Passage.after (P t) = List.map Becoming.Passage.before (P (t + 1)) →
    ∀ {c : Becoming.OneStep.Witness.Place o},
      0 < (Becoming.OneStep.Witness.web P o).level (t + 1) c → c ∈ Becoming.OneStep.Witness.family (P t).length o
Becoming.OneStep.Witness.dissipatesOn : ∀ (P : Nat → List Becoming.Passage) (o : Nat → Prop) (t : Nat) {k : Nat → Nat},
  Becoming.sign (Becoming.total (P t) Becoming.Passage.taken) ≤ k t →
    Becoming.total (P t) Becoming.Passage.given + k t ≤ Becoming.total (P t) Becoming.Passage.taken →
      (Becoming.OneStep.Witness.flow P (fun s => (k s).pred) o).DissipatesOn
        (Becoming.OneStep.Witness.family (P t).length o) t
Becoming.OneStep.Witness.runsDownOn : ∀ (P : Nat → List Becoming.Passage) (o : Nat → Prop) (t : Nat) {k : Nat → Nat},
  List.map Becoming.Passage.after (P t) = List.map Becoming.Passage.before (P (t + 1)) →
    (∀ (p : Becoming.Passage), p ∈ P t → p.Balanced) →
      Becoming.sign (Becoming.total (P t) Becoming.Passage.taken) ≤ k t →
        Becoming.total (P t) Becoming.Passage.given + k t ≤ Becoming.total (P t) Becoming.Passage.taken →
          (Becoming.OneStep.Witness.flow P (fun s => (k s).pred) o).RunsDownOn (Becoming.OneStep.Witness.web P o)
            (Becoming.OneStep.Witness.family (P t).length o) t
Becoming.OneStep.Witness.closedAt : ∀ (P : Nat → List Becoming.Passage) (u : Nat → Nat) (o : Nat → Prop) (t : Nat),
  ¬o t → (Becoming.OneStep.Witness.flow P u o).ClosedAt (Becoming.OneStep.Witness.family (P t).length o) t
@Becoming.OneStep.Witness.shows : ∀ {P : Nat → List Becoming.Passage} {k : Nat → Nat} (t : Nat),
  List.map Becoming.Passage.after (P t) = List.map Becoming.Passage.before (P (t + 1)) →
    Becoming.sign (Becoming.total (P t) Becoming.Passage.taken) ≤ k t →
      k t ≤ Becoming.total (P t) Becoming.Passage.taken →
        ∀ (o : Nat → Prop),
          Becoming.Distinct ((Becoming.OneStep.Witness.world P k o).flow.present t) ∧
            (Becoming.OneStep.Witness.world P k o).flow.Realizes (Becoming.OneStep.Witness.world P k o).web t
              (List.map Sum.inr (Becoming.OneStep.Witness.family (P t).length o)) (P t) (k t)
              (0 < Becoming.total (P t) Becoming.Passage.taken ∨ 0 < Becoming.total (P t) Becoming.Passage.given ∨ o t)
Becoming.OneStep.Witness.once_chain : ∀ (P : List Becoming.Passage),
  List.map Becoming.Passage.after (Becoming.OneStep.Witness.once P 0) =
    List.map Becoming.Passage.before (Becoming.OneStep.Witness.once P (0 + 1))
@Becoming.OneStep.exchange_open : ∀ {X Y : Nat} {e : Prop}, (0 < X ∨ 0 < Y → e) → (0 < X ∨ 0 < Y ∨ e ↔ e)
@Becoming.OneStep.exchange_closed : ∀ {X Y : Nat} {e : Prop}, (e ↔ 0 < X ∨ 0 < Y) → (0 < X ∨ 0 < Y ∨ False ↔ e)
@Becoming.OneStep.Witness.realizedOnce : ∀ {P : List Becoming.Passage} {k : Nat} {e : Prop},
  Becoming.OneStep.Every P k e →
    ∀ (o : Prop),
      (0 < Becoming.total P Becoming.Passage.taken ∨ 0 < Becoming.total P Becoming.Passage.given ∨ o ↔ e) →
        ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop},
          cond (Becoming.OneStep.Witness.world (Becoming.OneStep.Witness.once P) (fun x => k) fun x => o) 0
              (List.map Sum.inr (Becoming.OneStep.Witness.family P.length fun x => o)) →
            Becoming.OneStep.Realized cond P k e
Becoming.OneStep.every_iff : ∀ (P : List Becoming.Passage) (k : Nat) (e : Prop),
  Becoming.OneStep.Realized (fun x x_1 x_2 => True) P k e ↔ Becoming.OneStep.Every P k e
Becoming.OneStep.balance_iff : ∀ (P : List Becoming.Passage) (k : Nat) (e : Prop),
  Becoming.OneStep.Realized (fun w t es => w.flow.BalancesOn w.web es t) P k e ↔ Becoming.OneStep.Balance P k e
Becoming.OneStep.runsDown_iff : ∀ (P : List Becoming.Passage) (k : Nat) (e : Prop),
  Becoming.OneStep.Realized (fun w t es => w.flow.RunsDownOn w.web es t) P k e ↔ Becoming.OneStep.RunsDown P k e
Becoming.OneStep.closed_iff : ∀ (P : List Becoming.Passage) (k : Nat) (e : Prop),
  Becoming.OneStep.Realized (fun w t es => w.flow.ClosedAt es t) P k e ↔ Becoming.OneStep.Closed P k e
Becoming.OneStep.runsDownClosed_iff : ∀ (P : List Becoming.Passage) (k : Nat) (e : Prop),
  Becoming.OneStep.Realized (fun w t es => w.flow.RunsDownOn w.web es t ∧ w.flow.ClosedAt es t) P k e ↔
    Becoming.OneStep.RunsDownClosed P k e
Becoming.OneStep.runsDown_passages_iff : ∀ (P : List Becoming.Passage) (e : Prop),
  (∃ k, Becoming.OneStep.Realized (fun w t es => w.flow.RunsDownOn w.web es t) P k e) ↔
    (∀ (p : Becoming.Passage), p ∈ P → p.Balanced) ∧
      Becoming.total P Becoming.Passage.after + Becoming.sign (Becoming.total P Becoming.Passage.taken) ≤
          Becoming.total P Becoming.Passage.before ∧
        (0 < Becoming.total P Becoming.Passage.taken ∨ 0 < Becoming.total P Becoming.Passage.given → e)
@Becoming.OneStep.laws : ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop}
  {Law : List Becoming.Passage → Nat → Prop → Prop},
  (∀ (P : List Becoming.Passage) (k : Nat) (e : Prop), Becoming.OneStep.Realized cond P k e ↔ Law P k e) →
    ∀ {Q : List Becoming.Passage → Nat → Prop → Prop},
      Becoming.OneStep.Respects Q →
        ((∀ (w : Becoming.World) (t : Nat) (es : List w.Relatum),
            cond w t es →
              Becoming.Distinct (w.flow.present t) →
                Q (List.map (w.flow.passage w.web t) es) (w.flow.takers es t) (w.flow.ExchangesAt t)) ↔
          ∀ (P : List Becoming.Passage) (k : Nat) (e : Prop), Law P k e → Q P k e)
@Becoming.OneStep.RunRealized.chained : ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop}
  {P : Nat → List Becoming.Passage} {k : Nat → Nat} {e : Nat → Prop},
  Becoming.OneStep.RunRealized cond P k e → Becoming.OneStep.Chained P
@Becoming.OneStep.RunRealized.exchange : ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop}
  {P : Nat → List Becoming.Passage} {k : Nat → Nat} {e e' : Nat → Prop},
  (∀ (t : Nat), e t ↔ e' t) → Becoming.OneStep.RunRealized cond P k e → Becoming.OneStep.RunRealized cond P k e'
@Becoming.OneStep.Witness.showsRun : ∀ {P : Nat → List Becoming.Passage} {k : Nat → Nat},
  Becoming.OneStep.Chained P →
    (∀ (t : Nat),
        Becoming.sign (Becoming.total (P t) Becoming.Passage.taken) ≤ k t ∧
          k t ≤ Becoming.total (P t) Becoming.Passage.taken) →
      ∀ (o : Nat → Prop) {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop},
        (∀ (t : Nat),
            cond (Becoming.OneStep.Witness.world P k o) t
              (List.map Sum.inr (Becoming.OneStep.Witness.family (P t).length o))) →
          Becoming.OneStep.RunRealized cond P k fun t =>
            0 < Becoming.total (P t) Becoming.Passage.taken ∨ 0 < Becoming.total (P t) Becoming.Passage.given ∨ o t
Becoming.OneStep.run_every_iff : ∀ (P : Nat → List Becoming.Passage) (k : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.RunRealized (fun x x_1 x_2 => True) P k e ↔
    Becoming.OneStep.Chained P ∧ ∀ (t : Nat), Becoming.OneStep.Every (P t) (k t) (e t)
Becoming.OneStep.run_balance_iff : ∀ (P : Nat → List Becoming.Passage) (k : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.RunRealized (fun w t es => w.flow.BalancesOn w.web es t) P k e ↔
    Becoming.OneStep.Chained P ∧ ∀ (t : Nat), Becoming.OneStep.Balance (P t) (k t) (e t)
Becoming.OneStep.run_runsDown_iff : ∀ (P : Nat → List Becoming.Passage) (k : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.RunRealized (fun w t es => w.flow.RunsDownOn w.web es t) P k e ↔
    Becoming.OneStep.Chained P ∧ ∀ (t : Nat), Becoming.OneStep.RunsDown (P t) (k t) (e t)
Becoming.OneStep.run_closed_iff : ∀ (P : Nat → List Becoming.Passage) (k : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.RunRealized (fun w t es => w.flow.ClosedAt es t) P k e ↔
    Becoming.OneStep.Chained P ∧ ∀ (t : Nat), Becoming.OneStep.Closed (P t) (k t) (e t)
Becoming.OneStep.run_runsDownClosed_iff : ∀ (P : Nat → List Becoming.Passage) (k : Nat → Nat) (e : Nat → Prop),
  Becoming.OneStep.RunRealized (fun w t es => w.flow.RunsDownOn w.web es t ∧ w.flow.ClosedAt es t) P k e ↔
    Becoming.OneStep.Chained P ∧ ∀ (t : Nat), Becoming.OneStep.RunsDownClosed (P t) (k t) (e t)
@Becoming.OneStep.run_laws : ∀ {cond : (w : Becoming.World) → Nat → List w.Relatum → Prop}
  {Law : List Becoming.Passage → Nat → Prop → Prop},
  (∀ (P : Nat → List Becoming.Passage) (k : Nat → Nat) (e : Nat → Prop),
      Becoming.OneStep.RunRealized cond P k e ↔ Becoming.OneStep.Chained P ∧ ∀ (t : Nat), Law (P t) (k t) (e t)) →
    ∀ {Q : (Nat → List Becoming.Passage) → (Nat → Nat) → (Nat → Prop) → Prop},
      Becoming.OneStep.RunRespects Q →
        ((∀ (w : Becoming.World) (es : List w.Relatum),
            (∀ (t : Nat), cond w t es ∧ Becoming.Distinct (w.flow.present t)) →
              Q (fun t => List.map (w.flow.passage w.web t) es) (fun t => w.flow.takers es t) fun t =>
                w.flow.ExchangesAt t) ↔
          ∀ (P : Nat → List Becoming.Passage) (k : Nat → Nat) (e : Nat → Prop),
            Becoming.OneStep.Chained P → (∀ (t : Nat), Law (P t) (k t) (e t)) → Q P k e)
Becoming.OneStep.runsDownClosed_iff_stated : ∀ (P : List Becoming.Passage) (k : Nat) (e : Prop),
  Becoming.OneStep.RunsDownClosed P k e ↔
    Becoming.OneStep.Stated P k e ∧ Becoming.sign (Becoming.total P Becoming.Passage.taken) ≤ k
Becoming.OneStep.stated_not_realized : Becoming.OneStep.Stated [{ before := 1, after := 1, taken := 1, given := 1 }] 0
    False ∧
  ¬Becoming.OneStep.Realized (fun x x_1 x_2 => True) [{ before := 1, after := 1, taken := 1, given := 1 }] 0 False
Becoming.OneStep.standing_iff : ∀ (a x y : Nat) (comes ceases : Prop),
  (∃ w t c,
      w.flow.BalancesOn w.web [c] t ∧
        w.web.level t c = a ∧
          w.flow.taken t c = x ∧
            w.flow.given t c = y ∧ (w.web.ComesToStand t c ↔ comes) ∧ (w.web.CeasesToStand t c ↔ ceases)) ↔
    x ≤ a + y ∧ (comes ↔ a = 0 ∧ x < y) ∧ (ceases ↔ 0 < a ∧ x = a + y)
Becoming.OneStep.standing_bound_needed : ((False ↔ 0 = 0 ∧ 1 < 0) ∧ (False ↔ 0 < 0 ∧ 1 = 0 + 0)) ∧
  ¬∃ w t c,
      w.flow.BalancesOn w.web [c] t ∧
        w.web.level t c = 0 ∧
          w.flow.taken t c = 1 ∧
            w.flow.given t c = 0 ∧ (w.web.ComesToStand t c ↔ False) ∧ (w.web.CeasesToStand t c ↔ False)
Becoming.total_steps_shift : ∀ (q : Nat → Nat) (c T n : Nat),
  Becoming.total (Becoming.steps (T + c) n) q = Becoming.total (Becoming.steps T n) fun m => q (m + c)
@Becoming.OneStep.Chain.none_ne_some : ∀ {i : Nat}, none = some i → False
@Becoming.OneStep.Chain.some_inj : ∀ {a b : Nat}, some a = some b → a = b
Becoming.OneStep.Chain.hit_cases : ∀ (a b : Nat),
  Becoming.OneStep.Witness.hit a b = 0 ∨ Becoming.OneStep.Witness.hit a b = 1
@Becoming.OneStep.Chain.hit_lt : ∀ {a b : Nat}, a < b → Becoming.OneStep.Witness.hit a b = 0
@Becoming.OneStep.Chain.hit_of_eq : ∀ {a b : Nat}, a = b → Becoming.OneStep.Witness.hit a b = 1
Becoming.OneStep.Chain.total_hit : ∀ (L j : Nat),
  j < L → (Becoming.total (Becoming.steps 0 L) fun i => Becoming.OneStep.Witness.hit j i) = 1
Becoming.OneStep.Chain.least_le_left : ∀ (a b : Nat), Becoming.OneStep.Witness.least a b ≤ a
Becoming.OneStep.Chain.least_le_right : ∀ (a b : Nat), Becoming.OneStep.Witness.least a b ≤ b
@Becoming.OneStep.Chain.least_pos : ∀ {a b : Nat}, 0 < a → 0 < b → 0 < Becoming.OneStep.Witness.least a b
Becoming.OneStep.Chain.least_cases : ∀ (a b : Nat),
  Becoming.OneStep.Witness.least a b = a ∧ a ≤ b ∨ Becoming.OneStep.Witness.least a b = b ∧ b ≤ a
@Becoming.OneStep.Chain.add_excess : ∀ {a b : Nat}, b ≤ a → b + Becoming.excess a b = a
@Becoming.OneStep.Chain.sign_le_sign : ∀ {a b : Nat}, (0 < a → 0 < b) → Becoming.sign a ≤ Becoming.sign b
Becoming.OneStep.Chain.entry_beyond : ∀ (l : List Nat) (i : Nat), l.length ≤ i → Becoming.OneStep.Chain.entry l i = 0
@Becoming.OneStep.Chain.entry_steps : ∀ {q : Nat → Nat},
  q 0 = 0 →
    ∀ (l : List Nat) (N : Nat),
      l.length ≤ N →
        (Becoming.total (Becoming.steps 0 N) fun a => q (Becoming.OneStep.Chain.entry l a)) = Becoming.total l q
@Becoming.OneStep.Chain.entry_map : ∀ {q : Becoming.Passage → Nat},
  q Becoming.Passage.idle = 0 →
    ∀ (P : List Becoming.Passage) (j : Nat),
      Becoming.OneStep.Chain.entry (List.map q P) j = q (Becoming.OneStep.Witness.pick P j)
Becoming.OneStep.Chain.entry_steps_map : ∀ (f : Nat → Nat) (k a : Nat),
  a < k → Becoming.OneStep.Chain.entry (List.map f (Becoming.steps 0 k)) a = f a
Becoming.OneStep.Chain.within_lt : ∀ (rest : Nat → Nat) {b m : Nat}, m < b → Becoming.OneStep.Chain.within rest b m = 0
Becoming.OneStep.Chain.within_add : ∀ (rest : Nat → Nat) (b m : Nat),
  Becoming.OneStep.Chain.within rest b (m + b) = rest m + 1
@Becoming.OneStep.Chain.within_bound : ∀ {rest : Nat → Nat} {S L : Nat},
  (∀ (m : Nat), m < S → rest m < L) → ∀ (b m : Nat), m < b + S → Becoming.OneStep.Chain.within rest b m < L + 1
Becoming.OneStep.Chain.slot_lt : ∀ (bs : List Nat) (m : Nat),
  (m < Becoming.total bs fun x => x) → Becoming.OneStep.Chain.slot bs m < bs.length
Becoming.OneStep.Chain.blocks : ∀ (bs : List Nat) (i : Nat),
  (Becoming.total (Becoming.steps 0 (Becoming.total bs fun x => x)) fun m =>
      Becoming.OneStep.Witness.hit (Becoming.OneStep.Chain.slot bs m) i) =
    Becoming.OneStep.Chain.entry bs i
@Becoming.OneStep.Chain.cell_rows : ∀ {d s : List Nat},
  ((Becoming.total d fun x => x) = Becoming.total s fun x => x) →
    ∀ {L : Nat},
      s.length ≤ L →
        ∀ (a : Nat),
          Becoming.total (Becoming.steps 0 L) (Becoming.OneStep.Chain.cell d s a) = Becoming.OneStep.Chain.entry d a
@Becoming.OneStep.Chain.cell_columns : ∀ {d s : List Nat},
  ((Becoming.total d fun x => x) = Becoming.total s fun x => x) →
    ∀ {N : Nat},
      d.length ≤ N →
        ∀ (i : Nat),
          (Becoming.total (Becoming.steps 0 N) fun a => Becoming.OneStep.Chain.cell d s a i) =
            Becoming.OneStep.Chain.entry s i
Becoming.OneStep.Chain.cell_beyond : ∀ (d : List Nat) {s : List Nat} {i : Nat},
  s.length ≤ i → ∀ (a : Nat), Becoming.OneStep.Chain.cell d s a i = 0
Becoming.OneStep.Chain.total_entry_one : ∀ (x : Nat) {k : Nat},
  0 < k ∨ x = 0 → Becoming.total (Becoming.steps 0 k) (Becoming.OneStep.Chain.entry [x]) = x
@Becoming.OneStep.Chain.total_lift : ∀ {g : List Nat} {k x : Nat},
  g.length ≤ k →
    0 < k ∨ x = 0 →
      (Becoming.total (Becoming.OneStep.Chain.lift g k x) fun y => y) = (Becoming.total g fun y => y) + k + x
Becoming.OneStep.Chain.count_lift : ∀ (g : List Nat) (k x : Nat),
  (Becoming.count (Becoming.OneStep.Chain.lift g k x) fun y => y) = k
Becoming.OneStep.Chain.lift_length : ∀ (g : List Nat) (k x : Nat), (Becoming.OneStep.Chain.lift g k x).length = k
@Becoming.OneStep.Chain.lift_dissipates : ∀ {g : List Nat} {k : Nat},
  g.length ≤ k →
    ∀ (x a : Nat),
      Becoming.OneStep.Chain.entry g a +
          Becoming.sign (Becoming.OneStep.Chain.entry (Becoming.OneStep.Chain.lift g k x) a) ≤
        Becoming.OneStep.Chain.entry (Becoming.OneStep.Chain.lift g k x) a
Becoming.OneStep.Chain.fill_length : ∀ (cap Y r : Nat), (Becoming.OneStep.Chain.fill cap Y r).length = r
Becoming.OneStep.Chain.fill_spec : ∀ (cap r Y : Nat),
  r ≤ Y →
    Y ≤ cap * r →
      (Becoming.total (Becoming.OneStep.Chain.fill cap Y r) fun y => y) = Y ∧
        (Becoming.count (Becoming.OneStep.Chain.fill cap Y r) fun y => y) = r ∧
          ∀ (a : Nat), Becoming.OneStep.Chain.entry (Becoming.OneStep.Chain.fill cap Y r) a ≤ cap
Becoming.OneStep.Chain.fill_entry_le : ∀ (cap : Nat) {r Y : Nat},
  r ≤ Y → Y ≤ cap * r → ∀ (a : Nat), Becoming.OneStep.Chain.entry (Becoming.OneStep.Chain.fill cap Y r) a ≤ cap
@Becoming.Flow.sign_replenishment_le_renewers : ∀ {F C : Type} {L : Becoming.Flow F C} (cs : List C) (t : Nat),
  Becoming.sign (L.replenishment cs t) ≤ L.renewers cs t
@Becoming.Flow.renewers_le_replenishment : ∀ {F C : Type} {L : Becoming.Flow F C} (cs : List C) (t : Nat),
  L.renewers cs t ≤ L.replenishment cs t
@Becoming.Flow.DissipatesOn.renewers_le_takers : ∀ {F C : Type} {L : Becoming.Flow F C} {cs : List C} {t : Nat},
  L.DissipatesOn cs t → L.renewers cs t ≤ L.takers cs t
@Becoming.Flow.capacity_iff_at : ∀ {F C : Type} {L : Becoming.Flow F C} {cs : List C} {g : Nat},
  L.Capacity cs g ↔ ∀ (t : Nat), L.CapacityAt cs t g
@Becoming.Flow.acting_iff_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Acting W ↔ ∀ (t : Nat), L.ActingAt W t
@Becoming.Flow.taking_iff_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Taking W ↔ ∀ (t : Nat), L.TakingAt W t
@Becoming.Flow.CapacityAt.replenishment_le : ∀ {F C : Type} {L : Becoming.Flow F C} {cs : List C} {t g : Nat},
  L.CapacityAt cs t g → L.replenishment cs t ≤ g * L.renewers cs t
@Becoming.Flow.RealizesGivers.givers : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {es : List C} {P : List Becoming.Passage} {k r : Nat} {e : Prop},
  L.RealizesGivers W t es P k r e → Becoming.OneStep.Givers P r
@Becoming.Flow.RealizesGivers.takers : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {es : List C} {P : List Becoming.Passage} {k r : Nat} {e : Prop},
  L.RealizesGivers W t es P k r e → L.DissipatesOn es t → r ≤ k
@Becoming.Flow.RealizesGivers.capacity : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {es : List C} {P : List Becoming.Passage} {k r : Nat} {e : Prop},
  L.RealizesGivers W t es P k r e → ∀ {g : Nat}, L.CapacityAt es t g → Becoming.total P Becoming.Passage.given ≤ g * r
@Becoming.Flow.RealizesGivers.exchange : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {es : List C} {P : List Becoming.Passage} {k r : Nat} {e : Prop},
  L.RealizesGivers W t es P k r e → ∀ {e' : Prop}, (e ↔ e') → L.RealizesGivers W t es P k r e'
@Becoming.Flow.RealizesGivers.roles : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat}
  {es : List C} {P : List Becoming.Passage} {k r : Nat} {e : Prop},
  L.RealizesGivers W t es P k r e → L.roles.RealizesGivers W.roles t (List.map Sum.inr es) P k r e
@Becoming.Flow.CapacityAt.roles : ∀ {F C : Type} {L : Becoming.Flow F C} {t : Nat} {es : List C} {g : Nat},
  L.CapacityAt es t g → L.roles.CapacityAt (List.map Sum.inr es) t g
@Becoming.Flow.ActingAt.roles : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat},
  L.ActingAt W t → L.roles.ActingAt W.roles t
@Becoming.Flow.TakingAt.roles : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {t : Nat},
  L.TakingAt W t → L.roles.TakingAt W.roles t
Becoming.OneStep.Chain.later_self : ∀ (b : Nat), Becoming.OneStep.Chain.later b b = some 0
Becoming.OneStep.Chain.later_add : ∀ (b n : Nat), Becoming.OneStep.Chain.later b (n + b) = some n
@Becoming.OneStep.Chain.later_lt : ∀ {b s : Nat}, s < b → Becoming.OneStep.Chain.later b s = none
Becoming.OneStep.Chain.track_add : ∀ (σ ρ : Nat → Nat → Option Nat) (b j n : Nat),
  Becoming.OneStep.Chain.track σ ρ (b, j) (n + b) = Becoming.OneStep.Chain.run σ ρ b j n
Becoming.OneStep.Chain.track_self : ∀ (σ ρ : Nat → Nat → Option Nat) (b j : Nat),
  Becoming.OneStep.Chain.track σ ρ (b, j) b = Becoming.OneStep.Chain.start ρ b j
Becoming.OneStep.Chain.track_lt : ∀ (σ ρ : Nat → Nat → Option Nat) {b j s : Nat},
  s < b → Becoming.OneStep.Chain.track σ ρ (b, j) s = none
Becoming.OneStep.Chain.tracked_from : ∀ (σ ρ : Nat → Nat → Option Nat) {x : Nat × Nat} {s i : Nat},
  Becoming.OneStep.Chain.track σ ρ x s = some i → x.fst ≤ s
Becoming.OneStep.Chain.track_succ_add : ∀ (σ ρ : Nat → Nat → Option Nat) (b j n : Nat),
  Becoming.OneStep.Chain.track σ ρ (b, j) (n + b + 1) =
    (Becoming.OneStep.Chain.track σ ρ (b, j) (n + b)).bind (σ (n + b))
Becoming.OneStep.Chain.track_succ : ∀ (σ ρ : Nat → Nat → Option Nat) {x : Nat × Nat} {s : Nat},
  x.fst ≤ s → Becoming.OneStep.Chain.track σ ρ x (s + 1) = (Becoming.OneStep.Chain.track σ ρ x s).bind (σ s)
@Becoming.OneStep.Chain.originStep_le : ∀ {prev : Nat → Nat × Nat} {t : Nat},
  (∀ (i : Nat), (prev i).fst ≤ t) →
    ∀ (j : Nat) (o : Option Nat), (Becoming.OneStep.Chain.originStep prev (t + 1) j o).fst ≤ t + 1
Becoming.OneStep.Chain.origin_le : ∀ (ρ : Nat → Nat → Option Nat) (t j : Nat),
  (Becoming.OneStep.Chain.origin ρ t j).fst ≤ t
Becoming.OneStep.Chain.track_originStep : ∀ (σ ρ : Nat → Nat → Option Nat),
  (∀ (t i j : Nat), ρ t j = some i → σ t i = some j) →
    ∀ {t j : Nat},
      (∀ (i : Nat), Becoming.OneStep.Chain.track σ ρ (Becoming.OneStep.Chain.origin ρ t i) t = some i) →
        ∀ (o : Option Nat),
          ρ t j = o →
            Becoming.OneStep.Chain.track σ ρ
                (Becoming.OneStep.Chain.originStep (Becoming.OneStep.Chain.origin ρ t) (t + 1) j o) (t + 1) =
              some j
Becoming.OneStep.Chain.track_origin : ∀ (σ ρ : Nat → Nat → Option Nat),
  (∀ (t i j : Nat), ρ t j = some i → σ t i = some j) →
    ∀ (t j : Nat), Becoming.OneStep.Chain.track σ ρ (Becoming.OneStep.Chain.origin ρ t j) t = some j
Becoming.OneStep.Chain.origin_born : ∀ (ρ : Nat → Nat → Option Nat) {b i0 j : Nat} (o : Option Nat),
  ρ b i0 = o → Becoming.OneStep.Chain.born i0 o = some j → Becoming.OneStep.Chain.origin ρ (b + 1) j = (b + 1, i0)
Becoming.OneStep.Chain.origin_start : ∀ (ρ : Nat → Nat → Option Nat) (b : Nat) {i0 j : Nat},
  Becoming.OneStep.Chain.start ρ b i0 = some j → Becoming.OneStep.Chain.origin ρ b j = (b, i0)
Becoming.OneStep.Chain.origin_step : ∀ (σ ρ : Nat → Nat → Option Nat),
  (∀ (t i j : Nat), σ t i = some j → ρ t j = some i) →
    ∀ {b i0 n j : Nat},
      (∀ (i : Nat),
