Becoming.OneStep.swapped_runsDown : ∀ (t : Nat),
  Becoming.OneStep.RunsDown (Becoming.OneStep.swapped t) 0 False ∧
    Becoming.OneStep.Givers (Becoming.OneStep.swapped t) 0 ∧ 0 ≤ 0
