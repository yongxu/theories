  Becoming.Commutes J ts →
    Becoming.Commutes (fun a b => J (Becoming.origin ts a) (Becoming.origin ts b)) us → Becoming.Commutes J (ts ++ us)
@Becoming.Commutes.keeps : ∀ {J : Nat → Nat → Prop} {ts : List Nat},
  Becoming.Commutes J ts → ∀ {a b : Nat}, a < b → J a b → Becoming.place ts a < Becoming.place ts b
@Becoming.KeepsOrder.first_free : ∀ {J : Nat → Nat → Prop} {S m : Nat} {π σ : Nat → Nat},
  Becoming.Reindexes S (m + 1) π σ → Becoming.KeepsOrder J S (m + 1) π → ∀ {p : Nat}, S ≤ p → p < σ S → ¬J p (σ S)
@Becoming.lowering_commutes : ∀ {a d : Nat} {J : Nat → Nat → Prop},
  (∀ (p : Nat), a ≤ p → p < a + d → ¬J p (a + d)) → Becoming.Commutes J (Becoming.lowering a d)
@Becoming.lowered_keepsOrder : ∀ {J : Nat → Nat → Prop} {S m d : Nat} {π : Nat → Nat},
  (∀ (a b : Nat), J a b → J b a) →
    Becoming.Commutes J (Becoming.lowering S d) →
      Becoming.KeepsOrder J S (m + 1) π →
        d ≤ m →
          Becoming.KeepsOrder
            (fun a b => J (Becoming.origin (Becoming.lowering S d) a) (Becoming.origin (Becoming.lowering S d) b))
            (S + 1) m fun a => π (Becoming.origin (Becoming.lowering S d) a)
@Becoming.sorts_step_by : ∀ {m S d : Nat} {J : Nat → Nat → Prop} {π σ : Nat → Nat},
  (∀ (a b : Nat), J a b → J b a) →
    Becoming.Reindexes S (m + 1) π σ →
      Becoming.KeepsOrder J S (m + 1) π →
        σ S = S + d →
          (∀ {J' : Nat → Nat → Prop} {π' σ' : Nat → Nat},
              (∀ (a b : Nat), J' a b → J' b a) →
                Becoming.Reindexes (S + 1) m π' σ' →
                  Becoming.KeepsOrder J' (S + 1) m π' →
                    ∃ ts,
                      Becoming.EachStep (fun t => S + 1 ≤ t ∧ t + 2 ≤ S + 1 + m) ts ∧
                        Becoming.Commutes J' ts ∧ ∀ (i : Nat), S + 1 ≤ i → i < S + 1 + m → Becoming.place ts i = π' i) →
            ∃ ts,
              Becoming.EachStep (fun t => S ≤ t ∧ t + 2 ≤ S + (m + 1)) ts ∧
                Becoming.Commutes J ts ∧ ∀ (i : Nat), S ≤ i → i < S + (m + 1) → Becoming.place ts i = π i
Becoming.sorts_by : ∀ (m S : Nat) {J : Nat → Nat → Prop} {π σ : Nat → Nat},
  (∀ (a b : Nat), J a b → J b a) →
    Becoming.Reindexes S m π σ →
      Becoming.KeepsOrder J S m π →
        ∃ ts,
          Becoming.EachStep (fun t => S ≤ t ∧ t + 2 ≤ S + m) ts ∧
            Becoming.Commutes J ts ∧ ∀ (i : Nat), S ≤ i → i < S + m → Becoming.place ts i = π i
@Becoming.sorts_by_iff : ∀ {S m : Nat} {J : Nat → Nat → Prop} {π σ : Nat → Nat},
  (∀ (a b : Nat), J a b → J b a) →
    Becoming.Reindexes S m π σ →
      ((∃ ts,
          Becoming.EachStep (fun t => S ≤ t ∧ t + 2 ≤ S + m) ts ∧
            Becoming.Commutes J ts ∧ ∀ (i : Nat), S ≤ i → i < S + m → Becoming.place ts i = π i) ↔
        Becoming.KeepsOrder J S m π)
@Becoming.Footprinted.independent_iff_commutes : ∀ {X : Type} {r : Becoming.Footprinted X} {ts : List Nat},
  r.Contains → (r.Independent ts ↔ Becoming.Commutes r.Joined ts)
@Becoming.swapAt_within : ∀ {S m t n : Nat},
  S ≤ t ∧ t + 2 ≤ S + m → S ≤ n → n < S + m → S ≤ Becoming.swapAt t n ∧ Becoming.swapAt t n < S + m
@Becoming.place_within : ∀ {S m : Nat} {ts : List Nat},
  Becoming.EachStep (fun t => S ≤ t ∧ t + 2 ≤ S + m) ts →
    ∀ {n : Nat}, S ≤ n → n < S + m → S ≤ Becoming.place ts n ∧ Becoming.place ts n < S + m
@Becoming.origin_within : ∀ {S m : Nat} {ts : List Nat},
  Becoming.EachStep (fun t => S ≤ t ∧ t + 2 ≤ S + m) ts →
    ∀ {n : Nat}, S ≤ n → n < S + m → S ≤ Becoming.origin ts n ∧ Becoming.origin ts n < S + m
@Becoming.reindexes_of_within : ∀ {S m : Nat} {ts : List Nat},
  Becoming.EachStep (fun t => S ≤ t ∧ t + 2 ≤ S + m) ts →
    Becoming.Reindexes S m (Becoming.place ts) (Becoming.origin ts)
Becoming.Reindexes.identity : ∀ (S m : Nat), Becoming.Reindexes S m (fun i => i) fun i => i
@Becoming.Reindexes.symm : ∀ {S m : Nat} {π σ : Nat → Nat}, Becoming.Reindexes S m π σ → Becoming.Reindexes S m σ π
@Becoming.Reindexes.comp : ∀ {S m : Nat} {π σ π' σ' : Nat → Nat},
  Becoming.Reindexes S m π σ →
    Becoming.Reindexes S m π' σ' → Becoming.Reindexes S m (fun i => π' (π i)) fun p => σ (σ' p)
