@Becoming.add_excess_of_le : ∀ {a b : Nat}, a ≤ b → a + Becoming.excess b a = b
Becoming.firstWhere_ge : ∀ (P : Nat → Bool) (a n : Nat), a ≤ Becoming.firstWhere P a n
