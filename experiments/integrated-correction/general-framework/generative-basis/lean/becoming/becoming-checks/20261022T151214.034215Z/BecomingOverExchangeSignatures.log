  {G : Becoming.SelectionTerm.Generations w.withRest.Relatum} {ds : List w.withRest.Relatum},
  Becoming.SelectionTerm.Flow.Descended w.withRest.flow w.withRest.web G →
    (∀ (t : Nat) (p k : w.withRest.Relatum), p ∈ G.family t → k ∈ G.kids t p → k ∈ ds) →
      (∀ (t : Nat), t < w.withRest.web.stock ds 0 + 1 → w.withRest.flow.DissipatesOn ds t) →
        G.size (w.withRest.web.stock ds 0 + 1) = 0
@Becoming.World.withRest_closed_lineage_lowered : ∀ {w : Becoming.World}
  {G : Becoming.SelectionTerm.Generations w.withRest.Relatum} {ds : List w.withRest.Relatum},
  Becoming.SelectionTerm.Flow.Descended w.withRest.flow w.withRest.web G →
    (∀ (t : Nat) (p k : w.withRest.Relatum), p ∈ G.family t → k ∈ G.kids t p → k ∈ ds) →
      (∀ (t : Nat), t < w.withRest.web.stock ds 0 + 1 → w.withRest.flow.DissipatesOn ds t) →
        Becoming.Reproduction.Generations.ByNumber G →
