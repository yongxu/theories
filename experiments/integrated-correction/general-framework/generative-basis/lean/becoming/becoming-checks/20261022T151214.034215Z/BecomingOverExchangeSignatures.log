@Becoming.World.ReadOffExchange.consumption_ends_with_feeders : ∀ {w : Becoming.World},
  w.ReadOffExchange →
    ∀ {c g : w.withRest.Relatum} {T : Nat},
      (∀ (t : Nat), T ≤ t → w.withRest.web.active t g → w.withRest.web.requires t g c) →
        (∀ (t : Nat) (f : w.withRest.Relatum),
            T ≤ t → w.withRest.flow.FedBy w.withRest.web (g, t) (f, t) → ¬w.withRest.web.Supported t f) →
          (∀ (t : Nat),
              T ≤ t → w.withRest.web.active t g → g ∈ w.withRest.flow.present t ∧ 0 < w.withRest.flow.take t g c) →
            ∀ (n : Nat), (∀ (k : Nat), k < n → w.withRest.web.active (T + k) g) → n ≤ w.withRest.web.level T c
@Becoming.World.ReadOffExchange.continuing_excludes : ∀ {w : Becoming.World},
  w.ReadOffExchange →
    ∀ {c : w.withRest.Relatum} {m : Nat},
      (∀ (t : Nat) (e : w.withRest.Relatum),
          e ∈ w.withRest.flow.present t →
            0 < w.withRest.flow.give t e c → w.withRest.web.requires t e c ∧ m ≤ w.withRest.web.need t e c) →
        ∀ {f g : w.withRest.Relatum},
          f ≠ g →
            (∀ (t : Nat), w.withRest.flow.TakesAll t f c) →
              (∀ (t : Nat), w.withRest.web.requires t f c ∧ m ≤ w.withRest.web.need t f c) →
                (∀ (t : Nat), w.withRest.web.active t f) →
                  ∀ (T : Nat),
                    ¬∀ (j : Nat),
                        j < w.withRest.web.level T c + 1 →
                          g ∈ w.withRest.flow.present (T + j) ∧ 0 < w.withRest.flow.take (T + j) g c
@Becoming.World.ReadOffExchange.outrun_below : ∀ {w : Becoming.World},
  w.ReadOffExchange →
    ∀ {c : w.withRest.Relatum} {m : Nat},
      (∀ (t : Nat) (e : w.withRest.Relatum),
          e ∈ w.withRest.flow.present t →
            0 < w.withRest.flow.give t e c → w.withRest.web.requires t e c ∧ m ≤ w.withRest.web.need t e c) →
        ∀ {T n : Nat} {rest : List w.withRest.Relatum},
          Becoming.Distinct rest →
            (∀ (j : Nat) (f : w.withRest.Relatum),
                j < n → f ∈ rest → 0 < w.withRest.flow.take (T + j) f c → f ∈ w.withRest.flow.present (T + j)) →
              (∀ (j : Nat),
                  j < n →
                    w.withRest.flow.given (T + j) c < Becoming.total rest fun f => w.withRest.flow.take (T + j) f c) →
                w.withRest.web.level T c < n + m → ∀ (k : Nat), w.withRest.web.level (T + n + k) c < m
@Becoming.World.ReadOffExchange.roles_dependent : ∀ {w : Becoming.World},
  w.ReadOffExchange → w.withRest.web.roles.Dependent
@Becoming.World.ReadOffExchange.selection_within : ∀ {w : Becoming.World},
  w.ReadOffExchange →
    ∀ {t : Nat} {c : w.withRest.Relatum} {ps : List w.withRest.Relatum}
      {kids : w.withRest.Relatum → List w.withRest.Relatum},
      (∀ (p k : w.withRest.Relatum), p ∈ ps → k ∈ kids p → w.withRest.flow.DescendsAt w.withRest.web t k p) →
        (∀ (p : w.withRest.Relatum), p ∈ ps → w.withRest.web.requires t p c) →
          ∀ (b : w.withRest.Relatum → Nat),
            Becoming.offspring ps kids b + Becoming.lowered ps kids (fun p => w.withRest.web.need t p c) b ≤
              (Becoming.selected ps kids fun x => w.withRest.web.level t c) +
                Becoming.raised ps kids (fun p => w.withRest.web.need t p c) b
@Becoming.World.ReadOffExchange.selected_le : ∀ {w : Becoming.World},
  w.ReadOffExchange →
    ∀ {t : Nat} {c : w.withRest.Relatum} {ps : List w.withRest.Relatum}
      {kids : w.withRest.Relatum → List w.withRest.Relatum},
      (∀ (p k : w.withRest.Relatum), p ∈ ps → k ∈ kids p → w.withRest.flow.DescendsAt w.withRest.web t k p) →
        (∀ (p : w.withRest.Relatum), p ∈ ps → w.withRest.web.requires t p c) →
          (Becoming.selected ps kids fun p => w.withRest.web.need t p c) ≤
            Becoming.selected ps kids fun x => w.withRest.web.level t c
@Becoming.World.ReadOffExchange.transmitted_supported : ∀ {w : Becoming.World},
  w.ReadOffExchange →
    ∀ {c : w.withRest.Relatum} {δ : Nat},
      w.withRest.flow.TransmitsWithin w.withRest.web c δ →
        ∀ {t : Nat} {x g : w.withRest.Relatum},
          w.withRest.flow.DescendsAt w.withRest.web t x g →
            w.withRest.web.requires (t + 1) x c → w.withRest.web.need (t + 1) x c ≤ w.withRest.web.level t c + δ
@Becoming.World.ReadOffExchange.support_not_lower : ∀ {w : Becoming.World},
  w.ReadOffExchange →
    ∀ {G : Becoming.SelectionTerm.Generations w.withRest.Relatum},
      Becoming.SelectionTerm.Flow.Descended w.withRest.flow w.withRest.web G →
        (∀ (t : Nat) (p : w.withRest.Relatum),
            p ∈ G.family t →
              w.withRest.web.Supported t p → ∀ (q : w.withRest.Relatum), q ∈ G.family t → G.amount t q ≤ G.amount t p) →
          ∀ {T : Nat}, (∀ (t : Nat), t < T → G.loweredAt t = 0) → G.size T * G.sum 0 ≤ G.size 0 * G.sum T
@Becoming.World.ReadOffExchange.support_moved_rises : ∀ {w : Becoming.World},
  w.ReadOffExchange →
    ∀ {G : Becoming.SelectionTerm.Generations w.withRest.Relatum},
      Becoming.SelectionTerm.Flow.Descended w.withRest.flow w.withRest.web G →
        (∀ (t : Nat) (p : w.withRest.Relatum),
            p ∈ G.family t →
              w.withRest.web.Supported t p → ∀ (q : w.withRest.Relatum), q ∈ G.family t → G.amount t q ≤ G.amount t p) →
          ∀ {T : Nat},
            (∀ (t : Nat),
                t < T → Becoming.SelectionTerm.Exact (G.family t) (G.kids t) (G.amount t) (G.amount (t + 1))) →
              G.size 0 * G.sum T ≠ G.size T * G.sum 0 →
                G.size T * G.sum 0 < G.size 0 * G.sum T ∧ ∃ t, t < T ∧ G.discordAt t < G.concordAt t
@Becoming.World.ReadOffExchange.family_childless : ∀ {w : Becoming.World},
  w.ReadOffExchange →
    ∀ {ds : List w.withRest.Relatum} {m : Nat},
      (∀ (t : Nat) (f : w.withRest.Relatum),
          f ∈ w.withRest.flow.present t →
            ∀ (d : w.withRest.Relatum),
              d ∈ ds →
                0 < w.withRest.flow.give t f d →
                  ∃ e, e ∈ ds ∧ w.withRest.web.requires t f e ∧ m ≤ w.withRest.web.need t f e) →
        ∀ {T n : Nat},
          (∀ (k : Nat), k < n → w.withRest.flow.replenishment ds (T + k) < w.withRest.flow.uptake ds (T + k)) →
            w.withRest.web.stock ds T < n + m →
              ∀ (k : Nat) {g e : w.withRest.Relatum},
                e ∈ ds →
                  w.withRest.web.requires (T + n + k) g e →
                    m ≤ w.withRest.web.need (T + n + k) g e →
                      ∀ (x : w.withRest.Relatum), ¬w.withRest.flow.DescendsAt w.withRest.web (T + n + k) x g
@Becoming.World.ReadOffExchange.coupled_end_together : ∀ {w : Becoming.World},
  w.ReadOffExchange →
    ∀ {ds : List w.withRest.Relatum} {m : Nat},
      (∀ (t : Nat) (f : w.withRest.Relatum),
          f ∈ w.withRest.flow.present t →
            ∀ (d : w.withRest.Relatum),
              d ∈ ds →
                0 < w.withRest.flow.give t f d →
                  ∃ e, e ∈ ds ∧ w.withRest.web.requires t f e ∧ m ≤ w.withRest.web.need t f e) →
        ∀ {T n : Nat},
          (∀ (k : Nat), k < n → w.withRest.flow.replenishment ds (T + k) < w.withRest.flow.uptake ds (T + k)) →
            w.withRest.web.stock ds T < n + m →
              ∀ (k : Nat) {G : Becoming.SelectionTerm.Generations w.withRest.Relatum},
                Becoming.SelectionTerm.Flow.Descended w.withRest.flow w.withRest.web G →
                  ∀ {gs : List (List w.withRest.Relatum)},
                    (∀ (h : List w.withRest.Relatum) (p : w.withRest.Relatum),
                        h ∈ gs → p ∈ h → p ∈ G.family (T + n + k)) →
                      (∀ (h : List w.withRest.Relatum) (p : w.withRest.Relatum),
                          h ∈ gs →
                            p ∈ h →
                              ∃ e,
                                e ∈ ds ∧
                                  w.withRest.web.requires (T + n + k) p e ∧ m ≤ w.withRest.web.need (T + n + k) p e) →
                        ∀ (a : w.withRest.Relatum → Nat),
                          (∀ (h : List w.withRest.Relatum),
                              h ∈ gs → Becoming.total h (G.offspringNumber (T + n + k)) = 0) ∧
                            Becoming.SelectionLevels.concordAmong gs (G.offspringNumber (T + n + k)) a = 0 ∧
                              Becoming.SelectionLevels.discordAmong gs (G.offspringNumber (T + n + k)) a = 0
@Becoming.World.ReadOffExchange.family_excess_ends : ∀ {w : Becoming.World},
  w.ReadOffExchange →
    ∀ {parts : w.withRest.Relatum → Prop} {x : w.withRest.Relatum} {alive : Nat → List w.withRest.Relatum},
      w.withRest.web.Whole parts x →
        w.withRest.web.Listed parts alive →
          (∀ (p : w.withRest.Relatum), parts p → w.withRest.web.Ends p) →
            ∀ {ds : List w.withRest.Relatum} {m : Nat},
              (∀ (t : Nat) (f : w.withRest.Relatum),
                  f ∈ w.withRest.flow.present t →
                    ∀ (d : w.withRest.Relatum),
                      d ∈ ds →
                        0 < w.withRest.flow.give t f d →
                          ∃ e, e ∈ ds ∧ w.withRest.web.requires t f e ∧ m ≤ w.withRest.web.need t f e) →
                (∀ (t : Nat) (p : w.withRest.Relatum),
                    parts p →
                      w.withRest.web.Arises t p →
                        ∃ e, e ∈ ds ∧ w.withRest.web.requires (t + 1) p e ∧ m ≤ w.withRest.web.need (t + 1) p e) →
                  ∀ {T n : Nat},
                    (∀ (k : Nat),
                        k < n → w.withRest.flow.replenishment ds (T + k) < w.withRest.flow.uptake ds (T + k)) →
                      w.withRest.web.stock ds T < n + m →
                        (∀ (t : Nat), T + n ≤ t → ∀ (p : w.withRest.Relatum), parts p → ¬w.withRest.web.Arises t p) ∧
                          w.withRest.web.Ends x
@Becoming.ExchangeRelation.respondsBelow_supports : ∀ {F C : Type} {rel : Becoming.ExchangeRelation F C}
  {present : Nat → List F}, rel.Supports present (rel.RespondsBelow present)
@Becoming.ExchangeRelation.respondsBelow_local : ∀ {F C : Type} {rel : Becoming.ExchangeRelation F C}
  {present : Nat → List F}, Becoming.ExchangeRelation.Local (rel.RespondsBelow present)
@Becoming.ExchangeRelation.respondsBelow_weakest : ∀ {F C : Type} {rel : Becoming.ExchangeRelation F C}
  {present : Nat → List F} {R : (Nat → C → Nat) → Nat → F → C → Nat → Prop},
