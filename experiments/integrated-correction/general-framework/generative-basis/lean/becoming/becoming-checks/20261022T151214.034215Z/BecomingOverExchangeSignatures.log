  {reads : Nat → Option R → Option R → Nat → Option R → Bool},
  law.ReadsInto part reads →
    (∀ (t : Nat) (h e : Option R) (s : Nat) (d : Option R), reads t h e s d = true → d ∈ cs) →
      (∀ (t : Nat), L.present t = L'.present t) →
        (Becoming.World.of R L W).withRest.flow.ActsAlike (Becoming.World.of R L' W').withRest.flow part →
          (Becoming.World.of R L W).withRest.flow.Follows law part (Becoming.World.of R L W).withRest.web.level →
            (Becoming.World.of R L' W').withRest.flow.Follows law part (Becoming.World.of R L' W').withRest.web.level →
              ∀ {c : Option R},
                (∀ (e : Option R),
                    e ≠ c →
                      (Becoming.World.of R L W).withRest.web.level 0 e =
                        (Becoming.World.of R L' W').withRest.web.level 0 e) →
                  ∀ (t : Nat) (e : Option R),
                    ¬Becoming.Upstream cs part (Becoming.strengthsBefore t (Becoming.readCouplings reads))
                          (Becoming.World.of R L W).withRest.flow.present c e →
                      (Becoming.World.of R L W).withRest.web.level t e =
                        (Becoming.World.of R L' W').withRest.web.level t e
