          ∀ {t : Nat}, w.withRest.web.SelectsThroughAll obs pool t select → (select w.withRest.web.level ↔ select l)
@Becoming.World.withRest_retains_iff_within_margin : ∀ {w : Becoming.World} {Pos : Type}
  {part : w.withRest.Relatum → Bool} {l : Nat → w.withRest.Relatum → Nat},
  w.withRest.flow.WithheldLevels part w.withRest.web l →
    ∀ {sig : Pos → Nat → w.withRest.Relatum → Prop} {p : Pos},
      w.withRest.web.Retains sig p w.withRest.web.level l ↔
        ∀ (t : Nat) (f : w.withRest.Relatum),
          sig p t f →
            w.withRest.web.Admits (l t) t f →
              ∀ (c : w.withRest.Relatum),
                w.withRest.web.requires t f c →
                  (w.withRest.web.need t f c +
                      Becoming.total (Becoming.steps 0 t) fun s => w.withRest.flow.partTaken part s c) ≤
                    l t c + Becoming.total (Becoming.steps 0 t) fun s => w.withRest.flow.partGiven part s c
@Becoming.World.withRest_widens_iff_others_within : ∀ {w : Becoming.World} {part : w.withRest.Relatum → Bool}
  {l : Nat → w.withRest.Relatum → Nat},
  w.withRest.flow.WithheldLevels part w.withRest.web l →
    ∀ {own : w.withRest.Relatum → Bool},
      w.withRest.web.WidensWithin own w.withRest.web.level l →
        (w.withRest.web.Widens w.withRest.web.level l ↔
          ∀ (t : Nat) (f : w.withRest.Relatum),
            own f = false →
              w.withRest.web.Admits (l t) t f →
                ∀ (c : w.withRest.Relatum),
                  w.withRest.web.requires t f c →
                    (w.withRest.web.need t f c +
                        Becoming.total (Becoming.steps 0 t) fun s => w.withRest.flow.partTaken part s c) ≤
                      l t c + Becoming.total (Becoming.steps 0 t) fun s => w.withRest.flow.partGiven part s c)
