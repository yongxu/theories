@Becoming.World.withRest_comparison_within_response : ∀ {R : Type} {L L' : Becoming.Flow R R} {W W' : Becoming.Web R R}
  {Pos : Type} {obs : Option R → Option R → Prop} {part : Option R → Bool},
  (∀ (t : Nat), L.present t = L'.present t) →
    (∀ (c : R), W.level 0 c = W'.level 0 c) →
      (Becoming.World.of R L W).withRest.flow.RespondsThroughCoupling (Becoming.World.of R L' W').withRest.flow
          (Becoming.World.of R L W).withRest.web (Becoming.World.of R L' W').withRest.web obs part →
        ∀ {sig : Pos → Nat → Option R → Prop} {p : Pos},
          (∀ (t : Nat) (g : (Becoming.World.of R L W).withRest.Relatum),
              ¬¬(Becoming.World.of R L W).withRest.flow.WithinResponse (Becoming.World.of R L' W').withRest.flow
                      (Becoming.World.of R L W).withRest.web obs part g →
                sig p t g) →
            ((Becoming.World.of R L W).withRest.web.Retains sig p (Becoming.World.of R L W).withRest.web.level
                  (Becoming.World.of R L' W').withRest.web.level ↔
                (Becoming.World.of R L W).withRest.web.Includes (Becoming.World.of R L W).withRest.web.level
                  (Becoming.World.of R L' W').withRest.web.level) ∧
              ((Becoming.World.of R L W).withRest.web.Retains sig p (Becoming.World.of R L' W').withRest.web.level
                    (Becoming.World.of R L W).withRest.web.level ↔
                  (Becoming.World.of R L W).withRest.web.Includes (Becoming.World.of R L' W').withRest.web.level
                    (Becoming.World.of R L W).withRest.web.level) ∧
                (¬(Becoming.World.of R L W).withRest.web.Adds sig p (Becoming.World.of R L W).withRest.web.level
                        (Becoming.World.of R L' W').withRest.web.level ↔
                    ¬(Becoming.World.of R L W).withRest.web.Exceeds (Becoming.World.of R L W).withRest.web.level
                        (Becoming.World.of R L' W').withRest.web.level) ∧
                  (¬(Becoming.World.of R L W).withRest.web.Adds sig p (Becoming.World.of R L' W').withRest.web.level
                        (Becoming.World.of R L W).withRest.web.level ↔
                    ¬(Becoming.World.of R L W).withRest.web.Exceeds (Becoming.World.of R L' W').withRest.web.level
                        (Becoming.World.of R L W).withRest.web.level)
@Becoming.World.withRest_counterfactual_is_course : ∀ {w : Becoming.World}
  {law act : Becoming.ExchangeLaw w.withRest.Relatum w.withRest.Relatum} {part : w.withRest.Relatum → Bool},
  law.Nonanticipating →
    act.Nonanticipating →
      ∀ {present : Nat → List w.withRest.Relatum} {start : w.withRest.Relatum → Nat},
        (∀ (t : Nat), w.withRest.flow.present t = present t) →
          w.withRest.flow.ActsAlike ((law.withAct part act).course present start) part →
            w.withRest.flow.Follows law part w.withRest.web.level →
              (∀ (c : w.withRest.Relatum), w.withRest.web.level 0 c = start c) →
                (law.withAct part act).Feasible present start →
                  (∀ (t : Nat) (c : w.withRest.Relatum),
                      w.withRest.web.level t c = (law.withAct part act).levels present start t c) ∧
                    ∀ (t : Nat) (h c : w.withRest.Relatum),
                      w.withRest.flow.take t h c = ((law.withAct part act).course present start).take t h c ∧
                        w.withRest.flow.give t h c = ((law.withAct part act).course present start).give t h c
@Becoming.World.withRest_act_unselected : ∀ {R : Type} {L L' : Becoming.Flow R R} {W W' : Becoming.Web R R}
  {law : Becoming.ExchangeLaw (Option R) (Option R)} {obs : Option R → Option R → Prop} {part : Option R → Bool}
  {f : Option R} {select : (Nat → Option R → Nat) → Prop},
  law.Through (Becoming.World.of R L W).withRest.web obs part →
    (Becoming.World.of R L W).withRest.flow.Follows law part (Becoming.World.of R L W).withRest.web.level →
      (Becoming.World.of R L' W').withRest.flow.Follows law part (Becoming.World.of R L' W').withRest.web.level →
        (∀ (t : Nat), L.present t = L'.present t) →
          (∀ (c : R), W.level 0 c = W'.level 0 c) →
            (Becoming.World.of R L W).withRest.flow.ActsAlikeWithin (Becoming.World.of R L' W').withRest.flow
                (Becoming.World.of R L W).withRest.web (Becoming.World.of R L' W').withRest.web obs part f →
              ∀ {g : Option R},
                Becoming.WithinClosure
                    ((Becoming.World.of R L W).withRest.flow.CoupledFromEither (Becoming.World.of R L W).withRest.web
                      (Becoming.World.of R L' W').withRest.flow obs)
                    f g →
                  ∀ {t : Nat},
                    (Becoming.World.of R L W).withRest.web.SelectsThrough obs g t select →
                      (select (Becoming.World.of R L W).withRest.web.level ↔
                        select (Becoming.World.of R L' W').withRest.web.level)
@Becoming.World.withRest_act_selected_by_pool : ∀ {R : Type} {L L' : Becoming.Flow R R} {W W' : Becoming.Web R R}
  {law : Becoming.ExchangeLaw (Option R) (Option R)} {obs : Option R → Option R → Prop} {part : Option R → Bool}
  {group : Option R → Prop},
  law.Through (Becoming.World.of R L W).withRest.web obs part →
    (Becoming.World.of R L W).withRest.flow.Follows law part (Becoming.World.of R L W).withRest.web.level →
      (Becoming.World.of R L' W').withRest.flow.Follows law part (Becoming.World.of R L' W').withRest.web.level →
        (∀ (t : Nat), L.present t = L'.present t) →
          (∀ (c : R), W.level 0 c = W'.level 0 c) →
            (∀ (f : Option R),
                group f →
                  (Becoming.World.of R L W).withRest.flow.ActsAlikeWithin (Becoming.World.of R L' W').withRest.flow
                    (Becoming.World.of R L W).withRest.web (Becoming.World.of R L' W').withRest.web obs part f) →
              ∀ {x : Option R} {s : Nat},
                ¬((Becoming.World.of R L W).withRest.web.Admits ((Becoming.World.of R L W).withRest.web.level s) s x ↔
                      (Becoming.World.of R L W).withRest.web.Admits ((Becoming.World.of R L' W').withRest.web.level s) s
                        x) →
                  ¬Becoming.WithinClosureOf
                        ((Becoming.World.of R L W).withRest.flow.CoupledFromEither
                          (Becoming.World.of R L W).withRest.web (Becoming.World.of R L' W').withRest.flow obs)
                        group x ∧
                    (∀ (pool : Option R → Prop),
                        pool x →
                          ∀ (t : Nat),
                            s ≤ t →
                              (Becoming.World.of R L W).withRest.web.SelectsThroughAll obs pool t fun l =>
                                (Becoming.World.of R L W).withRest.web.Admits (l s) s x) ∧
                      ∀ (pool : Option R → Prop),
                        (∀ (g : Option R),
                            pool g →
                              Becoming.WithinClosureOf
                                ((Becoming.World.of R L W).withRest.flow.CoupledFromEither
                                  (Becoming.World.of R L W).withRest.web (Becoming.World.of R L' W').withRest.flow obs)
                                group g) →
                          ∀ (t : Nat),
                            ¬(Becoming.World.of R L W).withRest.web.SelectsThroughAll obs pool t fun l =>
                                (Becoming.World.of R L W).withRest.web.Admits (l s) s x
