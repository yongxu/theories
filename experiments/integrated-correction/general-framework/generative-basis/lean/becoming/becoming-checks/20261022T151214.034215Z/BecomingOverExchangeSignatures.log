            ∃ t, t < w.withRest.web.stock ds 0 ∧ G.concordAt t + G.size t * G.raisedAt t < G.size t * G.loweredAt t
@Becoming.World.withRest_rises_iff_inactive : ∀ {w : Becoming.World}
  {G : Becoming.SelectionTerm.Generations w.withRest.Relatum},
  Becoming.SelectionTerm.Flow.Descended w.withRest.flow w.withRest.web G →
    ∀ {t m : Nat} (gs : List (List w.withRest.Relatum)),
      Becoming.SelectionLevels.whole gs = G.family t →
        (∀ (g : List w.withRest.Relatum), g ∈ gs → g.length = m) →
          Becoming.SelectionTerm.Exact (G.family t) (G.kids t) (G.amount t) (G.amount (t + 1)) →
            (∀ (g h : List w.withRest.Relatum),
                g ∈ gs →
                  h ∈ gs →
                    Becoming.total h (G.amount t) < Becoming.total g (G.amount t) →
                      ∀ (p : w.withRest.Relatum), p ∈ h → ¬w.withRest.web.active t p) →
              (G.Raises t ↔
                gs.length * Becoming.SelectionLevels.discordWithin gs (G.offspringNumber t) (G.amount t) <
                  gs.length * Becoming.SelectionLevels.concordWithin gs (G.offspringNumber t) (G.amount t) +
                    Becoming.SelectionLevels.concordAmong gs (G.offspringNumber t) (G.amount t))
