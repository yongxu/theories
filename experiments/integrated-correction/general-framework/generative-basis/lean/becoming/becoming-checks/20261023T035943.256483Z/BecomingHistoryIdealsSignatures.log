      (h' : Becoming.Ideals.Within (Becoming.stretchOrder P) Q r'.stretches),
      (r.stretches.restrict h).LE (r'.stretches.restrict h') ↔ ∀ (t : Nat), Becoming.Run.AgreeUpTo t r r'
