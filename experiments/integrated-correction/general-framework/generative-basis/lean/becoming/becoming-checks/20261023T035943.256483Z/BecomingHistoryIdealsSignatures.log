  {Q : Becoming.Ideals.Preorder β} (D : Becoming.Ideals.DirectedComplete Q) {f : Becoming.Run P × Nat → β},
  Becoming.Ideals.Monotone (Becoming.stretchOrder P) Q f →
    ∀ {g g' : Becoming.Ideals.Ideal (Becoming.stretchOrder P) → β},
      Becoming.Ideals.Continuous (Becoming.Ideals.idealComplete (Becoming.stretchOrder P)) D g →
        Becoming.Ideals.Continuous (Becoming.Ideals.idealComplete (Becoming.stretchOrder P)) D g' →
