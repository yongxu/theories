  {K : Becoming.Run P → Prop} {H : Becoming.Ideals.Ideal (Becoming.stretchOrder P) → Prop},
  Becoming.Ideals.ScottClosed H →
    (∀ (r : Becoming.Run P), K r → H r.stretches) →
