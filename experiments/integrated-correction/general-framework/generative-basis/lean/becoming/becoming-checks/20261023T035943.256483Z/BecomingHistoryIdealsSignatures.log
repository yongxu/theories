      Becoming.Ideals.extend Becoming.Ideals.implicationComplete (Becoming.Ideals.above (Becoming.stretchOrder P) e) ⋯
          r.stretches ↔
        Becoming.Ideals.extend Becoming.Ideals.implicationComplete (Becoming.Ideals.above (Becoming.stretchOrder P) e) ⋯
          r'.stretches) →
    ∀ (t : Nat), Becoming.Run.AgreeUpTo t r r'
@Becoming.Stretches.finite_basis : ∀ {S : Type u_1} {A : Type u_2} (P : Generative.Process S A),
  Becoming.Ideals.CompactBasis (Becoming.stretchOrder P) (Becoming.Ideals.idealComplete (Becoming.stretchOrder P))
    (Becoming.Ideals.principal (Becoming.stretchOrder P))
@Becoming.Stretches.histories_representation : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A}
  {β : Type u_3} {Q : Becoming.Ideals.Preorder β} {D : Becoming.Ideals.DirectedComplete Q}
  {e : Becoming.Run P × Nat → β},
  Becoming.Ideals.CompactBasis (Becoming.stretchOrder P) D e →
    ∃ F,
      (∀ (s : Becoming.Run P × Nat),
          Q.Equiv (F.forward (Becoming.Ideals.principal (Becoming.stretchOrder P) s)) (e s)) ∧
        ∀ (G : Becoming.Ideals.OrderEquivalence (Becoming.Ideals.idealOrder (Becoming.stretchOrder P)) Q),
