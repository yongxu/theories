@Becoming.Transactions.replay_no_trace : ∀ {roster : List Becoming.FaultEnvelopes.Domain}
  {rf af : Becoming.FaultEnvelopes.Envelope} {w w'' : Becoming.Transactions.Installation}
  {x : Becoming.Transactions.Transaction},
  x.request.serial = w.serial →
    ∀ (laterReads : Becoming.Transactions.Readings) (laterApprovals : Becoming.Transactions.Approvals),
      ¬Generative.Trace (Becoming.Transactions.monitor roster rf af) w
          [(x, true), ({ request := x.request, reads := laterReads, approvals := laterApprovals }, true)] w''
@Becoming.Transactions.completion_exact : ∀ {roster : List Becoming.FaultEnvelopes.Domain}
  {rf af : Becoming.FaultEnvelopes.Envelope} {w : Becoming.Transactions.Installation}
  {x : Becoming.Transactions.Transaction},
  Becoming.Transactions.gate roster rf af w x.request x.reads x.approvals = true →
    Becoming.TreeSearch.locate w.root x.request.address = some x.request.key →
      Becoming.Transactions.load roster x.request + 3 ≤ w.state.reserve →
        w.state.time + Becoming.Transactions.load roster x.request + 3 ≤ w.state.deadline →
          ∃ w',
            (Becoming.Transactions.monitor roster rf af).step w (x, true) w' ∧
              w'.state.completed = true ∧
                w'.serial = w.serial + 1 ∧
                  w'.state.drawn = w.state.drawn + (Becoming.Transactions.load roster x.request + 3)
@Becoming.Transactions.quorum_completes : ∀ {roster : List Becoming.FaultEnvelopes.Domain}
  {rf af : Becoming.FaultEnvelopes.Envelope} {w : Becoming.Transactions.Installation}
  {x : Becoming.Transactions.Transaction} (readBad issueBad : List Becoming.FaultEnvelopes.Domain),
  readBad ∈ rf →
    issueBad ∈ af →
      Becoming.FaultEnvelopes.separated roster rf →
        Becoming.FaultEnvelopes.separated roster af →
          Becoming.Transactions.fresh w x.request = true →
            (∀ (d : Becoming.FaultEnvelopes.Domain),
                d ∈ roster → ¬d ∈ readBad → x.reads d = some (Becoming.Transactions.expected x.request)) →
              (∀ (d : Becoming.FaultEnvelopes.Domain), d ∈ roster → ¬d ∈ issueBad → x.approvals d = some x.request) →
                (∀ (d : Becoming.FaultEnvelopes.Domain),
                    d ∈ roster →
                      ¬d ∈ readBad →
                        ∀ (o : Becoming.Transactions.Observation),
                          x.reads d = some o → o = Becoming.Transactions.observed w x.request.address) →
                  (∀ (d : Becoming.FaultEnvelopes.Domain),
                      d ∈ roster →
                        ¬d ∈ issueBad →
                          x.approvals d = some x.request → Becoming.Transactions.withinScope w x.request = true) →
                    Becoming.Transactions.load roster x.request + 3 ≤ w.state.reserve →
                      w.state.time + Becoming.Transactions.load roster x.request + 3 ≤ w.state.deadline →
                        ∃ w',
                          (Becoming.Transactions.monitor roster rf af).step w (x, true) w' ∧
                            w'.state.completed = true ∧ Becoming.Transactions.withinScope w x.request = true
@Becoming.Transactions.guarded_forbidden_no_completion : ∀ {roster : List Becoming.FaultEnvelopes.Domain}
