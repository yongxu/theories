@Becoming.Transactions.completion_within_scope : ∀ {roster : List Becoming.FaultEnvelopes.Domain}
  {rf af : Becoming.FaultEnvelopes.Envelope} {w w' : Becoming.Transactions.Installation}
  {x : Becoming.Transactions.Transaction} {bad : List Becoming.FaultEnvelopes.Domain},
  bad ∈ af →
