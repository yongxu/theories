        { installation := { root := w.root, state := done, serial := w.serial + 1, scope := w.scope },
          succeeded := true }
@Becoming.Transactions.succeeded_cases : ∀ {roster : List Becoming.FaultEnvelopes.Domain}
  {rf af : Becoming.FaultEnvelopes.Envelope} {w : Becoming.Transactions.Installation}
