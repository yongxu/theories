Becoming.Transactions.accepted_reading_matches : ∀ (roster : List Becoming.FaultEnvelopes.Domain)
  (faults : Becoming.FaultEnvelopes.Envelope) (w : Becoming.Transactions.Installation)
  (p : Becoming.Transactions.Request) (reads : Becoming.Transactions.Readings)
  (bad : List Becoming.FaultEnvelopes.Domain),
  bad ∈ faults →
    (∀ (d : Becoming.FaultEnvelopes.Domain),
        d ∈ roster →
          ¬d ∈ bad →
            ∀ (o : Becoming.Transactions.Observation),
              reads d = some o → o = Becoming.Transactions.observed w p.address) →
      Becoming.FaultEnvelopes.certificate roster faults (Becoming.Transactions.readSupport p reads) = true →
        Becoming.Transactions.expected p = Becoming.Transactions.observed w p.address
Becoming.Transactions.gate_route : ∀ (roster : List Becoming.FaultEnvelopes.Domain)
  (rf af : Becoming.FaultEnvelopes.Envelope) (w : Becoming.Transactions.Installation)
  (p : Becoming.Transactions.Request) (reads : Becoming.Transactions.Readings)
  (approvals : Becoming.Transactions.Approvals) (bad : List Becoming.FaultEnvelopes.Domain),
  bad ∈ rf →
    (∀ (d : Becoming.FaultEnvelopes.Domain),
        d ∈ roster →
          ¬d ∈ bad →
            ∀ (o : Becoming.Transactions.Observation),
              reads d = some o → o = Becoming.Transactions.observed w p.address) →
      Becoming.Transactions.gate roster rf af w p reads approvals = true →
        Becoming.TreeSearch.locate w.root p.address = some p.key
Becoming.Transactions.gate_within_scope : ∀ (roster : List Becoming.FaultEnvelopes.Domain)
  (rf af : Becoming.FaultEnvelopes.Envelope) (w : Becoming.Transactions.Installation)
  (p : Becoming.Transactions.Request) (reads : Becoming.Transactions.Readings)
  (approvals : Becoming.Transactions.Approvals) (bad : List Becoming.FaultEnvelopes.Domain),
  bad ∈ af →
    (∀ (d : Becoming.FaultEnvelopes.Domain),
        d ∈ roster → ¬d ∈ bad → approvals d = some p → Becoming.Transactions.withinScope w p = true) →
      Becoming.Transactions.gate roster rf af w p reads approvals = true → Becoming.Transactions.withinScope w p = true
@Becoming.Transactions.fresh_iff : ∀ {w : Becoming.Transactions.Installation} {p : Becoming.Transactions.Request},
  Becoming.Transactions.fresh w p = true ↔ p.epoch = w.state.epoch ∧ p.serial = w.serial
Becoming.Transactions.stale_rejected : ∀ (roster : List Becoming.FaultEnvelopes.Domain)
  (rf af : Becoming.FaultEnvelopes.Envelope) (w : Becoming.Transactions.Installation)
  (p : Becoming.Transactions.Request) (reads : Becoming.Transactions.Readings)
  (approvals : Becoming.Transactions.Approvals),
  p.serial ≠ w.serial ∨ p.epoch ≠ w.state.epoch → Becoming.Transactions.gate roster rf af w p reads approvals = false
Becoming.Transactions.gate_available : ∀ (roster : List Becoming.FaultEnvelopes.Domain)
  (rf af : Becoming.FaultEnvelopes.Envelope) (w : Becoming.Transactions.Installation)
  (p : Becoming.Transactions.Request) (reads : Becoming.Transactions.Readings)
  (approvals : Becoming.Transactions.Approvals) (readBad issueBad : List Becoming.FaultEnvelopes.Domain),
  readBad ∈ rf →
    issueBad ∈ af →
      Becoming.FaultEnvelopes.separated roster rf →
        Becoming.FaultEnvelopes.separated roster af →
          Becoming.Transactions.fresh w p = true →
            (∀ (d : Becoming.FaultEnvelopes.Domain),
                d ∈ roster → ¬d ∈ readBad → reads d = some (Becoming.Transactions.expected p)) →
              (∀ (d : Becoming.FaultEnvelopes.Domain), d ∈ roster → ¬d ∈ issueBad → approvals d = some p) →
                Becoming.Transactions.gate roster rf af w p reads approvals = true
@Becoming.Transactions.execute_of_draw : ∀ {roster : List Becoming.FaultEnvelopes.Domain}
  {rf af : Becoming.FaultEnvelopes.Envelope} {w : Becoming.Transactions.Installation}
  {p : Becoming.Transactions.Request} {reads : Becoming.Transactions.Readings}
  {approvals : Becoming.Transactions.Approvals} {loaded : Becoming.Actuation.State},
  Becoming.Actuation.draw (Becoming.Transactions.load roster p) (Becoming.Transactions.load roster p) w.state =
      some loaded →
    Becoming.Transactions.execute roster rf af w p reads approvals =
      Becoming.Transactions.passGate roster rf af w p reads approvals loaded
@Becoming.Transactions.execute_of_short : ∀ {roster : List Becoming.FaultEnvelopes.Domain}
  {rf af : Becoming.FaultEnvelopes.Envelope} {w : Becoming.Transactions.Installation}
  {p : Becoming.Transactions.Request} {reads : Becoming.Transactions.Readings}
  {approvals : Becoming.Transactions.Approvals},
  Becoming.Actuation.draw (Becoming.Transactions.load roster p) (Becoming.Transactions.load roster p) w.state = none →
    Becoming.Transactions.execute roster rf af w p reads approvals = { installation := w, succeeded := false }
@Becoming.Transactions.passGate_of_open : ∀ {roster : List Becoming.FaultEnvelopes.Domain}
  {rf af : Becoming.FaultEnvelopes.Envelope} {w : Becoming.Transactions.Installation}
  {p : Becoming.Transactions.Request} {reads : Becoming.Transactions.Readings}
  {approvals : Becoming.Transactions.Approvals} {loaded : Becoming.Actuation.State},
  Becoming.Transactions.gate roster rf af w p reads approvals = true →
