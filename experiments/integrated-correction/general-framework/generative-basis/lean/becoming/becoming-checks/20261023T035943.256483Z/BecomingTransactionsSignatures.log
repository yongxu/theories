Becoming.Transactions.execute_exact : ∀ (roster : List Becoming.FaultEnvelopes.Domain)
  (rf af : Becoming.FaultEnvelopes.Envelope) (w : Becoming.Transactions.Installation)
  (p : Becoming.Transactions.Request) (reads : Becoming.Transactions.Readings)
  (approvals : Becoming.Transactions.Approvals),
  Becoming.Transactions.gate roster rf af w p reads approvals = true →
    Becoming.TreeSearch.locate w.root p.address = some p.key →
      Becoming.Transactions.load roster p + 3 ≤ w.state.reserve →
        w.state.time + Becoming.Transactions.load roster p + 3 ≤ w.state.deadline →
          (Becoming.Transactions.execute roster rf af w p reads approvals).succeeded = true ∧
            (Becoming.Transactions.execute roster rf af w p reads approvals).installation.state.completed = true ∧
              (Becoming.Transactions.execute roster rf af w p reads approvals).installation.serial = w.serial + 1 ∧
                (Becoming.Transactions.execute roster rf af w p reads approvals).installation.state.drawn =
                  w.state.drawn + (Becoming.Transactions.load roster p + 3)
