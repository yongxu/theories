@Becoming.Transactions.succeeded_gate : ∀ {roster : List Becoming.FaultEnvelopes.Domain}
  {rf af : Becoming.FaultEnvelopes.Envelope} {w : Becoming.Transactions.Installation}
  {p : Becoming.Transactions.Request} {reads : Becoming.Transactions.Readings}
