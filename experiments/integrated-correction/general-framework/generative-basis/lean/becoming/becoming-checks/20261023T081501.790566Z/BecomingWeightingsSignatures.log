@Becoming.Flow.coupled_ending_ranked_below : ∀ {Pos X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {G : Becoming.SelectionTerm.Generations X},
          Becoming.SelectionTerm.Flow.Descended L W G →
            ∀ {ds : List X} {m : Nat},
              (∀ (t : Nat) (f : X),
                  f ∈ L.present t →
                    ∀ (d : X), d ∈ ds → 0 < L.give t f d → ∃ e, e ∈ ds ∧ W.requires t f e ∧ m ≤ W.need t f e) →
                ∀ {T n : Nat},
                  (∀ (k : Nat), k < n → L.replenishment ds (T + k) < L.uptake ds (T + k)) →
                    W.stock ds T < n + m →
                      (∀ (k : Nat) (p : X),
                          p ∈ G.family (T + n + k) →
                            ∃ e, e ∈ ds ∧ W.requires (T + n + k) p e ∧ m ≤ W.need (T + n + k) p e) →
                        ∀ {items : List (Nat × X)} {a b : Nat × X → Bool},
                          (∀ (x : Nat × X), x ∈ items → b x = true → x.snd ∈ G.family x.fst) →
                            (∀ (x : Nat × X), x ∈ items → x.fst ≤ T + n → a x = b x) →
                              ∀ {own : Pos → Nat × X → Bool} (p : Pos),
                                Becoming.Weighting.AddsOwn items (own p) a b →
                                  ∀ (R : (Nat × X → Bool) → (Nat × X → Bool) → Prop),
                                    Becoming.Weighting.IncreasingInOwn items (own p) R → R b a
