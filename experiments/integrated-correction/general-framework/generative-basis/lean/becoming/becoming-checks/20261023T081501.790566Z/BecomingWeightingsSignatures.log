@Becoming.Flow.feedsAlone_iff : ∀ {F C : Type} [DecidableEq F] [DecidableEq C] {W : Becoming.Web F C}
  {cap : Nat → F → Nat} {cs : List C},
  Becoming.Distinct cs →
    ∀ {c₀ : C},
      c₀ ∈ cs →
        ∀ {K : F → Prop} {T n : Nat} {f g : F},
          ¬K f →
            K g →
              (∀ (t : Nat), T ≤ t → t < T + n → W.active t f) →
                W.stock cs T < n →
                  ((∃ L,
                      Becoming.Flow.FedOnlyWithin W cap cs K T n L ∧
                        Becoming.Flow.DrawsPast cs T n (L, W) f ∧
                          Becoming.Flow.GivesWithin cs T n (L, W) g ∧
                            ∀ (h : F), K h → Becoming.Flow.GivesWithin cs T n (L, W) h → h = g) ↔
                    W.CanFeedAlone cap cs T n g)
@Becoming.Flow.partAlone_within_iff : ∀ {F C : Type} [DecidableEq F] [DecidableEq C] {W : Becoming.Web F C}
  {cap : Nat → F → Nat} {cs : List C},
  Becoming.Distinct cs →
    ∀ {c₀ : C},
      c₀ ∈ cs →
        ∀ {K : F → Prop} {T n : Nat} {f : F},
          ¬K f →
            (∀ (t : Nat), T ≤ t → t < T + n → W.active t f) →
              W.stock cs T < n →
                (Becoming.PartAlone (Becoming.Flow.FedOnlyWithin W cap cs K T n)
                    (fun L => Becoming.Flow.DrawsPast cs T n (L, W)) (fun L => Becoming.Flow.GivesWithin cs T n (L, W))
                    f K ↔
                  ∀ (g : F), K g → W.CanFeedAlone cap cs T n g)
@Becoming.Flow.needs_giver_iff_only_within : ∀ {F C : Type} [DecidableEq F] [DecidableEq C] {W : Becoming.Web F C}
  {cap : Nat → F → Nat} {cs : List C},
  Becoming.Distinct cs →
    ∀ {c₀ : C},
      c₀ ∈ cs →
        ∀ {K : F → Prop} {T n : Nat} {f g : F},
          ¬K f →
            (∀ (t : Nat), T ≤ t → t < T + n → W.active t f) →
              W.stock cs T < n →
                (∀ (g : F), K g → W.CanFeedAlone cap cs T n g) →
                  K g →
                    (Becoming.NeedsPart (Becoming.Flow.FedOnlyWithin W cap cs K T n)
                        (fun L => Becoming.Flow.DrawsPast cs T n (L, W))
                        (fun L => Becoming.Flow.GivesWithin cs T n (L, W)) f g ↔
                      ∀ (h : F), K h → h = g)
@Becoming.Flow.needs_giver_of_short : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C} {ks : List F}
