  Becoming.Weighting.ConcaveTo n f → ∀ (a d : Nat), a + d + 2 ≤ n → f a + f (a + d + 2) < f (a + 1) + f (a + d + 1)
@Becoming.Weighting.prior_transfer : ∀ {F : Type} {n : Nat} {f : Nat → Nat},
  Becoming.Weighting.ConcaveTo n f →
    ∀ {g h : F} {rest : List F} {L L' : F → Nat} (a d : Nat),
      a + d + 2 ≤ n →
        L g = a + 1 →
          L h = a + d + 1 →
            L' g = a →
              L' h = a + d + 2 →
                (∀ (k : F), k ∈ rest → L k = L' k) →
                  (Becoming.total (g :: h :: rest) fun k => f (L' k)) < Becoming.total (g :: h :: rest) fun k => f (L k)
@Becoming.Weighting.sufficient_ties : ∀ {F : Type} {θ : Nat} {f : Nat → Nat},
  Becoming.Weighting.SufficientAt θ f →
    ∀ {gs : List F} {L L' : F → Nat},
      (∀ (k : F), k ∈ gs → L k = L' k ∨ θ ≤ L k ∧ θ ≤ L' k) →
        (Becoming.total gs fun k => f (L k)) = Becoming.total gs fun k => f (L' k)
Becoming.Partial.cond_pos : ∀ (v : Bool), 0 < bif v then 2 else 1
Becoming.Partial.standing : Becoming.Weighting.StandingInvariant Becoming.Partial.grade
Becoming.Partial.not_gradeInvariant : ¬Becoming.Weighting.GradeInvariant Becoming.Partial.grade
Becoming.Partial.ranks_differ : ((Becoming.Weighting.weighed [true, false] (Becoming.Partial.grade true) fun x => !x) <
    Becoming.Weighting.weighed [true, false] (Becoming.Partial.grade true) fun x => x) ∧
  (Becoming.Weighting.weighed [true, false] (Becoming.Partial.grade false) fun x => x) <
    Becoming.Weighting.weighed [true, false] (Becoming.Partial.grade false) fun x => !x
Becoming.LevelTransfer.mixed : Becoming.Weighting.MixedOn Becoming.LevelTransfer.items Becoming.LevelTransfer.even
  Becoming.LevelTransfer.uneven
Becoming.LevelTransfer.concave_to : Becoming.Weighting.ConcaveTo 3 Becoming.LevelTransfer.concave
Becoming.LevelTransfer.by_law : Becoming.Weighting.prior [false, true] Becoming.LevelTransfer.owner
    Becoming.LevelTransfer.items Becoming.LevelTransfer.concave Becoming.LevelTransfer.uneven <
  Becoming.Weighting.prior [false, true] Becoming.LevelTransfer.owner Becoming.LevelTransfer.items
    Becoming.LevelTransfer.concave Becoming.LevelTransfer.even
Becoming.LevelTransfer.decided : Becoming.Weighting.prior [true, false] Becoming.LevelTransfer.owner
      Becoming.LevelTransfer.items Becoming.LevelTransfer.concave Becoming.LevelTransfer.uneven <
    Becoming.Weighting.prior [true, false] Becoming.LevelTransfer.owner Becoming.LevelTransfer.items
      Becoming.LevelTransfer.concave Becoming.LevelTransfer.even ∧
  Becoming.Weighting.prior [true, false] Becoming.LevelTransfer.owner Becoming.LevelTransfer.items (fun k => k)
        Becoming.LevelTransfer.uneven =
      Becoming.Weighting.prior [true, false] Becoming.LevelTransfer.owner Becoming.LevelTransfer.items (fun k => k)
        Becoming.LevelTransfer.even ∧
    Becoming.Weighting.prior [true, false] Becoming.LevelTransfer.owner Becoming.LevelTransfer.items (fun k => k * k)
        Becoming.LevelTransfer.even <
      Becoming.Weighting.prior [true, false] Becoming.LevelTransfer.owner Becoming.LevelTransfer.items (fun k => k * k)
        Becoming.LevelTransfer.uneven
Becoming.Framed.increasing : Becoming.Weighting.IncreasingAt [()]
  (Becoming.Weighting.ranksNet [()] (fun x => 1) fun x => 0) ()
Becoming.Framed.widensBy : Becoming.Weighting.WidensBy [()] () (Becoming.Framed.kept (true, false))
  (Becoming.Framed.kept (false, true))
Becoming.Framed.framing_alone : Becoming.Framed.ranks (true, false) (false, true) ∧
  ¬Becoming.Weighting.ReadsSetsOn Becoming.Framed.kept Becoming.Framed.ranks
      (Becoming.Weighting.ranksNet [()] (fun x => 1) fun x => 0) (true, false) (false, true)
@Becoming.Interacting.eq_true_of_not_false : ∀ {v : Bool}, (!v) = false → v = true
Becoming.Interacting.alone : Becoming.Weighting.WidensBy Becoming.Interacting.items true Becoming.Interacting.onlyTrue
  Becoming.Interacting.neither
Becoming.Interacting.jointly : Becoming.Weighting.WidensBy Becoming.Interacting.items true Becoming.Interacting.both
  Becoming.Interacting.onlyFalse
Becoming.Interacting.increment_differs : Becoming.Weighting.IncrementIs Becoming.Interacting.order
    Becoming.Interacting.neither Becoming.Interacting.onlyTrue Ordering.gt ∧
  Becoming.Weighting.IncrementIs Becoming.Interacting.order Becoming.Interacting.onlyFalse Becoming.Interacting.both
    Ordering.lt
Becoming.Interacting.not_net : ¬∃ pos neg,
    ∀ (b a : Bool → Bool),
      Becoming.Interacting.order b a ↔ Becoming.Weighting.ranksNet Becoming.Interacting.items pos neg b a
