  (∀ (x : X), x ∈ items → a x = true → b x = false → neg x < pos x) →
    Becoming.Weighting.WidensOn items a b → Becoming.Weighting.ranksNet items pos neg b a
Becoming.Weighting.cond_zero : ∀ (v : Bool), (bif v then 0 else 0) = 0
@Becoming.Weighting.weighed_zero : ∀ {X : Type} (items : List X) (a : X → Bool),
  Becoming.Weighting.weighed items (fun x => 0) a = 0
@Becoming.Weighting.weighed_lt_of_widens : ∀ {X : Type} {items : List X} {a b : X → Bool} {w : X → Nat},
