@Becoming.Weighting.weighed_beyond_of_includes : ∀ {X : Type} {items : List X} {a b : X → Bool} (w : X → Nat),
  Becoming.Weighting.IncludesOn items a b → Becoming.Weighting.weighed items w (Becoming.Weighting.beyond b a) = 0
