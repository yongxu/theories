@Becoming.Weighting.size_widensBy_pos : ∀ {X : Type} {items : List X} {x : X} {a b : X → Bool},
  Becoming.Weighting.WidensBy items x a b → 0 < Becoming.Weighting.size items (Becoming.Weighting.beyond a b)
@Becoming.Weighting.ranksNet_widensBy : ∀ {X : Type} {items : List X} {pos neg : X → Nat} {x : X} {a b : X → Bool},
