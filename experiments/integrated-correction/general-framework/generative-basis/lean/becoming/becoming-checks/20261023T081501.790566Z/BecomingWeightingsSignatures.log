@Becoming.Weighting.ranksNet_increasingAt : ∀ {X : Type} {items : List X} {pos neg : X → Nat} {x : X},
  neg x < pos x → Becoming.Weighting.IncreasingAt items (Becoming.Weighting.ranksNet items pos neg) x
@Becoming.Weighting.increment_transfer : ∀ {X : Type} {O O' : (X → Bool) → (X → Bool) → Prop} {a b a' b' : X → Bool},
