                      d ∈ ds ∧ d ≠ c ∧ W.Falls t d ∧ g ∈ L.present t ∧ W.active t g ∧ W.draws t g d ∧ 0 < L.take t g d
Becoming.Frontier.burns : ∀ (n t : Nat),
  Becoming.Frontier.unburnt n (t + 1) + Becoming.Frontier.burning n t = Becoming.Frontier.unburnt n t
Becoming.Frontier.burning_self : ∀ (n : Nat), Becoming.Frontier.burning n n = 1
Becoming.Frontier.burning_at : ∀ (n t : Nat), 0 < Becoming.Frontier.burning n t → n = t
Becoming.Frontier.growers_take : ∀ (t n : Nat),
  (Becoming.total (Becoming.Frontier.growers n) fun f =>
      Becoming.Frontier.flow.take t f Becoming.Frontier.Condition.pool) =
    n
Becoming.Frontier.growers_give : ∀ (t : Nat) (c : Becoming.Frontier.Condition) (n : Nat),
  (Becoming.total (Becoming.Frontier.growers n) fun f => Becoming.Frontier.flow.give t f c) = 0
Becoming.Frontier.growers_take_fuel : ∀ (t m n : Nat),
  (Becoming.total (Becoming.Frontier.growers n) fun f =>
      Becoming.Frontier.flow.take t f (Becoming.Frontier.Condition.fuel m)) =
    0
Becoming.Frontier.balances : Becoming.Frontier.flow.Balances Becoming.Frontier.web
Becoming.Frontier.dissipative : Becoming.Frontier.flow.Dissipative
Becoming.Frontier.takers_pool : ∀ (t : Nat), Becoming.Frontier.flow.takers [Becoming.Frontier.Condition.pool] t = t
Becoming.Frontier.more : Becoming.Frontier.flow.More [Becoming.Frontier.Condition.pool]
@Becoming.Frontier.frontier : ∀ {ds : List Becoming.Frontier.Condition},
  Becoming.Distinct ds →
    Becoming.Frontier.Condition.pool ∈ ds → ∀ (T : Nat), ¬∀ (t : Nat), T ≤ t → Becoming.Frontier.flow.ClosedAt ds t
Becoming.Frontier.closed : ∀ (t : Nat),
  Becoming.Frontier.flow.ClosedAt [Becoming.Frontier.Condition.pool, Becoming.Frontier.Condition.fuel t] t
Becoming.Frontier.pool_fuel_distinct : ∀ (t : Nat),
  Becoming.Distinct [Becoming.Frontier.Condition.pool, Becoming.Frontier.Condition.fuel t]
Becoming.Frontier.enclosed : ∀ (t : Nat), Becoming.Frontier.flow.Enclosed t
Becoming.Frontier.around : ∀ (t : Nat), Becoming.Frontier.flow.Around [Becoming.Frontier.Condition.pool] t
Becoming.Frontier.draws_in : ∀ (N : Nat),
  ¬∀ (t : Nat), N ≤ t → Becoming.Frontier.flow.Inward [Becoming.Frontier.Condition.pool] t
Becoming.Frontier.gives_without_taking : Becoming.Frontier.flow.Dissipative ∧
  ∀ (t : Nat),
    0 <
        Becoming.total [Becoming.Frontier.Condition.pool]
          (Becoming.Frontier.flow.give (t + 1) Becoming.Frontier.Formation.source) ∧
      Becoming.total [Becoming.Frontier.Condition.pool]
          (Becoming.Frontier.flow.take (t + 1) Becoming.Frontier.Formation.source) =
        0
Becoming.Rooted.balances : Becoming.Frontier.flow.Balances Becoming.Rooted.web
Becoming.Rooted.growers_lt : ∀ (t i : Nat), Becoming.Frontier.Formation.grower i ∈ Becoming.Frontier.growers t → i < t
Becoming.Rooted.growers_listed : ∀ (t i : Nat),
  i < t → Becoming.Frontier.Formation.grower i ∈ Becoming.Frontier.growers t
Becoming.Rooted.growers_distinct : ∀ (t : Nat), Becoming.Distinct (Becoming.Frontier.growers t)
Becoming.Rooted.source_fresh : ∀ (t : Nat), ¬Becoming.Frontier.Formation.source ∈ Becoming.Frontier.growers t
Becoming.Rooted.present_distinct : ∀ (t : Nat), Becoming.Distinct (Becoming.Frontier.flow.present t)
Becoming.Rooted.census : Becoming.Rooted.web.Census Becoming.Frontier.flow.present
Becoming.Rooted.burning_pos : ∀ (n t : Nat), 0 < (n + 1) * Becoming.Frontier.burning n t → n = t
Becoming.Rooted.taking : Becoming.Frontier.flow.Taking Becoming.Rooted.web
Becoming.Rooted.acting : Becoming.Frontier.flow.Acting Becoming.Rooted.web
Becoming.Rooted.dependent : Becoming.Rooted.web.Dependent
Becoming.Rooted.arises_taking : ∀ (t : Nat),
  Becoming.Frontier.flow.ArisesTaking Becoming.Rooted.web [Becoming.Frontier.Condition.pool] t
    (Becoming.Frontier.Formation.grower t)
Becoming.Rooted.rooted : Becoming.Frontier.flow.Balances Becoming.Rooted.web ∧
  Becoming.Frontier.flow.Acting Becoming.Rooted.web ∧
    Becoming.Frontier.flow.Taking Becoming.Rooted.web ∧
      Becoming.Rooted.web.Dependent ∧
        Becoming.Rooted.web.Census Becoming.Frontier.flow.present ∧
          Becoming.Frontier.flow.Dissipative ∧
            Becoming.Frontier.flow.More [Becoming.Frontier.Condition.pool] ∧
              Becoming.Rooted.web.Unceasing ∧
                ∀ {ds : List Becoming.Frontier.Condition},
                  Becoming.Distinct ds →
                    Becoming.Frontier.Condition.pool ∈ ds →
                      ∀ (T : Nat), ¬∀ (t : Nat), T ≤ t → Becoming.Frontier.flow.ClosedAt ds t
Becoming.Lone.balances : Becoming.Lone.flow.Balances Becoming.Lone.web
Becoming.Lone.dissipative : Becoming.Lone.flow.Dissipative
Becoming.Lone.lone : Becoming.Lone.flow.Balances Becoming.Lone.web ∧
  Becoming.Lone.flow.Dissipative ∧
    (∀ (t : Nat), Becoming.Lone.flow.takers [Becoming.Frontier.Condition.pool] t = 1) ∧
      (∀ (t : Nat) (f : Becoming.Lone.Formation), ¬Becoming.Lone.web.Arises t f) ∧
        ¬Becoming.Lone.flow.More [Becoming.Frontier.Condition.pool]
@Becoming.Lone.frontier : ∀ {ds : List Becoming.Frontier.Condition},
  Becoming.Distinct ds →
    Becoming.Frontier.Condition.pool ∈ ds → ∀ (T : Nat), ¬∀ (t : Nat), T ≤ t → Becoming.Lone.flow.ClosedAt ds t
Becoming.Lone.closed : ∀ (t : Nat),
  Becoming.Lone.flow.ClosedAt [Becoming.Frontier.Condition.pool, Becoming.Frontier.Condition.fuel t] t
Becoming.Lone.enclosed : ∀ (t : Nat), Becoming.Lone.flow.Enclosed t
Becoming.Lone.draws_in : ∀ (N : Nat),
  ¬∀ (t : Nat), N ≤ t → Becoming.Lone.flow.Inward [Becoming.Frontier.Condition.pool] t
Becoming.Lone.repeated_family : ∀ (t : Nat),
  Becoming.Lone.flow.ClosedAt
      [Becoming.Frontier.Condition.pool, Becoming.Frontier.Condition.pool, Becoming.Frontier.Condition.fuel t] t ∧
    Becoming.Lone.Formation.source ∈ Becoming.Lone.flow.present t ∧
      Becoming.total
            [Becoming.Frontier.Condition.pool, Becoming.Frontier.Condition.pool, Becoming.Frontier.Condition.fuel t]
            (Becoming.Lone.flow.give t Becoming.Lone.Formation.source) =
          2 ∧
        Becoming.total
            [Becoming.Frontier.Condition.pool, Becoming.Frontier.Condition.pool, Becoming.Frontier.Condition.fuel t]
            (Becoming.Lone.flow.take t Becoming.Lone.Formation.source) =
          2
Becoming.Spray.fresh : ∀ (cs : List Nat), ¬(Becoming.total cs fun c => c) + 1 ∈ cs
Becoming.Spray.unenclosed : ∀ (t : Nat), ¬Becoming.Spray.flow.Enclosed t
Becoming.Spray.dissipative : Becoming.Spray.flow.Dissipative
Becoming.Spray.spray : Becoming.Spray.flow.Balances Becoming.Spray.web ∧
  Becoming.Spray.flow.Acting Becoming.Spray.web ∧
    Becoming.Spray.flow.Taking Becoming.Spray.web ∧
      Becoming.Spray.web.Dependent ∧
        Becoming.Spray.flow.Dissipative ∧
          (∀ (t : Nat), ¬Becoming.Spray.flow.Enclosed t) ∧
            (∀ (t : Nat),
                0 < Becoming.Spray.flow.give t Becoming.Spray.Formation.renewer 0 ∧
                  ∀ (c : Nat), Becoming.Spray.flow.take t Becoming.Spray.Formation.renewer c = 0) ∧
              ∀ (t : Nat), 0 < Becoming.Spray.flow.takers [0] t
@Becoming.Flow.Dissipative.one_taking_not_recurring : ∀ {F : Type} {L : Becoming.Flow F Unit} {W : Becoming.Web F Unit},
  L.Balances W → L.Dissipative → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < L.takers [()] t
Becoming.witnesses_not_dissipative : ¬Becoming.Expansion.flow.Dissipative ∧
  ¬Becoming.Cycle.flow.Dissipative ∧
    ¬Becoming.Pulse.flow.Dissipative ∧
      ¬Becoming.Steady.flow.Dissipative ∧ ¬Becoming.Repeated.flow.Dissipative ∧ ¬Becoming.Oscillation.flow.Dissipative
