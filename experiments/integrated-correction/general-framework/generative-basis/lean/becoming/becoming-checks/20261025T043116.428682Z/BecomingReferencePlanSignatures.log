Becoming.ReferencePlan.constant_channel_rejected : Becoming.ReferencePlan.repair 3
    (have __src := Becoming.ReferencePlan.failedFirst;
    { channel := fun x x_1 => false, method := __src.method, mismatch := __src.mismatch, pending := __src.pending,
      fresh := __src.fresh, installed := __src.installed, building := __src.building, fuel := __src.fuel,
      used := __src.used, response := __src.response }) =
