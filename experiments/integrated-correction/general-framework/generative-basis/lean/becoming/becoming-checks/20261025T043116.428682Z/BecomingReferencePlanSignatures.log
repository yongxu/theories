Becoming.ReferencePlan.constant_channel_contacts_use_fuel : Option.map
    (fun s => (s.fuel, s.used, Becoming.ReferencePlan.valid s.fresh, s.installed))
    (Becoming.ReferencePlan.repair 2
      (have __src := Becoming.ReferencePlan.failedFirst;
