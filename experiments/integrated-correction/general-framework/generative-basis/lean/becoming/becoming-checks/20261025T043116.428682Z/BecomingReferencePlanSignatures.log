Becoming.ReferencePlan.balanced : Becoming.Stock.Balanced Becoming.ReferencePlan.P Becoming.ReferencePlan.State.fuel
  Becoming.ReferencePlan.use fun x => 0
Becoming.ReferencePlan.used_balanced : Becoming.Stock.Balanced Becoming.ReferencePlan.P
  Becoming.ReferencePlan.State.used (fun x => 0) Becoming.ReferencePlan.use
Becoming.ReferencePlan.draws_held : Becoming.Stock.DrawsHeld Becoming.ReferencePlan.P Becoming.ReferencePlan.State.fuel
  Becoming.ReferencePlan.use
@Becoming.ReferencePlan.trace_conserves : ∀ {s t : Becoming.ReferencePlan.State} {as : List Becoming.ReferencePlan.Act},
  Generative.Trace Becoming.ReferencePlan.P s as t → t.fuel + t.used = s.fuel + s.used
@Becoming.ReferencePlan.covered : ∀ {s t : Becoming.ReferencePlan.State} {as : List Becoming.ReferencePlan.Act},
  Generative.Trace Becoming.ReferencePlan.P s as t →
    Becoming.Stock.Covered Becoming.ReferencePlan.use (fun x => 0) s.fuel as
Becoming.ReferencePlan.propose_answers : Becoming.Contacts.Answers Becoming.ReferencePlan.propose
Becoming.ReferencePlan.revise_registers_failure : ∀ (m : List Nat) (i : Nat),
  Becoming.Learning.Training.Through (Becoming.ReferencePlan.AgreeOn (Becoming.ReferencePlan.propose m (some i)))
    fun x => x i = true
Becoming.ReferencePlan.frozen_reads_method : ∀ (s : Becoming.ReferencePlan.State),
  Option.map Becoming.ReferencePlan.State.pending (Becoming.ReferencePlan.operate s Becoming.ReferencePlan.Act.frozen) =
    some (Becoming.ReferencePlan.frozenRule s.method s.mismatch)
Becoming.ReferencePlan.frozen_blind : Becoming.Contacts.Blind Becoming.ReferencePlan.frozenRule
Becoming.ReferencePlan.frozen_misses : ∀ (m : List Nat),
  ∃ i,
    ¬Becoming.Learning.Training.Through (Becoming.ReferencePlan.AgreeOn (Becoming.ReferencePlan.frozenRule m (some i)))
        fun x => x i = true
Becoming.ReferencePlan.flip_is_pick : ∀ (c : Bool → Bool) (b : Bool),
  Becoming.ReferencePlan.flip (c false) b = Becoming.References.pick c false true b
Becoming.ReferencePlan.checked_pair_iff : ∀ (c : Bool → Bool),
  (∀ (target : Bool), c (Becoming.ReferencePlan.flip (c false) target) = target) ↔ c false ≠ c true
Becoming.ReferencePlan.drift_fails : ∀ (c : Bool → Bool),
  c false ≠ c true → ∀ (b : Bool), (fun x => !c x) (Becoming.ReferencePlan.flip (c false) b) ≠ b
