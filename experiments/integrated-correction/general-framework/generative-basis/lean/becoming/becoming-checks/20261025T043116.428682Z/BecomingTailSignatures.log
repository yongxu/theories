Becoming.vanishesFrom_true : ∀ (decides : (s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false)) {α : Nat → Nat}
  {N : Nat}, Becoming.vanishesFrom decides α N = true → ∀ (m : Nat), N ≤ m → α m = 0
Becoming.vanishesFrom_of : ∀ (decides : (s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false)) {α : Nat → Nat}
  {N : Nat}, (∀ (m : Nat), N ≤ m → α m = 0) → Becoming.vanishesFrom decides α N = true
Becoming.vanishesFrom_never_iff : ∀ (decides : (s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false)) {α : Nat → Nat},
  (∀ (N : Nat), Becoming.vanishesFrom decides α N = false) ↔ ¬Becoming.VanishFrom α
Becoming.neverIndicator_eq_one : ∀ (decides : (s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false)) {α : Nat → Nat},
  ¬Becoming.VanishFrom α → Becoming.neverIndicator decides α = 1
Becoming.neverIndicator_eq_zero : ∀ (decides : (s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false)) {α : Nat → Nat},
  Becoming.VanishFrom α → Becoming.neverIndicator decides α = 0
Becoming.neverIndicator_eq_of_agree : ∀ (decides : (s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false))
  {α β : Nat → Nat} (n : Nat),
  (∀ (m : Nat), n ≤ m → α m = β m) → Becoming.neverIndicator decides α = Becoming.neverIndicator decides β
Becoming.neverIndicator_changedByNoCondition : ∀ (decides : (s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false)),
  Becoming.ChangedByNoCondition (Becoming.neverIndicator decides)
Becoming.neverIndicator_zeros : ∀ (decides : (s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false)),
  (Becoming.neverIndicator decides fun x => 0) = 0
Becoming.neverIndicator_ones : ∀ (decides : (s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false)),
  (Becoming.neverIndicator decides fun x => 1) = 1
Becoming.neverIndicator_add_vanishIndicator : ∀ (decides : (s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false))
  (vanishDecides : (α : Nat → Nat) → Decidable (Becoming.VanishFrom α)) (α : Nat → Nat),
  Becoming.neverIndicator decides α + Becoming.vanishIndicator vanishDecides α = 1
Becoming.neverLaw_nonanticipating : ∀ (decides : (s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false)),
  (Becoming.neverLaw decides).Nonanticipating
Becoming.neverLaw_insensitive : ∀ (decides : (s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false)) (t c : Nat),
  (Becoming.neverLaw decides).InsensitiveAt t () c
Becoming.neverLaw_not_sensitive : ∀ (decides : (s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false)) (c : Nat),
  ¬(Becoming.neverLaw decides).Sensitive () c
Becoming.neverLaw_differs : ∀ (decides : (s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false)) (t c : Nat),
  (Becoming.neverLaw decides).take t () (fun x x_1 => 0) c ≠ (Becoming.neverLaw decides).take t () (fun x x_1 => 1) c
Becoming.changedByNoCondition_iff_rule : (∃ f, Becoming.ChangedByNoCondition f ∧ ∃ α β, f α ≠ f β) ↔
  Nonempty ((s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false))
Becoming.insensitive_differs_iff_rule : (∃ F law t h l l' c,
    (∀ (e : Nat), law.InsensitiveAt t h e) ∧
      ¬(law.take t h l c = law.take t h l' c ∧ law.give t h l c = law.give t h l' c)) ↔
  Nonempty ((s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false))
Becoming.not_through_sensitive_iff_rule : (∃ F law t h l l' c,
    law.Nonanticipating ∧
      (∀ (e : Nat), law.Sensitive h e → ∀ (s : Nat), s ≤ t → l s e = l' s e) ∧
        ¬(law.take t h l c = law.take t h l' c ∧ law.give t h l c = law.give t h l' c)) ↔
  Nonempty ((s : Nat → Bool) → Decidable (∀ (n : Nat), s n = false))
Becoming.raisedFrom_false : ∀ (decides : (s : Nat → Bool) → Decidable (∃ n, s n = true)) {α : Nat → Nat} {N : Nat},
  Becoming.raisedFrom decides α N = false → ∀ (m : Nat), N ≤ m → α m = 0
Becoming.raisedFrom_of : ∀ (decides : (s : Nat → Bool) → Decidable (∃ n, s n = true)) {α : Nat → Nat} {N : Nat},
  (∀ (m : Nat), N ≤ m → α m = 0) → Becoming.raisedFrom decides α N = false
