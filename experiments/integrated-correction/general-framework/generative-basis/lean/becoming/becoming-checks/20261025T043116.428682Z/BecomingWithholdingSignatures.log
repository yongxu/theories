    1 Becoming.Withholding.Ring.third
@Becoming.Withholding.Ring.rotate_first : ∀ {s : Becoming.Withholding.Ring → Prop},
  ¬s Becoming.Withholding.Ring.first ∧ s Becoming.Withholding.Ring.second ∧ s Becoming.Withholding.Ring.third →
    Becoming.Withholding.answers Becoming.Withholding.Ring.Waits s Becoming.Withholding.Ring.first ∧
      ¬Becoming.Withholding.answers Becoming.Withholding.Ring.Waits s Becoming.Withholding.Ring.second ∧
        Becoming.Withholding.answers Becoming.Withholding.Ring.Waits s Becoming.Withholding.Ring.third
@Becoming.Withholding.Ring.rotate_second : ∀ {s : Becoming.Withholding.Ring → Prop},
  s Becoming.Withholding.Ring.first ∧ ¬s Becoming.Withholding.Ring.second ∧ s Becoming.Withholding.Ring.third →
    Becoming.Withholding.answers Becoming.Withholding.Ring.Waits s Becoming.Withholding.Ring.first ∧
      Becoming.Withholding.answers Becoming.Withholding.Ring.Waits s Becoming.Withholding.Ring.second ∧
        ¬Becoming.Withholding.answers Becoming.Withholding.Ring.Waits s Becoming.Withholding.Ring.third
@Becoming.Withholding.Ring.rotate_third : ∀ {s : Becoming.Withholding.Ring → Prop},
  s Becoming.Withholding.Ring.first ∧ s Becoming.Withholding.Ring.second ∧ ¬s Becoming.Withholding.Ring.third →
    ¬Becoming.Withholding.answers Becoming.Withholding.Ring.Waits s Becoming.Withholding.Ring.first ∧
      Becoming.Withholding.answers Becoming.Withholding.Ring.Waits s Becoming.Withholding.Ring.second ∧
