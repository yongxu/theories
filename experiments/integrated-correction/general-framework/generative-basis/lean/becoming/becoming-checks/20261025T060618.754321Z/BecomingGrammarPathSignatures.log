@Becoming.«所经必同» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«类» E →
    ∀ {P : α → Bool} {C : α → Prop},
      (∀ (u v : α), P u = true → Becoming.«续» R E u v → P v = false → C v) →
        ∀ {x y : α}, P x = true → P y = false → Becoming.«所及» R E x y → ∃ c, C c ∧ E x c ∧ Becoming.«所及» R E x c
@Becoming.«所经不同则不及» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«类» E →
    ∀ {P : α → Bool} {C : α → Prop},
      (∀ (u v : α), P u = true → Becoming.«续» R E u v → P v = false → C v) →
        ∀ {x y : α}, P x = true → P y = false → (∀ (c : α), C c → ¬E x c) → ¬Becoming.«所及» R E x y
@Becoming.«有常则至终有常» : ∀ {α : Type u_1} {R E : Becoming.«际» α}, Becoming.«有常» R E → Becoming.«至终有常» R E
@Becoming.«亡而网续则不至终有常» : ∀ {α : Type u_1} {R E : Becoming.«际» α} {x y : α},
  Becoming.«续» R E x y → Becoming.«亡» R E y → (∃ w, R y w) → ¬Becoming.«至终有常» R E
@Becoming.«至终常闭则所缘同类» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«类» E →
    Becoming.«至终有常» R E → ∀ {m : α}, (∃ w, R m w) → Becoming.«所缘同于» R E m → ∀ {u v : α}, E u m → R u v → E v m
@Becoming.«至终常闭则后皆续» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«类» E →
    Becoming.«至终有常» R E →
      ∀ {m : α},
        (∃ w, R m w) → Becoming.«所缘同于» R E m → ∀ {c t : α}, E c m → Becoming.«及» R c t → E t m ∧ Becoming.«相续» R E c t
@Becoming.«有常则同类者有所缘» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«有常» R E → ∀ {c m v : α}, E c m → R c v → ∃ w, R m w
@Becoming.«常闭则所缘同类» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«类» E → Becoming.«有常» R E → ∀ {m : α}, Becoming.«所缘同于» R E m → ∀ {u v : α}, E u m → R u v → E v m
@Becoming.«常闭则后皆续» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«类» E →
    Becoming.«有常» R E →
      ∀ {m : α}, Becoming.«所缘同于» R E m → ∀ {c t : α}, E c m → Becoming.«及» R c t → E t m ∧ Becoming.«相续» R E c t
@Becoming.«至终常闭则所及皆及» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«类» E →
    Becoming.«至终有常» R E →
      ∀ {m x c t : α},
        (∃ w, R m w) →
          Becoming.«所缘同于» R E m → Becoming.«所及» R E x c → E c m → Becoming.«及» R c t → Becoming.«所及» R E x t
@Becoming.«常闭则所及皆及» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«类» E →
    Becoming.«有常» R E →
      ∀ {m x c t : α},
        Becoming.«所缘同于» R E m → Becoming.«所及» R E x c → E c m → Becoming.«及» R c t → Becoming.«所及» R E x t
@Becoming.«至终常类之闭当且仅当后皆同类» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«类» E → Becoming.«至终有常» R E → ∀ {m : α}, Becoming.«所缘同于» R E m ↔ ∀ (t : α), Becoming.«及» R m t → E m t
@Becoming.«常类之闭当且仅当后皆同类» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«类» E → Becoming.«有常» R E → ∀ {m : α}, Becoming.«所缘同于» R E m ↔ ∀ (t : α), Becoming.«及» R m t → E m t
