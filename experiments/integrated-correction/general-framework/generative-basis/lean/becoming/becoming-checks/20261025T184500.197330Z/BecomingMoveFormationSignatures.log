@Becoming.Run.part_act_eq_rest_act : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A} (r : Becoming.Run (Becoming.coupled P Q form)) (n : Nat),
  r.part.act n = r.rest.act n
