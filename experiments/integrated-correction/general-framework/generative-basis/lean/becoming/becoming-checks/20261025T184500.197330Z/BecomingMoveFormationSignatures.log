  Becoming.RestForms fun x => r.act x.snd
@Becoming.Run.moves_lasso_of_rest_held : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A} (r : Becoming.Run (Becoming.coupled P Q form)) {G : E → A → E},
  (∀ (e : E) (a : A) (e' : E), Q.step e a e' → e' = G e a) →
    ∀ {input : E → A},
      (∀ (x : S × E), form x = input x.snd) →
        ∀ {l : List E},
          (∀ (n : Nat), (r.state n).snd ∈ l) →
            ∃ i q, i + q + 1 ≤ l.length ∧ Becoming.Learning.Lasso (fun n => form (r.state n)) i q
@Becoming.Run.moves_lasso_of_part_held : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A} (r : Becoming.Run (Becoming.coupled P Q form)) {F : S → A → S},
  (∀ (s : S) (a : A) (s' : S), P.step s a s' → s' = F s a) →
    ∀ {policy : S → A},
      (∀ (x : S × E), form x = policy x.fst) →
        ∀ {l : List S},
          (∀ (n : Nat), (r.state n).fst ∈ l) →
            ∃ i q, i + q + 1 ≤ l.length ∧ Becoming.Learning.Lasso (fun n => form (r.state n)) i q
@Becoming.Run.moves_lasso_of_whole_held : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A} (r : Becoming.Run (Becoming.coupled P Q form)) {F : S → A → S}
  {G : E → A → E},
  (∀ (s : S) (a : A) (s' : S), P.step s a s' → s' = F s a) →
    (∀ (e : E) (a : A) (e' : E), Q.step e a e' → e' = G e a) →
      ∀ {l : List (S × E)},
        (∀ (n : Nat), r.state n ∈ l) →
          ∃ i q, i + q + 1 ≤ l.length ∧ Becoming.Learning.Lasso (fun n => form (r.state n)) i q
@Becoming.Run.whole_unheld_of_never_cycles : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A} (r : Becoming.Run (Becoming.coupled P Q form)) {F : S → A → S}
  {G : E → A → E},
  (∀ (s : S) (a : A) (s' : S), P.step s a s' → s' = F s a) →
    (∀ (e : E) (a : A) (e' : E), Q.step e a e' → e' = G e a) →
      (∀ (i q : Nat), ¬Becoming.Learning.Lasso (fun n => form (r.state n)) i q) →
        ∀ (l : List (S × E)), ¬∀ (n : Nat), r.state n ∈ l
@Becoming.Run.rest_unheld_of_never_cycles : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A} (r : Becoming.Run (Becoming.coupled P Q form)) {G : E → A → E},
  (∀ (e : E) (a : A) (e' : E), Q.step e a e' → e' = G e a) →
    ∀ {input : E → A},
      (∀ (x : S × E), form x = input x.snd) →
        (∀ (i q : Nat), ¬Becoming.Learning.Lasso (fun n => form (r.state n)) i q) →
          ∀ (l : List E), ¬∀ (n : Nat), (r.state n).snd ∈ l
@Becoming.Run.part_unheld_of_never_cycles : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A} (r : Becoming.Run (Becoming.coupled P Q form)) {F : S → A → S},
  (∀ (s : S) (a : A) (s' : S), P.step s a s' → s' = F s a) →
    ∀ {policy : S → A},
      (∀ (x : S × E), form x = policy x.fst) →
        (∀ (i q : Nat), ¬Becoming.Learning.Lasso (fun n => form (r.state n)) i q) →
