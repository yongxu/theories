  Becoming.Learning.Lumped Prod.fst (Becoming.ExchangeLaw.ofMoves u).policy
Becoming.MoveFormation.alt_ne : ∀ (n : Nat), Becoming.MoveFormation.alt n ≠ Becoming.MoveFormation.alt (n + 1)
Becoming.TwoClocks.one_course_two_laws : (∀ (n : Nat),
    (Becoming.TwoClocks.together Becoming.TwoClocks.byPart).state n =
      (Becoming.TwoClocks.together Becoming.TwoClocks.byRest).state n) ∧
  (∀ (n : Nat),
      Becoming.TwoClocks.byPart ((Becoming.TwoClocks.together Becoming.TwoClocks.byPart).state n) =
        Becoming.TwoClocks.byRest ((Becoming.TwoClocks.together Becoming.TwoClocks.byRest).state n)) ∧
    Becoming.PartForms Becoming.TwoClocks.byPart ∧
      ¬Becoming.RestForms Becoming.TwoClocks.byPart ∧
        Becoming.RestForms Becoming.TwoClocks.byRest ∧
          ¬Becoming.PartForms Becoming.TwoClocks.byRest ∧
            Becoming.TwoClocks.byPart (0, 1) ≠ Becoming.TwoClocks.byRest (0, 1)
