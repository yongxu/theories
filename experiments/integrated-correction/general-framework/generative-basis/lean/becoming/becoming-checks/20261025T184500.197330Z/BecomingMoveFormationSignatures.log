  {i q : Nat} (lasso : Becoming.Learning.Lasso r.act i q) (n : Nat),
  ((r.withLasso lasso).state n).fst = r.state n ∧ (fun x => r.act x.snd) ((r.withLasso lasso).state n) = r.act n
