  {Q : Generative.Process E A} {form : S × E → A},
  Becoming.Determined P → Becoming.PartForms form → Becoming.GoAlike (Becoming.coupled P Q form) Prod.fst
@Becoming.PartForms.parts_agree : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A},
  Becoming.Determined P →
    Becoming.PartForms form →
      ∀ (r r' : Becoming.Run (Becoming.coupled P Q form)),
        (r.state 0).fst = (r'.state 0).fst → ∀ (n : Nat), (r.state n).fst = (r'.state n).fst
@Becoming.Run.part_trajectory : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A} (r : Becoming.Run (Becoming.coupled P Q form)) {F : S → A → S},
  (∀ (s : S) (a : A) (s' : S), P.step s a s' → s' = F s a) →
    ∀ (n : Nat),
      (r.state n).fst =
        Becoming.trajectory (fun s a x => F s a) (r.state 0).fst (fun n => form (r.state n)) (fun x => ()) n
@Becoming.Run.rest_trajectory : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A} (r : Becoming.Run (Becoming.coupled P Q form)) {G : E → A → E},
  (∀ (e : E) (a : A) (e' : E), Q.step e a e' → e' = G e a) →
    ∀ (n : Nat),
      (r.state n).snd =
        Becoming.trajectory (fun e a x => G e a) (r.state 0).snd (fun n => form (r.state n)) (fun x => ()) n
@Becoming.Run.part_orbit : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A} (r : Becoming.Run (Becoming.coupled P Q form)) {F : S → A → S},
  (∀ (s : S) (a : A) (s' : S), P.step s a s' → s' = F s a) →
    ∀ {policy : S → A},
      (∀ (x : S × E), form x = policy x.fst) →
        ∀ (n : Nat), (r.state n).fst = Becoming.Law.orbit (fun s => F s (policy s)) (r.state 0).fst n
