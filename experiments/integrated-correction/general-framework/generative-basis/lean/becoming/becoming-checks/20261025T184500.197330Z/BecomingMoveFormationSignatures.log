@Becoming.Run.withClock_part : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} (r : Becoming.Run P)
  (n : Nat), r.withClock.part.state n = r.state n ∧ r.withClock.part.act n = r.act n
