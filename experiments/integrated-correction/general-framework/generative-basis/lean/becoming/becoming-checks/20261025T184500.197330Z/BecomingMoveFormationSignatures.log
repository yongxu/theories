  {Q : Generative.Process E A} {form : S × E → A}
  {r : Becoming.Run (Becoming.closedBy (Generative.productProcess P Q) form)},
  (r.state 0).snd = form (r.state 0).fst → ∀ (n : Nat), (r.state n).snd = form (r.state n).fst
@Becoming.Run.ofClosedBy_toClosedBy : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A} (r : Becoming.Run (Becoming.coupled P Q form)) (n : Nat),
  (r.toClosedBy.ofClosedBy ⋯).state n = r.state n
@Becoming.coupled_determined : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A},
  Becoming.Determined P → Becoming.Determined Q → Becoming.Determined (Becoming.coupled P Q form)
@Becoming.lumped_id : ∀ {X : Type u_1} {A : Type u_2} (form : X → A), Becoming.Learning.Lumped id form
@Becoming.lumped_of_finer : ∀ {X : Type u_1} {K : Type u_2} {K' : Type u_4} {A : Type u_3} {form : X → A} {π : X → K}
  {π' : X → K'},
  Becoming.Learning.Lumped π form → (∀ (x x' : X), π' x = π' x' → π x = π x') → Becoming.Learning.Lumped π' form
@Becoming.lumped_const_iff : ∀ {X : Type u_1} {K : Type u_2} {A : Type u_3} {form : X → A} (k : K),
  Becoming.Learning.Lumped (fun x => k) form ↔ ∀ (x x' : X), form x = form x'
@Becoming.partForms_iff : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {form : S × E → A} (e₀ : E),
  Becoming.PartForms form ↔ ∀ (x : S × E), form x = form (x.fst, e₀)
@Becoming.restForms_iff : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {form : S × E → A} (s₀ : S),
  Becoming.RestForms form ↔ ∀ (x : S × E), form x = form (s₀, x.snd)
@Becoming.partForms_and_restForms_iff : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {form : S × E → A},
  Becoming.PartForms form ∧ Becoming.RestForms form ↔ ∀ (x x' : S × E), form x = form x'
