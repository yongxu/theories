  {Q : Generative.Process E A} {form : S × E → A} (r : Becoming.Run (Becoming.coupled P Q form)) {G : E → A → E},
  (∀ (e : E) (a : A) (e' : E), Q.step e a e' → e' = G e a) →
    ∀ {input : E → A},
      (∀ (x : S × E), form x = input x.snd) →
        ∀ (n : Nat), (r.state n).snd = Becoming.Law.orbit (fun e => G e (input e)) (r.state 0).snd n
@Becoming.Run.rest_driven_by_part : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A} (r : Becoming.Run (Becoming.coupled P Q form)) {G : E → A → E},
  (∀ (e : E) (a : A) (e' : E), Q.step e a e' → e' = G e a) →
    ∀ {policy : S → A},
      (∀ (x : S × E), form x = policy x.fst) →
        ∀ (n : Nat),
          (r.state n).snd =
            Becoming.trajectory (fun e a x => G e a) (r.state 0).snd (fun n => policy (r.state n).fst) (fun x => ()) n
@Becoming.Run.whole_orbit : ∀ {S : Type u_1} {E : Type u_2} {A : Type u_3} {P : Generative.Process S A}
  {Q : Generative.Process E A} {form : S × E → A} (r : Becoming.Run (Becoming.coupled P Q form)) {F : S → A → S}
  {G : E → A → E},
  (∀ (s : S) (a : A) (s' : S), P.step s a s' → s' = F s a) →
    (∀ (e : E) (a : A) (e' : E), Q.step e a e' → e' = G e a) →
      ∀ (n : Nat), r.state n = Becoming.Law.orbit (Becoming.wholeNext F G form) (r.state 0) n
