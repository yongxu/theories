  (∀ (i : I), R (g i) (m i)) → ∀ {k : K} {a : A}, Becoming.Readout.Reading g m k a → R k a
@Becoming.policyUpto_agrees : ∀ {K : Type u_1} {A : Type u_2} [inst : DecidableEq K] {g : Nat → K} {m : Nat → A} (d : A)
  (N : Nat),
  (∀ (i j : Nat), i < N → j < N → g i = g j → m i = m j) → ∀ (n : Nat), n < N → m n = Becoming.policyUpto g m d N (g n)
@Becoming.lumped_upto_iff : ∀ {K : Type u_1} {A : Type u_2} [DecidableEq K] {g : Nat → K} {m : Nat → A} (N : Nat),
  (∀ (i j : Nat), i < N → j < N → g i = g j → m i = m j) ↔ ∃ policy, ∀ (n : Nat), n < N → m n = policy (g n)
