  Becoming.«迭» R p x x → ∀ (k : Nat), Becoming.«迭» R (p * k) x x
@Becoming.«定后则定后于» : ∀ {α : Type u_1} {R : Becoming.«际» α}, Becoming.«定后» R → ∀ (x : α), Becoming.«定后于» R x
@Becoming.«定后于之后» : ∀ {α : Type u_1} {R : Becoming.«际» α} {x y : α},
  Becoming.«定后于» R x → Becoming.«所闭» R x y → Becoming.«定后于» R y
@Becoming.«迭之定于» : ∀ {α : Type u_1} {R : Becoming.«际» α} (n : Nat) {x y z : α},
  Becoming.«定后于» R x → Becoming.«迭» R n x y → Becoming.«迭» R n x z → y = z
@Becoming.«迭之定» : ∀ {α : Type u_1} {R : Becoming.«际» α},
  Becoming.«定后» R → ∀ (n : Nat) {x y z : α}, Becoming.«迭» R n x y → Becoming.«迭» R n x z → y = z
@Becoming.«迭之定前» : ∀ {α : Type u_1} {R : Becoming.«际» α},
  Becoming.«定前» R → ∀ (n : Nat) {x y z : α}, Becoming.«迭» R n x z → Becoming.«迭» R n y z → x = y
@Becoming.«入当且仅当有不返» : ∀ {α : Type u_1} {R : Becoming.«际» α} {x : α},
  Becoming.«入» R x ↔ ∃ y, Becoming.«及» R x y ∧ ¬Becoming.«及» R y x
@Becoming.«定后于环则所及皆返» : ∀ {α : Type u_1} {R : Becoming.«际» α} {x : α},
  Becoming.«定后于» R x → Becoming.«及» R x x → ∀ {y : α}, Becoming.«及» R x y → Becoming.«及» R y x
@Becoming.«定后环则所及皆返» : ∀ {α : Type u_1} {R : Becoming.«际» α},
  Becoming.«定后» R → ∀ {x : α}, Becoming.«及» R x x → ∀ {y : α}, Becoming.«及» R x y → Becoming.«及» R y x
@Becoming.«定后于则返者不入» : ∀ {α : Type u_1} {R : Becoming.«际» α} {x : α},
  Becoming.«定后于» R x → Becoming.«及» R x x → ¬Becoming.«入» R x
@Becoming.«定后则返者不入» : ∀ {α : Type u_1} {R : Becoming.«际» α},
  Becoming.«定后» R → ∀ {x : α}, Becoming.«及» R x x → ¬Becoming.«入» R x
@Becoming.«有后不返则入» : ∀ {α : Type u_1} {R : Becoming.«际» α} {x y : α}, R x y → ¬Becoming.«及» R x x → Becoming.«入» R x
@Becoming.«定后于有后则入当且仅当不返» : ∀ {α : Type u_1} {R : Becoming.«际» α} {x : α},
  Becoming.«定后于» R x → (∃ y, R x y) → (Becoming.«入» R x ↔ ¬Becoming.«及» R x x)
@Becoming.«定后有后则入当且仅当不返» : ∀ {α : Type u_1} {R : Becoming.«际» α},
  Becoming.«定后» R → ∀ {x : α}, (∃ y, R x y) → (Becoming.«入» R x ↔ ¬Becoming.«及» R x x)
@Becoming.«无后者不入亦不返» : ∀ {α : Type u_1} {R : Becoming.«际» α} {x : α},
  (∀ (y : α), ¬R x y) → ¬Becoming.«入» R x ∧ ¬Becoming.«及» R x x
Becoming.«入而返之例» : ∃ R x, Becoming.«入» R x ∧ Becoming.«及» R x x
Becoming.«非定后返而不入之例» : ∃ R, ¬Becoming.«定后» R ∧ Becoming.«及» R none none ∧ ¬Becoming.«入» R none
@Becoming.«遍后则有线» : ∀ {α : Type u_1} {R : Becoming.«际» α},
  (∀ (x : α), ∃ y, R x y) → ∀ (n : Nat) (x : α), ∃ g, g 0 = x ∧ ∀ (i : Nat), i < n → R (g i) (g (i + 1))
@Becoming.«定前则线不并» : ∀ {α : Type u_1} {R : Becoming.«际» α},
  Becoming.«定前» R → ∀ (g : Nat → α) (N : Nat), Becoming.«线不并» R g N
@Becoming.«线不并则可退» : ∀ {α : Type u_1} {R : Becoming.«际» α} {g : Nat → α} {N : Nat},
  Becoming.«线不并» R g N →
    (∀ (i : Nat), i < N → R (g i) (g (i + 1))) → ∀ (i d : Nat), i + d ≤ N → g i = g (i + d) → g 0 = g d
@Becoming.«定前则线可退» : ∀ {α : Type u_1} {R : Becoming.«际» α},
  Becoming.«定前» R →
    ∀ {g : Nat → α} {N : Nat},
      (∀ (i : Nat), i < N → R (g i) (g (i + 1))) → ∀ (i d : Nat), i + d ≤ N → g i = g (i + d) → g 0 = g d
@Becoming.«线则及» : ∀ {α : Type u_1} {R : Becoming.«际» α} {g : Nat → α} {N : Nat},
  (∀ (i : Nat), i < N → R (g i) (g (i + 1))) → ∀ (k m : Nat), m + (k + 1) ≤ N → Becoming.«及» R (g m) (g (m + (k + 1)))
@Becoming.«线则所闭» : ∀ {α : Type u_1} {R : Becoming.«际» α} {g : Nat → α} {N : Nat},
  (∀ (i : Nat), i < N → R (g i) (g (i + 1))) → ∀ (m : Nat), m ≤ N → Becoming.«所闭» R (g 0) (g m)
@Becoming.«线有限不并则回» : ∀ {α : Type u_1} {R : Becoming.«际» α} {l : List α} {g : Nat → α},
  Becoming.«线不并» R g l.length →
    (∀ (i : Nat), i < l.length → R (g i) (g (i + 1))) →
      (∀ (n : Nat), n ≤ l.length → g n ∈ l) → ∃ d, 0 < d ∧ d ≤ l.length ∧ g d = g 0
@Becoming.«线有限不并则返» : ∀ {α : Type u_1} {R : Becoming.«际» α} {l : List α} {g : Nat → α},
  Becoming.«线不并» R g l.length →
    (∀ (i : Nat), i < l.length → R (g i) (g (i + 1))) →
      (∀ (n : Nat), n ≤ l.length → g n ∈ l) → Becoming.«及» R (g 0) (g 0)
@Becoming.«线有限定前则返» : ∀ {α : Type u_1} {R : Becoming.«际» α} {l : List α},
  Becoming.«定前» R →
    ∀ {g : Nat → α},
      (∀ (i : Nat), i < l.length → R (g i) (g (i + 1))) →
        (∀ (n : Nat), n ≤ l.length → g n ∈ l) → Becoming.«及» R (g 0) (g 0)
@Becoming.«定后于线有限则末返» : ∀ {α : Type u_1} {R : Becoming.«际» α} {l : List α} {g : Nat → α},
  Becoming.«定后于» R (g 0) →
    (∀ (i : Nat), i < l.length → R (g i) (g (i + 1))) →
      (∀ (n : Nat), n ≤ l.length → g n ∈ l) → Becoming.«及» R (g l.length) (g l.length)
@Becoming.«有限遍后定前则皆返» : ∀ {α : Type u_1} {R : Becoming.«际» α} {all : List α},
  (∀ (x : α), x ∈ all) → (∀ (x : α), ∃ y, R x y) → Becoming.«定前» R → ∀ (x : α), Becoming.«及» R x x
@Becoming.«定后于二返则不并» : ∀ {α : Type u_1} {R : Becoming.«际» α} {x y z : α},
  Becoming.«定后于» R x → Becoming.«定后于» R y → Becoming.«及» R x x → Becoming.«及» R y y → R x z → R y z → x = y
@Becoming.«皆返定后则定前» : ∀ {α : Type u_1} {R : Becoming.«际» α},
  Becoming.«定后» R → (∀ (x : α), Becoming.«及» R x x) → Becoming.«定前» R
@Becoming.«有限遍后定后则定前当且仅当皆返» : ∀ {α : Type u_1} {R : Becoming.«际» α} {all : List α},
  (∀ (x : α), x ∈ all) → (∀ (x : α), ∃ y, R x y) → Becoming.«定后» R → (Becoming.«定前» R ↔ ∀ (x : α), Becoming.«及» R x x)
@Becoming.«屡则或屡» : ∀ {α : Type u_1} {F : Becoming.«际» α} {g : Nat → α},
  Becoming.«屡» F g → ∀ (T : Nat), Becoming.«或屡» F g T
@Becoming.«线或在所闭» : ∀ {α : Type u_1} {Q : Becoming.«际» α} {g : Nat → α} {T : Nat},
  (∀ (t : Nat), T ≤ t → ¬¬Q (g t) (g (t + 1))) → ∀ (k : Nat), ¬¬Becoming.«所闭» Q (g T) (g (T + k))
@Becoming.«尽则不或屡» : ∀ {α : Type u_1} {Q F : Becoming.«际» α} {g : Nat → α} {T : Nat},
  (∀ (t : Nat), T ≤ t → ¬¬Q (g t) (g (t + 1))) →
    Becoming.«尽» (Becoming.«而» (Becoming.«所闭» Q) F) Becoming.«一» (g T) → ¬Becoming.«或屡» F g T
@Becoming.«尽则不屡» : ∀ {α : Type u_1} {Q F : Becoming.«际» α} {g : Nat → α} {T : Nat},
  (∀ (t : Nat), T ≤ t → Q (g t) (g (t + 1))) →
    Becoming.«尽» (Becoming.«而» (Becoming.«所闭» Q) F) Becoming.«一» (g T) → ¬Becoming.«屡» F g
Becoming.«止而不入之例» : ∃ Q F g,
  (∀ (t : Nat), Q (g t) (g (t + 1))) ∧
    Becoming.«尽» (Becoming.«而» (Becoming.«所闭» Q) F) Becoming.«一» (g 0) ∧ ¬Becoming.«屡» F g ∧ ¬Becoming.«入» Q (g 0)
Becoming.«入而屡之例» : ∃ Q F g, (∀ (t : Nat), Q (g t) (g (t + 1))) ∧ Becoming.«屡» F g ∧ Becoming.«入» Q (g 0)
@Becoming.«同行之逐点» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«同行» R E ↔ ∀ (x x' : α), E x x' → ∀ (y y' : α), R x y → R x' y' → E y y'
@Becoming.«有常局定后则同行» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«有常» R E → (∀ (x x' : α), E x x' → ∀ (v w : α), R x' v → R x' w → v = w) → Becoming.«同行» R E
@Becoming.«有常定后则同行» : ∀ {α : Type u_1} {R E : Becoming.«际» α}, Becoming.«有常» R E → Becoming.«定后» R → Becoming.«同行» R E
@Becoming.«有常则可续» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«有常» R E → ∀ (u u' v : α), E u u' → R u v → ∃ v', R u' v'
@Becoming.«同行可续则有常» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«同行» R E → (∀ (u u' v : α), E u u' → R u v → ∃ v', R u' v') → Becoming.«有常» R E
@Becoming.«同行遍后则有常» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«同行» R E → (∀ (x : α), ∃ y, R x y) → Becoming.«有常» R E
@Becoming.«局定后则有常当且仅当同行可续» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  (∀ (x x' : α), E x x' → ∀ (v w : α), R x' v → R x' w → v = w) →
    (Becoming.«有常» R E ↔ Becoming.«同行» R E ∧ ∀ (u u' v : α), E u u' → R u v → ∃ v', R u' v')
@Becoming.«同行当且仅当有常» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«定后» R → (∀ (x : α), ∃ y, R x y) → (Becoming.«同行» R E ↔ Becoming.«有常» R E)
@Becoming.«类同行遍后则含于核» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«类» E → Becoming.«同行» R E → (∀ (x : α), ∃ y, R x y) → Becoming.«则» E (Becoming.«核» R E)
@Becoming.«同行之迭» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«同行» R E → ∀ (n : Nat) {x x' y y' : α}, E x x' → Becoming.«迭» R n x y → Becoming.«迭» R n x' y' → E y y'
@Becoming.«同行于迭» : ∀ {α : Type u_1} {R E : Becoming.«际» α},
  Becoming.«同行» R E → ∀ (n : Nat), Becoming.«同行» (Becoming.«迭» R n) E
@Becoming.«像定后当且仅当同行» : ∀ {α : Type u_1} {κ : Type u_2} {π : α → κ} {R : Becoming.«际» α},
  Becoming.«定后» (Becoming.«像» π R) ↔ Becoming.«同行» R fun s s' => π s = π s'
@Becoming.«逾则不则» : ∀ {α : Type u_1} {R S : Becoming.«际» α}, Becoming.«逾» R S → ¬Becoming.«则» R S
@Becoming.«广则不则» : ∀ {α : Type u_1} {R S : Becoming.«际» α}, Becoming.«广» R S → Becoming.«则» S R ∧ ¬Becoming.«则» R S
@Becoming.«广非自» : ∀ {α : Type u_1} (R : Becoming.«际» α), ¬Becoming.«广» R R
@Becoming.«广不可逆» : ∀ {α : Type u_1} {R S : Becoming.«际» α}, Becoming.«广» R S → ¬Becoming.«广» S R
@Becoming.«广之传递» : ∀ {α : Type u_1} {R S T : Becoming.«际» α}, Becoming.«广» R S → Becoming.«广» S T → Becoming.«广» R T
@Becoming.«齐即谓» : ∀ {α : Type u_1} {R S : Becoming.«际» α}, Becoming.«齐» R S ↔ Becoming.«谓» R S
@Becoming.«齐之对称» : ∀ {α : Type u_1} {R S : Becoming.«际» α}, Becoming.«齐» R S → Becoming.«齐» S R
@Becoming.«杂之对称» : ∀ {α : Type u_1} {R S : Becoming.«际» α}, Becoming.«杂» R S → Becoming.«杂» S R
@Becoming.«广则非齐» : ∀ {α : Type u_1} {R S : Becoming.«际» α}, Becoming.«广» R S → ¬Becoming.«齐» R S
@Becoming.«广则非杂» : ∀ {α : Type u_1} {R S : Becoming.«际» α}, Becoming.«广» R S → ¬Becoming.«杂» R S
@Becoming.«齐则非杂» : ∀ {α : Type u_1} {R S : Becoming.«际» α}, Becoming.«齐» R S → ¬Becoming.«杂» R S
@Becoming.«四比之周» : ∀ {α : Type u_1} {R S : Becoming.«际» α},
  Becoming.«则» R S ∨ Becoming.«逾» R S →
    Becoming.«则» S R ∨ Becoming.«逾» S R → Becoming.«广» R S ∨ Becoming.«广» S R ∨ Becoming.«齐» R S ∨ Becoming.«杂» R S
@Becoming.strictJoin_trans : ∀ {α : Type u_1} {S P : α → α → Prop},
  (∀ {a b c : α}, S a b → S b c → S a c) →
    (∀ {a b c : α}, P a b → P b c → P a c) →
      (∀ {a b : α}, S a b → P a b) →
        ∀ {a b c : α}, S a b ∨ P a b ∧ ¬P b a → S b c ∨ P b c ∧ ¬P c b → S a c ∨ P a c ∧ ¬P c a
@Becoming.strictJoin_irrefl : ∀ {α : Type u_1} {S P : α → α → Prop} {a : α}, ¬S a a → ¬(S a a ∨ P a a ∧ ¬P a a)
Becoming.«则逾之定当且仅当排中» : (∀ (α : Type) (R S : Becoming.«际» α), Becoming.«则» R S ∨ Becoming.«逾» R S) ↔
  ∀ (P : Prop), P ∨ ¬P
