Becoming.Brood.standing_self : ∀ (t : Nat), Becoming.Brood.standing t t = 1
Becoming.Brood.standing_before : ∀ (t : Nat), Becoming.Brood.standing (t + 1) t = 0
Becoming.Brood.arises : ∀ (t : Nat), Becoming.Brood.web.Arises t (t + 1)
Becoming.Brood.brood : Becoming.Brood.flow.Balances Becoming.Brood.web ∧
  Becoming.Brood.flow.Acting Becoming.Brood.web ∧
    Becoming.Brood.web.Dependent ∧
      (∀ (x : Nat), Becoming.Brood.web.Embodied x ∧ Becoming.Brood.web.SelfBearing x) ∧ Becoming.Brood.web.Unceasing
Becoming.Brood.not_dissipative : ¬Becoming.Brood.flow.Dissipative
Becoming.Brood.birth_only : ∀ (x t : Nat), 0 < Becoming.Brood.birth x t → x = t + 1
Becoming.Brood.rise_without_fall : ∀ (t : Nat),
  Becoming.Brood.flow.ClosedAt [t, t + 1] t ∧
    Becoming.Brood.web.Arises t (t + 1) ∧
      (∀ (s x : Nat), ¬Becoming.Brood.web.Falls s x) ∧ ¬Becoming.Brood.flow.DissipatesOn [t, t + 1] t
Becoming.SourceSeed.source_gives : Becoming.SourceSeed.flow.Balances Becoming.SourceSeed.web ∧
  Becoming.SourceSeed.flow.Acting Becoming.SourceSeed.web ∧
    Becoming.SourceSeed.web.Embodied Becoming.SourceSeed.Relatum.seed ∧
      Becoming.SourceSeed.web.Arises 0 Becoming.SourceSeed.Relatum.seed ∧
        (∀ (f : Becoming.SourceSeed.Relatum),
            Becoming.SourceSeed.web.active 0 f ∧
                f ∈ Becoming.SourceSeed.flow.present 0 ∧
                  0 < Becoming.SourceSeed.flow.give 0 f Becoming.SourceSeed.Relatum.seed ∧
                    f ≠ Becoming.SourceSeed.Relatum.seed →
              f = Becoming.SourceSeed.Relatum.source) ∧
          ¬Becoming.SourceSeed.web.Embodied Becoming.SourceSeed.Relatum.source ∧
            ¬Becoming.SourceSeed.web.SelfBearing Becoming.SourceSeed.Relatum.source ∧
              ∀ (t : Nat) (c : Becoming.SourceSeed.Relatum),
                ¬Becoming.SourceSeed.web.requires t Becoming.SourceSeed.Relatum.source c
Becoming.EmbodiedSource.balances : Becoming.SourceSeed.flow.Balances Becoming.EmbodiedSource.web
Becoming.EmbodiedSource.acting : Becoming.SourceSeed.flow.Acting Becoming.EmbodiedSource.web
Becoming.EmbodiedSource.gives_embodied : ∀ (t : Nat) (f c : Becoming.SourceSeed.Relatum),
  f ∈ Becoming.SourceSeed.flow.present t →
    0 < Becoming.SourceSeed.flow.give t f c → Becoming.EmbodiedSource.web.Embodied f
Becoming.EmbodiedSource.embodied_source : Becoming.SourceSeed.flow.Balances Becoming.EmbodiedSource.web ∧
  Becoming.SourceSeed.flow.Acting Becoming.EmbodiedSource.web ∧
    (∀ (t : Nat) (f c : Becoming.SourceSeed.Relatum),
        f ∈ Becoming.SourceSeed.flow.present t →
          0 < Becoming.SourceSeed.flow.give t f c → Becoming.EmbodiedSource.web.Embodied f) ∧
      Becoming.EmbodiedSource.web.Embodied Becoming.SourceSeed.Relatum.seed ∧
        Becoming.EmbodiedSource.web.Arises 0 Becoming.SourceSeed.Relatum.seed ∧
          (∃ f,
              Becoming.EmbodiedSource.web.Embodied f ∧
                0 < Becoming.EmbodiedSource.web.level 0 f ∧
                  f ∈ Becoming.SourceSeed.flow.present 0 ∧
                    0 < Becoming.SourceSeed.flow.give 0 f Becoming.SourceSeed.Relatum.seed ∧
                      f ≠ Becoming.SourceSeed.Relatum.seed) ∧
            (∀ (t : Nat) (c : Becoming.SourceSeed.Relatum),
                ¬Becoming.EmbodiedSource.web.requires t Becoming.SourceSeed.Relatum.source c ∧
                  ¬Becoming.EmbodiedSource.web.draws t Becoming.SourceSeed.Relatum.source c ∧
                    Becoming.SourceSeed.flow.take t Becoming.SourceSeed.Relatum.source c = 0) ∧
              ¬Becoming.EmbodiedSource.web.SelfBearing Becoming.SourceSeed.Relatum.source
Becoming.Shuttle.distinct : Becoming.Distinct [true, false]
Becoming.Shuttle.stands_two : ∀ (x : Bool) (t : Nat), Becoming.Shuttle.stands x (t + 2) = Becoming.Shuttle.stands x t
Becoming.Shuttle.holder_stands : ∀ (t : Nat), 0 < Becoming.Shuttle.stands (Becoming.Shuttle.holder t) t
Becoming.Shuttle.balances : Becoming.Shuttle.flow.Balances Becoming.Shuttle.web
Becoming.Shuttle.acting : Becoming.Shuttle.flow.Acting Becoming.Shuttle.web
Becoming.Shuttle.dependent : Becoming.Shuttle.web.Dependent
Becoming.Shuttle.embodied : ∀ (x : Bool), Becoming.Shuttle.web.Embodied x ∧ Becoming.Shuttle.web.SelfBearing x
Becoming.Shuttle.arises : ∀ (t : Nat) (x : Bool),
  Becoming.Shuttle.web.Arises t x ∨ Becoming.Shuttle.web.Arises (t + 1) x
Becoming.Shuttle.recurs : ∀ (x : Bool) (N : Nat), ∃ t, N ≤ t ∧ Becoming.Shuttle.web.Arises t x
Becoming.Shuttle.shuttle : Becoming.Shuttle.flow.Balances Becoming.Shuttle.web ∧
  Becoming.Shuttle.flow.Acting Becoming.Shuttle.web ∧
    Becoming.Shuttle.web.Dependent ∧
      (∀ (x : Bool), Becoming.Shuttle.web.Embodied x ∧ Becoming.Shuttle.web.SelfBearing x) ∧
        (∀ (t : Nat), Becoming.Shuttle.flow.ClosedAt [true, false] t) ∧
          Becoming.Shuttle.web.Unceasing ∧ ¬Becoming.Shuttle.flow.Dissipative
Becoming.Throughput.balances : Becoming.Throughput.flow.Balances Becoming.Throughput.web
Becoming.Throughput.acting : Becoming.Throughput.flow.Acting Becoming.Throughput.web
Becoming.Throughput.dependent : Becoming.Throughput.web.Dependent
Becoming.Throughput.gives_other : ∀ (t : Nat) (x : Bool) (c : Becoming.Throughput.Relatum),
  0 < Becoming.Throughput.flow.give t (Becoming.Throughput.Relatum.side x) c → c = Becoming.Throughput.Relatum.side !x
Becoming.Throughput.gives_one : ∀ (t : Nat) (x : Bool),
  Becoming.Throughput.flow.give t (Becoming.Throughput.Relatum.side x) (Becoming.Throughput.Relatum.side !x) ≤ 1
@Becoming.Throughput.side_dissipates : ∀ {ds : List Becoming.Throughput.Relatum} {t : Nat},
  Becoming.Distinct ds →
    Becoming.Throughput.flow.ClosedAt ds t →
      ∀ {x : Bool},
        Becoming.Throughput.Relatum.side x ∈ Becoming.Throughput.flow.present t →
          Becoming.total ds (Becoming.Throughput.flow.give t (Becoming.Throughput.Relatum.side x)) +
              Becoming.sign (Becoming.total ds (Becoming.Throughput.flow.take t (Becoming.Throughput.Relatum.side x))) ≤
            Becoming.total ds (Becoming.Throughput.flow.take t (Becoming.Throughput.Relatum.side x))
Becoming.Throughput.dissipative : Becoming.Throughput.flow.Dissipative
Becoming.Throughput.throughput : Becoming.Throughput.flow.Balances Becoming.Throughput.web ∧
  Becoming.Throughput.flow.Acting Becoming.Throughput.web ∧
    Becoming.Throughput.web.Dependent ∧
      (∀ (x : Bool),
          Becoming.Throughput.web.Embodied (Becoming.Throughput.Relatum.side x) ∧
            Becoming.Throughput.web.SelfBearing (Becoming.Throughput.Relatum.side x)) ∧
        Becoming.Throughput.flow.Dissipative ∧
          ∀ (x : Bool) (N : Nat), ∃ t, N ≤ t ∧ Becoming.Throughput.web.Arises t (Becoming.Throughput.Relatum.side x)
@Becoming.Throughput.frontier : ∀ {ds : List Becoming.Throughput.Relatum},
  Becoming.Distinct ds →
    ∀ {x : Bool},
      Becoming.Throughput.Relatum.side x ∈ ds →
        ∀ (T : Nat), ¬∀ (t : Nat), T ≤ t → Becoming.Throughput.flow.ClosedAt ds t
Becoming.Throughput.around : ∀ (t : Nat),
  Becoming.Throughput.flow.Around [Becoming.Throughput.Relatum.side true, Becoming.Throughput.Relatum.side false] t
Becoming.Throughput.draws_in : ∀ (N : Nat),
  ¬∀ (t : Nat),
      N ≤ t →
        Becoming.Throughput.flow.Inward [Becoming.Throughput.Relatum.side true, Becoming.Throughput.Relatum.side false]
          t
Becoming.SprayShuttle.sides_distinct : Becoming.Distinct Becoming.SprayShuttle.sides
@Becoming.SprayShuttle.le_bound : ∀ {m : Nat} {l : List Becoming.SprayShuttle.Relatum},
  Becoming.SprayShuttle.Relatum.aux m ∈ l → m + 1 ≤ Becoming.SprayShuttle.bound l
Becoming.SprayShuttle.fresh : ∀ (l : List Becoming.SprayShuttle.Relatum),
  ¬Becoming.SprayShuttle.Relatum.aux (Becoming.SprayShuttle.bound l) ∈ l
Becoming.SprayShuttle.balances : Becoming.SprayShuttle.flow.Balances Becoming.SprayShuttle.web
Becoming.SprayShuttle.acting : Becoming.SprayShuttle.flow.Acting Becoming.SprayShuttle.web
Becoming.SprayShuttle.dependent : Becoming.SprayShuttle.web.Dependent
Becoming.SprayShuttle.unenclosed : ∀ (t : Nat), ¬Becoming.SprayShuttle.flow.Enclosed t
Becoming.SprayShuttle.dissipative : Becoming.SprayShuttle.flow.Dissipative
Becoming.SprayShuttle.even_sum : ∀ (t : Nat), Becoming.Shuttle.even t + Becoming.Shuttle.even (t + 1) = 1
Becoming.SprayShuttle.spray_shuttle : Becoming.SprayShuttle.flow.Balances Becoming.SprayShuttle.web ∧
  Becoming.SprayShuttle.flow.Acting Becoming.SprayShuttle.web ∧
    Becoming.SprayShuttle.web.Dependent ∧
      (∀ (x : Bool),
          Becoming.SprayShuttle.web.Embodied (Becoming.SprayShuttle.Relatum.side x) ∧
            Becoming.SprayShuttle.web.SelfBearing (Becoming.SprayShuttle.Relatum.side x)) ∧
        Becoming.SprayShuttle.flow.Dissipative ∧
          (∀ (t : Nat), ¬Becoming.SprayShuttle.flow.Enclosed t) ∧
            (∀ (x : Bool) (N : Nat),
                ∃ t, N ≤ t ∧ Becoming.SprayShuttle.web.Arises t (Becoming.SprayShuttle.Relatum.side x)) ∧
              (∀ (t : Nat), Becoming.SprayShuttle.flow.Inward Becoming.SprayShuttle.sides t) ∧
                (∀ (t : Nat) (x : Bool),
                    Becoming.SprayShuttle.flow.take t Becoming.SprayShuttle.Relatum.sink
                          (Becoming.SprayShuttle.Relatum.side x) =
                        0 ∧
                      Becoming.SprayShuttle.flow.give t Becoming.SprayShuttle.Relatum.sink
                          (Becoming.SprayShuttle.Relatum.side x) =
                        0) ∧
                  ∀ (t : Nat), Becoming.SprayShuttle.web.stock Becoming.SprayShuttle.sides t = 1
Becoming.SprayShuttle.opens_anyway : ∀ (T : Nat),
  (¬∀ (t : Nat), T ≤ t → Becoming.SprayShuttle.flow.ClosedAt Becoming.SprayShuttle.sides t) ∧
    ∀ (t : Nat), ¬Becoming.SprayShuttle.flow.Around Becoming.SprayShuttle.sides t
Becoming.SprayShuttle.taking_opens_anyway : ∀ (T : Nat),
  ¬∀ (t : Nat), T ≤ t → Becoming.SprayShuttle.flow.ClosedAt Becoming.SprayShuttle.sides t
Becoming.Flicker.flicker : Becoming.Flicker.flow.Balances Becoming.Flicker.web ∧
  Becoming.Flicker.flow.Dissipative ∧ Becoming.Flicker.web.Unceasing ∧ ¬Becoming.Flicker.web.Embodied ()
Becoming.Shuttle.next_off : ∀ (t : Nat), Becoming.Shuttle.stands (Becoming.Shuttle.holder t) (t + 1) = 0
