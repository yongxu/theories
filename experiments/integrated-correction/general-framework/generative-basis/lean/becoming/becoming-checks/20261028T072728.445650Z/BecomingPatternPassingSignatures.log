@Becoming.Web.passesAt_of_alters : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop} {x y : Nat × F},
  V.active x.fst x.snd →
    Becoming.«异» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.activityClass
        V.carrierClass x y →
      V.PassesAt passes x.fst
@Becoming.Web.alters_of_passes : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop} {t : Nat}
  {b a : F},
  V.active t b →
    passes t b a →
      V.active (t + 1) a →
        ¬b = a →
          Becoming.«异» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.activityClass
            V.carrierClass (t, b) (t + 1, a)
@Becoming.Web.passing_fire : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop} {t : Nat} {b a : F},
  V.Ceases t b →
    passes t b a →
      V.active (t + 1) a →
        Becoming.«亡» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.carrierClass (t, b) ∧
          ¬Becoming.«亡» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.activityClass
                (t, b) ∧
            Becoming.«异» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.activityClass
              V.carrierClass (t, b) (t + 1, a)
@Becoming.Web.ceases_of_pattern_ends : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop} {t : Nat}
