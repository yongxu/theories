          (t + 1, a)
@Becoming.Web.arises_iff_sheng_carrier : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop} {t : Nat}
  {a : F},
  V.Arises t a ↔
    V.active (t + 1) a ∧
      Becoming.«生» (Becoming.Web.continuationStep (Becoming.Web.passingContinuation passes)) V.carrierClass (t + 1, a)
@Becoming.Web.ceases_iff_wang_carrier : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop} {t : Nat}
  {b : F},
  V.Ceases t b ↔
