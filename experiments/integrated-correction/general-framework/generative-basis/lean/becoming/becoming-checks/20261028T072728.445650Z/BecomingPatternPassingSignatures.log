@Becoming.Web.carrierClass_finer : ∀ {F C : Type} (V : Becoming.Web F C), Becoming.«则» V.carrierClass V.activityClass
@Becoming.Web.byPassing_iff_continues : ∀ {F C : Type} {V : Becoming.Web F C} {passes : Nat → F → F → Prop},
  V.ByPassing passes ↔
    ∀ (t : Nat) (a : F), V.active (t + 1) a → V.Continues (Becoming.Web.passingContinuation passes) t a
