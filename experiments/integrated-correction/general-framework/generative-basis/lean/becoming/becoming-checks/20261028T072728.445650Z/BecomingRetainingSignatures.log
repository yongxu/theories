              Becoming.ArisingDrawer.web.Widens l Becoming.ArisingDrawer.web.level
Becoming.ArisingGiver.withheld : Becoming.ArisingGiver.flow.WithheldLevels Becoming.ArisingGiver.part
  Becoming.ArisingGiver.web fun x x_1 => 0
@Becoming.ArisingGiver.arises_widens : ∀ {l : Nat → Unit → Nat},
  Becoming.ArisingGiver.flow.WithheldLevels Becoming.ArisingGiver.part Becoming.ArisingGiver.web l →
    Becoming.ArisingGiver.flow.Balances Becoming.ArisingGiver.web ∧
