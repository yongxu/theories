    Becoming.Optimum.AtSetPoint ds s o₀ →
      ∀ {o : C → Nat},
        Becoming.Requirement.Frontier eligible (Becoming.Optimum.byGapThen ds s [c]) o →
          (need ≤ o c ↔ ∃ o', eligible o' ∧ Becoming.Optimum.AtSetPoint ds s o' ∧ need ≤ o' c)
