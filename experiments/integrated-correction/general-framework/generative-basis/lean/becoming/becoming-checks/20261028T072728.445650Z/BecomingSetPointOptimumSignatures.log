  {o₀ : C → Nat}, (∀ (o : C → Nat), ¬better o o₀) → ∀ {d : C}, d ∈ ds → ¬Becoming.Optimum.Rising ds better
@Becoming.Optimum.byGap_not_rising : ∀ {C : Type} {ds : List C} {s : C → Nat} {d : C},
  d ∈ ds → ¬Becoming.Optimum.Rising ds (Becoming.Optimum.byGap ds s)
@Becoming.Optimum.nearer_of_atSetPoint : ∀ {C : Type} {ds : List C} {s o₀ o : C → Nat},
  Becoming.Optimum.AtSetPoint ds s o₀ → ∀ {c : C}, c ∈ ds → ¬o c = s c → Becoming.Optimum.Nearer ds s o₀ o
@Becoming.Optimum.Nearing.not_rising : ∀ {C : Type} {ds : List C} {s : C → Nat} {better : (C → Nat) → (C → Nat) → Prop},
  Becoming.Optimum.Nearing ds s better →
    (∀ (o o' : C → Nat), better o' o → ¬better o o') → ∀ {d : C}, d ∈ ds → ¬Becoming.Optimum.Rising ds better
@Becoming.Optimum.atSetPoint_iff : ∀ {C : Type} {ds : List C} {s : C → Nat} {eligible : (C → Nat) → Prop},
  (∀ (better : (C → Nat) → (C → Nat) → Prop),
      Becoming.Optimum.Nearing ds s better →
        ∀ (o : C → Nat), Becoming.Requirement.Frontier eligible better o → Becoming.Optimum.AtSetPoint ds s o) ↔
    ∀ (o : C → Nat),
      eligible o → ∀ (c : C), c ∈ ds → ¬o c = s c → ¬¬∃ o'', eligible o'' ∧ Becoming.Optimum.Nearer ds s o'' o
@Becoming.Optimum.atSetPoint_of_reach : ∀ {C : Type} {ds : List C} {s : C → Nat} {eligible : (C → Nat) → Prop}
  {better : (C → Nat) → (C → Nat) → Prop},
  Becoming.Optimum.Nearing ds s better →
    ∀ {o₀ : C → Nat},
      eligible o₀ →
        Becoming.Optimum.AtSetPoint ds s o₀ →
          ∀ {o : C → Nat}, Becoming.Requirement.Frontier eligible better o → Becoming.Optimum.AtSetPoint ds s o
@Becoming.Optimum.mutual_atSetPoint : ∀ {C : Type} {ds : List C} {s : C → Nat} {I : Type} {opt : List I}
  {fam : I → List C} {elig : I → (C → Nat) → Prop} {orders : I → (C → Nat) → (C → Nat) → Prop} {o : C → Nat},
  (∀ (c : C), c ∈ ds → ∃ i, i ∈ opt ∧ c ∈ fam i) →
    (∀ (i : I), i ∈ opt → Becoming.Optimum.Nearing (fam i) s (orders i)) →
      (∀ (i : I), i ∈ opt → ∃ o₀, elig i o₀ ∧ Becoming.Optimum.AtSetPoint (fam i) s o₀) →
        (∀ (i : I), i ∈ opt → Becoming.Requirement.Frontier (elig i) (orders i) o) → Becoming.Optimum.AtSetPoint ds s o
@Becoming.Optimum.optima_iff : ∀ {C : Type} {ds : List C} {s : C → Nat} {eligible : (C → Nat) → Prop} {o₀ : C → Nat},
  eligible o₀ →
    Becoming.Optimum.AtSetPoint ds s o₀ →
      ∀ {o : C → Nat},
        (∃ better, Becoming.Optimum.Nearing ds s better ∧ Becoming.Requirement.Frontier eligible better o) ↔
          eligible o ∧ Becoming.Optimum.AtSetPoint ds s o
@Becoming.Optimum.least_at_iff : ∀ {C : Type} {ds rest : List C} {s : C → Nat} {eligible : (C → Nat) → Prop}
  {o₀ : C → Nat},
