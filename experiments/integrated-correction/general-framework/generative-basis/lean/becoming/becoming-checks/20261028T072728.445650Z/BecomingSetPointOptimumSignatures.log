  Becoming.Optimum.Nearing ds s (Becoming.Optimum.byGapLess ds s rest)
@Becoming.Optimum.sub_le_sub_iff : ∀ {a b n : Nat}, a ≤ n → b ≤ n → (n - b ≤ n - a ↔ a ≤ b)
@Becoming.Optimum.sub_lt_sub_iff : ∀ {a b n : Nat}, b ≤ n → (n - b < n - a ↔ a < b)
@Becoming.Optimum.gapTo_of_upTo : ∀ {C : Type} {ds : List C} {s o : C → Nat},
  Becoming.Optimum.UpToSetPoint ds s o → ∀ {c : C}, c ∈ ds → Becoming.Optimum.gapTo s o c = s c - o c
@Becoming.Optimum.nearer_iff_exceeds : ∀ {C : Type} {ds : List C} {s o o' : C → Nat},
  Becoming.Optimum.UpToSetPoint ds s o →
    Becoming.Optimum.UpToSetPoint ds s o' → (Becoming.Optimum.Nearer ds s o' o ↔ Becoming.Optimum.Exceeds ds o' o)
@Becoming.Optimum.Nearing.rises_below : ∀ {C : Type} {ds : List C} {s : C → Nat}
  {better : (C → Nat) → (C → Nat) → Prop},
  Becoming.Optimum.Nearing ds s better →
    ∀ {o o' : C → Nat},
      Becoming.Optimum.UpToSetPoint ds s o →
        Becoming.Optimum.UpToSetPoint ds s o' → Becoming.Optimum.Exceeds ds o' o → better o' o
@Becoming.Optimum.least_below_iff : ∀ {C : Type} {ds rest : List C} {s : C → Nat} {eligible : (C → Nat) → Prop},
  (∀ (better : (C → Nat) → (C → Nat) → Prop),
      Becoming.Optimum.Nearing ds s better →
        ∀ (o : C → Nat),
          Becoming.Requirement.Frontier (fun o => eligible o ∧ Becoming.Optimum.UpToSetPoint ds s o) better o →
            Becoming.Optimum.Least rest (fun o => eligible o ∧ Becoming.Optimum.UpToSetPoint ds s o) o) ↔
    ∀ (o o' : C → Nat),
      eligible o ∧ Becoming.Optimum.UpToSetPoint ds s o →
        eligible o' ∧ Becoming.Optimum.UpToSetPoint ds s o' →
          ∀ (c : C),
            c ∈ rest →
              o' c < o c →
