  d ∈ ds → ¬Becoming.Optimum.Rising ds (Becoming.Optimum.byGapThen ds s rest)
@Becoming.Optimum.counted_after_most : ∀ {C : Type} {ds rest : List C} {s : C → Nat} {eligible : (C → Nat) → Prop}
  {o₀ : C → Nat},
  eligible o₀ →
    Becoming.Optimum.AtSetPoint ds s o₀ →
      ∀ {o : C → Nat},
        Becoming.Requirement.Frontier eligible (Becoming.Optimum.byGapThen ds s rest) o →
          Becoming.Optimum.AtSetPoint ds s o ∧
            ∀ (o' : C → Nat),
              eligible o' → Becoming.Optimum.AtSetPoint ds s o' → Becoming.total rest o' ≤ Becoming.total rest o
@Becoming.Optimum.counted_after_keeps_iff : ∀ {C : Type} {ds : List C} {s : C → Nat} {eligible : (C → Nat) → Prop}
  {c : C} {need : Nat} {o₀ : C → Nat},
