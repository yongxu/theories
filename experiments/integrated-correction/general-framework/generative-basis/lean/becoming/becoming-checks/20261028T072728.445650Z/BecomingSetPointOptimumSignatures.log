    Becoming.Optimum.AtSetPoint ds s o₀ →
      ((∀ (better : (C → Nat) → (C → Nat) → Prop),
          Becoming.Optimum.Nearing ds s better →
            ∀ (o : C → Nat),
              Becoming.Requirement.Frontier eligible better o →
                Becoming.Optimum.Least rest (fun o => eligible o ∧ Becoming.Optimum.AtSetPoint ds s o) o) ↔
        ∀ (o o' : C → Nat),
          eligible o →
            Becoming.Optimum.AtSetPoint ds s o →
              eligible o' → Becoming.Optimum.AtSetPoint ds s o' → ∀ (c : C), c ∈ rest → o c = o' c)
@Becoming.Optimum.byGapThen_nearing : ∀ {C : Type} {ds rest : List C} {s : C → Nat},
  Becoming.Optimum.Nearing ds s (Becoming.Optimum.byGapThen ds s rest)
@Becoming.Optimum.byGapThen_asymm : ∀ {C : Type} {ds rest : List C} {s : C → Nat} (o o' : C → Nat),
