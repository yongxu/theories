            Becoming.Reaching.PossibleHeld Becoming.Oscillating.process Becoming.Oscillating.Same
              Becoming.Oscillating.adm (Becoming.Oscillating.course.state 1) y) ∧
        Becoming.Reaching.PossibleHeld Becoming.Oscillating.process Becoming.Oscillating.Same Becoming.Oscillating.adm
            (Becoming.Oscillating.course.state 1) 1 ∧
          ¬Becoming.Reaching.PossibleHeld Becoming.Oscillating.process Becoming.Oscillating.Same
