Becoming.CopyDown.held_iff : ∀ (n k x : Nat),
  Becoming.Reaching.PossibleHeld Becoming.CopyDown.process (Becoming.RuleTower.SameFrom n) Becoming.CopyDown.adm
      (Becoming.CopyDown.course.state k) x ↔
    x < n ∨ x < k
