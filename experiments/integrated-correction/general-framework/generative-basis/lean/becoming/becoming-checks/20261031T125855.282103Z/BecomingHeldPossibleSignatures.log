@Becoming.CopyDown.rule_below : ∀ {k m : Nat}, m < k → Becoming.CopyDown.rule k m = m + 2
@Becoming.CopyDown.rule_above : ∀ {k m : Nat}, ¬m < k → Becoming.CopyDown.rule k m = m + 1
Becoming.CopyDown.changes_iff : ∀ (k m : Nat),
  ¬(Becoming.CopyDown.course.state (k + 1)).snd m = (Becoming.CopyDown.course.state k).snd m ↔ m = k
