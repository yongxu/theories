    s.fst = 0 → s.snd = 0 → t.snd = 0
Becoming.Oscillating.converse_fails : (∀ (k : Nat),
    ¬Becoming.Oscillating.Same (Becoming.Oscillating.course.state k) (Becoming.Oscillating.course.state (k + 1))) ∧
  (¬∃ ys,
        ∀ (y : Nat),
          Becoming.Reaching.Possible Becoming.Oscillating.process Becoming.Oscillating.adm
              (Becoming.Oscillating.course.state 0) y →
            y ∈ ys) ∧
    ¬Becoming.Reaching.KeepsWidening fun k =>
        Becoming.Reaching.PossibleHeld Becoming.Oscillating.process Becoming.Oscillating.Same Becoming.Oscillating.adm
          (Becoming.Oscillating.course.state k)
Becoming.Oscillating.returns : ∀ (k : Nat),
  Becoming.Oscillating.course.state (k + 2) = Becoming.Oscillating.course.state k
Becoming.Oscillating.generation : ∀ (N : Nat),
  Becoming.«全生成» Becoming.Steps.next Becoming.«一»
    (fun i j => Becoming.Oscillating.Same (Becoming.Oscillating.course.state i) (Becoming.Oscillating.course.state j)) N
Becoming.Oscillating.generation_without_widening : (∀ (N : Nat),
    Becoming.«全生成» Becoming.Steps.next Becoming.«一»
      (fun i j => Becoming.Oscillating.Same (Becoming.Oscillating.course.state i) (Becoming.Oscillating.course.state j))
      N) ∧
  ¬Becoming.Reaching.KeepsWidening fun k =>
      Becoming.Reaching.PossibleHeld Becoming.Oscillating.process Becoming.Oscillating.Same Becoming.Oscillating.adm
        (Becoming.Oscillating.course.state k)
Becoming.Oscillating.comes_back : ∀ (d : Nat),
  ∃ m, 0 + d ≤ m ∧ Becoming.Oscillating.course.state m = Becoming.Oscillating.course.state 0
Becoming.Oscillating.exceeds_now : ∀ (k : Nat),
  Becoming.Reaching.Possible Becoming.Oscillating.process Becoming.Oscillating.adm (Becoming.Oscillating.course.state k)
      1 ∧
    ¬Becoming.Oscillating.adm (Becoming.Oscillating.course.state k) 1
Becoming.Oscillating.held_widens : (∀ (y : Nat),
    Becoming.Reaching.PossibleHeld Becoming.Oscillating.process Becoming.Oscillating.Same Becoming.Oscillating.adm
        (Becoming.Oscillating.course.state 0) y →
      Becoming.Reaching.PossibleHeld Becoming.Oscillating.process Becoming.Oscillating.Same Becoming.Oscillating.adm
        (Becoming.Oscillating.course.state 1) y) ∧
  Becoming.Reaching.PossibleHeld Becoming.Oscillating.process Becoming.Oscillating.Same Becoming.Oscillating.adm
