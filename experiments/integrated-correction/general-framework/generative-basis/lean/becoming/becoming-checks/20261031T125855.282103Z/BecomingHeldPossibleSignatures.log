        (Becoming.RaisedEveryOther.course.state k) y) ∧
    Becoming.«生生» Becoming.Steps.next
        (fun i j =>
          Becoming.RaisedRule.Same (Becoming.RaisedEveryOther.course.state i)
            (Becoming.RaisedEveryOther.course.state j))
        0 ∧
      ¬Becoming.«息» Becoming.Steps.next
          (fun i j =>
            Becoming.RaisedRule.Same (Becoming.RaisedEveryOther.course.state i)
              (Becoming.RaisedEveryOther.course.state j))
          0
Becoming.Oscillating.cond_not_ne : ∀ (b : Bool), ¬(bif !b then 1 else 0) = bif b then 1 else 0
Becoming.Oscillating.rule_changes : ∀ (k : Nat),
  ¬Becoming.Oscillating.Same (Becoming.Oscillating.course.state k) (Becoming.Oscillating.course.state (k + 1))
Becoming.Oscillating.every : ∀ (s : Nat × Nat) (y : Nat),
  Becoming.Reaching.Possible Becoming.Oscillating.process Becoming.Oscillating.adm s y
@Becoming.Oscillating.held_zero : ∀ {as : List Unit} {s t : Nat × Nat},
