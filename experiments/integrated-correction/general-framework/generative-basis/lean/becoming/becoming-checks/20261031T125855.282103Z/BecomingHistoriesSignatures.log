@Becoming.ShownBy.admits : ∀ {S : Type u_1} {A : Type u_2} {H : (Nat → S) → (Nat → A) → Prop} {g : Nat → S}
  {m : Nat → A}, H g m → Becoming.Admits (Becoming.ShownBy H) g m
@Becoming.shownBy_le_iff : ∀ {S : Type u_1} {A : Type u_2} {H : (Nat → S) → (Nat → A) → Prop}
  {Q : Generative.Process S A},
  (∀ (s : S) (a : A) (t : S), (Becoming.ShownBy H).step s a t → Q.step s a t) ↔
    ∀ (g : Nat → S) (m : Nat → A), H g m → Becoming.Admits Q g m
@Becoming.admits_spliceClosed : ∀ {S : Type u_1} {A : Type u_2} (P : Generative.Process S A),
  Becoming.SpliceClosed (Becoming.Admits P)
@Becoming.family_iff : ∀ {S : Type u_1} {A : Type u_2} {H : (Nat → S) → (Nat → A) → Prop},
  (∃ P, ∀ (g : Nat → S) (m : Nat → A), H g m ↔ Becoming.Admits P g m) ↔ Becoming.SpliceClosed H
@Becoming.shownBy_determined_iff : ∀ {S : Type u_1} {A : Type u_2} {H : (Nat → S) → (Nat → A) → Prop},
  Becoming.Determined (Becoming.ShownBy H) ↔ Becoming.ConsistentFamily H
@Becoming.determined_family_iff : ∀ {S : Type u_1} {A : Type u_2} {H : (Nat → S) → (Nat → A) → Prop},
  (∃ P, Becoming.Determined P ∧ ∀ (g : Nat → S) (m : Nat → A), H g m ↔ Becoming.Admits P g m) ↔
    Becoming.SpliceClosed H ∧ Becoming.ConsistentFamily H
@Becoming.live_le : ∀ {S : Type u_1} {A : Type u_2} (P : Generative.Process S A) (s : S) (a : A) (t : S),
  (Becoming.live P).step s a t → P.step s a t
@Becoming.admits_live_iff : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} {g : Nat → S} {m : Nat → A},
  Becoming.Admits (Becoming.live P) g m ↔ Becoming.Admits P g m
@Becoming.same_histories_iff : ∀ {S : Type u_1} {A : Type u_2} {P Q : Generative.Process S A},
  (∀ (g : Nat → S) (m : Nat → A), Becoming.Admits P g m ↔ Becoming.Admits Q g m) ↔
    ∀ (s : S) (a : A) (t : S), (Becoming.live P).step s a t ↔ (Becoming.live Q).step s a t
@Becoming.live_live : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} {s : S} {a : A} {t : S},
  (Becoming.live (Becoming.live P)).step s a t ↔ (Becoming.live P).step s a t
@Becoming.DeadEnd.not_live : ∀ {s : Bool} {i : Unit} {t : Bool}, ¬(Becoming.live Becoming.DeadEnd.law).step s i t
@Becoming.Trace.of_same : ∀ {S : Type u_1} {A : Type u_2} {P Q : Generative.Process S A},
  (∀ (s : S) (a : A) (t : S), P.step s a t → Q.step s a t) →
    ∀ {s : S} {as : List A} {t : S}, Generative.Trace P s as t → Generative.Trace Q s as t
@Becoming.same_finite_histories_iff : ∀ {S : Type u_1} {A : Type u_2} {P Q : Generative.Process S A},
  (∀ (s : S) (as : List A) (t : S), Generative.Trace P s as t ↔ Generative.Trace Q s as t) ↔
    ∀ (s : S) (a : A) (t : S), P.step s a t ↔ Q.step s a t
@Becoming.finite_family_iff : ∀ {S : Type u_1} {A : Type u_2} {T : S → List A → S → Prop},
  (∃ P, ∀ (s : S) (as : List A) (t : S), T s as t ↔ Generative.Trace P s as t) ↔ Becoming.MadeOfSteps T
@Becoming.Alike.sameTests : ∀ {S : Type u_1} {S' : Type u_4} {A : Type u_2} {C : Type u_3} {F : Becoming.Frame S A C}
  {G : Becoming.Frame S' A C} {s : S} {s' : S'}, Becoming.Alike F G s s' → Becoming.SameTests F G s s'
@Becoming.SameTests.after : ∀ {S : Type u_1} {S' : Type u_4} {A : Type u_2} {C : Type u_3} {F : Becoming.Frame S A C}
  {G : Becoming.Frame S' A C} {s : S} {s' : S'},
  Becoming.SameTests F G s s' →
    Becoming.DeterminedAt F s →
      Becoming.DeterminedAt G s' →
        ∀ {a : A} {t : S} {t' : S'}, F.P.step s a t → G.P.step s' a t' → Becoming.SameTests F G t t'
@Becoming.sameTests_bisimulation : ∀ {S : Type u_1} {S' : Type u_4} {A : Type u_2} {C : Type u_3}
  {F : Becoming.Frame S A C} {G : Becoming.Frame S' A C},
  (∀ (s : S), Becoming.DeterminedAt F s) →
    (∀ (s' : S'), Becoming.DeterminedAt G s') → Becoming.Bisimulation F G (Becoming.SameTests F G)
@Becoming.alike_iff_sameTests : ∀ {S : Type u_1} {S' : Type u_4} {A : Type u_2} {C : Type u_3}
  {F : Becoming.Frame S A C} {G : Becoming.Frame S' A C},
  (∀ (s : S), Becoming.DeterminedAt F s) →
    (∀ (s' : S'), Becoming.DeterminedAt G s') →
      ∀ {s : S} {s' : S'}, Becoming.Alike F G s s' ↔ Becoming.SameTests F G s s'
@Becoming.Determined.alike_iff_sameTests : ∀ {S : Type u_1} {A : Type u_2} {C : Type u_3} {F : Becoming.Frame S A C},
  Becoming.Determined F.P → ∀ {s s' : S}, Becoming.Alike F F s s' ↔ Becoming.SameTests F F s s'
@Becoming.Choosing.late_open : ∀ {as : List Becoming.Choosing.Move} {t : Becoming.Choosing.Pos},
  Generative.Trace Becoming.Choosing.late.P Becoming.Choosing.Pos.p0 as t → Becoming.Choosing.Open as
@Becoming.Choosing.early_open : ∀ {as : List Becoming.Choosing.Move} {t : Becoming.Choosing.Pos},
  Generative.Trace Becoming.Choosing.early.P Becoming.Choosing.Pos.p0 as t → Becoming.Choosing.Open as
@Becoming.Choosing.late_of_open : ∀ {as : List Becoming.Choosing.Move},
  Becoming.Choosing.Open as → ∃ t, Generative.Trace Becoming.Choosing.late.P Becoming.Choosing.Pos.p0 as t
@Becoming.Choosing.early_of_open : ∀ {as : List Becoming.Choosing.Move},
  Becoming.Choosing.Open as → ∃ t, Generative.Trace Becoming.Choosing.early.P Becoming.Choosing.Pos.p0 as t
Becoming.Choosing.sameTests : Becoming.SameTests Becoming.Choosing.late Becoming.Choosing.early Becoming.Choosing.Pos.p0
  Becoming.Choosing.Pos.p0
Becoming.Choosing.not_alike : ¬Becoming.Alike Becoming.Choosing.late Becoming.Choosing.early Becoming.Choosing.Pos.p0
    Becoming.Choosing.Pos.p0
Becoming.Choosing.early_not_determined : ¬Becoming.Determined Becoming.Choosing.early.P
