  Becoming.Ideals.Continuous (Becoming.Ideals.idealComplete P) D (Becoming.Ideals.extend D f hf)
@Becoming.Ideals.extend_unique : ∀ {α : Type u_1} {β : Type u_2} {P : Becoming.Ideals.Preorder α}
  {Q : Becoming.Ideals.Preorder β} (D : Becoming.Ideals.DirectedComplete Q) (f : α → β)
  (hf : Becoming.Ideals.Monotone P Q f) (g : Becoming.Ideals.Ideal P → β),
  Becoming.Ideals.Continuous (Becoming.Ideals.idealComplete P) D g →
    (∀ (p : α), Q.Equiv (g (Becoming.Ideals.principal P p)) (f p)) →
      ∀ (I : Becoming.Ideals.Ideal P), Q.Equiv (g I) (Becoming.Ideals.extend D f hf I)
@Becoming.Ideals.unique_continuous_extension : ∀ {α : Type u_1} {β : Type u_2} {P : Becoming.Ideals.Preorder α}
  {Q : Becoming.Ideals.Preorder β} (D : Becoming.Ideals.DirectedComplete Q) (f : α → β),
  Becoming.Ideals.Monotone P Q f →
    ∃ g,
      Becoming.Ideals.Continuous (Becoming.Ideals.idealComplete P) D g ∧
        (∀ (p : α), Q.Equiv (g (Becoming.Ideals.principal P p)) (f p)) ∧
          ∀ (h : Becoming.Ideals.Ideal P → β),
            Becoming.Ideals.Continuous (Becoming.Ideals.idealComplete P) D h →
              (∀ (p : α), Q.Equiv (h (Becoming.Ideals.principal P p)) (f p)) →
                ∀ (I : Becoming.Ideals.Ideal P), Q.Equiv (h I) (g I)
@Becoming.Ideals.CompactBasis.monotone : ∀ {α : Type u_1} {β : Type u_2} {P : Becoming.Ideals.Preorder α}
  {Q : Becoming.Ideals.Preorder β} {D : Becoming.Ideals.DirectedComplete Q} {e : α → β},
  Becoming.Ideals.CompactBasis P D e → Becoming.Ideals.Monotone P Q e
@Becoming.Ideals.CompactBasis.below_monotone : ∀ {α : Type u_1} {β : Type u_2} {P : Becoming.Ideals.Preorder α}
  {Q : Becoming.Ideals.Preorder β} {D : Becoming.Ideals.DirectedComplete Q} {e : α → β}
  (R : Becoming.Ideals.CompactBasis P D e), Becoming.Ideals.Monotone Q (Becoming.Ideals.idealOrder P) R.below
@Becoming.Ideals.CompactBasis.below_extend : ∀ {α : Type u_1} {β : Type u_2} {P : Becoming.Ideals.Preorder α}
  {Q : Becoming.Ideals.Preorder β} {D : Becoming.Ideals.DirectedComplete Q} {e : α → β}
  (R : Becoming.Ideals.CompactBasis P D e) (I : Becoming.Ideals.Ideal P),
  (R.below (Becoming.Ideals.extend D e ⋯ I)).Same I
@Becoming.Ideals.CompactBasis.extend_below : ∀ {α : Type u_1} {β : Type u_2} {P : Becoming.Ideals.Preorder α}
  {Q : Becoming.Ideals.Preorder β} {D : Becoming.Ideals.DirectedComplete Q} {e : α → β}
  (R : Becoming.Ideals.CompactBasis P D e) (x : β), Q.Equiv (Becoming.Ideals.extend D e ⋯ (R.below x)) x
@Becoming.Ideals.OrderEquivalence.continuous : ∀ {α : Type u_1} {β : Type u_2} {P : Becoming.Ideals.Preorder α}
  {Q : Becoming.Ideals.Preorder β} (D : Becoming.Ideals.DirectedComplete P) (E : Becoming.Ideals.DirectedComplete Q)
  (F : Becoming.Ideals.OrderEquivalence P Q), Becoming.Ideals.Continuous D E F.forward
@Becoming.Ideals.CompactBasis.equivalence_principal : ∀ {α : Type u_1} {β : Type u_2} {P : Becoming.Ideals.Preorder α}
  {Q : Becoming.Ideals.Preorder β} {D : Becoming.Ideals.DirectedComplete Q} {e : α → β}
  (R : Becoming.Ideals.CompactBasis P D e) (p : α),
  Q.Equiv (R.equivalence.forward (Becoming.Ideals.principal P p)) (e p)
@Becoming.Ideals.CompactBasis.equivalence_unique : ∀ {α : Type u_1} {β : Type u_2} {P : Becoming.Ideals.Preorder α}
  {Q : Becoming.Ideals.Preorder β} {D : Becoming.Ideals.DirectedComplete Q} {e : α → β}
  (R : Becoming.Ideals.CompactBasis P D e) (F : Becoming.Ideals.OrderEquivalence (Becoming.Ideals.idealOrder P) Q),
  (∀ (p : α), Q.Equiv (F.forward (Becoming.Ideals.principal P p)) (e p)) →
    ∀ (I : Becoming.Ideals.Ideal P), Q.Equiv (F.forward I) (R.equivalence.forward I)
@Becoming.Ideals.CompactBasis.equivalence_backward_unique : ∀ {α : Type u_1} {β : Type u_2}
  {P : Becoming.Ideals.Preorder α} {Q : Becoming.Ideals.Preorder β} {D : Becoming.Ideals.DirectedComplete Q} {e : α → β}
  (R : Becoming.Ideals.CompactBasis P D e) (F : Becoming.Ideals.OrderEquivalence (Becoming.Ideals.idealOrder P) Q),
  (∀ (p : α), Q.Equiv (F.forward (Becoming.Ideals.principal P p)) (e p)) →
    ∀ (y : β), (F.backward y).Same (R.equivalence.backward y)
@Becoming.Ideals.principal_basis : ∀ {α : Type u_1} (P : Becoming.Ideals.Preorder α),
  Becoming.Ideals.CompactBasis P (Becoming.Ideals.idealComplete P) (Becoming.Ideals.principal P)
@Becoming.Ideals.unique_basis_representation : ∀ {α : Type u_1} {β : Type u_2} {P : Becoming.Ideals.Preorder α}
  {Q : Becoming.Ideals.Preorder β} {D : Becoming.Ideals.DirectedComplete Q} {e : α → β},
  Becoming.Ideals.CompactBasis P D e →
    ∃ F,
      (∀ (p : α), Q.Equiv (F.forward (Becoming.Ideals.principal P p)) (e p)) ∧
        ∀ (G : Becoming.Ideals.OrderEquivalence (Becoming.Ideals.idealOrder P) Q),
          (∀ (p : α), Q.Equiv (G.forward (Becoming.Ideals.principal P p)) (e p)) →
            (∀ (I : Becoming.Ideals.Ideal P), Q.Equiv (G.forward I) (F.forward I)) ∧
              ∀ (y : β), (G.backward y).Same (F.backward y)
@Becoming.Ideals.above_monotone : ∀ {α : Type u_1} (P : Becoming.Ideals.Preorder α) (p : α),
  Becoming.Ideals.Monotone P Becoming.Ideals.implication (Becoming.Ideals.above P p)
@Becoming.Ideals.extend_above_iff : ∀ {α : Type u_1} (P : Becoming.Ideals.Preorder α) (p : α)
  (I : Becoming.Ideals.Ideal P),
  Becoming.Ideals.extend Becoming.Ideals.implicationComplete (Becoming.Ideals.above P p) ⋯ I ↔ I.mem p
@Becoming.Ideals.above_readings_separate : ∀ {α : Type u_1} {P : Becoming.Ideals.Preorder α}
  (I J : Becoming.Ideals.Ideal P),
  (∀ (p : α),
      Becoming.Ideals.extend Becoming.Ideals.implicationComplete (Becoming.Ideals.above P p) ⋯ I ↔
        Becoming.Ideals.extend Becoming.Ideals.implicationComplete (Becoming.Ideals.above P p) ⋯ J) →
    I.Same J
