    ∀ {p : Pos} {a b : Nat × X},
      Becoming.ModelStatements.livesOn W a b →
        sig p (a.snd, a.fst) → Becoming.ModelStatements.livingOcc W b → sig p (b.snd, b.fst)
@Becoming.ModelStatements.descends_iff : ∀ {X : Type} (L : Becoming.Flow X X) (V : Becoming.Web X X) (x g : X)
  (t s : Nat), L.Descends V x g ↔ Becoming.ModelStatements.descendsRel L V (t, g) (s, x)
@Becoming.ModelStatements.descent_related_iff : ∀ {X : Type} (L : Becoming.Flow X X) (V : Becoming.Web X X) {Pos : Type}
  (own sig : Pos → X × Nat → Prop) (a b : Nat × X),
  (L.descent V own sig).related (a.snd, a.fst) (b.snd, b.fst) ↔ Becoming.ModelStatements.descentRel L V a b
@Becoming.ModelStatements.descent_neutral_iff : ∀ {X : Type} (L : Becoming.Flow X X) (V : Becoming.Web X X) {Pos : Type}
  (own sig : Pos → X × Nat → Prop),
  Becoming.Neutral (L.descent V own sig).transmits ↔
    ∀ (p : Pos),
      Becoming.«闭»
        (Becoming.«合» (Becoming.ModelStatements.descentRel L V) fun x b => Becoming.ModelStatements.livingOcc V b)
        fun a => sig p (a.snd, a.fst)
@Becoming.ModelStatements.descent_reaches_reading : ∀ {X Pos : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {sig : Pos → X × Nat → Prop},
  (∀ (p : Pos),
      Becoming.«闭»
        (Becoming.«合» (Becoming.ModelStatements.descentRel L W) fun x b => Becoming.ModelStatements.livingOcc W b)
        fun a => sig p (a.snd, a.fst)) →
    ∀ {p : Pos} {a b : Nat × X},
      Becoming.ModelStatements.descendsRel L W a b →
        sig p (a.snd, a.fst) → Becoming.ModelStatements.livingOcc W b → sig p (b.snd, b.fst)
@Becoming.ModelStatements.retains_iff : ∀ {F C Pos : Type} (W : Becoming.Web F C) (sig : Pos → Nat → F → Prop) (p : Pos)
  (l l' : Nat → C → Nat),
  W.Retains sig p l l' ↔
    Becoming.«则» (Becoming.«合» (Becoming.ModelStatements.significantAt sig p) (W.admitted l')) (W.admitted l)
@Becoming.ModelStatements.adds_iff : ∀ {F C Pos : Type} (W : Becoming.Web F C) (sig : Pos → Nat → F → Prop) (p : Pos)
  (l l' : Nat → C → Nat),
  W.Adds sig p l l' ↔
    Becoming.«逾» (Becoming.«合» (Becoming.ModelStatements.significantAt sig p) (W.admitted l)) (W.admitted l')
@Becoming.ModelStatements.significant_iff_livingClaim : ∀ {F C Pos : Type} (W : Becoming.Web F C)
  (own sig : Pos → F × Nat → Prop),
  (W.valuation own sig).Significant ↔
    ∀ (q : Pos),
      Becoming.«则» (Becoming.Web.partialIdentity (Becoming.ModelStatements.livingClaim W))
        (Becoming.Web.partialIdentity (sig q))
@Becoming.ModelStatements.significance_undetermined_reading : ∀ {F C Pos : Type} (W : Becoming.Web F C) (p : Pos)
  {e : F × Nat},
  Becoming.ModelStatements.livingClaim W e →
    (∀ (l l' : Nat → C → Nat),
        Becoming.«则» (Becoming.«合» (Becoming.ModelStatements.significantAt (fun x x_1 x_2 => False) p) (W.admitted l'))
            (W.admitted l) ∧
          ¬Becoming.«逾»
              (Becoming.«合» (Becoming.ModelStatements.significantAt (fun x x_1 x_2 => False) p) (W.admitted l))
