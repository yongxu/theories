@Becoming.ModelStatements.supported_iff : ∀ {X : Type} (V : Becoming.Web X X) (t : Nat) (x : X),
  V.Supported t x ↔
    Becoming.«则»
      (Becoming.«而» (Becoming.Web.partialIdentity fun x_1 => x_1 = (t, x)) (Becoming.ModelStatements.requiring V))
      (Becoming.ModelStatements.needMet V)
@Becoming.ModelStatements.dependent_iff : ∀ {X : Type} (V : Becoming.Web X X),
  V.Dependent ↔
    Becoming.«则»
      (Becoming.«而» (Becoming.Web.partialIdentity (Becoming.ModelStatements.activeAt V))
        (Becoming.ModelStatements.requiring V))
      (Becoming.ModelStatements.needMet V)
@Becoming.ModelStatements.kept_iff : ∀ {X : Type} (V : Becoming.Web X X) (t : Nat) (g c : X),
  V.Kept t g c ↔ Becoming.ModelStatements.keptAcross V (t, c) (t, g)
@Becoming.ModelStatements.renewingAt_iff : ∀ {X : Type} (V : Becoming.Web X X) (t : Nat) (f : X),
  Becoming.Web.RenewingAt t f ↔
    Becoming.ModelStatements.activeAt V (t, f) ∧
      Becoming.«则»
        (Becoming.«而» (Becoming.Web.partialIdentity (Becoming.ModelStatements.participating V (t, f)))
          (Becoming.«逆» (Becoming.ModelStatements.requiring V)))
        (Becoming.ModelStatements.keptAcross V)
@Becoming.ModelStatements.renewingOver_iff : ∀ {X : Type} (V : Becoming.Web X X) (region : X → Prop) (t : Nat) (f : X),
  V.RenewingOver region t f ↔
    Becoming.ModelStatements.activeAt V (t, f) ∧
      Becoming.«则»
        (Becoming.«而»
          (Becoming.Web.partialIdentity fun y => Becoming.ModelStatements.participating V (t, f) y ∧ region y.snd)
          (Becoming.«逆» (Becoming.ModelStatements.requiring V)))
        (Becoming.ModelStatements.keptAcross V)
@Becoming.ModelStatements.renewingIn_iff : ∀ {X : Type} (V : Becoming.Web X X) (f : X),
  V.RenewingIn f ↔
    Becoming.«则»
      (Becoming.«而»
        (Becoming.Web.partialIdentity fun y =>
          Becoming.«能»
            (Becoming.«逆»
              (Becoming.«而»
                (Becoming.«而» (Becoming.Web.partialIdentity fun a => a.snd = f)
                  (Becoming.ModelStatements.participating V))
                Becoming.ModelStatements.sameName))
            y)
        (Becoming.«逆» (Becoming.ModelStatements.requiring V)))
      (Becoming.ModelStatements.keptAcross V)
@Becoming.ModelStatements.underminingAt_iff : ∀ {X : Type} (V : Becoming.Web X X) (t : Nat) (f : X),
  Becoming.Web.UnderminingAt t f ↔
    Becoming.«能»
      (Becoming.«而» (Becoming.ModelStatements.drawing V)
        (Becoming.«合» (Becoming.«逆» (Becoming.ModelStatements.requiring V)) (Becoming.ModelStatements.undermined V)))
      (t, f)
@Becoming.ModelStatements.living_iff : ∀ {X : Type} (V : Becoming.Web X X) (t : Nat) (x : X),
  V.active t x ∧ ¬Becoming.Web.UnderminingAt t x ↔
    Becoming.ModelStatements.activeAt V (t, x) ∧
      ¬Becoming.«能»
          (Becoming.«而» (Becoming.ModelStatements.drawing V)
            (Becoming.«合» (Becoming.«逆» (Becoming.ModelStatements.requiring V))
              (Becoming.ModelStatements.undermined V)))
          (t, x)
@Becoming.ModelStatements.inheritsAt_iff : ∀ {X : Type} (V : Becoming.Web X X) (t : Nat) (x g c : X),
  V.InheritsAt t x g c ↔
    Becoming.«则»
      (Becoming.«而»
        (Becoming.«而» (Becoming.«逆» (Becoming.ModelStatements.atPair (t + 1, x) (t, g)))
          (Becoming.«而» (Becoming.ModelStatements.requiring V) (Becoming.Web.partialIdentity fun w => w.snd = c)))
        (Becoming.«逆» Becoming.Steps.along))
      (Becoming.ModelStatements.requiring V)
@Becoming.ModelStatements.needsWithinAt_iff : ∀ {X : Type} (V : Becoming.Web X X) (t : Nat) (x g c : X) (δ : Nat),
  V.NeedsWithinAt t x g c δ ↔
    Becoming.«则»
      (Becoming.«合» (Becoming.ModelStatements.atPair (t + 1, x) (t, g)) fun u v =>
        Becoming.ModelStatements.requiringOf V c u ∧ Becoming.ModelStatements.requiringOf V c v)
      (Becoming.ModelStatements.needWithin V δ c)
@Becoming.ModelStatements.transmits_at_one_kind : ∀ {X : Type} (V : Becoming.Web X X) (t : Nat) (x g c : X) (δ : Nat),
  V.requires (t + 1) x c → V.requires t g c ∧ V.need (t + 1) x c ≤ V.need t g c + δ ↔
    Becoming.«则»
        (Becoming.«而»
          (Becoming.«而» (Becoming.«逆» (Becoming.ModelStatements.atPair (t + 1, x) (t, g)))
            (Becoming.«而» (Becoming.ModelStatements.requiring V) (Becoming.Web.partialIdentity fun w => w.snd = c)))
          (Becoming.«逆» Becoming.Steps.along))
        (Becoming.ModelStatements.requiring V) ∧
      Becoming.«则»
        (Becoming.«合» (Becoming.ModelStatements.atPair (t + 1, x) (t, g)) fun u v =>
          Becoming.ModelStatements.requiringOf V c u ∧ Becoming.ModelStatements.requiringOf V c v)
        (Becoming.ModelStatements.needWithin V δ c)
@Becoming.ModelStatements.roles_renewingAt : ∀ {F C : Type} (W : Becoming.Web F C) (t : Nat) (f : F),
  Becoming.Web.RenewingAt t (Sum.inl f) ↔ Becoming.Web.RenewingAt t f
@Becoming.ModelStatements.roles_renewingOver : ∀ {F C : Type} (W : Becoming.Web F C) (region : C → Prop) (t : Nat)
  (f : F), W.roles.RenewingOver (Becoming.ModelStatements.onConditions region) t (Sum.inl f) ↔ W.RenewingOver region t f
@Becoming.ModelStatements.roles_supported_reading : ∀ {F C : Type} (W : Becoming.Web F C) (t : Nat) (f : F),
  W.Supported t f ↔
    Becoming.«则»
      (Becoming.«而» (Becoming.Web.partialIdentity fun x => x = (t, Sum.inl f))
        (Becoming.ModelStatements.requiring W.roles))
