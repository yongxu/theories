          (Becoming.«而» (Becoming.ModelStatements.drawing W.roles)
            (Becoming.«合» (Becoming.«逆» (Becoming.ModelStatements.requiring W.roles))
              (Becoming.ModelStatements.undermined W.roles)))
          (t, Sum.inl f)
@Becoming.ModelStatements.renewingAt_reading : ∀ {F C : Type} (W : Becoming.Web F C) (t : Nat) (f : F),
  Becoming.Web.RenewingAt t f ↔
    Becoming.ModelStatements.activeAt W.roles (t, Sum.inl f) ∧
      Becoming.«则»
        (Becoming.«而» (Becoming.Web.partialIdentity (Becoming.ModelStatements.participating W.roles (t, Sum.inl f)))
          (Becoming.«逆» (Becoming.ModelStatements.requiring W.roles)))
        (Becoming.ModelStatements.keptAcross W.roles)
@Becoming.ModelStatements.renewingOver_reading : ∀ {F C : Type} (W : Becoming.Web F C) (region : C → Prop) (t : Nat)
  (f : F),
  W.RenewingOver region t f ↔
    Becoming.ModelStatements.activeAt W.roles (t, Sum.inl f) ∧
      Becoming.«则»
        (Becoming.«而»
          (Becoming.Web.partialIdentity fun y =>
            Becoming.ModelStatements.participating W.roles (t, Sum.inl f) y ∧
              Becoming.ModelStatements.onConditions region y.snd)
          (Becoming.«逆» (Becoming.ModelStatements.requiring W.roles)))
        (Becoming.ModelStatements.keptAcross W.roles)
@Becoming.ModelStatements.renewingAt_iff_over_all_reading : ∀ {F C : Type} (W : Becoming.Web F C) (t : Nat) (f : F),
  Becoming.ModelStatements.activeAt W.roles (t, Sum.inl f) ∧
      Becoming.«则»
        (Becoming.«而» (Becoming.Web.partialIdentity (Becoming.ModelStatements.participating W.roles (t, Sum.inl f)))
          (Becoming.«逆» (Becoming.ModelStatements.requiring W.roles)))
        (Becoming.ModelStatements.keptAcross W.roles) ↔
    Becoming.ModelStatements.activeAt W.roles (t, Sum.inl f) ∧
      Becoming.«则»
        (Becoming.«而»
          (Becoming.Web.partialIdentity fun y =>
            Becoming.ModelStatements.participating W.roles (t, Sum.inl f) y ∧
              Becoming.ModelStatements.onConditions (fun x => True) y.snd)
          (Becoming.«逆» (Becoming.ModelStatements.requiring W.roles)))
        (Becoming.ModelStatements.keptAcross W.roles)
@Becoming.ModelStatements.transmits_at_reading : ∀ {F C : Type} (W : Becoming.Web F C) (t : Nat) (x g : F) (c : C)
  (δ : Nat),
  W.requires (t + 1) x c → W.requires t g c ∧ W.need (t + 1) x c ≤ W.need t g c + δ ↔
    Becoming.«则»
        (Becoming.«而»
          (Becoming.«而» (Becoming.«逆» (Becoming.ModelStatements.atPair (t + 1, Sum.inl x) (t, Sum.inl g)))
            (Becoming.«而» (Becoming.ModelStatements.requiring W.roles)
              (Becoming.Web.partialIdentity fun w => w.snd = Sum.inr c)))
          (Becoming.«逆» Becoming.Steps.along))
        (Becoming.ModelStatements.requiring W.roles) ∧
      Becoming.«则»
        (Becoming.«合» (Becoming.ModelStatements.atPair (t + 1, Sum.inl x) (t, Sum.inl g)) fun u v =>
          Becoming.ModelStatements.requiringOf W.roles (Sum.inr c) u ∧
            Becoming.ModelStatements.requiringOf W.roles (Sum.inr c) v)
        (Becoming.ModelStatements.needWithin W.roles δ (Sum.inr c))
@Becoming.ModelStatements.partialIdentity_le_iff : ∀ {α : Type} {P Q : α → Prop},
  Becoming.«则» (Becoming.Web.partialIdentity P) (Becoming.Web.partialIdentity Q) ↔ ∀ (x : α), P x → Q x
@Becoming.ModelStatements.significant_iff_reading : ∀ {Pos C : Type} (V : Becoming.Valuation Pos C),
  V.Significant ↔
    ∀ (p : Pos), Becoming.«则» (Becoming.Web.partialIdentity V.living) (Becoming.Web.partialIdentity (V.sig p))
@Becoming.ModelStatements.selfSignificance_iff_reading : ∀ {Pos C : Type} (V : Becoming.Valuation Pos C) (p : Pos),
  V.SelfSignificance p ↔
    Becoming.«则» (Becoming.«合» (Becoming.Web.partialIdentity (V.own p)) (Becoming.Web.partialIdentity V.living))
      (Becoming.Web.partialIdentity (V.sig p))
@Becoming.ModelStatements.shares_iff_reading : ∀ {Pos C : Type} (V : Becoming.Valuation Pos C),
  Becoming.Neutral V.shares ↔
    ∀ (p q : Pos),
      Becoming.«则» (Becoming.«合» (Becoming.Web.partialIdentity V.living) (Becoming.Web.partialIdentity (V.sig p)))
        (Becoming.Web.partialIdentity (V.sig q))
@Becoming.ModelStatements.held_iff_reading : ∀ {Pos C : Type} (V : Becoming.Valuation Pos C),
  V.Held ↔ Becoming.«则» (Becoming.Web.partialIdentity V.living) (Becoming.Web.partialIdentity fun c => ∃ p, V.own p c)
@Becoming.ModelStatements.significant_iff_held_reading : ∀ {Pos C : Type} (V : Becoming.Valuation Pos C),
  Becoming.«则» (Becoming.Web.partialIdentity V.living) (Becoming.Web.partialIdentity fun c => ∃ p, V.own p c) →
    ((∀ (p : Pos), Becoming.«则» (Becoming.Web.partialIdentity V.living) (Becoming.Web.partialIdentity (V.sig p))) ↔
      (∀ (p : Pos),
          Becoming.«则» (Becoming.«合» (Becoming.Web.partialIdentity (V.own p)) (Becoming.Web.partialIdentity V.living))
            (Becoming.Web.partialIdentity (V.sig p))) ∧
        ∀ (p q : Pos),
          Becoming.«则» (Becoming.«合» (Becoming.Web.partialIdentity V.living) (Becoming.Web.partialIdentity (V.sig p)))
            (Becoming.Web.partialIdentity (V.sig q)))
@Becoming.ModelStatements.neutral_transmits_iff : ∀ {Pos C : Type} (V : Becoming.Valuation Pos C),
  Becoming.Neutral V.transmits ↔ ∀ (p : Pos), Becoming.«闭» (Becoming.«合» V.related fun x d => V.living d) (V.sig p)
@Becoming.ModelStatements.livesOn_iff : ∀ {X : Type} (V : Becoming.Web X X) (a b : Nat × X),
  V.LivesOn (a.snd, a.fst) (b.snd, b.fst) ↔ Becoming.ModelStatements.livesOn V a b
@Becoming.ModelStatements.interacts_iff : ∀ {X : Type} (V : Becoming.Web X X) (a b : Nat × X),
  (∃ c, V.Interacts c (a.snd, a.fst) (b.snd, b.fst)) ↔ Becoming.ModelStatements.interacts V a b
@Becoming.ModelStatements.sustenance_related_iff : ∀ {X : Type} (V : Becoming.Web X X) {Pos : Type}
  (own sig : Pos → X × Nat → Prop) (a b : Nat × X),
  (V.sustenance own sig).related (a.snd, a.fst) (b.snd, b.fst) ↔ Becoming.ModelStatements.sustenanceRel V a b
@Becoming.ModelStatements.sustenance_neutral_iff : ∀ {X : Type} (V : Becoming.Web X X) {Pos : Type}
  (own sig : Pos → X × Nat → Prop),
  Becoming.Neutral (V.sustenance own sig).transmits ↔
    ∀ (p : Pos),
      Becoming.«闭»
        (Becoming.«合» (Becoming.ModelStatements.sustenanceRel V) fun x b => Becoming.ModelStatements.livingOcc V b)
        fun a => sig p (a.snd, a.fst)
@Becoming.ModelStatements.living_on_reaches_reading : ∀ {X Pos : Type} {W : Becoming.Web X X}
  {sig : Pos → X × Nat → Prop},
  (∀ (p : Pos),
      Becoming.«闭»
        (Becoming.«合» (Becoming.ModelStatements.sustenanceRel W) fun x b => Becoming.ModelStatements.livingOcc W b)
