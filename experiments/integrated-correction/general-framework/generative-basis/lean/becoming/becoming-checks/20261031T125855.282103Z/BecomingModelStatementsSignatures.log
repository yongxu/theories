@Becoming.ModelStatements.roles_dependent_reading : ∀ {F C : Type} (W : Becoming.Web F C),
  W.Dependent ↔
    Becoming.«则»
      (Becoming.«而» (Becoming.Web.partialIdentity (Becoming.ModelStatements.activeAt W.roles))
        (Becoming.ModelStatements.requiring W.roles))
      (Becoming.ModelStatements.needMet W.roles)
@Becoming.ModelStatements.roles_alive_reading : ∀ {F C : Type} (W : Becoming.Web F C) (t : Nat) (f : F),
  W.active t f ∧ ¬Becoming.Web.UnderminingAt t f ↔
    Becoming.ModelStatements.activeAt W.roles (t, Sum.inl f) ∧
