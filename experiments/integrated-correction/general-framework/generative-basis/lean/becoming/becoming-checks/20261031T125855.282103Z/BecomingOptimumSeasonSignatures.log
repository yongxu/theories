Becoming.Optimum.Season.top_caught : Becoming.Optimum.Season.caught Becoming.Optimum.Season.topTakes 10 = 34
Becoming.Optimum.Season.topTakes_length : Becoming.Optimum.Season.topTakes.length = 10
@Becoming.Optimum.Season.eligible_parts : ∀ {o : Becoming.Optimum.Season.Cond → Nat},
  Becoming.Optimum.Season.Eligible o →
    ∃ g k d,
      g ≤ 34 ∧
        k ≤ 6 ∧
          d ≤ 10 ∧
            o Becoming.Optimum.Season.Cond.catch = g + k ∧
              o Becoming.Optimum.Season.Cond.ground = g ∧
                o Becoming.Optimum.Season.Cond.bay = 6 - k ∧ o Becoming.Optimum.Season.Cond.site = 10 - d
