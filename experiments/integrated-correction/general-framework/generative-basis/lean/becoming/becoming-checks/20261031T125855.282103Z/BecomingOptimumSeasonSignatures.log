Becoming.Optimum.Season.outcome_ground : ∀ (as : List Becoming.Optimum.Season.Act),
  Becoming.Optimum.Season.outcome (Becoming.Optimum.Season.run as Becoming.Optimum.Season.start)
      Becoming.Optimum.Season.Cond.ground =
    Becoming.Optimum.Season.caught as 10
Becoming.Optimum.Season.outcome_catch : ∀ (as : List Becoming.Optimum.Season.Act),
  Becoming.Optimum.Season.outcome (Becoming.Optimum.Season.run as Becoming.Optimum.Season.start)
      Becoming.Optimum.Season.Cond.catch =
    Becoming.Optimum.Season.caught as 10 + Becoming.Optimum.Season.least 6 (Becoming.Optimum.Season.asked as)
Becoming.Optimum.Season.outcome_bay : ∀ (as : List Becoming.Optimum.Season.Act),
  Becoming.Optimum.Season.outcome (Becoming.Optimum.Season.run as Becoming.Optimum.Season.start)
      Becoming.Optimum.Season.Cond.bay =
    6 - Becoming.Optimum.Season.least 6 (Becoming.Optimum.Season.asked as)
Becoming.Optimum.Season.outcome_site : ∀ (as : List Becoming.Optimum.Season.Act),
  Becoming.Optimum.Season.outcome (Becoming.Optimum.Season.run as Becoming.Optimum.Season.start)
      Becoming.Optimum.Season.Cond.site =
    10 - Becoming.Optimum.Season.landings as
@Becoming.Optimum.Season.eligible_of : ∀ {as : List Becoming.Optimum.Season.Act},
  as.length = 10 →
    ∀ {k d : Nat},
      k ≤ 6 →
        d ≤ 10 →
          ∀ {o : Becoming.Optimum.Season.Cond → Nat},
            o Becoming.Optimum.Season.Cond.catch = Becoming.Optimum.Season.caught as 10 + k →
              o Becoming.Optimum.Season.Cond.ground = Becoming.Optimum.Season.caught as 10 →
                o Becoming.Optimum.Season.Cond.bay = 6 - k →
                  o Becoming.Optimum.Season.Cond.site = 10 - d → Becoming.Optimum.Season.Eligible o
Becoming.Optimum.Season.bellman : ∀ (n : Nat),
  n < 10 →
    ∀ (x : Nat),
      x < 11 →
        ∀ (j : Nat),
          j < 5 →
            Becoming.Optimum.Season.least j x +
                Becoming.Optimum.Season.best n (Becoming.Optimum.Season.renew (x - Becoming.Optimum.Season.least j x)) ≤
              Becoming.Optimum.Season.best (n + 1) x
Becoming.Optimum.Season.cap_lt : ∀ (h : Nat), Becoming.Optimum.Season.least h 4 < 5
Becoming.Optimum.Season.caught_le : ∀ (as : List Becoming.Optimum.Season.Act) (x : Nat),
  as.length ≤ 10 → x ≤ 10 → Becoming.Optimum.Season.caught as x ≤ Becoming.Optimum.Season.best as.length x
Becoming.Optimum.Season.best_ten : Becoming.Optimum.Season.best 10 10 = 34
@Becoming.Optimum.Season.ground_le : ∀ {as : List Becoming.Optimum.Season.Act},
