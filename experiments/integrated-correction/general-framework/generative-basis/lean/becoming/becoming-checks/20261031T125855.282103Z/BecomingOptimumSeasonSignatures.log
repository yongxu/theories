@Becoming.Optimum.Season.mix_bay_catch : ∀ {ps : List (Nat × (Becoming.Optimum.Season.Cond → Nat))},
  (∀ (p : Nat × (Becoming.Optimum.Season.Cond → Nat)), p ∈ ps → Becoming.Optimum.Season.Eligible p.snd) →
