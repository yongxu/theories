@Becoming.Optimum.Season.least_of_ge : ∀ {a b : Nat}, b ≤ a → Becoming.Optimum.Season.least a b = b
Becoming.Optimum.Season.least_zero_right : ∀ (a : Nat), Becoming.Optimum.Season.least a 0 = 0
Becoming.Optimum.Season.renew_le : ∀ (y : Nat), y < 11 → Becoming.Optimum.Season.renew y ≤ 10
