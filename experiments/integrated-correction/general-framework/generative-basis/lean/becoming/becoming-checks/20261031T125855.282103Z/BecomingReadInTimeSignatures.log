@Becoming.ReadInTime.kept_iff : ∀
  {fB : Becoming.RuleCapture.CarrierCounts × Nat → Becoming.RuleCapture.CarrierCounts → Nat} {a p c hi lo lo' N : Nat}
  {pos : 0 < a} {reads : Nat → Bool},
  Becoming.ClosedCapture.Accrues fB →
    lo' ≤ hi →
      ∀ {s : (Becoming.RuleCapture.CarrierCounts × Nat) × Becoming.RuleCapture.CarrierCounts} {r : Nat},
        reads r = true →
          N ≤ (Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s r).fst.snd →
            (Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s r).snd.favours →
              ((∀ (k : Nat),
                  Becoming.RuleCapture.Locked Becoming.RuleCapture.CarrierCounts.order
                    Becoming.RuleCapture.CarrierCounts.favours (Becoming.DrawnShaping.drawnRead a p c hi lo' pos)
                    ((Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s (r + (1 + k))).fst.fst,
                      (Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s (r + (1 + k))).snd)) ↔
                (Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s r).fst.fst.carrier * c +
                    (Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s r).fst.fst.other * c ≤
                  (Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s r).fst.fst.carrier * hi +
                    (Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s r).fst.fst.other * lo')
@Becoming.ReadInTime.loss_next : ∀
  {fB : Becoming.RuleCapture.CarrierCounts × Nat → Becoming.RuleCapture.CarrierCounts → Nat} {a p c hi lo lo' N : Nat}
  {pos : 0 < a} {reads : Nat → Bool},
  Becoming.ClosedCapture.Accrues fB →
    ∀ (s : (Becoming.RuleCapture.CarrierCounts × Nat) × Becoming.RuleCapture.CarrierCounts) (r : Nat),
      (Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s r).fst.snd + 1 ≤
        (Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s (r + 1)).fst.snd
@Becoming.ReadInTime.turned_iff : ∀
  {fB : Becoming.RuleCapture.CarrierCounts × Nat → Becoming.RuleCapture.CarrierCounts → Nat} {a p c hi lo lo' N : Nat}
  {pos : 0 < a} {reads : Nat → Bool},
  Becoming.ClosedCapture.Accrues fB →
    lo' ≤ hi →
      ∀ {s : (Becoming.RuleCapture.CarrierCounts × Nat) × Becoming.RuleCapture.CarrierCounts} {r : Nat},
        reads r = true →
          reads (r + 1) = true →
            N ≤ (Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s r).fst.snd →
              (Becoming.DrawnShaping.drawn a p c hi lo' pos
                    (Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s r).fst.fst).disfavours →
                ((∀ (k : Nat),
                    Becoming.RuleCapture.Locked (Becoming.RuleCapture.reverse Becoming.RuleCapture.CarrierCounts.order)
                      Becoming.RuleCapture.CarrierCounts.disfavours (Becoming.DrawnShaping.drawnRead a p c hi lo' pos)
                      ((Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s (r + 1 + (1 + k))).fst.fst,
                        (Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s (r + 1 + (1 + k))).snd)) ↔
                  (Becoming.DrawnShaping.drawn a p c hi lo' pos
                      (Becoming.ReadInTime.course fB a p c hi lo lo' N pos reads s (r + 1)).fst.fst).disfavours)
@Becoming.ReadInTime.shapedLossPool_before : ∀ {a p c hi lo lo' N : Nat} {pos : 0 < a} {ℓ : Nat},
  ℓ < N →
    ∀ (x g : Becoming.RuleCapture.CarrierCounts),
      Becoming.ReadInTime.shapedLossPool a p c hi lo lo' N pos (x, ℓ) g = Becoming.DrawnShaping.drawn a p c hi lo pos x
@Becoming.ReadInTime.turn_before : ∀ {a p c hi lo lo' N : Nat} {pos : 0 < a} (b : Bool)
  (q : (Becoming.RuleCapture.CarrierCounts × Nat) × Becoming.RuleCapture.CarrierCounts),
  q.fst.snd < N →
    ((Becoming.Pace.turn
                (Becoming.ClosedCapture.join Becoming.RuleCapture.CarrierCounts.select
                  Becoming.ClosedCapture.Beyond.lossStep)
                (Becoming.ReadInTime.shapedLossPool a p c hi lo lo' N pos) b q).fst.fst,
          (Becoming.Pace.turn
              (Becoming.ClosedCapture.join Becoming.RuleCapture.CarrierCounts.select
                Becoming.ClosedCapture.Beyond.lossStep)
              (Becoming.ReadInTime.shapedLossPool a p c hi lo lo' N pos) b q).snd) =
        Becoming.Pace.turn Becoming.RuleCapture.CarrierCounts.select (Becoming.DrawnShaping.drawnRead a p c hi lo pos) b
          (q.fst.fst, q.snd) ∧
      (Becoming.Pace.turn
              (Becoming.ClosedCapture.join Becoming.RuleCapture.CarrierCounts.select
                Becoming.ClosedCapture.Beyond.lossStep)
              (Becoming.ReadInTime.shapedLossPool a p c hi lo lo' N pos) b q).fst.snd =
        q.fst.snd + 1
