Becoming.Reconfiguration.fails_mono : ∀ (a b : List Nat),
  Becoming.Reconfiguration.Subset a b →
    ∀ (e : Becoming.Reconfiguration.FaultFormula),
      Becoming.Reconfiguration.fails e a = true → Becoming.Reconfiguration.fails e b = true
Becoming.Reconfiguration.survives_of_included : ∀ (e : Becoming.Reconfiguration.FaultFormula) (a b : List Nat),
  Becoming.Reconfiguration.Subset a b →
    Becoming.Reconfiguration.fails e b = false → Becoming.Reconfiguration.fails e a = false
Becoming.Reconfiguration.mem_induced_iff : ∀ (a : Becoming.Reconfiguration.Arrangement) (roots : List Nat)
  (d : Becoming.FaultEnvelopes.Domain),
  d ∈ Becoming.Reconfiguration.induced a roots ↔
    d ∈ a.roster ∧ Becoming.Reconfiguration.fails (a.vulnerability d) roots = true
Becoming.Reconfiguration.induced_mono : ∀ (a : Becoming.Reconfiguration.Arrangement) (x y : List Nat),
  Becoming.Reconfiguration.Subset x y →
    Becoming.Reconfiguration.Subset (Becoming.Reconfiguration.induced a x) (Becoming.Reconfiguration.induced a y)
Becoming.Reconfiguration.outside_bound_survives : ∀ (a : Becoming.Reconfiguration.Arrangement)
  (actual bound : List Nat),
  Becoming.Reconfiguration.Subset actual bound →
    ∀ (d : Becoming.FaultEnvelopes.Domain),
      d ∈ a.roster →
        ¬d ∈ Becoming.Reconfiguration.induced a bound →
          Becoming.Reconfiguration.fails (a.vulnerability d) actual = false
@Becoming.Reconfiguration.induced_mem_envelope : ∀ {a : Becoming.Reconfiguration.Arrangement} {bound : List Nat},
  bound ∈ a.rootFaults → Becoming.Reconfiguration.induced a bound ∈ Becoming.Reconfiguration.envelope a
Becoming.Reconfiguration.induced_certificate_sound : ∀ (a : Becoming.Reconfiguration.Arrangement) (actual : List Nat),
  Becoming.Reconfiguration.Covered a actual →
    ∀ (supports : Becoming.FaultEnvelopes.Domain → Bool) (P : Prop),
      (∀ (d : Becoming.FaultEnvelopes.Domain),
          d ∈ a.roster → Becoming.Reconfiguration.fails (a.vulnerability d) actual = false → supports d = true → P) →
        Becoming.FaultEnvelopes.certificate a.roster (Becoming.Reconfiguration.envelope a) supports = true → P
@Becoming.Reconfiguration.not_induced : ∀ {a : Becoming.Reconfiguration.Arrangement} {roots : List Nat}
  {d : Becoming.FaultEnvelopes.Domain},
  Becoming.Reconfiguration.fails (a.vulnerability d) roots = false → ¬d ∈ Becoming.Reconfiguration.induced a roots
Becoming.Reconfiguration.ready_separates : ∀ (a : Becoming.Reconfiguration.Arrangement),
  Becoming.Reconfiguration.ready a = true →
    Becoming.FaultEnvelopes.separated a.roster (Becoming.Reconfiguration.envelope a)
Becoming.Reconfiguration.ready_iff_nonempty_separated : ∀ (a : Becoming.Reconfiguration.Arrangement),
  Becoming.Reconfiguration.ready a = true ↔
    a.rootFaults ≠ [] ∧ Becoming.FaultEnvelopes.separated a.roster (Becoming.Reconfiguration.envelope a)
Becoming.Reconfiguration.induced_certificate_available : ∀ (a : Becoming.Reconfiguration.Arrangement)
  (actual : List Nat),
  Becoming.Reconfiguration.Covered a actual →
    Becoming.Reconfiguration.ready a = true →
      ∀ (supports : Becoming.FaultEnvelopes.Domain → Bool),
        (∀ (d : Becoming.FaultEnvelopes.Domain),
            d ∈ a.roster → Becoming.Reconfiguration.fails (a.vulnerability d) actual = false → supports d = true) →
          Becoming.FaultEnvelopes.certificate a.roster (Becoming.Reconfiguration.envelope a) supports = true
Becoming.Reconfiguration.induced_completes : ∀ (a : Becoming.Reconfiguration.Arrangement) (actual : List Nat),
  Becoming.Reconfiguration.Covered a actual →
    Becoming.Reconfiguration.ready a = true →
      ∀ (w : Becoming.Transactions.Installation) (p : Becoming.Transactions.Request)
        (reads : Becoming.Transactions.Readings) (approvals : Becoming.Transactions.Approvals),
        Becoming.Transactions.fresh w p = true →
          (∀ (d : Becoming.FaultEnvelopes.Domain),
              d ∈ a.roster →
                Becoming.Reconfiguration.fails (a.vulnerability d) actual = false →
                  reads d = some (Becoming.Transactions.expected p)) →
            (∀ (d : Becoming.FaultEnvelopes.Domain),
                d ∈ a.roster →
                  Becoming.Reconfiguration.fails (a.vulnerability d) actual = false → approvals d = some p) →
              (∀ (d : Becoming.FaultEnvelopes.Domain),
                  d ∈ a.roster →
                    Becoming.Reconfiguration.fails (a.vulnerability d) actual = false →
                      ∀ (o : Becoming.Transactions.Observation),
                        reads d = some o → o = Becoming.Transactions.observed w p.address) →
                (∀ (d : Becoming.FaultEnvelopes.Domain),
                    d ∈ a.roster →
                      Becoming.Reconfiguration.fails (a.vulnerability d) actual = false →
                        approvals d = some p → Becoming.Transactions.withinScope w p = true) →
                  Becoming.Transactions.load a.roster p + 3 ≤ w.state.reserve →
                    w.state.time + Becoming.Transactions.load a.roster p + 3 ≤ w.state.deadline →
                      (Becoming.Transactions.guardedExecute a.roster (Becoming.Reconfiguration.envelope a)
                              (Becoming.Reconfiguration.envelope a) w p reads approvals).succeeded =
                          true ∧
                        (Becoming.Transactions.guardedExecute a.roster (Becoming.Reconfiguration.envelope a)
                                    (Becoming.Reconfiguration.envelope a) w p reads
                                    approvals).installation.state.completed =
                            true ∧
                          Becoming.Transactions.withinScope w p = true
@Becoming.Reconfiguration.admits_true_iff : ∀ {opened : Bool} {amount depth : Nat}
  {candidate : Becoming.Reconfiguration.Arrangement} {old : Becoming.Reconfiguration.Managed},
  Becoming.Reconfiguration.admits opened amount depth candidate old = true ↔
    opened = true ∧
      Becoming.Reconfiguration.ready candidate = true ∧
        amount + Becoming.Reconfiguration.responseLoad candidate depth ≤ old.installation.state.reserve ∧
          old.installation.state.time + amount + Becoming.Reconfiguration.responseLoad candidate depth ≤
            old.installation.state.deadline
@Becoming.Reconfiguration.reconfigure_some : ∀ {opened : Bool} {amount depth : Nat}
  {candidate : Becoming.Reconfiguration.Arrangement} {old next : Becoming.Reconfiguration.Managed},
  Becoming.Reconfiguration.reconfigure opened amount depth candidate old = some next →
    Becoming.Reconfiguration.admits opened amount depth candidate old = true ∧
      next = { arrangement := candidate, installation := Becoming.Reconfiguration.renewedBy amount old }
Becoming.Reconfiguration.reconfigure_renews : ∀ (opened : Bool) (amount depth : Nat)
  (candidate : Becoming.Reconfiguration.Arrangement) (old next : Becoming.Reconfiguration.Managed),
  Becoming.Reconfiguration.reconfigure opened amount depth candidate old = some next →
    opened = true ∧
      Becoming.Reconfiguration.ready candidate = true ∧
        next.arrangement = candidate ∧
          next.installation.scope = old.installation.scope ∧
            next.installation.root = old.installation.root ∧
              next.installation.state.epoch = old.installation.state.epoch + 1 ∧
                next.installation.serial = old.installation.serial + 1 ∧
                  next.installation.state.signed = false ∧
                    next.installation.state.drawn = old.installation.state.drawn + amount ∧
                      next.installation.state.reserve + amount = old.installation.state.reserve ∧
                        Becoming.Reconfiguration.responseLoad candidate depth ≤ next.installation.state.reserve ∧
                          next.installation.state.time + Becoming.Reconfiguration.responseLoad candidate depth ≤
                            next.installation.state.deadline
Becoming.Reconfiguration.reconfigure_keeps_scope : ∀ (opened : Bool) (amount depth : Nat)
  (candidate : Becoming.Reconfiguration.Arrangement) (old next : Becoming.Reconfiguration.Managed),
  Becoming.Reconfiguration.reconfigure opened amount depth candidate old = some next →
    ∀ (command : Becoming.Actuation.Command),
      Becoming.Transactions.permits next.installation.scope command =
        Becoming.Transactions.permits old.installation.scope command
Becoming.Reconfiguration.reconfigure_stales_epoch : ∀ (opened : Bool) (amount depth : Nat)
  (candidate : Becoming.Reconfiguration.Arrangement) (old next : Becoming.Reconfiguration.Managed),
  Becoming.Reconfiguration.reconfigure opened amount depth candidate old = some next →
    ∀ (p : Becoming.Transactions.Request),
      p.epoch = old.installation.state.epoch → Becoming.Transactions.fresh next.installation p = false
Becoming.Reconfiguration.responseLoad_mono : ∀ (a : Becoming.Reconfiguration.Arrangement) {short long : Nat},
  short ≤ long → Becoming.Reconfiguration.responseLoad a short ≤ Becoming.Reconfiguration.responseLoad a long
Becoming.Reconfiguration.reconfigure_covers_shorter : ∀ (opened : Bool) (amount depth : Nat)
  (candidate : Becoming.Reconfiguration.Arrangement) (old next : Becoming.Reconfiguration.Managed),
  Becoming.Reconfiguration.reconfigure opened amount depth candidate old = some next →
    ∀ (actualDepth : Nat),
      actualDepth ≤ depth →
        Becoming.Reconfiguration.responseLoad candidate actualDepth ≤ next.installation.state.reserve ∧
          next.installation.state.time + Becoming.Reconfiguration.responseLoad candidate actualDepth ≤
            next.installation.state.deadline
Becoming.Reconfiguration.reconfigure_then_completes : ∀ (opened : Bool) (amount depth : Nat)
  (candidate : Becoming.Reconfiguration.Arrangement) (old next : Becoming.Reconfiguration.Managed),
  Becoming.Reconfiguration.reconfigure opened amount depth candidate old = some next →
    ∀ (actual : List Nat),
      Becoming.Reconfiguration.Covered candidate actual →
        ∀ (p : Becoming.Transactions.Request) (reads : Becoming.Transactions.Readings)
          (approvals : Becoming.Transactions.Approvals),
          List.length p.address ≤ depth →
            Becoming.Transactions.fresh next.installation p = true →
              (∀ (d : Becoming.FaultEnvelopes.Domain),
                  d ∈ candidate.roster →
                    Becoming.Reconfiguration.fails (candidate.vulnerability d) actual = false →
                      reads d = some (Becoming.Transactions.expected p)) →
                (∀ (d : Becoming.FaultEnvelopes.Domain),
                    d ∈ candidate.roster →
                      Becoming.Reconfiguration.fails (candidate.vulnerability d) actual = false →
                        approvals d = some p) →
                  (∀ (d : Becoming.FaultEnvelopes.Domain),
                      d ∈ candidate.roster →
                        Becoming.Reconfiguration.fails (candidate.vulnerability d) actual = false →
                          ∀ (o : Becoming.Transactions.Observation),
                            reads d = some o → o = Becoming.Transactions.observed next.installation p.address) →
                    (∀ (d : Becoming.FaultEnvelopes.Domain),
                        d ∈ candidate.roster →
                          Becoming.Reconfiguration.fails (candidate.vulnerability d) actual = false →
                            approvals d = some p → Becoming.Transactions.withinScope next.installation p = true) →
                      (Becoming.Transactions.guardedExecute next.arrangement.roster
                              (Becoming.Reconfiguration.envelope next.arrangement)
                              (Becoming.Reconfiguration.envelope next.arrangement) next.installation p reads
                              approvals).succeeded =
                          true ∧
                        (Becoming.Transactions.guardedExecute next.arrangement.roster
                                    (Becoming.Reconfiguration.envelope next.arrangement)
                                    (Becoming.Reconfiguration.envelope next.arrangement) next.installation p reads
                                    approvals).installation.state.completed =
                            true ∧
                          Becoming.Transactions.withinScope next.installation p = true
Becoming.Reconfiguration.and_false : ∀ (b : Bool), (b && false) = false
Becoming.Reconfiguration.unready_rejected : ∀ (opened : Bool) (amount depth : Nat)
