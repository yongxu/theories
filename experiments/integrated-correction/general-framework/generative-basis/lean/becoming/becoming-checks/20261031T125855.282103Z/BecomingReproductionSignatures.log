          (∀ (t : Nat), t < T → L.DissipatesOn ds t) →
            (W.stock ds T + Becoming.total (Becoming.steps 0 T) fun t => Becoming.sign (G.size (t + 1))) ≤ W.stock ds 0
@Becoming.Reproduction.Flow.lineage_ends : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {G : Becoming.SelectionTerm.Generations X} {ds : List X},
  Becoming.SelectionTerm.Flow.Descended L W G →
    (∀ (t : Nat) (p k : X), p ∈ G.family t → k ∈ G.kids t p → k ∈ ds) →
