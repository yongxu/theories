  0 < G.size 0 → G.size (S + 1) = 0 → ∃ m, m < S + 1 ∧ 0 < G.size m ∧ G.size (m + 1) = 0
@Becoming.Reproduction.Flow.closed_lineage_lowered : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {G : Becoming.SelectionTerm.Generations X} {ds : List X},
  Becoming.SelectionTerm.Flow.Descended L W G →
    (∀ (t : Nat) (p k : X), p ∈ G.family t → k ∈ G.kids t p → k ∈ ds) →
      (∀ (t : Nat), t < W.stock ds 0 + 1 → L.BalancesOn W ds t) →
        (∀ (t : Nat), t < W.stock ds 0 + 1 → L.DissipatesOn ds t) →
