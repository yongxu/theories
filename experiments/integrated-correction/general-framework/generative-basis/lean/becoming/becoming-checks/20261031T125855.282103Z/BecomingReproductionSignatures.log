@Becoming.Reproduction.Flow.closed_not_exact : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {G : Becoming.SelectionTerm.Generations X} {ds : List X},
  Becoming.SelectionTerm.Flow.Descended L W G →
    (∀ (t : Nat) (p k : X), p ∈ G.family t → k ∈ G.kids t p → k ∈ ds) →
