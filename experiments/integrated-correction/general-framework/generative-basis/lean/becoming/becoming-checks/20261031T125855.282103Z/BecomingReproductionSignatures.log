@Becoming.Reproduction.twice_le_of_le : ∀ {x y : Nat}, x ≤ y → 2 * (x * y) ≤ x * x + y * y
Becoming.Reproduction.twice_le : ∀ (x y : Nat), 2 * (x * y) ≤ x * x + y * y
Becoming.Reproduction.square_mul : ∀ (a b : Nat), a * b * (a * b) = a * a * (b * b)
Becoming.Reproduction.cross_mul : ∀ (a b c d : Nat), a * b * (c * d) = a * d * (c * b)
