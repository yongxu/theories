@Becoming.Reproduction.Generations.ByNumber.sum_eq : ∀ {α : Type} {G : Becoming.SelectionTerm.Generations α},
  Becoming.Reproduction.Generations.ByNumber G → ∀ (t : Nat), G.sum t = G.size (t + 1)
@Becoming.Reproduction.Generations.ByNumber.discord_none : ∀ {α : Type} {G : Becoming.SelectionTerm.Generations α},
  Becoming.Reproduction.Generations.ByNumber G → ∀ (t : Nat), G.discordAt t = 0
@Becoming.Reproduction.Generations.ByNumber.concord_eq : ∀ {α : Type} {G : Becoming.SelectionTerm.Generations α},
