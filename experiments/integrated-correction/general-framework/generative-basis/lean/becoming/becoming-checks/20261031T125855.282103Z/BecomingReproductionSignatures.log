Becoming.Reproduction.excess_cross : ∀ (x y : Nat), Becoming.excess x y * Becoming.excess y x = 0
@Becoming.Reproduction.le_of_excess_zero : ∀ {a b : Nat}, Becoming.excess a b = 0 → a ≤ b
