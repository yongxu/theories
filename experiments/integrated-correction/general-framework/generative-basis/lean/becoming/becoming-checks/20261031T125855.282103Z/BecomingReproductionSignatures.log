          Becoming.Distinct ks → ks.length + Becoming.sign ks.length ≤ Becoming.total ds (L.take t p)
@Becoming.Reproduction.Flow.born_within_stock : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {ds : List X} {t : Nat},
  L.BalancesOn W ds t →
    L.DissipatesOn ds t →
      ∀ {ps : List X} {kids : X → List X},
        (∀ (p k : X), p ∈ ps → k ∈ kids p → L.DescendsAt W t k p) →
          (∀ (p k : X), p ∈ ps → k ∈ kids p → k ∈ ds) →
            Becoming.Distinct (List.flatMap kids ps) →
              Becoming.SelectionTerm.born ps kids + L.takers ds t ≤ W.stock ds t
@Becoming.Reproduction.Flow.takers_pos_of_born : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {ds : List X} {t : Nat},
  L.DissipatesOn ds t →
    ∀ {ps : List X} {kids : X → List X},
      (∀ (p k : X), p ∈ ps → k ∈ kids p → L.DescendsAt W t k p) →
        (∀ (p k : X), p ∈ ps → k ∈ kids p → k ∈ ds) → 0 < Becoming.SelectionTerm.born ps kids → 0 < L.takers ds t
