  (σ : Nat → Nat) {s : Nat} {f : F},
  (∀ (j : Nat), j ∈ Becoming.span σ s → ¬f ∈ L.present j) → ∀ (c : C), (L.sample σ).take s f c = 0
@Becoming.ExchangeFlows.sample_give_absent : ∀ {F C : Type} [inst : DecidableEq F] (L : Becoming.Flow F C)
  (σ : Nat → Nat) {s : Nat} {f : F},
  (∀ (j : Nat), j ∈ Becoming.span σ s → ¬f ∈ L.present j) → ∀ (c : C), (L.sample σ).give s f c = 0
