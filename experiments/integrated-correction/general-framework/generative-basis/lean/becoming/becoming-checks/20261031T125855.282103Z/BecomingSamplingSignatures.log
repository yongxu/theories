  (∀ (s j : Nat) (x : F), σ s ≤ j → j < σ (s + 1) → (W.active j x ↔ W.active (σ s) x)) → W.Held σ
@Becoming.Flow.sample_acting_on : ∀ {F C : Type} [inst : DecidableEq F] {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {σ : Nat → Nat} {s : Nat} {f : F} {c : C},
  Becoming.Strict σ →
    (∀ (j : Nat), j ∈ Becoming.span σ s → f ∈ L.present j → 0 < L.give j f c → W.active j f) →
      (∀ (j : Nat), σ s ≤ j → j < σ (s + 1) → W.active j f → W.active (σ s) f) →
        0 < (L.sample σ).give s f c → (W.sample σ).active s f
@Becoming.Flow.sample_taking_on : ∀ {F C : Type} [inst : DecidableEq F] {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {σ : Nat → Nat} {s : Nat} {f : F} {c : C},
  Becoming.Strict σ →
    (∀ (j : Nat), j ∈ Becoming.span σ s → f ∈ L.present j → 0 < L.take j f c → W.active j f ∧ W.draws j f c) →
      (∀ (j : Nat), σ s ≤ j → j < σ (s + 1) → W.active j f → W.active (σ s) f) →
        (∀ (j : Nat), σ s ≤ j → j < σ (s + 1) → W.draws j f c → W.draws (σ s) f c) →
          0 < (L.sample σ).take s f c → (W.sample σ).active s f ∧ (W.sample σ).draws s f c
