@Becoming.Flow.RunsDownOn.sample : ∀ {F C : Type} [inst : DecidableEq F] {L : Becoming.Flow F C} (σ : Nat → Nat)
  {W : Becoming.Web F C} {es : List C} {s : Nat},
  Becoming.Strict σ →
    (∀ (j : Nat), j ∈ Becoming.span σ s → Becoming.Distinct (L.present j)) →
      Becoming.Distinct es →
        (∀ (c : C), 0 < W.level (σ s) c → c ∈ es) →
          (∀ (c : C), 0 < W.level (σ (s + 1)) c → c ∈ es) →
            (∀ (j : Nat), j ∈ Becoming.span σ s → L.BalancesOn W es j) →
              (∀ (j : Nat), j ∈ Becoming.span σ s → L.DissipatesOn es j) → (L.sample σ).RunsDownOn (W.sample σ) es s
@Becoming.Flow.RunsDownOn.sample_of_fine : ∀ {F C : Type} [inst : DecidableEq F] {L : Becoming.Flow F C} (σ : Nat → Nat)
  {W : Becoming.Web F C} {es : List C} {s : Nat},
  Becoming.Strict σ →
    (∀ (j : Nat), j ∈ Becoming.span σ s → Becoming.Distinct (L.present j)) →
      (∀ (j : Nat), j ∈ Becoming.span σ s → L.RunsDownOn W es j) → (L.sample σ).RunsDownOn (W.sample σ) es s
@Becoming.Flow.sample_changes_iff : ∀ {F C : Type} [DecidableEq F] {L : Becoming.Flow F C} (σ : Nat → Nat)
  {W : Becoming.Web F C} {es : List C} {s : Nat},
  Becoming.Strict σ →
    (∀ (j : Nat), j ∈ Becoming.span σ s → Becoming.Distinct (L.present j)) →
      Becoming.Distinct es →
        (∀ (c : C), 0 < W.level (σ s) c → c ∈ es) →
          (∀ (c : C), 0 < W.level (σ (s + 1)) c → c ∈ es) →
            (∀ (j : Nat), j ∈ Becoming.span σ s → L.BalancesOn W es j) →
              (∀ (j : Nat), j ∈ Becoming.span σ s → L.DissipatesOn es j) →
                ((∃ c, (W.sample σ).Rises s c ∨ (W.sample σ).Falls s c) ↔ W.stock es (σ (s + 1)) < W.stock es (σ s))
@Becoming.Flow.sample_comesToStand_iff : ∀ {F C : Type} [DecidableEq F] {L : Becoming.Flow F C} (σ : Nat → Nat)
  {W : Becoming.Web F C} {cs : List C} {s : Nat} {c : C},
  Becoming.Strict σ →
    (∀ (j : Nat), j ∈ Becoming.span σ s → Becoming.Distinct (L.present j)) →
      (∀ (j : Nat), j ∈ Becoming.span σ s → L.BalancesOn W cs j) →
        c ∈ cs →
          ((W.sample σ).ComesToStand s c ↔
            W.level (σ s) c = 0 ∧
              (Becoming.total (Becoming.span σ s) fun j => L.taken j c) <
                Becoming.total (Becoming.span σ s) fun j => L.given j c)
@Becoming.Flow.sample_ceasesToStand_iff : ∀ {F C : Type} [DecidableEq F] {L : Becoming.Flow F C} (σ : Nat → Nat)
  {W : Becoming.Web F C} {cs : List C} {s : Nat} {c : C},
  Becoming.Strict σ →
    (∀ (j : Nat), j ∈ Becoming.span σ s → Becoming.Distinct (L.present j)) →
      (∀ (j : Nat), j ∈ Becoming.span σ s → L.BalancesOn W cs j) →
        c ∈ cs →
          ((W.sample σ).CeasesToStand s c ↔
            0 < W.level (σ s) c ∧
              (Becoming.total (Becoming.span σ s) fun j => L.taken j c) =
                W.level (σ s) c + Becoming.total (Becoming.span σ s) fun j => L.given j c)
