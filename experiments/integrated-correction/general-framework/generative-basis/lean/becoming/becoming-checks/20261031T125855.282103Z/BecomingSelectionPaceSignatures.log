        (∀ (p k : X), p ∈ G.family (t + 1) → k ∈ G.kids (t + 1) p → W.ComesToStand (t + 1) k) →
          (∀ (p k : X), p ∈ G.family (t + 1) → k ∈ G.kids (t + 1) p → m ≤ W.level (t + 1 + 1) k) →
            (∀ (p : X), p ∈ G.family (t + 1) → W.level (t + 1) p ≤ m) →
