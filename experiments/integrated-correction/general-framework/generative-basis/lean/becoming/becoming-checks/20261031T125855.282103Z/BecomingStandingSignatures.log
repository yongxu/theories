  (∀ (w : Becoming.World),
      w.Meets S →
        (∃ T, ∀ (t : Nat), T ≤ t → w.flow.Enclosed t) →
          w.StandsObey fun n c a => ∃ T B, Becoming.ChangeBound T B n c a) ↔
    Becoming.World.BoundsStanding S
