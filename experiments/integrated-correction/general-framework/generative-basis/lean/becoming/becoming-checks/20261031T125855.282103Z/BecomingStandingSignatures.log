@Becoming.mem_pairs : ∀ {α β : Type} {a : α} {b : β} {l : List α} {m : List β},
  a ∈ l → b ∈ m → (a, b) ∈ Becoming.pairs l m
@Becoming.World.Embodied.standsObey_iff : ∀ {w : Becoming.World} {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop}
  [decided : (t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)],
  w.Embodied → Becoming.Pointwise Q → (w.StandsObey Q ↔ w.CountsObey Q)
Becoming.World.sourcedQueue_holds : ∀ (n c : Nat → Nat),
  (Becoming.World.sourcedQueue n c).Dependent ∧
    (Becoming.World.sourcedQueue n c).Balanced ∧
      (Becoming.World.sourcedQueue n c).Acting ∧
        (Becoming.World.sourcedQueue n c).Taking ∧
          (Becoming.World.sourcedQueue n c).Dissipative ∧
            (Becoming.World.sourcedQueue n c).Counted ∧ (Becoming.World.sourcedQueue n c).Transmitting
Becoming.World.sourcedQueue_meets : ∀ (n c : Nat → Nat) {S : Becoming.World.Premise → Bool},
  S Becoming.World.Premise.embodied = false → (Becoming.World.sourcedQueue n c).Meets S
Becoming.World.sourcedQueue_standing : ∀ (n c : Nat → Nat),
  (Becoming.World.sourcedQueue n c).web.StandingCensus fun t =>
    List.map Becoming.OpenQueue.Relatum.member (Becoming.Queue.line n c t)
@Becoming.World.sourcedQueue_counts : ∀ {n c a : Nat → Nat},
  Becoming.Tally n c a →
    ∀ (t : Nat),
      (List.map Becoming.OpenQueue.Relatum.member (Becoming.Queue.line n c t)).length = n t ∧
        Becoming.ceasings (List.map Becoming.OpenQueue.Relatum.member (Becoming.Queue.line n c t))
              (fun x s => 0 < (Becoming.World.sourcedQueue n c).web.level s x) t =
            c t ∧
          Becoming.comings (List.map Becoming.OpenQueue.Relatum.member (Becoming.Queue.line n c (t + 1)))
              (fun x s => 0 < (Becoming.World.sourcedQueue n c).web.level s x) t =
            a t
Becoming.World.standing_counting_under_sound : ∀ (S : Becoming.World.Premise → Bool) (w : Becoming.World),
  w.Meets S →
    Becoming.World.ListingHolds (fun w x t => 0 < w.web.level t x) w fun n x a =>
      Becoming.World.BindsCounting S → ∀ (t : Nat), 0 < a t → 0 < n t
Becoming.World.standing_counting_under_witnessed : ∀ (S : Becoming.World.Premise → Bool),
  Becoming.World.Witnessed (fun w x t => 0 < w.web.level t x) (fun x => x.Meets S) fun n x a =>
    Becoming.World.BindsCounting S → ∀ (t : Nat), 0 < a t → 0 < n t
@Becoming.World.standing_counting_under : ∀ {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop}
  (S : Becoming.World.Premise → Bool),
  Becoming.Pointwise Q →
    ((∀ (n c a : Nat → Nat),
        Becoming.Tally n c a → (Becoming.World.BindsCounting S → ∀ (t : Nat), 0 < a t → 0 < n t) → Q n c a) ↔
      ∀ (w : Becoming.World), w.Meets S → w.StandsObey Q)
@Becoming.World.standing_iff_counting : ∀ {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop}
  (S : Becoming.World.Premise → Bool),
  Becoming.Pointwise Q →
    ((∀ (w : Becoming.World), w.Meets S → w.StandsObey Q) ↔
      ∀ (w : Becoming.World) [inst : (t : Nat) → (x : w.Relatum) → Decidable (w.web.active t x)],
        w.Meets S → w.CountsObey Q)
Becoming.World.standing_binds_iff : ∀ (S : Becoming.World.Premise → Bool),
  (∀ (w : Becoming.World), w.Meets S → w.StandsObey fun n x a => ∀ (t : Nat), 0 < a t → 0 < n t) ↔
    Becoming.World.BindsCounting S
@Becoming.World.enclosure_bounds_standing_counted : ∀ {w : Becoming.World} {stand : Nat → List w.Relatum},
  w.web.StandingCensus stand →
    ∀ {n c a : Nat → Nat},
      Becoming.FamilyCounts (fun x s => 0 < w.web.level s x) stand n c a →
        w.Balanced →
          w.Dissipative →
            ∀ {T : Nat},
              (∀ (t : Nat), T ≤ t → w.flow.Enclosed t) → Becoming.ChangeBound T (w.web.stock (stand T) T) n c a
@Becoming.World.enclosure_bounds_standing : ∀ {w : Becoming.World} {stand : Nat → List w.Relatum},
  w.web.StandingCensus stand →
    w.Balanced →
      w.Dissipative →
        ∀ {T : Nat},
          (∀ (t : Nat), T ≤ t → w.flow.Enclosed t) →
            Becoming.ChangeBound T (w.web.stock (stand T) T) (fun t => (stand t).length)
              (fun t => Becoming.ceasings (stand t) (fun x s => 0 < w.web.level s x) t) fun t =>
              Becoming.comings (stand (t + 1)) (fun x s => 0 < w.web.level s x) t
@Becoming.World.standing_of_coming_enclosed : ∀ {w : Becoming.World},
  w.Balanced →
    w.Dissipative →
      ∀ {stand : Nat → List w.Relatum},
        w.web.StandingCensus stand →
          ∀ {t : Nat},
            w.flow.Enclosed t →
              ∀ {x : w.Relatum}, Becoming.ComesToBe (fun s => 0 < w.web.level s x) t → 0 < (stand t).length
@Becoming.World.enclosed_binds_standing : ∀ {w : Becoming.World},
  w.Balanced →
    w.Dissipative →
      ∀ {stand : Nat → List w.Relatum},
        w.web.StandingCensus stand →
          ∀ {t : Nat},
            w.flow.Enclosed t →
              0 < Becoming.comings (stand (t + 1)) (fun x s => 0 < w.web.level s x) t → 0 < (stand t).length
