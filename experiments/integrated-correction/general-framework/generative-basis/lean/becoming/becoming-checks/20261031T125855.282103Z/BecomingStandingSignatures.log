@Becoming.World.enclosed_standing_counting_under : ∀ {Q : (Nat → Nat) → (Nat → Nat) → (Nat → Nat) → Prop}
  (S : Becoming.World.Premise → Bool),
  Becoming.Pointwise Q →
    ((∀ (n c a : Nat → Nat),
        Becoming.Tally n c a →
          (Becoming.World.BindsCounting S → ∀ (t : Nat), 0 < a t → 0 < n t) →
            (Becoming.World.BoundsStanding S →
                ∃ T B, Becoming.ChangeBound T B n c a ∧ ∀ (t : Nat), T ≤ t → 0 < a t → 0 < n t) →
              Q n c a) ↔
      ∀ (w : Becoming.World), w.Meets S → (∃ T, ∀ (t : Nat), T ≤ t → w.flow.Enclosed t) → w.StandsObey Q)
