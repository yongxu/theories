Becoming.World.enclosed_standing_counting_under_sound : ∀ (S : Becoming.World.Premise → Bool) (w : Becoming.World),
  (w.Meets S ∧ ∃ T, ∀ (t : Nat), T ≤ t → w.flow.Enclosed t) →
    Becoming.World.ListingHolds (fun w x t => 0 < w.web.level t x) w fun n c a =>
      (Becoming.World.BindsCounting S → ∀ (t : Nat), 0 < a t → 0 < n t) ∧
        (Becoming.World.BoundsStanding S →
          ∃ T B, Becoming.ChangeBound T B n c a ∧ ∀ (t : Nat), T ≤ t → 0 < a t → 0 < n t)
Becoming.World.enclosed_standing_counting_under_witnessed : ∀ (S : Becoming.World.Premise → Bool),
  Becoming.World.Witnessed (fun w x t => 0 < w.web.level t x)
    (fun w => w.Meets S ∧ ∃ T, ∀ (t : Nat), T ≤ t → w.flow.Enclosed t) fun n c a =>
    (Becoming.World.BindsCounting S → ∀ (t : Nat), 0 < a t → 0 < n t) ∧
