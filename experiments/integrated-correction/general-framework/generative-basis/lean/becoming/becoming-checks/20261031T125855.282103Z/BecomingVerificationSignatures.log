  {K : Becoming.Run P → Prop},
  Becoming.Verifiable K ↔ ∀ (r : Becoming.Run P), K r ↔ Becoming.Stretches.verifyingClass K r.stretches
@Becoming.Stretches.verifiable_and : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A}
  {K L : Becoming.Run P → Prop}, Becoming.Verifiable K → Becoming.Verifiable L → Becoming.Verifiable fun r => K r ∧ L r
@Becoming.Stretches.verifiable_exists : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} {β : Type u_3}
  {K : β → Becoming.Run P → Prop}, (∀ (i : β), Becoming.Verifiable (K i)) → Becoming.Verifiable fun r => ∃ i, K i r
@Becoming.Stretches.refutable_or : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A}
  {K L : Becoming.Run P → Prop}, Becoming.Refutable K → Becoming.Refutable L → Becoming.Refutable fun r => K r ∨ L r
@Becoming.Stretches.verifiable_true_false : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A},
  (Becoming.Verifiable fun x => True) ∧ Becoming.Verifiable fun x => False
@Becoming.Stretches.closed_iff_remainder : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A}
  {K : Becoming.Run P → Prop},
  (∀ (r : Becoming.Run P), Becoming.Adheres K r → K r) ↔ ∀ (r : Becoming.Run P), Becoming.Remainder K r
Becoming.Sequences.eventually_verifiable : Becoming.Verifiable Becoming.Sequences.Eventually
Becoming.Sequences.eventually_dense : Becoming.Dense Becoming.Sequences.Eventually
Becoming.Sequences.recurs_dense : Becoming.Dense Becoming.Sequences.Recurs
Becoming.Sequences.recurs_not_verifiable : ¬Becoming.Verifiable Becoming.Sequences.Recurs
