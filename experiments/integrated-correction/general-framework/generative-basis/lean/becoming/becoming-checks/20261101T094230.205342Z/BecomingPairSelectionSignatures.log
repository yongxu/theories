@Becoming.PairSelection.meets_after : ∀ {f g : Becoming.PairSelection.PairLaw},
  f (true, true) (true, true) = true →
    g (true, true) (true, true) = true →
      ∀ {h k : Nat → Bool},
        Becoming.PairSelection.Meets f g (Becoming.PairSelection.errAt 0) h k →
          ∀ (t : Nat),
            Becoming.PairSelection.Meets f g (Becoming.PairSelection.errAt t) (Becoming.PairSelection.after t h)
              (Becoming.PairSelection.after t k)
Becoming.PairSelection.tally_after : ∀ (t : Nat) (h : Nat → Bool) (m : Nat),
  Becoming.PairSelection.tally (Becoming.PairSelection.after t h) (t + m) = t + Becoming.PairSelection.tally h m
Becoming.PairSelection.tally_not_after : ∀ (t : Nat) (h : Nat → Bool) (m : Nat),
  Becoming.PairSelection.tally (fun n => !Becoming.PairSelection.after t h n) (t + m) =
    Becoming.PairSelection.tally (fun n => !h n) m
@Becoming.PairSelection.counts_after : ∀ {f g : Becoming.PairSelection.PairLaw},
  f (true, true) (true, true) = true →
    g (true, true) (true, true) = true →
      ∀ {h k : Nat → Bool},
        Becoming.PairSelection.Meets f g (Becoming.PairSelection.errAt 0) h k →
          ∀ (t m : Nat),
            Becoming.PairSelection.received f g (Becoming.PairSelection.errAt t) Becoming.WindowedWaiting.Pair.first
                  (t + m) =
                t + Becoming.PairSelection.tally k m ∧
              Becoming.PairSelection.withheld f g (Becoming.PairSelection.errAt t) Becoming.WindowedWaiting.Pair.first
                    (t + m) =
                  Becoming.PairSelection.tally (fun n => !h n) m ∧
                Becoming.PairSelection.received f g (Becoming.PairSelection.errAt t)
                      Becoming.WindowedWaiting.Pair.second (t + m) =
                    t + Becoming.PairSelection.tally h m ∧
                  Becoming.PairSelection.withheld f g (Becoming.PairSelection.errAt t)
                      Becoming.WindowedWaiting.Pair.second (t + m) =
                    Becoming.PairSelection.tally (fun n => !k n) m
