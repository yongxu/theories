@Becoming.PairSelection.course_of : ∀ {f g : Becoming.PairSelection.PairLaw} {e : Becoming.PairSelection.Errors}
  {P Q : Nat → Bool},
  (f (true, true) (true, true) && !e 0 Becoming.WindowedWaiting.Pair.first) = P 0 →
    (g (true, true) (true, true) && !e 0 Becoming.WindowedWaiting.Pair.second) = Q 0 →
      (∀ (n : Nat),
          (f (P n, Becoming.PairSelection.before P n) (Q n, Becoming.PairSelection.before Q n) &&
              !e (n + 1) Becoming.WindowedWaiting.Pair.first) =
            P (n + 1)) →
        (∀ (n : Nat),
            (g (Q n, Becoming.PairSelection.before Q n) (P n, Becoming.PairSelection.before P n) &&
                !e (n + 1) Becoming.WindowedWaiting.Pair.second) =
              Q (n + 1)) →
          ∀ (n : Nat),
            (Becoming.PairSelection.course f g e).state n =
              (n, (P n, Becoming.PairSelection.before P n), Q n, Becoming.PairSelection.before Q n)
@Becoming.PairSelection.gives_of : ∀ {f g : Becoming.PairSelection.PairLaw} {e : Becoming.PairSelection.Errors}
  {P Q : Nat → Bool},
  (f (true, true) (true, true) && !e 0 Becoming.WindowedWaiting.Pair.first) = P 0 →
    (g (true, true) (true, true) && !e 0 Becoming.WindowedWaiting.Pair.second) = Q 0 →
      (∀ (n : Nat),
          (f (P n, Becoming.PairSelection.before P n) (Q n, Becoming.PairSelection.before Q n) &&
              !e (n + 1) Becoming.WindowedWaiting.Pair.first) =
            P (n + 1)) →
        (∀ (n : Nat),
            (g (Q n, Becoming.PairSelection.before Q n) (P n, Becoming.PairSelection.before P n) &&
                !e (n + 1) Becoming.WindowedWaiting.Pair.second) =
              Q (n + 1)) →
          ∀ (n : Nat),
            Becoming.PairSelection.gives f g e Becoming.WindowedWaiting.Pair.first n = P n ∧
              Becoming.PairSelection.gives f g e Becoming.WindowedWaiting.Pair.second n = Q n
@Becoming.PairSelection.tally_congr : ∀ {p q : Nat → Bool},
  (∀ (t : Nat), p t = q t) → ∀ (n : Nat), Becoming.PairSelection.tally p n = Becoming.PairSelection.tally q n
@Becoming.PairSelection.tally_true : ∀ {p : Nat → Bool},
  (∀ (t : Nat), p t = true) → ∀ (n : Nat), Becoming.PairSelection.tally p n = n
@Becoming.PairSelection.tally_false : ∀ {p : Nat → Bool},
  (∀ (t : Nat), p t = false) → ∀ (n : Nat), Becoming.PairSelection.tally p n = 0
Becoming.PairSelection.tally_head : ∀ (p : Nat → Bool) (n : Nat),
  Becoming.PairSelection.tally p (n + 1) = (bif p 0 then 1 else 0) + Becoming.PairSelection.tally (fun t => p (t + 1)) n
Becoming.PairSelection.tally_not : ∀ (p : Nat → Bool) (n : Nat),
  Becoming.PairSelection.tally p n + Becoming.PairSelection.tally (fun t => !p t) n = n
Becoming.PairSelection.tally_odd : ∀ (n : Nat),
