@Becoming.PairSelection.counts_giving : ∀ {f g : Becoming.PairSelection.PairLaw},
  f (true, true) (true, true) = true →
    g (true, true) (true, true) = true →
      ∀ (a : Becoming.WindowedWaiting.Pair) (n : Nat),
        Becoming.PairSelection.received f g Becoming.PairSelection.noErrors a n = n ∧
          Becoming.PairSelection.withheld f g Becoming.PairSelection.noErrors a n = 0
@Becoming.PairSelection.counts_of : ∀ {f g : Becoming.PairSelection.PairLaw} {e : Becoming.PairSelection.Errors}
  {P Q : Nat → Bool},
  (∀ (n : Nat),
      Becoming.PairSelection.gives f g e Becoming.WindowedWaiting.Pair.first n = P n ∧
        Becoming.PairSelection.gives f g e Becoming.WindowedWaiting.Pair.second n = Q n) →
    ∀ (n : Nat),
      Becoming.PairSelection.received f g e Becoming.WindowedWaiting.Pair.first n = Becoming.PairSelection.tally Q n ∧
        Becoming.PairSelection.withheld f g e Becoming.WindowedWaiting.Pair.first n =
            Becoming.PairSelection.tally (fun t => !P t) n ∧
          Becoming.PairSelection.received f g e Becoming.WindowedWaiting.Pair.second n =
              Becoming.PairSelection.tally P n ∧
            Becoming.PairSelection.withheld f g e Becoming.WindowedWaiting.Pair.second n =
              Becoming.PairSelection.tally (fun t => !Q t) n
