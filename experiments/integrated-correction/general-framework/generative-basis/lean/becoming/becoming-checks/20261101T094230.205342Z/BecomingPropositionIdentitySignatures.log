@Becoming.PropositionIdentity.iff_witness_unique : ∀ {a b : Prop} (h h' : a ↔ b), h = h'
@Becoming.PropositionIdentity.derivation_unique : ∀ {a b : Prop} (f f' : a → b), f = f'
Becoming.PropositionIdentity.two_equivalences : (∀ (x : Bool), (fun y => y) ((fun y => y) x) = x) ∧
  (∀ (x : Bool), Becoming.PropositionIdentity.flip (Becoming.PropositionIdentity.flip x) = x) ∧
    (fun y => y) ≠ Becoming.PropositionIdentity.flip
