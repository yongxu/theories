@Becoming.Reaching.coversLater_iff_of_unique : ∀ {S : Type u_1} {A : Type u_2} {X : Type} {P : Generative.Process S A}
  {adm : S → X → Prop},
  (∀ (q q' : Becoming.Run P), q.state 0 = q'.state 0 → ∀ (t : Nat), q.state t = q'.state t) →
    ∀ {s s' : S} {r r' : Becoming.Run P},
      r.state 0 = s →
        r'.state 0 = s' →
          ∀ (d : Nat),
            Becoming.Reaching.CoversLater P adm d s s' ↔
              ∀ (t : Nat) (x : X), adm (r'.state t) x → adm (r.state (t + d)) x
@Becoming.Reaching.widensOrLater_iff_of_unique : ∀ {S : Type u_1} {A : Type u_2} {X : Type} {P : Generative.Process S A}
  {adm : S → X → Prop},
  (∀ (q q' : Becoming.Run P), q.state 0 = q'.state 0 → ∀ (t : Nat), q.state t = q'.state t) →
    ∀ {s s' : S} {r r' : Becoming.Run P},
      r.state 0 = s →
        r'.state 0 = s' →
          (Becoming.Reaching.WidensOrLater P adm s s' ↔
            Becoming.Run.RangeIncludes adm r r' ∧ ¬Becoming.Run.RangeIncludes adm r' r ∨
              (∃ d, ∀ (t : Nat) (x : X), adm (r'.state t) x → adm (r.state (t + d)) x) ∧
                ¬∃ d, ∀ (t : Nat) (x : X), adm (r.state t) x → adm (r'.state (t + d)) x)
@Becoming.Reaching.covers_iff_carries : ∀ {S A X : Type} {P : Generative.Process S A} {adm : S → X → Prop} {s s' : S},
  Becoming.Reaching.Covers P adm s s' ↔
    Becoming.CarriesProfiles (Becoming.Reaching.coursesFrame P adm) (fun r => r.state 0 = s')
      (Becoming.Reaching.coursesFrame P adm) fun r => r.state 0 = s
@Becoming.Reaching.covers_iff_preserves : ∀ {S A X : Type} {P : Generative.Process S A} {adm : S → X → Prop} {s s' : S},
  Becoming.Reaching.Covers P adm s s' ↔
    Becoming.PreservesBundles (Becoming.Reaching.coursesFrame P adm) (fun r => r.state 0 = s')
      (Becoming.Reaching.coursesFrame P adm) fun r => r.state 0 = s
@Becoming.Reaching.covers_iff_included : ∀ {S A X : Type} {P : Generative.Process S A} {adm : S → X → Prop} {s s' : S},
  Becoming.Reaching.Covers P adm s s' ↔
    Becoming.Lexical.Included (Becoming.Reaching.reachableRanges P adm s') (Becoming.Reaching.reachableRanges P adm s)
@Becoming.Reaching.widens_iff_extension : ∀ {S A X : Type} {P : Generative.Process S A} {adm : S → X → Prop} {s s' : S},
  Becoming.Reaching.Widens P adm s s' ↔ Becoming.Extension (Becoming.Reaching.reachFrame P adm) (fun x => True) s' s
@Becoming.Reaching.comparison_widens : ∀ {S A X : Type} {P : Generative.Process S A} {adm : S → X → Prop},
  Becoming.Comparison (Becoming.Reaching.reachFrame P adm) (fun x => True) fun a b => Becoming.Reaching.Widens P adm b a
@Becoming.Reaching.comparison_widensOrLater : ∀ {S A X : Type} {P : Generative.Process S A} {adm : S → X → Prop},
  Becoming.Comparison (Becoming.Reaching.reachFrame P adm) (fun x => True) fun a b =>
    Becoming.Reaching.WidensOrLater P adm b a
@Becoming.Reaching.lexical_above : ∀ {S A X : Type} {P : Generative.Process S A} {adm : S → X → Prop}
  {course : S → Becoming.Run P} {s s' : S},
  Becoming.Reaching.Lexical P adm course s s' →
    Becoming.Lexical.Above (Becoming.Reaching.realizedClaims course adm) (Becoming.Reaching.reachableRanges P adm) s s'
@Becoming.Reaching.lexical_of_above_decided : ∀ {S A X : Type} {P : Generative.Process S A} {adm : S → X → Prop}
  {course : S → Becoming.Run P} {s s' : S},
  Becoming.Run.RangeIncludes adm (course s') (course s) ∨ Becoming.Run.RangeExceeds adm (course s) (course s') →
    (Becoming.Reaching.Covers P adm s' s ∨
        ∃ r, r.state 0 = s ∧ ∀ (r' : Becoming.Run P), r'.state 0 = s' → ¬Becoming.Run.RangeIncludes adm r' r) →
      Becoming.Lexical.Above (Becoming.Reaching.realizedClaims course adm) (Becoming.Reaching.reachableRanges P adm) s
          s' →
        Becoming.Reaching.Lexical P adm course s s'
@Becoming.Law.runs_agree : ∀ {S : Type u_1} {next : S → S} (q q' : Becoming.Run (Becoming.Law.process next)),
  q.state 0 = q'.state 0 → ∀ (t : Nat), q.state t = q'.state t
