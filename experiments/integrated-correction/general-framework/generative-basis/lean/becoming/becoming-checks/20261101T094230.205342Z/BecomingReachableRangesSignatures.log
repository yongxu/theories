    ∀ (r : Becoming.Run Becoming.DeferredBranching.process),
      r.state 0 = Becoming.DeferredBranching.Config.early →
        Becoming.Reaching.Widens Becoming.DeferredBranching.process Becoming.DeferredBranching.adm (q.state 1)
          (r.state 1)
@Becoming.DeferredBranching.early_not_simulating_late : ∀
  {R : Becoming.DeferredBranching.Config → Becoming.DeferredBranching.Config → Prop},
  Becoming.DeferredBranching.Simulation R →
    R Becoming.DeferredBranching.Config.late Becoming.DeferredBranching.Config.early → False
Becoming.DeferredBranching.late_simulates_early : Becoming.DeferredBranching.Simulation
    Becoming.DeferredBranching.lateOverEarly ∧
  Becoming.DeferredBranching.lateOverEarly Becoming.DeferredBranching.Config.early
    Becoming.DeferredBranching.Config.late
