          Becoming.Rooms.warm b = true → Becoming.«层» (Becoming.Rooms.joint m) Becoming.Rooms.jointAlike k (0, a) (c, b)
@Becoming.Rooms.empties : ∀ {m c : Nat},
  1 ≤ m →
    1 ≤ c →
      ∀ (j : Nat) {b : Becoming.Rooms.Occurrence},
        Becoming.Rooms.warm b = true →
          ¬Becoming.«层» (Becoming.Rooms.joint m) Becoming.Rooms.jointAlike j (0, { opened := true, level := j }) (c, b)
@Becoming.Rooms.«开窗以温层如其余乃分» : ∀ {n c : Nat},
  1 ≤ c →
    Becoming.«层» (Becoming.Rooms.joint (n + 1)) Becoming.Rooms.jointAlike n (0, Becoming.Rooms.start (n + 1))
        (c, Becoming.Rooms.start (n + 1)) ∧
      ¬Becoming.«层» (Becoming.Rooms.joint (n + 1)) Becoming.Rooms.jointAlike (n + 1) (0, Becoming.Rooms.start (n + 1))
          (c, Becoming.Rooms.start (n + 1))
@Becoming.Rooms.«有给之室以温不可分» : ∀ {m c c' : Nat},
  1 ≤ m →
    1 ≤ c →
      1 ≤ c' →
        Becoming.«核» (Becoming.Rooms.joint m) Becoming.Rooms.jointAlike (c, Becoming.Rooms.start m)
          (c', Becoming.Rooms.start m)
@Becoming.Rooms.joint_converse : ∀ {m c : Nat},
  1 ≤ m →
    1 ≤ c →
      ¬Becoming.«有常» (Becoming.Rooms.joint m) Becoming.Rooms.jointAlike ∧
        Becoming.«不穷» (Becoming.Rooms.joint m) Becoming.Rooms.jointAlike (c, Becoming.Rooms.start m)
Becoming.Rooms.before_window_moves : Becoming.Rooms.nextBefore 3 1 0 3 = 2 ∧
  Becoming.Rooms.nextBefore 3 1 0 2 = 2 ∧ Becoming.Rooms.nextBefore 3 2 0 3 = 2 ∧ Becoming.Rooms.nextBefore 3 2 0 2 = 3
@Becoming.Rooms.before_pos : ∀ {m c : Nat}, 2 ≤ m → 1 ≤ c → ∀ (σ x : Nat), 0 < Becoming.Rooms.nextBefore m c σ x
Becoming.Rooms.before_at_one : ∀ (c : Nat), Becoming.Rooms.nextBefore 1 c 0 1 = 0
Becoming.Rooms.before_unheated : ∀ (m σ x : Nat), Becoming.Rooms.nextBefore m 0 σ x = Becoming.Rooms.next m 0 σ x
Becoming.Rooms.toy_branches : (∀ (x y : Becoming.Room),
    x.opened y → Becoming.Rooms.joint 1 (Becoming.Rooms.toy x) (Becoming.Rooms.toy y)) ∧
  (∀ (x y : Becoming.Room), x.closed y → Becoming.Rooms.jointShut 1 (Becoming.Rooms.toy x) (Becoming.Rooms.toy y)) ∧
    (∀ (x : Becoming.Room),
        x = Becoming.Room.balanced ∨ x = Becoming.Room.held →
          ∀ (w : Becoming.Rooms.Tagged),
            Becoming.Rooms.joint 1 (Becoming.Rooms.toy x) w → ∃ y, x.opened y ∧ w = Becoming.Rooms.toy y) ∧
      (∀ (x : Becoming.Room),
          x = Becoming.Room.balanced ∨ x = Becoming.Room.held →
            ∀ (w : Becoming.Rooms.Tagged),
              Becoming.Rooms.jointShut 1 (Becoming.Rooms.toy x) w → ∃ y, x.closed y ∧ w = Becoming.Rooms.toy y) ∧
        ∀ (x : Becoming.Room), Becoming.Rooms.warm (Becoming.Rooms.toy x).snd = x.warm
Becoming.Rooms.toy_verdict : ¬Becoming.«层» Becoming.Room.opened Becoming.Room.alike 1 Becoming.Room.balanced
      Becoming.Room.held ∧
  ¬Becoming.«核» Becoming.Room.opened Becoming.Room.alike Becoming.Room.balanced Becoming.Room.held
