@Becoming.SelectionLevels.balance_add : ∀ {x p y q x' p' y' q' : Nat},
  x + p = y + q → x' + p' = y' + q' → x + x' + (p + p') = y + y' + (q + q')
Becoming.SelectionLevels.balance_mul : ∀ (k : Nat) {x p y q : Nat}, x + p = y + q → k * x + k * p = k * y + k * q
@Becoming.SelectionLevels.returns_total : ∀ {α : Type} {ps : List α} {w a o : α → Nat} {B b k : Nat},
  (∀ (p : α), p ∈ ps → w p + k * a p = B + b * o p) →
    Becoming.total ps w + k * Becoming.total ps a = ps.length * B + b * Becoming.total ps o
@Becoming.SelectionLevels.returns_weighted : ∀ {α : Type} {ps : List α} {w a o : α → Nat} {B b k : Nat},
  (∀ (p : α), p ∈ ps → w p + k * a p = B + b * o p) →
    Becoming.SelectionTerm.weighted ps w a + k * Becoming.SelectionTerm.weighted ps a a =
      B * Becoming.total ps a + b * Becoming.SelectionTerm.weighted ps o a
@Becoming.SelectionLevels.returns_balance : ∀ {α : Type} (ps : List α) (w a o : α → Nat) {B b k : Nat},
  (∀ (p : α), p ∈ ps → w p + k * a p = B + b * o p) →
    Becoming.SelectionTerm.concord ps w a + k * Becoming.SelectionTerm.concord ps a a +
        b * Becoming.SelectionTerm.discord ps o a =
      Becoming.SelectionTerm.discord ps w a + b * Becoming.SelectionTerm.concord ps o a
@Becoming.SelectionLevels.rises_iff_reading : ∀ {α : Type} (ps : List α) (w a o : α → Nat) {B b k : Nat},
  (∀ (p : α), p ∈ ps → w p + k * a p = B + b * o p) →
    (Becoming.SelectionTerm.discord ps w a < Becoming.SelectionTerm.concord ps w a ↔
      k * Becoming.SelectionTerm.concord ps a a + b * Becoming.SelectionTerm.discord ps o a <
        b * Becoming.SelectionTerm.concord ps o a)
