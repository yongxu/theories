@Becoming.SelectionLevels.within_by_one : ∀ {α : Type} (gs : List (List α)) (w a : α → Nat),
  Becoming.SelectionLevels.concordWithinBy gs (fun x => 1) w a = Becoming.SelectionLevels.concordWithin gs w a ∧
    Becoming.SelectionLevels.discordWithinBy gs (fun x => 1) w a = Becoming.SelectionLevels.discordWithin gs w a
@Becoming.SelectionLevels.among_by_one : ∀ {α : Type} (gs : List (List α)) (w a : α → Nat),
  (Becoming.SelectionTerm.concord gs (fun g => 1 * Becoming.total g w) fun g => 1 * Becoming.total g a) =
      Becoming.SelectionLevels.concordAmong gs w a ∧
    (Becoming.SelectionTerm.discord gs (fun g => 1 * Becoming.total g w) fun g => 1 * Becoming.total g a) =
      Becoming.SelectionLevels.discordAmong gs w a
@Becoming.SelectionLevels.nil_of_length_zero : ∀ {α : Type} {g : List α}, g.length = 0 → g = []
@Becoming.SelectionLevels.whole_nil : ∀ {α : Type} {gs : List (List α)},
  (∀ (g : List α), g ∈ gs → g.length = 0) → Becoming.SelectionLevels.whole gs = []
@Becoming.SelectionLevels.levels : ∀ {α : Type} (gs : List (List α)) (w a : α → Nat) {m : Nat},
