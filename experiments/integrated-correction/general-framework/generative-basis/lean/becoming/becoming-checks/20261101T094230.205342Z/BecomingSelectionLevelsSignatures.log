@Becoming.SelectionLevels.whole_total : ∀ {α : Type} (gs : List (List α)) (q : α → Nat),
  Becoming.total (Becoming.SelectionLevels.whole gs) q = Becoming.total gs fun g => Becoming.total g q
@Becoming.SelectionLevels.whole_weighted : ∀ {α : Type} (gs : List (List α)) (w a : α → Nat),
  Becoming.SelectionTerm.weighted (Becoming.SelectionLevels.whole gs) w a =
    Becoming.total gs fun g => Becoming.SelectionTerm.weighted g w a
