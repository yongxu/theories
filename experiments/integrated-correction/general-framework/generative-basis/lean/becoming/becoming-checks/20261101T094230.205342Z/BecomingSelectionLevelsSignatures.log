      n * n * Becoming.SelectionTerm.discord (Becoming.SelectionLevels.whole gs) w a +
        (n * (Becoming.SelectionLevels.whole gs).length * Becoming.SelectionLevels.concordWithinBy gs c w a +
          Becoming.SelectionLevels.concordMeans gs c w a)
