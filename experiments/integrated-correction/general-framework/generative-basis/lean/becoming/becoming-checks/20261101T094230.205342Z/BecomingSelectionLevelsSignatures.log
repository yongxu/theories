@Becoming.SelectionLevels.rises_iff_lineages : ∀ {α : Type} (G : Becoming.SelectionTerm.Generations α)
  {gs : List (List α)},
  Becoming.SelectionLevels.whole gs = G.family 0 →
    (∀ (t : Nat), Becoming.SelectionTerm.Exact (G.family t) (G.kids t) (G.amount t) (G.amount (t + 1))) →
      (∀ (g : List α), g ∈ gs → ∃ v, ∀ (p : α), p ∈ g → G.amount 0 p = v) →
        ∀ {t n : Nat} (c : List α → Nat),
