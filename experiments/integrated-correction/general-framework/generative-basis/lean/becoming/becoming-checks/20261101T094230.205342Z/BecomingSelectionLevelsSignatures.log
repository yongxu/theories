        gs.length * Becoming.SelectionLevels.concordWithin gs w a + Becoming.SelectionLevels.concordAmong gs w a)
@Becoming.SelectionLevels.square_lt_iff : ∀ {n x y : Nat}, 0 < n → (n * n * x < n * n * y ↔ x < y)
@Becoming.SelectionLevels.square_eq_iff : ∀ {n x y : Nat}, 0 < n → (n * n * x = n * n * y ↔ x = y)
