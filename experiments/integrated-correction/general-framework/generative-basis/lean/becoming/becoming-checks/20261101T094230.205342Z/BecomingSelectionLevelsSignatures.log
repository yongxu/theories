                Becoming.SelectionLevels.concordMeans gs c (G.offspringNumber t) (G.amount t))
@Becoming.SelectionLevels.rises_exact_iff_within_of_alike : ∀ {α : Type} (G : Becoming.SelectionTerm.Generations α)
  {t n d : Nat} (gs : List (List α)) (c : List α → Nat),
  Becoming.SelectionLevels.whole gs = G.family t →
    (∀ (g : List α), g ∈ gs → g.length * c g = n) →
