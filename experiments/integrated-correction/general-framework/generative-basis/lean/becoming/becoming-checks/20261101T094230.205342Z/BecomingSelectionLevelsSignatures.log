    Becoming.SelectionLevels.concordWithinBy gs c w a = 0 ∧ Becoming.SelectionLevels.discordWithinBy gs c w a = 0
@Becoming.SelectionLevels.rises_iff_means_of_uniform : ∀ {α : Type} (gs : List (List α)) (w a : α → Nat)
