@Becoming.SelectionLevels.levels_sized : ∀ {α : Type} (gs : List (List α)) (w a : α → Nat) (c : List α → Nat) {n : Nat},
  (∀ (g : List α), g ∈ gs → g.length * c g = n) →
    n * n * Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) w a +
        (n * (Becoming.SelectionLevels.whole gs).length * Becoming.SelectionLevels.discordWithinBy gs c w a +
