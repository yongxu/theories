@Becoming.SelectionLevels.flatMap_flatMap : ∀ {α β : Type} (F : β → List α) (k : α → List α) (gs : List β),
  List.flatMap k (List.flatMap F gs) = List.flatMap (fun g => List.flatMap k (F g)) gs
