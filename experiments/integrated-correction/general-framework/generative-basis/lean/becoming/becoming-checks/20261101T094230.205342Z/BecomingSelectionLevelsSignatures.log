      (∀ (g : List α), g ∈ gs → ∃ v, ∀ (p : α), p ∈ g → G.amount 0 p = v) →
        ∀ (t : Nat) (w : α → Nat),
          Becoming.SelectionLevels.concordWithin (Becoming.SelectionLevels.lineages G gs t) w (G.amount t) = 0 ∧
