  (Becoming.SelectionLevels.whole gs).length = Becoming.total gs fun g => g.length
@Becoming.SelectionLevels.total_eq_of_mem : ∀ {α : Type} {p q : α → Nat} {as : List α},
  (∀ (a : α), a ∈ as → p a = q a) → Becoming.total as p = Becoming.total as q
@Becoming.SelectionLevels.whole_length_of_equal : ∀ {α : Type} {gs : List (List α)} {m : Nat},
  (∀ (g : List α), g ∈ gs → g.length = m) → (Becoming.SelectionLevels.whole gs).length = gs.length * m
@Becoming.SelectionLevels.context_total : ∀ {α : Type} (q : List α → Nat) (gs : List (List α)),
  Becoming.total (Becoming.SelectionLevels.context gs) q = Becoming.total gs fun g => g.length * q g
@Becoming.SelectionLevels.context_length : ∀ {α : Type} (gs : List (List α)),
  (Becoming.SelectionLevels.context gs).length = (Becoming.SelectionLevels.whole gs).length
@Becoming.SelectionLevels.mem_of_mem_context : ∀ {α : Type} {gs : List (List α)} {x : List α},
  x ∈ Becoming.SelectionLevels.context gs → x ∈ gs
Becoming.SelectionLevels.shuffle_left : ∀ (c dw d' q s p : Nat),
  c + (dw + d') + (q + (s + p)) = q + c + (s + dw + (p + d'))
Becoming.SelectionLevels.shuffle_right : ∀ (s d p cw q c' : Nat),
  s + d + (p + cw + (q + c')) = d + (cw + c') + (q + (s + p))
@Becoming.SelectionLevels.meet : ∀ {s d q c dw p cw d' c' : Nat},
  s + d = q + c → s + dw = p + cw → p + d' = q + c' → c + (dw + d') = d + (cw + c')
