        ∃ G₁ G₂,
          Becoming.SelectionShift.SameTerms G G₁ ∧
            Becoming.SelectionShift.SameTerms G G₂ ∧
              (∀ (t : Nat), 0 < G₁.size t) ∧ ∃ m, ∀ (n : Nat), G₂.size (m + n) = 0
@Becoming.SelectionShift.Horizon.terms_boundary : ∀ {α : Type} {G : Becoming.SelectionTerm.Generations α},
  0 < G.size 0 →
    ((∀ (t : Nat), ∃ s, t ≤ s ∧ (0 < G.concordAt s ∨ 0 < G.discordAt s)) →
        ∀ (G' : Becoming.SelectionTerm.Generations α),
          Becoming.SelectionShift.SameTerms G G' → ∀ (t : Nat), 0 < G'.size t) ∧
      ∀ (H : Nat),
        (∀ (t : Nat), ¬t ≤ H → G.concordAt t = 0 ∧ G.discordAt t = 0) →
          ∃ G₁ G₂,
            Becoming.SelectionShift.SameTerms G G₁ ∧
              Becoming.SelectionShift.SameTerms G G₂ ∧
                (∀ (t : Nat), 0 < G₁.size t) ∧ ∃ m, ∀ (n : Nat), G₂.size (m + n) = 0
Becoming.SelectionShift.Alternating.step_family : ∀ (b : Bool),
  List.flatMap (bif b then Becoming.SelectionShift.Horizon.markedPair else fun p => [p]) [true, false] = [true, false]
Becoming.SelectionShift.Alternating.course_family : ∀ (t : Nat),
  Becoming.SelectionShift.Alternating.course.family t = [true, false]
Becoming.SelectionShift.Alternating.step_terms : ∀ (b : Bool),
  (Becoming.SelectionTerm.concord [true, false]
        (fun p => ((bif b then Becoming.SelectionShift.Horizon.markedPair else fun p => [p]) p).length)
        Becoming.SelectionShift.Horizon.carried =
      bif b then 2 else 0) ∧
    Becoming.SelectionTerm.discord [true, false]
        (fun p => ((bif b then Becoming.SelectionShift.Horizon.markedPair else fun p => [p]) p).length)
        Becoming.SelectionShift.Horizon.carried =
      0
Becoming.SelectionShift.Alternating.course_terms : ∀ (t : Nat),
  (Becoming.SelectionShift.Alternating.course.concordAt t =
      bif Becoming.SelectionShift.Alternating.even t then 2 else 0) ∧
    Becoming.SelectionShift.Alternating.course.discordAt t = 0
Becoming.SelectionShift.Alternating.even_double : ∀ (t : Nat), Becoming.SelectionShift.Alternating.even (2 * t) = true
Becoming.SelectionShift.Alternating.odd_double : ∀ (t : Nat),
  Becoming.SelectionShift.Alternating.even (2 * t + 1) = false
Becoming.SelectionShift.Alternating.le_double : ∀ (t : Nat), t ≤ 2 * t
Becoming.SelectionShift.Alternating.unbounded_not_every : (∀ (t : Nat),
    Becoming.SelectionShift.Alternating.course.concordAt (2 * t) = 2 ∧
      Becoming.SelectionShift.Alternating.course.discordAt (2 * t) = 0) ∧
  (∀ (t : Nat),
      Becoming.SelectionShift.Alternating.course.concordAt (2 * t + 1) = 0 ∧
        Becoming.SelectionShift.Alternating.course.discordAt (2 * t + 1) = 0) ∧
    (∀ (t : Nat),
        ∃ s,
          t ≤ s ∧
            (0 < Becoming.SelectionShift.Alternating.course.concordAt s ∨
              0 < Becoming.SelectionShift.Alternating.course.discordAt s)) ∧
      (¬∀ (t : Nat),
            0 < Becoming.SelectionShift.Alternating.course.concordAt t ∨
              0 < Becoming.SelectionShift.Alternating.course.discordAt t) ∧
        ∀ (t : Nat), 0 < Becoming.SelectionShift.Alternating.course.size t
Becoming.SelectionShift.Shrinking.unmarked_flatMap : ∀ (k : Nat),
  List.flatMap Becoming.SelectionShift.Shrinking.kids (List.replicate k none) = []
Becoming.SelectionShift.Shrinking.unmarked_mark : ∀ (k : Nat),
  Becoming.total (List.replicate k none) Becoming.SelectionShift.Shrinking.mark = 0
Becoming.SelectionShift.Shrinking.replicate_length : ∀ (a : Option Nat) (k : Nat), (List.replicate k a).length = k
Becoming.SelectionShift.Shrinking.line_step : ∀ (m : Nat),
  List.flatMap Becoming.SelectionShift.Shrinking.kids (Becoming.SelectionShift.Shrinking.line (m + 1)) =
    Becoming.SelectionShift.Shrinking.line m
Becoming.SelectionShift.Shrinking.course_family : ∀ (t m : Nat),
  (Becoming.SelectionShift.Shrinking.course (m + t)).family t = Becoming.SelectionShift.Shrinking.line (m + 1)
Becoming.SelectionShift.Shrinking.course_size : ∀ (t m : Nat),
  (Becoming.SelectionShift.Shrinking.course (m + t)).size t = m + 1
Becoming.SelectionShift.Shrinking.course_sum : ∀ (t m : Nat),
  (Becoming.SelectionShift.Shrinking.course (m + t)).sum t = 1
Becoming.SelectionShift.Shrinking.course_concord : ∀ (t m : Nat),
  0 < (Becoming.SelectionShift.Shrinking.course (m + 1 + t)).concordAt t
@Becoming.SelectionShift.Shrinking.split_le : ∀ {t N : Nat}, t ≤ N → ∃ m, N = m + t
Becoming.SelectionShift.Shrinking.positive_then_empty : ∀ (N : Nat),
  (∀ (t : Nat), t < N → 0 < (Becoming.SelectionShift.Shrinking.course N).concordAt t) ∧
    (∀ (t : Nat),
        t ≤ N →
          0 < (Becoming.SelectionShift.Shrinking.course N).size t ∧
            (Becoming.SelectionShift.Shrinking.course N).sum t = 1) ∧
      ((Becoming.SelectionShift.Shrinking.course N).concordAt N = 0 ∧
          (Becoming.SelectionShift.Shrinking.course N).discordAt N = 0) ∧
        ∀ (n : Nat), (Becoming.SelectionShift.Shrinking.course N).size (N + 1 + n) = 0
