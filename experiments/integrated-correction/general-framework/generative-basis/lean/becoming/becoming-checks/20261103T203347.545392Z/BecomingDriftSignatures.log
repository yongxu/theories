      (∀ (k : Nat), j < k → k ≤ j + n → 0 < u k) →
        Becoming.Drift.Replacement.riseBy M u d (j + n) ≤ Becoming.Drift.Replacement.riseBy M u d j
@Becoming.Drift.Replacement.riseBy_le_of_disfavoured : ∀ {M : Nat} {u d : Nat → Nat} {j n : Nat},
  j + n ≤ M →
    (∀ (k : Nat), j < k → k ≤ j + n → u k ≤ d k) →
      (∀ (k : Nat), j < k → k ≤ j + n → 0 < u k) →
        Becoming.Drift.Replacement.riseBy M u d j ≤ Becoming.Drift.Replacement.riseBy M u d (j + n)
@Becoming.Drift.Replacement.potentialBy_tail : ∀ {M : Nat} {u d : Nat → Nat} {i : Nat},
