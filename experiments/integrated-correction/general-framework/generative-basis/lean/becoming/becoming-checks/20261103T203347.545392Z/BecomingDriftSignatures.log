            Becoming.Drift.Replacement.potentialBy M u d (M + 1) *
              Becoming.Drift.Replacement.valueBy M T u d e (Becoming.Drift.Replacement.varied M) k i
@Becoming.Drift.Replacement.lostBy_favoured : ∀ {M T : Nat} {u d e : Nat → Nat},
  Becoming.Drift.Replacement.Steps M T u d e →
    (∀ (k : Nat), Becoming.Drift.Replacement.Mixed M k → 0 < u k) →
      ∀ {s n t : Nat},
