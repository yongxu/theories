                    Becoming.Drift.Replacement.valueBy M T u d e (Becoming.Drift.Replacement.fixed M) ((M + 1) * m) i +
                  Becoming.Drift.Replacement.potentialBy M u d (M + 1) * r ^ m
@Becoming.Drift.Replacement.lost_geBy : ∀ {M T : Nat} {u d e : Nat → Nat} {c : Nat},
  (∀ (j : Nat), Becoming.Drift.Replacement.Mixed M j → c ≤ d j) →
    ∀ (k i : Nat),
      i ≤ M → c ^ i * T ^ k ≤ Becoming.Drift.Replacement.valueBy M T u d e Becoming.Drift.Replacement.lost (k + i) i
@Becoming.Drift.Replacement.le_of_le_eq : ∀ {a b c : Nat}, a ≤ b → b = c → a ≤ c
@Becoming.Drift.Replacement.le_of_eq_le : ∀ {a b c : Nat}, a = b → b ≤ c → a ≤ c
Becoming.Drift.Replacement.turn_out : ∀ (a b c P : Nat), c * (a * (b * P)) = P * (a * b * c)
Becoming.Drift.Replacement.add_one_add : ∀ (j n : Nat), j + (n + 1) = j + 1 + n
@Becoming.Drift.Replacement.ups_le : ∀ {f g : Nat → Nat} {n j : Nat},
  (∀ (k : Nat), j < k → k ≤ j + n → f k ≤ g k) →
    Becoming.Drift.Replacement.ups f j n ≤ Becoming.Drift.Replacement.ups g j n
@Becoming.Drift.Replacement.ups_pos : ∀ {f : Nat → Nat} {n j : Nat},
  (∀ (k : Nat), j < k → k ≤ j + n → 0 < f k) → 0 < Becoming.Drift.Replacement.ups f j n
@Becoming.Drift.Replacement.riseBy_shift : ∀ {M : Nat} {u d : Nat → Nat} (n j : Nat),
