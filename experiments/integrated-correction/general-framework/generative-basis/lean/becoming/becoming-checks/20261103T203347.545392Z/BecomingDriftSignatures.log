    (∀ (j : Nat), Becoming.Drift.Replacement.Mixed M j → c ≤ u j) →
      c ≤ T →
        ∀ (j : Nat),
          Becoming.Drift.Replacement.valueBy M T u d e (Becoming.Drift.Replacement.varied M) (M + 1) j +
