    Becoming.Drift.Replacement.ups u j n * Becoming.Drift.Replacement.riseBy M u d (j + n) =
      Becoming.Drift.Replacement.ups d j n * Becoming.Drift.Replacement.riseBy M u d j
@Becoming.Drift.Replacement.riseBy_le_of_favoured : ∀ {M : Nat} {u d : Nat → Nat} {j n : Nat},
