    (Becoming.LineageRegions.Courses.generations Becoming.LineageRegions.Courses.always).concordAt s = 2) ∧
  ∀ (t : Nat) (p : Becoming.LineageRegions.Courses.Formation),
    p ∈ (Becoming.LineageRegions.Courses.generations Becoming.LineageRegions.Courses.always).family t →
      Becoming.«退化»
        (Becoming.LineageRegions.lineStep (Becoming.LineageRegions.Courses.flow Becoming.LineageRegions.Courses.always)
          (Becoming.LineageRegions.Courses.web Becoming.LineageRegions.Courses.always) fun a b => a = b)
        ((Becoming.LineageRegions.Courses.web Becoming.LineageRegions.Courses.always).kindClass fun a b => a = b) (t, p)
Becoming.LineageRegions.Courses.same_terms_two_fates : ∀ (H : Nat),
  (Becoming.LineageRegions.Courses.flow Becoming.LineageRegions.Courses.always).Acting
      (Becoming.LineageRegions.Courses.web Becoming.LineageRegions.Courses.always) ∧
    (Becoming.LineageRegions.Courses.flow (Becoming.LineageRegions.Courses.upTo H)).Acting
        (Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H)) ∧
      (∀ (x : Becoming.LineageRegions.Courses.Formation),
          (Becoming.LineageRegions.Courses.web Becoming.LineageRegions.Courses.always).Embodied x) ∧
        (∀ (x : Becoming.LineageRegions.Courses.Formation),
            (Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H)).Embodied x) ∧
          Becoming.SelectionTerm.Flow.Descended
              (Becoming.LineageRegions.Courses.flow Becoming.LineageRegions.Courses.always)
              (Becoming.LineageRegions.Courses.web Becoming.LineageRegions.Courses.always)
              (Becoming.LineageRegions.Courses.generations Becoming.LineageRegions.Courses.always) ∧
            Becoming.SelectionTerm.Flow.Descended
                (Becoming.LineageRegions.Courses.flow (Becoming.LineageRegions.Courses.upTo H))
                (Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H))
                (Becoming.LineageRegions.Courses.generations (Becoming.LineageRegions.Courses.upTo H)) ∧
              (∀ (t : Nat),
                  t ≤ H + 1 →
                    (Becoming.LineageRegions.Courses.generations Becoming.LineageRegions.Courses.always).family t =
                      (Becoming.LineageRegions.Courses.generations (Becoming.LineageRegions.Courses.upTo H)).family t) ∧
                (∀ (t : Nat),
                    t ≤ H →
                      (Becoming.LineageRegions.Courses.generations Becoming.LineageRegions.Courses.always).concordAt t =
                          2 ∧
                        (Becoming.LineageRegions.Courses.generations (Becoming.LineageRegions.Courses.upTo H)).concordAt
                              t =
                            2 ∧
                          (Becoming.LineageRegions.Courses.generations Becoming.LineageRegions.Courses.always).discordAt
                                t =
                              0 ∧
                            (Becoming.LineageRegions.Courses.generations
                                    (Becoming.LineageRegions.Courses.upTo H)).discordAt
                                t =
                              0) ∧
                  Becoming.«生成»
                      (Becoming.LineageRegions.lineStep
                        (Becoming.LineageRegions.Courses.flow Becoming.LineageRegions.Courses.always)
                        (Becoming.LineageRegions.Courses.web Becoming.LineageRegions.Courses.always)
                        (Becoming.LineageRegions.oneKind Becoming.LineageRegions.Courses.Formation))
                      ((Becoming.LineageRegions.Courses.web Becoming.LineageRegions.Courses.always).kindClass
                        (Becoming.LineageRegions.oneKind Becoming.LineageRegions.Courses.Formation))
                      (Becoming.LineageRegions.Courses.web Becoming.LineageRegions.Courses.always).carrierClass
                      (0, 0, true) ∧
                    Becoming.«退化»
                      (Becoming.LineageRegions.lineStep
                        (Becoming.LineageRegions.Courses.flow (Becoming.LineageRegions.Courses.upTo H))
                        (Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H))
                        (Becoming.LineageRegions.oneKind Becoming.LineageRegions.Courses.Formation))
                      ((Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H)).kindClass
                        (Becoming.LineageRegions.oneKind Becoming.LineageRegions.Courses.Formation))
                      (0, 0, true)
Becoming.LineageRegions.Courses.positive_but_last : ∀ (H : Nat),
  (Becoming.LineageRegions.Courses.flow (Becoming.LineageRegions.Courses.upTo H)).Acting
      (Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H)) ∧
    (∀ (x : Becoming.LineageRegions.Courses.Formation),
        (Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H)).Embodied x) ∧
      Becoming.SelectionTerm.Flow.Descended
          (Becoming.LineageRegions.Courses.flow (Becoming.LineageRegions.Courses.upTo H))
          (Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H))
          (Becoming.LineageRegions.Courses.generations (Becoming.LineageRegions.Courses.upTo H)) ∧
        Becoming.LineageRegions.KidsContinue
            (Becoming.LineageRegions.lineStep
              (Becoming.LineageRegions.Courses.flow (Becoming.LineageRegions.Courses.upTo H))
              (Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H))
              (Becoming.LineageRegions.oneKind Becoming.LineageRegions.Courses.Formation))
            ((Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H)).kindClass
              (Becoming.LineageRegions.oneKind Becoming.LineageRegions.Courses.Formation))
            (Becoming.LineageRegions.Courses.generations (Becoming.LineageRegions.Courses.upTo H)) ∧
          Becoming.LineageRegions.ContinuationsAreKids
              (Becoming.LineageRegions.lineStep
                (Becoming.LineageRegions.Courses.flow (Becoming.LineageRegions.Courses.upTo H))
                (Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H))
                (Becoming.LineageRegions.oneKind Becoming.LineageRegions.Courses.Formation))
              ((Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H)).kindClass
                (Becoming.LineageRegions.oneKind Becoming.LineageRegions.Courses.Formation))
              (Becoming.LineageRegions.Courses.generations (Becoming.LineageRegions.Courses.upTo H)) ∧
            (∀ (t : Nat),
                t ≤ H →
                  0 <
                    (Becoming.LineageRegions.Courses.generations (Becoming.LineageRegions.Courses.upTo H)).concordAt
                      t) ∧
              0 < (Becoming.LineageRegions.Courses.generations (Becoming.LineageRegions.Courses.upTo H)).size (H + 1) ∧
                (Becoming.LineageRegions.Courses.generations (Becoming.LineageRegions.Courses.upTo H)).concordAt
                      (H + 1) =
                    0 ∧
                  (Becoming.LineageRegions.Courses.generations (Becoming.LineageRegions.Courses.upTo H)).discordAt
                        (H + 1) =
                      0 ∧
                    (∀ (N : Nat),
                        H + 2 ≤ N →
                          (Becoming.LineageRegions.Courses.generations (Becoming.LineageRegions.Courses.upTo H)).size
                              N =
                            0) ∧
                      (∀ (t : Nat) (p : Becoming.LineageRegions.Courses.Formation),
                          p ∈
                              (Becoming.LineageRegions.Courses.generations
                                    (Becoming.LineageRegions.Courses.upTo H)).family
                                t →
                            Becoming.«退化»
                              (Becoming.LineageRegions.lineStep
                                (Becoming.LineageRegions.Courses.flow (Becoming.LineageRegions.Courses.upTo H))
                                (Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H))
                                (Becoming.LineageRegions.oneKind Becoming.LineageRegions.Courses.Formation))
                              ((Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H)).kindClass
                                (Becoming.LineageRegions.oneKind Becoming.LineageRegions.Courses.Formation))
                              (t, p)) ∧
                        Becoming.«新而尽»
                          (Becoming.LineageRegions.lineStep
                            (Becoming.LineageRegions.Courses.flow (Becoming.LineageRegions.Courses.upTo H))
                            (Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H))
                            (Becoming.LineageRegions.oneKind Becoming.LineageRegions.Courses.Formation))
                          ((Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H)).kindClass
                            (Becoming.LineageRegions.oneKind Becoming.LineageRegions.Courses.Formation))
                          (Becoming.LineageRegions.Courses.web (Becoming.LineageRegions.Courses.upTo H)).carrierClass
                          (0, 0, true)
