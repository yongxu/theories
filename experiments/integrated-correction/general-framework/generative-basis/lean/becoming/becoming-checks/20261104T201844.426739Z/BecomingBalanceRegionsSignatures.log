@Becoming.Continuity.reachedListed_stays : ∀ {R : Type} [inst : DecidableEq R] {rel : R → R → Bool} {us : List R}
  {a : R} {k : Nat},
  (∀ (x : R),
      Becoming.Continuity.reachedListed rel us a (k + 1) x = true →
        Becoming.Continuity.reachedListed rel us a k x = true) →
    ∀ (j : Nat) (x : R),
      Becoming.Continuity.reachedListed rel us a (k + j) x = true →
        Becoming.Continuity.reachedListed rel us a k x = true
@Becoming.Continuity.reachedListed_grows_or_stays : ∀ {R : Type} [inst : DecidableEq R] {rel : R → R → Bool}
