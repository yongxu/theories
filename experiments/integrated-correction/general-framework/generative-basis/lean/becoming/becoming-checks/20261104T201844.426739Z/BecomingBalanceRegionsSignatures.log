            Becoming.Continuity.reachedListed rel us a i x = true) ∨
    k + Becoming.«计» (Becoming.Continuity.reachedListed rel us a 0) us ≤
      Becoming.«计» (Becoming.Continuity.reachedListed rel us a k) us
