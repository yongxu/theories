Becoming.Clearing.uncoupled : Becoming.Clearing.sparedFlow.Balances Becoming.Clearing.sparedWeb ∧
  Becoming.Clearing.sparedWeb.Dependent ∧
    (∀ (t : Nat),
        Becoming.Clearing.web.Supported t Becoming.Clearing.Formation.clearer ↔
          Becoming.Clearing.sparedWeb.Supported t Becoming.Clearing.Formation.clearer) ∧
      (∀ (t : Nat),
          Becoming.Clearing.web.active t Becoming.Clearing.Formation.clearer ∧
            Becoming.Clearing.web.Supported t Becoming.Clearing.Formation.clearer) ∧
        (∀ (t : Nat),
            Becoming.Clearing.sparedWeb.active t Becoming.Clearing.Formation.dweller ∧
              Becoming.Clearing.sparedWeb.Supported t Becoming.Clearing.Formation.dweller) ∧
          ∀ (n : Nat), ¬Becoming.Clearing.web.active (n + 2) Becoming.Clearing.Formation.dweller
Becoming.Clearing.reaches_dweller : Becoming.Clearing.flow.Reaches Becoming.Clearing.web Becoming.Clearing.clearerPart
  Becoming.Clearing.Formation.dweller
