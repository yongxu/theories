  {c : C}, (∀ (g : F), g ∈ L.present t ∧ W.requires t g c ∧ 0 < L.give t g c) → ∀ (f g : F), L.WithinFeeding W f g
@Becoming.Flow.beyond_influence : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {f g h : F},
  L.WithinInfluence W f g → ¬L.WithinInfluence W f h → ∀ {c : C}, W.DependsOn g c → ¬L.Exchanges h c
@Becoming.Flow.Balances.levels_agree : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {L' : Becoming.Flow F C} {W' : Becoming.Web F C},
  L.Balances W →
    L'.Balances W' →
      ∀ {c : C},
        W.level 0 c = W'.level 0 c →
          (∀ (t : Nat), L.taken t c = L'.taken t c) →
            (∀ (t : Nat), L.given t c = L'.given t c) → ∀ (t : Nat), W.level t c = W'.level t c
@Becoming.Flow.Balances.support_agrees : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {L' : Becoming.Flow F C} {W' : Becoming.Web F C},
  L.Balances W →
    L'.Balances W' →
      ∀ {g : F},
        (∀ (t : Nat) (c : C), W.requires t g c ↔ W'.requires t g c) →
          (∀ (t : Nat) (c : C), W.need t g c = W'.need t g c) →
            (∀ (c : C), W.DependsOn g c → W.level 0 c = W'.level 0 c) →
              (∀ (t : Nat) (c : C), W.DependsOn g c → L.taken t c = L'.taken t c) →
                (∀ (t : Nat) (c : C), W.DependsOn g c → L.given t c = L'.given t c) →
                  ∀ (t : Nat), W.Supported t g ↔ W'.Supported t g
@Becoming.Flow.Balances.agrees_iff_even : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool},
