    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {t : Nat} {c : C},
          ¬W.level t c = l t c → ∃ h s, part h = true ∧ s < t ∧ h ∈ L.present s ∧ (0 < L.take s h c ∨ 0 < L.give s h c)
@Becoming.Flow.Balances.exchanges_of_differs : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l → ∀ {t : Nat} {c : C}, ¬W.level t c = l t c → ∃ h, part h = true ∧ L.Exchanges h c
@Becoming.Flow.Balances.agrees_or_reaches_before : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {t : Nat} {g : F} {c : C}, W.requires t g c → W.level t c = l t c ∨ L.ReachesBefore W part t g
@Becoming.Flow.Balances.agrees_or_reaches : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {t : Nat} {g : F} {c : C}, W.requires t g c → W.level t c = l t c ∨ L.Reaches W part g
@Becoming.Flow.Balances.admits_unreached_before : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {t : Nat} {g : F}, ¬L.ReachesBefore W part t g → (W.Supported t g ↔ W.Admits (l t) t g)
@Becoming.Flow.Balances.admits_unreached : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l → ∀ {g : F}, ¬L.Reaches W part g → ∀ (t : Nat), W.Supported t g ↔ W.Admits (l t) t g
@Becoming.Flow.unreached_within_influence : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool} {f : F},
  (∀ (h : F), part h = true → ¬L.WithinInfluence W f h) → ∀ {g : F}, L.WithinInfluence W f g → ¬L.Reaches W part g
@Becoming.Flow.Balances.uncoupled_beyond_influence : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {f : F},
          (∀ (h : F), part h = true → ¬L.WithinInfluence W f h) →
            ∀ (t : Nat) (g : F), L.WithinInfluence W f g → (W.Supported t g ↔ W.Admits (l t) t g)
@Becoming.Flow.Balances.retains_transfer : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool} {Pos : Type},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {sig sig' : Pos → Nat → F → Prop} {p : Pos},
          (∀ (t : Nat) (g : F), L.ReachesBefore W part t g → sig' p t g → sig p t g) →
            (W.Retains sig p W.level l → W.Retains sig' p W.level l) ∧
              (W.Retains sig p l W.level → W.Retains sig' p l W.level)
@Becoming.Flow.Balances.not_adds_transfer : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool} {Pos : Type},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {sig sig' : Pos → Nat → F → Prop} {p : Pos},
          (∀ (t : Nat) (g : F), L.ReachesBefore W part t g → sig' p t g → sig p t g) →
            (¬W.Adds sig p W.level l → ¬W.Adds sig' p W.level l) ∧ (¬W.Adds sig p l W.level → ¬W.Adds sig' p l W.level)
@Becoming.Flow.Balances.comparison_local : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool} {Pos : Type},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {sig sig' : Pos → Nat → F → Prop} {p : Pos},
          (∀ (t : Nat) (g : F), L.ReachesBefore W part t g → (sig p t g ↔ sig' p t g)) →
            (W.Retains sig p W.level l ↔ W.Retains sig' p W.level l) ∧
              (W.Retains sig p l W.level ↔ W.Retains sig' p l W.level) ∧
                (¬W.Adds sig p W.level l ↔ ¬W.Adds sig' p W.level l) ∧
                  (¬W.Adds sig p l W.level ↔ ¬W.Adds sig' p l W.level)
@Becoming.Flow.Balances.comparison_within_reach : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool} {Pos : Type},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
          (∀ (t : Nat) (g : F), L.ReachesBefore W part t g → sig p t g) →
            (W.Retains sig p W.level l ↔ W.Includes W.level l) ∧
              (W.Retains sig p l W.level ↔ W.Includes l W.level) ∧
                (¬W.Adds sig p W.level l ↔ ¬W.Exceeds W.level l) ∧ (¬W.Adds sig p l W.level ↔ ¬W.Exceeds l W.level)
@Becoming.Flow.Balances.adds_iff_exceeds_of_decidable : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool} {Pos : Type},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
          (∀ (t : Nat) (g : F), L.ReachesBefore W part t g → sig p t g) →
            ∀ (decided : (t : Nat) → (g : F) → Decidable (sig p t g)),
              (W.Adds sig p W.level l ↔ W.Exceeds W.level l) ∧ (W.Adds sig p l W.level ↔ W.Exceeds l W.level)
@Becoming.Flow.Balances.not_not_adds_of_exceeds : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool} {Pos : Type},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
          (∀ (t : Nat) (g : F), L.ReachesBefore W part t g → sig p t g) →
            (W.Exceeds W.level l → ¬¬W.Adds sig p W.level l) ∧ (W.Exceeds l W.level → ¬¬W.Adds sig p l W.level)
@Becoming.Flow.Balances.differs_before : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {L' : Becoming.Flow F C} {W' : Becoming.Web F C},
  L.Balances W →
    L'.Balances W' →
      (∀ (c : C), W.level 0 c = W'.level 0 c) →
        ∀ {c : C} (t : Nat),
          ¬W.level t c = W'.level t c → ∃ s, s < t ∧ (¬L.taken s c = L'.taken s c ∨ ¬L.given s c = L'.given s c)
@Becoming.Flow.Balances.comparison_within_difference : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {Pos : Type} {L' : Becoming.Flow F C} {W' : Becoming.Web F C},
  L.Balances W →
    L'.Balances W' →
      (∀ (c : C), W.level 0 c = W'.level 0 c) →
        ∀ {sig : Pos → Nat → F → Prop} {p : Pos},
          (∀ (t : Nat) (g : F), L.DiffersBefore L' W t g → sig p t g) →
            (W.Retains sig p W.level W'.level ↔ W.Includes W.level W'.level) ∧
              (W.Retains sig p W'.level W.level ↔ W.Includes W'.level W.level) ∧
                (¬W.Adds sig p W.level W'.level ↔ ¬W.Exceeds W.level W'.level) ∧
                  (¬W.Adds sig p W'.level W.level ↔ ¬W.Exceeds W'.level W.level)
@Becoming.Flow.reaches_within_closed : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {part : F → Bool}
  {region : F → Prop},
  Becoming.ClosedUnder (L.Affects W) region →
    (∀ (h : F), part h = true → region h) → ∀ {g : F}, L.Reaches W part g → region g
@Becoming.Flow.reaches_withinReach : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {part : F → Bool}
  {f : F}, (∀ (h : F), part h = true → L.WithinReach W f h) → ∀ {g : F}, L.Reaches W part g → L.WithinReach W f g
@Becoming.Flow.reaches_withinSystem : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {part : F → Bool}
  {f : F}, (∀ (h : F), part h = true → L.WithinSystem W f h) → ∀ {g : F}, L.Reaches W part g → L.WithinSystem W f g
@Becoming.Flow.unreached_within_system : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {part : F → Bool}
  {f : F}, (∀ (h : F), part h = true → ¬L.WithinSystem W f h) → ∀ {g : F}, L.WithinSystem W f g → ¬L.Reaches W part g
@Becoming.Flow.own_within_reach : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {part : F → Bool}
  {f : F}, (∀ (h : F), part h = true → h = f) → ∀ (h : F), part h = true → L.WithinReach W f h
@Becoming.Flow.own_within_system : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {part : F → Bool}
  {f : F}, (∀ (h : F), part h = true → h = f) → ∀ (h : F), part h = true → L.WithinSystem W f h
@Becoming.Flow.withinSystem_closed : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} (f : F),
  Becoming.ClosedUnder (L.Affects W) (L.WithinSystem W f)
@Becoming.Flow.Balances.closed_comparison : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool} {Pos : Type},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {region : Pos → F → Prop} {p : Pos},
          Becoming.ClosedUnder (L.Affects W) (region p) →
            (∀ (h : F), part h = true → region p h) →
