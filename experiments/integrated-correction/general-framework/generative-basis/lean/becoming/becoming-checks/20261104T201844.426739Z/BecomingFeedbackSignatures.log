      L.WithheldLevels part W l → ∀ {c : C}, (∀ (s : Nat), L.partGiven part s c = 0) → ∀ (t : Nat), W.level t c ≤ l t c
@Becoming.Flow.Balances.admits_without_taker : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {part : F → Bool},
