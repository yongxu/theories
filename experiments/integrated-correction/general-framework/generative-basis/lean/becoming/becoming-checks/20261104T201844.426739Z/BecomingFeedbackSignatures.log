    Becoming.Clearing.web.Adds (Becoming.bounded (Becoming.Clearing.flow.WithinSystem Becoming.Clearing.web))
        Becoming.Clearing.Formation.clearer l Becoming.Clearing.web.level ∧
      ¬Becoming.Clearing.web.Retains (Becoming.bounded (Becoming.Clearing.flow.WithinSystem Becoming.Clearing.web))
            Becoming.Clearing.Formation.clearer Becoming.Clearing.web.level l ∧
        Becoming.Clearing.web.Retains (Becoming.bounded (Becoming.Clearing.flow.WithinInfluence Becoming.Clearing.web))
          Becoming.Clearing.Formation.clearer Becoming.Clearing.web.level l
