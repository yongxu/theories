  fun x x_1 => 3
@Becoming.Margin.reach_without_misjudgment : ∀ {l : Nat → Unit → Nat},
  Becoming.Margin.flow.WithheldLevels Becoming.Margin.takerPart Becoming.Margin.web l →
    Becoming.Margin.flow.Reaches Becoming.Margin.web Becoming.Margin.takerPart false ∧
