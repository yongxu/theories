@Becoming.GrammarLaws.keep_congr : ∀ {α : Type u_1} {p q : α → Bool} (l : List α),
  (∀ (x : α), x ∈ l → p x = q x) → Becoming.GrammarLaws.keep p l = Becoming.GrammarLaws.keep q l
@Becoming.GrammarLaws.keep_all : ∀ {α : Type u_1} {p : α → Bool} (l : List α),
  (∀ (x : α), x ∈ l → p x = true) → Becoming.GrammarLaws.keep p l = l
@Becoming.GrammarLaws.mem_keep : ∀ {α : Type u_1} {p : α → Bool} {x : α} {l : List α},
  x ∈ Becoming.GrammarLaws.keep p l ↔ x ∈ l ∧ p x = true
@Becoming.GrammarLaws.any_false_mem : ∀ {α : Type u_1} {p : α → Bool} {l : List α} {x : α},
  l.any p = false → x ∈ l → p x = false
@Becoming.GrammarLaws.any_split : ∀ {α : Type u_1} {p : α → Bool} {l : List α},
  l.any p = true → ∃ a₁ y a₂, l = a₁ ++ y :: a₂ ∧ p y = true
@Becoming.GrammarLaws.any_remove : ∀ {α : Type u_1} {p : α → Bool} {f : α},
  p f = false → ∀ (a₂ a₁ : List α), (a₁ ++ f :: a₂).any p = (a₁ ++ a₂).any p
@Becoming.GrammarLaws.any_true_of_mem : ∀ {α : Type u_1} {p : α → Bool} {l : List α} {x : α},
  x ∈ l → p x = true → l.any p = true
@Becoming.GrammarLaws.any_false_of : ∀ {α : Type u_1} {p : α → Bool} (l : List α),
  (∀ (x : α), x ∈ l → p x = false) → l.any p = false
@Becoming.GrammarLaws.mem_middle : ∀ {α : Type u_1} (y : α) (a₂ a₁ : List α), y ∈ a₁ ++ y :: a₂
@Becoming.GrammarLaws.mem_of_removed : ∀ {α : Type u_1} {x y : α} {a₂ a₁ : List α}, x ∈ a₁ ++ a₂ → x ∈ a₁ ++ y :: a₂
@Becoming.GrammarLaws.distinct_removed : ∀ {α : Type u_1} {y : α} {a₂ a₁ : List α},
  Becoming.Distinct (a₁ ++ y :: a₂) → Becoming.Distinct (a₁ ++ a₂) ∧ ¬y ∈ a₁ ++ a₂
@Becoming.GrammarLaws.not_eq_true_iff : ∀ {b : Bool}, (!b) = true ↔ b = false
@Becoming.«对之长» : ∀ {α : Type u_1} {R : Becoming.«际» α} {a b : List α}, Becoming.«对» R a b → a.length = b.length
@Becoming.«等长则一对» : ∀ {α : Type u_1} (a b : List α), a.length = b.length → Becoming.«对» Becoming.«一» a b
@Becoming.«一之对» : ∀ {α : Type u_1} {a b : List α}, Becoming.«对» Becoming.«一» a b ↔ a.length = b.length
@Becoming.«对之单调» : ∀ {α : Type u_1} {R S : Becoming.«际» α},
  Becoming.«则» R S → ∀ {a b : List α}, Becoming.«对» R a b → Becoming.«对» S a b
@Becoming.«对之自反» : ∀ {α : Type u_1} {R : Becoming.«际» α}, (∀ (x : α), R x x) → ∀ (a : List α), Becoming.«对» R a a
@Becoming.«对之左插» : ∀ {α : Type u_1} {S : Becoming.«际» α} {y x : α},
  S y x → ∀ (l₁ : List α) {l₂ m : List α}, Becoming.«对» S (l₁ ++ l₂) m → Becoming.«对» S (l₁ ++ y :: l₂) (x :: m)
@Becoming.«对之逆» : ∀ {α : Type u_1} {R : Becoming.«际» α} {a b : List α},
  Becoming.«对» R a b → Becoming.«对» (Becoming.«逆» R) b a
@Becoming.«对则守数» : ∀ {α : Type u_1} {R : Becoming.«际» α} {before given after taken : List α},
  Becoming.«对» R (before ++ given) (after ++ taken) → after.length + taken.length = before.length + given.length
@Becoming.«守数当且仅当可对» : ∀ {p q r s : Nat},
  r + s = p + q ↔
    ∃ before given after taken,
      before.length = p ∧
        given.length = q ∧
          after.length = r ∧ taken.length = s ∧ Becoming.«对» Becoming.«一» (before ++ given) (after ++ taken)
Becoming.«等长而不对之例» : ∃ R a b, a.length = b.length ∧ ¬Becoming.«对» R a b
@Becoming.«对之取» : ∀ {α : Type u_1} {S : Becoming.«际» α} {l c : List α},
  Becoming.«对» S l c →
    ∀ (b₁ : List α) {y : α} {b₂ : List α},
      l = b₁ ++ y :: b₂ → ∃ c₁ z c₂, c = c₁ ++ z :: c₂ ∧ S y z ∧ Becoming.«对» S (b₁ ++ b₂) (c₁ ++ c₂)
@Becoming.«对之接» : ∀ {α : Type u_1} {R S : Becoming.«际» α} {a b : List α},
  Becoming.«对» R a b → ∀ {c : List α}, Becoming.«对» S b c → Becoming.«对» (Becoming.«而» R S) a c
@Becoming.«对之传» : ∀ {α : Type u_1} {T : Becoming.«际» α},
  (∀ (x y z : α), T x y → T y z → T x z) →
    ∀ {a b c : List α}, Becoming.«对» T a b → Becoming.«对» T b c → Becoming.«对» T a c
@Becoming.«对之并» : ∀ {α : Type u_1} {R : Becoming.«际» α} {a₁ b₁ : List α},
  Becoming.«对» R a₁ b₁ → ∀ {a₂ b₂ : List α}, Becoming.«对» R a₂ b₂ → Becoming.«对» R (a₁ ++ a₂) (b₁ ++ b₂)
@Becoming.«对之换» : ∀ {α : Type u_1} {R : Becoming.«际» α},
  (∀ (x : α), R x x) → ∀ (a b : List α), Becoming.«对» R (a ++ b) (b ++ a)
@Becoming.«对之族» : ∀ {α : Type u_1} {ι : Type u_2} {R : Becoming.«际» α} {a b : ι → List α} (is : List ι),
  (∀ (i : ι), i ∈ is → Becoming.«对» R (a i) (b i)) → Becoming.«对» R (Becoming.«聚» a is) (Becoming.«聚» b is)
@Becoming.«对之程» : ∀ {α : Type u_1} {R : Becoming.«际» α} {L G K : Nat → List α} (S n : Nat),
  (∀ (t : Nat), S ≤ t → t < S + n → Becoming.«对» R (L t ++ G t) (L (t + 1) ++ K t)) →
    Becoming.«对» (Becoming.«所闭» R) (L S ++ Becoming.«聚» G (Becoming.steps S n))
      (L (S + n) ++ Becoming.«聚» K (Becoming.steps S n))
@Becoming.«聚之长» : ∀ {α : Type u_1} {ι : Type} (f : ι → List α) (is : List ι),
  (Becoming.«聚» f is).length = Becoming.total is fun i => (f i).length
@Becoming.GrammarLaws.total_congr : ∀ {ι : Type} {p q : ι → Nat},
  (∀ (i : ι), p i = q i) → ∀ (is : List ι), Becoming.total is p = Becoming.total is q
@Becoming.«程守数当且仅当可对» : ∀ {q x y : Nat → Nat} {S n : Nat},
  q (S + n) + Becoming.total (Becoming.steps S n) x = q S + Becoming.total (Becoming.steps S n) y ↔
    ∃ level lost gained,
      (∀ (t : Nat), (level t).length = q t) ∧
        (∀ (t : Nat), (lost t).length = x t) ∧
          (∀ (t : Nat), (gained t).length = y t) ∧
            Becoming.«对» Becoming.«一» (level S ++ Becoming.«聚» gained (Becoming.steps S n))
              (level (S + n) ++ Becoming.«聚» lost (Becoming.steps S n))
@Becoming.GrammarLaws.count_insert : ∀ {α : Type u_1} (p : α → Bool) (y : α) (b₁ b₂ : List α),
  Becoming.«计» p (b₁ ++ y :: b₂) = (bif p y then 1 else 0) + Becoming.«计» p (b₁ ++ b₂)
@Becoming.GrammarLaws.split_of_count_pos : ∀ {α : Type u_1} {p : α → Bool} {b : List α},
  0 < Becoming.«计» p b → ∃ b₁ y b₂, b = b₁ ++ y :: b₂ ∧ p y = true
@Becoming.GrammarLaws.count_go : ∀ {α : Type u_1} (p : α → Bool) (l : List α) (acc : Nat),
  List.countP.go p l acc = acc + Becoming.«计» p l
@Becoming.GrammarLaws.count_eq_countP : ∀ {α : Type u_1} (p : α → Bool) (l : List α), Becoming.«计» p l = List.countP p l
@Becoming.GrammarLaws.uncrossed_of_closed : ∀ {α : Type u_1} {R : Becoming.«际» α} {p : α → Bool},
  (Becoming.«闭» R fun x => p x = true) →
    (Becoming.«闭» (Becoming.«逆» R) fun x => p x = true) → ∀ (x y : α), R x y → p x = p y
@Becoming.GrammarLaws.uncrossed_iff_notGoingOut : ∀ {α : Type u_1} {R : Becoming.«际» α} {p : α → Bool},
  (∀ (x y : α), R x y → p x = p y) ↔
    (Becoming.«不出» R fun x => p x = true) ∧ Becoming.«不出» (Becoming.«逆» R) fun x => p x = true
@Becoming.GrammarLaws.uncrossed_iff_closed : ∀ {α : Type u_1} {R : Becoming.«际» α} {p : α → Bool},
  (∀ (x y : α), R x y → p x = p y) ↔
    (Becoming.«闭» R fun x => p x = true) ∧ Becoming.«闭» (Becoming.«逆» R) fun x => p x = true
@Becoming.«对则不越域守数» : ∀ {α : Type u_1} {R : Becoming.«际» α} {p : α → Bool},
  (∀ (x y : α), R x y → p x = p y) → ∀ {a b : List α}, Becoming.«对» R a b → Becoming.«计» p a = Becoming.«计» p b
@Becoming.«对则双闭域守数» : ∀ {α : Type u_1} {R : Becoming.«际» α} {p : α → Bool},
  (Becoming.«闭» R fun x => p x = true) →
    (Becoming.«闭» (Becoming.«逆» R) fun x => p x = true) →
      ∀ {a b : List α}, Becoming.«对» R a b → Becoming.«计» p a = Becoming.«计» p b
Becoming.«对而单闭域不守数之例» : (Becoming.«闭» (fun x y => x = 0 ∧ y = 1) fun x => Nat.beq 1 x = true) ∧
  Becoming.«对» (fun x y => x = 0 ∧ y = 1) [0] [1] ∧ Becoming.«计» (Nat.beq 1) [0] ≠ Becoming.«计» (Nat.beq 1) [1]
@Becoming.GrammarLaws.class_test_congr : ∀ {α : Type u_1} {E : Becoming.«际» α} {e : α → α → Bool},
  Becoming.«类» E → (∀ (x y : α), E x y ↔ e x y = true) → ∀ {x y : α}, E x y → ∀ (z : α), e z x = e z y
@Becoming.GrammarLaws.pair_of_class_counts : ∀ {α : Type u_1} {E : Becoming.«际» α} {e : α → α → Bool},
  Becoming.«类» E →
    (∀ (x y : α), E x y ↔ e x y = true) →
      ∀ (a b : List α), (∀ (z : α), Becoming.«计» (e z) a = Becoming.«计» (e z) b) → Becoming.«对» E a b
@Becoming.«类之对当且仅当类类等数» : ∀ {α : Type u_1} {E : Becoming.«际» α} {e : α → α → Bool},
  Becoming.«类» E →
    (∀ (x y : α), E x y ↔ e x y = true) →
      ∀ {a b : List α}, Becoming.«对» E a b ↔ ∀ (z : α), Becoming.«计» (e z) a = Becoming.«计» (e z) b
@Becoming.«续之对则类类等数» : ∀ {α : Type u_1} {R E : Becoming.«际» α} {e : α → α → Bool},
  Becoming.«类» E →
    (∀ (x y : α), E x y ↔ e x y = true) →
      ∀ {a b : List α}, Becoming.«对» (Becoming.«续» R E) a b → ∀ (z : α), Becoming.«计» (e z) a = Becoming.«计» (e z) b
Becoming.«一对而静不对之例» : Becoming.«对» Becoming.«一» [0] [1] ∧ ¬Becoming.«对» Becoming.«静» [0] [1]
@Becoming.«定后之逐点» : ∀ {α : Type u_1} {R : Becoming.«际» α}, Becoming.«定后» R ↔ ∀ (x y z : α), R x y → R x z → y = z
@Becoming.«定前之逐点» : ∀ {α : Type u_1} {R : Becoming.«际» α}, Becoming.«定前» R ↔ ∀ (x y z : α), R x z → R y z → x = y
@Becoming.«定前即逆之定后» : ∀ {α : Type u_1} {R : Becoming.«际» α}, Becoming.«定前» R ↔ Becoming.«定后» (Becoming.«逆» R)
@Becoming.«历之接» : ∀ {α : Type u_1} {A : Type u_2} (F : A → Becoming.«际» α) (as bs : List A) {x z : α},
  Becoming.«历» F (as ++ bs) x z ↔ Becoming.«而» (Becoming.«历» F as) (Becoming.«历» F bs) x z
@Becoming.«历之末步» : ∀ {α : Type u_1} {A : Type u_2} (F : A → Becoming.«际» α) (as : List A) (a : A) {x z : α},
  Becoming.«历» F (as ++ [a]) x z ↔ ∃ y, Becoming.«历» F as x y ∧ F a y z
@Becoming.«历之逆» : ∀ {α : Type u_1} {A : Type u_2} (F : A → Becoming.«际» α) (as : List A) {x y : α},
  Becoming.«历» (fun a => Becoming.«逆» (F a)) as.reverse x y ↔ Becoming.«历» F as y x
