  d₁ ++ d₂ = e₁ ++ z :: e₂ → (∃ f, d₁ = e₁ ++ z :: f ∧ e₂ = f ++ d₂) ∨ ∃ f, e₁ = d₁ ++ f ∧ d₂ = f ++ z :: e₂
@Becoming.GrammarLaws.replicate_add_append : ∀ {α : Type u_1} (c : α) (a b : Nat),
  List.replicate (b + a) c = List.replicate a c ++ List.replicate b c
@Becoming.GrammarLaws.replicate_succ_append : ∀ {α : Type u_1} (c : α) (n : Nat),
  List.replicate (n + 1) c = List.replicate n c ++ [c]
@Becoming.GrammarLaws.reverseAux_append : ∀ {α : Type u_1} (as r s : List α),
