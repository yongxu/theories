@Becoming.ReadsNoOrder.not_entails : ∀ {S A C D : Type} {law : D → (S → S → Prop) → Prop},
  Becoming.ReadsNoOrder law →
    ∀ {frame : Becoming.Frame S A C} {living : C → Prop} {d : D},
      (∀ (better : S → S → Prop), law d better → Becoming.Comparison frame living better) →
        ∀ {s t : S}, Becoming.Extension frame living s t → ∀ {better : S → S → Prop}, ¬law d better
Becoming.LiftModel.met_and_failed : Becoming.LiftBetter Becoming.LiftModel.frame Becoming.LiftModel.larger 0
