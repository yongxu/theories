@Becoming.Weighting.reach_of_beyond : ∀ {X : Type} [DecidableEq X] {items : List X} {a : X → Bool} (L : List X),
  (∀ (z : X), z ∈ L → z ∈ items) →
    ∀ (b : X → Bool),
      Becoming.Weighting.IncludesOn items a b →
        (∀ (y : X), y ∈ items → a y = true → b y = false → y ∈ L) →
          Becoming.Weighting.IncludesOn items b a ∨ Becoming.«及» (Becoming.Weighting.WidensByOne items) a b
@Becoming.Weighting.widensOn_iff_reach : ∀ {X : Type} [DecidableEq X] {items : List X} {a b : X → Bool},
  Becoming.Weighting.WidensOn items a b ↔ Becoming.«及» (Becoming.Weighting.WidensByOne items) a b
@Becoming.Weighting.increasing_iff_by_one : ∀ {X : Type} [DecidableEq X] {items : List X}
  {O : (X → Bool) → (X → Bool) → Prop},
  (∀ {a b c : X → Bool}, O a b → O b c → O a c) →
    (Becoming.Weighting.Increasing items O ↔
      ∀ (x : X) (a b : X → Bool), Becoming.Weighting.WidensBy items x a b → O b a)
@Becoming.Weighting.exists_increasingInOwn_not_increasing : ∀ {X : Type} {items : List X} {own : X → Bool} {x : X},
  x ∈ items →
    own x = false → ∃ O, Becoming.Weighting.IncreasingInOwn items own O ∧ ¬Becoming.Weighting.Increasing items O
@Becoming.Weighting.increasingInOwn_iff_increasing_iff_marks : ∀ {X : Type} {items : List X} {own : X → Bool},
  (∀ (O : (X → Bool) → (X → Bool) → Prop),
      Becoming.Weighting.IncreasingInOwn items own O ↔ Becoming.Weighting.Increasing items O) ↔
    ∀ (x : X), x ∈ items → own x = true
@Becoming.Weighting.increasingInOwn_iff_increasing_iff_all : ∀ {α Pos : Type} {Q : Pos → α → Prop}
  {own : Pos → α → Bool},
  (∀ (p : Pos) (x : α), own p x = true ↔ Q p x) →
    ((∀ (p : Pos) (items : List α) (O : (α → Bool) → (α → Bool) → Prop),
        Becoming.Weighting.IncreasingInOwn items (own p) O ↔ Becoming.Weighting.Increasing items O) ↔
      ∀ (p : Pos) (x : α), Q p x)
@Becoming.Weighting.increasingInOwn_iff_increasing_of_noOutside : ∀ {α Pos : Type} {R E : Becoming.«际» α}
  {center : Pos → α},
  Becoming.«续无外» R E center →
    ∀ {p : Pos} {own : α → Bool},
      (∀ (x : α), Becoming.«所及» R E (center p) x → own x = true) →
        ∀ (items : List α) (O : (α → Bool) → (α → Bool) → Prop),
          Becoming.Weighting.IncreasingInOwn items own O ↔ Becoming.Weighting.Increasing items O
@Becoming.Weighting.exists_increasingInOwn_not_increasing_of_outside : ∀ {α Pos : Type} {R E : Becoming.«际» α}
  {center : Pos → α} {p : Pos} {own : α → Bool},
  (∀ (x : α), own x = true → Becoming.«所及» R E (center p) x) →
    ∀ {items : List α} {x : α},
      x ∈ items →
        ¬Becoming.«所及» R E (center p) x →
          ∃ O, Becoming.Weighting.IncreasingInOwn items own O ∧ ¬Becoming.Weighting.Increasing items O
@Becoming.Weighting.increasingInOwn_iff_increasing_iff_noOutside : ∀ {α Pos : Type} {R E : Becoming.«际» α}
  {center : Pos → α} {own : Pos → α → Bool},
  (∀ (p : Pos) (x : α), own p x = true ↔ Becoming.«所及» R E (center p) x) →
    ((∀ (p : Pos) (items : List α) (O : (α → Bool) → (α → Bool) → Prop),
        Becoming.Weighting.IncreasingInOwn items (own p) O ↔ Becoming.Weighting.Increasing items O) ↔
      Becoming.«续无外» R E center)
@Becoming.Weighting.increasingInOwn_iff_increasing_iff_unrestricted : ∀ {F Pos : Type} {rel : F → F → Prop}
  {center : Pos → F} {own : Pos → F → Bool},
  (∀ (p : Pos) (x : F), own p x = true ↔ Becoming.WithinClosure rel (center p) x) →
    ((∀ (p : Pos) (items : List F) (O : (F → Bool) → (F → Bool) → Prop),
        Becoming.Weighting.IncreasingInOwn items (own p) O ↔ Becoming.Weighting.Increasing items O) ↔
      Becoming.Unrestricted (Becoming.selfAscribed (Becoming.ownClosure rel) center))
@Becoming.Weighting.increasingInOwn_iff_increasing_of_unrestricted : ∀ {F Pos : Type} {rel : F → F → Prop}
  {center : Pos → F},
  Becoming.Unrestricted (Becoming.selfAscribed (Becoming.ownClosure rel) center) →
    ∀ {p : Pos} {own : F → Bool},
      (∀ (x : F), Becoming.WithinClosure rel (center p) x → own x = true) →
        ∀ (items : List F) (O : (F → Bool) → (F → Bool) → Prop),
          Becoming.Weighting.IncreasingInOwn items own O ↔ Becoming.Weighting.Increasing items O
@Becoming.Web.admits_need : ∀ {F C : Type} (W : Becoming.Web F C) (t : Nat) (f : F),
  W.Admits (fun c => W.need t f c) t f
@Becoming.Web.admits_nothing_from_of_listed : ∀ {F C : Type} {W : Becoming.Web F C} {items : List (Nat × F)}
  {l : Nat → C → Nat},
  W.ListsAdmitted items l → ∀ {t : Nat}, Becoming.Web.stepBound items ≤ t → ∀ (f : F), ¬W.Admits (l t) t f
@Becoming.Web.not_listsAdmitted_every : ∀ {F C : Type} (W : Becoming.Web F C) (f : F) {items : List (Nat × F)},
  ¬∀ (l : Nat → C → Nat), W.ListsAdmitted items l
@Becoming.Web.no_extension_of_listsAdmitted_every : ∀ {F C : Type} {W : Becoming.Web F C} {items : List (Nat × F)},
  (∀ (l : Nat → C → Nat), W.ListsAdmitted items l) →
    ∀ {living : F × Nat → Prop} {l l' : Nat → C → Nat}, ¬Becoming.Extension W.paths living l' l
@Becoming.Web.extension_ranked_of_increasing : ∀ {F C : Type} {W : Becoming.Web F C}
  {admitted : (Nat → C → Nat) → Nat × F → Bool},
  W.DecidesAdmission admitted →
    ∀ {items : List (Nat × F)} {O : (Nat × F → Bool) → (Nat × F → Bool) → Prop},
      Becoming.Weighting.Increasing items O →
        ∀ {l l' : Nat → C → Nat},
          W.ListsAdmitted items l →
            W.ListsAdmitted items l' → Becoming.Extension W.paths (fun x => True) l' l → O (admitted l') (admitted l)
@Becoming.Web.extension_ranked_of_increasingInOwn : ∀ {F C : Type} {W : Becoming.Web F C} {Pos : Type}
  {rel : F → F → Prop} {center : Pos → F},
  Becoming.Unrestricted (Becoming.selfAscribed (Becoming.ownClosure rel) center) →
    ∀ {p : Pos} {own : F → Bool},
      (∀ (f : F), Becoming.WithinClosure rel (center p) f → own f = true) →
        ∀ {admitted : (Nat → C → Nat) → Nat × F → Bool},
          W.DecidesAdmission admitted →
            ∀ {items : List (Nat × F)} {O : (Nat × F → Bool) → (Nat × F → Bool) → Prop},
              Becoming.Weighting.IncreasingInOwn items (fun i => own i.snd) O →
                ∀ {l l' : Nat → C → Nat},
                  W.ListsAdmitted items l →
                    W.ListsAdmitted items l' →
                      Becoming.Extension W.paths (fun x => True) l' l → O (admitted l') (admitted l)
