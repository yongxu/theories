  (∀ (u : Nat), u < T → q u = 0) →
    (∀ (u : Nat), T + n ≤ u → q u = 0) →
      (∀ (u : Nat), q u ≤ d) → ∀ (t : Nat), Becoming.total (Becoming.steps 0 t) q ≤ n * d
