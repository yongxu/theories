@Becoming.ReadingSchedule.shift_lt : ∀ {T j ℓ u : Nat}, T + (j + 1 + ℓ) ≤ u → T + j + ℓ < u
@Becoming.ReadingSchedule.shift_le : ∀ {T j ℓ u : Nat}, T + j + ℓ < u → T + (j + 1 + ℓ) ≤ u
