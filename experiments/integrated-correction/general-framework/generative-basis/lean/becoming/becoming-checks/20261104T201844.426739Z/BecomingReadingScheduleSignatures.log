  Becoming.ReadingSchedule.PoolWithin r x a →
    ∀ (T n : Nat), n ≤ Becoming.total (Becoming.steps T (n * a)) fun t => Becoming.ReadingSchedule.times (r t) x
@Becoming.ReadingSchedule.pool_density : ∀ {X : Type} [DecidableEq X] {ι : Type} {r : Nat → List X} {k : Nat},
  (∀ (t : Nat), (r t).length ≤ k) →
    ∀ {cs : List ι} {name : ι → X},
      Becoming.Distinct (List.map name cs) →
        ∀ {a q : ι → Nat} {P : Nat},
          (∀ (c : ι), c ∈ cs → Becoming.ReadingSchedule.PoolWithin r (name c) (a c)) →
            (∀ (c : ι), c ∈ cs → q c * a c ≤ P) → Becoming.total cs q ≤ P * k
@Becoming.ReadingSchedule.density : ∀ {X : Type} [DecidableEq X] {ι : Type} {s : Nat → X} {cs : List ι} {name : ι → X},
  Becoming.Distinct (List.map name cs) →
    ∀ {a q : ι → Nat} {P : Nat},
      (∀ (c : ι), c ∈ cs → Becoming.ReadingSchedule.Within s (name c) (a c)) →
        (∀ (c : ι), c ∈ cs → q c * a c ≤ P) → Becoming.total cs q ≤ P
@Becoming.ReadingSchedule.no_two_three : ∀ {X : Type} {s : Nat → X} {x y z : X},
  x ≠ y →
    z ≠ y →
      x ≠ z →
        ∀ (M : Nat),
          ¬(Becoming.ReadingSchedule.Within s x 2 ∧
              Becoming.ReadingSchedule.Within s y 3 ∧ Becoming.ReadingSchedule.Within s z M)
@Becoming.ReadingSchedule.two_three_room : ∀ {M : Nat},
  7 ≤ M → 3 * M * 2 = 6 * M ∧ 2 * M * 3 = 6 * M ∧ 6 * M = 6 * M ∧ 3 * M + 2 * M + 6 < 6 * M
@Becoming.ReadingSchedule.weave_even : ∀ {X : Type} (s₀ s₁ : Nat → X) (u : Nat),
  Becoming.ReadingSchedule.weave s₀ s₁ (2 * u) = s₀ u
@Becoming.ReadingSchedule.weave_odd : ∀ {X : Type} (s₀ s₁ : Nat → X) (u : Nat),
  Becoming.ReadingSchedule.weave s₀ s₁ (2 * u + 1) = s₁ u
Becoming.ReadingSchedule.halves : ∀ (T : Nat), ∃ v, T = 2 * v ∨ T = 2 * v + 1
@Becoming.ReadingSchedule.double_lt : ∀ {j a : Nat}, j < a → 2 * j + 1 < 2 * a
Becoming.ReadingSchedule.even_add : ∀ (v j : Nat), 2 * v + 2 * j = 2 * (v + j)
Becoming.ReadingSchedule.odd_add : ∀ (v j : Nat), 2 * v + 1 + 2 * j = 2 * (v + j) + 1
Becoming.ReadingSchedule.odd_add_odd : ∀ (v j : Nat), 2 * v + 1 + (2 * j + 1) = 2 * (v + 1 + j)
