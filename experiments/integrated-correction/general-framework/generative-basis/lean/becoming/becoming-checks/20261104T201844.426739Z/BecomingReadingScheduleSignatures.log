Becoming.ReadingSchedule.climb_spec : ∀ (a f k : Nat),
  2 ^ k ≤ a →
    a < 2 ^ (k + f + 1) →
      2 ^ Becoming.ReadingSchedule.climb a f k ≤ a ∧ a < 2 ^ (Becoming.ReadingSchedule.climb a f k + 1)
Becoming.ReadingSchedule.lt_two_pow : ∀ (n : Nat), n < 2 ^ n
@Becoming.ReadingSchedule.lg_spec : ∀ {a : Nat},
  0 < a → 2 ^ Becoming.ReadingSchedule.lg a ≤ a ∧ a < 2 ^ (Becoming.ReadingSchedule.lg a + 1)
Becoming.ReadingSchedule.cap_le : ∀ (D L : Nat),
  Becoming.ReadingSchedule.cap D L ≤ D ∧ Becoming.ReadingSchedule.cap D L ≤ L
@Becoming.ReadingSchedule.mul_lt_mul_left' : ∀ {m n : Nat}, m < n → ∀ {k : Nat}, 0 < k → k * m < k * n
@Becoming.ReadingSchedule.weight_le : ∀ {a q D : Nat},
  0 < a → 2 ^ (D + 1) ≤ q * a → 2 ^ (D - Becoming.ReadingSchedule.cap D (Becoming.ReadingSchedule.lg a)) ≤ q
@Becoming.ReadingSchedule.half_suffices : ∀ {X : Type} {cs : List X} {a q : X → Nat} {D : Nat},
  (∀ (c : X), c ∈ cs → 0 < a c) →
    (∀ (c : X), c ∈ cs → 2 ^ (D + 1) ≤ q c * a c) →
      Becoming.total cs q ≤ 2 ^ D → ∃ s, ∀ (c : X), c ∈ cs → Becoming.ReadingSchedule.Within s (some c) (a c)
@Becoming.Flow.taken_of_read : ∀ {X F C : Type} {L : Becoming.Flow F C} {part : F → Bool} {s : Nat → X} {name : C → X}
  {c : C} {a d T ℓ : Nat},
  Becoming.ReadingSchedule.Within s (name c) a →
    (∀ (u : Nat), L.partTaken part u c ≤ d) →
      (∀ (u : Nat), u < T → L.partTaken part u c = 0) →
        (∀ (u R : Nat), T ≤ R → s R = name c → R + ℓ < u → L.partTaken part u c = 0) →
          ∀ (t : Nat), (Becoming.total (Becoming.steps 0 t) fun u => L.partTaken part u c) ≤ (a + ℓ) * d
@Becoming.Flow.Balances.retains_of_read : ∀ {X F C Pos : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {sig : Pos → Nat → F → Prop} {p : Pos} {s : Nat → X} {name : C → X} {a d T : C → Nat} {ℓ : Nat},
          (∀ (c : C), 0 < d c → Becoming.ReadingSchedule.Within s (name c) (a c)) →
            (∀ (u : Nat) (c : C), L.partTaken part u c ≤ d c) →
              (∀ (u : Nat) (c : C), u < T c → L.partTaken part u c = 0) →
                (∀ (u : Nat) (c : C) (R : Nat), T c ≤ R → s R = name c → R + ℓ < u → L.partTaken part u c = 0) →
                  (∀ (t : Nat) (f : F),
                      sig p t f →
                        W.Admits (l t) t f → ∀ (c : C), W.requires t f c → W.need t f c + (a c + ℓ) * d c ≤ l t c) →
                    W.Retains sig p W.level l
@Becoming.Flow.Balances.loses_of_unread : ∀ {X F C Pos : Type} {L : Becoming.Flow F C} {part : F → Bool}
  {W : Becoming.Web F C},
  L.Balances W →
    ∀ {l : Nat → C → Nat},
      L.WithheldLevels part W l →
        ∀ {sig : Pos → Nat → F → Prop} {p : Pos} {s : Nat → X} {name : C → X} {c : C} {T k ℓ d t : Nat} {f : F},
          Becoming.ReadingSchedule.Unread s (name c) T k →
            (∀ (u : Nat), T ≤ u → (∀ (R : Nat), T ≤ R → s R = name c → u ≤ R + ℓ) → d ≤ L.partTaken part u c) →
              (∀ (u : Nat), L.partGiven part u c = 0) →
                T + (k + 1 + ℓ) ≤ t →
                  sig p t f →
                    W.Admits (l t) t f →
                      W.requires t f c → l t c < W.need t f c + (k + 1 + ℓ) * d → W.Adds sig p l W.level
@Becoming.ReadingSchedule.keeps_of_within : ∀ {X C : Type} [DecidableEq C] {s : Nat → X} {name : C → X} {c : C}
  {a ℓ d m : Nat},
  Becoming.ReadingSchedule.Within s (name c) a → (a + ℓ) * d ≤ m → Becoming.ReadingSchedule.Keeps s name c ℓ d m
@Becoming.ReadingSchedule.Drawer.partTaken_eq : ∀ {C : Type} [inst : DecidableEq C] (c : C) (T n d u : Nat) (c' : C),
  (Becoming.ReadingSchedule.Drawer.flow c T n d).partTaken (fun f => f) u c' =
    (Becoming.ReadingSchedule.Drawer.flow c T n d).take u true c'
@Becoming.ReadingSchedule.Drawer.take_le : ∀ {C : Type} [inst : DecidableEq C] (c : C) (T n d u : Nat) (c' : C),
  (Becoming.ReadingSchedule.Drawer.flow c T n d).take u true c' ≤ d
@Becoming.ReadingSchedule.Drawer.take_total : ∀ {C : Type} [inst : DecidableEq C] (c : C) (T n d : Nat) (c' : C)
  (t : Nat),
  (Becoming.total (Becoming.steps 0 t) fun u => (Becoming.ReadingSchedule.Drawer.flow c T n d).take u true c') ≤ n * d
@Becoming.ReadingSchedule.Drawer.take_total_end : ∀ {C : Type} [inst : DecidableEq C] (c : C) (T n d : Nat),
  (Becoming.total (Becoming.steps 0 (T + n)) fun u => (Becoming.ReadingSchedule.Drawer.flow c T n d).take u true c) =
    n * d
@Becoming.ReadingSchedule.Drawer.sub_add_of_le : ∀ {B y x : Nat}, y + x ≤ B → B - (y + x) + x = B - y
@Becoming.ReadingSchedule.Drawer.balances : ∀ {C : Type} [inst : DecidableEq C] (c : C) (T n d m : Nat),
  (Becoming.ReadingSchedule.Drawer.flow c T n d).Balances (Becoming.ReadingSchedule.Drawer.web c T n d m)
@Becoming.ReadingSchedule.Drawer.withheld : ∀ {C : Type} [inst : DecidableEq C] (c : C) (T n d m : Nat),
  (Becoming.ReadingSchedule.Drawer.flow c T n d).WithheldLevels (fun f => f)
    (Becoming.ReadingSchedule.Drawer.web c T n d m) fun x x_1 => n * d + m
@Becoming.ReadingSchedule.within_of_keeps : ∀ {X C : Type} [DecidableEq X] [DecidableEq C] {s : Nat → X} {name : C → X}
  {c : C} {a ℓ d m : Nat},
  Becoming.ReadingSchedule.Keeps s name c ℓ d m → m < (a + 1 + ℓ) * d → Becoming.ReadingSchedule.Within s (name c) a
@Becoming.ReadingSchedule.keeps_iff_within : ∀ {X C : Type} [DecidableEq X] [DecidableEq C] {s : Nat → X} {name : C → X}
  {c : C} {a ℓ d m : Nat},
  (a + ℓ) * d ≤ m →
    m < (a + 1 + ℓ) * d → (Becoming.ReadingSchedule.Keeps s name c ℓ d m ↔ Becoming.ReadingSchedule.Within s (name c) a)
@Becoming.ReadingSchedule.keeps_density : ∀ {X C : Type} [DecidableEq X] [DecidableEq C] {s : Nat → X} {name : C → X}
  {cs : List C},
  Becoming.Distinct (List.map name cs) →
    ∀ {ℓ P : Nat} {a d m q : C → Nat},
      (∀ (c : C), c ∈ cs → Becoming.ReadingSchedule.Keeps s name c ℓ (d c) (m c)) →
        (∀ (c : C), c ∈ cs → m c < (a c + 1 + ℓ) * d c) → (∀ (c : C), c ∈ cs → q c * a c ≤ P) → Becoming.total cs q ≤ P
@Becoming.ReadingSchedule.spare_not_enough : ∀ {X C : Type} [DecidableEq X] [DecidableEq C] {s : Nat → X} {name : C → X}
  {x y z : C},
  name x ≠ name y →
    name z ≠ name y →
      name x ≠ name z →
        ∀ {ℓ M : Nat} {d m : C → Nat},
          7 ≤ M →
            m x < (2 + 1 + ℓ) * d x →
              m y < (3 + 1 + ℓ) * d y →
                m z < (M + 1 + ℓ) * d z →
                  (3 * M * 2 = 6 * M ∧ 2 * M * 3 = 6 * M ∧ 6 * M = 6 * M ∧ 3 * M + 2 * M + 6 < 6 * M) ∧
                    ¬(Becoming.ReadingSchedule.Keeps s name x ℓ (d x) (m x) ∧
                        Becoming.ReadingSchedule.Keeps s name y ℓ (d y) (m y) ∧
                          Becoming.ReadingSchedule.Keeps s name z ℓ (d z) (m z))
@Becoming.ReadingSchedule.keeps_of_half : ∀ {C : Type} [DecidableEq C] {cs : List C} {ℓ D : Nat} {a d m q : C → Nat},
  (∀ (c : C), c ∈ cs → 0 < a c) →
    (∀ (c : C), c ∈ cs → (a c + ℓ) * d c ≤ m c) →
      (∀ (c : C), c ∈ cs → 2 ^ (D + 1) ≤ q c * a c) →
        Becoming.total cs q ≤ 2 ^ D → ∃ s, ∀ (c : C), c ∈ cs → Becoming.ReadingSchedule.Keeps s some c ℓ (d c) (m c)
