@Becoming.ReadingSchedule.Code.At.reads : ∀ {X : Type} {K : Becoming.ReadingSchedule.Code X} {x : X} {k : Nat},
  K.At x k → Becoming.ReadingSchedule.Within K.reader (some x) (2 ^ k)
@Becoming.ReadingSchedule.pair_lift : ∀ {X : Type} {L : List (Becoming.ReadingSchedule.Code X)}
  {t : Becoming.ReadingSchedule.Code X},
  t ∈ L → ∃ u, u ∈ Becoming.ReadingSchedule.pair L ∧ ∀ (x : X) (k : Nat), t.At x k → u.At x (k + 1)
@Becoming.ReadingSchedule.pair_length : ∀ {X : Type} (L : List (Becoming.ReadingSchedule.Code X)),
  2 * (Becoming.ReadingSchedule.pair L).length ≤ L.length + 1
@Becoming.ReadingSchedule.leaves_mem : ∀ {X : Type} {x : X} {items : List (X × Nat)},
  (x, 0) ∈ items → Becoming.ReadingSchedule.Code.leaf x ∈ Becoming.ReadingSchedule.leaves items
@Becoming.ReadingSchedule.deeper_mem : ∀ {X : Type} {x : X} {k : Nat} {items : List (X × Nat)},
  (x, k + 1) ∈ items → (x, k) ∈ Becoming.ReadingSchedule.deeper items
@Becoming.ReadingSchedule.leaves_length : ∀ {X : Type} (items : List (X × Nat)),
  (Becoming.ReadingSchedule.leaves items).length ≤ items.length
@Becoming.ReadingSchedule.weight_split : ∀ {X : Type} (D : Nat) (items : List (X × Nat)),
  (Becoming.total items fun i => 2 ^ (D + 1 - i.snd)) =
    (Becoming.ReadingSchedule.leaves items).length * 2 ^ (D + 1) +
      Becoming.total (Becoming.ReadingSchedule.deeper items) fun i => 2 ^ (D - i.snd)
@Becoming.ReadingSchedule.weight_zero : ∀ {X : Type} (items : List (X × Nat)),
  (Becoming.total items fun i => 2 ^ (0 - i.snd)) = items.length
Becoming.ReadingSchedule.two_pow_pos : ∀ (n : Nat), 0 < 2 ^ n
@Becoming.ReadingSchedule.two_pow_le : ∀ {k' k : Nat}, k' ≤ k → 2 ^ k' ≤ 2 ^ k
@Becoming.ReadingSchedule.build_length : ∀ {X : Type} (D : Nat) (items : List (X × Nat)),
  (Becoming.ReadingSchedule.build items D).length * 2 ^ D < (Becoming.total items fun i => 2 ^ (D - i.snd)) + 2 ^ D
@Becoming.ReadingSchedule.build_holds : ∀ {X : Type} (D : Nat) {items : List (X × Nat)} {x : X} {k : Nat},
  (x, k) ∈ items → k ≤ D → ∃ t, t ∈ Becoming.ReadingSchedule.build items D ∧ ∃ k', k' ≤ k ∧ t.At x k'
@Becoming.ReadingSchedule.first_of_short : ∀ {X : Type} {L : List (Becoming.ReadingSchedule.Code X)},
  L.length < 2 → ∀ {t : Becoming.ReadingSchedule.Code X}, t ∈ L → Becoming.ReadingSchedule.first L = t
@Becoming.ReadingSchedule.lt_of_mul_lt_mul : ∀ {a b c : Nat}, a * c < b * c → a < b
@Becoming.ReadingSchedule.kraft_reads : ∀ {X : Type} {items : List (X × Nat)} {D : Nat},
  (∀ (i : X × Nat), i ∈ items → i.snd ≤ D) →
    (Becoming.total items fun i => 2 ^ (D - i.snd)) ≤ 2 ^ D →
      ∀ (x : X) (k : Nat),
        (x, k) ∈ items →
