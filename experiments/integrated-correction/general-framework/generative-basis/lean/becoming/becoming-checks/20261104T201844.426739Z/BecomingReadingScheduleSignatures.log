  Becoming.ReadingSchedule.Within s x a → a ≤ b → Becoming.ReadingSchedule.Within s x b
@Becoming.ReadingSchedule.Within.unread_lt : ∀ {X : Type} {s : Nat → X} {x : X} {a : Nat},
  Becoming.ReadingSchedule.Within s x a → ∀ {T k : Nat}, Becoming.ReadingSchedule.Unread s x T k → k < a
