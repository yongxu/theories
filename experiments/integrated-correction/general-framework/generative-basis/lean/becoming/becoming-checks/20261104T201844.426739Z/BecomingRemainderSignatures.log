  Becoming.orderBelow cs part σ k present δ j t c < Becoming.carried cs part σ k present δ t c ↔
    Becoming.ConveyedThrough cs part σ k present δ j t c
@Becoming.carriedWithin_lt_iff : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {k : Nat → F → C → Nat → C → Nat} {present : Nat → List F} {δ : C → Nat} (j t : Nat) (c : C),
  Becoming.carriedWithin cs part σ k present δ j t c < Becoming.carried cs part σ k present δ t c ↔
    Becoming.ConveyedThrough cs part σ k present δ (j + 1) t c
@Becoming.carriedWithin_eq_iff : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {k : Nat → F → C → Nat → C → Nat} {present : Nat → List F} {δ : C → Nat} (j t : Nat) (c : C),
  Becoming.carriedWithin cs part σ k present δ j t c = Becoming.carried cs part σ k present δ t c ↔
    ¬Becoming.ConveyedThrough cs part σ k present δ (j + 1) t c
@Becoming.ConveyedThrough.coupledIntoBy : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {k : Nat → F → C → Nat → C → Nat} {present : Nat → List F} {δ : C → Nat} {j t : Nat} {c : C},
  Becoming.ConveyedThrough cs part σ k present δ j t c → Becoming.CoupledIntoBy cs part k present j t c
@Becoming.conveyed_ones : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {k : Nat → F → C → Nat → C → Nat} {present : Nat → List F} (t : Nat) (c : C),
