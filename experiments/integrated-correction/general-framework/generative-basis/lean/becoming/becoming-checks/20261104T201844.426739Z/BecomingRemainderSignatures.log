@Becoming.Remainder.mul_pos_nat : ∀ {a b : Nat}, 0 < a → 0 < b → 0 < a * b
Becoming.Remainder.add_left_cancel_nat : ∀ (a : Nat) {b c : Nat}, a + b = a + c → b = c
Becoming.Remainder.le_of_add_le_add_left_nat : ∀ (a : Nat) {b c : Nat}, a + b ≤ a + c → b ≤ c
@Becoming.responded_zero : ∀ {F C : Type} {cs : List C} {part : F → Bool} {k : Nat → F → C → Nat → C → Nat}
  {present : Nat → List F} (l : Nat → C → Nat) (c : C), Becoming.responded cs part k present l 0 c = 0
@Becoming.responded_succ : ∀ {F C : Type} {cs : List C} {part : F → Bool} {k : Nat → F → C → Nat → C → Nat}
  {present : Nat → List F} (l : Nat → C → Nat) (t : Nat) (c : C),
  Becoming.responded cs part k present l (t + 1) c =
    Becoming.responded cs part k present l t c +
      Becoming.total (present t) fun h => Becoming.carriedGive cs part (fun x x_1 x_2 => 0) k t h c l
@Becoming.carriedGive_add : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {k : Nat → F → C → Nat → C → Nat} (t : Nat) (h : F) (c : C) (l m : Nat → C → Nat),
  (Becoming.carriedGive cs part σ k t h c fun s d => l s d + m s d) =
    Becoming.carriedGive cs part σ k t h c l + Becoming.carriedGive cs part (fun x x_1 x_2 => 0) k t h c m
@Becoming.carriedFrom_add : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {k : Nat → F → C → Nat → C → Nat} {present : Nat → List F} {δ : C → Nat} (l m : Nat → C → Nat) (t : Nat) (c : C),
  Becoming.carriedFrom cs part σ k present δ (fun s d => l s d + m s d) t c =
    Becoming.carriedFrom cs part σ k present δ l t c + Becoming.responded cs part k present m t c
@Becoming.carried_eq_orderBelow_add : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {k : Nat → F → C → Nat → C → Nat} {present : Nat → List F} {δ : C → Nat} (j t : Nat) (c : C),
  Becoming.carried cs part σ k present δ t c =
    Becoming.orderBelow cs part σ k present δ j t c +
      Becoming.responses cs part k present (Becoming.carried cs part σ k present δ) j t c
@Becoming.carried_eq_carriedWithin_add : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {k : Nat → F → C → Nat → C → Nat} {present : Nat → List F} {δ : C → Nat} (j t : Nat) (c : C),
  Becoming.carried cs part σ k present δ t c =
    Becoming.carriedWithin cs part σ k present δ j t c +
      Becoming.responses cs part k present (Becoming.carried cs part σ k present δ) (j + 1) t c
@Becoming.responses_antitone : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {k : Nat → F → C → Nat → C → Nat} {present : Nat → List F} {δ : C → Nat} {j j' : Nat},
  j ≤ j' →
    ∀ (t : Nat) (c : C),
      Becoming.responses cs part k present (Becoming.carried cs part σ k present δ) j' t c ≤
        Becoming.responses cs part k present (Becoming.carried cs part σ k present δ) j t c
@Becoming.responses_le_missBound : ∀ {F C : Type} {cs : List C} {part : F → Bool} {k : Nat → F → C → Nat → C → Nat}
  {present : Nat → List F} {δ : C → Nat} {M D : Nat},
  (∀ (c : C), δ c ≤ D) →
    (∀ (t : Nat) (c : C), Becoming.inflow cs part k present t c ≤ M) →
      ∀ (j t : Nat) (c : C),
        Becoming.responses cs part k present (Becoming.carried cs part (fun x x_1 x_2 => 0) k present δ) (j + 1) t c ≤
          Becoming.Loops.missBound M D j t
@Becoming.carriedWorld_within_cut : ∀ {F C : Type} {cs : List C} {part : F → Bool} {k : Nat → F → C → Nat → C → Nat}
  {present : Nat → List F} {δ : C → Nat} {M D : Nat},
  (∀ (c : C), δ c ≤ D) →
    (∀ (t : Nat) (c : C), Becoming.inflow cs part k present t c ≤ M) →
      ∀ (j t : Nat) (c : C),
        (Becoming.carriedWorld cs part (fun x x_1 x_2 => 0) k present δ).web.level t (Sum.inr c) ≤
          Becoming.carriedWithin cs part (fun x x_1 x_2 => 0) k present δ j t c + Becoming.Loops.missBound M D j t
Becoming.Loops.SelfLoop.responses_eq : ∀ (M D j t : Nat),
  Becoming.responses [()] (fun x => false) (Becoming.Loops.SelfLoop.strengths M) (fun x => [()])
      (Becoming.carried [()] (fun x => false) (fun x x_1 x_2 => 0) (Becoming.Loops.SelfLoop.strengths M) (fun x => [()])
        fun x => D)
      (j + 1) t () =
    Becoming.Loops.missBound M D j t
@Becoming.couples_iff_couplesAt : ∀ {F C : Type} {cs : List C} {part : F → Bool} {k : Nat → F → C → Nat → C → Nat}
  {present : Nat → List F} {d c : C},
  Becoming.Couples cs part k present d c ↔ ∃ u s, Becoming.CouplesAt cs part k present u s d c
@Becoming.responded_pos_iff : ∀ {F C : Type} {cs : List C} {part : F → Bool} {k : Nat → F → C → Nat → C → Nat}
  {present : Nat → List F} (l : Nat → C → Nat) (t : Nat) (c : C),
