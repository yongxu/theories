    ∃ u s d, u < t ∧ Becoming.CouplesAt cs part k present u s d c ∧ 0 < l s d
@Becoming.responses_pos_iff : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {k : Nat → F → C → Nat → C → Nat} {present : Nat → List F} {δ : C → Nat} (j t : Nat) (c : C),
  0 < Becoming.responses cs part k present (Becoming.carried cs part σ k present δ) j t c ↔
    Becoming.ConveyedThrough cs part σ k present δ j t c
@Becoming.orderBelow_lt_iff : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
