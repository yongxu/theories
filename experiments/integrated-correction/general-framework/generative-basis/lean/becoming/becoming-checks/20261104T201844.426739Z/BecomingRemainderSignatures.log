@Becoming.ConveyedThrough.later : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {k : Nat → F → C → Nat → C → Nat} {present : Nat → List F} {δ : C → Nat} {j t t' : Nat} {c : C},
  Becoming.ConveyedThrough cs part σ k present δ j t c → t ≤ t' → Becoming.ConveyedThrough cs part σ k present δ j t' c
@Becoming.conveyedThrough_along : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
