@Becoming.CoupledIntoBy.conveyedThrough_ones : ∀ {F C : Type} {cs : List C} {part : F → Bool} {σ : Nat → F → C → Nat}
  {k : Nat → F → C → Nat → C → Nat} {present : Nat → List F} {j t : Nat} {c : C},
