  {present : Nat → List F} {j t : Nat} {c : C}, Becoming.CoupledIntoBy cs part k present j t c → j ≤ t
@Becoming.CoupledIntoBy.coupledInto : ∀ {F C : Type} {cs : List C} {part : F → Bool} {k : Nat → F → C → Nat → C → Nat}
  {present : Nat → List F} {j t : Nat} {c : C},
