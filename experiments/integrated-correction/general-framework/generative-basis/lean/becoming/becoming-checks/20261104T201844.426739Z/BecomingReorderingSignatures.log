  Becoming.EachStep (fun t => S ≤ t ∧ t + 2 ≤ S + M) ts →
    ∀ {k : Nat} (x : X), k ≤ S → r.web.SameAt k (r.reorder ts).web k x
@Becoming.Footprinted.converse_webs : ∀ {X : Type} {S m : Nat} {r r₂ : Becoming.Footprinted X} {π σ : Nat → Nat}
  {ts : List Nat},
  r.Contains →
    r₂.Contains →
      r.Independent ts →
        Becoming.EachStep (fun t => S ≤ t ∧ t + 2 ≤ S + m) ts →
          Becoming.Reindexes S m π σ →
            (∀ (a : Nat), S ≤ a → a < S + m → Becoming.origin ts a = σ a) →
              (∀ (i : Nat) (x : X), S ≤ i → i < S + m → r₂.touch (π i) x = r.touch i x) →
                (∀ (i : Nat) (x : X),
                    S ≤ i → i < S + m → r.touch i x = true → r.web.SameAt (i + 1) r₂.web (π i + 1) x) →
                  (∀ (x : X), r.web.SameAt S r₂.web S x) →
                    ∀ (e : Nat), e ≤ m → ∀ (x : X), (r.reorder ts).web.SameAt (S + e) r₂.web (S + e) x
@Becoming.Footprinted.converse : ∀ {X : Type} {S m : Nat} {r r₂ : Becoming.Footprinted X} {π σ : Nat → Nat},
  r.Contains →
    r₂.Contains →
      Becoming.Reindexes S m π σ →
        r.Keeps S m π →
          (∀ (i : Nat), S ≤ i → i < S + m → r.flow.SameExchange i r₂.flow (π i)) →
            (∀ (i : Nat) (x : X), S ≤ i → i < S + m → r₂.touch (π i) x = r.touch i x) →
              (∀ (i : Nat) (x : X), S ≤ i → i < S + m → r.touch i x = true → r.web.SameAt (i + 1) r₂.web (π i + 1) x) →
                (∀ (x : X), r.web.SameAt S r₂.web S x) →
                  ∃ ts,
                    Becoming.EachStep (fun t => S ≤ t ∧ t + 2 ≤ S + m) ts ∧
                      r.Independent ts ∧
                        (∀ (i : Nat), S ≤ i → i < S + m → Becoming.place ts i = π i) ∧
                          (∀ (a : Nat), S ≤ a → a < S + m → (r.reorder ts).flow.SameExchange a r₂.flow a) ∧
                            ∀ (k : Nat) (x : X), S ≤ k → k ≤ S + m → (r.reorder ts).web.SameAt k r₂.web k x
@Becoming.Footprinted.Joined.mono : ∀ {X : Type} {r : Becoming.Footprinted X} {touch : Nat → X → Bool},
  (∀ (n : Nat) (x : X), r.touch n x = true → touch n x = true) →
    ∀ {i j : Nat}, r.Joined i j → { flow := r.flow, web := r.web, touch := touch }.Joined i j
@Becoming.Footprinted.Precedes.mono : ∀ {X : Type} {r : Becoming.Footprinted X} {touch : Nat → X → Bool},
  (∀ (n : Nat) (x : X), r.touch n x = true → touch n x = true) →
    ∀ {i j : Nat}, r.Precedes i j → { flow := r.flow, web := r.web, touch := touch }.Precedes i j
@Becoming.Footprinted.Contains.mono : ∀ {X : Type} {r : Becoming.Footprinted X} {touch : Nat → X → Bool},
  r.Contains →
    (∀ (n : Nat) (x : X), r.touch n x = true → touch n x = true) →
      { flow := r.flow, web := r.web, touch := touch }.Contains
@Becoming.Footprinted.contains_everything : ∀ {X : Type} (L : Becoming.Flow X X) (W : Becoming.Web X X),
  { flow := L, web := W, touch := fun x x_1 => true }.Contains
