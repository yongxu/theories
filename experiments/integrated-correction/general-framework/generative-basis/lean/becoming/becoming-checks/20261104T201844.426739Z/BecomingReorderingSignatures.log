  [inst : (n : Nat) → (x : X) → Decidable (W.active n x)] [inst_1 : (n : Nat) → (x : X) → Decidable (W'.active n x)],
  Becoming.Reorders (fun t => S ≤ t ∧ t + 2 ≤ S + m) L W L' W' →
    Becoming.total (Becoming.steps S m) (Becoming.comings xs fun x n => W'.active n x) =
