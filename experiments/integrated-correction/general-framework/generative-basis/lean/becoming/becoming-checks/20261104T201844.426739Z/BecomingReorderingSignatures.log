            ∃ ts,
              Becoming.EachStep (fun t => S ≤ t ∧ t + 2 ≤ S + (m + 1)) ts ∧
                r.Independent ts ∧ ∀ (i : Nat), S ≤ i → i < S + (m + 1) → Becoming.place ts i = π i
