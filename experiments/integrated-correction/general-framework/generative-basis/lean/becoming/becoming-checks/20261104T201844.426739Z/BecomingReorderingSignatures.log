  W.Split t sideF sideC → W.Commuted (W.commute t sideF sideC) t
@Becoming.Web.commute_dependent : ∀ {F C : Type} {W : Becoming.Web F C} {t : Nat} {sideF : F → Bool} {sideC : C → Bool},
  W.Dependent →
    (∀ (f : F) (c : C), W.requires t f c ∨ W.requires (t + 2) f c → sideF f = sideC c) →
      (W.commute t sideF sideC).Dependent
@Becoming.World.commute_laws : ∀ {w : Becoming.World} {t : Nat} {side : w.Relatum → Bool},
  w.web.Split t side side →
    ((w.commute t side).Balanced ↔ w.Balanced) ∧
      ((w.commute t side).Dissipative ↔ w.Dissipative) ∧
        ((w.commute t side).Embodied ↔ w.Embodied) ∧
          (w.Dependent →
              (∀ (f c : w.Relatum), w.web.requires t f c ∨ w.web.requires (t + 2) f c → side f = side c) →
                (w.commute t side).Dependent) ∧
            (w.Acting →
              (∀ (f c : w.Relatum),
                  f ∈ w.flow.present (t + 1) →
                    0 < w.flow.give (t + 1) f c → w.web.active (t + 1) f → w.web.active t f) →
                (∀ (f c : w.Relatum),
                    f ∈ w.flow.present t → 0 < w.flow.give t f c → w.web.active (t + 1) f → w.web.active (t + 2) f) →
                  (w.commute t side).Acting)
@Becoming.World.commute_counts : ∀ {w : Becoming.World} {t : Nat} {side : w.Relatum → Bool},
  w.web.Split t side side →
    ∀ [inst : (n : Nat) → (x : w.Relatum) → Decidable (w.web.active n x)]
      [inst_1 : (n : Nat) → (x : (w.commute t side).Relatum) → Decidable ((w.commute t side).web.active n x)]
      (xs cs : List w.Relatum) {S m : Nat},
      S ≤ t →
        t + 2 ≤ S + m →
          Becoming.total (Becoming.steps S m) (Becoming.comings xs fun x n => (w.commute t side).web.active n x) =
              Becoming.total (Becoming.steps S m) (Becoming.comings xs fun x n => w.web.active n x) ∧
            Becoming.total (Becoming.steps S m) (Becoming.ceasings xs fun x n => (w.commute t side).web.active n x) =
                Becoming.total (Becoming.steps S m) (Becoming.ceasings xs fun x n => w.web.active n x) ∧
              Becoming.total (Becoming.steps S m) (Becoming.rise ((w.commute t side).web.stock cs)) =
                  Becoming.total (Becoming.steps S m) (Becoming.rise (w.web.stock cs)) ∧
                Becoming.total (Becoming.steps S m) (Becoming.fall ((w.commute t side).web.stock cs)) =
                    Becoming.total (Becoming.steps S m) (Becoming.fall (w.web.stock cs)) ∧
                  Becoming.count (Becoming.steps S m) (Becoming.fall ((w.commute t side).web.stock cs)) =
                    Becoming.count (Becoming.steps S m) (Becoming.fall (w.web.stock cs))
@Becoming.Reorders.laws : ∀ {X : Type} {within : Nat → Prop} {L L' : Becoming.Flow X X} {W W' : Becoming.Web X X},
  Becoming.Reorders within L W L' W' →
    ((Becoming.World.of X L' W').Balanced ↔ (Becoming.World.of X L W).Balanced) ∧
      ((Becoming.World.of X L' W').Dissipative ↔ (Becoming.World.of X L W).Dissipative) ∧
        ((Becoming.World.of X L' W').Embodied ↔ (Becoming.World.of X L W).Embodied)
@Becoming.Reorders.totals : ∀ {X : Type} {S m : Nat} {L L' : Becoming.Flow X X} {W W' : Becoming.Web X X} (cs : List X),
  Becoming.Reorders (fun t => S ≤ t ∧ t + 2 ≤ S + m) L W L' W' →
    Becoming.total (Becoming.steps S m) (Becoming.rise (W'.stock cs)) =
        Becoming.total (Becoming.steps S m) (Becoming.rise (W.stock cs)) ∧
      Becoming.total (Becoming.steps S m) (Becoming.fall (W'.stock cs)) =
          Becoming.total (Becoming.steps S m) (Becoming.fall (W.stock cs)) ∧
        Becoming.count (Becoming.steps S m) (Becoming.fall (W'.stock cs)) =
          Becoming.count (Becoming.steps S m) (Becoming.fall (W.stock cs))
