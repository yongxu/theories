@Becoming.Flow.exchange_not_recurring_of_least_loss : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {r : Nat → Nat},
  L.BalancesAt r W →
    L.Dissipative →
      ∀ {R : Nat → Nat} {p m : Nat},
