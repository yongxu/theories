@Becoming.Trickle.taken_total : ∀ {es : List Becoming.Trickle.Relatum} {t : Nat},
  Becoming.Trickle.flow.ClosedAt es t →
    ∀ (f : Becoming.Trickle.Relatum), 4 * (Becoming.halving t + 1) ≤ Becoming.total es (Becoming.Trickle.flow.take t f)
Becoming.Trickle.part_loss : ∀ (h : Nat), 2 * (2 * h + 1) + 2 = 4 * (h + 1)
@Becoming.Trickle.loses_two : ∀ {es : List Becoming.Trickle.Relatum},
  Becoming.Distinct es →
    ∀ {t : Nat},
      Becoming.Trickle.flow.ClosedAt es t →
        ∀ (f : Becoming.Trickle.Relatum),
          Becoming.total es (Becoming.Trickle.flow.give t f) + 2 ≤ Becoming.total es (Becoming.Trickle.flow.take t f)
Becoming.Trickle.dissipative : Becoming.Trickle.flow.Dissipative
Becoming.Trickle.double : ∀ (h : Nat), h + h = 2 * h
@Becoming.Trickle.large_early : ∀ {t p : Nat},
  Becoming.quarter (t + 1) ≤ p * (4 * (Becoming.halving t + 1)) → Becoming.halving t ≤ 2 * p
Becoming.Trickle.losesAtEverySize : Becoming.Flow.LosesAtEverySize Becoming.quarter
Becoming.Trickle.sides_closed : ∀ (t : Nat), Becoming.Trickle.flow.ClosedAt Becoming.Trickle.sides t
Becoming.Trickle.enclosed : ∀ (t : Nat), Becoming.Trickle.flow.Enclosed t
Becoming.Trickle.exchange_not_recurring : ∀ (p : Nat),
  ¬∀ (N : Nat),
      ∃ t f,
        N ≤ t ∧
          f ∈ Becoming.Trickle.flow.present t ∧
            Becoming.quarter (t + 1) ≤ p * Becoming.total Becoming.Trickle.sides (Becoming.Trickle.flow.take t f)
Becoming.Trickle.arising_whole : ∀ (N : Nat),
  ∃ t c, N ≤ t ∧ Becoming.Trickle.web.Arises t c ∧ Becoming.quarter (t + 1) ≤ 1 * Becoming.Trickle.web.level (t + 1) c
Becoming.Trickle.not_dissipativeBy : ∀ (q : Nat), ¬Becoming.Flow.DissipativeBy q
Becoming.Trickle.uptake : ∀ (t : Nat),
  Becoming.Trickle.flow.uptake Becoming.Trickle.sides t = 4 * (Becoming.quarter t + Becoming.halving t)
Becoming.Trickle.throughput_unbounded : ∀ (B : Nat),
  ∃ n,
    B * Becoming.quarter n < Becoming.refinedSum (fun x => 4) (Becoming.Trickle.flow.uptake Becoming.Trickle.sides) 0 n
Becoming.arising_needs_quantum : Becoming.Emission.world.Counted ∧
  Becoming.Emission.world.Embodied ∧
    Becoming.Emission.flow.BalancesAt (fun x => 2) Becoming.Emission.web ∧
      Becoming.Emission.world.Dissipative ∧
        Becoming.Flow.DissipativeBy 1 ∧
          (∀ (t : Nat), Becoming.Emission.world.flow.Enclosed t) ∧
            Becoming.Emission.world.ArisingRecurs ∧ ¬Becoming.Emission.world.Balanced
Becoming.arising_needs_proportion : Becoming.Alternation.world.Counted ∧
  Becoming.Alternation.world.Embodied ∧
    Becoming.Alternation.flow.BalancesAt (fun x => 2) Becoming.Alternation.web ∧
      Becoming.Alternation.world.Dissipative ∧
        (∀ (t : Nat), Becoming.Alternation.world.flow.Enclosed t) ∧
          (∀ (N : Nat),
              ∃ t x,
                N ≤ t ∧
                  Becoming.Alternation.web.Arises t x ∧
                    Becoming.halving (t + 1) ≤ 1 * Becoming.Alternation.web.level (t + 1) x) ∧
            ∀ (q : Nat), ¬Becoming.Flow.DissipativeBy q
Becoming.exchange_needs_quantum : (Becoming.Circulation.web.StandingCensus fun x => [()]) ∧
  Becoming.Circulation.flow.BalancesAt (fun x => 2) Becoming.Circulation.web ∧
    Becoming.Circulation.flow.Dissipative ∧
      (∀ (t : Nat), Becoming.Circulation.flow.AroundStanding (fun x => [()]) t) ∧
        (∀ (t : Nat), Becoming.Circulation.flow.take t () () = Becoming.halving (t + 1)) ∧
          Becoming.Circulation.flow.ExchangeRecurs ∧ ∀ (q : Nat), ¬Becoming.Flow.DissipativeBy q
Becoming.rest_needs_quantum : ∀ (split : Nat → Nat),
  (∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < split t) →
    (Becoming.Asymptote.flow split).BalancesAt (Becoming.Asymptote.refinement split) (Becoming.Asymptote.web split) ∧
      (Becoming.Asymptote.flow split).Dissipative ∧
        (∀ (q : Nat), Becoming.Flow.DissipativeBy q) ∧
          (Becoming.Asymptote.web split).Dependent ∧
            (∀ (t : Nat), (Becoming.Asymptote.flow split).ClosedAt [()] t) ∧
              (∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < (Becoming.Asymptote.flow split).takers [()] t) ∧
                ¬(Becoming.Asymptote.flow split).Balances (Becoming.Asymptote.web split)
Becoming.reserve_needs_quantum : (∀ (t : Nat), ¬Becoming.Dwindle.web.Supported t ()) ∧
  Becoming.Dwindle.web.CarriesIn (fun x => 2) Becoming.Dwindle.reserve ∧
    (∀ (t : Nat), Becoming.Dwindle.web.active t ()) ∧
      ∀ (p : Nat), ¬Becoming.Dwindle.web.CarriesAt (fun x => 2) Becoming.halving p Becoming.Dwindle.reserve
Becoming.growth_needs_proportion : Becoming.Trickle.world.Counted ∧
  Becoming.Trickle.world.Embodied ∧
    Becoming.Trickle.flow.BalancesAt (fun x => 4) Becoming.Trickle.web ∧
      Becoming.Trickle.world.Dissipative ∧
        (∀ (t : Nat), Becoming.Trickle.world.flow.Enclosed t) ∧
          Becoming.Flow.LosesAtEverySize Becoming.quarter ∧
            (∀ (p : Nat),
                ¬∀ (N : Nat),
                    ∃ t f,
                      N ≤ t ∧
                        f ∈ Becoming.Trickle.flow.present t ∧
                          Becoming.quarter (t + 1) ≤
                            p * Becoming.total Becoming.Trickle.sides (Becoming.Trickle.flow.take t f)) ∧
              (∀ (N : Nat),
                  ∃ t x,
                    N ≤ t ∧
                      Becoming.Trickle.web.Arises t x ∧
                        Becoming.quarter (t + 1) ≤ 1 * Becoming.Trickle.web.level (t + 1) x) ∧
                ∀ (q : Nat), ¬Becoming.Flow.DissipativeBy q
Becoming.amount_sharp : ∀ (q s : Nat),
  (Becoming.Geometric.flow q s).BalancesAt (fun x => q + 1) (Becoming.Geometric.web q s) ∧
    Becoming.Flow.DissipativeBy q ∧
      (∀ (t : Nat), (Becoming.Geometric.flow q s).ClosedAt [()] t) ∧
        (Becoming.Geometric.web q s).stock [()] 0 = s * 1 + 0 ∧
          ∀ (m : Nat),
            ∃ n,
              m * ((q + 1) * s * Becoming.powers (q + 1) n) ≤
                m * Becoming.refinedSum (fun x => q + 1) ((Becoming.Geometric.flow q s).uptake [()]) 0 n +
                  (q + 1) * s * Becoming.powers (q + 1) n
Becoming.throughput_needs_proportion : Becoming.Trickle.flow.BalancesAt (fun x => 4) Becoming.Trickle.web ∧
  Becoming.Trickle.flow.Dissipative ∧
    (∀ (t : Nat), Becoming.Trickle.flow.ClosedAt Becoming.Trickle.sides t) ∧
      Becoming.Flow.LosesAtEverySize Becoming.quarter ∧
        ∀ (B : Nat),
          ∃ n,
            B * Becoming.quarter n <
              Becoming.refinedSum (fun x => 4) (Becoming.Trickle.flow.uptake Becoming.Trickle.sides) 0 n
Becoming.refinement_feeds_witnesses : ∀ (split : Nat → Nat),
  (∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < split t) →
    ∀ (T : Nat),
      (¬∀ (t : Nat),
            T ≤ t →
              ∀ (x : Option Nat),
                (Becoming.Emission.flow.withRefinement Becoming.Emission.web fun x => 1).give t none x = 0) ∧
        (¬∀ (t : Nat),
              T ≤ t →
                ∀ (x : Bool),
                  (Becoming.Alternation.flow.withRefinement Becoming.Alternation.web fun x => 1).give t none x = 0) ∧
          (¬∀ (t : Nat),
                T ≤ t →
                  (Becoming.Circulation.flow.withRefinement Becoming.Circulation.web fun x => 1).give t none () = 0) ∧
            (¬∀ (t : Nat),
                  T ≤ t →
                    ((Becoming.Asymptote.flow split).withRefinement (Becoming.Asymptote.web split) split).give t none
                        () =
                      0) ∧
              ¬∀ (t : Nat), T ≤ t → 1 * Becoming.Dwindle.reserve t () = 0
