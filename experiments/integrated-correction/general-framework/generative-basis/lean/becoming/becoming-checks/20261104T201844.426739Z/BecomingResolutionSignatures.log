            (∀ (t : Nat), T ≤ t → L.ClosedAt cs t) →
              (∀ (t : Nat), T ≤ t → split t * W.stock cs t = 0) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < L.takers cs t
