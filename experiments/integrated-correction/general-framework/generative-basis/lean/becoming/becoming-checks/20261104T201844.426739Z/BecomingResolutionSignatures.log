@Becoming.Flow.balancesAt_one : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.BalancesAt (fun x => 1) W ↔ L.Balances W
@Becoming.Flow.BalancesAt.over : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {r : Nat → Nat},
  L.BalancesAt r W →
    ∀ (cs : List C) (t : Nat), W.stock cs (t + 1) + L.uptake cs t = r t * W.stock cs t + L.replenishment cs t
@Becoming.Flow.BalancesAt.lowers : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {r : Nat → Nat},
  L.BalancesAt r W →
    ∀ {cs : List C} {t : Nat}, L.DissipatesOn cs t → W.stock cs (t + 1) + L.takers cs t ≤ r t * W.stock cs t
@Becoming.units_pos : ∀ {r R : Nat → Nat} {T : Nat},
  R T = 1 → (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) → (∀ (t : Nat), T ≤ t → 0 < r t) → ∀ {t : Nat}, T ≤ t → 0 < R t
@Becoming.losses_invariant : ∀ {r R s k : Nat → Nat} {q T : Nat},
  R T = 1 →
    (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) →
      (∀ (t : Nat), T ≤ t → q * s (t + 1) + k t * R (t + 1) ≤ q * (r t * s t)) →
        ∀ (n : Nat), q * s (T + n) + Becoming.total (Becoming.steps T n) k * R (T + n) ≤ q * s T * R (T + n)
@Becoming.losses_bound : ∀ {r R s k : Nat → Nat} {q T : Nat},
  R T = 1 →
    (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) →
      (∀ (t : Nat), T ≤ t → 0 < r t) →
        (∀ (t : Nat), T ≤ t → q * s (t + 1) + k t * R (t + 1) ≤ q * (r t * s t)) →
          ∀ (n : Nat), Becoming.total (Becoming.steps T n) k ≤ q * s T
@Becoming.unbounded_of_recurring : ∀ {k : Nat → Nat} {T : Nat},
  (∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < k t) → ∀ (m : Nat), ∃ n, m ≤ Becoming.total (Becoming.steps T n) k
@Becoming.bounded_not_recurring : ∀ {k : Nat → Nat} {T B : Nat},
  (∀ (n : Nat), Becoming.total (Becoming.steps T n) k ≤ B) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < k t
@Becoming.quantum_step : ∀ {r R s : Nat → Nat} {q t : Nat},
  s (t + 1) ≤ r t * s t → q * s (t + 1) + Becoming.mark (Becoming.LosesQuantum r R s q t) * R (t + 1) ≤ q * (r t * s t)
@Becoming.quantum_bound : ∀ {r R s : Nat → Nat} {q T : Nat},
  R T = 1 →
    (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) →
      (∀ (t : Nat), T ≤ t → 0 < r t) →
        (∀ (t : Nat), T ≤ t → s (t + 1) ≤ r t * s t) →
          ∀ (n : Nat),
            (Becoming.total (Becoming.steps T n) fun u => Becoming.mark (Becoming.LosesQuantum r R s q u)) ≤ q * s T
@Becoming.quantum_not_recurring : ∀ {r R s : Nat → Nat} {q T : Nat},
  R T = 1 →
    (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) →
      (∀ (t : Nat), T ≤ t → 0 < r t) →
        (∀ (t : Nat), T ≤ t → s (t + 1) ≤ r t * s t) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ Becoming.LosesQuantum r R s q t
@Becoming.refinedSum_invariant : ∀ {r R s ℓ : Nat → Nat} {c T : Nat},
  R T = 1 →
    (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) →
      (∀ (t : Nat), T ≤ t → c * s (t + 1) + ℓ t ≤ c * (r t * s t)) →
        ∀ (n : Nat), c * s (T + n) + Becoming.refinedSum r ℓ T n ≤ c * s T * R (T + n)
@Becoming.refinedSum_mono : ∀ {r a b : Nat → Nat} {T : Nat},
  (∀ (t : Nat), T ≤ t → a t ≤ b t) → ∀ (n : Nat), Becoming.refinedSum r a T n ≤ Becoming.refinedSum r b T n
Becoming.refinedSum_mul : ∀ (r ℓ : Nat → Nat) (p T n : Nat),
  Becoming.refinedSum r (fun t => p * ℓ t) T n = p * Becoming.refinedSum r ℓ T n
@Becoming.refinedSum_marks : ∀ {r R k : Nat → Nat} {T : Nat},
  (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) →
    ∀ (n : Nat),
      Becoming.refinedSum r (fun t => k t * R (t + 1)) T n = Becoming.total (Becoming.steps T n) k * R (T + n)
@Becoming.counts_of_amounts : ∀ {r R k ℓ : Nat → Nat} {p B T : Nat},
  R T = 1 →
    (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) →
      (∀ (t : Nat), T ≤ t → 0 < r t) →
        (∀ (t : Nat), T ≤ t → k t * R (t + 1) ≤ p * ℓ t) →
          (∀ (n : Nat), Becoming.refinedSum r ℓ T n ≤ B * R (T + n)) →
            ∀ (n : Nat), Becoming.total (Becoming.steps T n) k ≤ p * B
@Becoming.Flow.quantum_bound : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {r R : Nat → Nat},
  L.BalancesAt r W →
    L.Dissipative →
      ∀ {cs : List C},
        Becoming.Distinct cs →
          ∀ {T : Nat},
            (∀ (t : Nat), T ≤ t → L.ClosedAt cs t) →
              R T = 1 →
                (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) →
                  (∀ (t : Nat), T ≤ t → 0 < r t) →
                    ∀ (q n : Nat),
                      (Becoming.total (Becoming.steps T n) fun u =>
                          Becoming.mark (Becoming.LosesQuantum r R (W.stock cs) q u)) ≤
                        q * W.stock cs T
@Becoming.Flow.quantum_not_recurring : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {r R : Nat → Nat},
  L.BalancesAt r W →
    L.Dissipative →
      ∀ {cs : List C},
        Becoming.Distinct cs →
          ∀ {T : Nat},
            (∀ (t : Nat), T ≤ t → L.ClosedAt cs t) →
              R T = 1 →
                (∀ (t : Nat), T ≤ t → R (t + 1) = r t * R t) →
                  (∀ (t : Nat), T ≤ t → 0 < r t) →
                    ∀ (q : Nat), ¬∀ (N : Nat), ∃ t, N ≤ t ∧ Becoming.LosesQuantum r R (W.stock cs) q t
@Becoming.Flow.takes_loses : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {r : Nat → Nat},
  L.BalancesAt r W →
    ∀ {cs : List C} {t : Nat},
      L.DissipatesOn cs t → 0 < L.takers cs t → Becoming.LosesQuantum r (fun x => 1) (W.stock cs) 1 t
@Becoming.Flow.taking_not_recurring : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {r : Nat → Nat},
  L.BalancesAt r W →
    L.Dissipative →
      ∀ {cs : List C},
        Becoming.Distinct cs →
          ∀ {T : Nat},
            (∀ (t : Nat), T ≤ t → L.ClosedAt cs t) →
              (∀ (t : Nat), T ≤ t → r t = 1) → ¬∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < L.takers cs t
@Becoming.total_map_some : ∀ {α : Type} (q : Option α → Nat) (l : List α),
  Becoming.total (List.map some l) q = Becoming.total l fun a => q (some a)
@Becoming.mem_map_some : ∀ {α : Type} {a : α} {l : List α}, a ∈ l → some a ∈ List.map some l
@Becoming.of_mem_map_some : ∀ {α : Type} {l : List α} {f : Option α}, f ∈ List.map some l → ∃ a, a ∈ l ∧ some a = f
Becoming.refine_eq : ∀ (s l g : Nat), (s + 1) * l + g = l + (s * l + g)
@Becoming.Flow.withRefinement_taken : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} (split : Nat → Nat)
  (t : Nat) (c : C), (L.withRefinement W split).taken t c = L.taken t c
@Becoming.Flow.withRefinement_given : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} (split : Nat → Nat)
  (t : Nat) (c : C), (L.withRefinement W split).given t c = split t * W.level t c + L.given t c
@Becoming.Flow.balancesAt_iff_withRefinement : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {split : Nat → Nat}, L.BalancesAt (fun t => split t + 1) W ↔ (L.withRefinement W split).Balances W.withRefinement
@Becoming.Flow.withRefinement_dissipatesOn_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {split : Nat → Nat} {cs : List C} {t : Nat},
  (L.withRefinement W split).DissipatesOn cs t ↔ L.DissipatesOn cs t ∧ split t * W.stock cs t = 0
@Becoming.Flow.ClosedAt.of_withRefinement : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {split : Nat → Nat} {cs : List C} {t : Nat}, (L.withRefinement W split).ClosedAt cs t → L.ClosedAt cs t
