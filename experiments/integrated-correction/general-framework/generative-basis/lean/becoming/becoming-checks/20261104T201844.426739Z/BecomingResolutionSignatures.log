  {split : Nat → Nat} {cs : List C} {t : Nat},
  L.ClosedAt cs t → (∀ (c : C), split t * W.level t c = 0) → (L.withRefinement W split).ClosedAt cs t
@Becoming.Flow.Enclosed.of_withRefinement : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {split : Nat → Nat} {t : Nat}, (L.withRefinement W split).Enclosed t → L.Enclosed t
