Becoming.RuleRebuilding.sum_keep_le : ∀ (n : Nat) (xs : List Nat),
  Becoming.RuleRebuilding.sumL (Becoming.RuleRebuilding.keep n xs) ≤ Becoming.RuleRebuilding.sumL xs
@Becoming.RuleRebuilding.length_keep_le : ∀ {α : Type} (n : Nat) (xs : List α),
