Becoming.RuleRebuilding.succ_ne_zero' : ∀ (n : Nat), n + 1 ≠ 0
@Becoming.RuleRebuilding.sub_pos' : ∀ {a b : Nat}, a < b → 0 < b - a
@Becoming.RuleRebuilding.exists_div : ∀ {d : Nat}, 1 ≤ d → ∀ (L : Nat), ∃ r k, L = r + k * d ∧ r < d
Becoming.RuleRebuilding.sumL_replicate : ∀ (n a : Nat), Becoming.RuleRebuilding.sumL (List.replicate n a) = n * a
@Becoming.RuleRebuilding.length_replicate' : ∀ {α : Type} (n : Nat) (a : α), (List.replicate n a).length = n
@Becoming.RuleRebuilding.keep_cons_replicate : ∀ {α : Type} (n : Nat) (a : α),
  Becoming.RuleRebuilding.keep n (a :: List.replicate n a) = List.replicate n a
Becoming.RuleRebuilding.after_replicate : ∀ (l s q : Nat),
  Becoming.RuleRebuilding.after l (List.replicate s q) = (s - l) * q
Becoming.RuleRebuilding.after_le_sum : ∀ (l : Nat) (xs : List Nat),
  Becoming.RuleRebuilding.after l xs ≤ Becoming.RuleRebuilding.sumL xs
@Becoming.RuleRebuilding.after_zero_of_sum : ∀ {l : Nat} {xs : List Nat},
  Becoming.RuleRebuilding.sumL xs = 0 → Becoming.RuleRebuilding.after l xs = 0
@Becoming.RuleRebuilding.after_short : ∀ {l : Nat} {xs : List Nat},
