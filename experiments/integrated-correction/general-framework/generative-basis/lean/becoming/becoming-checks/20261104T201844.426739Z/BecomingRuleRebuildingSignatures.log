Becoming.RuleRebuilding.le_add_sub : ∀ (a : Nat) {g t : Nat}, t ≤ g → a ≤ a + g - t
@Becoming.RuleRebuilding.le_of_add_le_add_right' : ∀ {a b : Nat} (c : Nat), a + c ≤ b + c → a ≤ b
Becoming.RuleRebuilding.mul_assoc' : ∀ (a b c : Nat), a * b * c = a * (b * c)
Becoming.RuleRebuilding.right_distrib' : ∀ (a b c : Nat), (a + b) * c = a * c + b * c
Becoming.RuleRebuilding.sub_le_sub_left' : ∀ (a : Nat) {b c : Nat}, b ≤ c → a - c ≤ a - b
@Becoming.RuleRebuilding.sub_eq_zero_of_le' : ∀ {a b : Nat}, a ≤ b → a - b = 0
