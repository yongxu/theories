@Becoming.RuleShaping.grouped_returns : ∀ {α : Type} {gs : List (List α)} {w shapes : α → Nat} {a s q c : Nat}
  {pos : 0 < a},
  Becoming.RuleShaping.Grouped gs w shapes a s q c pos →
    ∀ (g : List α), g ∈ gs → ∀ (x : α), x ∈ g → w x + c * shapes x = a + c + s * shapes x + q * Becoming.total g shapes
@Becoming.RuleShaping.grouped_rises_iff : ∀ {α : Type} {gs : List (List α)} {w shapes : α → Nat} {a s q c m : Nat}
  {pos : 0 < a},
  (∀ (g : List α), g ∈ gs → g.length = m) →
    Becoming.RuleShaping.Grouped gs w shapes a s q c pos →
      (Becoming.SelectionTerm.discord (Becoming.SelectionLevels.whole gs) w shapes <
          Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) w shapes ↔
        c * Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) shapes shapes <
          s * Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) shapes shapes +
            m * q * Becoming.SelectionLevels.concordAmong gs shapes shapes)
@Becoming.RuleShaping.grouped_rises_iff_sized : ∀ {α : Type} {gs : List (List α)} {w shapes : α → Nat} {a s q c n : Nat}
  {pos : 0 < a} (f : List α → Nat),
  (∀ (g : List α), g ∈ gs → g.length * f g = n) →
    0 < n →
      Becoming.RuleShaping.Grouped gs w shapes a s q c pos →
        (Becoming.SelectionTerm.discord (Becoming.SelectionLevels.whole gs) w shapes <
            Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) w shapes ↔
          (c * (n * Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) shapes shapes) +
              q *
                Becoming.SelectionTerm.discord (Becoming.SelectionLevels.context gs) (fun g => Becoming.total g shapes)
                  fun g => f g * Becoming.total g shapes) <
            s * (n * Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) shapes shapes) +
              q *
                Becoming.SelectionTerm.concord (Becoming.SelectionLevels.context gs) (fun g => Becoming.total g shapes)
                  fun g => f g * Becoming.total g shapes)
@Becoming.RuleShaping.grouped_alike_iff : ∀ {α : Type} {gs : List (List α)} {w shapes : α → Nat} {a s q c m d : Nat}
  {pos : 0 < a},
  (∀ (g : List α), g ∈ gs → g.length = m) →
    Becoming.RuleShaping.Grouped gs w shapes a s q c pos →
      (∀ (g : List α), g ∈ gs → Becoming.total g shapes = d) →
        0 < Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) shapes shapes →
          (Becoming.SelectionTerm.discord (Becoming.SelectionLevels.whole gs) w shapes <
              Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) w shapes ↔
            c < s)
@Becoming.RuleShaping.grouped_kept_rises : ∀ {α : Type} {gs : List (List α)} {w shapes : α → Nat} {a s q c m : Nat}
  {pos : 0 < a},
  (∀ (g : List α), g ∈ gs → g.length = m) →
    Becoming.RuleShaping.Grouped gs w shapes a s q c pos →
      c < s →
        0 < Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) shapes shapes →
          Becoming.SelectionTerm.discord (Becoming.SelectionLevels.whole gs) w shapes <
            Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) w shapes
@Becoming.RuleShaping.grouped_uniform_iff : ∀ {α : Type} {gs : List (List α)} {w shapes : α → Nat} {a s q c m : Nat}
  {pos : 0 < a},
  (∀ (g : List α), g ∈ gs → g.length = m) →
    Becoming.RuleShaping.Grouped gs w shapes a s q c pos →
      (∀ (g : List α), g ∈ gs → ∃ v, ∀ (x : α), x ∈ g → shapes x = v) →
        0 < Becoming.SelectionLevels.concordAmong gs shapes shapes →
          (Becoming.SelectionTerm.discord (Becoming.SelectionLevels.whole gs) w shapes <
              Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) w shapes ↔
            c < s + m * q)
