@Becoming.RuleShaping.eq_of_counts : ∀ {x y : Becoming.RuleCapture.CarrierCounts},
  x.carrier = y.carrier → x.other = y.other → x = y
@Becoming.RuleShaping.favours_iff : ∀ {a s p c : Nat} {pos : 0 < a},
  (Becoming.RuleShaping.shaped a s p c pos).favours ↔ c ≤ s
@Becoming.RuleShaping.disfavours_iff : ∀ {a s p c : Nat} {pos : 0 < a},
  (Becoming.RuleShaping.shaped a s p c pos).disfavours ↔ s ≤ c
@Becoming.RuleShaping.favours_alike : ∀ {a s p p' c : Nat} {pos : 0 < a},
  (Becoming.RuleShaping.shaped a s p c pos).favours ↔ (Becoming.RuleShaping.shaped a s p' c pos).favours
@Becoming.RuleShaping.shared_lowers : ∀ {a s p p' c : Nat} {pos : 0 < a},
  c ≤ s →
    p ≤ p' →
      Becoming.RuleCapture.CarrierCounts.order.le (Becoming.RuleShaping.shaped a s p' c pos)
        (Becoming.RuleShaping.shaped a s p c pos)
@Becoming.RuleShaping.shared_lowers_strictly : ∀ {a s p p' c : Nat} {pos : 0 < a},
  c < s →
    p < p' →
      (Becoming.RuleShaping.shaped a s p' c pos).carrier * (Becoming.RuleShaping.shaped a s p c pos).other <
        (Becoming.RuleShaping.shaped a s p c pos).carrier * (Becoming.RuleShaping.shaped a s p' c pos).other
@Becoming.RuleShaping.shared_raises : ∀ {a s p p' c : Nat} {pos : 0 < a},
  s ≤ c →
    p ≤ p' →
      Becoming.RuleCapture.CarrierCounts.order.le (Becoming.RuleShaping.shaped a s p c pos)
        (Becoming.RuleShaping.shaped a s p' c pos)
@Becoming.RuleShaping.lower_c_raises : ∀ {a s p c c' : Nat} {pos : 0 < a},
  c' ≤ c →
    Becoming.RuleCapture.CarrierCounts.order.le (Becoming.RuleShaping.shaped a s p c pos)
      (Becoming.RuleShaping.shaped a s p c' pos)
@Becoming.RuleShaping.lower_c_raises_strictly : ∀ {a s p c c' : Nat} {pos : 0 < a},
  c' < c →
    (Becoming.RuleShaping.shaped a s p c pos).carrier * (Becoming.RuleShaping.shaped a s p c' pos).other <
      (Becoming.RuleShaping.shaped a s p c' pos).carrier * (Becoming.RuleShaping.shaped a s p c pos).other
@Becoming.RuleShaping.shaped_shift : ∀ {a s p c : Nat} {pos : 0 < a},
  Becoming.RuleShaping.shaped a s p c pos = Becoming.RuleShaping.shaped (a + p) s 0 c ⋯
@Becoming.RuleShaping.falls_strictly : ∀ {x g : Becoming.RuleCapture.CarrierCounts},
  0 < x.carrier → g.carrier < g.other → (x.select g).carrier * x.other < x.carrier * (x.select g).other
@Becoming.RuleShaping.present_along : ∀ {g : Becoming.RuleCapture.CarrierCounts},
  0 < g.carrier →
    ∀ {x : Becoming.RuleCapture.CarrierCounts},
      0 < x.carrier → ∀ (n : Nat), 0 < (Becoming.Law.orbit (fun y => y.select g) x n).carrier
@Becoming.RuleShaping.present_of_le : ∀ {x y : Becoming.RuleCapture.CarrierCounts},
  Becoming.RuleCapture.CarrierCounts.order.le x y → 0 < x.carrier → 0 < y.carrier
@Becoming.RuleShaping.nothing_back_falls : ∀ {a p c : Nat} {pos : 0 < a},
  0 < c →
    ∀ {x : Becoming.RuleCapture.CarrierCounts},
      0 < x.carrier →
        ∀ (n : Nat),
          (Becoming.Law.orbit (fun y => y.select (Becoming.RuleShaping.shaped a 0 p c pos)) x (n + 1)).carrier *
              (Becoming.Law.orbit (fun y => y.select (Becoming.RuleShaping.shaped a 0 p c pos)) x n).other <
            (Becoming.Law.orbit (fun y => y.select (Becoming.RuleShaping.shaped a 0 p c pos)) x n).carrier *
              (Becoming.Law.orbit (fun y => y.select (Becoming.RuleShaping.shaped a 0 p c pos)) x (n + 1)).other
@Becoming.RuleShaping.c_zero_favours : ∀ {a s p : Nat} {pos : 0 < a}, (Becoming.RuleShaping.shaped a s p 0 pos).favours
@Becoming.RuleShaping.neutral_steady : ∀ {a p : Nat} {pos : 0 < a} (x : Becoming.RuleCapture.CarrierCounts),
  Becoming.RuleCapture.CarrierCounts.order.le x (x.select (Becoming.RuleShaping.shaped a 0 p 0 pos)) ∧
    Becoming.RuleCapture.CarrierCounts.order.le (x.select (Becoming.RuleShaping.shaped a 0 p 0 pos)) x
Becoming.RuleShaping.select_thenBy : ∀ (x g g' : Becoming.RuleCapture.CarrierCounts),
  (x.select g).select g' = x.select (Becoming.RuleShaping.thenBy g g')
@Becoming.RuleShaping.pow_pos_of_pos : ∀ {b : Nat}, 0 < b → ∀ (n : Nat), 0 < b ^ n
Becoming.RuleShaping.orbit_held : ∀ (g x : Becoming.RuleCapture.CarrierCounts) (n : Nat),
  Becoming.Law.orbit (fun y => y.select g) x n = x.select (Becoming.RuleShaping.held g n)
@Becoming.RuleShaping.le_select_iff : ∀ {x g : Becoming.RuleCapture.CarrierCounts},
  0 < x.carrier → (Becoming.RuleCapture.CarrierCounts.order.le x (x.select g) ↔ g.favours)
@Becoming.RuleShaping.lt_select_iff : ∀ {x g : Becoming.RuleCapture.CarrierCounts},
  0 < x.carrier → (x.carrier * (x.select g).other < (x.select g).carrier * x.other ↔ g.other < g.carrier)
@Becoming.RuleShaping.stretch_eq : ∀ {a s p c : Nat} {pos : 0 < a} (x : Becoming.RuleCapture.CarrierCounts) (m n : Nat),
  Becoming.Law.orbit (fun y => y.select (Becoming.RuleShaping.shaped a s p c pos))
      (Becoming.Law.orbit (fun y => y.select (Becoming.RuleShaping.shaped a 0 p c pos)) x m) n =
    x.select
      (Becoming.RuleShaping.thenBy (Becoming.RuleShaping.held (Becoming.RuleShaping.shaped a 0 p c pos) m)
        (Becoming.RuleShaping.held (Becoming.RuleShaping.shaped a s p c pos) n))
@Becoming.RuleShaping.stretch_iff : ∀ {a s p c : Nat} {pos : 0 < a} {x : Becoming.RuleCapture.CarrierCounts},
  0 < x.carrier →
    ∀ (m n : Nat),
      Becoming.RuleCapture.CarrierCounts.order.le x
          (Becoming.Law.orbit (fun y => y.select (Becoming.RuleShaping.shaped a s p c pos))
            (Becoming.Law.orbit (fun y => y.select (Becoming.RuleShaping.shaped a 0 p c pos)) x m) n) ↔
        (a + c + p) ^ m * (a + c + p) ^ n ≤ (a + p) ^ m * (a + s + p) ^ n
@Becoming.RuleShaping.stretch_lt_iff : ∀ {a s p c : Nat} {pos : 0 < a} {x : Becoming.RuleCapture.CarrierCounts},
  0 < x.carrier →
    ∀ (m n : Nat),
      x.carrier *
            (Becoming.Law.orbit (fun y => y.select (Becoming.RuleShaping.shaped a s p c pos))
                (Becoming.Law.orbit (fun y => y.select (Becoming.RuleShaping.shaped a 0 p c pos)) x m) n).other <
          (Becoming.Law.orbit (fun y => y.select (Becoming.RuleShaping.shaped a s p c pos))
                (Becoming.Law.orbit (fun y => y.select (Becoming.RuleShaping.shaped a 0 p c pos)) x m) n).carrier *
            x.other ↔
        (a + c + p) ^ m * (a + c + p) ^ n < (a + p) ^ m * (a + s + p) ^ n
@Becoming.RuleShaping.wait_not_more : ∀ {a s p c m n : Nat},
  0 < a →
    (a + c + p) ^ (m + 1) * (a + c + p) ^ n ≤ (a + p) ^ (m + 1) * (a + s + p) ^ n →
      (a + c + p) ^ m * (a + c + p) ^ n ≤ (a + p) ^ m * (a + s + p) ^ n
@Becoming.RuleShaping.back_longer_not_less : ∀ {a s p c m n : Nat},
  c ≤ s →
    (a + c + p) ^ m * (a + c + p) ^ n ≤ (a + p) ^ m * (a + s + p) ^ n →
      (a + c + p) ^ m * (a + c + p) ^ (n + 1) ≤ (a + p) ^ m * (a + s + p) ^ (n + 1)
@Becoming.RuleShaping.byBack_reads_iff : ∀ {a p c : Nat} {pos : 0 < a} {σ : Becoming.RuleCapture.CarrierCounts → Nat},
  Becoming.RuleCapture.ReadsShare Becoming.RuleCapture.CarrierCounts.order Becoming.RuleCapture.CarrierCounts.order
      (Becoming.RuleShaping.byBack a p c pos σ) ↔
    ∀ (x y : Becoming.RuleCapture.CarrierCounts), Becoming.RuleCapture.CarrierCounts.order.le x y → σ x ≤ σ y
@Becoming.RuleShaping.covering_locks : ∀ {a p c : Nat} {pos : 0 < a} {σ : Becoming.RuleCapture.CarrierCounts → Nat},
  (∀ (x y : Becoming.RuleCapture.CarrierCounts), Becoming.RuleCapture.CarrierCounts.order.le x y → σ x ≤ σ y) →
    (∀ (x : Becoming.RuleCapture.CarrierCounts), c ≤ σ x) →
      ∀ {reads : Nat → Bool} {x : Becoming.RuleCapture.CarrierCounts} {s : Nat},
        c ≤ s →
          (∀ (t : Nat),
              Becoming.RuleCapture.CarrierCounts.order.le
                (Becoming.Pace.paced Becoming.RuleCapture.CarrierCounts.select (Becoming.RuleShaping.byBack a p c pos σ)
                    reads (x, Becoming.RuleShaping.shaped a s p c pos) t).fst
                (Becoming.Pace.paced Becoming.RuleCapture.CarrierCounts.select (Becoming.RuleShaping.byBack a p c pos σ)
                    reads (x, Becoming.RuleShaping.shaped a s p c pos) (t + 1)).fst) ∧
            ∀ (r : Nat),
              reads r = true →
                Becoming.RuleCapture.Locked Becoming.RuleCapture.CarrierCounts.order
                  Becoming.RuleCapture.CarrierCounts.favours (Becoming.RuleShaping.byBack a p c pos σ)
                  (Becoming.Pace.paced Becoming.RuleCapture.CarrierCounts.select
                    (Becoming.RuleShaping.byBack a p c pos σ) reads (x, Becoming.RuleShaping.shaped a s p c pos)
                    (r + 1))
@Becoming.RuleShaping.thresholdBack_above : ∀ {hi lo : Nat} {x : Becoming.RuleCapture.CarrierCounts},
  x.favours → Becoming.RuleShaping.thresholdBack hi lo x = hi
@Becoming.RuleShaping.thresholdBack_below : ∀ {hi lo : Nat} {x : Becoming.RuleCapture.CarrierCounts},
  ¬x.favours → Becoming.RuleShaping.thresholdBack hi lo x = lo
