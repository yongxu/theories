@Becoming.UnreadStandings.le_scaled : ∀ {k : Nat}, 0 < k → ∀ (a b : Nat), k * a ≤ k * b ↔ a ≤ b
@Becoming.UnreadStandings.lt_scaled : ∀ {k : Nat}, 0 < k → ∀ (a b : Nat), k * a < k * b ↔ a < b
@Becoming.UnreadStandings.sum_eq_scaled : ∀ {k : Nat},
