@Becoming.World.standing_not_read : ∀ {Ψ : (R : Type) → Becoming.World.ModelRelations R → Nat × R → Nat},
  (∀ (R : Type) (a b : Becoming.World.ModelRelations R), a.Agree b → ∀ (x : Nat × R), Ψ R a x = Ψ R b x) →
    ∀ (w : Becoming.World) {k : Nat},
      0 < k →
        k ≠ 1 →
          ∀ (x : Nat × w.Relatum),
            0 < w.web.level x.fst x.snd →
              ¬(Ψ w.Relatum w.modelRelations x = w.web.level x.fst x.snd ∧
                  Ψ w.Relatum (Becoming.World.atFinerUnit k w).modelRelations x =
                    (Becoming.World.atFinerUnit k w).web.level x.fst x.snd)
Becoming.World.standingAt_eq_stillAt : ∀ (k : Nat),
  Becoming.World.standingAt k = Becoming.World.stillAt Unit fun x x_1 => k
@Becoming.World.stillAt_conserves : ∀ {R : Type} (s : Nat → R → Nat) (t : Nat) (g f : R),
  (Becoming.World.stillAt R s).Conserves t g f ↔ s (t + 1) f = s t g
@Becoming.World.stillAt_relabel_agree : ∀ {R : Type} (s : Nat → R → Nat) {σ : Nat → Nat},
  (∀ (a : Nat), 0 < σ a ↔ 0 < a) →
    (∀ (a b : Nat), σ a ≤ σ b ↔ a ≤ b) →
      (Becoming.World.stillAt R fun t x => σ (s t x)).modelRelations.Agree (Becoming.World.stillAt R s).modelRelations
@Becoming.World.stillAt_squared_agree : ∀ {R : Type} (s : Nat → R → Nat),
  (Becoming.World.stillAt R fun t x => s t x * s t x).modelRelations.Agree (Becoming.World.stillAt R s).modelRelations
Becoming.World.oneTwo_not_scaled : (Becoming.World.stillAt Bool fun t x =>
          Becoming.World.oneTwo t x * Becoming.World.oneTwo t x).modelRelations.Agree
    (Becoming.World.stillAt Bool Becoming.World.oneTwo).modelRelations ∧
  ¬∃ k,
      ∀ (t : Nat) (x : Bool),
        (Becoming.World.stillAt Bool fun t x => Becoming.World.oneTwo t x * Becoming.World.oneTwo t x).web.level t x =
          k * (Becoming.World.stillAt Bool Becoming.World.oneTwo).web.level t x
@Becoming.World.ratio_apart : ∀ {p q p' q' a b : Nat},
  0 < p → 0 < q' → q * 1 = p * a → q * 2 = p * b → q' * 1 = p' * a → q' * 4 = p' * b → False
Becoming.World.standing_not_read_up_to_unit : ¬∃ Ψ,
    (∀ (R : Type) (a b : Becoming.World.ModelRelations R), a.Agree b → ∀ (x : Nat × R), Ψ R a x = Ψ R b x) ∧
      ∀ (w : Becoming.World),
        ∃ p q, 0 < p ∧ 0 < q ∧ ∀ (x : Nat × w.Relatum), q * w.web.level x.fst x.snd = p * Ψ w.Relatum w.modelRelations x
