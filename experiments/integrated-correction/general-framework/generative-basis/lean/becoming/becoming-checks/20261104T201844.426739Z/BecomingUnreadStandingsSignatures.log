@Becoming.World.atFinerUnit_ends : ∀ {w : Becoming.World} {k : Nat},
  0 < k →
    ∀ (x : Nat × w.Relatum),
      Becoming.«亡» (Becoming.World.atFinerUnit k w).conservationStep (Becoming.World.atFinerUnit k w).web.activityClass
