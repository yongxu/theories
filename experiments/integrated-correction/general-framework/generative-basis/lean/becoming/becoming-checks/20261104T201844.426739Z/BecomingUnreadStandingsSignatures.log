  0 < k → (Becoming.World.atFinerUnit k w).modelRelations.Agree w.modelRelations
@Becoming.World.carried_of_same : ∀ {R : Type} {S S' : Becoming.«际» (Nat × R)},
  Becoming.«谓» S S' → Becoming.«谓» (Becoming.«像» (Becoming.World.identityOnOccurrences R).to S) S'
@Becoming.World.atFinerUnit_carried : ∀ {w : Becoming.World} {k : Nat},
  0 < k →
    have a := (Becoming.World.atFinerUnit k w).modelRelations;
    have b := w.modelRelations;
    have e := (Becoming.World.identityOnOccurrences w.Relatum).to;
    Becoming.«谓» (Becoming.«像» e a.conservation) b.conservation ∧
      Becoming.«谓» (Becoming.«像» e a.active) b.active ∧
        Becoming.«谓» (Becoming.«像» e a.standing) b.standing ∧
          Becoming.«谓» (Becoming.«像» e a.present) b.present ∧
            Becoming.«谓» (Becoming.«像» e a.requires) b.requires ∧
              Becoming.«谓» (Becoming.«像» e a.draws) b.draws ∧
                Becoming.«谓» (Becoming.«像» e a.needMet) b.needMet ∧
                  Becoming.«谓» (Becoming.«像» e a.gives) b.gives ∧
                    Becoming.«谓» (Becoming.«像» e a.takes) b.takes ∧
                      Becoming.«谓» (Becoming.«像» e a.falls) b.falls ∧ Becoming.«谓» (Becoming.«像» e a.order) b.order
@Becoming.World.atFinerUnit_activityClass : ∀ {w : Becoming.World} {k : Nat},
  Becoming.«谓»
    (Becoming.«像» (Becoming.World.identityOnOccurrences w.Relatum).to
      (Becoming.World.atFinerUnit k w).web.activityClass)
    w.web.activityClass
@Becoming.World.atFinerUnit_family : ∀ {w : Becoming.World} {k : Nat},
  0 < k →
    ∀ (x y : Nat × w.Relatum),
      Becoming.«同族» (Becoming.World.atFinerUnit k w).conservationStep (Becoming.World.atFinerUnit k w).web.activityClass
          x y ↔
        Becoming.«同族» w.conservationStep w.web.activityClass x y
@Becoming.World.atFinerUnit_begins : ∀ {w : Becoming.World} {k : Nat},
