Becoming.UnreadStandings.left_comm_mul : ∀ (a b c : Nat), a * (b * c) = b * (a * c)
@Becoming.UnreadStandings.factor_of_one : ∀ {k p : Nat}, 1 = k * p → k = 1
@Becoming.World.atFinerUnit_level : ∀ {w : Becoming.World} {k : Nat} (t : Nat) (x : w.Relatum),
  (Becoming.World.atFinerUnit k w).web.level t x = k * w.web.level t x
@Becoming.World.atFinerUnit_taken : ∀ {w : Becoming.World} {k : Nat} (t : Nat) (c : w.Relatum),
  (Becoming.World.atFinerUnit k w).flow.taken t c = k * w.flow.taken t c
@Becoming.World.atFinerUnit_given : ∀ {w : Becoming.World} {k : Nat} (t : Nat) (c : w.Relatum),
  (Becoming.World.atFinerUnit k w).flow.given t c = k * w.flow.given t c
@Becoming.World.atFinerUnit_conserves : ∀ {w : Becoming.World} {k : Nat},
