Becoming.PairFlow.FailedRenewal.first_active_keeping : ∀ (n : Nat),
  Becoming.PairFlow.WhileStanding.isActive Becoming.PairFlow.FailedRenewal.parts
      (Becoming.PairFlow.WhileStanding.levels Becoming.PairFlow.FailedRenewal.parts
        Becoming.PairFlow.FailedRenewal.keeping n)
      Becoming.WindowedWaiting.Pair.first =
    true
Becoming.PairFlow.FailedRenewal.first_sharing : ∀ (n : Nat),
  Becoming.PairFlow.WhileStanding.lineAt Becoming.PairFlow.FailedRenewal.parts Becoming.PairFlow.FailedRenewal.sharing
      Becoming.WindowedWaiting.Pair.first n =
    n
Becoming.PairFlow.FailedRenewal.first_keeping : ∀ (n : Nat),
  Becoming.PairFlow.WhileStanding.lineAt Becoming.PairFlow.FailedRenewal.parts Becoming.PairFlow.FailedRenewal.keeping
      Becoming.WindowedWaiting.Pair.first n =
    n
Becoming.PairFlow.FailedRenewal.second_sharing : ∀ (m : Nat),
  Becoming.PairFlow.WhileStanding.lineAt Becoming.PairFlow.FailedRenewal.parts Becoming.PairFlow.FailedRenewal.sharing
      Becoming.WindowedWaiting.Pair.second (m + 4) =
    m + 2
Becoming.PairFlow.FailedRenewal.second_keeping : ∀ (m : Nat),
  Becoming.PairFlow.WhileStanding.lineAt Becoming.PairFlow.FailedRenewal.parts Becoming.PairFlow.FailedRenewal.keeping
      Becoming.WindowedWaiting.Pair.second (m + 2) =
    2
Becoming.PairFlow.FailedRenewal.lines_gain : ∀ (m : Nat),
  Becoming.PairFlow.WhileStanding.lineAt Becoming.PairFlow.FailedRenewal.parts Becoming.PairFlow.FailedRenewal.sharing
        Becoming.WindowedWaiting.Pair.first (m + 4) +
