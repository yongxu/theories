@Becoming.HeldForReading.forall_pair : ∀ {β : Type} {P : β → Prop} {a b : β}, P a → P b → ∀ (x : β), x ∈ [a, b] → P x
@Becoming.HeldForReading.bestOf_best : ∀ {C A : Type} (value : C → A → Nat) (c : C) (a : A) (bs : List A),
  Becoming.HeldForReading.BestAt (a :: bs) value (fun c' => Becoming.HeldForReading.bestOf value c' a bs) c
@Becoming.HeldForReading.after_le_after : ∀ {C A : Type} {m : Becoming.HeldForReading.Model C} {acts : List A}
  {value : C → A → Nat} {p : C → A},
  (∀ (c : C), c ∈ m.listed → Becoming.HeldForReading.BestAt acts value p c) →
    ∀ {q : C → A}, (∀ (c : C), c ∈ m.listed → q c ∈ acts) → m.after value q ≤ m.after value p
@Becoming.HeldForReading.after_add_gap : ∀ {C A : Type} {m : Becoming.HeldForReading.Model C} {acts : List A}
  {value : C → A → Nat} {p : C → A},
  (∀ (c : C), c ∈ m.listed → Becoming.HeldForReading.BestAt acts value p c) →
    ∀ {q : C → A},
      (∀ (c : C), c ∈ m.listed → q c ∈ acts) →
        (m.after value q + Becoming.total m.listed fun c => m.weight c * (value c (p c) - value c (q c))) =
          m.after value p
@Becoming.HeldForReading.after_lt_after_iff : ∀ {C A : Type} {m : Becoming.HeldForReading.Model C} {acts : List A}
  {value : C → A → Nat} {p : C → A},
  (∀ (c : C), c ∈ m.listed → Becoming.HeldForReading.BestAt acts value p c) →
    ∀ {q : C → A},
      (∀ (c : C), c ∈ m.listed → q c ∈ acts) →
        (m.after value q < m.after value p ↔ ∃ c, c ∈ m.listed ∧ 0 < m.weight c ∧ value c (q c) < value c (p c))
@Becoming.HeldForReading.after_eq_after_iff : ∀ {C A : Type} {m : Becoming.HeldForReading.Model C} {acts : List A}
  {value : C → A → Nat} {p : C → A},
  (∀ (c : C), c ∈ m.listed → Becoming.HeldForReading.BestAt acts value p c) →
    ∀ {q : C → A},
      (∀ (c : C), c ∈ m.listed → q c ∈ acts) →
        (m.after value q = m.after value p ↔ ∀ (c : C), c ∈ m.listed → 0 < m.weight c → value c (q c) = value c (p c))
@Becoming.HeldForReading.committed_le_after : ∀ {C A : Type} {m : Becoming.HeldForReading.Model C} {acts : List A}
  {value : C → A → Nat} {p : C → A},
  (∀ (c : C), c ∈ m.listed → Becoming.HeldForReading.BestAt acts value p c) →
    ∀ {a : A}, a ∈ acts → m.committed value a ≤ m.after value p
@Becoming.HeldForReading.committed_eq_after_iff : ∀ {C A : Type} {m : Becoming.HeldForReading.Model C} {acts : List A}
  {value : C → A → Nat} {p : C → A},
  (∀ (c : C), c ∈ m.listed → Becoming.HeldForReading.BestAt acts value p c) →
    ∀ {a : A},
      a ∈ acts →
        (m.committed value a = m.after value p ↔ ∀ (c : C), c ∈ m.listed → 0 < m.weight c → value c a = value c (p c))
@Becoming.HeldForReading.reading_gains_iff : ∀ {C A : Type} {m : Becoming.HeldForReading.Model C} {acts : List A}
  {value : C → A → Nat} {p : C → A},
  (∀ (c : C), c ∈ m.listed → Becoming.HeldForReading.BestAt acts value p c) →
    ((∀ (a : A), a ∈ acts → m.committed value a < m.after value p) ↔
      ¬∃ a, a ∈ acts ∧ ∀ (c : C), c ∈ m.listed → 0 < m.weight c → value c a = value c (p c))
@Becoming.HeldForReading.below_iff : ∀ {C A : Type} {m : Becoming.HeldForReading.Model C} {acts : List A}
  {value : C → A → Nat} {p : C → A},
  (∀ (c : C), c ∈ m.listed → Becoming.HeldForReading.BestAt acts value p c) →
    ∀ {a : A},
      a ∈ acts →
        ∀ {Q : C → Prop},
          (∀ (c : C), c ∈ m.listed → 0 < m.weight c → (value c a < value c (p c) ↔ Q c)) →
            (m.committed value a < m.after value p ↔ ∃ c, c ∈ m.listed ∧ 0 < m.weight c ∧ Q c)
@Becoming.HeldForReading.cell_policy_iff : ∀ {C A : Type} {m : Becoming.HeldForReading.Model C} {acts : List A}
  {value : C → A → Nat} {p : C → A} {K : Type},
  Becoming.Viability.ChoiceOver K A →
    (∀ (c : C), c ∈ m.listed → Becoming.HeldForReading.BestAt acts value p c) →
      ∀ (π : C → K),
        (∃ f, (∀ (k : K), f k ∈ acts) ∧ (m.after value fun c => f (π c)) = m.after value p) ↔
          ∀ (k : K), ∃ a, a ∈ acts ∧ ∀ (c : C), c ∈ m.listed → π c = k → 0 < m.weight c → value c a = value c (p c)
@Becoming.HeldForReading.after_offset : ∀ {C A : Type} {m : Becoming.HeldForReading.Model C} {v v' : C → A → Nat}
  {b : C → Nat},
  (∀ (c : C) (a : A), v' c a = v c a + b c) →
    ∀ (p₁ : C → A), m.after v' p₁ = m.after v p₁ + Becoming.total m.listed fun c => m.weight c * b c
@Becoming.HeldForReading.after_offset_le_iff : ∀ {C A : Type} {m : Becoming.HeldForReading.Model C} {v v' : C → A → Nat}
  {b : C → Nat},
  (∀ (c : C) (a : A), v' c a = v c a + b c) →
    ∀ (p₁ p₂ : C → A), m.after v' p₁ ≤ m.after v' p₂ ↔ m.after v p₁ ≤ m.after v p₂
@Becoming.HeldForReading.byRule_of_true : ∀ {C : Type} {r : C → Bool} {c : C},
  r c = true → Becoming.HeldForReading.byRule r c = Becoming.HeldForReading.Move.off
@Becoming.HeldForReading.byRule_of_false : ∀ {C : Type} {r : C → Bool} {c : C},
  r c = false → Becoming.HeldForReading.byRule r c = Becoming.HeldForReading.Move.go
@Becoming.HeldForReading.byReading_of_lt : ∀ {C : Type} {gain loss : C → Nat} {c : C},
  gain c < loss c → Becoming.HeldForReading.byReading gain loss c = Becoming.HeldForReading.Move.off
@Becoming.HeldForReading.byReading_of_not_lt : ∀ {C : Type} {gain loss : C → Nat} {c : C},
  ¬gain c < loss c → Becoming.HeldForReading.byReading gain loss c = Becoming.HeldForReading.Move.go
Becoming.HeldForReading.go_open : Becoming.HeldForReading.Move.go ∈
  [Becoming.HeldForReading.Move.go, Becoming.HeldForReading.Move.off]
Becoming.HeldForReading.off_open : Becoming.HeldForReading.Move.off ∈
  [Becoming.HeldForReading.Move.go, Becoming.HeldForReading.Move.off]
@Becoming.HeldForReading.byReading_best : ∀ {C : Type} (gain loss : C → Nat) (c : C),
  Becoming.HeldForReading.BestAt [Becoming.HeldForReading.Move.go, Becoming.HeldForReading.Move.off]
    (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byReading gain loss) c
@Becoming.HeldForReading.go_below_iff : ∀ {C : Type} (gain loss : C → Nat) (c : C),
  Becoming.HeldForReading.shifted gain loss c Becoming.HeldForReading.Move.go <
      Becoming.HeldForReading.shifted gain loss c (Becoming.HeldForReading.byReading gain loss c) ↔
    gain c < loss c
@Becoming.HeldForReading.off_below_iff : ∀ {C : Type} (gain loss : C → Nat) (c : C),
  Becoming.HeldForReading.shifted gain loss c Becoming.HeldForReading.Move.off <
      Becoming.HeldForReading.shifted gain loss c (Becoming.HeldForReading.byReading gain loss c) ↔
    loss c < gain c
@Becoming.HeldForReading.committed_le_held : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat),
  m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.go ≤
      m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byReading gain loss) ∧
    m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.off ≤
      m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byReading gain loss)
@Becoming.HeldForReading.held_gains_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat),
  m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.go <
        m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byReading gain loss) ∧
      m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.off <
        m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byReading gain loss) ↔
    (∃ c, c ∈ m.listed ∧ 0 < m.weight c ∧ gain c < loss c) ∧ ∃ c, c ∈ m.listed ∧ 0 < m.weight c ∧ loss c < gain c
Becoming.HeldForReading.cond_split : ∀ (x : Nat) (b : Bool), ((bif b then x else 0) + bif b then 0 else x) = x
@Becoming.HeldForReading.offPart_add_onPart : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (r : C → Bool)
  (f : C → Nat),
  Becoming.HeldForReading.offPart m r f + Becoming.HeldForReading.onPart m r f = Becoming.total m.listed f
@Becoming.HeldForReading.after_rule : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r : C → Bool),
  m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) =
    (Becoming.HeldForReading.offPart m r fun c => m.weight c * loss c) +
      Becoming.HeldForReading.onPart m r fun c => m.weight c * gain c
@Becoming.HeldForReading.after_rule_add_onLoss : ∀ {C : Type} (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) (r : C → Bool),
  (m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) +
      Becoming.HeldForReading.onPart m r fun c => m.weight c * loss c) =
    (Becoming.total m.listed fun c => m.weight c * loss c) +
      Becoming.HeldForReading.onPart m r fun c => m.weight c * gain c
@Becoming.HeldForReading.after_rule_le_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r r' : C → Bool),
  m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) ≤
      m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r') ↔
    ((Becoming.HeldForReading.onPart m r fun c => m.weight c * gain c) +
        Becoming.HeldForReading.onPart m r' fun c => m.weight c * loss c) ≤
      (Becoming.HeldForReading.onPart m r' fun c => m.weight c * gain c) +
        Becoming.HeldForReading.onPart m r fun c => m.weight c * loss c
@Becoming.HeldForReading.rule_not_below_go_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) (r : C → Bool),
  m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.go ≤
      m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) ↔
    (Becoming.HeldForReading.offPart m r fun c => m.weight c * gain c) ≤
      Becoming.HeldForReading.offPart m r fun c => m.weight c * loss c
@Becoming.HeldForReading.rule_not_below_off_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) (r : C → Bool),
  m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.off ≤
      m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) ↔
    (Becoming.HeldForReading.onPart m r fun c => m.weight c * loss c) ≤
      Becoming.HeldForReading.onPart m r fun c => m.weight c * gain c
@Becoming.HeldForReading.held_term : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r : C → Bool) (c : C),
  m.weight c * Becoming.HeldForReading.shifted gain loss c (Becoming.HeldForReading.byRule r c) =
    bif r c then m.weight c * loss c else m.weight c * gain c
@Becoming.HeldForReading.gainOf_goOn : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (a : Nat),
  Becoming.RevisionPlans.gainOf m.listed gain loss (Becoming.RevisionPlans.goOn m.weight a) =
    m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.go
@Becoming.HeldForReading.gainOf_off : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (a : Nat),
  Becoming.RevisionPlans.gainOf m.listed gain loss (Becoming.RevisionPlans.off m.weight a) =
    m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.off
@Becoming.HeldForReading.gainOf_held : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r : C → Bool) (a : Nat),
  Becoming.RevisionPlans.gainOf m.listed gain loss (Becoming.RevisionPlans.held m.weight r a) =
    m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r)
@Becoming.HeldForReading.excess_goOn : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (a : Nat),
  Becoming.RevisionPlans.excess m.listed gain loss (Becoming.RevisionPlans.goOn m.weight a) =
    Becoming.HeldForReading.offExcess m gain loss
@Becoming.HeldForReading.excess_off : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (a : Nat),
  Becoming.RevisionPlans.excess m.listed gain loss (Becoming.RevisionPlans.off m.weight a) =
    Becoming.HeldForReading.goExcess m gain loss
@Becoming.HeldForReading.excess_held : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r : C → Bool) (a : Nat),
  Becoming.RevisionPlans.excess m.listed gain loss (Becoming.RevisionPlans.held m.weight r a) =
    Becoming.HeldForReading.shortfall m gain loss r
@Becoming.HeldForReading.moves_not_below_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r : C → Bool) (a : Nat),
  (¬(Becoming.RevisionPlans.order m.listed gain loss).Above (Becoming.RevisionPlans.goOn m.weight 0)
          (Becoming.RevisionPlans.held m.weight r a) ↔
      m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.go + a ≤
        m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r)) ∧
    (¬(Becoming.RevisionPlans.order m.listed gain loss).Above (Becoming.RevisionPlans.off m.weight 0)
          (Becoming.RevisionPlans.held m.weight r a) ↔
      m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.off + a ≤
        m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r))
@Becoming.HeldForReading.held_above_moves_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r : C → Bool) (a : Nat),
  ((Becoming.RevisionPlans.order m.listed gain loss).Above (Becoming.RevisionPlans.held m.weight r a)
        (Becoming.RevisionPlans.goOn m.weight 0) ↔
      m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.go + a <
        m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r)) ∧
    ((Becoming.RevisionPlans.order m.listed gain loss).Above (Becoming.RevisionPlans.held m.weight r a)
        (Becoming.RevisionPlans.off m.weight 0) ↔
      m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.off + a <
        m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r))
@Becoming.HeldForReading.held_above_held_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r r' : C → Bool) (k k' : Nat),
  (Becoming.RevisionPlans.order m.listed gain loss).Above (Becoming.RevisionPlans.held m.weight r k)
      (Becoming.RevisionPlans.held m.weight r' k') ↔
    m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r') + k <
      m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) + k'
@Becoming.HeldForReading.after_add_shortfall_go : ∀ {C : Type} (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) (r : C → Bool),
  m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) +
      Becoming.HeldForReading.shortfall m gain loss r =
    m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.go +
      Becoming.HeldForReading.offExcess m gain loss
@Becoming.HeldForReading.after_add_shortfall_off : ∀ {C : Type} (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) (r : C → Bool),
  m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) +
      Becoming.HeldForReading.shortfall m gain loss r =
    m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.off +
      Becoming.HeldForReading.goExcess m gain loss
@Becoming.HeldForReading.shortfall_byReading : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat),
  (Becoming.HeldForReading.shortfall m gain loss fun c => decide (gain c < loss c)) = 0
@Becoming.HeldForReading.after_byReading : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat),
  m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byReading gain loss) =
      m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.go +
        Becoming.HeldForReading.offExcess m gain loss ∧
    m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byReading gain loss) =
      m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.off +
        Becoming.HeldForReading.goExcess m gain loss
@Becoming.HeldForReading.held_eq_go_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat),
  m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byReading gain loss) =
      m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.go ↔
    Becoming.HeldForReading.offExcess m gain loss = 0
@Becoming.HeldForReading.held_eq_off_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat),
  m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byReading gain loss) =
      m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.off ↔
    Becoming.HeldForReading.goExcess m gain loss = 0
@Becoming.HeldForReading.after_add_shortfall : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r : C → Bool),
  m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) +
      Becoming.HeldForReading.shortfall m gain loss r =
    m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byReading gain loss)
@Becoming.HeldForReading.across_le_iff : ∀ {G H S N k : Nat}, H + S = G + N → (G + k ≤ H ↔ S + k ≤ N)
@Becoming.HeldForReading.across_lt_iff : ∀ {G H S N k : Nat}, H + S = G + N → (G + k < H ↔ S + k < N)
@Becoming.HeldForReading.threshold_go_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r : C → Bool) (forgone : Nat),
  (m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.go + forgone ≤
        m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) ↔
      Becoming.HeldForReading.shortfall m gain loss r + forgone ≤ Becoming.HeldForReading.offExcess m gain loss) ∧
    (m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.go + forgone <
        m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) ↔
      Becoming.HeldForReading.shortfall m gain loss r + forgone < Becoming.HeldForReading.offExcess m gain loss)
@Becoming.HeldForReading.threshold_off_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r : C → Bool) (forgone : Nat),
  (m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.off + forgone ≤
        m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) ↔
      Becoming.HeldForReading.shortfall m gain loss r + forgone ≤ Becoming.HeldForReading.goExcess m gain loss) ∧
    (m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.off + forgone <
        m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) ↔
      Becoming.HeldForReading.shortfall m gain loss r + forgone < Becoming.HeldForReading.goExcess m gain loss)
@Becoming.HeldForReading.forgone_within_excess_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) (forgone : Nat),
  (m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.go + forgone ≤
        m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byReading gain loss) ↔
      forgone ≤ Becoming.HeldForReading.offExcess m gain loss) ∧
    (m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.off + forgone ≤
        m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byReading gain loss) ↔
      forgone ≤ Becoming.HeldForReading.goExcess m gain loss)
@Becoming.HeldForReading.forgone_below_excess_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) (forgone : Nat),
  (m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.go + forgone <
        m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byReading gain loss) ↔
      forgone < Becoming.HeldForReading.offExcess m gain loss) ∧
    (m.committed (Becoming.HeldForReading.shifted gain loss) Becoming.HeldForReading.Move.off + forgone <
        m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byReading gain loss) ↔
      forgone < Becoming.HeldForReading.goExcess m gain loss)
@Becoming.HeldForReading.excess_pos_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat),
  (0 < Becoming.HeldForReading.offExcess m gain loss ↔ ∃ c, c ∈ m.listed ∧ 0 < m.weight c ∧ gain c < loss c) ∧
    (0 < Becoming.HeldForReading.goExcess m gain loss ↔ ∃ c, c ∈ m.listed ∧ 0 < m.weight c ∧ loss c < gain c)
