@Becoming.Trace.determined_end : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A},
  Becoming.Determined P →
    ∀ {s t r : S} {plan : List A}, Generative.Trace P s plan t → Generative.Trace P s plan r → t = r
@Becoming.Assurance.ofMap_determined : ∀ {S : Type u_1} {A : Type u_2} (f : S → A → S),
  Becoming.Determined (Becoming.Assurance.ofMap f)
@Becoming.Assurance.ofPartial_determined : ∀ {S : Type u_1} {A : Type u_2} (f : S → A → Option S),
  Becoming.Determined (Becoming.Assurance.ofPartial f)
@Becoming.Assurance.trace_ofPartial_iff : ∀ {S : Type u_1} {A : Type u_2} (f : S → A → Option S) {s t : S}
  {plan : List A},
  Generative.Trace (Becoming.Assurance.ofPartial f) s plan t ↔ Becoming.Assurance.runPartial f s plan = some t
@Becoming.determined_iff_fixed : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A},
  Becoming.Determined P ↔ ∀ (a : A), Becoming.«定后» fun s t => P.step s a t
@Becoming.goAlikeUnder_iff_alike : ∀ {S : Type u_1} {A : Type u_2} {K : Type u_3} {P : Generative.Process S A}
  {π : S → K} {E : K → K → Prop},
  Becoming.GoAlikeUnder P π E ↔ ∀ (a : A), Becoming.«同行» (fun s t => P.step s a t) fun s s' => E (π s) (π s')
