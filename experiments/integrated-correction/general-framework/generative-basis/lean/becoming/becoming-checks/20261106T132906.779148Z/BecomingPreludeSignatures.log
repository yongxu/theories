  (∀ (N : Nat), ∃ t, N ≤ t ∧ r t) → ∀ (N : Nat), ∃ m, N ≤ m ∧ r (T + m)
@Becoming.recurs_unshift : ∀ {r : Nat → Prop} (T : Nat),
  (∀ (N : Nat), ∃ m, N ≤ m ∧ r (T + m)) → ∀ (N : Nat), ∃ t, N ≤ t ∧ r t
@Becoming.gaining_of_losing_from : ∀ {q x y : Nat → Nat} {T : Nat},
  (∀ (t : Nat), T ≤ t → q (t + 1) + x t ≤ q t + y t) →
    (∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < x t) → ∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < y t
@Becoming.losing_of_gaining_from : ∀ {q x y : Nat → Nat} {T B : Nat},
  (∀ (t : Nat), T ≤ t → q t + y t ≤ q (t + 1) + x t) →
    (∀ (t : Nat), T ≤ t → q t ≤ B) → (∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < y t) → ∀ (N : Nat), ∃ t, N ≤ t ∧ 0 < x t
@Becoming.RouteTraces.nonzero_of_le : ∀ {a b : Nat}, a ≤ b → Becoming.nonzero a = true → Becoming.nonzero b = true
@Becoming.mem_downFrom : ∀ {k K : Nat}, k ≤ K → k ∈ Becoming.downFrom K
@Becoming.le_of_mem_downFrom : ∀ {K k : Nat}, k ∈ Becoming.downFrom K → k ≤ K
@Becoming.Undecided.mem_upto : ∀ {n i : Nat}, i < n → i ∈ Becoming.Undecided.upto n
