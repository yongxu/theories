    none
Becoming.RevisionRoutes.Example.twoRoutes_complying_above : Becoming.RevisionRoutes.Example.twoRoutes.Above (some false)
  none
Becoming.RevisionRoutes.Example.both_at_loss_ten : (Becoming.RevisionRoutes.Example.twoRoutes.withLosses fun x =>
      10).Maximal
  none
Becoming.RevisionRoutes.Example.restored_every : ∀ (v : Nat) (c : Bool → Nat),
