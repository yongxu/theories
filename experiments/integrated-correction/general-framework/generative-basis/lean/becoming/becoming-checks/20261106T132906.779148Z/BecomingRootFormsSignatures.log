    Becoming.RootForms.noneRelated
Becoming.RootForms.descent_forms_no_dependence.needs_inherits : ¬∀ {X : Type} {comes before after : X → Prop}
    {descends : Becoming.«际» X},
    Becoming.RootForms.GivenTo comes descends →
      Becoming.RootForms.UndependedFrom descends before → ¬∃ x, comes x ∧ after x
Becoming.RootForms.descent_forms_no_dependence.inherits_needed : ¬Becoming.RootForms.Inherits
    Becoming.RootForms.allRelated Becoming.RootForms.nowhere Becoming.RootForms.everywhere
Becoming.RootForms.descent_forms_no_dependence.needs_undepended : ¬∀ {X : Type} {comes before after : X → Prop}
    {descends : Becoming.«际» X},
    Becoming.RootForms.GivenTo comes descends →
      Becoming.RootForms.Inherits descends before after → ¬∃ x, comes x ∧ after x
Becoming.RootForms.descent_forms_no_dependence.undepended_needed : ¬Becoming.RootForms.UndependedFrom
    Becoming.RootForms.allRelated Becoming.RootForms.everywhere
@Becoming.RootForms.no_new_dependence_at_model : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X} {t : Nat}
  {x c : X},
  W.level (t + 1) x + L.taken t x = W.level t x + L.given t x →
    (∀ (g : X), L.DescendsAt W t x g → W.InheritsAt t x g c) →
      (∀ (g : X), g ∈ L.present t → ¬W.requires t g c) → W.ComesToStand t x → ¬W.requires (t + 1) x c
Becoming.RootForms.no_new_dependence_certified : @Becoming.Flow.no_new_dependence =
  @Becoming.RootForms.no_new_dependence_at_model
@Becoming.RootForms.length_zero_of_none : ∀ {X : Type} {ks : List X}, (∀ (k : X), ¬k ∈ ks) → ks.length = 0
@Becoming.RootForms.outside_leaves_no_offspring : ∀ {X : Type} {region : X → Prop} {gives : Becoming.«际» X}
  {ps : List X} {kids : X → List X},
  Becoming.RootForms.GivesFrom region gives →
    Becoming.RootForms.ListedWithin ps kids gives →
      Becoming.RootForms.Outside region ps → (List.flatMap kids ps).length = 0
Becoming.RootForms.gives_from_everywhere : Becoming.RootForms.GivesFrom Becoming.RootForms.everywhere
  Becoming.RootForms.allRelated
Becoming.RootForms.gives_from_vacuous : Becoming.RootForms.GivesFrom Becoming.RootForms.nowhere
  Becoming.RootForms.noneRelated
Becoming.RootForms.listed_within_all : Becoming.RootForms.ListedWithin Becoming.RootForms.oneListed
  Becoming.RootForms.oneOffspring Becoming.RootForms.allRelated
Becoming.RootForms.outside_nowhere : Becoming.RootForms.Outside Becoming.RootForms.nowhere Becoming.RootForms.oneListed
Becoming.RootForms.one_offspring : ¬(List.flatMap Becoming.RootForms.oneOffspring Becoming.RootForms.oneListed).length =
    0
