@Becoming.RootForms.descent_forms_no_dependence : ∀ {X : Type} {comes before after : X → Prop}
  {descends : Becoming.«际» X},
  Becoming.RootForms.GivenTo comes descends →
    Becoming.RootForms.Inherits descends before after →
      Becoming.RootForms.UndependedFrom descends before → ¬∃ x, comes x ∧ after x
Becoming.RootForms.given_everywhere : Becoming.RootForms.GivenTo Becoming.RootForms.everywhere
  Becoming.RootForms.allRelated
Becoming.RootForms.inherits_vacuous : Becoming.RootForms.Inherits Becoming.RootForms.noneRelated
  Becoming.RootForms.nowhere Becoming.RootForms.everywhere
Becoming.RootForms.inherits_everywhere : Becoming.RootForms.Inherits Becoming.RootForms.allRelated
  Becoming.RootForms.everywhere Becoming.RootForms.everywhere
Becoming.RootForms.undepended_vacuous : Becoming.RootForms.UndependedFrom Becoming.RootForms.noneRelated
  Becoming.RootForms.nowhere
Becoming.RootForms.undepended_nowhere : Becoming.RootForms.UndependedFrom Becoming.RootForms.allRelated
  Becoming.RootForms.nowhere
Becoming.RootForms.some_depends : ∃ x, Becoming.RootForms.everywhere x ∧ Becoming.RootForms.everywhere x
Becoming.RootForms.descent_forms_no_dependence.needs_given : ¬∀ {X : Type} {comes before after : X → Prop}
    {descends : Becoming.«际» X},
