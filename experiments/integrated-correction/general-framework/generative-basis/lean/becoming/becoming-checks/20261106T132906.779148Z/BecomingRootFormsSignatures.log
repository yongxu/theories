@Becoming.RootForms.all_end_at_model : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X},
  L.Acting W →
    ∀ {G : Becoming.SelectionTerm.Generations X},
      Becoming.SelectionTerm.Flow.Descended L W G →
        ∀ {t : Nat}, (∀ (p : X), p ∈ G.family t → ¬W.active t p) → G.size (t + 1) = 0
Becoming.RootForms.all_end_certified : @Becoming.GroupEnding.Flow.all_end = @Becoming.RootForms.all_end_at_model
