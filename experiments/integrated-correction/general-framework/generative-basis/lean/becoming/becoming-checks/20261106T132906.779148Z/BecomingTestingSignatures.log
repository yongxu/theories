    (Becoming.Gauged.web 1).Dependent ∧
      (Becoming.Gauged.web 2).Dependent ∧
        (∀ (t : Nat), (Becoming.Gauged.web 1).Supported t () ∧ (Becoming.Gauged.web 2).Supported t ()) ∧
          (Becoming.Gauged.web 2).level 0 () = (Becoming.Gauged.web 1).level 0 () + 1 ∧
            (Becoming.Gauged.web 2).level 1 () ≠ (Becoming.Gauged.web 1).level 1 () + 1 ∧
              ¬(Becoming.Gauged.web 1).AlikeThrough Becoming.Gauged.stock () (Becoming.Gauged.web 1).level
                    (Becoming.Gauged.web 2).level 0 ∧
                (Becoming.Gauged.flow 1).ExchangeFollows (Becoming.Gauged.web 1) (Becoming.Gauged.flow 2)
                    (Becoming.Gauged.web 2) Becoming.Gauged.stock () ∧
                  ¬(Becoming.Gauged.flow 1).ExchangeFollows (Becoming.Gauged.web 1) (Becoming.Gauged.flow 2)
                      (Becoming.Gauged.web 2) Becoming.thresholdOnly ()
