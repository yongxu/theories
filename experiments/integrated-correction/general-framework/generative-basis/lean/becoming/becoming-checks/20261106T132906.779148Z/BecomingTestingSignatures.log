Becoming.SupportDrawn.higher_balances : (Becoming.SupportDrawn.flow Becoming.SupportDrawn.higherDraw).Balances
  (Becoming.SupportDrawn.web Becoming.SupportDrawn.higherLevel)
Becoming.SupportDrawn.dependent : ∀ (level : Nat → Nat), (Becoming.SupportDrawn.web level).Dependent
Becoming.SupportDrawn.follows : (Becoming.SupportDrawn.flow Becoming.SupportDrawn.lowerDraw).ExchangeFollows
  (Becoming.SupportDrawn.web Becoming.SupportDrawn.lowerLevel)
  (Becoming.SupportDrawn.flow Becoming.SupportDrawn.higherDraw)
  (Becoming.SupportDrawn.web Becoming.SupportDrawn.higherLevel) Becoming.thresholdOnly ()
Becoming.SupportDrawn.difference_waits : (Becoming.SupportDrawn.flow Becoming.SupportDrawn.lowerDraw).Balances
    (Becoming.SupportDrawn.web Becoming.SupportDrawn.lowerLevel) ∧
  (Becoming.SupportDrawn.flow Becoming.SupportDrawn.higherDraw).Balances
      (Becoming.SupportDrawn.web Becoming.SupportDrawn.higherLevel) ∧
    (Becoming.SupportDrawn.web Becoming.SupportDrawn.lowerLevel).Dependent ∧
      (Becoming.SupportDrawn.web Becoming.SupportDrawn.higherLevel).Dependent ∧
        (Becoming.SupportDrawn.flow Becoming.SupportDrawn.lowerDraw).ExchangeFollows
            (Becoming.SupportDrawn.web Becoming.SupportDrawn.lowerLevel)
            (Becoming.SupportDrawn.flow Becoming.SupportDrawn.higherDraw)
            (Becoming.SupportDrawn.web Becoming.SupportDrawn.higherLevel) Becoming.thresholdOnly () ∧
          (∀ (t : Nat),
              t ≤ 2 →
                (Becoming.SupportDrawn.web Becoming.SupportDrawn.higherLevel).level t () =
                  (Becoming.SupportDrawn.web Becoming.SupportDrawn.lowerLevel).level t () + 1) ∧
            ¬(Becoming.SupportDrawn.web Becoming.SupportDrawn.lowerLevel).Supported 2 () ∧
              (Becoming.SupportDrawn.web Becoming.SupportDrawn.higherLevel).Supported 2 () ∧
                (Becoming.SupportDrawn.web Becoming.SupportDrawn.higherLevel).level 3 () ≠
                  (Becoming.SupportDrawn.web Becoming.SupportDrawn.lowerLevel).level 3 () + 1
Becoming.JointFailure.balances_two : (Becoming.JointFailure.flow Becoming.JointFailure.draw).Balances
  (Becoming.JointFailure.web 2)
Becoming.JointFailure.balances_three : (Becoming.JointFailure.flow Becoming.JointFailure.draw).Balances
  (Becoming.JointFailure.web 3)
Becoming.JointFailure.difference_kept : (Becoming.JointFailure.flow Becoming.JointFailure.draw).Balances
    (Becoming.JointFailure.web 2) ∧
  (Becoming.JointFailure.flow Becoming.JointFailure.draw).Balances (Becoming.JointFailure.web 3) ∧
    (Becoming.JointFailure.flow Becoming.JointFailure.draw).ExchangeFollows (Becoming.JointFailure.web 2)
        (Becoming.JointFailure.flow Becoming.JointFailure.draw) (Becoming.JointFailure.web 3) Becoming.thresholdOnly
        () ∧
      ¬(Becoming.JointFailure.web 2).Supported 1 () ∧
        ¬(Becoming.JointFailure.web 3).Supported 1 () ∧
          ∀ (t : Nat), (Becoming.JointFailure.web 3).level t true = (Becoming.JointFailure.web 2).level t true + 1
Becoming.Attracting.lower_balances : Becoming.Attracting.lowerFlow.Balances
  (Becoming.Attracting.web Becoming.Attracting.lowerLevel)
Becoming.Attracting.higher_balances : Becoming.Attracting.higherFlow.Balances
  (Becoming.Attracting.web Becoming.Attracting.higherLevel)
Becoming.Attracting.dependent_web : ∀ (level : Nat → Nat), (Becoming.Attracting.web level).Dependent
Becoming.Attracting.higher_breaks_first : Becoming.Attracting.lowerFlow.Balances
    (Becoming.Attracting.web Becoming.Attracting.lowerLevel) ∧
  Becoming.Attracting.higherFlow.Balances (Becoming.Attracting.web Becoming.Attracting.higherLevel) ∧
    (Becoming.Attracting.web Becoming.Attracting.lowerLevel).Dependent ∧
      (Becoming.Attracting.web Becoming.Attracting.higherLevel).Dependent ∧
        (Becoming.Attracting.web Becoming.Attracting.higherLevel).level 0 () =
            (Becoming.Attracting.web Becoming.Attracting.lowerLevel).level 0 () + 1 ∧
          (Becoming.Attracting.web Becoming.Attracting.lowerLevel).AlikeThrough Becoming.thresholdOnly
              Becoming.Attracting.Formation.dependent (Becoming.Attracting.web Becoming.Attracting.lowerLevel).level
              (Becoming.Attracting.web Becoming.Attracting.higherLevel).level 0 ∧
            (Becoming.Attracting.web Becoming.Attracting.lowerLevel).Supported 1
                Becoming.Attracting.Formation.dependent ∧
              ¬(Becoming.Attracting.web Becoming.Attracting.higherLevel).Supported 1
                    Becoming.Attracting.Formation.dependent ∧
                ¬(Becoming.Attracting.web Becoming.Attracting.lowerLevel).AlikeThrough Becoming.thresholdOnly
                      Becoming.Attracting.Formation.dependent
                      (Becoming.Attracting.web Becoming.Attracting.lowerLevel).level
                      (Becoming.Attracting.web Becoming.Attracting.higherLevel).level 1 ∧
                  ¬Becoming.Attracting.lowerFlow.ExchangeFollows
                      (Becoming.Attracting.web Becoming.Attracting.lowerLevel) Becoming.Attracting.higherFlow
                      (Becoming.Attracting.web Becoming.Attracting.higherLevel) Becoming.thresholdOnly
                      Becoming.Attracting.Formation.dependent
Becoming.Prey.balances : Becoming.Prey.flow.Balances Becoming.Prey.web
Becoming.Prey.dependent : Becoming.Prey.web.Dependent
Becoming.Prey.withheld : Becoming.Prey.flow.WithheldLevels Becoming.Prey.predatorPart Becoming.Prey.web
  Becoming.Prey.spared
Becoming.Prey.preyAlone_closed : Becoming.ClosedUnder (Becoming.Prey.flow.AffectedBy Becoming.Prey.web) fun x =>
  x = Becoming.Prey.Relatum.prey
Becoming.Prey.couples_taking : ¬Becoming.Prey.flow.WithinInfluence Becoming.Prey.web Becoming.Prey.Relatum.prey
      Becoming.Prey.Relatum.predator ∧
  Becoming.Prey.flow.WithinCoupling Becoming.Prey.web Becoming.ownStanding Becoming.Prey.Relatum.prey
      Becoming.Prey.Relatum.predator ∧
    (∀ (t : Nat),
        Becoming.Prey.web.AlikeThrough Becoming.thresholdOnly Becoming.Prey.Relatum.prey Becoming.Prey.web.level
          Becoming.Prey.spared t) ∧
      ¬Becoming.Prey.web.AlikeThrough Becoming.ownStanding Becoming.Prey.Relatum.prey Becoming.Prey.web.level
          Becoming.Prey.spared 1
Becoming.Prey.omits : (∀ (t : Nat),
    Becoming.Prey.web.Supported t Becoming.Prey.Relatum.prey ∧
      Becoming.Prey.web.active t Becoming.Prey.Relatum.prey ∧
        Becoming.Prey.web.Admits (Becoming.Prey.spared t) t Becoming.Prey.Relatum.prey) ∧
  ¬Becoming.Prey.web.SelfBearing Becoming.Prey.Relatum.prey ∧ ¬Becoming.Prey.web.Embodied Becoming.Prey.Relatum.predator
Becoming.SelfPrey.balances_one : (Becoming.SelfPrey.flow 1).Balances (Becoming.SelfPrey.web 1)
Becoming.SelfPrey.balances_two : (Becoming.SelfPrey.flow 2).Balances (Becoming.SelfPrey.web 2)
Becoming.SelfPrey.selfBearing : ∀ (b : Nat), (Becoming.SelfPrey.web b).SelfBearing Becoming.Prey.Relatum.prey
Becoming.SelfPrey.within_influence : ∀ (b : Nat),
  0 < b →
    (Becoming.SelfPrey.flow b).WithinInfluence (Becoming.SelfPrey.web b) Becoming.Prey.Relatum.prey
      Becoming.Prey.Relatum.predator
Becoming.SelfPrey.admits_spared : ∀ (b t : Nat),
  (Becoming.SelfPrey.web b).Admits (Becoming.Prey.spared t) t Becoming.Prey.Relatum.prey
Becoming.SelfPrey.threshold_on_oneself : (∀ (t : Nat),
    (Becoming.SelfPrey.web 1).AlikeThrough Becoming.thresholdOnly Becoming.Prey.Relatum.prey
      (Becoming.SelfPrey.web 1).level Becoming.Prey.spared t) ∧
  ¬(Becoming.SelfPrey.web 1).AlikeThrough Becoming.ownStanding Becoming.Prey.Relatum.prey
        (Becoming.SelfPrey.web 1).level Becoming.Prey.spared 1 ∧
    ¬(Becoming.SelfPrey.web 2).AlikeThrough Becoming.thresholdOnly Becoming.Prey.Relatum.prey
        (Becoming.SelfPrey.web 2).level Becoming.Prey.spared 1
Becoming.Stationary.model_error : (∃ T, Becoming.Stationary.actual T () = 0) ∧
  ¬Becoming.Stationary.still.BalancedHistory Becoming.Stationary.actual ∧
    Becoming.Stationary.web.ExcludesWithin Becoming.Stationary.still.BalancedHistory Becoming.Stationary.gauge
      (fun l' => ∃ T, l' T () = 0) () Becoming.Stationary.actual 0
Becoming.Stationary.model_excluded : Becoming.Stationary.web.ExcludesWithin Becoming.Stationary.still.BalancedHistory
  Becoming.Stationary.gauge (fun x => True) () Becoming.Stationary.actual 1
@Becoming.Clearing.couples_resource : ∀ {g : Becoming.Clearing.Formation} {c : Becoming.Clearing.Place},
  Becoming.Clearing.clearerSide g →
    Becoming.Clearing.web.CoupledInto Becoming.thresholdOnly g c → c = Becoming.Clearing.Place.resource
Becoming.Clearing.clearerSide_closed : ∀ (L : Becoming.Flow Becoming.Clearing.Formation Becoming.Clearing.Place),
  (∀ (t : Nat),
      L.take t Becoming.Clearing.Formation.dweller Becoming.Clearing.Place.resource = 0 ∧
        L.give t Becoming.Clearing.Formation.dweller Becoming.Clearing.Place.resource = 0) →
    Becoming.ClosedUnder (L.CoupledFrom Becoming.Clearing.web Becoming.thresholdOnly) Becoming.Clearing.clearerSide
Becoming.Clearing.alike_for_clearer : ∀ (t : Nat),
  Becoming.Clearing.web.AlikeThroughUpTo Becoming.thresholdOnly Becoming.Clearing.Formation.clearer
    Becoming.Clearing.web.level Becoming.Clearing.sparedWeb.level t
Becoming.Clearing.tested_by_dweller : Becoming.Clearing.DwellerEnded Becoming.Clearing.web.level ∧
  (∀ (t : Nat),
      ¬Becoming.Clearing.web.Excludes Becoming.thresholdOnly Becoming.Clearing.DwellerEnded
          Becoming.Clearing.Formation.clearer Becoming.Clearing.sparedWeb.level t) ∧
    Becoming.Clearing.web.Excludes Becoming.thresholdOnly Becoming.Clearing.DwellerEnded
      Becoming.Clearing.Formation.dweller Becoming.Clearing.sparedWeb.level 2
Becoming.Clearing.pooled : ¬Becoming.Clearing.web.Excludes Becoming.thresholdOnly Becoming.Clearing.EitherEnded
      Becoming.Clearing.Formation.clearer Becoming.Clearing.sparedWeb.level 2 ∧
  ¬Becoming.Clearing.web.Excludes Becoming.thresholdOnly Becoming.Clearing.EitherEnded
        Becoming.Clearing.Formation.dweller Becoming.Clearing.sparedWeb.level 2 ∧
    Becoming.Clearing.web.ExcludesBy Becoming.thresholdOnly Becoming.Clearing.EitherEnded
      Becoming.Clearing.clearerAndDweller Becoming.Clearing.sparedWeb.level 2
Becoming.Clearing.model_idles_coupling : Becoming.Clearing.web.ExcludesWithin Becoming.Clearing.FixedStartAndExchange
  Becoming.thresholdOnly (fun l' => Becoming.Clearing.web.Admits (l' 2) 2 Becoming.Clearing.Formation.dweller)
  Becoming.Clearing.Formation.clearer Becoming.Clearing.web.level 0
