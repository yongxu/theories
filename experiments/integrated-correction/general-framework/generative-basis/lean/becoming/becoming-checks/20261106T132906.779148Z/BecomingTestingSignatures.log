                        W.CoupledInto obs g c → L.take t h c = L'.take t h c ∧ L.give t h c = L'.give t h c) →
            ∀ (t : Nat) (g : F),
              Becoming.WithinClosure (L.CoupledFromEither W L' obs) f g → W.AlikeThrough obs g W.level W'.level t
