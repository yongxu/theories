            ∀ (t : Nat),
              (∀ (s : Nat), s < t → W.Supported s g) → ∀ (s : Nat), s < t → W.AlikeThrough obs g W.level W'.level s
@Becoming.Flow.difference_changes_after_divergence : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {L' : Becoming.Flow F C} {W' : Becoming.Web F C} {obs : F → C → Prop} {g : F},
  (∀ (t : Nat) (e : C), W.CoupledInto obs g e → L.BalancesOn W [e] t) →
    (∀ (t : Nat) (e : C), W.CoupledInto obs g e → L'.BalancesOn W' [e] t) →
      (∀ (e : C), W.CoupledInto obs g e → W.level 0 e ≤ W'.level 0 e) →
        (∀ (e : C), obs g e → W.level 0 e = W'.level 0 e) →
          L.ExchangeFollows W L' W' obs g →
            ∀ {t : Nat} {e : C},
              W.CoupledInto obs g e →
                W'.level t e + W.level 0 e ≠ W.level t e + W'.level 0 e →
                  (¬∀ (s : Nat), s < t → W.Admits (W'.level s) s g → W.Supported s g) ∧
                    (W.Dependent → ¬∀ (s : Nat), s < t → W.active s g)
@Becoming.Flow.subthreshold_alike : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {L' : Becoming.Flow F C} {W' : Becoming.Web F C} {obs : F → C → Prop} {g : F} [DecidableEq C] {c : C} {d : Nat},
  (∀ (t : Nat) (e : C), W.CoupledInto obs g e → L.BalancesOn W [e] t) →
    (∀ (t : Nat) (e : C), W.CoupledInto obs g e → L'.BalancesOn W' [e] t) →
      W.DependsOn g c →
        ¬obs g c →
          W'.level 0 c = W.level 0 c + d →
            (∀ (e : C), W.CoupledInto obs g e → e ≠ c → W.level 0 e = W'.level 0 e) →
              L.ExchangeFollows W L' W' obs g →
                ∀ (t : Nat),
                  (∀ (s : Nat), s < t → W.Supported s g) →
                    W'.level t c = W.level t c + d ∧
                      (∀ (e : C), W.CoupledInto obs g e → e ≠ c → W.level t e = W'.level t e) ∧
                        ∀ (s : Nat), s < t → W.AlikeThrough obs g W.level W'.level s
@Becoming.Flow.subthreshold_alike_always : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {L' : Becoming.Flow F C} {W' : Becoming.Web F C} {obs : F → C → Prop} {g : F} [DecidableEq C] {c : C} {d : Nat},
  (∀ (t : Nat) (e : C), W.CoupledInto obs g e → L.BalancesOn W [e] t) →
    (∀ (t : Nat) (e : C), W.CoupledInto obs g e → L'.BalancesOn W' [e] t) →
      W.DependsOn g c →
        ¬obs g c →
          W'.level 0 c = W.level 0 c + d →
            (∀ (e : C), W.CoupledInto obs g e → e ≠ c → W.level 0 e = W'.level 0 e) →
              L.ExchangeFollows W L' W' obs g →
                (∀ (t : Nat), W.Supported t g) →
                  ∀ (t : Nat), W'.level t c = W.level t c + d ∧ W.AlikeThrough obs g W.level W'.level t
