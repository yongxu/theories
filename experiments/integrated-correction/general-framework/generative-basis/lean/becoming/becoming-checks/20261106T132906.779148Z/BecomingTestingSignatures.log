  {L' : Becoming.Flow F C} {W' : Becoming.Web F C} {obs : F → C → Prop} {region : F → Prop},
  (∀ (t : Nat) (g : F) (c : C), region g → W.CoupledInto obs g c → L.BalancesOn W [c] t) →
    (∀ (t : Nat) (g : F) (c : C), region g → W.CoupledInto obs g c → L'.BalancesOn W' [c] t) →
      Becoming.ClosedUnder (L.CoupledFrom W obs) region →
        Becoming.ClosedUnder (L'.CoupledFrom W obs) region →
          (∀ (t : Nat), L.present t = L'.present t) →
            (∀ (g : F), region g → ∀ (c : C), W.CoupledInto obs g c → W.level 0 c = W'.level 0 c) →
