  {L' : Becoming.Flow F C} {obs : F → C → Prop} {g : F} {region : F → Prop} {h : F} {c : C} {t : Nat},
  Becoming.ClosedUnder (L.CoupledFrom W obs) region →
    Becoming.ClosedUnder (L'.CoupledFrom W obs) region →
      L.present t = L'.present t →
        region g →
