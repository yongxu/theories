  {b : α} (m : Nat), Becoming.WindowedWaiting.erringRun e w up m (b, 0) → ¬e m b
@Becoming.WindowedWaiting.spaced_mono : ∀ {α : Type u_1} {e : Nat → α → Prop} {w w' : Nat},
  w ≤ w' → Becoming.WindowedWaiting.Spaced e w → Becoming.WindowedWaiting.Spaced e w'
Becoming.WindowedWaiting.window_turn : ∀ (t i d : Nat), i + 1 + d + t = t + i + d + 1
@Becoming.WindowedWaiting.window_of_gap : ∀ {α : Type u_1} {e : Nat → α → Prop} {w : Nat} {up : α → α → Prop} {c : α}
  (n : Nat),
  (∀ (t : Nat), n + 1 = w + t → ∃ i, i < w ∧ Becoming.WindowedWaiting.erringRun e w up (t + i) (c, 0)) →
    ∃ i, i < w ∧ Becoming.WindowedWaiting.erringRun e w up n (c, i)
@Becoming.WindowedWaiting.gap_le : ∀ {w n t i : Nat}, n + 1 = w + t → i < w → t + i ≤ n
@Becoming.WindowedWaiting.gives_unless_errs_le : ∀ {α : Type u_1} {e : Nat → α → Prop} {w : Nat} {up : α → α → Prop},
  Becoming.WindowedWaiting.Spaced e w →
    ∀ (n m : Nat), m ≤ n → ∀ (a : α), ¬e m a → Becoming.WindowedWaiting.erringRun e w up m (a, 0)
@Becoming.WindowedWaiting.gives_unless_errs : ∀ {α : Type u_1} {e : Nat → α → Prop} {w : Nat} {up : α → α → Prop},
  Becoming.WindowedWaiting.Spaced e w →
    ∀ (n : Nat) (a : α),
      ((Becoming.Law.run (Becoming.WindowedWaiting.clocked e w up) (0, Becoming.WindowedWaiting.erringStart e)).state
              n).snd
          (a, 0) ↔
        ¬e n a
@Becoming.WindowedWaiting.errs_answered : ∀ {α : Type u_1} {e : Nat → α → Prop} {w : Nat} {up : α → α → Prop} {b a : α},
  up b a →
    ∀ (t : Nat),
      (∀ (i : Nat), i < w + 1 → e (t + i) b) →
        ¬((Becoming.Law.run (Becoming.WindowedWaiting.clocked e (w + 1) up)
                    (0, Becoming.WindowedWaiting.erringStart e)).state
                (t + w + 1)).snd
            (a, 0)
@Becoming.WindowedWaiting.withholder_answered_clocked : ∀ {α : Type u_1} {e : Nat → α → Prop} {w : Nat}
  {up : α → α → Prop} {c : α} {T : Nat},
  (∀ (t : Nat), T ≤ t → e t c) →
    ∀ (a : α),
      up c a →
        ∀ (n : Nat),
          T + (w + 1) ≤ n →
            ¬((Becoming.Law.run (Becoming.WindowedWaiting.clocked e (w + 1) up)
                        (0, Becoming.WindowedWaiting.erringStart e)).state
                    n).snd
                (a, 0)
@Becoming.WindowedWaiting.window_holds_of_gaps : ∀ {α : Type u_1} {e : Nat → α → Prop} {w : Nat} {up : α → α → Prop}
  {c : α},
  (∀ (t : Nat),
      ∃ i,
        i < w ∧
          ((Becoming.Law.run (Becoming.WindowedWaiting.clocked e w up)
                    (0, Becoming.WindowedWaiting.erringStart e)).state
                (t + i)).snd
            (c, 0)) →
    ∀ (n : Nat),
      ∃ i,
        i < w ∧
          ((Becoming.Law.run (Becoming.WindowedWaiting.clocked e w up)
                    (0, Becoming.WindowedWaiting.erringStart e)).state
                n).snd
            (c, i)
@Becoming.WindowedWaiting.spaced_window_holds : ∀ {α : Type u_1} {e : Nat → α → Prop} {w : Nat} {up : α → α → Prop},
  Becoming.WindowedWaiting.Spaced e w →
    ∀ (c : α) (n : Nat),
