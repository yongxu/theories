@Becoming.WindowedWaiting.invariant : ∀ {S : Type u_1} {next : S → S} {s : S} (P : S → Prop),
  P s → (∀ (x : S), P x → P (next x)) → ∀ (n : Nat), P ((Becoming.Law.run next s).state n)
