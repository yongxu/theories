@Becoming.LineageDrawdown.below_iff : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    ∀ (ds : List C) (T n m : Nat),
      W.stock ds (T + n) < m ↔
        W.stock ds T + Becoming.total (Becoming.steps T n) (L.replenishment ds) <
          m + Becoming.total (Becoming.steps T n) (L.uptake ds)
@Becoming.LineageDrawdown.degeneration_of_unmet : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {Q : X → X → Prop},
  W.Dependent →
    ∀ {ds : List X} {m N : Nat},
      W.stock ds N < m →
        ∀ {x : Nat × X},
          W.active x.fst x.snd →
            x.fst ≤ N →
              (∀ (y : Nat × X),
                  Becoming.«所及» (Becoming.LineageRegions.lineStep L W Q) (W.kindClass Q) x y →
                    y.fst = N → ∃ e, e ∈ ds ∧ W.requires y.fst y.snd e ∧ m ≤ W.need y.fst y.snd e) →
                Becoming.«退化» (Becoming.LineageRegions.lineStep L W Q) (W.kindClass Q) x
@Becoming.LineageDrawdown.degeneration_of_unmet_listed : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {Q : X → X → Prop},
  W.Dependent →
    ∀ {ds : List X} {m N : Nat},
      W.stock ds N < m →
        ∀ {G : Becoming.SelectionTerm.Generations X},
          Becoming.LineageRegions.ContinuationsListed (Becoming.LineageRegions.lineStep L W Q) (W.kindClass Q) G →
            (∀ (q : X), q ∈ G.family N → ∃ e, e ∈ ds ∧ W.requires N q e ∧ m ≤ W.need N q e) →
              ∀ {t : Nat} {p : X},
                p ∈ G.family t →
                  W.active t p → t ≤ N → Becoming.«退化» (Becoming.LineageRegions.lineStep L W Q) (W.kindClass Q) (t, p)
@Becoming.LineageDrawdown.degeneration_of_drawdown : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {Q : X → X → Prop},
  L.Balances W →
    W.Dependent →
      ∀ {ds : List X} {m T n : Nat},
        W.stock ds T + Becoming.total (Becoming.steps T n) (L.replenishment ds) <
            m + Becoming.total (Becoming.steps T n) (L.uptake ds) →
          ∀ {x : Nat × X},
            W.active x.fst x.snd →
              x.fst ≤ T + n →
                (∀ (y : Nat × X),
                    Becoming.«所及» (Becoming.LineageRegions.lineStep L W Q) (W.kindClass Q) x y →
                      y.fst = T + n → ∃ e, e ∈ ds ∧ W.requires y.fst y.snd e ∧ m ≤ W.need y.fst y.snd e) →
                  Becoming.«退化» (Becoming.LineageRegions.lineStep L W Q) (W.kindClass Q) x
@Becoming.LineageDrawdown.next_empty_of_unmet : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X},
  L.Acting W →
    W.Dependent →
      ∀ {G : Becoming.SelectionTerm.Generations X},
        Becoming.SelectionTerm.Flow.Descended L W G →
          ∀ {ds : List X} {m N : Nat},
            W.stock ds N < m →
              (∀ (q : X), q ∈ G.family N → ∃ e, e ∈ ds ∧ W.requires N q e ∧ m ≤ W.need N q e) → G.size (N + 1) = 0
@Becoming.LineageDrawdown.ends_of_unmet : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X},
  L.Acting W →
    W.Dependent →
      ∀ {G : Becoming.SelectionTerm.Generations X},
