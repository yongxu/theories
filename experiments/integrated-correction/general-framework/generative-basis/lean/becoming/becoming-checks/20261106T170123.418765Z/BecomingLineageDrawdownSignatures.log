                (∀ (q : X), q ∈ G.family (T + n) → ∃ e, e ∈ ds ∧ W.requires (T + n) q e ∧ m ≤ W.need (T + n) q e) →
                  ∀ (s : Nat), G.size (T + n + 1 + s) = 0 ∧ G.concordAt (T + n + s) = 0 ∧ G.discordAt (T + n + s) = 0
@Becoming.LineageDrawdown.no_term_of_drawdown : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X},
