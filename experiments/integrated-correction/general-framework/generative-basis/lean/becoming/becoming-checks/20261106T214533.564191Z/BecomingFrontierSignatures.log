    (∀ (a : H), admissible a → task a → means a) → Becoming.Requirement.Required admissible means
@Becoming.Requirement.Required.redescribed : ∀ {H : Type} {admissible task : H → Prop} {K : Type}
  {admissible' task' : K → Prop} (f : H → K),
  (∀ (a : H), admissible a → admissible' (f a)) →
    (∀ (b : K), admissible' b → ∃ a, admissible a ∧ f a = b) →
      (∀ (a : H), task a ↔ task' (f a)) →
        Becoming.Requirement.Required admissible task → Becoming.Requirement.Required admissible' task'
@Becoming.Requirement.required_of_bettered : ∀ {H : Type} {eligible : H → Prop} {better : H → H → Prop}
  {task : H → Prop} (x : H) (rest : List H),
  (∀ (a : H), eligible a ↔ a ∈ x :: rest) →
    (∀ (a b : H), eligible a → eligible b → Becoming.WeaklyDecided (better a b)) →
      (∀ (a : H), ¬better a a) →
        (∀ {a b c : H}, better a b → better b c → better a c) →
          (∀ (a : H), eligible a → Becoming.Decided (task a)) →
            (∀ (a : H), eligible a → ¬task a → ∃ b, eligible b ∧ better b a) →
              Becoming.Requirement.Required (Becoming.Requirement.Frontier eligible better) task
@Becoming.Lexical.BasicPriority.frontier_iff : ∀ {H : Type} {eligible : H → Prop} {better : H → H → Prop} {C G : Type}
  {basic : H → C → Prop} {gain : H → G → Prop},
  Becoming.Lexical.BasicPriority basic gain better →
    ∀ {a : H},
      Becoming.Requirement.Frontier eligible better a ↔
        Becoming.Requirement.Frontier eligible (Becoming.Lexical.Above basic gain) a
@Becoming.Lexical.BasicPriority.required_iff : ∀ {H : Type} {eligible : H → Prop} {better : H → H → Prop}
  {task : H → Prop} {C G : Type} {basic : H → C → Prop} {gain : H → G → Prop},
  Becoming.Lexical.BasicPriority basic gain better →
    (Becoming.Requirement.Required (Becoming.Requirement.Frontier eligible better) task ↔
      Becoming.Requirement.Required (Becoming.Requirement.Frontier eligible (Becoming.Lexical.Above basic gain)) task)
@Becoming.Requirement.Assigned.unique_required : ∀ {P A T : Type} {admissible : P → Prop}
  {allocation : P → T → A → Prop} {a : A} {t : T},
  (∃ p, admissible p) →
    (∀ (p : P), admissible p → ∃ b, allocation p t b) →
      (∀ (p : P) (b : A), admissible p → allocation p t b → b = a) →
        Becoming.Requirement.Required admissible fun p => Becoming.Requirement.Assigned allocation p a t
@Becoming.Requirement.Assigned.capable : ∀ {P A T : Type} {admissible : P → Prop} {allocation : P → T → A → Prop}
  {capable : P → A → T → Prop},
