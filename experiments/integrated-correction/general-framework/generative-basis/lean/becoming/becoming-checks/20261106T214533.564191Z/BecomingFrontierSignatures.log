  {menu : List H},
  (∀ (a : H), eligible a ↔ a ∈ menu) →
    ∀ {a : H}, Becoming.Requirement.Frontier eligible better a ↔ Becoming.Undominated menu better a
@Becoming.Requirement.frontier_exists : ∀ {H : Type} {eligible : H → Prop} {better : H → H → Prop} (x : H)
  (rest : List H),
  (∀ (a : H), eligible a ↔ a ∈ x :: rest) →
    (∀ (a b : H), eligible a → eligible b → Becoming.WeaklyDecided (better a b)) →
      (∀ (a : H), ¬better a a) →
        (∀ {a b c : H}, better a b → better b c → better a c) → ∃ a, Becoming.Requirement.Frontier eligible better a
