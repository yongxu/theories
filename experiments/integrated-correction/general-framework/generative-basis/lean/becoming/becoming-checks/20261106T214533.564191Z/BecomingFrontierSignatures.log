@Becoming.Requirement.required_under_every_classification : ∀ {H C G N : Type} {p : H → C → Prop} {g : H → G → Prop}
  {f : H → N → Prop} {eligible formed : H → Prop} (x : H) (rest : List H),
  (∀ (a : H), eligible a ↔ a ∈ x :: rest) →
    (∀ (q : N → Prop) (a b : H),
        eligible a → eligible b → Becoming.WeaklyDecided (Becoming.Lexical.classified p g f q a b)) →
      (∀ (a : H), eligible a → Becoming.Decided (formed a)) →
        (∀ (a : H) (n : N), eligible a → Becoming.Decided (f a n)) →
          (∀ (q : N → Prop) (a b : H), eligible a → eligible b → Becoming.Decided (∀ (n : N), f a n → q n → f b n)) →
            (∀ (a : H),
                eligible a →
                  ¬formed a →
                    ∃ b,
                      eligible b ∧
                        Becoming.Lexical.Included (f a) (f b) ∧
                          Becoming.Lexical.Above p (Becoming.Lexical.adjoin g f) b a) →
              ∀ (q : N → Prop),
                Becoming.Requirement.Required
                  (Becoming.Requirement.Frontier eligible (Becoming.Lexical.classified p g f q)) formed
