      Becoming.Weighting.WidensOn items a b →
        ∃ u refusal,
          range u refusal ∧ Becoming.Weighting.reach items u refusal b < Becoming.Weighting.reach items u refusal a) ↔
    ∀ (x : X), x ∈ items → ∃ u refusal, range u refusal ∧ refusal < u x ∧ ∀ (y : X), y ∈ items → y ≠ x → u y < u x
