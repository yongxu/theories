  (∀ (R : P → (X → Bool) → (X → Bool) → Prop),
      (∀ (p : P), Becoming.Weighting.IncreasingInOwn items (own p) (R p)) →
        (∀ (p : P), Becoming.Weighting.NotBelow items (R p)) → Becoming.Weighting.ParetoAmong R b a) ↔
    Becoming.Weighting.WidensOn items a b ∧ ∃ p, Becoming.Weighting.AddsOwn items (own p) a b
