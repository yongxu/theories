  Becoming.ReadsNoOrder help →
    ∀ {frame : Becoming.Frame S A C} {living : C → Prop} {premise : (S → S → Prop) → Prop} {d : D},
      (∀ (better : S → S → Prop), premise better → help d better → Becoming.Comparison frame living better) →
        ∀ {order : S → S → Prop}, help d order → ¬∃ better, premise better ∧ ¬Becoming.Comparison frame living better
@Becoming.ReadsNoOrder.iff_of_weaker : ∀ {S A C D : Type} {help : D → (S → S → Prop) → Prop},
  Becoming.ReadsNoOrder help →
    ∀ {frame : Becoming.Frame S A C} {living : C → Prop} {premise : (S → S → Prop) → Prop} {d : D},
      (∀ (better : S → S → Prop), premise better → help d better → Becoming.Comparison frame living better) →
        ∀ {order : S → S → Prop},
          help d order →
            (∀ (better : S → S → Prop), Becoming.Comparison frame living better → premise better) →
              ∀ (better : S → S → Prop), premise better ↔ Becoming.Comparison frame living better
