        (∀ (p : P), Becoming.Weighting.NotBelow items (R p)) →
          Becoming.Weighting.Increasing items (Becoming.Weighting.ParetoAmong R)) ↔
    ∀ (x : X), x ∈ items → ∃ p, own p x = true
