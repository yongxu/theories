@Becoming.PooledEnvelopes.retained_truth : ∀ {H : Type} (models : List H) (test : H → Bool) (actual : H),
  actual ∈ models → actual ∈ Becoming.PooledEnvelopes.retain models test (test actual)
@Becoming.PooledEnvelopes.retained_subset : ∀ {H : Type} (models : List H) (test : H → Bool) (answer : Bool) (h : H),
  h ∈ Becoming.PooledEnvelopes.retain models test answer → h ∈ models
@Becoming.PooledEnvelopes.model_faults_in_pool : ∀ {H : Type} (describe : H → Becoming.Reconfiguration.Arrangement)
  (models : List H) (actual : H),
  actual ∈ models →
    ∀ (bad : List Becoming.FaultEnvelopes.Domain),
      bad ∈ Becoming.Reconfiguration.envelope (describe actual) → bad ∈ Becoming.PooledEnvelopes.pooled describe models
@Becoming.PooledEnvelopes.pooled_subset : ∀ {H : Type} (describe : H → Becoming.Reconfiguration.Arrangement)
  (old new : List H),
  (∀ (h : H), h ∈ new → h ∈ old) →
    ∀ (bad : List Becoming.FaultEnvelopes.Domain),
      bad ∈ Becoming.PooledEnvelopes.pooled describe new → bad ∈ Becoming.PooledEnvelopes.pooled describe old
@Becoming.PooledEnvelopes.pooled_certificate_sound : ∀ {H : Type} (describe : H → Becoming.Reconfiguration.Arrangement)
  (models : List H) (actual : H),
  actual ∈ models →
    ∀ (roots : List Nat),
      Becoming.Reconfiguration.Covered (describe actual) roots →
        ∀ (supports : Becoming.FaultEnvelopes.Domain → Bool) (P : Prop),
          (∀ (d : Becoming.FaultEnvelopes.Domain),
              d ∈ (describe actual).roster →
                Becoming.Reconfiguration.fails ((describe actual).vulnerability d) roots = false →
                  supports d = true → P) →
            Becoming.FaultEnvelopes.certificate (describe actual).roster
                  (Becoming.PooledEnvelopes.pooled describe models) supports =
                true →
              P
@Becoming.PooledEnvelopes.refinement_preserves_certificate : ∀ {H : Type}
  (describe : H → Becoming.Reconfiguration.Arrangement) (roster : List Becoming.FaultEnvelopes.Domain)
  (old new : List H),
  (∀ (h : H), h ∈ new → h ∈ old) →
    Becoming.PooledEnvelopes.pooled describe new ≠ [] →
      ∀ (supports : Becoming.FaultEnvelopes.Domain → Bool),
        Becoming.FaultEnvelopes.certificate roster (Becoming.PooledEnvelopes.pooled describe old) supports = true →
          Becoming.FaultEnvelopes.certificate roster (Becoming.PooledEnvelopes.pooled describe new) supports = true
@Becoming.PooledEnvelopes.refinement_preserves_separation : ∀ {H : Type}
  (describe : H → Becoming.Reconfiguration.Arrangement) (roster : List Becoming.FaultEnvelopes.Domain)
  (old new : List H),
  (∀ (h : H), h ∈ new → h ∈ old) →
    Becoming.FaultEnvelopes.separated roster (Becoming.PooledEnvelopes.pooled describe old) →
      Becoming.FaultEnvelopes.separated roster (Becoming.PooledEnvelopes.pooled describe new)
Becoming.PooledEnvelopes.empty_family_rejects : ∀ (roster : List Becoming.FaultEnvelopes.Domain) {H : Type}
  (describe : H → Becoming.Reconfiguration.Arrangement) (supports : Becoming.FaultEnvelopes.Domain → Bool),
  Becoming.FaultEnvelopes.certificate roster (Becoming.PooledEnvelopes.pooled describe []) supports = false
@Becoming.PooledEnvelopes.member_completes : ∀ {H : Type} (describe : H → Becoming.Reconfiguration.Arrangement)
  (models : List H) (actual : H),
  actual ∈ models →
    ∀ (roots : List Nat),
      Becoming.Reconfiguration.Covered (describe actual) roots →
        Becoming.FaultEnvelopes.separated (describe actual).roster (Becoming.PooledEnvelopes.pooled describe models) →
          ∀ (w : Becoming.Transactions.Installation) (p : Becoming.Transactions.Request)
            (reads : Becoming.Transactions.Readings) (approvals : Becoming.Transactions.Approvals),
            Becoming.Transactions.fresh w p = true →
              (∀ (d : Becoming.FaultEnvelopes.Domain),
                  d ∈ (describe actual).roster →
                    Becoming.Reconfiguration.fails ((describe actual).vulnerability d) roots = false →
                      reads d = some (Becoming.Transactions.expected p)) →
                (∀ (d : Becoming.FaultEnvelopes.Domain),
                    d ∈ (describe actual).roster →
                      Becoming.Reconfiguration.fails ((describe actual).vulnerability d) roots = false →
                        approvals d = some p) →
                  (∀ (d : Becoming.FaultEnvelopes.Domain),
                      d ∈ (describe actual).roster →
                        Becoming.Reconfiguration.fails ((describe actual).vulnerability d) roots = false →
                          ∀ (o : Becoming.Transactions.Observation),
                            reads d = some o → o = Becoming.Transactions.observed w p.address) →
                    (∀ (d : Becoming.FaultEnvelopes.Domain),
                        d ∈ (describe actual).roster →
                          Becoming.Reconfiguration.fails ((describe actual).vulnerability d) roots = false →
                            approvals d = some p → Becoming.Transactions.withinScope w p = true) →
                      Becoming.Transactions.load (describe actual).roster p + 3 ≤ w.state.reserve →
                        w.state.time + Becoming.Transactions.load (describe actual).roster p + 3 ≤ w.state.deadline →
                          (Becoming.Transactions.guardedExecute (describe actual).roster
                                  (Becoming.PooledEnvelopes.pooled describe models)
                                  (Becoming.PooledEnvelopes.pooled describe models) w p reads approvals).succeeded =
                              true ∧
                            (Becoming.Transactions.guardedExecute (describe actual).roster
                                        (Becoming.PooledEnvelopes.pooled describe models)
                                        (Becoming.PooledEnvelopes.pooled describe models) w p reads
                                        approvals).installation.state.completed =
                                true ∧
                              Becoming.Transactions.withinScope w p = true
@Becoming.PooledEnvelopes.pooled_completes : ∀ {H : Type} (describe : H → Becoming.Reconfiguration.Arrangement)
  (models : List H) (test : H → Bool) (actual : H),
  actual ∈ models →
    ∀ (roots : List Nat),
      Becoming.Reconfiguration.Covered (describe actual) roots →
        Becoming.FaultEnvelopes.separated (describe actual).roster
            (Becoming.PooledEnvelopes.pooled describe (Becoming.PooledEnvelopes.retain models test (test actual))) →
          ∀ (w : Becoming.Transactions.Installation) (p : Becoming.Transactions.Request)
            (reads : Becoming.Transactions.Readings) (approvals : Becoming.Transactions.Approvals),
            Becoming.Transactions.fresh w p = true →
              (∀ (d : Becoming.FaultEnvelopes.Domain),
                  d ∈ (describe actual).roster →
                    Becoming.Reconfiguration.fails ((describe actual).vulnerability d) roots = false →
                      reads d = some (Becoming.Transactions.expected p)) →
                (∀ (d : Becoming.FaultEnvelopes.Domain),
                    d ∈ (describe actual).roster →
                      Becoming.Reconfiguration.fails ((describe actual).vulnerability d) roots = false →
                        approvals d = some p) →
                  (∀ (d : Becoming.FaultEnvelopes.Domain),
                      d ∈ (describe actual).roster →
                        Becoming.Reconfiguration.fails ((describe actual).vulnerability d) roots = false →
                          ∀ (o : Becoming.Transactions.Observation),
                            reads d = some o → o = Becoming.Transactions.observed w p.address) →
                    (∀ (d : Becoming.FaultEnvelopes.Domain),
                        d ∈ (describe actual).roster →
                          Becoming.Reconfiguration.fails ((describe actual).vulnerability d) roots = false →
                            approvals d = some p → Becoming.Transactions.withinScope w p = true) →
                      Becoming.Transactions.load (describe actual).roster p + 3 ≤ w.state.reserve →
                        w.state.time + Becoming.Transactions.load (describe actual).roster p + 3 ≤ w.state.deadline →
                          (Becoming.Transactions.guardedExecute (describe actual).roster
                                  (Becoming.PooledEnvelopes.pooled describe
                                    (Becoming.PooledEnvelopes.retain models test (test actual)))
                                  (Becoming.PooledEnvelopes.pooled describe
                                    (Becoming.PooledEnvelopes.retain models test (test actual)))
                                  w p reads approvals).succeeded =
                              true ∧
                            (Becoming.Transactions.guardedExecute (describe actual).roster
                                        (Becoming.PooledEnvelopes.pooled describe
                                          (Becoming.PooledEnvelopes.retain models test (test actual)))
                                        (Becoming.PooledEnvelopes.pooled describe
                                          (Becoming.PooledEnvelopes.retain models test (test actual)))
                                        w p reads approvals).installation.state.completed =
                                true ∧
                              Becoming.Transactions.withinScope w p = true
