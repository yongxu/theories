@Becoming.PooledEnvelopes.probe_some : ∀ {s t : Becoming.PooledEnvelopes.Situation}
  {q : Becoming.PooledEnvelopes.Inspection} {a : Bool},
  Becoming.PooledEnvelopes.probe s q = some (a, t) →
    a = Becoming.PooledEnvelopes.queryLaw q s.actual ∧
      t.actual = s.actual ∧
        t.candidates = Becoming.PooledEnvelopes.retain s.candidates (Becoming.PooledEnvelopes.queryLaw q) a
Becoming.PooledEnvelopes.probe_keeps_actual : ∀ (s : Becoming.PooledEnvelopes.Situation)
  (q : Becoming.PooledEnvelopes.Inspection) (answer : Bool) (after : Becoming.PooledEnvelopes.Situation),
  s.actual ∈ s.candidates →
    Becoming.PooledEnvelopes.probe s q = some (answer, after) →
      after.actual = s.actual ∧ after.actual ∈ after.candidates
Becoming.PooledEnvelopes.selected_completes : ∀ (states : List Becoming.PooledEnvelopes.Situation)
  (chosen : Becoming.ContingentPlans.Plan Becoming.PooledEnvelopes.Inspection Unit)
  (s : Becoming.PooledEnvelopes.Situation),
  Becoming.ContingentPlans.choose Becoming.PooledEnvelopes.interface states Becoming.PooledEnvelopes.plans =
      some chosen →
    s ∈ states →
      ∃ answer after out,
        Becoming.PooledEnvelopes.probe s chosen.query = some (answer, after) ∧
          Becoming.PooledEnvelopes.respond after (Becoming.ContingentPlans.branch chosen answer) = some out ∧
            Becoming.PooledEnvelopes.achieved out = true
