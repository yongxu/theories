@Becoming.World.standingAt_alike : ∀ {k k' : Nat},
  0 < k →
    0 < k' →
      ∀ (t : Nat),
        ((Becoming.World.standingAt k).web.active t () ↔ (Becoming.World.standingAt k').web.active t ()) ∧
          (0 < (Becoming.World.standingAt k).web.level t () ↔ 0 < (Becoming.World.standingAt k').web.level t ()) ∧
            ((Becoming.World.standingAt k).web.requires t () () ↔ (Becoming.World.standingAt k').web.requires t () ()) ∧
              ((Becoming.World.standingAt k).web.draws t () () ↔ (Becoming.World.standingAt k').web.draws t () ()) ∧
                (() ∈ (Becoming.World.standingAt k).flow.present t ↔
                    () ∈ (Becoming.World.standingAt k').flow.present t) ∧
                  ((Becoming.World.standingAt k).web.need t () () ≤ (Becoming.World.standingAt k).web.level t () ↔
                      (Becoming.World.standingAt k').web.need t () () ≤ (Becoming.World.standingAt k').web.level t ()) ∧
                    (0 < (Becoming.World.standingAt k).flow.give t () () ↔
                        0 < (Becoming.World.standingAt k').flow.give t () ()) ∧
                      (0 < (Becoming.World.standingAt k).flow.take t () () ↔
                          0 < (Becoming.World.standingAt k').flow.take t () ()) ∧
                        ((Becoming.World.standingAt k).Conserves t () () ↔
                            (Becoming.World.standingAt k').Conserves t () ()) ∧
                          ((Becoming.World.standingAt k).web.Falls t () ↔
                              (Becoming.World.standingAt k').web.Falls t ()) ∧
                            (Becoming.World.standingAt k).web.level t () = k
