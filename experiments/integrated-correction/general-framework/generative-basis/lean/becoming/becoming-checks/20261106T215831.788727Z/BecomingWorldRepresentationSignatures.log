@Becoming.World.reidentify_carries : ∀ {w : Becoming.World} {R' : Type} (σ : Becoming.Reidentify w.Relatum R'),
  Becoming.«谓» (Becoming.«像» σ.onOccurrences.to Becoming.Web.sameStep) Becoming.Web.sameStep ∧
    Becoming.«谓» (Becoming.«像» σ.onOccurrences.to (w.reidentify σ).conservationStep) w.conservationStep ∧
      Becoming.«谓»
          (Becoming.«像» σ.onOccurrences.to
            (Becoming.Web.partialIdentity fun x => (w.reidentify σ).web.active x.fst x.snd))
          (Becoming.Web.partialIdentity fun x => w.web.active x.fst x.snd) ∧
        Becoming.«谓»
            (Becoming.«像» σ.onOccurrences.to
