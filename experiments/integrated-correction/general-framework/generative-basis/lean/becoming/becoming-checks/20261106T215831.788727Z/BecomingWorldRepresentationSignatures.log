Becoming.World.ofRelations_relations : ∀ (F : Type) (active : Nat → F → Prop) (requires draws : Nat → F → F → Prop)
  (present : Nat → List F) (t : Nat),
  (∀ (x : (Becoming.World.ofRelations F active requires draws present).Relatum),
      (Becoming.World.ofRelations F active requires draws present).web.active t x ↔ active t x) ∧
    (∀ (x y : (Becoming.World.ofRelations F active requires draws present).Relatum),
        (Becoming.World.ofRelations F active requires draws present).web.requires t x y ↔ requires t x y) ∧
      (∀ (x y : (Becoming.World.ofRelations F active requires draws present).Relatum),
          (Becoming.World.ofRelations F active requires draws present).web.draws t x y ↔ draws t x y) ∧
        ∀ (x : (Becoming.World.ofRelations F active requires draws present).Relatum),
          x ∈ (Becoming.World.ofRelations F active requires draws present).flow.present t ↔ x ∈ present t
Becoming.World.ofModel_model : ∀ (F : Type) (a : Nat × F → Prop) {q d : Becoming.«际» (Nat × F)},
  Becoming.«则» q Becoming.Web.sameStep →
    Becoming.«则» d Becoming.Web.sameStep →
      ∀ (present : Nat → List F),
        Becoming.«谓»
            (Becoming.Web.partialIdentity fun x => (Becoming.World.ofModel F a q d present).web.active x.fst x.snd)
            (Becoming.Web.partialIdentity a) ∧
          Becoming.«谓» (Becoming.World.withinStep (Becoming.World.ofModel F a q d present).web.requires) q ∧
            Becoming.«谓» (Becoming.World.withinStep (Becoming.World.ofModel F a q d present).web.draws) d ∧
              ∀ (x : Nat × F),
                x.snd ∈ (Becoming.World.ofModel F a q d present).flow.present x.fst ↔ x.snd ∈ present x.fst
@Becoming.World.conserves_form : ∀ {w : Becoming.World} {t : Nat} {g f : w.Relatum},
  w.Conserves t g f ↔ w.web.level (t + 1) f + w.flow.taken t g = w.web.level t g + w.flow.given t g
@Becoming.World.ofConservationForm_conserves : ∀ {R : Type} (r₀ : R) (level a b : Nat → R → Nat) (t : Nat) (g f : R),
  (Becoming.World.ofConservationForm r₀ level a b).Conserves t g f ↔ level (t + 1) f + b t g = a t g
@Becoming.World.conserves_iff_same_level : ∀ {w : Becoming.World} {t : Nat} {g f : w.Relatum},
  w.Conserves t g f → ∀ (f' : w.Relatum), w.Conserves t g f' ↔ w.web.level (t + 1) f' = w.web.level (t + 1) f
@Becoming.World.conserves_difunctional : ∀ {w : Becoming.World} {t : Nat} {g g' f f' : w.Relatum},
