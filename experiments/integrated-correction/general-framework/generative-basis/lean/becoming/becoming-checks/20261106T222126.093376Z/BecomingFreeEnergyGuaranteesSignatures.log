@Becoming.FreeEnergyGuarantees.RiskAndNeeds.need_ends : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {c : C} {m : Nat},
          (∀ (t : Nat) (e : F), e ∈ L.present t → 0 < L.give t e c → W.requires t e c ∧ m ≤ W.need t e c) →
            ∀ {T n : Nat} {rest : List F},
              Becoming.Distinct rest →
                (∀ (j : Nat) (f : F), j < n → f ∈ rest → 0 < L.take (T + j) f c → f ∈ L.present (T + j)) →
                  (∀ (j : Nat), j < n → L.given (T + j) c < Becoming.total rest fun f => L.take (T + j) f c) →
                    W.level T c < n + m →
                      ∀ (g : F) (R : Type) (ch : Becoming.FreeEnergyGuarantees.RiskAndNeeds.Chooser R)
                        (reading : Nat → R),
                        ¬g ∈ rest →
                          (∀ (t : Nat), g ∈ L.present t → L.take t g c = ch.chosen (reading t)) →
                            ∀ (k : Nat),
                              W.level (T + n + k) c < m ∧
                                (W.requires (T + n + k) g c → m ≤ W.need (T + n + k) g c → ¬W.active (T + n + k) g)
@Becoming.FreeEnergyGuarantees.RiskAndNeeds.restraint_unread : ∀ {F C : Type} {L : Becoming.Flow F C}
  {W : Becoming.Web F C} {L' : Becoming.Flow F C} {W' : Becoming.Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        L'.Balances W' →
          L'.Acting W' →
            W'.Dependent →
              ∀ {c : C},
                (∀ (t : Nat) (e : F), e ∈ L.present t → 0 < L.give t e c → W.requires t e c ∧ 1 ≤ W.need t e c) →
                  (∀ (t : Nat) (e : F), e ∈ L'.present t → 0 < L'.give t e c → W'.requires t e c ∧ 1 ≤ W'.need t e c) →
                    ∀ {T n : Nat} {rest rest' : List F},
                      Becoming.Distinct rest →
                        Becoming.Distinct rest' →
                          (∀ (j : Nat) (f : F), j < n → f ∈ rest → 0 < L.take (T + j) f c → f ∈ L.present (T + j)) →
                            (∀ (j : Nat) (f : F),
                                j < n → f ∈ rest' → 0 < L'.take (T + j) f c → f ∈ L'.present (T + j)) →
                              (∀ (j : Nat),
                                  j < n → L.given (T + j) c < Becoming.total rest fun f => L.take (T + j) f c) →
                                (∀ (j : Nat),
                                    j < n → L'.given (T + j) c < Becoming.total rest' fun f => L'.take (T + j) f c) →
                                  W.level T c < n + 1 →
                                    W'.level T c < n + 1 →
                                      ∀ {score : (Nat → C → Nat) → Nat},
                                        (∀ (l l' : Nat → C → Nat),
                                            (∀ (k : Nat), l (T + n + k) c = l' (T + n + k) c) → score l = score l') →
                                          ∀ (g : F) (R : Type)
                                            (ch : Becoming.FreeEnergyGuarantees.RiskAndNeeds.Chooser R)
                                            (reading : Nat → R),
                                            ¬g ∈ rest →
                                              ¬g ∈ rest' →
                                                (∀ (t : Nat), g ∈ L.present t → L.take t g c = ch.chosen (reading t)) →
                                                  (∀ (t : Nat),
                                                      g ∈ L'.present t →
                                                        L'.take t g c =
                                                          (Becoming.FreeEnergyGuarantees.RiskAndNeeds.Chooser.restraint
                                                                R).chosen
                                                            (reading t)) →
                                                    score W.level = score W'.level
@Becoming.FreeEnergyGuarantees.RiskAndNeeds.outside_takes_nothing : ∀ {F C : Type} {L : Becoming.Flow F C}
  {W : Becoming.Web F C},
