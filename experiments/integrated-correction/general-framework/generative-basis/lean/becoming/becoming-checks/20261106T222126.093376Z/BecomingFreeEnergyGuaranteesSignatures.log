@Becoming.FreeEnergyGuarantees.RiskAndNeeds.expectation_not_course : ∀ {F C : Type} {L : Becoming.Flow F C}
  {W : Becoming.Web F C},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {c : C} {m : Nat},
          (∀ (t : Nat) (e : F), e ∈ L.present t → 0 < L.give t e c → W.requires t e c ∧ m ≤ W.need t e c) →
            ∀ {T n : Nat} {rest : List F},
              Becoming.Distinct rest →
                (∀ (j : Nat) (f : F), j < n → f ∈ rest → 0 < L.take (T + j) f c → f ∈ L.present (T + j)) →
                  (∀ (j : Nat), j < n → L.given (T + j) c < Becoming.total rest fun f => L.take (T + j) f c) →
                    W.level T c < n + m →
                      ∀ (ch : Becoming.FreeEnergyGuarantees.RiskAndNeeds.Chooser Nat),
