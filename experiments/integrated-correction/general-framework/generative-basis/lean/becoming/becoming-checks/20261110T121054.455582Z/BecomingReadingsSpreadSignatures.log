@Becoming.SelectionTerm.Generations.fixed_of_closedFrom : ∀ {Sig α O : Type} {G : Becoming.SelectionTerm.Generations α}
  {read : α → Sig} {sense : Nat → α → O} {upd : Sig → O → Sig} {P : Sig → Prop} {T : Nat},
  G.RevisesBy read sense upd →
    (∀ (x : α), x ∈ G.family T → P (read x)) →
      G.ClosedFrom read sense upd P T → ∀ (n : Nat) (x : α), x ∈ G.family (T + n) → P (read x)
@Becoming.SelectionTerm.Generations.revised_out : ∀ {Sig α O : Type} {G : Becoming.SelectionTerm.Generations α}
  {read : α → Sig} {sense : Nat → α → O} {upd : Sig → O → Sig} {P : Sig → Prop} {t : Nat} {p k : α},
  G.RevisesBy read sense upd →
    p ∈ G.family t → k ∈ G.kids t p → ¬P (upd (read p) (sense t p)) → k ∈ G.family (t + 1) ∧ ¬P (read k)
@Becoming.SelectionTerm.Generations.fixed_of_present : ∀ {Sig α : Type} {G : Becoming.SelectionTerm.Generations α}
  {read : α → Sig} {P : Sig → Prop} {T : Nat} {src : Nat → α → α} {upd : Sig → Sig → Sig},
  G.RevisesBy read (fun t p => read (src t p)) upd →
    (∀ (t : Nat) (p : α), p ∈ G.family t → src t p ∈ G.family t) →
      (∀ (σ τ : Sig), P σ → P τ → P (upd σ τ)) →
        (∀ (x : α), x ∈ G.family T → P (read x)) → ∀ (n : Nat) (x : α), x ∈ G.family (T + n) → P (read x)
@Becoming.Flow.inheritsReading_iff : ∀ {X Sig : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X} {read : X → Sig},
  L.InheritsReading W read ↔ L.RevisesBy W read (fun x x_1 => ()) fun σ x => σ
@Becoming.Flow.RevisesBy.lineOf : ∀ {X Sig O : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  [inst : DecidableEq X] {read : X → Sig} {sense : Nat → X → O} {upd : Sig → O → Sig},
  L.RevisesBy W read sense upd → ∀ {members first : List X}, (L.lineOf W members first).RevisesBy read sense upd
@Becoming.Flow.closedFrom_of_standing : ∀ {X Sig : Type} {W : Becoming.Web X X}
  {G : Becoming.SelectionTerm.Generations X} {read : X → Sig} {src : Nat → X → X} {upd : Sig → Sig → Sig}
  {P : Sig → Prop} {T : Nat},
  (∀ (t : Nat) (g : X), T ≤ t → g ∈ G.family t → 0 < W.level t (src t g)) →
    (∀ (σ τ : Sig), P σ → P τ → P (upd σ τ)) →
      (∀ (t : Nat) (y : X), T ≤ t → 0 < W.level t y → P (read y)) →
        G.ClosedFrom read (fun t g => read (src t g)) upd P T
@Becoming.SelectionTerm.Generations.withAmount_family : ∀ {α : Type} (G : Becoming.SelectionTerm.Generations α)
  (a : Nat → α → Nat) (t : Nat), (G.withAmount a).family t = G.family t
Becoming.SelectionTerm.Generations.excess_indicator : ∀ (b c : Bool),
  Becoming.excess (bif b then 1 else 0) (bif c then 1 else 0) = bif b && !c then 1 else 0
@Becoming.SelectionTerm.Generations.carrying_family : ∀ {Sig α : Type} {G : Becoming.SelectionTerm.Generations α}
  {read : α → Sig} {inR : Sig → Bool} (t : Nat), (G.carrying read inR).family t = G.family t
@Becoming.SelectionTerm.Generations.carrying_size : ∀ {Sig α : Type} {G : Becoming.SelectionTerm.Generations α}
  {read : α → Sig} {inR : Sig → Bool} (t : Nat), (G.carrying read inR).size t = G.size t
@Becoming.SelectionTerm.Generations.carrying_raisedAt : ∀ {Sig α : Type} {G : Becoming.SelectionTerm.Generations α}
  {read : α → Sig} {inR : Sig → Bool} (t : Nat), (G.carrying read inR).raisedAt t = G.revisedIn read inR t
@Becoming.SelectionTerm.Generations.carrying_loweredAt : ∀ {Sig α : Type} {G : Becoming.SelectionTerm.Generations α}
  {read : α → Sig} {inR : Sig → Bool} (t : Nat), (G.carrying read inR).loweredAt t = G.revisedOut read inR t
@Becoming.SelectionTerm.Generations.share_step : ∀ {Sig α : Type} {G : Becoming.SelectionTerm.Generations α}
  {read : α → Sig} {inR : Sig → Bool} (t : Nat),
  G.size t * (G.carrying read inR).sum (t + 1) +
      (G.size t * G.revisedOut read inR t + (G.carrying read inR).discordAt t) =
    G.size (t + 1) * (G.carrying read inR).sum t +
      ((G.carrying read inR).concordAt t + G.size t * G.revisedIn read inR t)
@Becoming.SelectionTerm.Generations.total_congr_mem : ∀ {α : Type} {q r : α → Nat} {ps : List α},
  (∀ (p : α), p ∈ ps → q p = r p) → Becoming.total ps q = Becoming.total ps r
@Becoming.SelectionTerm.Generations.fixed_step : ∀ {Sig α : Type} {G : Becoming.SelectionTerm.Generations α}
  {read : α → Sig} {inR : Sig → Bool} {t : Nat},
  (∀ (x : α), x ∈ G.family t → inR (read x) = true) →
    (G.carrying read inR).concordAt t = 0 ∧
      (G.carrying read inR).discordAt t = 0 ∧
        (G.carrying read inR).sum t = G.size t ∧
          G.revisedIn read inR t = 0 ∧ (G.carrying read inR).sum (t + 1) + G.revisedOut read inR t = G.size (t + 1)
@Becoming.SelectionTerm.Generations.absent_step : ∀ {Sig α : Type} {G : Becoming.SelectionTerm.Generations α}
  {read : α → Sig} {inR : Sig → Bool} {t : Nat},
  (∀ (x : α), x ∈ G.family t → inR (read x) = false) →
    (G.carrying read inR).concordAt t = 0 ∧
      (G.carrying read inR).discordAt t = 0 ∧ (G.carrying read inR).sum (t + 1) = G.revisedIn read inR t
@Becoming.SelectionTerm.Generations.revised_none_of_inherits : ∀ {Sig α : Type}
  {G : Becoming.SelectionTerm.Generations α} {read : α → Sig} {inR : Sig → Bool},
  (∀ (t : Nat) (p k : α), p ∈ G.family t → k ∈ G.kids t p → read k = read p) →
    ∀ (t : Nat), G.revisedIn read inR t = 0 ∧ G.revisedOut read inR t = 0
Becoming.Flow.indicator_le_one : ∀ (b : Bool), (bif b then 1 else 0) ≤ 1
@Becoming.Flow.supported_carriers_not_against : ∀ {X Sig : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {G : Becoming.SelectionTerm.Generations X} {read : X → Sig} {inR : Sig → Bool},
  L.Acting W →
    W.Dependent →
      Becoming.SelectionTerm.Flow.Descended L W G →
        ∀ {t : Nat},
          (∀ (p : X), p ∈ G.family t → W.Supported t p → inR (read p) = true) →
            (G.carrying read inR).discordAt t = 0 ∧
              Becoming.SelectionTerm.born ((G.carrying read inR).family t) ((G.carrying read inR).kids t) *
                  Becoming.total ((G.carrying read inR).family t) ((G.carrying read inR).amount t) ≤
                ((G.carrying read inR).family t).length *
                  Becoming.selected ((G.carrying read inR).family t) ((G.carrying read inR).kids t)
                    ((G.carrying read inR).amount t)
@Becoming.Flow.carriers_inactive_step : ∀ {X Sig : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {G : Becoming.SelectionTerm.Generations X} {read : X → Sig} {inR : Sig → Bool},
  L.Acting W →
    Becoming.SelectionTerm.Flow.Descended L W G →
      ∀ {t : Nat},
        (∀ (p : X), p ∈ G.family t → inR (read p) = true → ¬W.active t p) →
          (G.carrying read inR).sum (t + 1) = G.revisedIn read inR t
@Becoming.Flow.carriers_drawn_down : ∀ {X Sig : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {G : Becoming.SelectionTerm.Generations X} {read : X → Sig} {inR : Sig → Bool},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        Becoming.SelectionTerm.Flow.Descended L W G →
          ∀ {ds : List X} {m T n : Nat},
            W.stock ds T + Becoming.total (Becoming.steps T n) (L.replenishment ds) <
                m + Becoming.total (Becoming.steps T n) (L.uptake ds) →
              (∀ (q : X),
                  q ∈ G.family (T + n) →
                    inR (read q) = true → ∃ e, e ∈ ds ∧ W.requires (T + n) q e ∧ m ≤ W.need (T + n) q e) →
                (G.carrying read inR).sum (T + n + 1) = G.revisedIn read inR (T + n)
@Becoming.standingCount_unselected : ∀ {X Sig : Type} {law : Becoming.ExchangeLaw X X} {W : Becoming.Web X X}
  {obs : X → X → Prop} {part : X → Bool} {group : X → Prop} {present : Nat → List X} {start : X → Nat}
  {act act' : Becoming.ExchangeLaw X X},
  law.Nonanticipating →
    act.Nonanticipating →
      act'.Nonanticipating →
        law.Through W obs part →
          (act.Through W obs fun h => !part h) →
            (law.withAct part act).Feasible present start →
              (law.withAct part act').Feasible present start →
                (∀ (t : Nat) (h : X) (l : Nat → X → Nat) (c : X),
                    part h = true →
                      (∃ g,
                          Becoming.WithinClosureOf
                              (((law.withAct part act).course present start).CoupledFromEither W
                                ((law.withAct part act').course present start) obs)
                              group g ∧
                            W.CoupledInto obs g c) →
                        act.take t h l c = act'.take t h l c ∧ act.give t h l c = act'.give t h l c) →
                  ∀ {ms : List X},
                    (∀ (x : X), x ∈ ms → obs x x) →
                      (∀ (x : X),
                          x ∈ ms →
                            Becoming.WithinClosureOf
                              (((law.withAct part act).course present start).CoupledFromEither W
                                ((law.withAct part act').course present start) obs)
                              group x) →
                        ∀ (read : X → Sig) (inR : Sig → Bool) (t : Nat),
                          Becoming.standingCount ms read inR ((law.withAct part act).levels present start) t =
                            Becoming.standingCount ms read inR ((law.withAct part act').levels present start) t
Becoming.ReadingsSpread.Revised.rises_then_revised : (Becoming.ReadingsSpread.Revised.generations.carrying
          Becoming.ReadingsSpread.Revised.read id).sum
      0 =
    1 ∧
  Becoming.ReadingsSpread.Revised.generations.size 0 = 2 ∧
    (Becoming.ReadingsSpread.Revised.generations.carrying Becoming.ReadingsSpread.Revised.read id).concordAt 0 = 2 ∧
      (Becoming.ReadingsSpread.Revised.generations.carrying Becoming.ReadingsSpread.Revised.read id).discordAt 0 = 0 ∧
        Becoming.ReadingsSpread.Revised.generations.revisedIn Becoming.ReadingsSpread.Revised.read id 0 = 0 ∧
          Becoming.ReadingsSpread.Revised.generations.revisedOut Becoming.ReadingsSpread.Revised.read id 0 = 0 ∧
            (Becoming.ReadingsSpread.Revised.generations.carrying Becoming.ReadingsSpread.Revised.read id).sum 1 = 2 ∧
              Becoming.ReadingsSpread.Revised.generations.size 1 = 2 ∧
                (Becoming.ReadingsSpread.Revised.generations.carrying Becoming.ReadingsSpread.Revised.read id).concordAt
                      1 =
                    0 ∧
                  (Becoming.ReadingsSpread.Revised.generations.carrying Becoming.ReadingsSpread.Revised.read
                            id).discordAt
                        1 =
                      0 ∧
                    Becoming.ReadingsSpread.Revised.generations.revisedOut Becoming.ReadingsSpread.Revised.read id 1 =
                        1 ∧
                      (Becoming.ReadingsSpread.Revised.generations.carrying Becoming.ReadingsSpread.Revised.read id).sum
                            2 =
                          1 ∧
                        Becoming.ReadingsSpread.Revised.generations.size 2 = 2
