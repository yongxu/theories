      Becoming.Clearing.Formation.dweller
@Becoming.Clearing.couplingIn_leaves_dweller : ∀ {Pos : Type} {center : Pos → Becoming.Clearing.Formation} {p : Pos},
  center p = Becoming.Clearing.Formation.clearer →
    ∀ (obs : Becoming.Clearing.Formation → Becoming.Clearing.Place → Prop)
      {rel : Becoming.Clearing.Formation → Becoming.Clearing.Formation → Prop},
      (∀ (g h : Becoming.Clearing.Formation),
          rel g h → Becoming.Clearing.flow.CoupledFrom Becoming.Clearing.web obs g h) →
        (∀ (t : Nat), ¬Becoming.selfAscribed (Becoming.ownClosure rel) center p t Becoming.Clearing.Formation.dweller) ∧
          ¬Becoming.Unrestricted (Becoming.selfAscribed (Becoming.ownClosure rel) center) ∧
            Becoming.selfAscribed (Becoming.ownClosure (Becoming.Clearing.flow.Affects Becoming.Clearing.web)) center p
              0 Becoming.Clearing.Formation.dweller
Becoming.Clearing.counting_dweller_unselected : (∀ (select : (Nat → Becoming.Clearing.Place → Nat) → Prop),
    Becoming.Clearing.web.ReadOffCouplings Becoming.thresholdOnly Becoming.Clearing.clearerSide select →
      (select (Becoming.Clearing.countingLevel true) ↔ select (Becoming.Clearing.countingLevel false))) ∧
  Becoming.Clearing.DwellerEnded (Becoming.Clearing.countingLevel false) ∧
