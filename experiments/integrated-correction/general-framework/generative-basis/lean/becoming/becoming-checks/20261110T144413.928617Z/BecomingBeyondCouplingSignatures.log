          ¬∀ (b : Bool), select (Becoming.Clearing.countingLevel b) ↔ b = true
Becoming.Clearing.turned_by_dweller_read : Becoming.Clearing.web.ReadOffContinuations Becoming.Clearing.clearerOrDweller
