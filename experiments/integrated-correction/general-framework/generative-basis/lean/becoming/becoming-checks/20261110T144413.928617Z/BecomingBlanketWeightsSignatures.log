@Becoming.BlanketWeights.independentGiven_of_crossFormOn : ∀ {I B E : Type} (li : List I) (le : List E)
  (w : I → B → E → Nat), Becoming.BlanketWeights.CrossFormOn li le w → Becoming.BlanketWeights.IndependentGiven li le w
@Becoming.BlanketWeights.crossFormOn_of_independentGiven : ∀ {I B E : Type} (li : List I) (le : List E)
