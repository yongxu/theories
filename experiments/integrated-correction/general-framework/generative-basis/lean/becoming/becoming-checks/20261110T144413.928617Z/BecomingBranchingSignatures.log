      Becoming.DeterminedAt
        (Becoming.retargetAlike Becoming.Twins.frame Becoming.Twins.Config.left () Becoming.Twins.Config.start) x
Becoming.Coarse.first_bisimulation : Becoming.Bisimulation Becoming.Coarse.firstFrame Becoming.Coarse.firstFrame
  fun s s' => s.fst = s'.fst
Becoming.Coarse.first_determinedAt : ∀ (s : Bool × Bool), Becoming.DeterminedAt Becoming.Coarse.firstFrame s
Becoming.Coarse.meet_and_part : Becoming.Coarse.still.state 0 = Becoming.Coarse.turned.state 0 ∧
  (∀ (n : Nat), Becoming.Coarse.still.act n = Becoming.Coarse.turned.act n) ∧
    Becoming.Coarse.still.state 1 ≠ Becoming.Coarse.turned.state 1 ∧
      (∀ (s : Bool × Bool), Becoming.DeterminedAt Becoming.Coarse.firstFrame s) ∧
        ∀ (n : Nat),
          Becoming.Alike Becoming.Coarse.firstFrame Becoming.Coarse.firstFrame (Becoming.Coarse.still.state n)
            (Becoming.Coarse.turned.state n)
Becoming.Confound.refutes_registered : (∃ Q,
    (∀ (k : Bool), Becoming.DeterminedAt { P := Q, realized := fun x x_1 => True } k) ∧
      (Becoming.Confound.run Becoming.Confound.varied).StepsThrough Becoming.Confound.outcome Q 4) ∧
  ¬∃ Q,
      (∀ (k : Bool), Becoming.DeterminedAt (Becoming.Frame.configurations Q) k) ∧
        (Becoming.Confound.run Becoming.Confound.varied).StepsThrough Becoming.Confound.outcome Q 4
@Becoming.Law.rule_absorbing : ∀ {S : Type u_1} {R : Type u_2} {next : S × R → S × R},
  (∀ (s : S × R), (next s).snd = s.snd) → ∀ (g : R), Becoming.Law.Absorbing next fun s => s.snd = g
@Becoming.Law.held_absorbing : ∀ {S : Type u_1} {R : Type u_2} {next : S × R → S × R},
  (∀ (x x' : S) (g : R), next (x, g) = next (x', g)) →
    (∀ (s : S × R), (next s).snd = s.snd) → ∀ (x : S) (g : R), Becoming.Law.Absorbing next fun s => s = next (x, g)
@Becoming.Law.perturbation_drawnInto : ∀ {S : Type u_1} {R : Type u_2} {next : S × R → S × R},
  (∀ (x x' : S) (g : R), next (x, g) = next (x', g)) →
    ∀ {x x' : S} {g : R}, (x', g) ≠ next (x, g) → Becoming.Law.DrawnInto next (fun s => s = next (x, g)) (x', g)
Becoming.Captured.keeps : ∀ (s : Bool × Bool), (Becoming.Captured.next s).snd = s.snd
Becoming.Captured.rule_region_absorbing : ∀ (g : Bool), Becoming.Law.Absorbing Becoming.Captured.next fun s => s.snd = g
Becoming.Captured.held_absorbing : ∀ (g : Bool), Becoming.Law.Absorbing Becoming.Captured.next fun s => s = (g, g)
Becoming.Captured.state_perturbation_drawn : ∀ (g : Bool),
  Becoming.Law.DrawnInto Becoming.Captured.next (fun s => s = (g, g)) (!g, g) ∧
    ¬Becoming.Law.Returns Becoming.Captured.next (!g, g)
Becoming.Captured.rule_perturbation_drawn : ∀ (g : Bool),
  Becoming.Law.DrawnInto Becoming.Captured.next (fun s => s = (!g, !g)) (g, !g) ∧
    ¬Becoming.Law.Returns Becoming.Captured.next (g, !g)
@Becoming.RecurrenceRuns.lossless_iff_returns : ∀ {S : Type u_1} {next : S → S} {all : List S},
  (∀ (s : S), s ∈ all) →
    (Becoming.Branching.Lossless (Becoming.Law.process next) ↔
      ∀ (s : S), Becoming.Branching.Returns (Becoming.Law.process next) s)
@Becoming.RecurrenceRuns.merges_loses : ∀ {S : Type u_1} {next : S → S},
  Becoming.Branching.Merges (Becoming.Law.process next) →
    ∀ {all : List S},
      (∀ (s : S), s ∈ all) → ¬∀ (s : S), Becoming.Branching.Reachable (Becoming.Law.process next) all.length s
@Becoming.RecurrenceRuns.kept_lossless : ∀ {S : Type u_1} (next : S → S),
  Becoming.Branching.Lossless (Becoming.Law.process (Becoming.Law.withHistory next))
@Becoming.RecurrenceRuns.kept_never_returns : ∀ {S : Type u_1} (next : S → S) (h : S × List S),
  ¬Becoming.Branching.Returns (Becoming.Law.process (Becoming.Law.withHistory next)) h
@Becoming.RecurrenceRuns.kept_loses_beginning : ∀ {S : Type u_1} (next : S → S) (s : S) (n : Nat),
  ¬Becoming.Branching.Reachable (Becoming.Law.process (Becoming.Law.withHistory next)) (n + 1) (s, [])
@Becoming.RecurrenceRuns.kept_unlisted : ∀ {S : Type u_1} {next : S → S}
  (h : Becoming.Run (Becoming.Law.process (Becoming.Law.withHistory next))), ¬∃ l, ∀ (n : Nat), h.state n ∈ l
@Becoming.RecurrenceRuns.keptRun_present : ∀ {S : Type u_1} {next : S → S}
  (r : Becoming.Run (Becoming.Law.process next)) (past : List S) (n : Nat),
  ((Becoming.RecurrenceRuns.keptRun r past).state n).fst = r.state n
@Becoming.RecurrenceRuns.return_keeps_history : ∀ {S : Type u_1} {next : S → S}
  (r : Becoming.Run (Becoming.Law.process next)) {p : Nat},
  0 < p →
    r.state p = r.state 0 →
      ∀ (past : List S),
        ((Becoming.RecurrenceRuns.keptRun r past).state p).fst = r.state 0 ∧
          (Becoming.RecurrenceRuns.keptRun r past).state p ≠ (Becoming.RecurrenceRuns.keptRun r past).state 0
