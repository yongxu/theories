@Becoming.Flow.returning_downstream_iff_mutuallyDependent : ∀ {F C : Type} {L : Becoming.Flow F C}
  {W : Becoming.Web F C},
  (∃ c, L.ReachReturns W c) →
    (∀ (c : L.Returning W),
        Becoming.«本类至终有常» (L.Affects W) (Becoming.«后类» (L.Affects W) c.val) c.val ∧
          Becoming.«所缘同于» (L.Affects W) (Becoming.«后类» (L.Affects W) c.val) c.val) ∧
      ((∀ (c : L.Returning W) (x : F), Becoming.«所及» (L.Affects W) (Becoming.«后类» (L.Affects W) c.val) c.val x) ↔
        L.MutuallyDependent W)
@Becoming.Flow.returning_beyond_coupling : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  (obs : F → C → Prop) (c : L.Returning W) {h : F},
  ¬L.WithinCoupling W obs c.val h →
    (∀ (t : Nat), ¬Becoming.selfAscribed (Becoming.ownClosure (L.Affects W)) Subtype.val c t h) ∧
      ¬Becoming.Unrestricted (Becoming.selfAscribed (Becoming.ownClosure (L.Affects W)) Subtype.val) ∧
        Becoming.Rival (Becoming.selfAscribed (Becoming.ownClosure (L.Affects W)) Subtype.val)
@Becoming.ChoiceOccasions.selfConcerned_above_iff_reach : ∀ {X O : Type} {ch : Becoming.ChoiceOccasions (X → Bool) O}
  {items : List X} {own : X → Bool},
  Becoming.«无环» (ch.withPairs (ch.OwnWidensMet items own)).Shown →
    ∀ {x y : X → Bool},
      (∀ (P : Becoming.«际» (X → Bool)),
          (∀ (a : X → Bool), ¬P a a) →
            (∀ (a b c : X → Bool), P a b → P b c → P a c) →
              ch.Accords P → (Becoming.Weighting.IncreasingInOwnOn ch.Met items own fun b a => P a b) → P x y) ↔
        Becoming.«及» (ch.withPairs (ch.OwnWidensMet items own)).Shown x y
@Becoming.Web.extension_reached_of_met : ∀ {F C : Type} {W : Becoming.Web F C} {Pos : Type} {rel : F → F → Prop}
  {center : Pos → F},
  Becoming.Unrestricted (Becoming.selfAscribed (Becoming.ownClosure rel) center) →
    ∀ {p : Pos} {own : F → Bool},
      (∀ (f : F), Becoming.WithinClosure rel (center p) f → own f = true) →
        ∀ {admitted : (Nat → C → Nat) → Nat × F → Bool},
          W.DecidesAdmission admitted →
            ∀ {items : List (Nat × F)} {l l' : Nat → C → Nat},
              W.ListsAdmitted items l →
                W.ListsAdmitted items l' →
                  Becoming.Extension W.paths (fun x => True) l' l →
                    ∀ {O : Type} {ch : Becoming.ChoiceOccasions (Nat × F → Bool) O},
                      ch.Met (admitted l) (admitted l') →
                        Becoming.«及» (ch.withPairs (ch.OwnWidensMet items fun i => own i.snd)).Shown (admitted l)
                          (admitted l')
@Becoming.Web.extension_met_keeps_above_ending : ∀ {F C : Type} {W : Becoming.Web F C} {Pos : Type} {rel : F → F → Prop}
  {center : Pos → F},
  Becoming.Unrestricted (Becoming.selfAscribed (Becoming.ownClosure rel) center) →
    ∀ {p : Pos} {own : F → Bool},
      (∀ (f : F), Becoming.WithinClosure rel (center p) f → own f = true) →
        ∀ {admitted : (Nat → C → Nat) → Nat × F → Bool},
          W.DecidesAdmission admitted →
            ∀ {items : List (Nat × F)} {l l' : Nat → C → Nat},
              W.ListsAdmitted items l →
                W.ListsAdmitted items l' →
                  Becoming.Extension W.paths (fun x => True) l' l →
                    ∀ {O : Type} {ch : Becoming.ChoiceOccasions (Nat × F → Bool) O} {ends : (Nat × F → Bool) → Prop},
                      (∀ (a b : Nat × F → Bool),
                          ch.Met a b →
                            Becoming.Weighting.WidensOn items a b →
                              Becoming.Weighting.AddsOwn items (fun i => own i.snd) a b → ¬ends a ∧ ends b) →
                        ch.Met (admitted l) (admitted l') → ¬ends (admitted l) ∧ ends (admitted l')
Becoming.FromTheDynamics.Alternating.unit_self : ∀ (s : Bool), Becoming.FromTheDynamics.Alternating.unit s s = 1
Becoming.FromTheDynamics.Alternating.unit_other : ∀ (s : Bool), (Becoming.FromTheDynamics.Alternating.unit s !s) = 0
Becoming.FromTheDynamics.Alternating.family_eq : ∀ (t : Nat),
  Becoming.FromTheDynamics.Alternating.generations.family t = [Becoming.FromTheDynamics.Alternating.stands t]
Becoming.FromTheDynamics.Alternating.balances_at : ∀ (s c : Bool),
  Becoming.FromTheDynamics.Alternating.unit (!s) c +
      (Becoming.FromTheDynamics.Alternating.unit s s * Becoming.FromTheDynamics.Alternating.unit s c + 0) =
    Becoming.FromTheDynamics.Alternating.unit s c +
      (Becoming.FromTheDynamics.Alternating.unit s s * Becoming.FromTheDynamics.Alternating.unit (!s) c + 0)
