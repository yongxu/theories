  Becoming.FromTheDynamics.Alternating.keep
Becoming.FromTheDynamics.Alternating.noCycle : Becoming.«无环» Becoming.FromTheDynamics.Alternating.choices.Shown
Becoming.FromTheDynamics.Alternating.kept : ∀ (o : Unit),
  ¬Becoming.Weighting.EndsOwn Becoming.FromTheDynamics.Alternating.both Becoming.FromTheDynamics.Alternating.own
      (Becoming.FromTheDynamics.Alternating.choices.pick o)
Becoming.FromTheDynamics.Alternating.stake : ∀ (a b : Bool → Bool),
  Becoming.FromTheDynamics.Alternating.choices.Met a b →
    Becoming.Weighting.WidensOn Becoming.FromTheDynamics.Alternating.both a b →
      Becoming.Weighting.AddsOwn Becoming.FromTheDynamics.Alternating.both Becoming.FromTheDynamics.Alternating.own a
          b →
        ¬Becoming.Weighting.EndsOwn Becoming.FromTheDynamics.Alternating.both Becoming.FromTheDynamics.Alternating.own
              a ∧
          Becoming.Weighting.EndsOwn Becoming.FromTheDynamics.Alternating.both Becoming.FromTheDynamics.Alternating.own
            b
Becoming.FromTheDynamics.Alternating.realized : ∀ (o : Unit),
  Becoming.Weighting.EndsOwn Becoming.FromTheDynamics.Alternating.both Becoming.FromTheDynamics.Alternating.own
      (Becoming.FromTheDynamics.Alternating.choices.pick o) →
    ∃ T n,
      (∀ (k : Nat),
          k < n →
            Becoming.FromTheDynamics.Alternating.flow.replenishment Becoming.FromTheDynamics.Alternating.both (T + k) <
              Becoming.FromTheDynamics.Alternating.flow.uptake Becoming.FromTheDynamics.Alternating.both (T + k)) ∧
        Becoming.FromTheDynamics.Alternating.web.stock Becoming.FromTheDynamics.Alternating.both T < n + 1
Becoming.FromTheDynamics.Alternating.joined : (∀ (g : Bool), g ∈ Becoming.FromTheDynamics.Alternating.both) ∧
  Becoming.FromTheDynamics.Alternating.flow.Balances Becoming.FromTheDynamics.Alternating.web ∧
    Becoming.FromTheDynamics.Alternating.flow.Acting Becoming.FromTheDynamics.Alternating.web ∧
      Becoming.FromTheDynamics.Alternating.web.Dependent ∧
        Becoming.FromTheDynamics.Alternating.flow.MutuallyDependent Becoming.FromTheDynamics.Alternating.web ∧
          (∀ (c : Bool),
              Becoming.FromTheDynamics.Alternating.flow.ReachReturns Becoming.FromTheDynamics.Alternating.web c) ∧
            (∀ (c : Becoming.FromTheDynamics.Alternating.flow.Returning Becoming.FromTheDynamics.Alternating.web)
                (x : Bool),
                Becoming.«所及»
                  (Becoming.FromTheDynamics.Alternating.flow.Affects Becoming.FromTheDynamics.Alternating.web)
                  (Becoming.«后类»
                    (Becoming.FromTheDynamics.Alternating.flow.Affects Becoming.FromTheDynamics.Alternating.web) c.val)
                  c.val x) ∧
              Becoming.SelectionTerm.Flow.Descended Becoming.FromTheDynamics.Alternating.flow
                  Becoming.FromTheDynamics.Alternating.web Becoming.FromTheDynamics.Alternating.generations ∧
                Becoming.FromTheDynamics.Alternating.generations.Persists ∧
                  (∀ (b : Bool) (N : Nat), ∃ t, N ≤ t ∧ Becoming.FromTheDynamics.Alternating.stands t = b) ∧
                    (∀ (t : Nat) (y : Bool),
                        y ∈ Becoming.FromTheDynamics.Alternating.generations.family t →
                          y = Becoming.FromTheDynamics.Alternating.stands t ∧
                            Becoming.FromTheDynamics.Alternating.flow.ReachReturns
                              Becoming.FromTheDynamics.Alternating.web y) ∧
                      (∀ (T n : Nat),
                          ¬((∀ (k : Nat),
                                k < n →
                                  Becoming.FromTheDynamics.Alternating.flow.replenishment
                                      Becoming.FromTheDynamics.Alternating.both (T + k) <
                                    Becoming.FromTheDynamics.Alternating.flow.uptake
                                      Becoming.FromTheDynamics.Alternating.both (T + k)) ∧
                              Becoming.FromTheDynamics.Alternating.web.stock Becoming.FromTheDynamics.Alternating.both
                                  T <
                                n + 1)) ∧
                        (∀ (items : List (Nat × Bool)),
                            ¬Becoming.FromTheDynamics.Alternating.web.ListsAdmitted items
                                Becoming.FromTheDynamics.Alternating.web.level) ∧
                          ∃ P,
                            (∀ (a : Bool → Bool), ¬P a a) ∧
                              (∀ (a b c : Bool → Bool), P a b → P b c → P a c) ∧
                                Becoming.FromTheDynamics.Alternating.choices.Accords P ∧
                                  P Becoming.FromTheDynamics.Alternating.keep
                                      Becoming.FromTheDynamics.Alternating.drain ∧
                                    Becoming.Weighting.IncreasingInOwnOn
                                      Becoming.FromTheDynamics.Alternating.choices.Met
                                      Becoming.FromTheDynamics.Alternating.both Becoming.FromTheDynamics.Alternating.own
                                      fun b a => P a b
Becoming.FromTheDynamics.Alternating.crossed_noCycle : Becoming.«无环» Becoming.PersistingChoices.Crossed.choices.Shown
