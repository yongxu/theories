  Becoming.FromTheDynamics.Alternating.web
Becoming.FromTheDynamics.Alternating.acting : Becoming.FromTheDynamics.Alternating.flow.Acting
  Becoming.FromTheDynamics.Alternating.web
Becoming.FromTheDynamics.Alternating.dependent : Becoming.FromTheDynamics.Alternating.web.Dependent
Becoming.FromTheDynamics.Alternating.descends_at : ∀ (s : Bool),
  0 < Becoming.FromTheDynamics.Alternating.unit s s * Becoming.FromTheDynamics.Alternating.unit (!s) !s ∧
    ¬0 < Becoming.FromTheDynamics.Alternating.unit s !s ∧ 0 < Becoming.FromTheDynamics.Alternating.unit (!s) !s
Becoming.FromTheDynamics.Alternating.descended : Becoming.SelectionTerm.Flow.Descended
  Becoming.FromTheDynamics.Alternating.flow Becoming.FromTheDynamics.Alternating.web
  Becoming.FromTheDynamics.Alternating.generations
Becoming.FromTheDynamics.Alternating.member_stands : ∀ (t : Nat) (y : Bool),
  y ∈ Becoming.FromTheDynamics.Alternating.generations.family t → y = Becoming.FromTheDynamics.Alternating.stands t
Becoming.FromTheDynamics.Alternating.recurs : ∀ (b : Bool) (N : Nat),
  ∃ t, N ≤ t ∧ Becoming.FromTheDynamics.Alternating.stands t = b
Becoming.FromTheDynamics.Alternating.persists : Becoming.FromTheDynamics.Alternating.generations.Persists
Becoming.FromTheDynamics.Alternating.mem_both : ∀ (b : Bool), b ∈ Becoming.FromTheDynamics.Alternating.both
Becoming.FromTheDynamics.Alternating.gated : ∀ (t : Nat) (f : Bool),
  f ∈ Becoming.FromTheDynamics.Alternating.flow.present t →
    ∀ (d : Bool),
      d ∈ Becoming.FromTheDynamics.Alternating.both →
        0 < Becoming.FromTheDynamics.Alternating.flow.give t f d →
          ∃ e,
            e ∈ Becoming.FromTheDynamics.Alternating.both ∧
              Becoming.FromTheDynamics.Alternating.web.requires t f e ∧
                1 ≤ Becoming.FromTheDynamics.Alternating.web.need t f e
Becoming.FromTheDynamics.Alternating.coupled : ∀ (s : Nat) (p : Bool),
  p ∈ Becoming.FromTheDynamics.Alternating.generations.family s →
    ∃ e,
      e ∈ Becoming.FromTheDynamics.Alternating.both ∧
        Becoming.FromTheDynamics.Alternating.web.requires s p e ∧
          1 ≤ Becoming.FromTheDynamics.Alternating.web.need s p e
Becoming.FromTheDynamics.Alternating.dependsOn_self : ∀ (g : Bool),
  Becoming.FromTheDynamics.Alternating.web.DependsOn g g
Becoming.FromTheDynamics.Alternating.exchanges : ∀ (h c : Bool), Becoming.FromTheDynamics.Alternating.flow.Exchanges h c
Becoming.FromTheDynamics.Alternating.mutuallyDependent : Becoming.FromTheDynamics.Alternating.flow.MutuallyDependent
  Becoming.FromTheDynamics.Alternating.web
