    ¬∃ P,
        (∀ (a : Becoming.PersistingChoices.Crossed.Item → Bool), ¬P a a) ∧
          (∀ (a b c : Becoming.PersistingChoices.Crossed.Item → Bool), P a b → P b c → P a c) ∧
            Becoming.PersistingChoices.Crossed.choices.Accords P ∧
              Becoming.Weighting.IncreasingInOwn Becoming.PersistingChoices.Crossed.items
                Becoming.PersistingChoices.Crossed.own fun b a => P a b
