Becoming.KindRelay.Fed.fuel_present : ∀ (p : Bool),
  (Becoming.total (Becoming.KindRelay.presentAt p) fun x => 1) = Becoming.KindRelay.Fed.fuelNeed p
@Becoming.KindRelay.Fed.supported_iff : ∀ {t : Nat} {f : Becoming.KindRelay.Form},
  Becoming.KindRelay.Fed.web.Supported t f ↔ Becoming.KindRelay.Holds (Becoming.ClosedCycle.parity t) f
@Becoming.KindRelay.Fed.passes_iff : ∀ {t : Nat} {g f : Becoming.KindRelay.Form},
  Becoming.KindRelay.Fed.flow.PassesSupport Becoming.KindRelay.Fed.web t g f ↔
    0 < Becoming.KindRelay.giveAt (Becoming.ClosedCycle.parity t) g f
Becoming.KindRelay.Fed.runs : Becoming.KindRelay.Runs Becoming.KindRelay.Fed.web Becoming.KindRelay.Fed.flow
Becoming.KindRelay.Fed.fuel_balance : ∀ (s t : Nat),
  (Becoming.KindRelay.Fed.level (s + 1) (Sum.inr t) +
      Becoming.total (Becoming.KindRelay.presentAt (Becoming.ClosedCycle.parity s)) fun g =>
        Becoming.KindRelay.Fed.take s g (Sum.inr t)) =
    Becoming.KindRelay.Fed.level s (Sum.inr t) +
      Becoming.total (Becoming.KindRelay.presentAt (Becoming.ClosedCycle.parity s)) fun g =>
        Becoming.KindRelay.Fed.give s g (Sum.inr t)
Becoming.KindRelay.Fed.balances : Becoming.KindRelay.Fed.flow.Balances Becoming.KindRelay.Fed.web
Becoming.KindRelay.Fed.acting : Becoming.KindRelay.Fed.flow.Acting Becoming.KindRelay.Fed.web
Becoming.KindRelay.Fed.dependent : Becoming.KindRelay.Fed.web.Dependent
Becoming.KindRelay.Fed.unloosened : ∀ (t : Nat) (f : Becoming.KindRelay.Form), Becoming.KindRelay.Fed.web.Unloosened t f
Becoming.KindRelay.Fed.taking : Becoming.KindRelay.Fed.flow.Taking Becoming.KindRelay.Fed.web
Becoming.KindRelay.Fed.give_support : ∀ (s : Nat) (f : Becoming.KindRelay.Form) (a : Becoming.KindRelay.Form ⊕ Nat),
  0 < Becoming.KindRelay.Fed.give s f a →
    a ∈ List.map Sum.inl (Becoming.KindRelay.giveSupport (Becoming.ClosedCycle.parity s) f)
Becoming.KindRelay.Fed.take_support : ∀ (s : Nat) (f : Becoming.KindRelay.Form) (a : Becoming.KindRelay.Form ⊕ Nat),
  0 < Becoming.KindRelay.Fed.take s f a → a ∈ [Sum.inl f, Sum.inr s]
@Becoming.KindRelay.Fed.map_distinct : ∀ {l : List Becoming.KindRelay.Form},
  Becoming.Distinct l → Becoming.Distinct (List.map Sum.inl l)
Becoming.KindRelay.Fed.take_distinct : ∀ (s : Nat) (f : Becoming.KindRelay.Form),
  Becoming.Distinct [Sum.inl f, Sum.inr s]
Becoming.KindRelay.Fed.dissipative : Becoming.KindRelay.Fed.flow.Dissipative
Becoming.KindRelay.Fed.gainless : Becoming.KindRelay.Fed.flow.Gainless
Becoming.KindRelay.Fed.part_conserves : ∀ (p : Bool) (f : Becoming.KindRelay.Form),
  f ∈ Becoming.KindRelay.presentAt p →
    Becoming.total Becoming.KindRelay.allForms (Becoming.KindRelay.giveAt p f) =
      Becoming.total Becoming.KindRelay.allForms (Becoming.KindRelay.takeAt p f)
Becoming.KindRelay.Fed.conserving_on_part : ∀ (s : Nat),
  Becoming.KindRelay.Fed.flow.ConservingOn (List.map Sum.inl Becoming.KindRelay.allForms) s
@Becoming.KindRelay.Fed.lt_fuelBound : ∀ {l : List (Becoming.KindRelay.Form ⊕ Nat)} {t : Nat},
  Sum.inr t ∈ l → t < Becoming.KindRelay.Fed.fuelBound l
Becoming.KindRelay.Fed.not_listed : ¬∃ all, ∀ (x : Becoming.KindRelay.Form ⊕ Nat), x ∈ all
Becoming.KindRelay.Fed.keeps_widening : Becoming.KindRelay.Fed.web.KeepsWidening
  (Becoming.KindRelay.Fed.web.withinKind Becoming.KindRelay.sameKind
    (Becoming.KindRelay.Fed.flow.PassesSupport Becoming.KindRelay.Fed.web))
  Becoming.KindRelay.Fed.web.level 0
Becoming.KindRelay.Fed.requirements_not_dissipated : ¬∃ all T₀,
    (∀ (t : Nat) (f : Becoming.KindRelay.Form) (x : Becoming.KindRelay.Form ⊕ Nat),
        Becoming.KindRelay.Fed.web.requires t f x → x ∈ all) ∧
      ∀ (t : Nat), T₀ ≤ t → Becoming.KindRelay.Fed.flow.DissipatesOn all t
@Becoming.KindRelay.Fed.generation : ∀ {x : Nat × Becoming.KindRelay.Form},
  Becoming.KindRelay.Fed.web.Supported x.fst x.snd →
    Becoming.«全生成»
      (Becoming.Web.continuationStep
        (Becoming.KindRelay.Fed.web.withinKind Becoming.KindRelay.sameKind
          (Becoming.KindRelay.Fed.flow.PassesSupport Becoming.KindRelay.Fed.web)))
      (Becoming.KindRelay.Fed.web.admitting Becoming.KindRelay.Fed.web.level).activityClass
      (Becoming.KindRelay.Fed.web.admitting Becoming.KindRelay.Fed.web.level).carrierClass x
@Becoming.KindRelay.Fed.generation_one_up : ∀ {x : Nat × Becoming.KindRelay.Form},
  Becoming.KindRelay.Fed.web.Supported x.fst x.snd →
    Becoming.«全生成»
      (Becoming.Web.continuationStep
        (Becoming.Web.passingContinuation (Becoming.KindRelay.Fed.flow.PassesSupport Becoming.KindRelay.Fed.web)))
      (Becoming.KindRelay.Fed.web.admitting Becoming.KindRelay.Fed.web.level).activityClass
      ((Becoming.KindRelay.Fed.web.admitting Becoming.KindRelay.Fed.web.level).kindClass Becoming.KindRelay.sameKind) x
Becoming.KindRelay.Fed.renews_without_end : Becoming.«生生»
  (Becoming.Web.continuationStep
    (Becoming.Web.passingContinuation (Becoming.KindRelay.Fed.flow.PassesSupport Becoming.KindRelay.Fed.web)))
  ((Becoming.KindRelay.Fed.web.admitting Becoming.KindRelay.Fed.web.level).kindClass Becoming.KindRelay.sameKind)
  (0, Becoming.KindRelay.Form.a0)
Becoming.KindRelay.Fed.not_keepsWidening_byName : ∀ (T : Nat),
  ¬Becoming.KindRelay.Fed.web.KeepsWidening Becoming.Web.itself Becoming.KindRelay.Fed.web.level T
Becoming.KindRelay.Fed.not_keepsWidening_supportedPassing : ∀ (T : Nat),
  ¬Becoming.KindRelay.Fed.web.KeepsWidening
      (Becoming.KindRelay.Fed.web.supportedPassing
        (Becoming.KindRelay.Fed.flow.PassesSupport Becoming.KindRelay.Fed.web))
      Becoming.KindRelay.Fed.web.level T
Becoming.KindRelay.Fed.not_keepsWidening_dormant : ∀ (T : Nat),
  ¬Becoming.KindRelay.Fed.web.KeepsWidening
      (Becoming.Web.passingContinuation fun t g f =>
        Becoming.KindRelay.Fed.flow.PassesSupport Becoming.KindRelay.Fed.web t g f ∧ Becoming.KindRelay.sameKind g f)
      Becoming.KindRelay.Fed.web.level T
Becoming.KindRelay.Fed.returns : ∀ (t : Nat),
  (∀ (f : Becoming.KindRelay.Form),
      Becoming.KindRelay.Fed.web.level (t + 2) (Sum.inl f) = Becoming.KindRelay.Fed.web.level t (Sum.inl f)) ∧
    Becoming.KindRelay.Fed.flow.present (t + 2) = Becoming.KindRelay.Fed.flow.present t ∧
      ∀ (g f : Becoming.KindRelay.Form),
        Becoming.KindRelay.Fed.flow.give (t + 2) g (Sum.inl f) = Becoming.KindRelay.Fed.flow.give t g (Sum.inl f)
Becoming.Map.Undecided.kind_degenerates : ∀ (P : Prop) (Q : Bool → Bool → Prop),
  (∀ (y : Nat × Bool),
      Becoming.«所及» (Becoming.Web.continuationStep (Becoming.Map.Undecided.continuation P))
          (Becoming.Map.Undecided.web.kindClass Q) (0, false) y →
        y.fst = 2 → ¬Becoming.Map.Undecided.web.active y.fst y.snd) ∧
    Becoming.«退化» (Becoming.Web.continuationStep (Becoming.Map.Undecided.continuation P))
      (Becoming.Map.Undecided.web.kindClass Q) (0, false)
