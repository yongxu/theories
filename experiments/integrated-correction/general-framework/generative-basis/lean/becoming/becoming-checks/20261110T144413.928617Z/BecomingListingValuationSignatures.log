@Becoming.ListingValuation.internal_step : ∀ {W V O X H : Type} [inst : DecidableEq O]
  (rd : Becoming.ListingValuation.Reader W V O X) (hd : Becoming.ListingValuation.Holder H X)
  (x : Becoming.Blanket.Parts (List W × V) (Becoming.ListingValuation.Input O X) Bool (W × H)),
  ((Becoming.ListingValuation.joint rd hd).step x).internal = rd.update x.internal x.sensory
@Becoming.ListingValuation.active_step : ∀ {W V O X H : Type} [inst : DecidableEq O]
  (rd : Becoming.ListingValuation.Reader W V O X) (hd : Becoming.ListingValuation.Holder H X)
  (x : Becoming.Blanket.Parts (List W × V) (Becoming.ListingValuation.Input O X) Bool (W × H)),
  ((Becoming.ListingValuation.joint rd hd).step x).active = rd.answerOf (rd.update x.internal x.sensory)
@Becoming.ListingValuation.sensory_step : ∀ {W V O X H : Type} [inst : DecidableEq O]
  (rd : Becoming.ListingValuation.Reader W V O X) (hd : Becoming.ListingValuation.Holder H X)
  (x : Becoming.Blanket.Parts (List W × V) (Becoming.ListingValuation.Input O X) Bool (W × H)),
  ((Becoming.ListingValuation.joint rd hd).step x).sensory = rd.input x.external.fst (hd.act x.external.snd)
@Becoming.ListingValuation.external_step : ∀ {W V O X H : Type} [inst : DecidableEq O]
  (rd : Becoming.ListingValuation.Reader W V O X) (hd : Becoming.ListingValuation.Holder H X)
  (x : Becoming.Blanket.Parts (List W × V) (Becoming.ListingValuation.Input O X) Bool (W × H)),
  ((Becoming.ListingValuation.joint rd hd).step x).external = (x.external.fst, hd.next x.external.snd x.active)
@Becoming.ListingValuation.active_answer : ∀ {W V O X H : Type} [inst : DecidableEq O]
  (rd : Becoming.ListingValuation.Reader W V O X) (hd : Becoming.ListingValuation.Holder H X)
  (x : Becoming.Blanket.Parts (List W × V) (Becoming.ListingValuation.Input O X) Bool (W × H)) (n : Nat),
  ((Becoming.ListingValuation.joint rd hd).course x (n + 1)).active =
    rd.answerOf ((Becoming.ListingValuation.joint rd hd).course x (n + 1)).internal
@Becoming.ListingValuation.world_fixed : ∀ {W V O X H : Type} [inst : DecidableEq O]
  (rd : Becoming.ListingValuation.Reader W V O X) (hd : Becoming.ListingValuation.Holder H X)
  (x : Becoming.Blanket.Parts (List W × V) (Becoming.ListingValuation.Input O X) Bool (W × H)) (n : Nat),
  ((Becoming.ListingValuation.joint rd hd).course x n).external.fst = x.external.fst
@Becoming.ListingValuation.timing : ∀ {W V O X H : Type} [inst : DecidableEq O]
  (rd : Becoming.ListingValuation.Reader W V O X) (hd : Becoming.ListingValuation.Holder H X)
  (x : Becoming.Blanket.Parts (List W × V) (Becoming.ListingValuation.Input O X) Bool (W × H)) (t : Nat),
  ((Becoming.ListingValuation.joint rd hd).course x (t + 1)).sensory =
      rd.input x.external.fst (hd.act ((Becoming.ListingValuation.joint rd hd).course x t).external.snd) ∧
    ((Becoming.ListingValuation.joint rd hd).course x (t + 2)).internal =
        rd.update ((Becoming.ListingValuation.joint rd hd).course x (t + 1)).internal
          ((Becoming.ListingValuation.joint rd hd).course x (t + 1)).sensory ∧
      ((Becoming.ListingValuation.joint rd hd).course x (t + 2)).active =
          rd.answerOf ((Becoming.ListingValuation.joint rd hd).course x (t + 2)).internal ∧
        ((Becoming.ListingValuation.joint rd hd).course x (t + 3)).external.snd =
          hd.next ((Becoming.ListingValuation.joint rd hd).course x (t + 2)).external.snd
            ((Becoming.ListingValuation.joint rd hd).course x (t + 2)).active
@Becoming.ListingValuation.through_sensed : ∀ {W V O X H : Type} [inst : DecidableEq O]
  (rd : Becoming.ListingValuation.Reader W V O X) (hd : Becoming.ListingValuation.Holder H X)
  {x y : Becoming.Blanket.Parts (List W × V) (Becoming.ListingValuation.Input O X) Bool (W × H)},
  x.internal = y.internal →
    x.active = y.active →
      ∀ (n : Nat),
        (∀ (k : Nat),
            k < n →
              ((Becoming.ListingValuation.joint rd hd).course x k).sensory =
                ((Becoming.ListingValuation.joint rd hd).course y k).sensory) →
          ((Becoming.ListingValuation.joint rd hd).course x n).internal =
              ((Becoming.ListingValuation.joint rd hd).course y n).internal ∧
            ((Becoming.ListingValuation.joint rd hd).course x n).active =
              ((Becoming.ListingValuation.joint rd hd).course y n).active
@Becoming.ListingValuation.updates_commute : ∀ {W V O X : Type} [inst : DecidableEq O]
  (rd : Becoming.ListingValuation.Reader W V O X) (st : List W × V) (o : O) (x : X),
  rd.update (rd.update st (Becoming.ListingValuation.Input.shown o)) (Becoming.ListingValuation.Input.presented x) =
    rd.update (rd.update st (Becoming.ListingValuation.Input.presented x)) (Becoming.ListingValuation.Input.shown o)
@Becoming.ListingValuation.total_filter_shows : ∀ {W O : Type} [inst : DecidableEq O] (reveal : W → O) (o : O)
  (q : W → Nat) (L : List W),
  Becoming.total (List.filter (fun c => decide (reveal c = o)) L) q =
    Becoming.total L fun c => if reveal c = o then q c else 0
@Becoming.ListingValuation.within_one_cell : ∀ {W : Type} (pm : Becoming.HeldForReading.Model W) (f : W → Nat),
  Becoming.ListingValuation.within pm (fun x => ()) f () = Becoming.total pm.listed fun c => pm.weight c * f c
@Becoming.ListingValuation.within_shown : ∀ {W V O X : Type} [inst : DecidableEq O]
  (rd : Becoming.ListingValuation.Reader W V O X) (L : List W) (o : O) (f : W → Nat),
  Becoming.ListingValuation.within { listed := List.filter (fun c => decide (rd.reveal c = o)) L, weight := rd.weight }
      (fun x => ()) f () =
    Becoming.ListingValuation.within { listed := L, weight := rd.weight } rd.reveal f o
@Becoming.ListingValuation.answer_shown : ∀ {W V O X : Type} [inst : DecidableEq O]
  (rd : Becoming.ListingValuation.Reader W V O X) (L : List W) (v : V) (w : W),
  rd.update (L, v) (Becoming.ListingValuation.Input.shown (rd.reveal w)) =
      (List.filter (fun c => decide (rd.reveal c = rd.reveal w)) L, v) ∧
    rd.answerOf (rd.update (L, v) (Becoming.ListingValuation.Input.shown (rd.reveal w))) =
      Becoming.ListingValuation.answer { listed := L, weight := rd.weight } (rd.goVal v) (rd.offVal v) rd.reveal
        (rd.reveal w)
@Becoming.ListingValuation.shown_split : ∀ {W V O X : Type} [inst : DecidableEq O]
  (rd : Becoming.ListingValuation.Reader W V O X) (L : List W) (v : V) (m : Becoming.HeldForReading.Model W)
  (gain loss : W → Nat) {os : List O},
  List.Pairwise (fun a b => a ≠ b) os →
    (∀ (w : W), w ∈ m.listed → rd.reveal w ∈ os) →
      (Becoming.HeldForReading.shortfall m gain loss fun w =>
          rd.answerOf (rd.update (L, v) (Becoming.ListingValuation.Input.shown (rd.reveal w)))) =
        (Becoming.HeldForReading.shortfall m gain loss fun w =>
            Becoming.HeldForReading.leastThrough m gain loss rd.reveal (rd.reveal w)) +
          Becoming.ListingValuation.residual m gain loss rd.reveal os
            (Becoming.ListingValuation.answer { listed := L, weight := rd.weight } (rd.goVal v) (rd.offVal v) rd.reveal)
@Becoming.ListingValuation.shown_least_le : ∀ {W O : Type} [inst : DecidableEq O] (reveal : W → O)
  (m : Becoming.HeldForReading.Model W) (gain loss : W → Nat) {os : List O},
  List.Pairwise (fun a b => a ≠ b) os →
    (∀ (w : W), w ∈ m.listed → reveal w ∈ os) →
      (Becoming.HeldForReading.shortfall m gain loss fun w =>
          Becoming.HeldForReading.leastThrough m gain loss reveal (reveal w)) ≤
        Becoming.HeldForReading.shortfall m gain loss fun x =>
          Becoming.HeldForReading.leastThrough m gain loss (fun x => ()) ()
@Becoming.ListingValuation.shown_never_lowers : ∀ {W V O X : Type} [inst : DecidableEq O]
  (rd : Becoming.ListingValuation.Reader W V O X) (L : List W) (v : V) (gain loss : W → Nat),
  (∀ (w : W), w ∈ L → 0 < rd.weight w → rd.goVal v w + loss w = rd.offVal v w + gain w) →
    ∀ {os : List O},
      List.Pairwise (fun a b => a ≠ b) os →
        (∀ (w : W), w ∈ L → rd.reveal w ∈ os) →
          { listed := L, weight := rd.weight }.after (Becoming.HeldForReading.shifted gain loss)
              (Becoming.HeldForReading.byRule fun x => rd.answerOf (L, v)) ≤
            { listed := L, weight := rd.weight }.after (Becoming.HeldForReading.shifted gain loss)
              (Becoming.HeldForReading.byRule fun w =>
                rd.answerOf (rd.update (L, v) (Becoming.ListingValuation.Input.shown (rd.reveal w))))
@Becoming.ListingValuation.input_eq_of_reveal_eq : ∀ {W V O X : Type} (rd : Becoming.ListingValuation.Reader W V O X)
  {w w' : W}, rd.reveal w = rd.reveal w' → ∀ (act : Becoming.ListingValuation.Act X), rd.input w act = rd.input w' act
@Becoming.ListingValuation.inputs_alike_before : ∀ {W V O X H : Type} [inst : DecidableEq O]
