    (Becoming.HeldForReading.shortfall { listed := [()], weight := fun x => 1 } (fun x => 0) (fun x => 1) fun c =>
        Becoming.ListingValuation.answer { listed := [()], weight := fun x => 0 } (fun x => 0) (fun x => 1) id (id c)) =
      1
Becoming.ListingValuation.release_keeps : (Becoming.ListingValuation.SplitsKeep { listed := [()], weight := fun x => 1 }
    { listed := [()], weight := fun x => 1 } (fun x => 0) (fun x => 1) (fun x => 1) fun x => 0) ∧
  Becoming.ListingValuation.residual { listed := [()], weight := fun x => 1 } (fun x => 0) (fun x => 1) (fun x => ())
      [()]
      (Becoming.ListingValuation.answer { listed := [()], weight := fun x => 1 } (fun x => 1) (fun x => 0) fun x =>
        ()) =
    1
Becoming.ListingValuation.Informing.informing_lowers : Becoming.ListingValuation.Informing.model.after
      (Becoming.HeldForReading.shifted Becoming.ListingValuation.Informing.gain
        Becoming.ListingValuation.Informing.loss)
      (Becoming.HeldForReading.byRule fun x =>
        Becoming.ListingValuation.answer Becoming.ListingValuation.Informing.model
