Becoming.ListingValuation.ite_mul_add : ∀ (p : Prop) [inst : Decidable p] (w a b : Nat),
  (if p then w * (a + b) else 0) = (if p then w * a else 0) + if p then w * b else 0
Becoming.ListingValuation.ite_mul_left : ∀ (p : Prop) [inst : Decidable p] (w k f : Nat),
  (if p then w * (k * f) else 0) = k * if p then w * f else 0
Becoming.ListingValuation.cond_split_least : ∀ (x y : Nat) (b : Bool),
  (bif b then x else y) = (bif decide (x ≤ y) then x else y) + bif b then x - y else y - x
Becoming.ListingValuation.cond_sub_eq_zero_iff : ∀ (x y : Nat) (b : Bool),
  (bif b then x - y else y - x) = 0 ↔ (b = true → x ≤ y) ∧ (b = false → y ≤ x)
@Becoming.ListingValuation.lt_of_sub_pos_core : ∀ {m n : Nat}, 0 < n - m → m < n
Becoming.ListingValuation.cond_sub_pos_iff : ∀ (x y : Nat) (b : Bool),
  (0 < bif b then x - y else y - x) ↔ b = true ∧ y < x ∨ b = false ∧ x < y
@Becoming.ListingValuation.answer_true_iff : ∀ {C K : Type} [inst : DecidableEq K]
  (pm : Becoming.HeldForReading.Model C) (g l : C → Nat) (π : C → K) (z : K),
  Becoming.ListingValuation.answer pm g l π z = true ↔
    Becoming.ListingValuation.within pm π g z < Becoming.ListingValuation.within pm π l z
@Becoming.ListingValuation.answer_false_iff : ∀ {C K : Type} [inst : DecidableEq K]
  (pm : Becoming.HeldForReading.Model C) (g l : C → Nat) (π : C → K) (z : K),
  Becoming.ListingValuation.answer pm g l π z = false ↔
    ¬Becoming.ListingValuation.within pm π g z < Becoming.ListingValuation.within pm π l z
@Becoming.ListingValuation.goExcessWithin_eq : ∀ {C K : Type} [inst : DecidableEq K]
  (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat) (π : C → K) (z : K),
  Becoming.HeldForReading.goExcessWithin m gain loss π z =
    Becoming.ListingValuation.within m π (fun c => gain c - loss c) z
@Becoming.ListingValuation.offExcessWithin_eq : ∀ {C K : Type} [inst : DecidableEq K]
  (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat) (π : C → K) (z : K),
  Becoming.HeldForReading.offExcessWithin m gain loss π z =
    Becoming.ListingValuation.within m π (fun c => loss c - gain c) z
@Becoming.ListingValuation.within_add : ∀ {C K : Type} [inst : DecidableEq K] (pm : Becoming.HeldForReading.Model C)
  (π : C → K) (f h : C → Nat) (z : K),
  Becoming.ListingValuation.within pm π (fun c => f c + h c) z =
    Becoming.ListingValuation.within pm π f z + Becoming.ListingValuation.within pm π h z
@Becoming.ListingValuation.within_mul : ∀ {C K : Type} [inst : DecidableEq K] (pm : Becoming.HeldForReading.Model C)
  (π : C → K) (k : Nat) (f : C → Nat) (z : K),
  Becoming.ListingValuation.within pm π (fun c => k * f c) z = k * Becoming.ListingValuation.within pm π f z
@Becoming.ListingValuation.within_congr_weighted : ∀ {C K : Type} [inst : DecidableEq K]
  (pm : Becoming.HeldForReading.Model C) (π : C → K) {f h : C → Nat},
  (∀ (c : C), c ∈ pm.listed → 0 < pm.weight c → f c = h c) →
    ∀ (z : K), Becoming.ListingValuation.within pm π f z = Becoming.ListingValuation.within pm π h z
@Becoming.ListingValuation.within_turn : ∀ {C K : Type} [inst : DecidableEq K] (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) (π : C → K) (z : K),
  Becoming.ListingValuation.within m π loss z + Becoming.HeldForReading.goExcessWithin m gain loss π z =
    Becoming.ListingValuation.within m π gain z + Becoming.HeldForReading.offExcessWithin m gain loss π z
@Becoming.ListingValuation.shortfall_split : ∀ {C K : Type} [inst : DecidableEq K] (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) (π : C → K) {zs : List K},
  List.Pairwise (fun a b => a ≠ b) zs →
    (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
      ∀ (s : K → Bool),
        (Becoming.HeldForReading.shortfall m gain loss fun c => s (π c)) =
          (Becoming.HeldForReading.shortfall m gain loss fun c =>
              Becoming.HeldForReading.leastThrough m gain loss π (π c)) +
            Becoming.ListingValuation.residual m gain loss π zs s
@Becoming.ListingValuation.residual_zero_iff : ∀ {C K : Type} [inst : DecidableEq K]
  (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat) (π : C → K) (zs : List K) (s : K → Bool),
  Becoming.ListingValuation.residual m gain loss π zs s = 0 ↔
    ∀ (z : K),
      z ∈ zs →
        (s z = true →
            Becoming.HeldForReading.goExcessWithin m gain loss π z ≤
              Becoming.HeldForReading.offExcessWithin m gain loss π z) ∧
          (s z = false →
            Becoming.HeldForReading.offExcessWithin m gain loss π z ≤
              Becoming.HeldForReading.goExcessWithin m gain loss π z)
@Becoming.ListingValuation.residual_pos_iff : ∀ {C K : Type} [inst : DecidableEq K]
  (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat) (π : C → K) (zs : List K) (s : K → Bool),
  0 < Becoming.ListingValuation.residual m gain loss π zs s ↔
    ∃ z,
      z ∈ zs ∧
        (s z = true ∧
            Becoming.HeldForReading.offExcessWithin m gain loss π z <
              Becoming.HeldForReading.goExcessWithin m gain loss π z ∨
          s z = false ∧
            Becoming.HeldForReading.goExcessWithin m gain loss π z <
              Becoming.HeldForReading.offExcessWithin m gain loss π z)
@Becoming.ListingValuation.unweighted_cell : ∀ {C K : Type} [inst : DecidableEq K] (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) (π : C → K) {z : K},
  (∀ (c : C), c ∈ m.listed → π c = z → m.weight c = 0) →
    Becoming.HeldForReading.goExcessWithin m gain loss π z = 0 ∧
      Becoming.HeldForReading.offExcessWithin m gain loss π z = 0 ∧
        ∀ (b : Bool),
          (bif b then
              Becoming.HeldForReading.goExcessWithin m gain loss π z -
                Becoming.HeldForReading.offExcessWithin m gain loss π z
            else
              Becoming.HeldForReading.offExcessWithin m gain loss π z -
                Becoming.HeldForReading.goExcessWithin m gain loss π z) =
            0
@Becoming.ListingValuation.answer_residual_zero_iff : ∀ {C K : Type} [inst : DecidableEq K]
  (m pm : Becoming.HeldForReading.Model C) (gain loss g l : C → Nat) (π : C → K) (zs : List K),
  Becoming.ListingValuation.residual m gain loss π zs (Becoming.ListingValuation.answer pm g l π) = 0 ↔
    ∀ (z : K),
      z ∈ zs →
        (Becoming.ListingValuation.within pm π g z < Becoming.ListingValuation.within pm π l z →
            Becoming.HeldForReading.goExcessWithin m gain loss π z ≤
              Becoming.HeldForReading.offExcessWithin m gain loss π z) ∧
          (¬Becoming.ListingValuation.within pm π g z < Becoming.ListingValuation.within pm π l z →
            Becoming.HeldForReading.offExcessWithin m gain loss π z ≤
              Becoming.HeldForReading.goExcessWithin m gain loss π z)
@Becoming.ListingValuation.answer_least_of_scaled : ∀ {C K : Type} [inst : DecidableEq K]
  (m : Becoming.HeldForReading.Model C) (gain loss g l : C → Nat) (π : C → K) (zs : List K) {p q : Nat},
  0 < p →
    0 < q →
      (∀ (c : C), c ∈ m.listed → 0 < m.weight c → q * g c + p * loss c = q * l c + p * gain c) →
        Becoming.ListingValuation.residual m gain loss π zs (Becoming.ListingValuation.answer m g l π) = 0
@Becoming.ListingValuation.answer_least_of_net : ∀ {C K : Type} [inst : DecidableEq K]
  (m : Becoming.HeldForReading.Model C) (gain loss g l : C → Nat) (π : C → K) (zs : List K),
  (∀ (c : C), c ∈ m.listed → 0 < m.weight c → g c + loss c = l c + gain c) →
    Becoming.ListingValuation.residual m gain loss π zs (Becoming.ListingValuation.answer m g l π) = 0
@Becoming.ListingValuation.after_le_iff_shortfall : ∀ {C : Type} (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) (r r' : C → Bool),
  m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) ≤
      m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r') ↔
    Becoming.HeldForReading.shortfall m gain loss r' ≤ Becoming.HeldForReading.shortfall m gain loss r
@Becoming.ListingValuation.after_lt_iff_shortfall : ∀ {C : Type} (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) (r r' : C → Bool),
  m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) <
      m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r') ↔
    Becoming.HeldForReading.shortfall m gain loss r' < Becoming.HeldForReading.shortfall m gain loss r
@Becoming.ListingValuation.const_worth : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r : C → Bool) (b : Bool),
  (∀ (c : C), c ∈ m.listed → r c = b) →
    m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) =
      m.committed (Becoming.HeldForReading.shifted gain loss)
        (bif b then Becoming.HeldForReading.Move.off else Becoming.HeldForReading.Move.go)
@Becoming.ListingValuation.weightOf_pos_iff : ∀ {C : Type} [inst : DecidableEq C] (pm : Becoming.HeldForReading.Model C)
  (c : C), 0 < Becoming.ListingValuation.weightOf pm c ↔ c ∈ pm.listed ∧ 0 < pm.weight c
@Becoming.ListingValuation.within_id : ∀ {C : Type} [inst : DecidableEq C] (pm : Becoming.HeldForReading.Model C)
  (f : C → Nat) (c : C), Becoming.ListingValuation.within pm id f c = f c * Becoming.ListingValuation.weightOf pm c
@Becoming.ListingValuation.unweighted_released : ∀ {C : Type} [inst : DecidableEq C]
  (pm : Becoming.HeldForReading.Model C) (g l : C → Nat) (z : C),
  Becoming.ListingValuation.weightOf pm z = 0 →
    ¬Becoming.ListingValuation.within pm id g z < Becoming.ListingValuation.within pm id l z
@Becoming.ListingValuation.weighed_stops_iff : ∀ {C : Type} [inst : DecidableEq C]
  (pm : Becoming.HeldForReading.Model C) (gain loss g l : C → Nat),
  (∀ (c : C), c ∈ pm.listed → 0 < pm.weight c → g c + loss c = l c + gain c) →
    ∀ (z : C),
      0 < Becoming.ListingValuation.weightOf pm z →
        (Becoming.ListingValuation.within pm id g z < Becoming.ListingValuation.within pm id l z ↔ gain z < loss z)
@Becoming.ListingValuation.told_residual_zero_iff : ∀ {C : Type} [inst : DecidableEq C]
  (m pm : Becoming.HeldForReading.Model C) (gain loss g l : C → Nat) {zs : List C},
  (∀ (c : C), c ∈ m.listed → c ∈ zs) →
    (∀ (c : C), c ∈ pm.listed → 0 < pm.weight c → g c + loss c = l c + gain c) →
      (Becoming.ListingValuation.residual m gain loss id zs (Becoming.ListingValuation.answer pm g l id) = 0 ↔
        ∀ (c : C), c ∈ m.listed → 0 < m.weight c → gain c < loss c → 0 < Becoming.ListingValuation.weightOf pm c)
@Becoming.ListingValuation.told_shortfall_zero_iff : ∀ {C : Type} [inst : DecidableEq C]
  (m pm : Becoming.HeldForReading.Model C) (gain loss g l : C → Nat),
  (∀ (c : C), c ∈ pm.listed → 0 < pm.weight c → g c + loss c = l c + gain c) →
    (Becoming.HeldForReading.shortfall m gain loss (Becoming.ListingValuation.answer pm g l id) = 0 ↔
      ∀ (c : C), c ∈ m.listed → 0 < m.weight c → gain c < loss c → 0 < Becoming.ListingValuation.weightOf pm c)
@Becoming.ListingValuation.shortfall_congr_on : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  {r r' : C → Bool},
  (∀ (c : C), c ∈ m.listed → r c = r' c) →
    Becoming.HeldForReading.shortfall m gain loss r = Becoming.HeldForReading.shortfall m gain loss r'
@Becoming.ListingValuation.least_falls : ∀ {C K L : Type} [inst : DecidableEq K] [inst_1 : DecidableEq L]
  (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat) (π : C → K) (π' : C → L) (f : L → K),
  (∀ (c : C), c ∈ m.listed → π c = f (π' c)) →
    ∀ {zs' : List L},
      List.Pairwise (fun a b => a ≠ b) zs' →
        (∀ (c : C), c ∈ m.listed → π' c ∈ zs') →
          (Becoming.HeldForReading.shortfall m gain loss fun c =>
              Becoming.HeldForReading.leastThrough m gain loss π' (π' c)) ≤
            Becoming.HeldForReading.shortfall m gain loss fun c =>
              Becoming.HeldForReading.leastThrough m gain loss π (π c)
@Becoming.ListingValuation.informed_le : ∀ {C K L : Type} [inst : DecidableEq L] (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) (π : C → K) (π' : C → L) (f : L → K),
  (∀ (c : C), c ∈ m.listed → π c = f (π' c)) →
    ∀ {zs' : List L},
      List.Pairwise (fun a b => a ≠ b) zs' →
        (∀ (c : C), c ∈ m.listed → π' c ∈ zs') →
          ∀ (s' : L → Bool),
            Becoming.ListingValuation.residual m gain loss π' zs' s' = 0 →
              ∀ (s : K → Bool),
                ((Becoming.HeldForReading.shortfall m gain loss fun c => s' (π' c)) ≤
                    Becoming.HeldForReading.shortfall m gain loss fun c => s (π c)) ∧
                  m.after (Becoming.HeldForReading.shifted gain loss)
                      (Becoming.HeldForReading.byRule fun c => s (π c)) ≤
                    m.after (Becoming.HeldForReading.shifted gain loss)
                      (Becoming.HeldForReading.byRule fun c => s' (π' c))
@Becoming.ListingValuation.informed_answer_le : ∀ {C K L : Type} [inst : DecidableEq L]
  (m : Becoming.HeldForReading.Model C) (gain loss g l : C → Nat),
  (∀ (c : C), c ∈ m.listed → 0 < m.weight c → g c + loss c = l c + gain c) →
    ∀ (π : C → K) (π' : C → L) (f : L → K),
      (∀ (c : C), c ∈ m.listed → π c = f (π' c)) →
        ∀ {zs' : List L},
          List.Pairwise (fun a b => a ≠ b) zs' →
            (∀ (c : C), c ∈ m.listed → π' c ∈ zs') →
              ∀ (s : K → Bool),
                m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule fun c => s (π c)) ≤
                  m.after (Becoming.HeldForReading.shifted gain loss)
                    (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer m g l π' (π' c))
@Becoming.ListingValuation.informed_le_add_residual : ∀ {C K L : Type} [inst : DecidableEq L]
  (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat) (π : C → K) (π' : C → L) (f : L → K),
  (∀ (c : C), c ∈ m.listed → π c = f (π' c)) →
    ∀ {zs' : List L},
      List.Pairwise (fun a b => a ≠ b) zs' →
        (∀ (c : C), c ∈ m.listed → π' c ∈ zs') →
          ∀ (s' : L → Bool) (s : K → Bool),
            m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule fun c => s (π c)) ≤
              m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule fun c => s' (π' c)) +
                Becoming.ListingValuation.residual m gain loss π' zs' s'
@Becoming.ListingValuation.informed_lt_iff : ∀ {C K L : Type} [inst : DecidableEq K] [inst_1 : DecidableEq L]
  (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat) (π : C → K) (π' : C → L) (f : L → K),
  (∀ (c : C), c ∈ m.listed → π c = f (π' c)) →
    ∀ {zs : List K} {zs' : List L},
      List.Pairwise (fun a b => a ≠ b) zs →
        (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
          List.Pairwise (fun a b => a ≠ b) zs' →
            (∀ (c : C), c ∈ m.listed → π' c ∈ zs') →
              ∀ (s' : L → Bool),
                Becoming.ListingValuation.residual m gain loss π' zs' s' = 0 →
                  ∀ (s : K → Bool),
                    m.after (Becoming.HeldForReading.shifted gain loss)
                          (Becoming.HeldForReading.byRule fun c => s (π c)) <
                        m.after (Becoming.HeldForReading.shifted gain loss)
                          (Becoming.HeldForReading.byRule fun c => s' (π' c)) ↔
                      ((Becoming.HeldForReading.shortfall m gain loss fun c =>
                            Becoming.HeldForReading.leastThrough m gain loss π' (π' c)) <
                          Becoming.HeldForReading.shortfall m gain loss fun c =>
                            Becoming.HeldForReading.leastThrough m gain loss π (π c)) ∨
                        0 < Becoming.ListingValuation.residual m gain loss π zs s
@Becoming.ListingValuation.forgone_lt_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r r' : C → Bool) (k k' : Nat),
  m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r') + k <
      m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) + k' ↔
    Becoming.HeldForReading.shortfall m gain loss r + k < Becoming.HeldForReading.shortfall m gain loss r' + k'
@Becoming.ListingValuation.forgone_through_lt_iff : ∀ {C K L : Type} [inst : DecidableEq K] [inst_1 : DecidableEq L]
  (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat) (π : C → K) (π' : C → L) {zs : List K} {zs' : List L},
  List.Pairwise (fun a b => a ≠ b) zs →
    (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
      List.Pairwise (fun a b => a ≠ b) zs' →
        (∀ (c : C), c ∈ m.listed → π' c ∈ zs') →
          ∀ (s : K → Bool) (s' : L → Bool) (k k' : Nat),
            m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule fun c => s' (π' c)) +
                  k <
                m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule fun c => s (π c)) +
                  k' ↔
              (Becoming.HeldForReading.shortfall m gain loss fun c =>
                      Becoming.HeldForReading.leastThrough m gain loss π (π c)) +
                    Becoming.ListingValuation.residual m gain loss π zs s +
                  k <
                (Becoming.HeldForReading.shortfall m gain loss fun c =>
                      Becoming.HeldForReading.leastThrough m gain loss π' (π' c)) +
                    Becoming.ListingValuation.residual m gain loss π' zs' s' +
                  k'
@Becoming.ListingValuation.add_lt_iff_sub_add_lt : ∀ {a a' r r' k : Nat},
  a' ≤ a → (a + r + k < a' + r' + k ↔ a - a' + r < r')
@Becoming.ListingValuation.refined_lt_iff : ∀ {C K L : Type} [inst : DecidableEq K] [inst_1 : DecidableEq L]
  (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat) (π : C → K) (π' : C → L) (f : L → K),
  (∀ (c : C), c ∈ m.listed → π c = f (π' c)) →
    ∀ {zs : List K} {zs' : List L},
      List.Pairwise (fun a b => a ≠ b) zs →
        (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
          List.Pairwise (fun a b => a ≠ b) zs' →
            (∀ (c : C), c ∈ m.listed → π' c ∈ zs') →
              ∀ (s : K → Bool) (s' : L → Bool) (k : Nat),
                m.after (Becoming.HeldForReading.shifted gain loss)
                        (Becoming.HeldForReading.byRule fun c => s' (π' c)) +
                      k <
                    m.after (Becoming.HeldForReading.shifted gain loss)
                        (Becoming.HeldForReading.byRule fun c => s (π c)) +
                      k ↔
                  ((Becoming.HeldForReading.shortfall m gain loss fun c =>
                          Becoming.HeldForReading.leastThrough m gain loss π (π c)) -
                        Becoming.HeldForReading.shortfall m gain loss fun c =>
                          Becoming.HeldForReading.leastThrough m gain loss π' (π' c)) +
                      Becoming.ListingValuation.residual m gain loss π zs s <
                    Becoming.ListingValuation.residual m gain loss π' zs' s'
@Becoming.ListingValuation.forgone_least_iff : ∀ {C K L : Type} [inst : DecidableEq K] [inst_1 : DecidableEq L]
  (m : Becoming.HeldForReading.Model C) (gain loss g l : C → Nat),
  (∀ (c : C), c ∈ m.listed → 0 < m.weight c → g c + loss c = l c + gain c) →
    ∀ (π : C → K) (π' : C → L) {zs : List K} {zs' : List L},
      List.Pairwise (fun a b => a ≠ b) zs →
        (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
          List.Pairwise (fun a b => a ≠ b) zs' →
            (∀ (c : C), c ∈ m.listed → π' c ∈ zs') →
              ∀ (k k' : Nat),
                m.after (Becoming.HeldForReading.shifted gain loss)
                        (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer m g l π' (π' c)) +
                      k <
                    m.after (Becoming.HeldForReading.shifted gain loss)
                        (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer m g l π (π c)) +
                      k' ↔
                  (Becoming.HeldForReading.shortfall m gain loss fun c =>
                        Becoming.HeldForReading.leastThrough m gain loss π (π c)) +
                      k <
                    (Becoming.HeldForReading.shortfall m gain loss fun c =>
                        Becoming.HeldForReading.leastThrough m gain loss π' (π' c)) +
                      k'
@Becoming.ListingValuation.coarser_not_above : ∀ {C K L : Type} [inst : DecidableEq K] [inst_1 : DecidableEq L]
  (m : Becoming.HeldForReading.Model C) (gain loss g l : C → Nat),
  (∀ (c : C), c ∈ m.listed → 0 < m.weight c → g c + loss c = l c + gain c) →
    ∀ (π : C → K) (π' : C → L) (f : L → K),
      (∀ (c : C), c ∈ m.listed → π c = f (π' c)) →
        ∀ {zs : List K} {zs' : List L},
          List.Pairwise (fun a b => a ≠ b) zs →
            (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
              List.Pairwise (fun a b => a ≠ b) zs' →
                (∀ (c : C), c ∈ m.listed → π' c ∈ zs') →
                  ∀ {k k' : Nat},
                    k' ≤ k →
                      ¬m.after (Becoming.HeldForReading.shifted gain loss)
                              (Becoming.HeldForReading.byRule fun c =>
                                Becoming.ListingValuation.answer m g l π' (π' c)) +
                            k <
                          m.after (Becoming.HeldForReading.shifted gain loss)
                              (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer m g l π (π c)) +
                            k'
@Becoming.ListingValuation.answer_shortfall_least : ∀ {C K : Type} [inst : DecidableEq K]
  (m : Becoming.HeldForReading.Model C) (gain loss g l : C → Nat) (π : C → K) {zs : List K},
  List.Pairwise (fun a b => a ≠ b) zs →
    (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
      (∀ (c : C), c ∈ m.listed → 0 < m.weight c → g c + loss c = l c + gain c) →
        (Becoming.HeldForReading.shortfall m gain loss fun c => Becoming.ListingValuation.answer m g l π (π c)) =
          Becoming.HeldForReading.shortfall m gain loss fun c =>
            Becoming.HeldForReading.leastThrough m gain loss π (π c)
@Becoming.ListingValuation.revalued_split : ∀ {C K : Type} [inst : DecidableEq K]
  (m pm : Becoming.HeldForReading.Model C) (gain loss g l g' l' : C → Nat) (π : C → K) {zs : List K},
  List.Pairwise (fun a b => a ≠ b) zs →
    (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
      (Becoming.HeldForReading.shortfall m gain loss fun c => Becoming.ListingValuation.answer pm g l π (π c)) +
          Becoming.ListingValuation.residual m gain loss π zs (Becoming.ListingValuation.answer pm g' l' π) =
        (Becoming.HeldForReading.shortfall m gain loss fun c => Becoming.ListingValuation.answer pm g' l' π (π c)) +
          Becoming.ListingValuation.residual m gain loss π zs (Becoming.ListingValuation.answer pm g l π)
@Becoming.ListingValuation.own_least : ∀ {C K : Type} [inst : DecidableEq K] (m : Becoming.HeldForReading.Model C)
  (g l : C → Nat) (π : C → K) {zs : List K},
  List.Pairwise (fun a b => a ≠ b) zs →
    (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
      ∀ (s : K → Bool),
        m.after (Becoming.HeldForReading.shifted g l) (Becoming.HeldForReading.byRule fun c => s (π c)) ≤
          m.after (Becoming.HeldForReading.shifted g l)
            (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer m g l π (π c))
@Becoming.ListingValuation.revalued_lowers_iff : ∀ {C K : Type} [inst : DecidableEq K]
  (m : Becoming.HeldForReading.Model C) (g l g' l' : C → Nat) (π : C → K) {zs : List K},
  List.Pairwise (fun a b => a ≠ b) zs →
    (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
      (m.after (Becoming.HeldForReading.shifted g l)
            (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer m g' l' π (π c)) <
          m.after (Becoming.HeldForReading.shifted g l)
            (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer m g l π (π c)) ↔
        ∃ z,
          z ∈ zs ∧
            (Becoming.ListingValuation.answer m g' l' π z = true ∧
                Becoming.HeldForReading.offExcessWithin m g l π z < Becoming.HeldForReading.goExcessWithin m g l π z ∨
              Becoming.ListingValuation.answer m g' l' π z = false ∧
                Becoming.HeldForReading.goExcessWithin m g l π z < Becoming.HeldForReading.offExcessWithin m g l π z))
@Becoming.ListingValuation.outcome_least : ∀ {C K : Type} [inst : DecidableEq K] (m : Becoming.HeldForReading.Model C)
  (g' l' : C → Nat) (π : C → K) (zs : List K),
  Becoming.ListingValuation.residual m g' l' π zs (Becoming.ListingValuation.answer m g' l' π) = 0
@Becoming.ListingValuation.residual_pos_of_gains : ∀ {C K : Type} [inst : DecidableEq K]
  (m pm : Becoming.HeldForReading.Model C) (gain loss g l : C → Nat) (π : C → K) {zs : List K},
  List.Pairwise (fun a b => a ≠ b) zs →
    (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
      (∃ g' l',
          m.after (Becoming.HeldForReading.shifted gain loss)
              (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer pm g l π (π c)) <
            m.after (Becoming.HeldForReading.shifted gain loss)
              (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer pm g' l' π (π c))) →
        0 < Becoming.ListingValuation.residual m gain loss π zs (Becoming.ListingValuation.answer pm g l π)
@Becoming.ListingValuation.revaluing_gains_iff : ∀ {C K : Type} [inst : DecidableEq K]
  (m : Becoming.HeldForReading.Model C) (gain loss g l : C → Nat) (π : C → K) {zs : List K},
  List.Pairwise (fun a b => a ≠ b) zs →
    (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
      ((∃ g' l',
          m.after (Becoming.HeldForReading.shifted gain loss)
              (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer m g l π (π c)) <
            m.after (Becoming.HeldForReading.shifted gain loss)
              (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer m g' l' π (π c))) ↔
        0 < Becoming.ListingValuation.residual m gain loss π zs (Becoming.ListingValuation.answer m g l π))
@Becoming.ListingValuation.revaluing_gain : ∀ {C K : Type} [inst : DecidableEq K] (m : Becoming.HeldForReading.Model C)
  (gain loss g l : C → Nat) (π : C → K) {zs : List K},
  List.Pairwise (fun a b => a ≠ b) zs →
    (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
      m.after (Becoming.HeldForReading.shifted gain loss)
            (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer m g l π (π c)) +
          Becoming.ListingValuation.residual m gain loss π zs (Becoming.ListingValuation.answer m g l π) =
        m.after (Becoming.HeldForReading.shifted gain loss)
          (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer m gain loss π (π c))
@Becoming.ListingValuation.revalued_forgone_lt_iff : ∀ {C K : Type} [inst : DecidableEq K]
  (m pm : Becoming.HeldForReading.Model C) (gain loss g l g' l' : C → Nat) (π : C → K) {zs : List K},
  List.Pairwise (fun a b => a ≠ b) zs →
    (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
      ∀ (k k' : Nat),
        m.after (Becoming.HeldForReading.shifted gain loss)
                (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer pm g l π (π c)) +
              k' <
            m.after (Becoming.HeldForReading.shifted gain loss)
                (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer pm g' l' π (π c)) +
              k ↔
          Becoming.ListingValuation.residual m gain loss π zs (Becoming.ListingValuation.answer pm g' l' π) + k' <
            Becoming.ListingValuation.residual m gain loss π zs (Becoming.ListingValuation.answer pm g l π) + k
@Becoming.ListingValuation.const_below_iff : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r : C → Bool) (b : Bool),
  (∀ (c : C), c ∈ m.listed → r c = b) →
    ∀ (k : Nat),
      m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) <
          m.committed (Becoming.HeldForReading.shifted gain loss)
              (bif b then Becoming.HeldForReading.Move.off else Becoming.HeldForReading.Move.go) +
            k ↔
        0 < k
@Becoming.ListingValuation.one_cell_worth : ∀ {C : Type} (m pm : Becoming.HeldForReading.Model C)
  (gain loss g l : C → Nat),
  m.after (Becoming.HeldForReading.shifted gain loss)
      (Becoming.HeldForReading.byRule fun x => Becoming.ListingValuation.answer pm g l (fun x => ()) ()) =
    m.committed (Becoming.HeldForReading.shifted gain loss)
      (bif Becoming.ListingValuation.answer pm g l (fun x => ()) () then Becoming.HeldForReading.Move.off
      else Becoming.HeldForReading.Move.go)
@Becoming.ListingValuation.after_rule_total : ∀ {C : Type} (m : Becoming.HeldForReading.Model C) (gain loss : C → Nat)
  (r : C → Bool),
  m.after (Becoming.HeldForReading.shifted gain loss) (Becoming.HeldForReading.byRule r) =
    Becoming.total m.listed fun c => bif r c then m.weight c * loss c else m.weight c * gain c
@Becoming.ListingValuation.total_cond_by_cells : ∀ {C K : Type} [inst : DecidableEq K]
  (m : Becoming.HeldForReading.Model C) (π : C → K) {zs : List K},
  List.Pairwise (fun a b => a ≠ b) zs →
    (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
      ∀ (s : K → Bool) (x y : C → Nat),
        (Becoming.total m.listed fun c => bif s (π c) then x c else y c) =
          Becoming.total zs fun z =>
            bif s z then Becoming.total m.listed fun c => if π c = z then x c else 0
            else Becoming.total m.listed fun c => if π c = z then y c else 0
Becoming.ListingValuation.ite_split_rule : ∀ (p : Prop) [inst : Decidable p] (b : Bool) (v : Nat),
  (if p then v else 0) = (bif decide p && !b then v else 0) + bif decide p && b then v else 0
Becoming.ListingValuation.ite_cond_split : ∀ (p : Prop) [inst : Decidable p] (b : Bool) (x y : Nat),
  (if p then bif b then x else y else 0) = (bif decide p && b then x else 0) + bif decide p && !b then y else 0
@Becoming.ListingValuation.within_split : ∀ {C K : Type} [inst : DecidableEq K] (pm : Becoming.HeldForReading.Model C)
  (π : C → K) (t : C → Bool) (h : C → Nat) (z : K),
  Becoming.ListingValuation.within pm π h z =
    Becoming.ListingValuation.weightedOn pm (fun c => decide (π c = z) && !t c) h +
      Becoming.ListingValuation.weightedOn pm (fun c => decide (π c = z) && t c) h
@Becoming.ListingValuation.within_rule_split : ∀ {C K : Type} [inst : DecidableEq K]
  (m : Becoming.HeldForReading.Model C) (π : C → K) (t : C → Bool) (x y : C → Nat) (z : K),
  (Becoming.total m.listed fun c => if π c = z then bif t c then m.weight c * x c else m.weight c * y c else 0) =
    Becoming.ListingValuation.weightedOn m (fun c => decide (π c = z) && t c) x +
      Becoming.ListingValuation.weightedOn m (fun c => decide (π c = z) && !t c) y
@Becoming.ListingValuation.weightedOn_by_cells : ∀ {C L : Type} [inst : DecidableEq L]
  (pm : Becoming.HeldForReading.Model C) (π' : C → L) {zs' : List L},
  List.Pairwise (fun a b => a ≠ b) zs' →
    (∀ (c : C), c ∈ pm.listed → π' c ∈ zs') →
      ∀ {B : C → Bool} {t : L → Bool},
        (∀ (c : C), c ∈ pm.listed → B c = t (π' c)) →
          ∀ (h : C → Nat),
            Becoming.ListingValuation.weightedOn pm B h =
              Becoming.total zs' fun y => bif t y then Becoming.ListingValuation.within pm π' h y else 0
@Becoming.ListingValuation.total_lt_of_mem : ∀ {α : Type} {p q : α → Nat} {a : α} {as : List α},
  (∀ (b : α), b ∈ as → p b ≤ q b) → a ∈ as → p a < q a → Becoming.total as p < Becoming.total as q
@Becoming.ListingValuation.split_cell_le : ∀ {BL DL BG DG : Nat} {b : Bool},
  (b = false → DG ≤ DL) → (b = true → BL ≤ BG) → (bif b then BL + DL else BG + DG) ≤ DL + BG
@Becoming.ListingValuation.cell_refined_le : ∀ {C K L : Type} [inst : DecidableEq K] [inst_1 : DecidableEq L]
  (m pm : Becoming.HeldForReading.Model C) (gain loss g l : C → Nat),
  Becoming.ListingValuation.SplitsKeep m pm gain loss g l →
    ∀ (π : C → K) (π' : C → L) (f : L → K) {zs' : List L},
      (∀ (c : C), c ∈ m.listed → π c = f (π' c)) →
        (∀ (c : C), c ∈ pm.listed → π c = f (π' c)) →
          List.Pairwise (fun a b => a ≠ b) zs' →
            (∀ (c : C), c ∈ m.listed → π' c ∈ zs') →
              (∀ (c : C), c ∈ pm.listed → π' c ∈ zs') →
                ∀ (z : K),
                  (bif Becoming.ListingValuation.answer pm g l π z then Becoming.ListingValuation.within m π loss z
                    else Becoming.ListingValuation.within m π gain z) ≤
                    Becoming.total m.listed fun c =>
                      if π c = z then
                        bif Becoming.ListingValuation.answer pm g l π' (π' c) then m.weight c * loss c
                        else m.weight c * gain c
                      else 0
@Becoming.ListingValuation.refined_le_of_splitsKeep : ∀ {C K L : Type} [inst : DecidableEq K] [inst_1 : DecidableEq L]
  (m pm : Becoming.HeldForReading.Model C) (gain loss g l : C → Nat),
  Becoming.ListingValuation.SplitsKeep m pm gain loss g l →
    ∀ (π : C → K) (π' : C → L) (f : L → K) {zs : List K} {zs' : List L},
      (∀ (c : C), c ∈ m.listed → π c = f (π' c)) →
        (∀ (c : C), c ∈ pm.listed → π c = f (π' c)) →
          List.Pairwise (fun a b => a ≠ b) zs →
            (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
              List.Pairwise (fun a b => a ≠ b) zs' →
                (∀ (c : C), c ∈ m.listed → π' c ∈ zs') →
                  (∀ (c : C), c ∈ pm.listed → π' c ∈ zs') →
                    m.after (Becoming.HeldForReading.shifted gain loss)
                        (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer pm g l π (π c)) ≤
                      m.after (Becoming.HeldForReading.shifted gain loss)
                        (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer pm g l π' (π' c))
Becoming.ListingValuation.either_which : ∀ (bB bD : Bool),
  (bif bB || bD then 0 else 1) = (bif bB then 0 else bif bD then 1 else 2) - 1
Becoming.ListingValuation.either_mem : ∀ (bB bD : Bool), (bif bB || bD then 0 else 1) ∈ [0, 1]
Becoming.ListingValuation.which_mem : ∀ (bB bD : Bool), (bif bB then 0 else bif bD then 1 else 2) ∈ [0, 1, 2]
Becoming.ListingValuation.which_first : ∀ (v : Nat) (bB bD : Bool),
  (if (bif bB then 0 else bif bD then 1 else 2) = 0 then v else 0) = bif bB then v else 0
Becoming.ListingValuation.which_second : ∀ (v : Nat) (bB bD : Bool),
  (bB = true → bD = false) → (if (bif bB then 0 else bif bD then 1 else 2) = 1 then v else 0) = bif bD then v else 0
Becoming.ListingValuation.either_both : ∀ (v : Nat) (bB bD : Bool),
  (bB = true → bD = false) →
    (if (bif bB || bD then 0 else 1) = 0 then v else 0) = (bif bB then v else 0) + bif bD then v else 0
Becoming.ListingValuation.either_neither : ∀ (v : Nat) (bB bD : Bool),
  (if (bif bB || bD then 0 else 1) = 1 then v else 0) = if (bif bB then 0 else bif bD then 1 else 2) = 2 then v else 0
@Becoming.ListingValuation.split_released_term : ∀ {s t : Nat → Bool},
  s 0 = false →
    t 0 = false →
      t 1 = true →
        s 1 = t 2 →
          ∀ (x y : Nat) (bB bD : Bool),
            (bB = true → bD = false) →
              ((bif t (bif bB then 0 else bif bD then 1 else 2) then x else y) + bif bD then y else 0) =
                (bif s (bif bB || bD then 0 else 1) then x else y) + bif bD then x else 0
@Becoming.ListingValuation.split_stopped_term : ∀ {s t : Nat → Bool},
  s 0 = true →
    t 0 = false →
      t 1 = true →
        s 1 = t 2 →
          ∀ (x y : Nat) (bB bD : Bool),
            (bB = true → bD = false) →
              ((bif t (bif bB then 0 else bif bD then 1 else 2) then x else y) + bif bB then x else 0) =
                (bif s (bif bB || bD then 0 else 1) then x else y) + bif bB then y else 0
@Becoming.ListingValuation.worth_split_released : ∀ {C : Type} (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) {B D : C → Bool},
  (∀ (c : C), B c = true → D c = false) →
    ∀ {s t : Nat → Bool},
      s 0 = false →
        t 0 = false →
          t 1 = true →
            s 1 = t 2 →
              m.after (Becoming.HeldForReading.shifted gain loss)
                    (Becoming.HeldForReading.byRule fun c => t (Becoming.ListingValuation.whichCell B D c)) +
                  Becoming.ListingValuation.weightedOn m D gain =
                m.after (Becoming.HeldForReading.shifted gain loss)
                    (Becoming.HeldForReading.byRule fun c => s (Becoming.ListingValuation.eitherCell B D c)) +
                  Becoming.ListingValuation.weightedOn m D loss
@Becoming.ListingValuation.worth_split_stopped : ∀ {C : Type} (m : Becoming.HeldForReading.Model C)
  (gain loss : C → Nat) {B D : C → Bool},
  (∀ (c : C), B c = true → D c = false) →
    ∀ {s t : Nat → Bool},
      s 0 = true →
        t 0 = false →
          t 1 = true →
            s 1 = t 2 →
              m.after (Becoming.HeldForReading.shifted gain loss)
                    (Becoming.HeldForReading.byRule fun c => t (Becoming.ListingValuation.whichCell B D c)) +
                  Becoming.ListingValuation.weightedOn m B loss =
                m.after (Becoming.HeldForReading.shifted gain loss)
                    (Becoming.HeldForReading.byRule fun c => s (Becoming.ListingValuation.eitherCell B D c)) +
                  Becoming.ListingValuation.weightedOn m B gain
@Becoming.ListingValuation.splitsKeep_of_refined_le : ∀ {C : Type} (m pm : Becoming.HeldForReading.Model C)
  (gain loss g l : C → Nat),
  (∀ (K L : Type) [inst : DecidableEq K] [inst_1 : DecidableEq L] (π : C → K) (π' : C → L) (f : L → K) (zs : List K)
      (zs' : List L),
      (∀ (c : C), c ∈ m.listed → π c = f (π' c)) →
        (∀ (c : C), c ∈ pm.listed → π c = f (π' c)) →
          List.Pairwise (fun a b => a ≠ b) zs →
            (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
              List.Pairwise (fun a b => a ≠ b) zs' →
                (∀ (c : C), c ∈ m.listed → π' c ∈ zs') →
                  (∀ (c : C), c ∈ pm.listed → π' c ∈ zs') →
                    m.after (Becoming.HeldForReading.shifted gain loss)
                        (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer pm g l π (π c)) ≤
                      m.after (Becoming.HeldForReading.shifted gain loss)
                        (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer pm g l π' (π' c))) →
    Becoming.ListingValuation.SplitsKeep m pm gain loss g l
@Becoming.ListingValuation.splitsKeep_of_net : ∀ {C : Type} (m : Becoming.HeldForReading.Model C)
  (gain loss g l : C → Nat),
  (∀ (c : C), c ∈ m.listed → 0 < m.weight c → g c + loss c = l c + gain c) →
    Becoming.ListingValuation.SplitsKeep m m gain loss g l
@Becoming.ListingValuation.splitsKeep_of_off_le_go : ∀ {C : Type} (m pm : Becoming.HeldForReading.Model C)
  (gain loss g l : C → Nat),
  (∀ (c : C), c ∈ pm.listed → l c ≤ g c) → Becoming.ListingValuation.SplitsKeep m pm gain loss g l
@Becoming.ListingValuation.refining_never_lowers_iff : ∀ {C : Type} (m pm : Becoming.HeldForReading.Model C)
  (gain loss g l : C → Nat),
  (∀ (K L : Type) [inst : DecidableEq K] [inst_1 : DecidableEq L] (π : C → K) (π' : C → L) (f : L → K) (zs : List K)
      (zs' : List L),
      (∀ (c : C), c ∈ m.listed → π c = f (π' c)) →
        (∀ (c : C), c ∈ pm.listed → π c = f (π' c)) →
          List.Pairwise (fun a b => a ≠ b) zs →
            (∀ (c : C), c ∈ m.listed → π c ∈ zs) →
              List.Pairwise (fun a b => a ≠ b) zs' →
                (∀ (c : C), c ∈ m.listed → π' c ∈ zs') →
                  (∀ (c : C), c ∈ pm.listed → π' c ∈ zs') →
                    m.after (Becoming.HeldForReading.shifted gain loss)
                        (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer pm g l π (π c)) ≤
                      m.after (Becoming.HeldForReading.shifted gain loss)
                        (Becoming.HeldForReading.byRule fun c => Becoming.ListingValuation.answer pm g l π' (π' c))) ↔
    Becoming.ListingValuation.SplitsKeep m pm gain loss g l
Becoming.ListingValuation.scales_by_candidate : (∀ (c : Bool),
    ((1 * bif c then 0 else 10) + (bif c then 1 else 10) * bif c then 2 else 0) =
      (1 * bif c then 2 else 0) + (bif c then 1 else 10) * bif c then 0 else 1) ∧
  Becoming.ListingValuation.answer { listed := [false, true], weight := fun x => 1 } (fun c => bif c then 0 else 10)
        (fun c => bif c then 2 else 0) (fun x => ()) () =
      false ∧
    Becoming.ListingValuation.residual { listed := [false, true], weight := fun x => 1 } (fun c => bif c then 0 else 1)
        (fun c => bif c then 2 else 0) (fun x => ()) [()]
        (Becoming.ListingValuation.answer { listed := [false, true], weight := fun x => 1 }
          (fun c => bif c then 0 else 10) (fun c => bif c then 2 else 0) fun x => ()) =
      1
Becoming.ListingValuation.unweighted_told : (∀ (g l : Unit → Nat),
    Becoming.ListingValuation.answer { listed := [()], weight := fun x => 0 } g l id () = false) ∧
  Becoming.ListingValuation.residual { listed := [()], weight := fun x => 1 } (fun x => 0) (fun x => 1) id [()]
        (Becoming.ListingValuation.answer { listed := [()], weight := fun x => 0 } (fun x => 0) (fun x => 1) id) =
