        ((Becoming.ListingValuation.joint rd hd).course
            { internal := i, sensory := s, active := a, external := (w', h) } n).internal ∧
      ((Becoming.ListingValuation.joint rd hd).course { internal := i, sensory := s, active := a, external := (w, h) }
              n).sensory =
          ((Becoming.ListingValuation.joint rd hd).course
              { internal := i, sensory := s, active := a, external := (w', h) } n).sensory ∧
        ((Becoming.ListingValuation.joint rd hd).course { internal := i, sensory := s, active := a, external := (w, h) }
                n).active =
            ((Becoming.ListingValuation.joint rd hd).course
                { internal := i, sensory := s, active := a, external := (w', h) } n).active ∧
          ((Becoming.ListingValuation.joint rd hd).course
                  { internal := i, sensory := s, active := a, external := (w, h) } n).external.snd =
            ((Becoming.ListingValuation.joint rd hd).course
                  { internal := i, sensory := s, active := a, external := (w', h) } n).external.snd
@Becoming.ListingValuation.inputs_alike : ∀ {W V O X H : Type} [inst : DecidableEq O]
  (rd : Becoming.ListingValuation.Reader W V O X) (hd : Becoming.ListingValuation.Holder H X) (i : List W × V)
  (s : Becoming.ListingValuation.Input O X) (a : Bool) (h : H) {w w' : W},
  rd.reveal w = rd.reveal w' →
    ∀ (n : Nat),
      ((Becoming.ListingValuation.joint rd hd).course { internal := i, sensory := s, active := a, external := (w, h) }
              n).internal =
          ((Becoming.ListingValuation.joint rd hd).course
              { internal := i, sensory := s, active := a, external := (w', h) } n).internal ∧
        ((Becoming.ListingValuation.joint rd hd).course { internal := i, sensory := s, active := a, external := (w, h) }
                n).sensory =
            ((Becoming.ListingValuation.joint rd hd).course
                { internal := i, sensory := s, active := a, external := (w', h) } n).sensory ∧
