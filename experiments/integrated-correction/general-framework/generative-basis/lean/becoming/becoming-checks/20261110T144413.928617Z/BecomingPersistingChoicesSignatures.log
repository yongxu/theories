      (∀ (x y : X → Bool), ch.Met x y → ¬ends x → ends y → P x y) →
        Becoming.Weighting.IncreasingInOwnOn ch.Met items own fun b a => P a b
@Becoming.ChoiceOccasions.selfConcerned_consistent_of_kept : ∀ {X O : Type} {ch : Becoming.ChoiceOccasions (X → Bool) O}
  {items : List X} {own : X → Bool} {ends : (X → Bool) → Prop},
