    ∀ {x y : α},
      (∀ (P : Becoming.«际» α),
          (∀ (a : α), ¬P a a) →
            (∀ (a b c : α), P a b → P b c → P a c) → ch.Accords P → (∀ (a b : α), Q a b → b ≠ a → P a b) → P x y) ↔
        Becoming.«及» (ch.withPairs Q).Shown x y
@Becoming.ChoiceOccasions.above_in_some_containing_of_unreached : ∀ {α : Type u_1} {O : Type u_2}
  {ch : Becoming.ChoiceOccasions α O} {Q : Becoming.«际» α},
  Becoming.«无环» (ch.withPairs Q).Shown →
    ∀ {x y : α},
      x ≠ y →
        ¬Becoming.«及» (ch.withPairs Q).Shown y x →
          ∃ P,
            (∀ (a : α), ¬P a a) ∧
              (∀ (a b c : α), P a b → P b c → P a c) ∧ ch.Accords P ∧ (∀ (a b : α), Q a b → b ≠ a → P a b) ∧ P x y
