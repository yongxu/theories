@Becoming.ChoiceOccasions.reversed_off_met : ∀ {X O : Type} {ch : Becoming.ChoiceOccasions (X → Bool) O}
  {items : List X} {own : X → Bool},
  Becoming.«无环» (ch.withPairs (ch.OwnWidensMet items own)).Shown →
