      ch.Unmet a →
        Becoming.Weighting.WidensOn items a b →
          Becoming.Weighting.AddsOwn items own a b →
            ∃ P,
              (∀ (x : X → Bool), ¬P x x) ∧
                (∀ (x y z : X → Bool), P x y → P y z → P x z) ∧
                  ch.Accords P ∧
                    (Becoming.Weighting.IncreasingInOwnOn ch.Met items own fun y x => P x y) ∧
                      P b a ∧ ¬Becoming.Weighting.IncreasingInOwn items own fun y x => P x y
@Becoming.Flow.member_after_never_overdrew : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {G : Becoming.SelectionTerm.Generations X},
          Becoming.SelectionTerm.Flow.Descended L W G →
            ∀ {ds : List X} {m : Nat},
              (∀ (t : Nat) (f : X),
                  f ∈ L.present t →
                    ∀ (d : X), d ∈ ds → 0 < L.give t f d → ∃ e, e ∈ ds ∧ W.requires t f e ∧ m ≤ W.need t f e) →
                (∀ (s : Nat) (p : X), p ∈ G.family s → ∃ e, e ∈ ds ∧ W.requires s p e ∧ m ≤ W.need s p e) →
                  ∀ {T n s : Nat} {y : X},
                    T + n < s →
                      y ∈ G.family s →
                        ¬((∀ (k : Nat), k < n → L.replenishment ds (T + k) < L.uptake ds (T + k)) ∧
                            W.stock ds T < n + m)
@Becoming.Flow.persists_never_overdraws : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {G : Becoming.SelectionTerm.Generations X},
          Becoming.SelectionTerm.Flow.Descended L W G →
            ∀ {ds : List X} {m : Nat},
              (∀ (t : Nat) (f : X),
                  f ∈ L.present t →
                    ∀ (d : X), d ∈ ds → 0 < L.give t f d → ∃ e, e ∈ ds ∧ W.requires t f e ∧ m ≤ W.need t f e) →
                (∀ (s : Nat) (p : X), p ∈ G.family s → ∃ e, e ∈ ds ∧ W.requires s p e ∧ m ≤ W.need s p e) →
                  G.Persists →
                    ∀ (T n : Nat),
                      ¬((∀ (k : Nat), k < n → L.replenishment ds (T + k) < L.uptake ds (T + k)) ∧ W.stock ds T < n + m)
@Becoming.Flow.persisting_keeping_above_ending : ∀ {X α O : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {G : Becoming.SelectionTerm.Generations X},
          Becoming.SelectionTerm.Flow.Descended L W G →
            ∀ {ds : List X} {m : Nat},
              (∀ (t : Nat) (f : X),
                  f ∈ L.present t →
                    ∀ (d : X), d ∈ ds → 0 < L.give t f d → ∃ e, e ∈ ds ∧ W.requires t f e ∧ m ≤ W.need t f e) →
                (∀ (s : Nat) (p : X), p ∈ G.family s → ∃ e, e ∈ ds ∧ W.requires s p e ∧ m ≤ W.need s p e) →
                  G.Persists →
                    ∀ {ch : Becoming.ChoiceOccasions α O} {ends : α → Prop},
                      (∀ (o : O),
                          ends (ch.pick o) →
                            ∃ T n,
                              (∀ (k : Nat), k < n → L.replenishment ds (T + k) < L.uptake ds (T + k)) ∧
                                W.stock ds T < n + m) →
                        Becoming.«无环» ch.Shown →
                          ∃ P,
                            (∀ (x : α), ¬P x x) ∧
                              (∀ (x y z : α), P x y → P y z → P x z) ∧
                                ch.Accords P ∧ ∀ (x y : α), ch.Met x y → ¬ends x → ends y → P x y
@Becoming.Flow.persisting_consistent_with_selfConcern : ∀ {X Y O : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {G : Becoming.SelectionTerm.Generations X},
          Becoming.SelectionTerm.Flow.Descended L W G →
            ∀ {ds : List X} {m : Nat},
              (∀ (t : Nat) (f : X),
                  f ∈ L.present t →
                    ∀ (d : X), d ∈ ds → 0 < L.give t f d → ∃ e, e ∈ ds ∧ W.requires t f e ∧ m ≤ W.need t f e) →
                (∀ (s : Nat) (p : X), p ∈ G.family s → ∃ e, e ∈ ds ∧ W.requires s p e ∧ m ≤ W.need s p e) →
                  G.Persists →
                    ∀ {ch : Becoming.ChoiceOccasions (Y → Bool) O} {items : List Y} {own : Y → Bool}
                      {ends : (Y → Bool) → Prop},
                      (∀ (o : O),
                          ends (ch.pick o) →
                            ∃ T n,
                              (∀ (k : Nat), k < n → L.replenishment ds (T + k) < L.uptake ds (T + k)) ∧
                                W.stock ds T < n + m) →
                        Becoming.«无环» ch.Shown →
                          (∀ (a b : Y → Bool),
                              ch.Met a b →
                                Becoming.Weighting.WidensOn items a b →
                                  Becoming.Weighting.AddsOwn items own a b → ¬ends a ∧ ends b) →
                            ∃ P,
                              (∀ (a : Y → Bool), ¬P a a) ∧
                                (∀ (a b c : Y → Bool), P a b → P b c → P a c) ∧
                                  ch.Accords P ∧ Becoming.Weighting.IncreasingInOwnOn ch.Met items own fun b a => P a b
