    (∀ (o : O), ¬ends (ch.pick o)) → (∀ (x y : α), Q x y → ¬ends x ∧ ends y) → Becoming.«无环» (ch.withPairs Q).Shown
@Becoming.ChoiceOccasions.keeping_above_ending : ∀ {α : Type u_1} {O : Type u_2} {ch : Becoming.ChoiceOccasions α O}
  {ends : α → Prop},
