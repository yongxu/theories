  {ch : Becoming.ChoiceOccasions (X → Bool) O} {items : List X} {own : X → Bool},
  Becoming.«无环» ch.Shown →
    (∀ (o : O), ¬Becoming.Weighting.EndsOwn items own (ch.pick o)) →
      (∀ (o : O) (a : X → Bool), ch.menu o a → Becoming.Weighting.AllOrNone items own a) →
        ∃ P,
