    Becoming.«无环» (ch.withPairs (ch.OwnWidensMet items own)).Shown
@Becoming.ChoiceOccasions.increasingInOwnOn_of_keeping : ∀ {X O : Type} {ch : Becoming.ChoiceOccasions (X → Bool) O}
  {items : List X} {own : X → Bool} {ends : (X → Bool) → Prop},
