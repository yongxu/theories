          (∀ (x y z : α), P x y → P y z → P x z) ∧ ch.Accords P ∧ ∀ (x y : α), ch.Met x y → ¬ends x → ends y → P x y
@Becoming.Weighting.WidensOn.ne : ∀ {X : Type} {items : List X} {a b : X → Bool},
  Becoming.Weighting.WidensOn items a b → b ≠ a
@Becoming.Weighting.adds_ends_of_allOrNone : ∀ {X : Type} {items : List X} {own a b : X → Bool},
