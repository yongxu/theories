@Becoming.ChoiceOccasions.shown_withPairs_iff : ∀ {α : Type u_1} {O : Type u_2} {ch : Becoming.ChoiceOccasions α O}
  {Q : Becoming.«际» α} {x y : α}, (ch.withPairs Q).Shown x y ↔ ch.Shown x y ∨ Q x y ∧ y ≠ x
