  Becoming.ListedPaths.counted
@Becoming.ListedPaths.premises_hold_de_se : ∀ {O : (Nat × Unit → Bool) → (Nat × Unit → Bool) → Prop},
  Becoming.Weighting.IncreasingInOwn Becoming.ListedPaths.items (fun x => true) O →
    Becoming.Unrestricted (Becoming.selfAscribed (Becoming.ownClosure fun x x_1 => True) fun x => ()) ∧
      O (Becoming.ListedPaths.admitted Becoming.ListedPaths.never)
        (Becoming.ListedPaths.admitted Becoming.ListedPaths.once)
Becoming.ListedPaths.not_listed : ¬Becoming.ListedPaths.web.ListsAdmitted [] Becoming.ListedPaths.once
Becoming.ListedPaths.condition_reads_no_order : Becoming.ReadsNoOrder Becoming.ListedPaths.condition ∧
  (∀ (better : (Nat → Unit → Nat) → (Nat → Unit → Nat) → Prop), Becoming.ListedPaths.condition () better) ∧
    ¬∀ (better : (Nat → Unit → Nat) → (Nat → Unit → Nat) → Prop),
        Becoming.ListedPaths.condition () better →
          Becoming.Comparison Becoming.ListedPaths.web.paths (fun x => True) better
@Becoming.Relabel.GreaterOfTwo.pick_gt : ∀ {x y : Nat}, y < x → Becoming.Relabel.GreaterOfTwo.pick x y = some true
@Becoming.Relabel.GreaterOfTwo.pick_lt : ∀ {x y : Nat},
  x < y → ¬y < x → Becoming.Relabel.GreaterOfTwo.pick x y = some false
@Becoming.Relabel.GreaterOfTwo.pick_tie : ∀ {x y : Nat}, ¬y < x → ¬x < y → Becoming.Relabel.GreaterOfTwo.pick x y = none
Becoming.Relabel.GreaterOfTwo.pick_exchange : ∀ (x y : Nat),
  Becoming.Relabel.GreaterOfTwo.pick y x = Option.map (fun x => !x) (Becoming.Relabel.GreaterOfTwo.pick x y)
Becoming.Relabel.GreaterOfTwo.map_same : ∀ (a : Bool) (c : Option Bool), c = Option.map (Becoming.Relabel.swap a a) c
Becoming.Relabel.GreaterOfTwo.map_not : ∀ (a : Bool) (c : Option Bool),
  Option.map (fun x => !x) c = Option.map (Becoming.Relabel.swap a !a) c
Becoming.Relabel.GreaterOfTwo.equivariant : Becoming.Relabel.EquivariantChoice Becoming.Relabel.GreaterOfTwo.rule
Becoming.Relabel.GreaterOfTwo.premises_hold : Becoming.Relabel.EquivariantChoice Becoming.Relabel.GreaterOfTwo.rule ∧
  (Becoming.Relabel.GreaterOfTwo.rule fun b => bif b then 1 else 0) = some true ∧
    (Becoming.Relabel.GreaterOfTwo.rule fun x => 0) = none ∧ ¬Becoming.Relabel.EquivariantChoice fun x => some true
Becoming.IdleStep.stutter : Becoming.Stutter Becoming.IdleStep.reading
