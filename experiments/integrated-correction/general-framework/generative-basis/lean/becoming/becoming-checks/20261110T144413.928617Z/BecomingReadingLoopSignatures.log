@Becoming.ReadingLoop.Untested.floor_forgoes : ∀ {I : Type}
  (b :
    Becoming.Blanket.Blanketed I Becoming.ReadingLoop.Untested.Value Becoming.ReadingLoop.Untested.Act
      Becoming.ReadingLoop.Untested.World),
  (∀ (s : Becoming.ReadingLoop.Untested.Value) (a : Becoming.ReadingLoop.Untested.Act)
      (w : Becoming.ReadingLoop.Untested.World), b.nextSensory s a w = Becoming.ReadingLoop.Untested.reply s a w) →
    (∀ (s : Becoming.ReadingLoop.Untested.Value) (a : Becoming.ReadingLoop.Untested.Act)
        (w : Becoming.ReadingLoop.Untested.World), b.nextExternal s a w = w) →
      ∀ (i : I) (s : Becoming.ReadingLoop.Untested.Value) (a : Becoming.ReadingLoop.Untested.Act),
        (∀ (n : Nat),
            (b.course { internal := i, sensory := s, active := a, external := Becoming.ReadingLoop.Untested.World.down }
                  n).sensory ≠
              Becoming.ReadingLoop.Untested.Value.low) →
          ∀ (n : Nat),
            (b.course { internal := i, sensory := s, active := a, external := Becoming.ReadingLoop.Untested.World.up }
                    n).sensory =
                (b.course
                    { internal := i, sensory := s, active := a, external := Becoming.ReadingLoop.Untested.World.down }
                    n).sensory ∧
              (b.course
                    { internal := i, sensory := s, active := a, external := Becoming.ReadingLoop.Untested.World.down }
                    n).active =
                Becoming.ReadingLoop.Untested.Act.known
@Becoming.ReadingLoop.Untested.floor_never_high : ∀ {I : Type}
  (b :
    Becoming.Blanket.Blanketed I Becoming.ReadingLoop.Untested.Value Becoming.ReadingLoop.Untested.Act
      Becoming.ReadingLoop.Untested.World),
  (∀ (s : Becoming.ReadingLoop.Untested.Value) (a : Becoming.ReadingLoop.Untested.Act)
      (w : Becoming.ReadingLoop.Untested.World), b.nextSensory s a w = Becoming.ReadingLoop.Untested.reply s a w) →
    (∀ (s : Becoming.ReadingLoop.Untested.Value) (a : Becoming.ReadingLoop.Untested.Act)
        (w : Becoming.ReadingLoop.Untested.World), b.nextExternal s a w = w) →
      ∀ (i : I) (s : Becoming.ReadingLoop.Untested.Value) (a : Becoming.ReadingLoop.Untested.Act),
        s ≠ Becoming.ReadingLoop.Untested.Value.high →
          (∀ (n : Nat),
              (b.course
                    { internal := i, sensory := s, active := a, external := Becoming.ReadingLoop.Untested.World.down }
                    n).sensory ≠
                Becoming.ReadingLoop.Untested.Value.low) →
            ∀ (n : Nat),
              (b.course { internal := i, sensory := s, active := a, external := Becoming.ReadingLoop.Untested.World.up }
                    n).sensory ≠
                Becoming.ReadingLoop.Untested.Value.high
Becoming.ReadingLoop.Untested.both_accord : Becoming.ReadingLoop.Untested.training.Accords
    (Becoming.ReadingLoop.Untested.above Becoming.ReadingLoop.Untested.rank) ∧
  Becoming.ReadingLoop.Untested.training.Accords
    (Becoming.ReadingLoop.Untested.above Becoming.ReadingLoop.Untested.rank')
Becoming.ReadingLoop.Untested.apart_beyond : Becoming.ReadingLoop.Untested.above Becoming.ReadingLoop.Untested.rank
    Becoming.ReadingLoop.Untested.Value.high Becoming.ReadingLoop.Untested.Value.mid ∧
  Becoming.ReadingLoop.Untested.above Becoming.ReadingLoop.Untested.rank' Becoming.ReadingLoop.Untested.Value.mid
    Becoming.ReadingLoop.Untested.Value.high
Becoming.ReadingLoop.Untested.order_rests : ∀ (n : Nat),
  (Becoming.ReadingLoop.Untested.loop Becoming.ReadingLoop.Untested.rank').law.course
      (Becoming.ReadingLoop.Loop.start [Becoming.ReadingLoop.Untested.World.up] Becoming.ReadingLoop.Untested.Value.mid
        Becoming.ReadingLoop.Untested.Act.known Becoming.ReadingLoop.Untested.World.up)
      (n + 1) =
    Becoming.ReadingLoop.Untested.orderRest
Becoming.ReadingLoop.Untested.model_or_order : ∀ (n : Nat),
  ((Becoming.ReadingLoop.Untested.loop Becoming.ReadingLoop.Untested.rank).law.course
          (Becoming.ReadingLoop.Loop.start
            [Becoming.ReadingLoop.Untested.World.up, Becoming.ReadingLoop.Untested.World.down]
            Becoming.ReadingLoop.Untested.Value.mid Becoming.ReadingLoop.Untested.Act.known
            Becoming.ReadingLoop.Untested.World.up)
          n).sensory =
      ((Becoming.ReadingLoop.Untested.loop Becoming.ReadingLoop.Untested.rank').law.course
          (Becoming.ReadingLoop.Loop.start [Becoming.ReadingLoop.Untested.World.up]
            Becoming.ReadingLoop.Untested.Value.mid Becoming.ReadingLoop.Untested.Act.known
            Becoming.ReadingLoop.Untested.World.up)
          n).sensory ∧
    ((Becoming.ReadingLoop.Untested.loop Becoming.ReadingLoop.Untested.rank).law.course
          (Becoming.ReadingLoop.Loop.start
            [Becoming.ReadingLoop.Untested.World.up, Becoming.ReadingLoop.Untested.World.down]
            Becoming.ReadingLoop.Untested.Value.mid Becoming.ReadingLoop.Untested.Act.known
            Becoming.ReadingLoop.Untested.World.up)
          n).active =
      ((Becoming.ReadingLoop.Untested.loop Becoming.ReadingLoop.Untested.rank').law.course
          (Becoming.ReadingLoop.Loop.start [Becoming.ReadingLoop.Untested.World.up]
            Becoming.ReadingLoop.Untested.Value.mid Becoming.ReadingLoop.Untested.Act.known
            Becoming.ReadingLoop.Untested.World.up)
          n).active
Becoming.ReadingLoop.Untested.informed_turns : ∀ (n : Nat),
  (Becoming.ReadingLoop.Untested.loop Becoming.ReadingLoop.Untested.rank).law.course
      (Becoming.ReadingLoop.Loop.start [Becoming.ReadingLoop.Untested.World.up] Becoming.ReadingLoop.Untested.Value.mid
        Becoming.ReadingLoop.Untested.Act.known Becoming.ReadingLoop.Untested.World.up)
      (n + 3) =
    Becoming.ReadingLoop.Untested.upRest
