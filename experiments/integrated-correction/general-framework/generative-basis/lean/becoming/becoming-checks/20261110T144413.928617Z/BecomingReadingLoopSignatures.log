Becoming.ReadingLoop.Untested.byWorst_iff : ∀ (r : Becoming.ReadingLoop.Untested.Value → Nat)
  (ws : List Becoming.ReadingLoop.Untested.World) (s : Becoming.ReadingLoop.Untested.Value),
  Becoming.ReadingLoop.Untested.byWorst r ws s = Becoming.ReadingLoop.Untested.Act.untried ↔
    Becoming.ReadingLoop.Untested.worst r Becoming.ReadingLoop.Untested.Act.known ws <
      Becoming.ReadingLoop.Untested.worst r Becoming.ReadingLoop.Untested.Act.untried ws
