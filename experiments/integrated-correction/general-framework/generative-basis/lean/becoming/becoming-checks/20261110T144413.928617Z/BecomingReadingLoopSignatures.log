Becoming.ReadingLoop.Untested.worst_attained : ∀ (r : Becoming.ReadingLoop.Untested.Value → Nat)
  (a : Becoming.ReadingLoop.Untested.Act) (w : Becoming.ReadingLoop.Untested.World)
  (ws : List Becoming.ReadingLoop.Untested.World),
  ∃ v,
    v ∈ w :: ws ∧
      Becoming.ReadingLoop.Untested.worst r a (w :: ws) =
