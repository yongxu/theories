Becoming.ReadingLoop.Untested.explorer_down : ∀ (n : Nat),
  (Becoming.ReadingLoop.Untested.loop Becoming.ReadingLoop.Untested.rank).law.course
      (Becoming.ReadingLoop.Loop.start
        [Becoming.ReadingLoop.Untested.World.up, Becoming.ReadingLoop.Untested.World.down]
