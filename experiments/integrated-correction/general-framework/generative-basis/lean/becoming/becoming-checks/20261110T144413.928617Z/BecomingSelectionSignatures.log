@Becoming.Web.SelectsThrough.later : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop} {g : F} {t : Nat}
  {select : (Nat → C → Nat) → Prop} {s : Nat}, W.SelectsThrough obs g s select → s ≤ t → W.SelectsThrough obs g t select
@Becoming.Web.SelectsThrough.widen : ∀ {F C : Type} {W : Becoming.Web F C} {obs obs' : F → C → Prop} {g : F} {t : Nat}
  {select : (Nat → C → Nat) → Prop},
