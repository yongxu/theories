        Becoming.Diversion.diverting.Acting (Becoming.Diversion.web Becoming.Diversion.divertedLevel) ∧
          Becoming.Diversion.diverting.Taking (Becoming.Diversion.web Becoming.Diversion.divertedLevel) ∧
            Becoming.Diversion.diverting.WithinReach (Becoming.Diversion.web Becoming.Diversion.divertedLevel)
                Becoming.Diversion.Formation.taker Becoming.Diversion.Formation.dweller ∧
              ¬Becoming.Diversion.diverting.WithinCoupling (Becoming.Diversion.web Becoming.Diversion.divertedLevel)
                    Becoming.Diversion.gauge Becoming.Diversion.Formation.taker Becoming.Diversion.Formation.dweller ∧
                ¬Becoming.Diversion.undiverted.WithinReach (Becoming.Diversion.web Becoming.Diversion.undivertedLevel)
                      Becoming.Diversion.Formation.taker Becoming.Diversion.Formation.dweller ∧
                  (Becoming.Diversion.web Becoming.Diversion.divertedLevel).SelectsThrough Becoming.Diversion.gauge
                      Becoming.Diversion.Formation.taker 1 (Becoming.Diversion.StoreAtLeast 1 1) ∧
                    Becoming.Diversion.StoreAtLeast 1 1 Becoming.Diversion.divertedLevel ∧
                      ¬Becoming.Diversion.StoreAtLeast 1 1 Becoming.Diversion.undivertedLevel ∧
                        (∀ (n : Nat),
                            ¬(Becoming.Diversion.web Becoming.Diversion.divertedLevel).Supported (n + 1)
                                Becoming.Diversion.Formation.dweller) ∧
                          ∀ (t : Nat),
                            (Becoming.Diversion.web Becoming.Diversion.undivertedLevel).Supported t
                              Becoming.Diversion.Formation.dweller
Becoming.Diversion.blind_to_source : Becoming.Diversion.supplying.Balances
    (Becoming.Diversion.web Becoming.Diversion.suppliedLevel) ∧
  (Becoming.Diversion.web Becoming.Diversion.suppliedLevel).Dependent ∧
    ¬Becoming.Diversion.supplying.WithinReach (Becoming.Diversion.web Becoming.Diversion.suppliedLevel)
          Becoming.Diversion.Formation.taker Becoming.Diversion.Formation.dweller ∧
      (∀ (t : Nat),
          (Becoming.Diversion.web Becoming.Diversion.divertedLevel).AlikeThroughUpTo Becoming.Diversion.gauge
            Becoming.Diversion.Formation.taker Becoming.Diversion.divertedLevel Becoming.Diversion.suppliedLevel t) ∧
        (∀ (t : Nat) (select : (Nat → Becoming.Diversion.Place → Nat) → Prop),
            (Becoming.Diversion.web Becoming.Diversion.divertedLevel).SelectsThrough Becoming.Diversion.gauge
                Becoming.Diversion.Formation.taker t select →
              (select Becoming.Diversion.divertedLevel ↔ select Becoming.Diversion.suppliedLevel)) ∧
          (∀ (t : Nat),
              (Becoming.Diversion.web Becoming.Diversion.suppliedLevel).Supported t
                Becoming.Diversion.Formation.dweller) ∧
            ∀ (n : Nat),
              ¬(Becoming.Diversion.web Becoming.Diversion.divertedLevel).Supported (n + 1)
                  Becoming.Diversion.Formation.dweller
