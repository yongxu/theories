  {l l' : Nat → C → Nat} {t : Nat} (decided : (m : Nat → C → Nat) → Decidable (W.AlikeThroughUpTo obs g l m t)),
  (∀ (score : (Nat → C → Nat) → Nat), W.ScoresThrough obs g t score → score l = score l') ↔
    W.AlikeThroughUpTo obs g l l' t
