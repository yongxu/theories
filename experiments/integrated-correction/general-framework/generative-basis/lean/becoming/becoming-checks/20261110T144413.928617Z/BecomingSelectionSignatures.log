@Becoming.Web.SelectsThrough.not : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop} {g : F} {t : Nat}
  {select : (Nat → C → Nat) → Prop}, W.SelectsThrough obs g t select → W.SelectsThrough obs g t fun l => ¬select l
@Becoming.Web.SelectsThrough.and : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop} {g : F} {t : Nat}
  {select select' : (Nat → C → Nat) → Prop},
