  s ≤ t → W.SelectsThrough obs g t fun l => W.Admits (l s) s g
@Becoming.Web.observed_scores : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop} {g : F} {t : Nat} {c : C}
  {s : Nat}, obs g c → s ≤ t → W.ScoresThrough obs g t fun l => l s c
@Becoming.Web.ScoresThrough.atLeast : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop} {g : F} {t : Nat}
  {score : (Nat → C → Nat) → Nat},
