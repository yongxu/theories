@Becoming.Flow.beyond_pool_coupling : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {obs : F → C → Prop}
  {group : F → Prop} {g h : F},
  L.WithinPoolCoupling W obs group g →
    ¬L.WithinPoolCoupling W obs group h → ∀ {c : C}, W.CoupledInto obs g c → ¬L.Exchanges h c
@Becoming.Flow.unselected_beyond_coupling : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {obs : F → C → Prop} {part : F → Bool} {select : (Nat → C → Nat) → Prop} {l : Nat → C → Nat},
  L.WithheldLevels part W l →
    ∀ {f : F},
      (∀ (t : Nat) (g : F) (c : C), L.WithinCoupling W obs f g → W.CoupledInto obs g c → L.BalancesOn W [c] t) →
        (∀ (h : F), part h = true → ¬L.WithinCoupling W obs f h) →
          ∀ {g : F},
            L.WithinCoupling W obs f g → ∀ {t : Nat}, W.SelectsThrough obs g t select → (select W.level ↔ select l)
@Becoming.Flow.unscored_beyond_coupling : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {obs : F → C → Prop} {part : F → Bool} {score : (Nat → C → Nat) → Nat} {l : Nat → C → Nat},
  L.WithheldLevels part W l →
    ∀ {f : F},
      (∀ (t : Nat) (g : F) (c : C), L.WithinCoupling W obs f g → W.CoupledInto obs g c → L.BalancesOn W [c] t) →
        (∀ (h : F), part h = true → ¬L.WithinCoupling W obs f h) →
          ∀ {g : F}, L.WithinCoupling W obs f g → ∀ {t : Nat}, W.ScoresThrough obs g t score → score W.level = score l
@Becoming.Flow.uncoupled_beyond_pool : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {obs : F → C → Prop} {part : F → Bool} {group : F → Prop} {l : Nat → C → Nat},
  L.WithheldLevels part W l →
    (∀ (t : Nat) (g : F) (c : C), L.WithinPoolCoupling W obs group g → W.CoupledInto obs g c → L.BalancesOn W [c] t) →
      (∀ (h : F), part h = true → ¬L.WithinPoolCoupling W obs group h) →
        ∀ (t : Nat) (g : F), L.WithinPoolCoupling W obs group g → W.AlikeThrough obs g W.level l t
@Becoming.Flow.unselected_beyond_pool : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {obs : F → C → Prop} {part : F → Bool} {select : (Nat → C → Nat) → Prop} {group : F → Prop} {l : Nat → C → Nat},
  L.WithheldLevels part W l →
    (∀ (t : Nat) (g : F) (c : C), L.WithinPoolCoupling W obs group g → W.CoupledInto obs g c → L.BalancesOn W [c] t) →
      (∀ (h : F), part h = true → ¬L.WithinPoolCoupling W obs group h) →
        ∀ {pool : F → Prop},
          (∀ (g : F), pool g → L.WithinPoolCoupling W obs group g) →
            ∀ {t : Nat}, W.SelectsThroughAll obs pool t select → (select W.level ↔ select l)
@Becoming.Flow.unselected_beyond_coupling_all : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {obs : F → C → Prop} {part : F → Bool} {select : (Nat → C → Nat) → Prop} {l : Nat → C → Nat},
  L.WithheldLevels part W l →
    ∀ {f : F},
      (∀ (t : Nat) (g : F) (c : C), L.WithinCoupling W obs f g → W.CoupledInto obs g c → L.BalancesOn W [c] t) →
        (∀ (h : F), part h = true → ¬L.WithinCoupling W obs f h) →
          ∀ {group : F → Prop},
            (∀ (g : F), group g → L.WithinCoupling W obs f g) →
              ∀ {t : Nat}, W.SelectsThroughAll obs group t select → (select W.level ↔ select l)
@Becoming.Flow.unselected_beyond_coupling_responsive : ∀ {F C : Type} {L L' : Becoming.Flow F C}
  {W W' : Becoming.Web F C} {obs : F → C → Prop} {select : (Nat → C → Nat) → Prop} {f : F},
  (∀ (t : Nat) (g : F) (c : C),
      Becoming.WithinClosure (L.CoupledFromEither W L' obs) f g → W.CoupledInto obs g c → L.BalancesOn W [c] t) →
    (∀ (t : Nat) (g : F) (c : C),
        Becoming.WithinClosure (L.CoupledFromEither W L' obs) f g → W.CoupledInto obs g c → L'.BalancesOn W' [c] t) →
      (∀ (t : Nat), L.present t = L'.present t) →
        (∀ (g : F),
            Becoming.WithinClosure (L.CoupledFromEither W L' obs) f g →
              ∀ (c : C), W.CoupledInto obs g c → W.level 0 c = W'.level 0 c) →
          (∀ (h : F),
              Becoming.WithinClosure (L.CoupledFromEither W L' obs) f h →
                ∀ (t : Nat),
                  W.AlikeThroughUpTo obs h W.level W'.level t →
                    ∀ (g : F) (c : C),
                      Becoming.WithinClosure (L.CoupledFromEither W L' obs) f g →
                        W.CoupledInto obs g c → L.take t h c = L'.take t h c ∧ L.give t h c = L'.give t h c) →
            ∀ {g : F},
              Becoming.WithinClosure (L.CoupledFromEither W L' obs) f g →
                ∀ {t : Nat}, W.SelectsThrough obs g t select → (select W.level ↔ select W'.level)
@Becoming.share_rises_through : ∀ {C α : Type} {history : α → Nat → C → Nat} {kids : α → List α}
  {select : (Nat → C → Nat) → Prop} {ms es : List α} {a b : Nat},
  (∀ (p : α), p ∈ ms → select (history p)) →
    (∀ (p : α), p ∈ es → ¬select (history p)) →
      (∀ (p : α), select (history p) → a ≤ (kids p).length) →
        (∀ (p : α), ¬select (history p) → (kids p).length ≤ b) →
          b < a →
            0 < ms.length →
              0 < es.length → ms.length * Becoming.offspringCount es kids < Becoming.offspringCount ms kids * es.length
