          ∀ {t : Nat},
            T ≤ t →
              t < T + n →
                ∀ {h : F},
                  h ∈ ks →
                    ¬W.Rises t (store h) → (Becoming.Flow.storeDrawn W store cs c₀ ks T n f g).BalancesOn W [store h] t
@Becoming.Flow.storeDrawn_fedFromStores : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cs : List C}
  {c₀ : C} {ks : List F} {T n : Nat} {f g : F},
