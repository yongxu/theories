                (Becoming.Flow.gradedDrawn W cap cs c₀ ks T n f g)
@Becoming.Flow.gradedDrawn_givenFrom_le : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C} {ks : List F}
  {T n : Nat} {f g : F} [inst_2 : DecidableEq C] {c₀ : C},
