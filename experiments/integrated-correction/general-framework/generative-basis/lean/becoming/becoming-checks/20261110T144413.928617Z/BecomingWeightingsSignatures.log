                  (∀ (t : Nat), T ≤ t → t < T + n → W.active t f) →
                    W.stock cs T < n →
                      (∀ (h h' : F), h ∈ ks → h' ∈ ks → store h = store h' → h = h') →
                        (∀ (h : F), h ∈ ks → ¬store h ∈ cs) →
                          (∀ (t : Nat), T ≤ t → t < T + n → ∀ (h : F), h ∈ ks → ¬W.Rises t (store h)) →
                            (∀ (L : Becoming.Flow F C),
                                Becoming.Flow.FedFromStores W store cs ks T n L →
                                  Becoming.Flow.DrawsPast cs T n (L, W) f →
                                    Becoming.total (Becoming.steps T n) (W.shortfall (W.storeFall store) cs ks g) ≤
                                      Becoming.total (Becoming.steps T n) fun t => L.givenFrom cs t g) ∧
                              ((∀ (t : Nat),
                                  T ≤ t →
                                    t < T + n →
                                      W.shortfall (W.storeFall store) cs ks g t ≤
                                        W.otherCapacity (W.storeFall store) f t g) →
                                ∃ L,
                                  Becoming.Flow.FedFromStores W store cs ks T n L ∧
                                    Becoming.Flow.DrawsPast cs T n (L, W) f ∧
                                      (Becoming.total (Becoming.steps T n) fun t => L.givenFrom cs t g) =
                                        Becoming.total (Becoming.steps T n) (W.shortfall (W.storeFall store) cs ks g))
@Becoming.total_le_at_on : ∀ {α : Type} {q : α → Nat} {a : α} {as : List α},
  (∀ (b : α), b ∈ as → 0 < q b → b = a) → Becoming.Distinct as → Becoming.total as q ≤ q a
@Becoming.le_excess_of_add_le : ∀ {a b c : Nat}, a + b ≤ c → a ≤ Becoming.excess c b
@Becoming.excess_add_of_le : ∀ {a b : Nat}, b ≤ a → Becoming.excess a b + b = a
@Becoming.Flow.taken_store : ∀ {F C : Type} {W : Becoming.Web F C} {store : F → C} {L : Becoming.Flow F C} {t : Nat}
  {h : F},
  L.BalancesOn W [store h] t →
    L.taken t (store h) = W.storeFall store t h + Becoming.excess (L.given t (store h)) (W.storeRise store t h)
@Becoming.Flow.replenishment_le_taken : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cs : List C} {ks js : List F}
  {cap₂ : Nat → F → Nat} {T n : Nat} {e : F} {L : Becoming.Flow F C},
  Becoming.Flow.FedThroughStores W store cs ks js cap₂ T n L →
    ∀ {t : Nat},
      T ≤ t →
        t < T + n →
          (e ∈ L.present t → Becoming.total cs (L.give t e) = 0) →
            L.replenishment cs t ≤ Becoming.total ks fun h => if W.active t h ∧ h ≠ e then L.taken t (store h) else 0
@Becoming.Flow.stores_given_le : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cs : List C} {ks js : List F}
  {cap₂ : Nat → F → Nat} {T n : Nat} {e : F} {L : Becoming.Flow F C},
  Becoming.Flow.FedThroughStores W store cs ks js cap₂ T n L →
    ∀ {t : Nat},
      T ≤ t →
        t < T + n →
          (e ∈ L.present t → (Becoming.total ks fun h => L.give t e (store h)) = 0) →
            (Becoming.total ks fun h => L.given t (store h)) ≤ W.capacityWithout cap₂ js e t
@Becoming.Flow.storesRisen_le_given : ∀ {F C : Type} {W : Becoming.Web F C} {store : F → C} {cs : List C}
  {ks js : List F} {cap₂ : Nat → F → Nat} {T n : Nat} {L : Becoming.Flow F C},
  Becoming.Flow.FedThroughStores W store cs ks js cap₂ T n L →
    ∀ {t : Nat}, T ≤ t → t < T + n → W.storesRisen store ks t ≤ Becoming.total ks fun h => L.given t (store h)
@Becoming.Flow.storesRisen_le_capacity : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cs : List C} {ks js : List F}
  {cap₂ : Nat → F → Nat} {T n : Nat} {e : F} {L : Becoming.Flow F C},
  Becoming.Flow.FedThroughStores W store cs ks js cap₂ T n L →
    ∀ {t : Nat},
      T ≤ t →
        t < T + n →
          (e ∈ L.present t → (Becoming.total ks fun h => L.give t e (store h)) = 0) →
            W.storesRisen store ks t ≤ W.capacityWithout cap₂ js e t
@Becoming.Flow.replenishment_le_othersThrough : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cs : List C} {ks js : List F}
  {cap₂ : Nat → F → Nat} {T n : Nat} {e : F} {L : Becoming.Flow F C},
  Becoming.Flow.FedThroughStores W store cs ks js cap₂ T n L →
    ∀ {t : Nat},
      T ≤ t →
        t < T + n →
          (e ∈ L.present t → (Becoming.total cs (L.give t e) + Becoming.total ks fun h => L.give t e (store h)) = 0) →
            L.replenishment cs t ≤ W.othersThrough store cap₂ ks js e t
@Becoming.Flow.routed_zero : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cap₂ : Nat → F → Nat} {cs : List C}
  {ks js : List F} {e : F} {t : Nat},
  W.demand cs t ≤ W.othersThrough store cap₂ ks js e t → ¬W.RoutesAt ks e t → W.routed store cs ks e t = 0
@Becoming.Flow.routed_le : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cap₂ : Nat → F → Nat} {cs : List C}
  {ks js : List F} {e : F} {t : Nat},
  W.demand cs t ≤ W.othersThrough store cap₂ ks js e t →
    W.RoutesAt ks e t →
      W.routed store cs ks e t ≤ Becoming.excess (W.capacityWithout cap₂ js e t) (W.storesRisen store ks t)
@Becoming.Flow.router_of_routed : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cap₂ : Nat → F → Nat} {cs : List C}
  {ks js : List F} {e : F} {t : Nat},
  W.demand cs t ≤ W.othersThrough store cap₂ ks js e t →
    0 < W.routed store cs ks e t →
      Becoming.Flow.firstActiveOther W e t ks ∈ ks ∧
        W.active t (Becoming.Flow.firstActiveOther W e t ks) ∧ Becoming.Flow.firstActiveOther W e t ks ≠ e
@Becoming.Flow.storeNeed_total_le : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cap₂ : Nat → F → Nat} {cs : List C}
  {ks js : List F} {e : F},
  Becoming.Distinct ks →
    ∀ {t : Nat},
      W.storesRisen store ks t ≤ W.capacityWithout cap₂ js e t →
        W.demand cs t ≤ W.othersThrough store cap₂ ks js e t →
          Becoming.total ks (W.storeNeed store cs ks e t) ≤ W.capacityWithout cap₂ js e t
@Becoming.Flow.routedGive_pos : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C] {W : Becoming.Web F C}
  [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cap₂ : Nat → F → Nat} {cs : List C}
  {ks js : List F} {e : F} {t : Nat} {x : F} {c : C},
  0 < W.routedGive store cap₂ cs ks js e t x c → (∃ h, h ∈ ks ∧ store h = c) ∧ x ∈ js ∧ W.active t x ∧ x ≠ e
@Becoming.Flow.routedGive_family : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C] {W : Becoming.Web F C}
  [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cap₂ : Nat → F → Nat} {cs : List C}
  {ks js : List F} {e : F},
  (∀ (h : F), h ∈ ks → ¬store h ∈ cs) →
    ∀ {t : Nat} {x : F} {c : C}, c ∈ cs → W.routedGive store cap₂ cs ks js e t x c = 0
@Becoming.Flow.routedGive_store : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C] {W : Becoming.Web F C}
  [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cap₂ : Nat → F → Nat} {cs : List C}
  {ks js : List F} {e : F},
  Becoming.Distinct ks →
    Becoming.Distinct js →
      (∀ (h h' : F), h ∈ ks → h' ∈ ks → store h = store h' → h = h') →
        ∀ {t : Nat},
          W.storesRisen store ks t ≤ W.capacityWithout cap₂ js e t →
            W.demand cs t ≤ W.othersThrough store cap₂ ks js e t →
              ∀ {h : F},
                h ∈ ks →
                  (Becoming.total js fun x => W.routedGive store cap₂ cs ks js e t x (store h)) =
                    W.storeNeed store cs ks e t h
@Becoming.Flow.routedGive_le : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C] {W : Becoming.Web F C}
  [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cap₂ : Nat → F → Nat} {cs : List C}
  {ks js : List F} {e : F},
  Becoming.Distinct ks →
    Becoming.Distinct js →
      (∀ (h h' : F), h ∈ ks → h' ∈ ks → store h = store h' → h = h') →
        ∀ (t : Nat) (x : F), (Becoming.total ks fun h => W.routedGive store cap₂ cs ks js e t x (store h)) ≤ cap₂ t x
@Becoming.Flow.routedCapacity_covers : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cap₂ : Nat → F → Nat} {cs : List C}
  {ks js : List F} {e : F} {t : Nat},
  W.demand cs t ≤ W.othersThrough store cap₂ ks js e t →
    W.demand cs t ≤ W.capacityWithout (W.routedCapacity store cs ks e) ks e t
@Becoming.Flow.routedDrawn_give_family : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C}
  {cap₂ : Nat → F → Nat} {cs : List C} {c₀ : C} {ks js : List F} {T n : Nat} {f e : F},
  (∀ (h : F), h ∈ ks → ¬store h ∈ cs) →
    ∀ {t : Nat} {x : F} {c : C},
      c ∈ cs →
        (Becoming.Flow.routedDrawn W store cap₂ cs c₀ ks js T n f e).give t x c =
