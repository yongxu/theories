@Becoming.Flow.needs_giver_iff_alone : ∀ {F C : Type} [DecidableEq F] {W : Becoming.Web F C}
  [(t : Nat) → (x : F) → Decidable (W.active t x)] {cs : List C} {c₀ : C},
  c₀ ∈ cs →
    ∀ {ks : List F} {T n : Nat} {f g : F},
      ¬f ∈ ks →
        g ∈ ks →
          (∀ (t : Nat), T ≤ t → t < T + n → W.active t f) →
            W.stock cs T < n →
              (Becoming.NeedsPart (Becoming.Flow.FedOnlyOn W cs (fun x => x ∈ ks) T n)
                  (fun L => Becoming.Flow.DrawsPast cs T n (L, W)) (fun L => Becoming.Flow.GivesWithin cs T n (L, W)) f
                  g ↔
                ∃ t, T ≤ t ∧ t < T + n ∧ W.CallsForGiving cs t ∧ ∀ (h : F), h ∈ ks → W.active t h → h = g)
@Becoming.Web.callsForGiving_iff_demand_pos : ∀ {F C : Type} {W : Becoming.Web F C} {cs : List C} {t : Nat},
  W.CallsForGiving cs t ↔ 0 < W.demand cs t
@Becoming.Web.total_drawnUnit : ∀ {F C : Type} {W : Becoming.Web F C} [inst : DecidableEq C] {cs : List C},
  Becoming.Distinct cs →
    ∀ {c₀ : C},
      c₀ ∈ cs → ∀ (t : Nat), Becoming.total cs (W.drawnUnit cs c₀ t) = if ¬∃ c, c ∈ cs ∧ W.Falls t c then 1 else 0
@Becoming.Flow.given_of_steady : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {cs : List C} {t : Nat}
  {c : C},
  L.BalancesOn W cs t → c ∈ cs → ¬W.Falls t c → L.given t c = Becoming.rise (fun s => W.level s c) t + L.taken t c
@Becoming.Flow.rise_le_given : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {cs : List C} {t : Nat}
  {c : C}, L.BalancesOn W cs t → c ∈ cs → Becoming.rise (fun s => W.level s c) t ≤ L.given t c
@Becoming.Flow.demand_le_replenishment : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {cs : List C}
  {t : Nat} {f : F},
  L.BalancesOn W cs t → f ∈ L.present t → 0 < Becoming.total cs (L.take t f) → W.demand cs t ≤ L.replenishment cs t
@Becoming.Flow.needsSome_within : ∀ {F C : Type} (W : Becoming.Web F C) (cap : Nat → F → Nat) (cs : List C)
  (K : F → Prop) (T n : Nat) (f : F),
  Becoming.NeedsSomePart (Becoming.Flow.FedOnlyWithin W cap cs K T n) (fun L => Becoming.Flow.DrawsPast cs T n (L, W))
    (fun L => Becoming.Flow.GivesWithin cs T n (L, W)) f K
@Becoming.Flow.leastDrawn_gives : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C] {W : Becoming.Web F C}
  {cs : List C} {c₀ : C} {T n : Nat} {f : F} {pick : Nat → F} {t : Nat} {x : F} {c : C},
  0 < (Becoming.Flow.leastDrawn W cs c₀ T n f pick).give t x c → x = pick t ∧ W.CallsForGiving cs t
@Becoming.Flow.leastDrawn_balancesOn : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} {cs : List C} {c₀ : C} {T n : Nat} {f : F} {pick : Nat → F},
  (∀ (t : Nat), pick t ≠ f) →
    ∀ (t : Nat), T ≤ t → t < T + n → (Becoming.Flow.leastDrawn W cs c₀ T n f pick).BalancesOn W cs t
@Becoming.Flow.leastDrawn_acting : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C] {W : Becoming.Web F C}
  {cs : List C} {c₀ : C} {T n : Nat} {f : F} {pick : Nat → F},
  (∀ (t : Nat), T ≤ t → t < T + n → W.CallsForGiving cs t → W.active t (pick t)) →
    (Becoming.Flow.leastDrawn W cs c₀ T n f pick).Acting W
@Becoming.Flow.leastDrawn_given_total : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} {cs : List C} {c₀ : C} {T n : Nat} {f : F} {pick : Nat → F},
  Becoming.Distinct cs →
    c₀ ∈ cs →
      ∀ (t : Nat), Becoming.total cs ((Becoming.Flow.leastDrawn W cs c₀ T n f pick).give t (pick t)) = W.demand cs t
@Becoming.Flow.leastDrawn_drawsPast : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} {cs : List C} {c₀ : C} {T n : Nat} {f : F} {pick : Nat → F},
  c₀ ∈ cs →
    (∀ (t : Nat), T ≤ t → t < T + n → W.active t f) →
      W.stock cs T < n → Becoming.Flow.DrawsPast cs T n (Becoming.Flow.leastDrawn W cs c₀ T n f pick, W) f
@Becoming.Flow.leastDrawn_fedOnlyWithin : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} {cs : List C} {c₀ : C} {T n : Nat} {f : F} {pick : Nat → F} {cap : Nat → F → Nat}
  {K : F → Prop},
  Becoming.Distinct cs →
    c₀ ∈ cs →
      (∀ (t : Nat), pick t ≠ f) →
        (∀ (t : Nat),
            T ≤ t → t < T + n → W.CallsForGiving cs t → W.active t (pick t) ∧ W.demand cs t ≤ cap t (pick t)) →
          (∀ (t : Nat), K (pick t)) →
            Becoming.Flow.FedOnlyWithin W cap cs K T n (Becoming.Flow.leastDrawn W cs c₀ T n f pick)
@Becoming.Flow.feedsAlone_iff : ∀ {F C : Type} [DecidableEq F] [DecidableEq C] {W : Becoming.Web F C}
  {cap : Nat → F → Nat} {cs : List C},
  Becoming.Distinct cs →
    ∀ {c₀ : C},
      c₀ ∈ cs →
        ∀ {K : F → Prop} {T n : Nat} {f g : F},
          ¬K f →
            K g →
              (∀ (t : Nat), T ≤ t → t < T + n → W.active t f) →
                W.stock cs T < n →
                  ((∃ L,
                      Becoming.Flow.FedOnlyWithin W cap cs K T n L ∧
                        Becoming.Flow.DrawsPast cs T n (L, W) f ∧
                          Becoming.Flow.GivesWithin cs T n (L, W) g ∧
                            ∀ (h : F), K h → Becoming.Flow.GivesWithin cs T n (L, W) h → h = g) ↔
                    W.CanFeedAlone cap cs T n g)
@Becoming.Flow.partAlone_within_iff : ∀ {F C : Type} [DecidableEq F] [DecidableEq C] {W : Becoming.Web F C}
  {cap : Nat → F → Nat} {cs : List C},
  Becoming.Distinct cs →
    ∀ {c₀ : C},
      c₀ ∈ cs →
        ∀ {K : F → Prop} {T n : Nat} {f : F},
          ¬K f →
            (∀ (t : Nat), T ≤ t → t < T + n → W.active t f) →
              W.stock cs T < n →
                (Becoming.PartAlone (Becoming.Flow.FedOnlyWithin W cap cs K T n)
                    (fun L => Becoming.Flow.DrawsPast cs T n (L, W)) (fun L => Becoming.Flow.GivesWithin cs T n (L, W))
                    f K ↔
                  ∀ (g : F), K g → W.CanFeedAlone cap cs T n g)
@Becoming.Flow.needs_giver_iff_only_within : ∀ {F C : Type} [DecidableEq F] [DecidableEq C] {W : Becoming.Web F C}
  {cap : Nat → F → Nat} {cs : List C},
  Becoming.Distinct cs →
    ∀ {c₀ : C},
      c₀ ∈ cs →
        ∀ {K : F → Prop} {T n : Nat} {f g : F},
          ¬K f →
            (∀ (t : Nat), T ≤ t → t < T + n → W.active t f) →
              W.stock cs T < n →
                (∀ (g : F), K g → W.CanFeedAlone cap cs T n g) →
                  K g →
                    (Becoming.NeedsPart (Becoming.Flow.FedOnlyWithin W cap cs K T n)
                        (fun L => Becoming.Flow.DrawsPast cs T n (L, W))
                        (fun L => Becoming.Flow.GivesWithin cs T n (L, W)) f g ↔
                      ∀ (h : F), K h → h = g)
@Becoming.Flow.needs_giver_of_short : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C} {ks : List F}
  {T n : Nat} {f g : F},
  (∃ t, T ≤ t ∧ t < T + n ∧ (Becoming.total ks fun h => if W.active t h ∧ h ≠ g then cap t h else 0) < W.demand cs t) →
    Becoming.NeedsPart (Becoming.Flow.FedOnlyWithin W cap cs (fun x => x ∈ ks) T n)
      (fun L => Becoming.Flow.DrawsPast cs T n (L, W)) (fun L => Becoming.Flow.GivesWithin cs T n (L, W)) f g
@Becoming.total_unitsOn : ∀ {α : Type} (q r : α → Nat) (as : List α),
  Becoming.total (Becoming.unitsOn r as) q = Becoming.total as fun a => r a * q a
@Becoming.mem_replicate_pos : ∀ {α : Type} {a x : α} {k : Nat}, x ∈ List.replicate k a → x = a ∧ 0 < k
@Becoming.mem_unitsOn : ∀ {α : Type} {r : α → Nat} {x : α} {as : List α}, x ∈ Becoming.unitsOn r as → x ∈ as ∧ 0 < r x
@Becoming.total_pairUp_fst : ∀ {α β : Type} (q : α → Nat) (as : List α) (bs : List β),
  ((Becoming.total as fun x => 1) ≤ Becoming.total bs fun x => 1) →
    (Becoming.total (Becoming.pairUp as bs) fun z => q z.fst) = Becoming.total as q
@Becoming.total_pairUp_snd_le : ∀ {α β : Type} (q : β → Nat) (as : List α) (bs : List β),
  (Becoming.total (Becoming.pairUp as bs) fun z => q z.snd) ≤ Becoming.total bs q
@Becoming.mem_pairUp : ∀ {α β : Type} {z : α × β} {as : List α} {bs : List β},
  z ∈ Becoming.pairUp as bs → z.fst ∈ as ∧ z.snd ∈ bs
@Becoming.total_eq_at : ∀ {α : Type} {q : α → Nat} {a : α} {as : List α},
  (∀ (b : α), 0 < q b → b = a) → Becoming.Distinct as → a ∈ as → Becoming.total as q = q a
@Becoming.Web.total_demandAt : ∀ {F C : Type} {W : Becoming.Web F C} [inst : DecidableEq C] {cs : List C},
  Becoming.Distinct cs → ∀ {c₀ : C}, c₀ ∈ cs → ∀ (t : Nat), Becoming.total cs (W.demandAt cs c₀ t) = W.demand cs t
@Becoming.Web.otherCapacity_le : ∀ {F C : Type} {W : Becoming.Web F C}
  [inst : (t : Nat) → (x : F) → Decidable (W.active t x)] [inst_1 : DecidableEq F] (cap : Nat → F → Nat) (g : F)
  (t : Nat) (h : F), W.otherCapacity cap g t h ≤ cap t h
@Becoming.Web.mem_shares : ∀ {F C : Type} {W : Becoming.Web F C} [inst : DecidableEq C]
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] [inst_2 : DecidableEq F] {cap : Nat → F → Nat} {cs : List C}
  {c₀ : C} {ks : List F} {g : F} {t : Nat} {z : C × F},
  z ∈ W.shares cap cs c₀ ks g t → z.fst ∈ cs ∧ 0 < W.demandAt cs c₀ t z.fst ∧ z.snd ∈ ks ∧ W.active t z.snd ∧ z.snd ≠ g
@Becoming.Flow.sharedDrawn_gives : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C] {W : Becoming.Web F C}
  [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C} {c₀ : C} {ks : List F}
  {T n : Nat} {f g : F} {t : Nat} {x : F} {c : C},
  0 < (Becoming.Flow.sharedDrawn W cap cs c₀ ks T n f g).give t x c → c ∈ cs ∧ x ∈ ks ∧ W.active t x ∧ x ≠ g
@Becoming.Flow.sharedDrawn_given_members : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C}
  {c₀ : C} {ks : List F} {T n : Nat} {f g : F},
  Becoming.Distinct cs →
    c₀ ∈ cs →
      Becoming.Distinct ks →
        ∀ {t : Nat},
          W.demand cs t ≤ W.capacityWithout cap ks g t →
            ∀ {c : C},
              c ∈ cs →
                (Becoming.total ks fun x => (Becoming.Flow.sharedDrawn W cap cs c₀ ks T n f g).give t x c) =
                  W.demandAt cs c₀ t c
@Becoming.Flow.sharedDrawn_balancesOn : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C}
  {c₀ : C} {ks : List F} {T n : Nat} {f g : F},
  Becoming.Distinct cs →
    c₀ ∈ cs →
      Becoming.Distinct ks →
        ¬f ∈ ks →
          (∀ (t : Nat), T ≤ t → t < T + n → W.demand cs t ≤ W.capacityWithout cap ks g t) →
            ∀ (t : Nat), T ≤ t → t < T + n → (Becoming.Flow.sharedDrawn W cap cs c₀ ks T n f g).BalancesOn W cs t
@Becoming.Flow.sharedDrawn_acting : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C}
  {c₀ : C} {ks : List F} {T n : Nat} {f g : F}, (Becoming.Flow.sharedDrawn W cap cs c₀ ks T n f g).Acting W
@Becoming.Flow.sharedDrawn_given_le : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C}
  {c₀ : C} {ks : List F} {T n : Nat} {f g : F},
  Becoming.Distinct cs →
    Becoming.Distinct ks →
      ∀ (t : Nat) (x : F),
        Becoming.total cs ((Becoming.Flow.sharedDrawn W cap cs c₀ ks T n f g).give t x) ≤ W.otherCapacity cap g t x
@Becoming.Flow.sharedDrawn_quiet : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C] {W : Becoming.Web F C}
  [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C} {c₀ : C} {ks : List F}
  {T n : Nat} {f g : F},
  Becoming.Distinct cs →
    Becoming.Distinct ks →
      ∀ (t : Nat), Becoming.total cs ((Becoming.Flow.sharedDrawn W cap cs c₀ ks T n f g).give t g) = 0
@Becoming.Flow.sharedDrawn_fedOnlyWithin : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C}
  {c₀ : C} {ks : List F} {T n : Nat} {f g : F},
  Becoming.Distinct cs →
    c₀ ∈ cs →
      Becoming.Distinct ks →
        ¬f ∈ ks →
          (∀ (t : Nat), T ≤ t → t < T + n → W.demand cs t ≤ W.capacityWithout cap ks g t) →
            Becoming.Flow.FedOnlyWithin W cap cs (fun x => x ∈ ks) T n
              (Becoming.Flow.sharedDrawn W cap cs c₀ ks T n f g)
@Becoming.Flow.sharedDrawn_drawsPast : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C}
  {c₀ : C} {ks : List F} {T n : Nat} {f g : F},
  c₀ ∈ cs →
    (∀ (t : Nat), T ≤ t → t < T + n → W.active t f) →
      W.stock cs T < n → Becoming.Flow.DrawsPast cs T n (Becoming.Flow.sharedDrawn W cap cs c₀ ks T n f g, W) f
@Becoming.Flow.sharedDrawn_not_gives : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C}
  {c₀ : C} {ks : List F} {T n : Nat} {f g : F},
  Becoming.Distinct cs →
    Becoming.Distinct ks → ¬Becoming.Flow.GivesWithin cs T n (Becoming.Flow.sharedDrawn W cap cs c₀ ks T n f g, W) g
@Becoming.Flow.needs_giver_iff_short : ∀ {F C : Type} [inst : DecidableEq F] [DecidableEq C] {W : Becoming.Web F C}
  [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C},
  Becoming.Distinct cs →
    ∀ {c₀ : C},
      c₀ ∈ cs →
        ∀ {ks : List F},
          Becoming.Distinct ks →
            ∀ {T n : Nat} {f g : F},
              ¬f ∈ ks →
                (∀ (t : Nat), T ≤ t → t < T + n → W.active t f) →
                  W.stock cs T < n →
                    (Becoming.NeedsPart (Becoming.Flow.FedOnlyWithin W cap cs (fun x => x ∈ ks) T n)
                        (fun L => Becoming.Flow.DrawsPast cs T n (L, W))
                        (fun L => Becoming.Flow.GivesWithin cs T n (L, W)) f g ↔
                      ∃ t, T ≤ t ∧ t < T + n ∧ W.capacityWithout cap ks g t < W.demand cs t)
@Becoming.Flow.replenishment_le_uptake : ∀ {F C : Type} {L : Becoming.Flow F C} {cs ds : List C} {t : Nat},
  L.PassesOn cs ds t → L.replenishment cs t ≤ L.uptake ds t
@Becoming.Flow.passed_le_supply : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {cs ds : List C}
  {t : Nat},
  L.BalancesOn W ds t →
    L.PassesOn cs ds t → W.stock ds (t + 1) + L.replenishment cs t ≤ W.stock ds t + L.replenishment ds t
@Becoming.Flow.passed_le_drop : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {cs ds : List C}
  {t : Nat},
  L.BalancesOn W ds t →
    L.PassesOn cs ds t → L.replenishment ds t = 0 → W.stock ds (t + 1) + L.replenishment cs t ≤ W.stock ds t
@Becoming.Flow.passed_zero_of_exhausted : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {cs ds : List C}
  {t : Nat},
  L.BalancesOn W ds t → L.PassesOn cs ds t → L.replenishment ds t = 0 → W.stock ds t = 0 → L.replenishment cs t = 0
@Becoming.Flow.uptake_le_tiers : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} (T N : Nat) (cs : List C)
  (ups : List (List C)),
  (∀ (t : Nat), T ≤ t → t < T + N → L.BalancesTiers W t cs ups) →
    (∀ (t : Nat), T ≤ t → t < T + N → L.PassesTiers t cs ups) →
      Becoming.total (Becoming.steps T N) (L.uptake cs) ≤
        W.stockTiers T cs ups + Becoming.total (Becoming.steps T N) (L.replenishment (Becoming.topTier cs ups))
@Becoming.Flow.needsSome_tiers : ∀ {F C : Type} (W : Becoming.Web F C) (cs : List C) (ups : List (List C))
  (K : F → Prop) (T n : Nat) (f : F),
  Becoming.NeedsSomePart (Becoming.Flow.FedThroughTiers W cs ups K T n)
    (fun L => Becoming.Flow.DrawsPastTiers cs ups T n (L, W))
    (fun L => Becoming.Flow.GivesWithin (Becoming.topTier cs ups) T n (L, W)) f K
@Becoming.Flow.take_le_storeFall : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {store : F → C}
  {t : Nat} {h : F},
  L.BalancesOn W [store h] t → L.given t (store h) = 0 → h ∈ L.present t → L.take t h (store h) ≤ W.storeFall store t h
@Becoming.Flow.fedFromStores_within : ∀ {F C : Type} {W : Becoming.Web F C} {store : F → C} {cs : List C} {ks : List F}
  {T n : Nat} {L : Becoming.Flow F C},
  Becoming.Flow.FedFromStores W store cs ks T n L →
    Becoming.Flow.FedOnlyWithin W (W.storeFall store) cs (fun x => x ∈ ks) T n L
@Becoming.Flow.storeDrawn_balancesOn : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cs : List C}
  {c₀ : C} {ks : List F} {T n : Nat} {f g : F},
  Becoming.Distinct cs →
    c₀ ∈ cs →
      Becoming.Distinct ks →
        ¬f ∈ ks →
          (∀ (h : F), h ∈ ks → ¬store h ∈ cs) →
            (∀ (t : Nat), T ≤ t → t < T + n → W.demand cs t ≤ W.capacityWithout (W.storeFall store) ks g t) →
              ∀ (t : Nat), T ≤ t → t < T + n → (Becoming.Flow.storeDrawn W store cs c₀ ks T n f g).BalancesOn W cs t
@Becoming.Flow.storeDrawn_given_store : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cs : List C}
  {c₀ : C} {ks : List F} {T n : Nat} {f g : F},
  (∀ (h : F), h ∈ ks → ¬store h ∈ cs) →
    ∀ {t : Nat} {h : F}, h ∈ ks → (Becoming.Flow.storeDrawn W store cs c₀ ks T n f g).given t (store h) = 0
@Becoming.Flow.storeDrawn_taken_store : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cs : List C}
  {c₀ : C} {ks : List F} {T n : Nat} {f g : F},
  Becoming.Distinct ks →
    ¬f ∈ ks →
      (∀ (h h' : F), h ∈ ks → h' ∈ ks → store h = store h' → h = h') →
        (∀ (h : F), h ∈ ks → ¬store h ∈ cs) →
          ∀ {t : Nat} {h : F},
            h ∈ ks →
              (Becoming.total ks fun x => (Becoming.Flow.storeDrawn W store cs c₀ ks T n f g).take t x (store h)) =
                W.storeFall store t h
@Becoming.Flow.storeDrawn_balances_store : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cs : List C}
  {c₀ : C} {ks : List F} {T n : Nat} {f g : F},
