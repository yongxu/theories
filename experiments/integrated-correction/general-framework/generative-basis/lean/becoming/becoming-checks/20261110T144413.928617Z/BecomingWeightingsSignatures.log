      W.stock cs T < n → Becoming.Flow.DrawsPast cs T n (Becoming.Flow.storeDrawn W store cs c₀ ks T n f g, W) f
@Becoming.Flow.storeDrawn_not_gives : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cs : List C}
  {c₀ : C} {ks : List F} {T n : Nat} {f g : F},
