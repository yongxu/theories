            W.capacityWithout cap ks g t
@Becoming.Flow.shortfall_le_givenFrom : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C} {ks : List F}
  {T n : Nat} {f g : F} {L : Becoming.Flow F C},
  Becoming.Flow.FedOnlyWithin W cap cs (fun x => x ∈ ks) T n L →
    ∀ {t : Nat},
      T ≤ t →
        t < T + n →
          f ∈ L.present t → 0 < Becoming.total cs (L.take t f) → W.shortfall cap cs ks g t ≤ L.givenFrom cs t g
@Becoming.Flow.shortfalls_le_given : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C} {ks : List F}
  {T n : Nat} {f g : F} {L : Becoming.Flow F C},
  Becoming.Flow.FedOnlyWithin W cap cs (fun x => x ∈ ks) T n L →
    Becoming.Flow.DrawsPast cs T n (L, W) f →
      Becoming.total (Becoming.steps T n) (W.shortfall cap cs ks g) ≤
        Becoming.total (Becoming.steps T n) fun t => L.givenFrom cs t g
@Becoming.Flow.otherCapacity_short : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C} {ks : List F} {f g : F},
  ¬f ∈ ks →
    ∀ {t : Nat},
      W.shortfall cap cs ks g t ≤ W.otherCapacity cap f t g →
        ∀ {h : F},
          h ∈ ks →
            W.otherCapacity (W.shortCapacity cap cs ks g) f t h =
              W.otherCapacity cap g t h + if h = g then W.shortfall cap cs ks g t else 0
@Becoming.Flow.capacityWithout_short : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C} {ks : List F} {f g : F},
  Becoming.Distinct ks →
    ¬f ∈ ks →
      g ∈ ks →
        ∀ {t : Nat},
          W.shortfall cap cs ks g t ≤ W.otherCapacity cap f t g →
            W.capacityWithout (W.shortCapacity cap cs ks g) ks f t =
              W.capacityWithout cap ks g t + W.shortfall cap cs ks g t
@Becoming.Flow.shortCapacity_le : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C} {ks : List F} {f g : F}
  {t : Nat},
  W.shortfall cap cs ks g t ≤ W.otherCapacity cap f t g → ∀ (x : F), W.shortCapacity cap cs ks g t x ≤ cap t x
