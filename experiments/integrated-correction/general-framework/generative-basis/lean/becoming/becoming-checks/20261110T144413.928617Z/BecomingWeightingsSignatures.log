            (∀ (h : F), h ∈ ks → ¬store h ∈ cs) →
              (∀ (t : Nat), T ≤ t → t < T + n → ∀ (h : F), h ∈ ks → ¬W.Rises t (store h)) →
                (∀ (t : Nat), T ≤ t → t < T + n → W.demand cs t ≤ W.capacityWithout (W.storeFall store) ks g t) →
                  Becoming.Flow.FedFromStores W store cs ks T n (Becoming.Flow.storeDrawn W store cs c₀ ks T n f g)
@Becoming.Flow.storeDrawn_drawsPast : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
