  [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C},
  Becoming.Distinct cs →
    ∀ {c₀ : C},
      c₀ ∈ cs →
        ∀ {ks : List F},
