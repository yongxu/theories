@Becoming.Weighting.increasingInOwn_of_increasing : ∀ {X : Type} {items : List X} {own : X → Bool}
  {R : (X → Bool) → (X → Bool) → Prop},
  Becoming.Weighting.Increasing items R → Becoming.Weighting.IncreasingInOwn items own R
@Becoming.Weighting.increasingInOwnOn_of_increasingInOwn : ∀ {X : Type} {met : (X → Bool) → (X → Bool) → Prop}
  {items : List X} {own : X → Bool} {R : (X → Bool) → (X → Bool) → Prop},
  Becoming.Weighting.IncreasingInOwn items own R → Becoming.Weighting.IncreasingInOwnOn met items own R
@Becoming.Weighting.increasingInOwnOn_every_iff : ∀ {X : Type} {items : List X} {own : X → Bool}
  {R : (X → Bool) → (X → Bool) → Prop},
  Becoming.Weighting.IncreasingInOwnOn (fun x x_1 => True) items own R ↔ Becoming.Weighting.IncreasingInOwn items own R
@Becoming.Weighting.increasingInOwn_iff_increasing : ∀ {X : Type} {items : List X} {own : X → Bool}
  {R : (X → Bool) → (X → Bool) → Prop},
  (∀ (x : X), x ∈ items → own x = true) →
    (Becoming.Weighting.IncreasingInOwn items own R ↔ Becoming.Weighting.Increasing items R)
@Becoming.Weighting.widensOwn_iff_every_increasingInOwn : ∀ {X : Type} {items : List X} {own a b : X → Bool},
  Becoming.Weighting.WidensOn items a b ∧ Becoming.Weighting.AddsOwn items own a b ↔
    ∀ (R : (X → Bool) → (X → Bool) → Prop), Becoming.Weighting.IncreasingInOwn items own R → R b a
@Becoming.Weighting.every_increasingInOwn_iff_includes : ∀ {X : Type} {items : List X} {own a b : X → Bool},
  Becoming.Weighting.AddsOwn items own a b →
    ((∀ (R : (X → Bool) → (X → Bool) → Prop), Becoming.Weighting.IncreasingInOwn items own R → R b a) ↔
      Becoming.Weighting.IncludesOn items a b)
@Becoming.Weighting.some_increasingInOwn_reverses : ∀ {X : Type} {items : List X} {own a b : X → Bool},
  Becoming.Weighting.ExceedsOn items b a → ∃ R, Becoming.Weighting.IncreasingInOwn items own R ∧ R a b ∧ ¬R b a
@Becoming.Weighting.includes_of_ended : ∀ {X : Type} {items : List X} {late a b : X → Bool},
  (∀ (x : X), x ∈ items → late x = true → b x = false) →
    (∀ (x : X), x ∈ items → late x = false → a x = b x) → Becoming.Weighting.IncludesOn items a b
@Becoming.Weighting.ended_below : ∀ {Pos X : Type} {items : List X} {own : Pos → X → Bool} {late a b : X → Bool},
  (∀ (x : X), x ∈ items → late x = true → b x = false) →
    (∀ (x : X), x ∈ items → late x = false → a x = b x) →
      ∀ (p : Pos),
        Becoming.Weighting.AddsOwn items (own p) a b →
          ∀ (R : (X → Bool) → (X → Bool) → Prop), Becoming.Weighting.IncreasingInOwn items (own p) R → R b a
@Becoming.Flow.coupled_ending_ranked_below : ∀ {Pos X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {G : Becoming.SelectionTerm.Generations X},
          Becoming.SelectionTerm.Flow.Descended L W G →
            ∀ {ds : List X} {m : Nat},
              (∀ (t : Nat) (f : X),
                  f ∈ L.present t →
                    ∀ (d : X), d ∈ ds → 0 < L.give t f d → ∃ e, e ∈ ds ∧ W.requires t f e ∧ m ≤ W.need t f e) →
                ∀ {T n : Nat},
                  (∀ (k : Nat), k < n → L.replenishment ds (T + k) < L.uptake ds (T + k)) →
                    W.stock ds T < n + m →
                      (∀ (k : Nat) (p : X),
                          p ∈ G.family (T + n + k) →
                            ∃ e, e ∈ ds ∧ W.requires (T + n + k) p e ∧ m ≤ W.need (T + n + k) p e) →
                        ∀ {items : List (Nat × X)} {a b : Nat × X → Bool},
                          (∀ (x : Nat × X), x ∈ items → b x = true → x.snd ∈ G.family x.fst) →
                            (∀ (x : Nat × X), x ∈ items → x.fst ≤ T + n → a x = b x) →
                              ∀ {own : Pos → Nat × X → Bool} (p : Pos),
                                Becoming.Weighting.AddsOwn items (own p) a b →
                                  ∀ (R : (Nat × X → Bool) → (Nat × X → Bool) → Prop),
                                    Becoming.Weighting.IncreasingInOwn items (own p) R → R b a
@Becoming.Weighting.standingInvariant_of_gradeInvariant : ∀ {Pos X : Type} {grade : Pos → X → Nat},
  Becoming.Weighting.GradeInvariant grade → Becoming.Weighting.StandingInvariant grade
@Becoming.Weighting.weighed_eq_of_gradeInvariant : ∀ {Pos X : Type} {grade : Pos → X → Nat},
  Becoming.Weighting.GradeInvariant grade →
    ∀ (items : List X) (a : X → Bool) (p q : Pos),
      Becoming.Weighting.weighed items (grade p) a = Becoming.Weighting.weighed items (grade q) a
@Becoming.Weighting.ranks_alike_of_gradeInvariant : ∀ {Pos X : Type} {grade : Pos → X → Nat},
  Becoming.Weighting.GradeInvariant grade →
    ∀ (items : List X) (a b : X → Bool) (p q : Pos),
      Becoming.Weighting.weighed items (grade p) b < Becoming.Weighting.weighed items (grade p) a ↔
        Becoming.Weighting.weighed items (grade q) b < Becoming.Weighting.weighed items (grade q) a
@Becoming.Weighting.level_le_of_includes : ∀ {X : Type} {items : List X} {a b : X → Bool} (of : X → Bool),
  Becoming.Weighting.IncludesOn items a b → Becoming.Weighting.level items of b ≤ Becoming.Weighting.level items of a
@Becoming.Weighting.level_lt_of_includes_at : ∀ {X : Type} {items : List X} {a b of : X → Bool},
  Becoming.Weighting.IncludesOn items a b →
    ∀ {x : X},
      x ∈ items →
        a x = true →
          b x = false → of x = true → Becoming.Weighting.level items of b < Becoming.Weighting.level items of a
@Becoming.Weighting.le_of_strict : ∀ {f : Nat → Nat},
  (∀ (m n : Nat), m < n → f m < f n) → ∀ {m n : Nat}, m ≤ n → f m ≤ f n
@Becoming.Weighting.prior_lt_of_widens : ∀ {F X : Type} {gs : List F} {owner : F → X → Bool} {items : List X}
  {f : Nat → Nat},
  (∀ (m n : Nat), m < n → f m < f n) →
    (∀ (x : X), x ∈ items → ∃ g, g ∈ gs ∧ owner g x = true) →
      ∀ {a b : X → Bool},
        Becoming.Weighting.WidensOn items a b →
          Becoming.Weighting.prior gs owner items f b < Becoming.Weighting.prior gs owner items f a
@Becoming.Weighting.increasing_prior : ∀ {F X : Type} {gs : List F} {owner : F → X → Bool} {items : List X}
  {f : Nat → Nat},
  (∀ (m n : Nat), m < n → f m < f n) →
    (∀ (x : X), x ∈ items → ∃ g, g ∈ gs ∧ owner g x = true) →
      Becoming.Weighting.Increasing items fun b a =>
        Becoming.Weighting.prior gs owner items f b < Becoming.Weighting.prior gs owner items f a
@Becoming.Weighting.concave_gap : ∀ {n : Nat} {f : Nat → Nat},
  Becoming.Weighting.ConcaveTo n f → ∀ (a d : Nat), a + d + 2 ≤ n → f a + f (a + d + 2) < f (a + 1) + f (a + d + 1)
@Becoming.Weighting.prior_transfer : ∀ {F : Type} {n : Nat} {f : Nat → Nat},
  Becoming.Weighting.ConcaveTo n f →
    ∀ {g h : F} {rest : List F} {L L' : F → Nat} (a d : Nat),
      a + d + 2 ≤ n →
        L g = a + 1 →
          L h = a + d + 1 →
            L' g = a →
              L' h = a + d + 2 →
                (∀ (k : F), k ∈ rest → L k = L' k) →
                  (Becoming.total (g :: h :: rest) fun k => f (L' k)) < Becoming.total (g :: h :: rest) fun k => f (L k)
@Becoming.Weighting.sufficient_ties : ∀ {F : Type} {θ : Nat} {f : Nat → Nat},
  Becoming.Weighting.SufficientAt θ f →
    ∀ {gs : List F} {L L' : F → Nat},
      (∀ (k : F), k ∈ gs → L k = L' k ∨ θ ≤ L k ∧ θ ≤ L' k) →
        (Becoming.total gs fun k => f (L k)) = Becoming.total gs fun k => f (L' k)
