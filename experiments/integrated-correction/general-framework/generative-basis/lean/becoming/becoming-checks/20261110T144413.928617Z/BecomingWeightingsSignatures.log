@Becoming.Flow.replenishment_split : ∀ {F C : Type} [inst : DecidableEq F] {cs : List C} {g : F} (L : Becoming.Flow F C)
  (t : Nat),
  L.replenishment cs t =
    (Becoming.total (L.present t) fun x => if x = g then 0 else Becoming.total cs (L.give t x)) + L.givenFrom cs t g
@Becoming.Flow.others_le_capacityWithout : ∀ {F C : Type} [inst : DecidableEq F] {W : Becoming.Web F C}
  [inst_1 : (t : Nat) → (x : F) → Decidable (W.active t x)] {cap : Nat → F → Nat} {cs : List C} {ks : List F}
  {T n : Nat} {g : F} {L : Becoming.Flow F C},
  Becoming.Flow.FedOnlyWithin W cap cs (fun x => x ∈ ks) T n L →
    ∀ {t : Nat},
      T ≤ t →
