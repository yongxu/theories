@Becoming.Flow.routedDrawn_fedThroughStores : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C}
  {cap₂ : Nat → F → Nat} {cs : List C} {c₀ : C} {ks js : List F} {T n : Nat} {f e : F},
  Becoming.Distinct cs →
    c₀ ∈ cs →
      Becoming.Distinct ks →
        Becoming.Distinct js →
          ¬f ∈ ks →
            ¬f ∈ js →
              (∀ (h : F), h ∈ ks → ¬h ∈ js) →
                (∀ (h h' : F), h ∈ ks → h' ∈ ks → store h = store h' → h = h') →
                  (∀ (h : F), h ∈ ks → ¬store h ∈ cs) →
                    (∀ (t : Nat), T ≤ t → t < T + n → W.storesRisen store ks t ≤ W.capacityWithout cap₂ js e t) →
                      (∀ (t : Nat), T ≤ t → t < T + n → W.demand cs t ≤ W.othersThrough store cap₂ ks js e t) →
                        Becoming.Flow.FedThroughStores W store cs ks js cap₂ T n
                          (Becoming.Flow.routedDrawn W store cap₂ cs c₀ ks js T n f e)
@Becoming.Flow.routedDrawn_drawsPast : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C}
  {cap₂ : Nat → F → Nat} {cs : List C} {c₀ : C} {ks js : List F} {T n : Nat} {f e : F},
  c₀ ∈ cs →
    (∀ (t : Nat), T ≤ t → t < T + n → W.active t f) →
      W.stock cs T < n →
        Becoming.Flow.DrawsPast cs T n (Becoming.Flow.routedDrawn W store cap₂ cs c₀ ks js T n f e, W) f
@Becoming.Flow.routedDrawn_not_gives : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C}
  {cap₂ : Nat → F → Nat} {cs : List C} {c₀ : C} {ks js : List F} {T n : Nat} {f e : F},
  Becoming.Distinct cs →
    Becoming.Distinct ks →
      (∀ (h : F), h ∈ ks → ¬store h ∈ cs) →
        ¬Becoming.Flow.GivesInto cs ks store T n (Becoming.Flow.routedDrawn W store cap₂ cs c₀ ks js T n f e, W) e
@Becoming.Flow.needs_iff_through_short : ∀ {F C : Type} [inst : DecidableEq F] [DecidableEq C] {W : Becoming.Web F C}
  [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cap₂ : Nat → F → Nat} {cs : List C},
  Becoming.Distinct cs →
    ∀ {c₀ : C},
      c₀ ∈ cs →
        ∀ {ks js : List F},
          Becoming.Distinct ks →
            Becoming.Distinct js →
              (∀ (h : F), h ∈ ks → ¬h ∈ js) →
                ∀ {T n : Nat} {f e : F},
                  ¬f ∈ ks →
                    ¬f ∈ js →
                      (∀ (t : Nat), T ≤ t → t < T + n → W.active t f) →
                        W.stock cs T < n →
                          (∀ (h h' : F), h ∈ ks → h' ∈ ks → store h = store h' → h = h') →
                            (∀ (h : F), h ∈ ks → ¬store h ∈ cs) →
                              (Becoming.NeedsPart (Becoming.Flow.FedThroughStores W store cs ks js cap₂ T n)
                                  (fun L => Becoming.Flow.DrawsPast cs T n (L, W))
                                  (fun L => Becoming.Flow.GivesInto cs ks store T n (L, W)) f e ↔
                                ∃ t,
                                  T ≤ t ∧
                                    t < T + n ∧
                                      (W.capacityWithout cap₂ js e t < W.storesRisen store ks t ∨
                                        W.othersThrough store cap₂ ks js e t < W.demand cs t))
@Becoming.Flow.active_of_givesWithin : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Acting W →
    ∀ {cs : List C} {T n : Nat} {e : F},
      Becoming.Flow.GivesWithin cs T n (L, W) e → ∃ t, T ≤ t ∧ t < T + n ∧ W.active t e
@Becoming.Flow.active_of_givesInto : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Acting W →
    ∀ {cs : List C} {ks : List F} {store : F → C} {T n : Nat} {e : F},
      Becoming.Flow.GivesInto cs ks store T n (L, W) e → ∃ t, T ≤ t ∧ t < T + n ∧ W.active t e
@Becoming.Flow.needs_iff_none_of_inactive : ∀ {F C : Type} {W : Becoming.Web F C} {possible : Becoming.Flow F C → Prop},
  (∀ (L : Becoming.Flow F C), possible L → L.Acting W) →
    ∀ {cs : List C} {T n : Nat} {f e : F},
      (∀ (t : Nat), T ≤ t → t < T + n → ¬W.active t e) →
        (Becoming.NeedsPart possible (fun L => Becoming.Flow.DrawsPast cs T n (L, W))
            (fun L => Becoming.Flow.GivesWithin cs T n (L, W)) f e ↔
          ¬∃ L, possible L ∧ Becoming.Flow.DrawsPast cs T n (L, W) f)
@Becoming.Flow.needs_into_iff_none_of_inactive : ∀ {F C : Type} {W : Becoming.Web F C} {store : F → C} {cs : List C}
  {ks js : List F} {cap₂ : Nat → F → Nat} {T n : Nat} {f e : F},
  (∀ (t : Nat), T ≤ t → t < T + n → ¬W.active t e) →
    (Becoming.NeedsPart (Becoming.Flow.FedThroughStores W store cs ks js cap₂ T n)
        (fun L => Becoming.Flow.DrawsPast cs T n (L, W)) (fun L => Becoming.Flow.GivesInto cs ks store T n (L, W)) f e ↔
      ¬∃ L, Becoming.Flow.FedThroughStores W store cs ks js cap₂ T n L ∧ Becoming.Flow.DrawsPast cs T n (L, W) f)
@Becoming.Flow.gives_of_withinFeedingUpTo : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {f : F}
  {T : Nat} {g : F}, L.WithinFeedingUpTo W f T g → g = f ∨ ∃ s, s ≤ T ∧ g ∈ L.present s ∧ ∃ c, 0 < L.give s g c
@Becoming.Flow.active_of_withinFeedingUpTo : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C},
  L.Acting W → ∀ {f : F} {T : Nat} {g : F}, L.WithinFeedingUpTo W f T g → g = f ∨ ∃ s, s ≤ T ∧ W.active s g
@Becoming.Flow.withinFeeding_of_upTo : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {f : F} {T : Nat}
