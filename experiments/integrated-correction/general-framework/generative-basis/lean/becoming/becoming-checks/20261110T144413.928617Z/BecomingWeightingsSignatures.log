@Becoming.Flow.needs_giver_iff_store_short : ∀ {F C : Type} [inst : DecidableEq F] [DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C} {cs : List C},
  Becoming.Distinct cs →
    ∀ {c₀ : C},
      c₀ ∈ cs →
        ∀ {ks : List F},
          Becoming.Distinct ks →
            ∀ {T n : Nat} {f g : F},
              ¬f ∈ ks →
                (∀ (t : Nat), T ≤ t → t < T + n → W.active t f) →
                  W.stock cs T < n →
                    (∀ (h h' : F), h ∈ ks → h' ∈ ks → store h = store h' → h = h') →
                      (∀ (h : F), h ∈ ks → ¬store h ∈ cs) →
                        (∀ (t : Nat), T ≤ t → t < T + n → ∀ (h : F), h ∈ ks → ¬W.Rises t (store h)) →
                          (Becoming.NeedsPart (Becoming.Flow.FedFromStores W store cs ks T n)
                              (fun L => Becoming.Flow.DrawsPast cs T n (L, W))
                              (fun L => Becoming.Flow.GivesWithin cs T n (L, W)) f g ↔
