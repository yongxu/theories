              (∀ (h : F), h ∈ ks → ¬store h ∈ cs) →
                (∀ (t : Nat), T ≤ t → t < T + n → W.demand cs t ≤ W.othersThrough store cap₂ ks js e t) →
                  ∀ (t : Nat),
                    T ≤ t → t < T + n → (Becoming.Flow.routedDrawn W store cap₂ cs c₀ ks js T n f e).BalancesOn W cs t
@Becoming.Flow.routedDrawn_taken_store : ∀ {F C : Type} [inst : DecidableEq F] [inst_1 : DecidableEq C]
  {W : Becoming.Web F C} [inst_2 : (t : Nat) → (x : F) → Decidable (W.active t x)] {store : F → C}
  {cap₂ : Nat → F → Nat} {cs : List C} {c₀ : C} {ks js : List F} {T n : Nat} {f e : F},
