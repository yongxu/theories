@Becoming.Web.FirstApart.alike_before : ∀ {F C : Type} {W : Becoming.Web F C} {group : F → Prop} {l l' : Nat → C → Nat}
  {T : Nat} {select : (Nat → C → Nat) → Prop},
  W.FirstApart group l l' T →
