@Becoming.Web.alikeThroughAll_thresholdOnly_iff : ∀ {F C : Type} {W : Becoming.Web F C} {group : F → Prop}
  {l l' : Nat → C → Nat} {T : Nat},
  W.AlikeThroughAll Becoming.thresholdOnly group l l' T ↔
