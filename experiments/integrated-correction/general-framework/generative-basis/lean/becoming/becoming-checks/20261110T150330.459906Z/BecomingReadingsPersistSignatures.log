Becoming.ReadingsPersist.Habitat.world_byReading : ∀ (back : Bool) (σ : Becoming.ReadingsPersist.Habitat.Reading)
  (t : Nat) (x : Becoming.ReadingsPersist.Habitat.Rel) (l : Nat → Becoming.ReadingsPersist.Habitat.Rel → Nat)
