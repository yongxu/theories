@Becoming.TurningInTime.turns_in_time_iff : ∀ {W : Type u_1} {marked : Nat → Prop} [DecidablePred marked]
  {alone : W → W} {renew : W → Nat → W} {Kept : W → Prop} {giving : Nat → Nat} {use : W → Nat}
  {H₁ y₁ H₂ y₂ hi need : Nat},
  Becoming.TurningInTime.AloneOutside marked alone renew →
    (∀ (w : W) (x : Nat), marked x → Kept (renew w x)) →
