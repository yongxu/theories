            Becoming.RegimeMargin.Short giving H₂ y₂ →
              Becoming.RegimeMargin.Meets giving H₂ y₂ hi →
                Becoming.RegimeMargin.Keeps giving H₂ hi →
                  0 < need →
                    need ≤ H₂ + y₂ →
                      Becoming.RegimeMargin.Short giving H₁ y₁ →
                        ∀ {w : W} {x : Nat},
                          (∀ (j : Nat), H₁ ≤ use (Becoming.Law.orbit alone w j)) →
                            x < H₁ + y₁ →
                              x ≤ hi →
                                (Becoming.«不穷»
                                    (Becoming.TurningInTime.net need renew fun w x =>
                                      Becoming.RegimeMargin.step giving (use w) x)
                                    Becoming.«一» (w, x) ↔
                                  ∃ T,
                                    (∀ (j : Nat),
                                        j < T →
                                          need ≤
                                              (Becoming.Law.orbit
                                                  (Becoming.TurningInTime.asItWas alone fun w x =>
                                                    Becoming.RegimeMargin.step giving (use w) x)
                                                  (w, x) j).snd ∧
                                            ¬marked
                                                (Becoming.Law.orbit
                                                    (Becoming.TurningInTime.asItWas alone fun w x =>
                                                      Becoming.RegimeMargin.step giving (use w) x)
                                                    (w, x) j).snd) ∧
                                      need ≤
                                          (Becoming.Law.orbit
                                              (Becoming.TurningInTime.asItWas alone fun w x =>
                                                Becoming.RegimeMargin.step giving (use w) x)
                                              (w, x) T).snd ∧
                                        marked
                                            (Becoming.Law.orbit
                                                (Becoming.TurningInTime.asItWas alone fun w x =>
                                                  Becoming.RegimeMargin.step giving (use w) x)
                                                (w, x) T).snd ∧
                                          H₂ + y₂ ≤
                                            (Becoming.Law.orbit
                                                (Becoming.TurningInTime.asItWas alone fun w x =>
                                                  Becoming.RegimeMargin.step giving (use w) x)
                                                (w, x) (T + 1)).snd)
