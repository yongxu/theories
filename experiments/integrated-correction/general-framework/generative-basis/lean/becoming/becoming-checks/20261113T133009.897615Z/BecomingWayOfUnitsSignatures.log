  Becoming.TurningInTime.pair Becoming.WayOfUnits.after (Becoming.WayOfUnits.left giving) s = s →
    ∀ (k : Nat), Becoming.WayOfUnits.course giving s k = s
@Becoming.WayOfUnits.unending_of_fixed : ∀ {giving : Nat → Nat} {s : List (Nat × Nat) × Nat} {t : Nat},
  (∀ (j : Nat), j < t → Becoming.WayOfUnits.Goes (Becoming.WayOfUnits.course giving s j)) →
    Becoming.TurningInTime.pair Becoming.WayOfUnits.after (Becoming.WayOfUnits.left giving)
          (Becoming.WayOfUnits.course giving s t) =
        Becoming.WayOfUnits.course giving s t →
      Becoming.WayOfUnits.Goes (Becoming.WayOfUnits.course giving s t) →
        Becoming.«不穷» (Becoming.WayOfUnits.net giving) Becoming.«一» s
