@Becoming.LineOnAStock.mem_cond : ∀ {U : Type} {a : U} {l : List U} {b : Bool},
  (a ∈ bif b then l else []) → b = true ∧ a ∈ l
@Becoming.LineOnAStock.mem_cond_of : ∀ {U : Type} {a : U} {l : List U} {b : Bool},
  b = true → a ∈ l → a ∈ bif b then l else []
@Becoming.LineOnAStock.decide_le_congr : ∀ {n x x' : Nat}, (n ≤ x ↔ n ≤ x') → decide (n ≤ x) = decide (n ≤ x')
@Becoming.LineOnAStock.ite_le : ∀ {U : Type} {S : U → Prop} [inst : DecidablePred S] (u : U) (a : Nat),
  (if S u then a else 0) ≤ a
@Becoming.LineOnAStock.lineTake_le_taken : ∀ {U : Type} {S : U → Prop} [inst : DecidablePred S] {use : U → Nat}
  (w : List U), Becoming.LineOnAStock.lineTake S use w ≤ Becoming.LineOnAStock.taken use w
@Becoming.LineOnAStock.lineTake_append : ∀ {U : Type} {S : U → Prop} [inst : DecidablePred S] {use : U → Nat}
  (a b : List U),
  Becoming.LineOnAStock.lineTake S use (a ++ b) =
    Becoming.LineOnAStock.lineTake S use a + Becoming.LineOnAStock.lineTake S use b
@Becoming.LineOnAStock.lineCount_pos : ∀ {U : Type} {S : U → Prop} [inst : DecidablePred S] {u : U},
  S u → ∀ {w : List U}, u ∈ w → 0 < Becoming.LineOnAStock.lineCount S w
@Becoming.LineOnAStock.line_or_none : ∀ {U : Type} {S : U → Prop} [DecidablePred S] (w : List U),
  (∀ (u : U), u ∈ w → ¬S u) ∨ ∃ u, u ∈ w ∧ S u
@Becoming.LineOnAStock.met_or_unmet : ∀ {U : Type} (need : U → Nat) (z : Nat) (w : List U),
  (∀ (u : U), u ∈ w → need u ≤ z) ∨ ∃ u, u ∈ w ∧ z < need u
@Becoming.LineOnAStock.anyMet_iff : ∀ {U : Type} (need : U → Nat) (x : Nat) (w : List U),
  Becoming.LineOnAStock.anyMet need x w = true ↔ ∃ u, u ∈ w ∧ need u ≤ x
@Becoming.LineOnAStock.mem_of_ne_nil : ∀ {U : Type} {l : List U}, l ≠ [] → ∃ v, v ∈ l
@Becoming.LineOnAStock.strong_below : ∀ {P : Nat → Prop},
  (∀ (m : Nat), (∀ (m' : Nat), m' < m → P m') → P m) → ∀ (M m : Nat), m < M → P m
@Becoming.LineOnAStock.after_flatMap : ∀ {U : Type} {need : U → Nat} {kids : U → List U} (x : Nat) (w : List U),
  Becoming.LineOnAStock.after need kids w x = List.flatMap (fun u => bif decide (need u ≤ x) then kids u else []) w
@Becoming.LineOnAStock.mem_after_iff : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {x : Nat} {v : U} {w : List U},
  v ∈ Becoming.LineOnAStock.after need kids w x ↔ ∃ u, u ∈ w ∧ need u ≤ x ∧ v ∈ kids u
@Becoming.LineOnAStock.after_alike : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {x x' : Nat} {w : List U},
  (∀ (u : U), u ∈ w → (need u ≤ x ↔ need u ≤ x')) →
    Becoming.LineOnAStock.after need kids w x = Becoming.LineOnAStock.after need kids w x'
@Becoming.LineOnAStock.after_append : ∀ {U : Type} {need : U → Nat} {kids : U → List U} (x : Nat) (w₁ w₂ : List U),
  Becoming.LineOnAStock.after need kids (w₁ ++ w₂) x =
    Becoming.LineOnAStock.after need kids w₁ x ++ Becoming.LineOnAStock.after need kids w₂ x
@Becoming.LineOnAStock.left_of_taken : ∀ {U : Type} {giving : Nat → Nat} {use : U → Nat} {w₁ w₂ : List U} {x : Nat},
  Becoming.LineOnAStock.taken use w₁ = Becoming.LineOnAStock.taken use w₂ →
    Becoming.LineOnAStock.left giving use w₁ x = Becoming.LineOnAStock.left giving use w₂ x
@Becoming.LineOnAStock.after_of_met : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {x : Nat} {w : List U},
  (∀ (u : U), u ∈ w → need u ≤ x) → Becoming.LineOnAStock.after need kids w x = Becoming.LineOnAStock.allKids kids w
@Becoming.LineOnAStock.allKids_flatMap : ∀ {U : Type} {kids : U → List U} (w : List U),
  Becoming.LineOnAStock.allKids kids w = List.flatMap kids w
@Becoming.LineOnAStock.mem_allKids_iff : ∀ {U : Type} {kids : U → List U} {v : U} {w : List U},
  v ∈ Becoming.LineOnAStock.allKids kids w ↔ ∃ u, u ∈ w ∧ v ∈ kids u
@Becoming.LineOnAStock.generation_orbit : ∀ {U : Type} {kids : U → List U} (w : List U) (n : Nat),
  Becoming.LineOnAStock.generation kids n w = Becoming.Law.orbit (Becoming.LineOnAStock.allKids kids) w n
@Becoming.LineOnAStock.generation_mem : ∀ {U : Type} {kids : U → List U},
  (∀ (u : U), kids u ≠ []) →
    ∀ {v : U} {w : List U}, v ∈ w → ∀ (n : Nat), ∃ u, u ∈ Becoming.LineOnAStock.generation kids n w
@Becoming.LineOnAStock.generation_below : ∀ {U : Type} {need : U → Nat} {kids : U → List U},
  (∀ (u v : U), v ∈ kids u → need v ≤ need u) →
    ∀ {z : Nat} {w : List U},
      (∀ (u : U), u ∈ w → need u ≤ z) → ∀ (n : Nat) (u : U), u ∈ Becoming.LineOnAStock.generation kids n w → need u ≤ z
@Becoming.LineOnAStock.generation_ancestor : ∀ {U : Type} {need : U → Nat} {kids : U → List U},
  (∀ (u v : U), v ∈ kids u → need v ≤ need u) →
    ∀ {w : List U} (n : Nat) (u : U), u ∈ Becoming.LineOnAStock.generation kids n w → ∃ p, p ∈ w ∧ need u ≤ need p
@Becoming.LineOnAStock.mem_generation : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {giving : Nat → Nat}
  {use : U → Nat} (s : List U × Nat) (k : Nat) (u : U),
  u ∈ (Becoming.LineOnAStock.course need kids giving use s k).fst → u ∈ Becoming.LineOnAStock.generation kids k s.fst
@Becoming.LineOnAStock.alike_of_met : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {w : List U} {x x' : Nat},
  (∀ (u : U), u ∈ w → (need u ≤ x ↔ need u ≤ x')) → Becoming.LineOnAStock.Alike need kids w x x'
@Becoming.LineOnAStock.block_le : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {u : U} {x x' : Nat},
  x ≤ x' → (bif decide (need u ≤ x) then kids u else []).length ≤ (bif decide (need u ≤ x') then kids u else []).length
@Becoming.LineOnAStock.block_lt : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {u : U} {x x' : Nat},
  x < need u →
    need u ≤ x' →
      kids u ≠ [] →
        (bif decide (need u ≤ x) then kids u else []).length < (bif decide (need u ≤ x') then kids u else []).length
@Becoming.LineOnAStock.after_length_le : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {x x' : Nat},
  x ≤ x' →
    ∀ (w : List U),
      (Becoming.LineOnAStock.after need kids w x).length ≤ (Becoming.LineOnAStock.after need kids w x').length
@Becoming.LineOnAStock.after_length_lt : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {x x' : Nat},
  x ≤ x' →
    ∀ {u : U},
      x < need u →
        need u ≤ x' →
          kids u ≠ [] →
            ∀ {w : List U},
              u ∈ w →
                (Becoming.LineOnAStock.after need kids w x).length < (Becoming.LineOnAStock.after need kids w x').length
@Becoming.LineOnAStock.met_of_alike_le : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {w : List U} {x x' : Nat},
  x ≤ x' → Becoming.LineOnAStock.Alike need kids w x x' → ∀ {u : U}, u ∈ w → kids u ≠ [] → need u ≤ x' → need u ≤ x
@Becoming.LineOnAStock.alike_iff : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {w : List U} {x x' : Nat},
  (∀ (u : U), u ∈ w → kids u ≠ []) →
    (Becoming.LineOnAStock.Alike need kids w x x' ↔ ∀ (u : U), u ∈ w → (need u ≤ x ↔ need u ≤ x'))
@Becoming.LineOnAStock.need_in_after : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {x n : Nat} {w : List U},
  (∃ v, v ∈ Becoming.LineOnAStock.after need kids w x ∧ need v = n) →
    ∃ u v, u ∈ w ∧ need u ≤ x ∧ v ∈ kids u ∧ need v = n
@Becoming.LineOnAStock.needs_after_iff : ∀ {U : Type} {need : U → Nat} {kids : U → List U},
  (∀ (u v : U), v ∈ kids u → need v = need u) →
    (∀ (u : U), kids u ≠ []) →
      ∀ {x n : Nat} {w : List U},
        (∃ v, v ∈ Becoming.LineOnAStock.after need kids w x ∧ need v = n) ↔ ∃ u, u ∈ w ∧ need u = n ∧ n ≤ x
@Becoming.LineOnAStock.needs_kept : ∀ {U : Type} {need : U → Nat} {kids : U → List U},
  (∀ (u v : U), v ∈ kids u → need v = need u) →
    (∀ (u : U), kids u ≠ []) →
      ∀ {x n : Nat} {w : List U},
        (∀ (u : U), u ∈ w → need u ≤ x) →
          ((∃ v, v ∈ Becoming.LineOnAStock.after need kids w x ∧ need v = n) ↔ ∃ u, u ∈ w ∧ need u = n)
@Becoming.LineOnAStock.ways_alike : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {g g' : Nat → Nat}
  {use use' : U → Nat} {w : List U} {x x' n : Nat},
  (∀ (j : Nat),
      j < n →
        ∀ (u : U),
          u ∈ (Becoming.LineOnAStock.course need kids g use (w, x) j).fst →
            (need u ≤ (Becoming.LineOnAStock.course need kids g use (w, x) j).snd ↔
              need u ≤ (Becoming.LineOnAStock.course need kids g' use' (w, x') j).snd)) →
    ∀ (j : Nat),
      j ≤ n →
        (Becoming.LineOnAStock.course need kids g use (w, x) j).fst =
          (Becoming.LineOnAStock.course need kids g' use' (w, x') j).fst
@Becoming.LineOnAStock.family_eq : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {giving : Nat → Nat}
  {use : U → Nat} (s : List U × Nat) (t : Nat),
  (Becoming.LineOnAStock.generations need kids giving use s).family t =
    (Becoming.LineOnAStock.course need kids giving use s t).fst
@Becoming.LineOnAStock.born_eq_length : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {giving : Nat → Nat}
  {use : U → Nat} (s : List U × Nat) (t : Nat),
  Becoming.SelectionTerm.born ((Becoming.LineOnAStock.generations need kids giving use s).family t)
      ((Becoming.LineOnAStock.generations need kids giving use s).kids t) =
    (Becoming.LineOnAStock.course need kids giving use s (t + 1)).fst.length
@Becoming.LineOnAStock.born_alike : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {g g' : Nat → Nat}
  {use use' : U → Nat} {w : List U} {x x' n : Nat},
  (∀ (j : Nat),
      j < n →
        ∀ (u : U),
          u ∈ (Becoming.LineOnAStock.course need kids g use (w, x) j).fst →
            (need u ≤ (Becoming.LineOnAStock.course need kids g use (w, x) j).snd ↔
              need u ≤ (Becoming.LineOnAStock.course need kids g' use' (w, x') j).snd)) →
    ∀ {j : Nat},
      j < n →
        Becoming.SelectionTerm.born ((Becoming.LineOnAStock.generations need kids g use (w, x)).family j)
            ((Becoming.LineOnAStock.generations need kids g use (w, x)).kids j) =
          Becoming.SelectionTerm.born ((Becoming.LineOnAStock.generations need kids g' use' (w, x')).family j)
            ((Becoming.LineOnAStock.generations need kids g' use' (w, x')).kids j)
@Becoming.LineOnAStock.draw_rises : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {use : U → Nat} {S : U → Prop}
  [inst : DecidablePred S] {bonus : U → Nat},
  (∀ (u : U), S u → use u + bonus u ≤ Becoming.LineOnAStock.lineTake S use (kids u)) →
    ∀ {x : Nat} {w : List U},
      (∀ (u : U), u ∈ w → S u → need u ≤ x) →
        (Becoming.LineOnAStock.lineTake S use w + Becoming.total w fun u => if S u then bonus u else 0) ≤
          Becoming.LineOnAStock.lineTake S use (Becoming.LineOnAStock.after need kids w x)
@Becoming.LineOnAStock.rise : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {use : U → Nat} {S : U → Prop}
  [inst : DecidablePred S],
  (∀ (u : U), S u → use u < Becoming.LineOnAStock.lineTake S use (kids u)) →
    ∀ {x : Nat} {w : List U},
      (∀ (u : U), u ∈ w → S u → need u ≤ x) →
        Becoming.LineOnAStock.lineTake S use w + Becoming.LineOnAStock.lineCount S w ≤
          Becoming.LineOnAStock.lineTake S use (Becoming.LineOnAStock.after need kids w x)
@Becoming.LineOnAStock.draw_holds : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {use : U → Nat} {S : U → Prop}
  [inst : DecidablePred S],
  (∀ (u : U), S u → use u ≤ Becoming.LineOnAStock.lineTake S use (kids u)) →
    ∀ {x : Nat} {w : List U},
      (∀ (u : U), u ∈ w → S u → need u ≤ x) →
        Becoming.LineOnAStock.lineTake S use w ≤
          Becoming.LineOnAStock.lineTake S use (Becoming.LineOnAStock.after need kids w x)
@Becoming.LineOnAStock.line_from_line : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {S : U → Prop},
  (∀ (u v : U), v ∈ kids u → S v → S u) →
    ∀ {w : List U} {x : Nat} {v : U},
      v ∈ Becoming.LineOnAStock.after need kids w x → S v → ∃ u, u ∈ w ∧ need u ≤ x ∧ S u ∧ v ∈ kids u
@Becoming.LineOnAStock.none_after : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {S : U → Prop},
  (∀ (u v : U), v ∈ kids u → S v → S u) →
    ∀ {w : List U} {x : Nat},
      (∀ (u : U), u ∈ w → S u → x < need u) → ∀ (v : U), v ∈ Becoming.LineOnAStock.after need kids w x → ¬S v
@Becoming.LineOnAStock.never_in : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {use : U → Nat} {S : U → Prop},
  (∀ (u v : U), v ∈ kids u → S v → S u) →
    ∀ {giving : Nat → Nat} {s : List U × Nat},
      (∀ (u : U), u ∈ s.fst → ¬S u) →
        ∀ (j : Nat) (u : U), u ∈ (Becoming.LineOnAStock.course need kids giving use s j).fst → ¬S u
@Becoming.LineOnAStock.gone_from : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {use : U → Nat} {S : U → Prop},
  (∀ (u v : U), v ∈ kids u → S v → S u) →
    ∀ {giving : Nat → Nat} {s : List U × Nat} {k : Nat},
      (∀ (u : U), u ∈ (Becoming.LineOnAStock.course need kids giving use s k).fst → ¬S u) →
        ∀ (j : Nat), k ≤ j → ∀ (u : U), u ∈ (Becoming.LineOnAStock.course need kids giving use s j).fst → ¬S u
@Becoming.LineOnAStock.gone_after : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {use : U → Nat} {S : U → Prop},
  (∀ (u v : U), v ∈ kids u → S v → S u) →
    ∀ {giving : Nat → Nat} {s : List U × Nat} {k : Nat},
      (∀ (u : U),
          u ∈ (Becoming.LineOnAStock.course need kids giving use s k).fst →
            S u → (Becoming.LineOnAStock.course need kids giving use s k).snd < need u) →
        ∀ (j : Nat), k + 1 ≤ j → ∀ (u : U), u ∈ (Becoming.LineOnAStock.course need kids giving use s j).fst → ¬S u
@Becoming.LineOnAStock.step_zero : ∀ {giving : Nat → Nat} {H x : Nat},
  Becoming.RegimeMargin.FromNothing giving → x ≤ H → Becoming.RegimeMargin.step giving H x = 0
@Becoming.LineOnAStock.step_overdrawn : ∀ {giving : Nat → Nat} {T H x : Nat},
  (∀ (z : Nat), giving z < T) →
    T ≤ H → Becoming.RegimeMargin.step giving H x < x ∨ Becoming.RegimeMargin.step giving H x = giving 0
@Becoming.LineOnAStock.step_lowers : ∀ {giving : Nat → Nat} {H y D z : Nat},
  Becoming.RegimeMargin.Short giving H y →
    Becoming.RegimeMargin.FromNothing giving →
      H ≤ D → z < H + y → Becoming.RegimeMargin.step giving D z = 0 ∨ Becoming.RegimeMargin.step giving D z < z
@Becoming.LineOnAStock.fall_low : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {use : U → Nat} {giving : Nat → Nat}
  {S : U → Prop},
  (∀ (u v : U), v ∈ kids u → S v → S u) →
    ∀ {m : Nat},
      (∀ (u : U), S u → need u = m) →
        ∀ {s : List U × Nat} {k : Nat},
          (Becoming.LineOnAStock.course need kids giving use s k).snd < m →
            ∃ n, ∀ (j : Nat), n ≤ j → ∀ (u : U), u ∈ (Becoming.LineOnAStock.course need kids giving use s j).fst → ¬S u
@Becoming.LineOnAStock.fall_from : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {use : U → Nat}
  {giving : Nat → Nat} {S : U → Prop} [inst : DecidablePred S],
  (∀ (u v : U), v ∈ kids u → S v → S u) →
    ∀ {m : Nat},
      (∀ (u : U), S u → need u = m) →
        (∀ (u : U), S u → use u ≤ Becoming.LineOnAStock.lineTake S use (kids u)) →
          giving 0 < m →
            ∀ (s : List U × Nat) (f k : Nat),
              (Becoming.LineOnAStock.course need kids giving use s k).snd ≤ f →
                (∀ (z : Nat),
                    giving z <
                      Becoming.LineOnAStock.lineTake S use
                        (Becoming.LineOnAStock.course need kids giving use s k).fst) →
                  ∃ n,
                    ∀ (j : Nat),
                      n ≤ j → ∀ (u : U), u ∈ (Becoming.LineOnAStock.course need kids giving use s j).fst → ¬S u
@Becoming.LineOnAStock.fall : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {use : U → Nat} {giving : Nat → Nat}
  {S : U → Prop} [inst : DecidablePred S],
  (∀ (u v : U), v ∈ kids u → S v → S u) →
    ∀ {m : Nat},
      (∀ (u : U), S u → need u = m) →
        (∀ (u : U), S u → use u ≤ Becoming.LineOnAStock.lineTake S use (kids u)) →
          giving 0 < m →
            ∀ {w : List U} {x : Nat},
              (∀ (z : Nat), giving z < Becoming.LineOnAStock.lineTake S use w) →
                ∃ n,
                  ∀ (k : Nat),
                    n ≤ k → ∀ (u : U), u ∈ (Becoming.LineOnAStock.course need kids giving use (w, x) k).fst → ¬S u
@Becoming.LineOnAStock.below_after : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {S : U → Prop},
  (∀ (u v : U), v ∈ kids u → S v → S u) →
    (∀ (u v : U), S u → v ∈ kids u → need v ≤ need u) →
      ∀ (w : List U) (x : Nat), Becoming.LineOnAStock.Below need S x (Becoming.LineOnAStock.after need kids w x)
@Becoming.LineOnAStock.below_keeps : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {S : U → Prop},
  (∀ (u v : U), v ∈ kids u → S v → S u) →
    (∀ (u v : U), S u → v ∈ kids u → need v ≤ need u) →
      ∀ {m : Nat} {w : List U},
        Becoming.LineOnAStock.Below need S m w →
          ∀ (x : Nat), Becoming.LineOnAStock.Below need S m (Becoming.LineOnAStock.after need kids w x)
@Becoming.LineOnAStock.none_shift : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {use : U → Nat}
  {giving : Nat → Nat} {S : U → Prop} {s : List U × Nat} {j : Nat},
  Becoming.LineOnAStock.NoneMet need S
      (Becoming.LineOnAStock.course need kids giving use (Becoming.LineOnAStock.step need kids giving use s) j) →
    ∃ k, Becoming.LineOnAStock.NoneMet need S (Becoming.LineOnAStock.course need kids giving use s k)
@Becoming.LineOnAStock.ends_low : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {use : U → Nat} {giving : Nat → Nat}
  {S : U → Prop} {hi : Nat},
  Becoming.RegimeMargin.Keeps giving 0 hi →
    (∀ (u v : U), v ∈ kids u → S v → S u) →
      (∀ (u v : U), S u → v ∈ kids u → need v ≤ need u) →
        ∀ {m : Nat},
          (∀ (m' : Nat), m' < m → Becoming.LineOnAStock.Ends need kids giving use S hi m') →
            ∀ (s : List U × Nat),
              s.snd ≤ hi →
                s.snd < m →
                  ∃ k, Becoming.LineOnAStock.NoneMet need S (Becoming.LineOnAStock.course need kids giving use s k)
@Becoming.LineOnAStock.ends_high : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {use : U → Nat}
  {giving : Nat → Nat} {S : U → Prop} {hi : Nat} [inst : DecidablePred S],
  Becoming.RegimeMargin.FromNothing giving →
    Becoming.RegimeMargin.Keeps giving 0 hi →
      (∀ (u v : U), v ∈ kids u → S v → S u) →
        (∀ (u : U), S u → use u < Becoming.LineOnAStock.lineTake S use (kids u)) →
          (∀ (u : U), S u → 0 < need u) →
            (∀ (u v : U), S u → v ∈ kids u → need v ≤ need u) →
              ∀ {m : Nat},
                (∀ (m' : Nat), m' < m → Becoming.LineOnAStock.Ends need kids giving use S hi m') →
                  ∀ (k : Nat) (s : List U × Nat),
                    s.snd ≤ hi →
                      Becoming.LineOnAStock.Below need S m s.fst →
                        m ≤ s.snd →
                          hi + 1 ≤ Becoming.LineOnAStock.lineTake S use s.fst + k →
                            ∃ j,
                              Becoming.LineOnAStock.NoneMet need S
                                (Becoming.LineOnAStock.course need kids giving use s j)
@Becoming.LineOnAStock.ends_all : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {use : U → Nat} {giving : Nat → Nat}
  {S : U → Prop} {hi : Nat} [inst : DecidablePred S],
  Becoming.RegimeMargin.FromNothing giving →
    Becoming.RegimeMargin.Keeps giving 0 hi →
      (∀ (u v : U), v ∈ kids u → S v → S u) →
        (∀ (u : U), S u → use u < Becoming.LineOnAStock.lineTake S use (kids u)) →
          (∀ (u : U), S u → 0 < need u) →
            (∀ (u v : U), S u → v ∈ kids u → need v ≤ need u) →
              ∀ (m : Nat), Becoming.LineOnAStock.Ends need kids giving use S hi m
@Becoming.LineOnAStock.line_ends : ∀ {U : Type} {need : U → Nat} {kids : U → List U} {use : U → Nat}
  {giving : Nat → Nat} {S : U → Prop} {hi : Nat} [inst : DecidablePred S],
  Becoming.RegimeMargin.FromNothing giving →
    Becoming.RegimeMargin.Keeps giving 0 hi →
