        Becoming.«一» ([()], 3)
Becoming.LineOnAStock.DrainCase.late : ∀ (t : Nat),
  Becoming.LineOnAStock.course Becoming.LineOnAStock.DrainCase.need Becoming.LineOnAStock.DrainCase.kids
      Becoming.LineOnAStock.DrainCase.gift Becoming.LineOnAStock.DrainCase.use
      ([Becoming.LineOnAStock.DrainCase.Kind.r, Becoming.LineOnAStock.DrainCase.Kind.d0], 11) (t + 10) =
