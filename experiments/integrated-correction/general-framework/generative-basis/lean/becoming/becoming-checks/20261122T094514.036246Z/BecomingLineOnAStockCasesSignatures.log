              Becoming.LineOnAStock.nothingGiven Becoming.LineOnAStock.Doubling.use ([()], 3) t).snd ∧
        ((∃ p,
            p ∈ Becoming.LineageRegimes.MultiplyingTakers.generations.family t ∧
              Becoming.LineageRegimes.MultiplyingTakers.web.active t p) ↔
          Becoming.LineOnAStock.Goes Becoming.LineOnAStock.Doubling.need
            (Becoming.LineOnAStock.course Becoming.LineOnAStock.Doubling.need Becoming.LineOnAStock.Doubling.kids
              Becoming.LineOnAStock.nothingGiven Becoming.LineOnAStock.Doubling.use ([()], 3) t))) ∧
  (∃ t,
      ¬∃ p,
