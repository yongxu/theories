Becoming.LineOnAStock.MultiplyingTakersCase.late : ∀ (t : Nat),
  Becoming.LineOnAStock.course Becoming.LineOnAStock.Doubling.need Becoming.LineOnAStock.Doubling.kids
      Becoming.LineOnAStock.nothingGiven Becoming.LineOnAStock.Doubling.use ([()], 3) (t + 3) =
