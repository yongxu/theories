@Becoming.PacedStock.blocks_keepable_to_fine_of_choice : ∀ {S : Type u_1} {A : Type u_2} {B : Type u_3} {C : Type u_4}
  (F : Becoming.Frame S A C) (expand : B → List A) (guard : S → Prop) {s : S},
  (∀ (R : Nat → List S → Prop), (∀ (n : Nat), ∃ xs, R n xs) → ∃ f, ∀ (n : Nat), R n (f n)) →
    (∀ (b : B), expand b ≠ []) →
      Becoming.Viability.Keepable (F.blocks expand).P (Becoming.PacedStock.SpanGuard F expand guard) s →
