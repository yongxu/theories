@Becoming.PacedStock.blocks_keepable_to_fine_of_dc : ∀ {S : Type u_1} {A : Type u_2} {B : Type u_3} {C : Type u_4}
  (F : Becoming.Frame S A C) (expand : B → List A) (guard : S → Prop) {s : S},
  (∀ (α : Type u_1) (R : α → α → Prop),
      (∀ (x : α), ∃ y, R x y) → ∀ (x : α), ∃ f, f 0 = x ∧ ∀ (n : Nat), R (f n) (f (n + 1))) →
    (∀ (b : B), expand b ≠ []) →
      Becoming.Viability.Keepable (F.blocks expand).P (Becoming.PacedStock.SpanGuard F expand guard) s →
        Becoming.Viability.Keepable F.P guard s
@Becoming.PacedStock.slack_certifies_fine_kernel : ∀ {S : Type u_1} {A : Type u_2} {B : Type u_3} {C : Type u_4}
  (F : Becoming.Frame S A C) (expand : B → List A) (stock : S → Nat) (thr stepDrop L : Nat) {s : S},
  Becoming.PacedStock.CoveredByBlocks F expand s →
    (∀ {u : S} {a : A} {w : S}, Becoming.Reach F.P s u → F.P.step u a w → stock u ≤ stock w + stepDrop) →
      (∀ (blk : B), (expand blk).length ≤ L) →
        Becoming.Viability.Kernel (F.blocks expand).P (fun v => thr + stepDrop * (L - 1) ≤ stock v) s →
          Becoming.Viability.Kernel F.P (fun v => thr ≤ stock v) s
@Becoming.PacedStock.slack_certifies_fine_kernel_global : ∀ {S : Type u_1} {A : Type u_2} {B : Type u_3} {C : Type u_4}
  (F : Becoming.Frame S A C) (expand : B → List A) (stock : S → Nat) (thr stepDrop L : Nat) {s : S},
  Becoming.PacedStock.CoveredByBlocks F expand s →
    (∀ {u : S} {a : A} {w : S}, F.P.step u a w → stock u ≤ stock w + stepDrop) →
      (∀ (blk : B), (expand blk).length ≤ L) →
        Becoming.Viability.Kernel (F.blocks expand).P (fun v => thr + stepDrop * (L - 1) ≤ stock v) s →
          Becoming.Viability.Kernel F.P (fun v => thr ≤ stock v) s
@Becoming.PacedStock.slack_iff_of_drop_realized : ∀ {S : Type u_1} {A : Type u_2} {B : Type u_3} {C : Type u_4}
  (F : Becoming.Frame S A C) (expand : B → List A) (stock : S → Nat) (thr stepDrop L : Nat) {s : S},
  Becoming.PacedStock.CoveredByBlocks F expand s →
    (∀ {u : S} {a : A} {w : S}, Becoming.Reach F.P s u → F.P.step u a w → stock u ≤ stock w + stepDrop) →
      (∀ (blk : B), (expand blk).length ≤ L) →
        (∀ (v : S),
            thr ≤ stock v →
              Becoming.Reach (F.blocks expand).P s v →
                ∃ blk pre post,
                  expand blk = pre ++ post ∧
                    ∃ m, Generative.Trace F.P v pre m ∧ stock m + stepDrop * (L - 1) ≤ stock v) →
          (Becoming.Viability.Kernel (F.blocks expand).P (fun v => thr + stepDrop * (L - 1) ≤ stock v) s ↔
            Becoming.Viability.Kernel F.P (fun v => thr ≤ stock v) s)
