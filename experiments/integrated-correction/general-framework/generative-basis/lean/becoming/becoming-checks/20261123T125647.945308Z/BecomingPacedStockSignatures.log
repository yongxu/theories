@Becoming.PacedStock.fineStep_orbit_fst : ∀ {A U R : Type} {fA : A → R → A} {need : U → Nat} {kids : R → U → List U}
  {giving : Nat → Nat} {use : U → Nat} (s : Becoming.PacedStock.StockState A U) (g : R) (k : Nat),
  (Becoming.Law.orbit (fun y => Becoming.PacedStock.fineStep fA need kids giving use y g) s k).fst =
    Becoming.Law.orbit (fun a => fA a g) s.fst k
@Becoming.PacedStock.fineStep_orbit_snd : ∀ {A U R : Type} {fA : A → R → A} {need : U → Nat} {kids : R → U → List U}
  {giving : Nat → Nat} {use : U → Nat} (s : Becoming.PacedStock.StockState A U) (g : R) (k : Nat),
  (Becoming.Law.orbit (fun y => Becoming.PacedStock.fineStep fA need kids giving use y g) s k).snd =
    Becoming.Law.orbit (Becoming.LineOnAStock.step need (kids g) giving use) s.snd k
@Becoming.PacedStock.paced_held_on_span_state : ∀ {A U R : Type} {fA : A → R → A} {need : U → Nat}
  {kids : R → U → List U} {giving : Nat → Nat} {use : U → Nat} {h : Becoming.PacedStock.StockState A U → R → R}
  {reads : Nat → Bool} {σ : Nat → Nat},
  Becoming.Strict σ →
    Becoming.PacedStock.ReadAtSpanEnd σ reads →
      ∀ (c : Becoming.PacedStock.StockState A U × R) {j t : Nat},
        t ∈ Becoming.span σ j →
          Becoming.PacedStock.pacedCourse fA need kids giving use h reads c t =
            (Becoming.Law.orbit
                (fun y =>
                  Becoming.PacedStock.fineStep fA need kids giving use y
                    (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c (σ j)).snd)
                (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c (σ j)).fst (t - σ j),
              (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c (σ j)).snd)
@Becoming.PacedStock.paced_held_on_span : ∀ {A U R : Type} {fA : A → R → A} {need : U → Nat} {kids : R → U → List U}
  {giving : Nat → Nat} {use : U → Nat} {h : Becoming.PacedStock.StockState A U → R → R} {reads : Nat → Bool}
  {σ : Nat → Nat},
  Becoming.Strict σ →
    Becoming.PacedStock.ReadAtSpanEnd σ reads →
      ∀ (c : Becoming.PacedStock.StockState A U × R) {j t : Nat},
        t ∈ Becoming.span σ j →
          (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c t).snd =
              (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c (σ j)).snd ∧
            (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c t).fst.snd =
              Becoming.Law.orbit
                (Becoming.LineOnAStock.step need
                  (kids (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c (σ j)).snd) giving use)
                (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c (σ j)).fst.snd (t - σ j)
@Becoming.PacedStock.paced_block_transition : ∀ {A U R : Type} {fA : A → R → A} {need : U → Nat} {kids : R → U → List U}
  {giving : Nat → Nat} {use : U → Nat} {h : Becoming.PacedStock.StockState A U → R → R} {reads : Nat → Bool}
  {σ : Nat → Nat},
  Becoming.Strict σ →
    Becoming.PacedStock.ReadAtSpanEnd σ reads →
      ∀ (c : Becoming.PacedStock.StockState A U × R) (j : Nat),
        (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c (σ (j + 1))).fst =
            Becoming.Law.orbit
              (fun y =>
                Becoming.PacedStock.fineStep fA need kids giving use y
                  (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c (σ j)).snd)
              (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c (σ j)).fst (σ (j + 1) - σ j) ∧
          (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c (σ (j + 1))).snd =
            h (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c (σ (j + 1) - 1)).fst
              (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c (σ j)).snd
@Becoming.PacedStock.blocks_reach_to_fine : ∀ {S : Type u_1} {A : Type u_2} {B : Type u_3} {C : Type u_4}
  (F : Becoming.Frame S A C) (expand : B → List A) {s v : S},
