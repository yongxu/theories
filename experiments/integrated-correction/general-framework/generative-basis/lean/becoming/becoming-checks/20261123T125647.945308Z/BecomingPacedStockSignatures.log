@Becoming.PacedStock.line_envelope_lower : ∀ {U R : Type} {need use : U → Nat} {kids : R → U → List U}
  {giving : Nat → Nat} {H : Nat} {g : R} {w : List U} {x k : Nat},
  Becoming.PacedStock.UpperDraw need use kids giving H g w x k →
    ∀ (j : Nat),
      j ≤ k →
        Becoming.Law.orbit (Becoming.RegimeMargin.step (fun x => 0) H) x j ≤
          (Becoming.LineOnAStock.course need (kids g) giving use (w, x) j).snd
@Becoming.PacedStock.line_envelope_upper : ∀ {U R : Type} {need use : U → Nat} {kids : R → U → List U}
  {giving : Nat → Nat} {Y H₁ : Nat} {g : R} {w : List U} {x k : Nat},
  Becoming.RegimeMargin.FromNothing giving →
    Becoming.RegimeMargin.AtMost giving Y →
      Becoming.PacedStock.LowerDrawWhileMet H₁ need kids giving use g w x k →
        (∀ (t : Nat),
            t < k →
              ∀ (u : U),
                u ∈ (Becoming.LineOnAStock.course need (kids g) giving use (w, x) t).fst →
                  need u ≤ (Becoming.LineOnAStock.course need (kids g) giving use (w, x) t).snd) →
          ∀ (j : Nat),
            j ≤ k →
              (Becoming.LineOnAStock.course need (kids g) giving use (w, x) j).snd ≤
                Becoming.Law.orbit (Becoming.RegimeMargin.step (fun x => Y) H₁) x j
@Becoming.PacedStock.line_envelope : ∀ {U R : Type} {need use : U → Nat} {kids : R → U → List U} {giving : Nat → Nat}
  {H Y H₁ : Nat} {g : R} {w : List U} {x k : Nat},
  (Becoming.PacedStock.UpperDraw need use kids giving H g w x k →
      Becoming.Law.orbit (Becoming.RegimeMargin.step (fun x => 0) H) x k ≤
          (Becoming.LineOnAStock.course need (kids g) giving use (w, x) k).snd ∧
        ∀ (b : Nat), b + H * k ≤ x → b ≤ (Becoming.LineOnAStock.course need (kids g) giving use (w, x) k).snd) ∧
    (Becoming.RegimeMargin.FromNothing giving →
      Becoming.RegimeMargin.AtMost giving Y →
        Becoming.PacedStock.LowerDrawWhileMet H₁ need kids giving use g w x k →
          (∀ (t : Nat),
              t < k →
                ∀ (u : U),
                  u ∈ (Becoming.LineOnAStock.course need (kids g) giving use (w, x) t).fst →
                    need u ≤ (Becoming.LineOnAStock.course need (kids g) giving use (w, x) t).snd) →
            (Becoming.LineOnAStock.course need (kids g) giving use (w, x) k).snd ≤
              Becoming.Law.orbit (Becoming.RegimeMargin.step (fun x => Y) H₁) x k)
@Becoming.PacedStock.pace_margin_feasibility_window : ∀ {A U R O : Type} {fA : A → R → A} {need : U → Nat}
  {kids : R → U → List U} {giving : Nat → Nat} {use : U → Nat} {h : Becoming.PacedStock.StockState A U → R → R}
  {reads : Nat → Bool} {σ : Nat → Nat} {N L H₁ H₂ y₂ hi : Nat} {x_o y_o : O},
  x_o ≠ y_o →
    σ 0 = 0 →
      σ 1 = L →
        Becoming.Strict σ →
          Becoming.PacedStock.ReadAtSpanEnd σ reads →
            2 * N - 1 ≤ L →
              ∀ {a₀ : A} {w₀ : List U} {x₀ : Nat} {g_bad g_safe : R},
                x₀ ≤ hi →
                  Becoming.RegimeMargin.Keeps giving 0 hi →
                    Becoming.RegimeMargin.Short giving H₂ y₂ →
                      Becoming.RegimeMargin.Meets giving H₂ y₂ hi →
                        Becoming.RegimeMargin.Keeps giving H₂ hi →
                          H₂ + H₂ + y₂ ≤ hi →
                            (∀ (u : U), 0 < need u ∧ need u ≤ H₂ + y₂) →
                              w₀ ≠ [] →
                                (∀ (g : R) (u : U), kids g u ≠ []) →
                                  Becoming.LineOnAStock.taken use
                                        (Becoming.LineOnAStock.allKids (kids g_safe)
                                          (Becoming.LineOnAStock.generation (kids g_bad) L w₀)) ≤
                                      H₂ →
                                    (∀ (w : List U),
                                        Becoming.LineOnAStock.taken use w ≤ H₂ →
                                          Becoming.LineOnAStock.taken use
                                              (Becoming.LineOnAStock.allKids (kids g_safe) w) ≤
                                            H₂) →
                                      Becoming.PacedStock.UpperDraw need use kids giving H₁ g_bad w₀ x₀ (L + 1) →
                                        H₂ + y₂ + H₁ * (L + 1) ≤ x₀ →
                                          (Becoming.PacedStock.pacedCourse fA need kids giving use h reads
                                                  ((a₀, w₀, x₀), g_bad) (σ 1)).snd =
                                              g_safe →
                                            (∀ (s : Becoming.PacedStock.StockState A U), h s g_safe = g_safe) →
                                              Becoming.Pace.StretchFixes O N L ∧
                                                ∀ (t : Nat),
                                                  L + 1 ≤ t →
                                                    H₂ + y₂ ≤
                                                        (Becoming.PacedStock.pacedCourse fA need kids giving use h reads
                                                                ((a₀, w₀, x₀), g_bad) t).fst.snd.snd ∧
                                                      (Becoming.PacedStock.pacedCourse fA need kids giving use h reads
                                                                  ((a₀, w₀, x₀), g_bad) t).fst.snd.snd ≤
                                                          hi ∧
                                                        Becoming.LineOnAStock.Goes need
                                                          (Becoming.PacedStock.pacedCourse fA need kids giving use h
                                                                reads ((a₀, w₀, x₀), g_bad) t).fst.snd
@Becoming.PacedStock.pace_margin_feasibility_window_exact : ∀ {A U R O : Type} {fA : A → R → A} {need : U → Nat}
  {kids : R → U → List U} {giving : Nat → Nat} {use : U → Nat} {h : Becoming.PacedStock.StockState A U → R → R}
  {reads : Nat → Bool} {σ : Nat → Nat} {N L H₁ H₂ y₂ hi : Nat} {x_o y_o : O},
  x_o ≠ y_o →
    σ 0 = 0 →
      σ 1 = L →
        Becoming.Strict σ →
          Becoming.PacedStock.ReadAtSpanEnd σ reads →
            2 * N - 1 ≤ L →
              ∀ {a₀ : A} {w₀ : List U} {x₀ : Nat} {g_bad g_safe : R},
                x₀ ≤ hi →
                  Becoming.RegimeMargin.Keeps giving 0 hi →
                    Becoming.RegimeMargin.Short giving H₂ y₂ →
                      Becoming.RegimeMargin.Meets giving H₂ y₂ hi →
                        Becoming.RegimeMargin.Keeps giving H₂ hi →
                          (∀ (u : U), 0 < need u ∧ need u ≤ H₂ + y₂) →
                            w₀ ≠ [] →
                              (∀ (g : R) (u : U), kids g u ≠ []) →
                                Becoming.LineOnAStock.taken use
                                      (Becoming.LineOnAStock.allKids (kids g_safe)
                                        (Becoming.LineOnAStock.generation (kids g_bad) L w₀)) =
                                    H₂ →
                                  (∀ (w : List U),
                                      Becoming.LineOnAStock.taken use w = H₂ →
                                        Becoming.LineOnAStock.taken use
                                            (Becoming.LineOnAStock.allKids (kids g_safe) w) =
                                          H₂) →
                                    Becoming.PacedStock.UpperDraw need use kids giving H₁ g_bad w₀ x₀ (L + 1) →
                                      H₂ + y₂ + H₁ * (L + 1) ≤ x₀ →
                                        (Becoming.PacedStock.pacedCourse fA need kids giving use h reads
                                                ((a₀, w₀, x₀), g_bad) (σ 1)).snd =
                                            g_safe →
                                          (∀ (s : Becoming.PacedStock.StockState A U), h s g_safe = g_safe) →
                                            Becoming.Pace.StretchFixes O N L ∧
                                              ∀ (t : Nat),
                                                L + 1 ≤ t →
                                                  H₂ + y₂ ≤
                                                      (Becoming.PacedStock.pacedCourse fA need kids giving use h reads
                                                              ((a₀, w₀, x₀), g_bad) t).fst.snd.snd ∧
                                                    (Becoming.PacedStock.pacedCourse fA need kids giving use h reads
                                                                ((a₀, w₀, x₀), g_bad) t).fst.snd.snd ≤
                                                        hi ∧
                                                      Becoming.LineOnAStock.Goes need
                                                        (Becoming.PacedStock.pacedCourse fA need kids giving use h reads
                                                              ((a₀, w₀, x₀), g_bad) t).fst.snd
@Becoming.PacedStock.unrecoverable_cadence_impossibility : ∀ {A U R O : Type} {fA : A → R → A} {need : U → Nat}
  {kids : R → U → List U} {giving : Nat → Nat} {use : U → Nat} {N Y H₁ H₂ y₂ : Nat} {x_o y_o : O},
  2 ≤ N →
    x_o ≠ y_o →
      Becoming.RegimeMargin.FromNothing giving →
        Becoming.RegimeMargin.AtMost giving Y →
          Y < H₁ →
            H₁ ≤ H₂ + y₂ →
              Becoming.RegimeMargin.Short giving H₂ y₂ →
                (∀ (u : U), 0 < need u ∧ need u ≤ H₂ + y₂) →
                  ∀ {g_bad : R} {w₀ : List U} {x₀ : Nat},
                    Becoming.PacedStock.LowerDrawWhileMet H₁ need kids giving use g_bad w₀ x₀ (2 * N - 1) →
                      (∀ (w : List U), w ≠ [] → H₂ ≤ Becoming.LineOnAStock.taken use w) →
                        x₀ < H₂ + y₂ + (H₁ - Y) * (2 * N - 1) →
                          (∀ (L : Nat),
                              L < 2 * N - 1 →
                                ¬Becoming.Pace.StretchFixes O N L ∧
                                  Becoming.StatesBelow
                                      (Becoming.Pace.heldCourse Becoming.Pace.lassoStep (0, N - 2 + 1)
                                        (fun p => if p = N - 2 + 1 then y_o else x_o) 0)
                                      N ∧
                                    Becoming.StatesBelow
                                        (Becoming.Pace.heldCourse Becoming.Pace.lassoStep (1, N - 2)
                                          (fun p => if p = N - 2 + 1 then y_o else x_o) 0)
                                        N ∧
                                      (∀ (t : Nat),
                                          t < L →
                                            Becoming.Pace.heldCourse Becoming.Pace.lassoStep (0, N - 2 + 1)
                                                (fun p => if p = N - 2 + 1 then y_o else x_o) 0 t =
                                              Becoming.Pace.heldCourse Becoming.Pace.lassoStep (1, N - 2)
                                                (fun p => if p = N - 2 + 1 then y_o else x_o) 0 t) ∧
                                        Becoming.Pace.heldCourse Becoming.Pace.lassoStep (0, N - 2 + 1)
                                            (fun p => if p = N - 2 + 1 then y_o else x_o) 0 (2 * N - 2) ≠
                                          Becoming.Pace.heldCourse Becoming.Pace.lassoStep (1, N - 2)
                                            (fun p => if p = N - 2 + 1 then y_o else x_o) 0 (2 * N - 2)) ∧
                            ∀ (L : Nat) (σ : Nat → Nat) (reads : Nat → Bool)
                              (h : Becoming.PacedStock.StockState A U → R → R) (a₀ : A),
                              2 * N - 1 ≤ L →
                                σ 0 = 0 →
                                  σ 1 = L →
                                    Becoming.Strict σ →
                                      Becoming.PacedStock.ReadAtSpanEnd σ reads →
                                        have c := ((a₀, w₀, x₀), g_bad);
                                        ((∀ (t : Nat),
                                              t < L →
                                                Becoming.LineOnAStock.Goes need
                                                  (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c
                                                        t).fst.snd) →
                                            (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c
                                                      L).fst.snd.snd <
                                              H₂ + y₂) ∧
                                          ∃ t,
                                            ¬Becoming.LineOnAStock.Goes need
                                                (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c
                                                      t).fst.snd
@Becoming.PacedStock.coupled_two_rule_impossibility : ∀ {U : Type} {need : U → Nat} {kids : Nat × Nat → U → List U}
  {giving : Nat → Nat} {use : U → Nat} (M : Nat) {Y H₁ H₂ y₂ : Nat},
  Becoming.RegimeMargin.FromNothing giving →
    Becoming.RegimeMargin.AtMost giving Y →
      Y < H₁ →
        H₁ ≤ H₂ + y₂ →
          Becoming.RegimeMargin.Short giving H₂ y₂ →
            (∀ (u : U), 0 < need u ∧ need u ≤ H₂ + y₂) →
              ∀ {w₀ : List U} {x₀ : Nat},
                Becoming.PacedStock.LowerDrawWhileMet H₁ need kids giving use (1, M) w₀ x₀ (2 * (M + 2) - 1) →
                  (∀ (w : List U), w ≠ [] → H₂ ≤ Becoming.LineOnAStock.taken use w) →
                    x₀ < H₂ + y₂ + (H₁ - Y) * (2 * (M + 2) - 1) →
                      have g_safe := (0, M + 1);
                      have g_bad := (1, M);
                      have o_M := fun s => decide (s.fst = M + 1);
                      have c_safe := ((0, w₀, x₀), g_safe);
                      have c_bad := ((0, w₀, x₀), g_bad);
                      (∀ (L : Nat) (σ : Nat → Nat) (reads_s reads_b : Nat → Bool)
                          (h_s h_b : Becoming.PacedStock.StockState Nat U → Nat × Nat → Nat × Nat),
                          L < 2 * (M + 2) - 1 →
                            σ 0 = 0 →
                              σ 1 = L →
                                Becoming.Strict σ →
                                  Becoming.PacedStock.ReadAtSpanEnd σ reads_s →
                                    Becoming.PacedStock.ReadAtSpanEnd σ reads_b →
                                      ¬Becoming.Pace.StretchFixes Bool (M + 2) L ∧
                                        (∀ (t : Nat),
                                            t ∈ Becoming.span σ 0 →
                                              o_M
                                                  (Becoming.PacedStock.pacedCourse Becoming.Pace.lassoStep need kids
                                                      giving use h_s reads_s c_safe t).fst =
                                                o_M
                                                  (Becoming.PacedStock.pacedCourse Becoming.Pace.lassoStep need kids
                                                      giving use h_b reads_b c_bad t).fst) ∧
                                          Becoming.StatesBelow
                                              (Becoming.Pace.heldCourse Becoming.Pace.lassoStep g_safe
                                                (fun p => decide (p = M + 1)) 0)
                                              (M + 2) ∧
                                            Becoming.StatesBelow
                                                (Becoming.Pace.heldCourse Becoming.Pace.lassoStep g_bad
                                                  (fun p => decide (p = M + 1)) 0)
                                                (M + 2) ∧
                                              Becoming.Pace.heldCourse Becoming.Pace.lassoStep g_safe
                                                  (fun p => decide (p = M + 1)) 0 (2 * (M + 2) - 2) ≠
                                                Becoming.Pace.heldCourse Becoming.Pace.lassoStep g_bad
                                                  (fun p => decide (p = M + 1)) 0 (2 * (M + 2) - 2)) ∧
                        ∀ (L : Nat) (σ : Nat → Nat) (reads : Nat → Bool)
                          (h : Becoming.PacedStock.StockState Nat U → Nat × Nat → Nat × Nat),
                          2 * (M + 2) - 1 ≤ L →
                            σ 0 = 0 →
                              σ 1 = L →
                                Becoming.Strict σ →
                                  Becoming.PacedStock.ReadAtSpanEnd σ reads →
                                    ((∀ (t : Nat),
                                          t < L →
                                            Becoming.LineOnAStock.Goes need
                                              (Becoming.PacedStock.pacedCourse Becoming.Pace.lassoStep need kids giving
                                                    use h reads c_bad t).fst.snd) →
                                        (Becoming.PacedStock.pacedCourse Becoming.Pace.lassoStep need kids giving use h
                                                  reads c_bad L).fst.snd.snd <
                                          H₂ + y₂) ∧
                                      ∃ t,
                                        ¬Becoming.LineOnAStock.Goes need
                                            (Becoming.PacedStock.pacedCourse Becoming.Pace.lassoStep need kids giving
                                                  use h reads c_bad t).fst.snd
