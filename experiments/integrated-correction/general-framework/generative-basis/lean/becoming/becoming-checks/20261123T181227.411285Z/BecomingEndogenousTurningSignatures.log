@Becoming.EndogenousTurning.flow_proxy_optimum_collapse : ∀ {F C : Type} [DecidableEq F] [DecidableEq C]
  (L : Becoming.Flow F C) (W : Becoming.Web F C) (part : F → Bool) (cap : F → C → Nat) (ds rest : List C)
  (better : (C → Nat) → (C → Nat) → Prop),
  (∀ (t : Nat), Becoming.Distinct (L.present t)) →
    Becoming.Distinct (ds ++ rest) →
      (∀ (c : C), c ∈ rest → ¬c ∈ ds) →
        ∀ {e c : C},
          e ∈ ds →
            c ∈ rest →
              Becoming.Optimum.Rising ds better →
                Becoming.Optimum.Reoptimizes L W part cap ds rest better →
                  ∀ (g : Nat → Nat) {Y H_min H_safe y_safe m : Nat},
                    (∀ (t : Nat),
                        L.restGiven part t c = g (W.level t c - (L.restTaken part t c + L.capacity part cap t c))) →
                      Becoming.RegimeMargin.AtMost g Y →
                        Y < H_min →
                          Becoming.RegimeMargin.Short g H_safe y_safe →
                            H_safe ≤ H_min →
                              Becoming.RegimeMargin.FromNothing g →
                                0 < H_safe + y_safe →
                                  (∀ (t : Nat), H_min ≤ L.restTaken part t c + L.capacity part cap t c) →
                                    ∀ {f : F},
                                      0 < m →
                                        (∀ (t : Nat), W.requires t f c) →
                                          (∀ (t : Nat), W.need t f c = m) →
                                            m ≤ W.level 0 c →
                                              ∀ (n : Nat),
                                                W.level 0 c < H_safe + y_safe + (H_min - Y) * n →
                                                  (∀ (t : Nat),
                                                      W.level (t + 1) c =
                                                        Becoming.RegimeMargin.step g
                                                          (L.restTaken part t c + L.capacity part cap t c)
                                                          (W.level t c)) ∧
                                                    W.Lost c ∧
                                                      ∃ T,
                                                        T ≤ n ∧
                                                          W.level T c < H_safe + y_safe ∧
                                                            (∀ (k : Nat),
                                                                (Becoming.StockFlowBridge.unitWeb fun t =>
                                                                        W.level t c).level
                                                                    (T + k) () <
                                                                  H_safe + y_safe) ∧
                                                              ∃ M, W.level M c = 0 ∧ ∀ (j : Nat), W.level (M + j) c = 0
@Becoming.EndogenousTurning.flow_step_breaks_beyond : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {ds rest : List C} {t : Nat} {dep : C → F},
  L.Balances W →
    L.GainlessOn (ds ++ rest) t →
      W.MetOn dep rest t →
        W.stock ds t + W.slack dep rest t < W.stock ds (t + 1) + L.lost (ds ++ rest) t →
          ∃ c, c ∈ rest ∧ W.Broken t (dep c) c
@Becoming.EndogenousTurning.roomBelow_of_marginal_yield : ∀ {P C : Type} (ds : List C) (out : P → C → Nat)
  (draw : P → Nat) (eligible : P → Prop) {H_min : Nat},
  (∀ (p₁ p₂ : P), draw p₁ < draw p₂ → Becoming.Optimum.Exceeds ds (out p₂) (out p₁)) →
    (∃ p_hi, eligible p_hi ∧ H_min ≤ draw p_hi) →
      ∀ (p : P), eligible p → draw p < H_min → ∃ p', eligible p' ∧ Becoming.Optimum.Exceeds ds (out p') (out p)
@Becoming.EndogenousTurning.optimum_forces_overdraw : ∀ {P C : Type} (ds : List C) (out : P → C → Nat) (draw : P → Nat)
  (eligible : P → Prop) (better : (C → Nat) → (C → Nat) → Prop) {H_min : Nat},
  Becoming.Optimum.Rising ds better →
    (∀ (p : P), eligible p → draw p < H_min → ∃ p', eligible p' ∧ Becoming.Optimum.Exceeds ds (out p') (out p)) →
      ∀ {p_star : P},
        Becoming.Requirement.Frontier eligible (fun a b => better (out a) (out b)) p_star → H_min ≤ draw p_star
@Becoming.EndogenousTurning.proxy_optimum_overdraw_collapse : ∀ {P C : Type} (ds : List C) (out : P → C → Nat)
  (draw : P → Nat) (eligible : P → Prop) (better : (C → Nat) → (C → Nat) → Prop) (g : Nat → Nat)
  {Y H_min H_safe y_safe : Nat},
  Becoming.Optimum.Rising ds better →
    (∀ (p : P), eligible p → draw p < H_min → ∃ p', eligible p' ∧ Becoming.Optimum.Exceeds ds (out p') (out p)) →
      Becoming.RegimeMargin.AtMost g Y →
        Y < H_min →
          Becoming.RegimeMargin.Short g H_safe y_safe →
            H_safe ≤ H_min →
              Becoming.RegimeMargin.FromNothing g →
                0 < H_safe + y_safe →
                  ∀ (pol : Nat → P),
                    (∀ (t : Nat), Becoming.Requirement.Frontier eligible (fun a b => better (out a) (out b)) (pol t)) →
                      ∀ {x : Nat → Nat},
                        (∀ (t : Nat), x (t + 1) = Becoming.RegimeMargin.step g (draw (pol t)) (x t)) →
                          ∀ (n : Nat),
                            x 0 < H_safe + y_safe + (H_min - Y) * n →
                              (∀ (t : Nat), H_min ≤ draw (pol t)) ∧
                                ∃ T,
                                  T ≤ n ∧
                                    x T < H_safe + y_safe ∧
                                      (∀ (k : Nat),
                                          (Becoming.StockFlowBridge.unitWeb x).level (T + k) () < H_safe + y_safe) ∧
                                        ∃ M, x M = 0 ∧ ∀ (j : Nat), x (M + j) = 0
@Becoming.EndogenousTurning.constrained_selector_viable : ∀ {P : Type} (draw : P → Nat) (eligible : P → Prop)
  (g : Nat → Nat) {H_safe y_safe hi : Nat},
  Becoming.RegimeMargin.Meets g H_safe y_safe hi →
    Becoming.RegimeMargin.Keeps g 0 hi →
      H_safe + y_safe + H_safe ≤ hi →
        ∀ (pol : Nat → P),
          (∀ (t : Nat), eligible (pol t) ∧ draw (pol t) ≤ H_safe) →
            ∀ {x : Nat → Nat},
              (∀ (t : Nat), x (t + 1) = Becoming.RegimeMargin.step g (draw (pol t)) (x t)) →
                H_safe + y_safe ≤ x 0 → x 0 ≤ hi → ∀ (t : Nat), H_safe + y_safe ≤ x t ∧ x t ≤ hi
