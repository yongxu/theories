@Becoming.EndogenousTurning.EndogenousSystem.timely_turning_certificate : ∀ {S Obs : Type}
  (sys : Becoming.EndogenousTurning.EndogenousSystem S Obs) (K : S → Prop) (eta : S → Nat) (taskDegrades : Obs → Prop)
  {B_task H_safe y_safe drawCeiling lag hi : Nat},
  (∀ (s : S) (o : Obs), K s → K (sys.next s o)) →
    (∀ (s : S), K s → eta s ≤ lag) →
      (∀ (s : S), K s → sys.draw s ≤ drawCeiling) →
        (∀ (s : S), K s → eta s = 0 → sys.draw s ≤ H_safe) →
          (∀ (s : S) (x : Nat), K s → x < B_task → taskDegrades (sys.obs s x)) →
            (∀ (s : S) (o : Obs), K s → taskDegrades o → 0 < eta s → eta (sys.next s o) < eta s) →
              (∀ (s : S) (o : Obs), K s → taskDegrades o → eta s = 0 → eta (sys.next s o) = 0) →
                Becoming.RegimeMargin.Meets sys.g H_safe y_safe hi →
                  Becoming.RegimeMargin.Keeps sys.g 0 hi →
                    H_safe + y_safe + H_safe ≤ hi →
                      H_safe + y_safe + drawCeiling * (lag + 1) ≤ B_task →
                        Becoming.Viability.Certificate (Becoming.Law.process sys.step)
                          (fun st => H_safe + y_safe ≤ st.fst ∧ st.fst ≤ hi ∧ K st.snd)
                          (Becoming.EndogenousTurning.turningInv K eta H_safe y_safe drawCeiling hi)
@Becoming.EndogenousTurning.EndogenousSystem.timely_turning_kernel : ∀ {S Obs : Type}
  (sys : Becoming.EndogenousTurning.EndogenousSystem S Obs) (K : S → Prop) (eta : S → Nat) (taskDegrades : Obs → Prop)
  {B_task H_safe y_safe drawCeiling lag hi : Nat} (init : S) (x₀ : Nat),
  K init →
    (∀ (s : S) (o : Obs), K s → K (sys.next s o)) →
      (∀ (s : S), K s → eta s ≤ lag) →
        (∀ (s : S), K s → sys.draw s ≤ drawCeiling) →
          (∀ (s : S), K s → eta s = 0 → sys.draw s ≤ H_safe) →
            (∀ (s : S) (x : Nat), K s → x < B_task → taskDegrades (sys.obs s x)) →
              (∀ (s : S) (o : Obs), K s → taskDegrades o → 0 < eta s → eta (sys.next s o) < eta s) →
                (∀ (s : S) (o : Obs), K s → taskDegrades o → eta s = 0 → eta (sys.next s o) = 0) →
                  Becoming.RegimeMargin.Meets sys.g H_safe y_safe hi →
                    Becoming.RegimeMargin.Keeps sys.g 0 hi →
                      H_safe + y_safe + H_safe ≤ hi →
                        H_safe + y_safe + drawCeiling * (lag + 1) ≤ B_task →
                          H_safe + y_safe + eta init * drawCeiling ≤ x₀ →
                            x₀ ≤ hi →
                              Becoming.Viability.Kernel (Becoming.Law.process sys.step)
                                  (fun st => H_safe + y_safe ≤ st.fst ∧ st.fst ≤ hi ∧ K st.snd) (x₀, init) ∧
                                ∀ (t : Nat),
                                  H_safe + y_safe ≤ (Becoming.Law.orbit sys.step (x₀, init) t).fst ∧
                                    (Becoming.Law.orbit sys.step (x₀, init) t).fst ≤ hi
@Becoming.EndogenousTurning.EndogenousSystem.timely_turning_guarantee : ∀ {S Obs : Type}
  (sys : Becoming.EndogenousTurning.EndogenousSystem S Obs) (K : S → Prop) (eta : S → Nat) (taskDegrades : Obs → Prop)
  {B_task H_safe y_safe drawCeiling lag hi : Nat} (init : S) (x₀ : Nat),
  K init →
    (∀ (s : S) (o : Obs), K s → K (sys.next s o)) →
      (∀ (s : S), K s → eta s ≤ lag) →
        (∀ (s : S), K s → sys.draw s ≤ drawCeiling) →
          (∀ (s : S), K s → eta s = 0 → sys.draw s ≤ H_safe) →
            (∀ (s : S) (x : Nat), K s → x < B_task → taskDegrades (sys.obs s x)) →
              (∀ (s : S) (o : Obs), K s → taskDegrades o → 0 < eta s → eta (sys.next s o) < eta s) →
                (∀ (s : S) (o : Obs), K s → taskDegrades o → eta s = 0 → eta (sys.next s o) = 0) →
                  Becoming.RegimeMargin.Meets sys.g H_safe y_safe hi →
                    Becoming.RegimeMargin.Keeps sys.g 0 hi →
                      H_safe + y_safe + H_safe ≤ hi →
                        H_safe + y_safe + drawCeiling * (lag + 1) ≤ B_task →
                          H_safe + y_safe + eta init * drawCeiling ≤ x₀ →
                            x₀ ≤ hi →
                              ∀ (T₀ : Nat),
                                (∀ (k : Nat),
                                    k < lag → (Becoming.Law.orbit sys.step (x₀, init) (T₀ + k)).fst < B_task) →
                                  eta (Becoming.Law.orbit sys.step (x₀, init) (T₀ + lag)).snd = 0 ∧
                                    sys.draw (Becoming.Law.orbit sys.step (x₀, init) (T₀ + lag)).snd ≤ H_safe ∧
