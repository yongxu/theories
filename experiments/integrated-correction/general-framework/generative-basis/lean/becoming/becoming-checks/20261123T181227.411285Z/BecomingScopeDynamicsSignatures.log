@Becoming.ScopeDynamics.preCollapse_mixed_weighting : ∀ {X : Type} {items : List X} {a b : X → Bool},
  Becoming.Weighting.MixedOn items a b →
    (∃ w,
        Becoming.Weighting.Positive items w ∧
          Becoming.Weighting.weighed items w b < Becoming.Weighting.weighed items w a) ∧
      ∃ w',
