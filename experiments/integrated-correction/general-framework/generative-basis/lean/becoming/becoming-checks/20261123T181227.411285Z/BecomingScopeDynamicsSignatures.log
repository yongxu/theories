    ∀ {items : List (Nat × F)} {l_wide l_narrow : Nat → C → Nat},
      W.ListsAdmitted items l_wide →
        W.ListsAdmitted items l_narrow →
          (W.Widens l_wide l_narrow ↔
            ∀ (w : Nat × F → Nat),
              Becoming.Weighting.Positive items w →
                Becoming.Weighting.weighed items w (admitted l_narrow) <
