@Becoming.AlignmentSpine.ComposedSpine.spine_preCap_eq : ∀ {P : Type}
  (M : Becoming.EndogenousTurning.ServiceTaskModel P) (base hProxyPre hProxySafe lagProxy lagPartner : Nat)
  (safe_le : hProxySafe ≤ hProxyPre) (initProxy : Nat) (hInitProxy : initProxy ≤ lagProxy) (initPartner : Bool × Nat)
  (hInitPartner : Becoming.EndogenousTurning.serviceK lagPartner initPartner)
  (head : Becoming.UnifiedDrawdown.RestraintAgentSpec) (tail : List Becoming.UnifiedDrawdown.RestraintAgentSpec)
  (warnFleet H_def_pre H_def_post T_gate H_coop : Nat) (post_le_pre : H_def_post ≤ H_def_pre),
  (Becoming.AlignmentSpine.ComposedSpine.spineContract M base hProxyPre hProxySafe lagProxy lagPartner safe_le initProxy
          hInitProxy initPartner hInitPartner head tail warnFleet H_def_pre H_def_post T_gate H_coop
          post_le_pre).preCapExt
      () =
    hProxyPre + Becoming.AdaptiveLoops.natMax (M.draw M.ext) (M.draw M.safe) +
        Becoming.UnifiedDrawdown.OpenCompositionBridge.specSum (fun s => s.preCap) head tail +
      (H_def_pre + H_coop)
