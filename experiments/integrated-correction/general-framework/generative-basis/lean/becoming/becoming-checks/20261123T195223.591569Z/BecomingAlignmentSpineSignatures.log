@Becoming.AlignmentSpine.ComposedSpine.master_spine_multiscale_transfer : ∀ {S₁ A₁ Q₁ B₁ S₂ A₂ Q₂ B₂ F C K_cap : Type}
  {P₁ : Generative.Process S₁ A₁} {R₁ : Generative.Process Q₁ B₁} {π₁ : S₁ → Q₁} {M₁ : Becoming.SlackDist Q₁}
  {P₂ : Generative.Process S₂ A₂} {R₂ : Generative.Process Q₂ B₂} {π₂ : S₂ → Q₂} {M₂ : Becoming.SlackDist Q₂}
  {σ : Nat → Nat} (sim₁ : Becoming.LaxSim P₁ R₁ π₁ σ M₁) (sim₂ : Becoming.LaxSim P₂ R₂ π₂ σ M₂)
  {guardQ K : Q₁ × Q₂ → Prop} {guardProd : S₁ × S₂ → Prop},
  Becoming.Viability.Certificate (Becoming.OpenComposition.prodProcess R₁ R₂) guardQ K →
    ∀ (Δ : Nat),
      Becoming.AdaptiveLoops.natMax (sim₁.α Δ) (sim₂.α Δ) + Becoming.AdaptiveLoops.natMax sim₁.ε sim₂.ε ≤ Δ →
        (∀ (q : Q₁ × Q₂) (u : S₁ × S₂),
            guardQ q →
              Becoming.AdaptiveLoops.natMax (M₁.d (π₁ u.fst) q.fst) (M₂.d (π₂ u.snd) q.snd) ≤
                  Becoming.AdaptiveLoops.natMax (sim₁.β Δ) (sim₂.β Δ) + Becoming.AdaptiveLoops.natMax sim₁.η sim₂.η →
                guardProd u) →
          ∀ {s₁₀ : S₁} {s₂₀ : S₂},
            sim₁.Epoch (σ 0) s₁₀ →
              sim₂.Epoch (σ 0) s₂₀ →
                K (π₁ s₁₀, π₂ s₂₀) →
                  ∀ (r : Becoming.Run (Becoming.OpenComposition.prodProcess P₁ P₂)),
                    r.state 0 = (s₁₀, s₂₀) →
                      ∀ (W : Becoming.Web F C) (cap : F → K_cap) (T : Nat),
                        (Becoming.ReserveSafe (fun t => guardProd (r.state t)) T →
                            ∀ (s t : Nat),
                              T ≤ s →
                                s ≤ t →
                                  ∀ (k : K_cap),
                                    W.MacroAdmits cap (W.level s) s k → W.MacroAdmits cap (W.level t) t k) →
                          (∀ (t : Nat), T ≤ t → ∃ f, W.Admits (W.level t) t f ∧ ¬W.Admits (W.level (t + 1)) (t + 1) f) →
                            Becoming.Viability.Kernel (Becoming.OpenComposition.prodProcess P₁ P₂) guardProd
                                (s₁₀, s₂₀) ∧
                              Becoming.ReserveSafe (fun t => guardProd (r.state t)) T ∧
                                Becoming.TransformsViably W (fun t => guardProd (r.state t)) cap T
