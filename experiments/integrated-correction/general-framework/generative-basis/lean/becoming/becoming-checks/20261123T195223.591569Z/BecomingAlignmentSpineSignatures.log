  {S₁ S₂ S₂' Obs₁ Obs₂ Obs₂' Dist₁ Dist₂ Dist₂' Int₁ Int₂ Int₂' Ext Env : Type}
  (A : Becoming.OpenComposition.OpenComponent S₁ Obs₁ Dist₁ Int₁ Ext)
  (B : Becoming.OpenComposition.OpenComponent S₂ Obs₂ Dist₂ Int₂ Ext)
  (B' : Becoming.OpenComposition.OpenComponent S₂' Obs₂' Dist₂' Int₂' Ext) {init₁ : S₁} {init₂ : S₂} {init₂' : S₂'}
  (cA : Becoming.OpenComposition.InterfaceContract A init₁) (cB : Becoming.OpenComposition.InterfaceContract B init₂)
  (cB' : Becoming.OpenComposition.InterfaceContract B' init₂') (obs₁ : (Ext → Nat) → Obs₁) (obs₂ : (Ext → Nat) → Obs₂)
  (obs₂' : (Ext → Nat) → Obs₂') (channel : Bool → Nat → Env → Bool) (G : Ext → (Ext → Nat) → Nat)
  (envDraw : Env → Ext → Nat) (envCap : Ext → Nat) (jointAdm : Env → Prop),
  (∀ (env : Env), jointAdm env → ∀ (k : Ext), envDraw env k ≤ envCap k) →
    ∀ (x_crit warnLevel H_safe x₀ : Ext → Nat),
      Becoming.OpenComposition.ContractRefines cB cB' obs₂ obs₂' warnLevel →
        (∀ (x : Ext → Nat) (k : Ext), x k < warnLevel k → cA.warnObs (obs₁ x) ∨ cB.warnObs (obs₂ x)) →
          (∀ (load : Nat) (env : Env),
              jointAdm env → load ≤ cA.maxSilence + cB.maxSilence → channel true load env = true) →
            (∀ (k : Ext), Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole (G k)) →
              (∀ (k : Ext),
                  x_crit k ≤
                    Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G H_safe x_crit k) →
                (∀ (k : Ext), cA.postBudgetExt k + cB.postBudgetExt k + envCap k ≤ H_safe k) →
                  (∀ (k : Ext),
                      x_crit k +
                          (Becoming.AdaptiveLoops.natMax cA.maxLag cB.maxLag + 1) *
                            (cA.preCapExt k + cB.preCapExt k + envCap k) ≤
                        warnLevel k) →
                    (∀ (k : Ext),
                        x_crit k +
                            Becoming.AdaptiveLoops.natMax (cA.eta init₁) (cB.eta init₂) *
                              (cA.preCapExt k + cB.preCapExt k + envCap k) ≤
                          x₀ k) →
                      Becoming.Viability.Kernel
                        (Becoming.OpenComposition.closedProcess (A.compose B')
                          (Becoming.OpenComposition.composeContract cA cB') (fun x => (obs₁ x, obs₂' x)) channel G
                          envDraw jointAdm)
                        (Becoming.OpenComposition.closedGuard (A.compose B')
                          (Becoming.OpenComposition.composeContract cA cB') x_crit)
                        (x₀, init₁, init₂')
