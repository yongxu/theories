          (Becoming.WayUnderARule.course need kids next giving use s k).snd ≤ hi
@Becoming.WayUnderARule.goes_upto : ∀ {U R : Type} {need use : U → Nat} {kids : R → U → List U} {next : List U → R → R}
  {giving : Nat → Nat} {s : (List U × R) × Nat} {k : Nat},
