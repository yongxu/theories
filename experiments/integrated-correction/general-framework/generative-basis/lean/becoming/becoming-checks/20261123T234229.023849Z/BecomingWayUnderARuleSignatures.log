@Becoming.WayUnderARule.taken_rises : ∀ {U R : Type} {need use : U → Nat} {kids : R → U → List U}
  {next : List U → R → R} {giving : Nat → Nat} {favours : R → Prop},
  (∀ (g : R), favours g → ∀ (u : U), use u < Becoming.LineOnAStock.taken use (kids g u)) →
    ∀ {t : (List U × R) × Nat},
      favours t.fst.snd →
        ∀ {v : U},
          v ∈ t.fst.fst →
            (∀ (u : U), u ∈ t.fst.fst → need u ≤ t.snd) →
              Becoming.LineOnAStock.taken use t.fst.fst + 1 ≤
                Becoming.LineOnAStock.taken use (Becoming.WayUnderARule.step need kids next giving use t).fst.fst
@Becoming.WayUnderARule.taken_kept : ∀ {U R : Type} {need use : U → Nat} {kids : R → U → List U} {next : List U → R → R}
  {giving : Nat → Nat} {favours : R → Prop},
  (∀ (g : R), ¬favours g → ∀ (u : U), Becoming.LineOnAStock.taken use (kids g u) = use u) →
    ∀ {t : (List U × R) × Nat},
      ¬favours t.fst.snd →
        (∀ (u : U), u ∈ t.fst.fst → need u ≤ t.snd) →
          Becoming.LineOnAStock.taken use (Becoming.WayUnderARule.step need kids next giving use t).fst.fst =
            Becoming.LineOnAStock.taken use t.fst.fst
@Becoming.WayUnderARule.below_kept : ∀ {U R : Type} {need use : U → Nat} {kids : R → U → List U} {next : List U → R → R}
  {giving : Nat → Nat},
