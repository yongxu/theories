@Becoming.WayUnderARule.held_step : ∀ {U R : Type} {need use : U → Nat} {kids : R → U → List U} {giving y : Nat → Nat}
  {hi : Nat} {favours : R → Prop} {next : List U → R → R} {x₀ T₀ : Nat},
  (∀ (g : R), ¬favours g → ∀ (u : U), Becoming.LineOnAStock.taken use (kids g u) = use u) →
    (∀ (g : R), ¬favours g → ∀ (u : U), kids g u ≠ []) →
      (∀ (g : R) (u v : U), v ∈ kids g u → need v ≤ need u) →
        Becoming.RegimeMargin.Meets giving T₀ (y T₀) hi →
          Becoming.RegimeMargin.Keeps giving T₀ hi →
            T₀ + y T₀ ≤ x₀ →
              ∀ {t : (List U × R) × Nat},
