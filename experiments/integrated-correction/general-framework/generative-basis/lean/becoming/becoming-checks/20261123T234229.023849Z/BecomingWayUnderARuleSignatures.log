        j ≤ k → Becoming.WayUnderARule.Goes need (Becoming.WayUnderARule.course need kids next giving use s j)
@Becoming.WayUnderARule.outcome_or_met : ∀ {U R : Type} {need use : U → Nat} {kids : R → U → List U}
  {next : List U → R → R} {giving y : Nat → Nat} {hi : Nat} {favours : R → Prop} {s : (List U × R) × Nat},
  (∀ (g : R) (u v : U), v ∈ kids g u → need v ≤ need u) →
    (∀ (k : Nat) (u : U), u ∈ (Becoming.WayUnderARule.course need kids next giving use s k).fst.fst → 0 < need u) →
      Becoming.RegimeMargin.FromNothing giving →
        ∀ {m : Nat},
          (∀ (m' : Nat),
              m' < m →
                ∀ (room f : Nat),
                  Becoming.WayUnderARule.OrFrom need use y favours next hi
                    (Becoming.WayUnderARule.course need kids next giving use s) m' room f) →
            ∀ {k : Nat},
              (∀ (j : Nat),
                  j < k →
                    Becoming.WayUnderARule.Goes need (Becoming.WayUnderARule.course need kids next giving use s j)) →
                Becoming.LineOnAStock.Below need (fun x => True) m
                    (Becoming.WayUnderARule.course need kids next giving use s k).fst.fst →
                  Becoming.WayUnderARule.Outcomes need use y favours next
                      (Becoming.WayUnderARule.course need kids next giving use s) ∨
                    Becoming.WayUnderARule.Goes need (Becoming.WayUnderARule.course need kids next giving use s k) ∧
                      (∀ (u : U),
                          u ∈ (Becoming.WayUnderARule.course need kids next giving use s k).fst.fst →
                            need u ≤ (Becoming.WayUnderARule.course need kids next giving use s k).snd) ∧
