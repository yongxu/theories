      Becoming.LineOnAStock.taken use t.fst.fst + y (Becoming.LineOnAStock.taken use t.fst.fst) ≤ t.snd →
        t.snd ≤ hi → t.snd ≤ (Becoming.WayUnderARule.step need kids next giving use t).snd
