    ∀ {y : Nat → Nat} {t : (List U × R) × Nat},
      Becoming.RegimeMargin.Short giving (Becoming.LineOnAStock.taken use t.fst.fst)
          (y (Becoming.LineOnAStock.taken use t.fst.fst)) →
        0 < t.snd →
          t.snd < Becoming.LineOnAStock.taken use t.fst.fst + y (Becoming.LineOnAStock.taken use t.fst.fst) →
