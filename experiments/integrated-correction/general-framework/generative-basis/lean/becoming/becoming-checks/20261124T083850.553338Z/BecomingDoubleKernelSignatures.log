@Becoming.DoubleKernel.evalHPath_endpoints : ∀ {G : Becoming.DoubleKernel.DoubleSig}
  {M : Becoming.DoubleKernel.StrictDoubleCat} (I : Becoming.DoubleKernel.SigInterp G M) {x y : G.Obj}
  (p : Becoming.DoubleKernel.TypedPath G.hSrc G.hTgt x y),
  M.hSrc (Becoming.DoubleKernel.evalHPath I p) = I.onObj x ∧ M.hTgt (Becoming.DoubleKernel.evalHPath I p) = I.onObj y
@Becoming.DoubleKernel.evalVPath_endpoints : ∀ {G : Becoming.DoubleKernel.DoubleSig}
  {M : Becoming.DoubleKernel.StrictDoubleCat} (I : Becoming.DoubleKernel.SigInterp G M) {x y : G.Obj}
  (u : Becoming.DoubleKernel.TypedPath G.vSrc G.vTgt x y),
  M.vSrc (Becoming.DoubleKernel.evalVPath I u) = I.onObj x ∧ M.vTgt (Becoming.DoubleKernel.evalVPath I u) = I.onObj y
@Becoming.DoubleKernel.evalHPath_comp : ∀ {G : Becoming.DoubleKernel.DoubleSig}
  {M : Becoming.DoubleKernel.StrictDoubleCat} (I : Becoming.DoubleKernel.SigInterp G M) {x y z : G.Obj}
  (p : Becoming.DoubleKernel.TypedPath G.hSrc G.hTgt x y) (q : Becoming.DoubleKernel.TypedPath G.hSrc G.hTgt y z),
  Becoming.DoubleKernel.evalHPath I (Becoming.DoubleKernel.pathComp p q) =
    M.hComp (Becoming.DoubleKernel.evalHPath I p) (Becoming.DoubleKernel.evalHPath I q)
@Becoming.DoubleKernel.evalVPath_comp : ∀ {G : Becoming.DoubleKernel.DoubleSig}
  {M : Becoming.DoubleKernel.StrictDoubleCat} (I : Becoming.DoubleKernel.SigInterp G M) {x y z : G.Obj}
  (u : Becoming.DoubleKernel.TypedPath G.vSrc G.vTgt x y) (v : Becoming.DoubleKernel.TypedPath G.vSrc G.vTgt y z),
  Becoming.DoubleKernel.evalVPath I (Becoming.DoubleKernel.pathComp u v) =
