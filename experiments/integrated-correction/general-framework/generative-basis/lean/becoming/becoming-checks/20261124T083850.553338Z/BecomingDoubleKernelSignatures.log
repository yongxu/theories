@Becoming.DoubleKernel.evalSqTerm_frame : ∀ {G : Becoming.DoubleKernel.DoubleSig}
  {M : Becoming.DoubleKernel.StrictDoubleCat} (I : Becoming.DoubleKernel.SigInterp G M)
  {P : Becoming.DoubleKernel.SqTerm G} {φ : Becoming.DoubleKernel.Frame G.hSrc G.hTgt G.vSrc G.vTgt},
  Becoming.DoubleKernel.HasFrame G P φ →
    M.top (Becoming.DoubleKernel.evalSqTerm I P) = Becoming.DoubleKernel.evalHPath I φ.top ∧
      M.bot (Becoming.DoubleKernel.evalSqTerm I P) = Becoming.DoubleKernel.evalHPath I φ.bot ∧
        M.left (Becoming.DoubleKernel.evalSqTerm I P) = Becoming.DoubleKernel.evalVPath I φ.left ∧
          M.right (Becoming.DoubleKernel.evalSqTerm I P) = Becoming.DoubleKernel.evalVPath I φ.right
@Becoming.DoubleKernel.eqCert_sound : ∀ {G : Becoming.DoubleKernel.DoubleSig}
  {M : Becoming.DoubleKernel.StrictDoubleCat} (I : Becoming.DoubleKernel.SigInterp G M)
  {P Q : Becoming.DoubleKernel.SqTerm G},
