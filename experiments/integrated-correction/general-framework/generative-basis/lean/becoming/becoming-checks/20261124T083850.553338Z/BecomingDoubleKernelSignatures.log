@Becoming.DoubleKernel.evalCell3Term_compH3_compat : ∀ {G : Becoming.DoubleKernel.Double3Sig}
  {K : Becoming.DoubleKernel.StrictTripleCat} (I : Becoming.DoubleKernel.Sig3Interp G K)
