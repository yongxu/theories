@Becoming.DoubleKernel.guarded_oplax_sound : ∀ {A B : Type} {e₁ e₂ : Becoming.DoubleKernel.GuardedExpr A B}
  (p : Becoming.DoubleKernel.GuardedProof e₁ e₂),
  (∀ (w : (Becoming.DoubleKernel.evalGuardedExpr e₁).W),
      (Becoming.DoubleKernel.evalGuardedExpr e₂).left ((Becoming.DoubleKernel.evalGuardedProof p).map w) =
          (Becoming.DoubleKernel.evalGuardedExpr e₁).left w ∧
        (Becoming.DoubleKernel.evalGuardedExpr e₂).right ((Becoming.DoubleKernel.evalGuardedProof p).map w) =
          (Becoming.DoubleKernel.evalGuardedExpr e₁).right w) ∧
    ∀ {X Y Z : Type} (H : Becoming.OplaxHistory.RelSpan X Y) (K : Becoming.OplaxHistory.RelSpan Y Z)
      (S : Becoming.OplaxHistory.SumPreservingFunctor)
      (b :
        Becoming.OplaxHistory.Bij (S.toFunctor.obj (Becoming.OplaxHistory.PullbackElem H.right K.left))
          (Becoming.OplaxHistory.PullbackElem (S.toFunctor.map H.right) (S.toFunctor.map K.left))),
      (∀ (u : S.toFunctor.obj (Becoming.OplaxHistory.PullbackElem H.right K.left)),
          b.toFun u = (Becoming.OplaxHistory.chi S.toFunctor H K).map u) →
        Becoming.OplaxHistory.FImageIsPullback S.toFunctor H K ∧
          ∀ (E : S.toFunctor.obj H.W → Type) (v : S.toFunctor.obj K.W),
            Becoming.OplaxHistory.IsBijective (Becoming.OplaxHistory.bcMap S.toFunctor H K E v)
Becoming.DoubleKernel.strict_vs_guarded_separation_witness : (¬Becoming.OplaxHistory.Surj
        Becoming.OplaxHistory.EmergentCrossSeamWitness.chiZeroToOne ∧
    Becoming.OplaxHistory.Inj Becoming.OplaxHistory.EmergentCrossSeamWitness.chiZeroToOne ∧
      ¬Becoming.OplaxHistory.Surj Becoming.OplaxHistory.EmergentCrossSeamWitness.chiTwoToFour) ∧
  (¬Becoming.OplaxHistory.Inj Becoming.OplaxHistory.C2RelativeLossWitness.c2ChiTwoToOne ∧
      Becoming.OplaxHistory.Surj Becoming.OplaxHistory.C2RelativeLossWitness.c2ChiTwoToOne) ∧
    (∀ (F : Becoming.OplaxHistory.SpanFunctor) {A D C : Type} (H : Becoming.OplaxHistory.RelSpan A D)
        (K : Becoming.OplaxHistory.RelSpan D C) (v : F.obj K.W),
        Becoming.OplaxHistory.IsBijective (Becoming.OplaxHistory.bcMap F H K (fun x => Empty) v)) ∧
      ∀ (F : Becoming.OplaxHistory.SpanFunctor) {A D C : Type} (H : Becoming.OplaxHistory.RelSpan A D)
        (K : Becoming.OplaxHistory.RelSpan D C),
        (Becoming.OplaxHistory.IsBijective (Becoming.OplaxHistory.chi F H K).map ↔
            Becoming.OplaxHistory.FImageIsPullback F H K) ∧
          (Becoming.OplaxHistory.IsBijective (Becoming.OplaxHistory.chi F H K).map ↔
            ∀ (E : F.obj H.W → Type) (v : F.obj K.W),
              Becoming.OplaxHistory.IsBijective (Becoming.OplaxHistory.bcMap F H K E v))
