@Becoming.DoubleKernel.congrArg2 : ∀ {α β γ : Type} (f : α → β → γ) {a₁ a₂ : α} {b₁ b₂ : β},
  a₁ = a₂ → b₁ = b₂ → f a₁ b₁ = f a₂ b₂
@Becoming.DoubleKernel.pathComp_nil_l : ∀ {Obj Edge : Type} {src tgt : Edge → Obj} {x y : Obj}
  (p : Becoming.DoubleKernel.TypedPath src tgt x y),
  Becoming.DoubleKernel.pathComp (Becoming.DoubleKernel.TypedPath.nil x) p = p
@Becoming.DoubleKernel.pathComp_nil_r : ∀ {Obj Edge : Type} {src tgt : Edge → Obj} {x y : Obj}
  (p : Becoming.DoubleKernel.TypedPath src tgt x y),
  Becoming.DoubleKernel.pathComp p (Becoming.DoubleKernel.TypedPath.nil y) = p
@Becoming.DoubleKernel.pathComp_assoc : ∀ {Obj Edge : Type} {src tgt : Edge → Obj} {w x y z : Obj}
  (p : Becoming.DoubleKernel.TypedPath src tgt w x) (q : Becoming.DoubleKernel.TypedPath src tgt x y)
  (r : Becoming.DoubleKernel.TypedPath src tgt y z),
  Becoming.DoubleKernel.pathComp (Becoming.DoubleKernel.pathComp p q) r =
    Becoming.DoubleKernel.pathComp p (Becoming.DoubleKernel.pathComp q r)
@Becoming.DoubleKernel.frame_eq_components : ∀ {Obj HEdge VEdge : Type} {hSrc hTgt : HEdge → Obj}
  {vSrc vTgt : VEdge → Obj} {f₁ f₂ : Becoming.DoubleKernel.Frame hSrc hTgt vSrc vTgt},
  f₁ = f₂ →
    ∃ htl htr hbl hbr,
      htl ▸ htr ▸ f₁.top = f₂.top ∧
        hbl ▸ hbr ▸ f₁.bot = f₂.bot ∧ htl ▸ hbl ▸ f₁.left = f₂.left ∧ htr ▸ hbr ▸ f₁.right = f₂.right
@Becoming.DoubleKernel.frame_ext : ∀ {Obj HEdge VEdge : Type} {hSrc hTgt : HEdge → Obj} {vSrc vTgt : VEdge → Obj}
  (f₁ f₂ : Becoming.DoubleKernel.Frame hSrc hTgt vSrc vTgt) (htl : f₁.tl = f₂.tl) (htr : f₁.tr = f₂.tr)
  (hbl : f₁.bl = f₂.bl) (hbr : f₁.br = f₂.br),
  htl ▸ htr ▸ f₁.top = f₂.top →
    hbl ▸ hbr ▸ f₁.bot = f₂.bot → htl ▸ hbl ▸ f₁.left = f₂.left → htr ▸ hbr ▸ f₁.right = f₂.right → f₁ = f₂
@Becoming.DoubleKernel.pathComp_subst : ∀ {Obj Edge : Type} {src tgt : Edge → Obj} {x₁ y₁ z₁ x₂ y₂ z₂ : Obj}
  (hx : x₁ = x₂) (hy : y₁ = y₂) (hz : z₁ = z₂) {p₁ : Becoming.DoubleKernel.TypedPath src tgt x₁ y₁}
  {p₂ : Becoming.DoubleKernel.TypedPath src tgt x₂ y₂} {q₁ : Becoming.DoubleKernel.TypedPath src tgt y₁ z₁}
  {q₂ : Becoming.DoubleKernel.TypedPath src tgt y₂ z₂},
  hx ▸ hy ▸ p₁ = p₂ →
    hy ▸ hz ▸ q₁ = q₂ → hx ▸ hz ▸ Becoming.DoubleKernel.pathComp p₁ q₁ = Becoming.DoubleKernel.pathComp p₂ q₂
@Becoming.DoubleKernel.hasFrame_unique : ∀ {G : Becoming.DoubleKernel.DoubleSig} {P : Becoming.DoubleKernel.SqTerm G}
  {φ₁ φ₂ : Becoming.DoubleKernel.Frame G.hSrc G.hTgt G.vSrc G.vTgt},
  Becoming.DoubleKernel.HasFrame G P φ₁ → Becoming.DoubleKernel.HasFrame G P φ₂ → φ₁ = φ₂
@Becoming.DoubleKernel.eqCert_preserves_frame : ∀ {G : Becoming.DoubleKernel.DoubleSig}
  {P Q : Becoming.DoubleKernel.SqTerm G},
  Becoming.DoubleKernel.EqCert G P Q → ∃ φ, Becoming.DoubleKernel.HasFrame G P φ ∧ Becoming.DoubleKernel.HasFrame G Q φ
@Becoming.DoubleKernel.eqCert_frame_eq : ∀ {G : Becoming.DoubleKernel.DoubleSig} {P Q : Becoming.DoubleKernel.SqTerm G}
  {φ₁ φ₂ : Becoming.DoubleKernel.Frame G.hSrc G.hTgt G.vSrc G.vTgt},
  Becoming.DoubleKernel.EqCert G P Q →
