Becoming.OplaxHistory.reserve_disjoint_vs_serial_reconfig : (∀ {A D C A' D' C' : Type}
    (H : Becoming.OplaxHistory.RelSpan A D) (K : Becoming.OplaxHistory.RelSpan D C)
    (H' : Becoming.OplaxHistory.RelSpan A' D') (K' : Becoming.OplaxHistory.RelSpan D' C'),
    Becoming.OplaxHistory.IsBijective (Becoming.OplaxHistory.coprod_pullback_iso H K H' K').toFun) ∧
  (Becoming.PolyComposition.ConcurrentSerialWitness.csProc.step Becoming.PolyComposition.ConcurrentSerialWitness.st₀
        (Becoming.PolyComposition.SerialCoordAct.reconfigA Becoming.PolyComposition.ConcurrentSerialWitness.reqA)
        Becoming.PolyComposition.ConcurrentSerialWitness.stA ∧
      Becoming.Viability.Kernel Becoming.PolyComposition.ConcurrentSerialWitness.csProc
        Becoming.PolyComposition.ConcurrentSerialWitness.csGuard Becoming.PolyComposition.ConcurrentSerialWitness.stA) ∧
    (Becoming.PolyComposition.ConcurrentSerialWitness.csProc.step Becoming.PolyComposition.ConcurrentSerialWitness.st₀
          (Becoming.PolyComposition.SerialCoordAct.reconfigB Becoming.PolyComposition.ConcurrentSerialWitness.reqB)
          Becoming.PolyComposition.ConcurrentSerialWitness.stB ∧
        Becoming.Viability.Kernel Becoming.PolyComposition.ConcurrentSerialWitness.csProc
          Becoming.PolyComposition.ConcurrentSerialWitness.csGuard
          Becoming.PolyComposition.ConcurrentSerialWitness.stB) ∧
      ((Becoming.PolyComposition.ConcurrentSerialWitness.concurrentOrbit 0).fst () = 4 ∧
          (Becoming.PolyComposition.ConcurrentSerialWitness.concurrentOrbit 1).fst () = 3 ∧
            (Becoming.PolyComposition.ConcurrentSerialWitness.concurrentOrbit 2).fst () = 1 ∧
              (Becoming.PolyComposition.ConcurrentSerialWitness.concurrentOrbit 3).fst () = 0 ∧
                ¬Becoming.Viability.Kernel Becoming.PolyComposition.ConcurrentSerialWitness.concurrentUnguardedProcess
                    (fun st => 3 ≤ st.fst ()) (Becoming.PolyComposition.ConcurrentSerialWitness.concurrentOrbit 0)) ∧
        Becoming.Transactions.fresh Becoming.PolyComposition.ConcurrentSerialWitness.w₁.installation
              Becoming.PolyComposition.ConcurrentSerialWitness.reqB.req =
            false ∧
          Becoming.Reconfiguration.reconfigure Becoming.PolyComposition.ConcurrentSerialWitness.reqB'.opened
                Becoming.PolyComposition.ConcurrentSerialWitness.reqB'.amount
                Becoming.PolyComposition.ConcurrentSerialWitness.reqB'.depth
                Becoming.PolyComposition.ConcurrentSerialWitness.reqB'.candidate
                Becoming.PolyComposition.ConcurrentSerialWitness.w₁ =
              none ∧
            (∀
                (st' :
                  Becoming.PolyComposition.SerialCoordState Becoming.PolyComposition.ConcurrentSerialWitness.SideMode
                    Becoming.PolyComposition.ConcurrentSerialWitness.SideMode
                    Becoming.PolyComposition.ConcurrentSerialWitness.sideS
                    Becoming.PolyComposition.ConcurrentSerialWitness.sideS Unit),
                ¬Becoming.PolyComposition.ConcurrentSerialWitness.csProc.step
                    Becoming.PolyComposition.ConcurrentSerialWitness.stA
                    (Becoming.PolyComposition.SerialCoordAct.reconfigB
                      Becoming.PolyComposition.ConcurrentSerialWitness.reqB')
                    st') ∧
              Becoming.Viability.Kernel Becoming.PolyComposition.ConcurrentSerialWitness.csProc
                Becoming.PolyComposition.ConcurrentSerialWitness.csGuard
                Becoming.PolyComposition.ConcurrentSerialWitness.st₀
