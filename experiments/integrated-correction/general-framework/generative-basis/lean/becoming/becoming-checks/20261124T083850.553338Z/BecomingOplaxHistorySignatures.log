      ∀ (s : Becoming.OplaxHistory.C2CoupledAlignmentWitness.CoupledState),
        Kq (Becoming.OplaxHistory.C2CoupledAlignmentWitness.c2ProjMicro s) →
          Becoming.Viability.Kernel Becoming.OplaxHistory.C2CoupledAlignmentWitness.proc
            Becoming.OplaxHistory.C2CoupledAlignmentWitness.guardS s)
Becoming.OplaxHistory.coprod_strong_vs_time_oplax : ∀ (S : Becoming.OplaxHistory.SumPreservingFunctor)
  {A D C A' D' C' : Type} (H : Becoming.OplaxHistory.RelSpan A D) (K : Becoming.OplaxHistory.RelSpan D C)
  (H' : Becoming.OplaxHistory.RelSpan A' D') (K' : Becoming.OplaxHistory.RelSpan D' C'),
  (∀ (u : S.toFunctor.obj (Becoming.OplaxHistory.PullbackElem H.right K.left)),
      (S.sumBij H.W H'.W).toFun
            ((Becoming.OplaxHistory.chi S.toFunctor (Becoming.OplaxHistory.coprodSpan H H')
                    (Becoming.OplaxHistory.coprodSpan K K')).map
                (S.toFunctor.map (Becoming.OplaxHistory.coprod_pullback_iso H K H' K').toFun
                  (S.toFunctor.map Sum.inl u))).fst =
          Sum.inl ((Becoming.OplaxHistory.chi S.toFunctor H K).map u).fst ∧
        (S.sumBij K.W K'.W).toFun
            ((Becoming.OplaxHistory.chi S.toFunctor (Becoming.OplaxHistory.coprodSpan H H')
                    (Becoming.OplaxHistory.coprodSpan K K')).map
                (S.toFunctor.map (Becoming.OplaxHistory.coprod_pullback_iso H K H' K').toFun
                  (S.toFunctor.map Sum.inl u))).snd =
          Sum.inl ((Becoming.OplaxHistory.chi S.toFunctor H K).map u).snd) ∧
    ∀ (v : S.toFunctor.obj (Becoming.OplaxHistory.PullbackElem H'.right K'.left)),
      (S.sumBij H.W H'.W).toFun
            ((Becoming.OplaxHistory.chi S.toFunctor (Becoming.OplaxHistory.coprodSpan H H')
                    (Becoming.OplaxHistory.coprodSpan K K')).map
                (S.toFunctor.map (Becoming.OplaxHistory.coprod_pullback_iso H K H' K').toFun
                  (S.toFunctor.map Sum.inr v))).fst =
          Sum.inr ((Becoming.OplaxHistory.chi S.toFunctor H' K').map v).fst ∧
        (S.sumBij K.W K'.W).toFun
            ((Becoming.OplaxHistory.chi S.toFunctor (Becoming.OplaxHistory.coprodSpan H H')
                    (Becoming.OplaxHistory.coprodSpan K K')).map
                (S.toFunctor.map (Becoming.OplaxHistory.coprod_pullback_iso H K H' K').toFun
                  (S.toFunctor.map Sum.inr v))).snd =
          Sum.inr ((Becoming.OplaxHistory.chi S.toFunctor H' K').map v).snd
Becoming.OplaxHistory.guarded_interchange_upgrades_iff_bc : ∀ (F : Becoming.OplaxHistory.SpanFunctor) {A D C : Type}
  (H : Becoming.OplaxHistory.RelSpan A D) (K : Becoming.OplaxHistory.RelSpan D C),
