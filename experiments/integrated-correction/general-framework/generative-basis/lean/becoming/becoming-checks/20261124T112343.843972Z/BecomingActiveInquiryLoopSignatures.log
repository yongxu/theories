@Becoming.ActiveInquiryLoop.network_threshold_blindness : ∀ {F C : Type} [DecidableEq C]
  {law : Becoming.ExchangeLaw F C} {W_net W_net' : Becoming.Web F C} {obs_net : F → C → Prop} {part : F → Bool}
  {L_net L_net' : Becoming.Flow F C} {c_stock : C} {θ_net : Nat → Nat},
  law.Through W_net obs_net part →
    (∀ (h : F), part h = false → ¬obs_net h c_stock) →
      (∀ (h : F) (s : Nat), part h = false → W_net.requires s h c_stock → W_net.need s h c_stock ≤ θ_net s) →
        L_net.Balances W_net →
          L_net'.Balances W_net' →
            (∀ (t : Nat), L_net.present t = L_net'.present t) →
              L_net.ActsAlike L_net' part →
                L_net.Follows law part W_net.level →
                  L_net'.Follows law part W_net'.level →
                    ∀ {d_res T_net : Nat},
                      (∀ (s : Nat), s < T_net → θ_net s ≤ W_net.level s c_stock) →
                        (∀ (e : C), e ≠ c_stock → W_net.level 0 e = W_net'.level 0 e) →
                          W_net'.level 0 c_stock = W_net.level 0 c_stock + d_res →
                            law.ReadsBelow part c_stock θ_net ∧
                              (∀ (t : Nat),
                                  t ≤ T_net →
                                    (∀ (e : C), e ≠ c_stock → W_net.level t e = W_net'.level t e) ∧
                                      W_net'.level t c_stock = W_net.level t c_stock + d_res) ∧
                                ∀ (h : F) (cc : C) (s t_ev : Nat),
                                  part h = false → ¬law.RespondsByLevel W_net t_ev h cc s c_stock
