                      (∀ (sA : SA) (sB : SB) (ob : Bool × Bool) (dA : DistA) (dB : DistB),
                          cA.tol (ob.fst, false) dA →
                            cB.tol (ob.snd, false) dB →
                              0 < cA.eta sA ∨ 0 < cB.eta sB →
                                0 < cA.eta (A.next sA (ob.fst, false) dA) ∨ 0 < cB.eta (B.next sB (ob.snd, false) dB)) →
                        0 < cA.eta initA ∨ 0 < cB.eta initB →
                          ∀ (env_adm : Env),
