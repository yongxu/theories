                                                        Becoming.Law.orbit
                                                          (fun st =>
                                                            Becoming.OpenComposition.closedStep comp obs channel G
                                                              envDraw st (env_adm, d₀))
                                                          (x₀, init);
                                                      (orb T).fst site_crit < H_safe + y_safe ∧
                                                        (orb (T + (orb T).fst site_crit)).fst site_crit = 0 ∧
                                                          ∀ (m : Nat),
                                                            (orb (T + (orb T).fst site_crit + m)).fst site_crit = 0) ∧
                                                  ¬Becoming.Viability.Kernel
                                                      (Becoming.OpenComposition.closedProcess comp c obs channel G
                                                        envDraw jointAdm)
                                                      (Becoming.OpenComposition.closedGuard comp c fun x => x_crit)
                                                      (x₀, init)
@Becoming.ActiveInquiryLoop.network_readsBelow_feeds_open_collapse : ∀ {F C S Obs Dist Int Ext Env : Type}
  [inst : DecidableEq C] {law : Becoming.ExchangeLaw F C} {W_net W_net' : Becoming.Web F C} {obs_net : F → C → Prop}
  {part : F → Bool} {L_net L_net' : Becoming.Flow F C} {c_stock : C} {θ_sensor : Nat},
  law.Through W_net obs_net part →
    (∀ (h : F), part h = false → ¬obs_net h c_stock) →
      (∀ (h : F) (s : Nat), part h = false → W_net.requires s h c_stock → W_net.need s h c_stock ≤ θ_sensor) →
        L_net.Balances W_net →
          L_net'.Balances W_net' →
            (∀ (t : Nat), L_net.present t = L_net'.present t) →
              L_net.ActsAlike L_net' part →
                L_net.Follows law part W_net.level →
                  L_net'.Follows law part W_net'.level →
                    ∀ {d_res T_net : Nat},
                      (∀ (s : Nat), s < T_net → θ_sensor ≤ W_net.level s c_stock) →
                        (∀ (e : C), e ≠ c_stock → W_net.level 0 e = W_net'.level 0 e) →
                          W_net'.level 0 c_stock = W_net.level 0 c_stock + d_res →
                            ∀ (h_obs : F),
                              part h_obs = false →
                                ∀ (t_obs : Nat) (c_out : C) (base_level : C → Nat) (readout : Nat → Nat → Obs)
                                  (comp : Becoming.OpenComposition.OpenComponent S Obs Dist Int Ext) {init : S}
                                  (c : Becoming.OpenComposition.InterfaceContract comp init)
                                  (channel : Bool → Nat → Env → Bool) (G : Ext → (Ext → Nat) → Nat)
                                  (envDraw : Env → Ext → Nat) (jointAdm : Env → Prop) (site_crit : Ext)
                                  (x_safe_hi x₀ : Ext → Nat),
                                  θ_sensor ≤ x_safe_hi site_crit →
                                    (∀ (s : S),
                                        comp.emitAlarm s
                                            (readout
                                              (law.take t_obs h_obs
                                                (fun x e => if e = c_stock then x_safe_hi site_crit else base_level e)
                                                c_out)
                                              (law.give t_obs h_obs
                                                (fun x e => if e = c_stock then x_safe_hi site_crit else base_level e)
                                                c_out)) =
                                          false) →
                                      (∀ (load : Nat) (env : Env), channel false load env = false) →
                                        ∀ {Y H_pre H_safe y_safe x_crit n : Nat},
                                          θ_sensor ≤ H_safe + y_safe →
                                            0 < H_safe + y_safe →
                                              x_crit ≤ H_safe + y_safe →
                                                0 < x_crit →
                                                  (∀ (e : Ext → Nat), G site_crit e ≤ Y) →
                                                    Becoming.RegimeMargin.Coupled.Indexed.DependsOn
                                                        Becoming.RegimeMargin.Drawn.whole G site_crit site_crit →
                                                      (∀ (e : Ext → Nat),
                                                          e site_crit < y_safe → G site_crit e < H_safe) →
                                                        Y < H_pre →
                                                          (∀ (s : S), ⋯) →
                                                            (∀ (s : S), c.K s → H_safe ≤ comp.drawExt s site_crit) → ⋯
