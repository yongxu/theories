  (obsFn : α → (Ext → Nat) → Obs) (channel : Bool → Nat → Env → Bool) (G : Ext → (Ext → Nat) → Nat)
  (envDraw : Env → Ext → Nat) (envCap : Ext → Nat) (jointAdm : Env → Prop),
