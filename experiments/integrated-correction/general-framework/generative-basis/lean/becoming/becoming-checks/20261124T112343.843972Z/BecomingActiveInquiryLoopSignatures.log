@Becoming.ActiveInquiryLoop.blanket_compose_closed_viable : ∀ {I₁ S₁ A₁ Dist₁ I₂ S₂ A₂ Dist₂ Ext Env : Type}
  (sp₁ : Becoming.ActiveInquiryLoop.BlanketContractSpec I₁ S₁ A₁ Ext Dist₁)
  (sp₂ : Becoming.ActiveInquiryLoop.BlanketContractSpec I₂ S₂ A₂ Ext Dist₂) (obs₁ : (Ext → Nat) → S₁)
  (obs₂ : (Ext → Nat) → S₂) (channel : Bool → Nat → Env → Bool) (G : Ext → (Ext → Nat) → Nat)
  (envDraw : Env → Ext → Nat) (envCap : Ext → Nat) (jointAdm : Env → Prop),
  (∀ (env : Env), jointAdm env → ∀ (k : Ext), envDraw env k ≤ envCap k) →
    ∀ (x_crit warnLevel H_safe x₀ : Ext → Nat),
      (∀ (x : Ext → Nat) (k : Ext), x k < warnLevel k → sp₁.warnSensory (obs₁ x) ∨ sp₂.warnSensory (obs₂ x)) →
        (∀ (load : Nat) (env : Env),
            jointAdm env → load ≤ sp₁.maxSilence + sp₂.maxSilence → channel true load env = true) →
          (∀ (k : Ext), Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole (G k)) →
            (∀ (k : Ext),
                x_crit k ≤
                  Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G H_safe x_crit k) →
              (∀ (k : Ext), sp₁.postAllowanceExt k + sp₂.postAllowanceExt k + envCap k ≤ H_safe k) →
                (∀ (k : Ext),
                    x_crit k +
                        (Becoming.CoreHelpers.natMax sp₁.maxLag sp₂.maxLag + 1) *
                          (sp₁.preCapExt k + sp₂.preCapExt k + envCap k) ≤
                      warnLevel k) →
                  (∀ (k : Ext),
                      x_crit k +
                          Becoming.CoreHelpers.natMax (sp₁.eta (sp₁.initI, sp₁.initA))
                              (sp₂.eta (sp₂.initI, sp₂.initA)) *
                            (sp₁.preCapExt k + sp₂.preCapExt k + envCap k) ≤
                        x₀ k) →
                    Becoming.BlanketCouplings.BlanketDetermined
                        (Becoming.BlanketCouplings.liftedClosedProcess
                          ((Becoming.ActiveInquiryLoop.componentOfBlanket sp₁).compose
                            (Becoming.ActiveInquiryLoop.componentOfBlanket sp₂))
                          (Becoming.OpenComposition.composeContract (Becoming.ActiveInquiryLoop.contractOfBlanket sp₁)
                            (Becoming.ActiveInquiryLoop.contractOfBlanket sp₂))
                          (fun x => (obs₁ x, obs₂ x)) channel G envDraw jointAdm) ∧
                      Becoming.Viability.Kernel
                        (Becoming.OpenComposition.closedProcess
                          ((Becoming.ActiveInquiryLoop.componentOfBlanket sp₁).compose
                            (Becoming.ActiveInquiryLoop.componentOfBlanket sp₂))
                          (Becoming.OpenComposition.composeContract (Becoming.ActiveInquiryLoop.contractOfBlanket sp₁)
                            (Becoming.ActiveInquiryLoop.contractOfBlanket sp₂))
                          (fun x => (obs₁ x, obs₂ x)) channel G envDraw jointAdm)
                        (Becoming.OpenComposition.closedGuard
                          ((Becoming.ActiveInquiryLoop.componentOfBlanket sp₁).compose
                            (Becoming.ActiveInquiryLoop.componentOfBlanket sp₂))
                          (Becoming.OpenComposition.composeContract (Becoming.ActiveInquiryLoop.contractOfBlanket sp₁)
                            (Becoming.ActiveInquiryLoop.contractOfBlanket sp₂))
                          x_crit)
                        (x₀, (sp₁.initI, sp₁.initA), sp₂.initI, sp₂.initA)
@Becoming.ActiveInquiryLoop.blanket_compose_screening : ∀ {I₁ S₁ A₁ Dist₁ I₂ S₂ A₂ Dist₂ Ext Env : Type}
  (sp₁ : Becoming.ActiveInquiryLoop.BlanketContractSpec I₁ S₁ A₁ Ext Dist₁)
  (sp₂ : Becoming.ActiveInquiryLoop.BlanketContractSpec I₂ S₂ A₂ Ext Dist₂) (obs₁ : (Ext → Nat) → S₁)
  (obs₂ : (Ext → Nat) → S₂) (channel : Bool → Nat → Env → Bool) (G : Ext → (Ext → Nat) → Nat)
  (envDraw : Env → Ext → Nat) (env : Env) (d₁ : Dist₁) (d₂ : Dist₂),
  have comp :=
    (Becoming.ActiveInquiryLoop.componentOfBlanket sp₁).compose (Becoming.ActiveInquiryLoop.componentOfBlanket sp₂);
  have obs := fun x => (obs₁ x, obs₂ x);
  have stepFn := fun st => Becoming.OpenComposition.closedStep comp obs channel G envDraw st (env, d₁, d₂);
  have b := Becoming.BlanketCouplings.closedBlanketLaw comp obs channel G envDraw env (d₁, d₂);
  (∀ {x₀ : Ext → Nat} {p₁ p₂ : (I₁ × A₁) × I₂ × A₂} (n : Nat),
      (∀ (k : Nat),
          k < n →
            comp.drawExt (Becoming.Law.orbit stepFn (x₀, p₁) k).snd =
              comp.drawExt (Becoming.Law.orbit stepFn (x₀, p₂) k).snd) →
        (Becoming.Law.orbit stepFn (x₀, p₁) n).fst = (Becoming.Law.orbit stepFn (x₀, p₂) n).fst) ∧
    ∀ {x₁ x₂ : Ext → Nat} {p₀ : (I₁ × A₁) × I₂ × A₂} (n : Nat),
      (∀ (k : Nat),
          k < n →
            (b.course (Becoming.BlanketCouplings.closedParts comp obs x₁ p₀) k).sensory =
              (b.course (Becoming.BlanketCouplings.closedParts comp obs x₂ p₀) k).sensory) →
        (Becoming.Law.orbit stepFn (x₁, p₀) n).snd = (Becoming.Law.orbit stepFn (x₂, p₀) n).snd
@Becoming.ActiveInquiryLoop.blanket_isolation_necessary_for_determined_parts : ∀ {I S A E M : Type}
  (Q : Generative.Process (Becoming.Blanket.Parts I S A E) M),
  (∃ p₁ p₂ m q₁ q₂,
      p₁.internal = p₂.internal ∧
        p₁.sensory = p₂.sensory ∧
          p₁.active = p₂.active ∧
            Q.step p₁ m q₁ ∧ Q.step p₂ m q₂ ∧ (q₁.internal ≠ q₂.internal ∨ q₁.active ≠ q₂.active)) →
    ¬Becoming.BlanketCouplings.BlanketDetermined Q ∧
      (¬∃ b,
            ∀ (p : Becoming.Blanket.Parts I S A E) (m : M) (q : Becoming.Blanket.Parts I S A E),
              Q.step p m q → q = b.step p) ∧
        ∀ (H : (Nat → Becoming.Blanket.Parts I S A E) → (Nat → M) → Prop),
          (∀ (p : Becoming.Blanket.Parts I S A E) (m : M) (q : Becoming.Blanket.Parts I S A E),
              Q.step p m q → ∃ g ms i, H g ms ∧ g i = p ∧ ms i = m ∧ g (i + 1) = q) →
            ¬Becoming.BlanketCouplings.BlanketConsistentFamily H
