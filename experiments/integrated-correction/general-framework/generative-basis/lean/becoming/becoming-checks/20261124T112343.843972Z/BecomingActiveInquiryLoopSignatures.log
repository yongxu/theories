                                                            t ≤ D → readStep W'.level t = readStep W.level t) ∧
                                                          (∃ T,
                                                              T ≤ D + 1 ∧
                                                                have orb :=
                                                                  Becoming.Law.orbit (fun st => ⋯) (x₀, ⟨0, init⟩);
                                                                (orb T).fst ext_crit < H_safe + y_safe ∧
