    (∀ (t : Nat), t < D → ∀ (c : C), W.level (t + 1) c + L.taken t c = W.level t c + L.given t c) →
      (∀ (t : Nat), t < D → ∀ (c : C), W'.level (t + 1) c + L'.taken t c = W'.level t c + L'.given t c) →
        (∀ (t : Nat), t < D → L.present t = L'.present t) →
          (∀ (c : C), W.level 0 c = W'.level 0 c) →
            (∀ (t : Nat),
                t < D →
                  ∀ (h : F),
                    ¬source t h →
                      W.AlikeThroughUpTo obs_web h W.level W'.level t →
                        ∀ (c : C), L.take t h c = L'.take t h c ∧ L.give t h c = L'.give t h c) →
              (∀ (t : Nat) (h : F), source t h → S_src ≤ t) →
                (∀ (n s : Nat) (c : C),
                    s ≤ D →
                      Becoming.TimedResponse.CoupledIntoAt W obs_web g_mon s c →
                        Becoming.TimedResponse.Linked L L' W obs_web source n c → D < S_src + n) →
                  (∀ (t : Nat) (s : S), t ≤ D → C_comp.emitAlarm s (readStep W.level t) = false) →
                    ∀ (channel : Bool → Nat → Env → Bool),
                      (∀ (load : Nat) (env : Env), channel false load env = false) →
                        ∀ (G : Ext → (Ext → Nat) → Nat) (envDraw : Env → Ext → Nat) (jointAdm : Env → Prop)
                          (x₀ x_crit : Ext → Nat) {Y H_pre H_safe y_safe : Nat},
                          (∀ (e : Ext → Nat), G ext_crit e ≤ Y) →
                            Becoming.RegimeMargin.Coupled.Indexed.DependsOn Becoming.RegimeMargin.Drawn.whole G ext_crit
                                ext_crit →
                              (∀ (e : Ext → Nat), e ext_crit < y_safe → G ext_crit e < H_safe) →
                                Y < H_pre →
                                  0 < H_safe + y_safe →
                                    0 < x_crit ext_crit →
                                      (∀ (s : S), c.K s → 0 < c.eta s → H_pre ≤ C_comp.drawExt s ext_crit) →
                                        (∀ (s : S), c.K s → H_safe ≤ C_comp.drawExt s ext_crit) →
                                          0 < c.eta init →
                                            (∀ (s : S) (ob : Obs) (d : Dist),
                                                c.tol (ob, false) d →
                                                  0 < c.eta s → 0 < c.eta (C_comp.next s (ob, false) d)) →
                                              ∀ (env_adm : Env),
                                                jointAdm env_adm →
                                                  ∀ (d₀ : Dist),
                                                    (∀ (ob : Obs × Bool), c.tol ob d₀) →
                                                      x₀ ext_crit < H_safe + y_safe + (H_pre - Y) * (D + 1) →
