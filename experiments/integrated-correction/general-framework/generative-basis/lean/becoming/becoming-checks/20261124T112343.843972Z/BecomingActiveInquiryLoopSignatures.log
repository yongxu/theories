@Becoming.ActiveInquiryLoop.coupling_distance_obs_alike : ∀ {F C Obs : Type} {L L' : Becoming.Flow F C}
  {W W' : Becoming.Web F C} {obs : F → C → Prop} {source : Nat → F → Prop} {S_src D : Nat} {g_mon : F},
  (∀ (t : Nat), t < D → ∀ (c : C), W.level (t + 1) c + L.taken t c = W.level t c + L.given t c) →
    (∀ (t : Nat), t < D → ∀ (c : C), W'.level (t + 1) c + L'.taken t c = W'.level t c + L'.given t c) →
      (∀ (t : Nat), t < D → L.present t = L'.present t) →
        (∀ (c : C), W.level 0 c = W'.level 0 c) →
          (∀ (t : Nat),
              t < D →
                ∀ (h : F),
                  ¬source t h →
                    W.AlikeThroughUpTo obs h W.level W'.level t →
                      ∀ (c : C), L.take t h c = L'.take t h c ∧ L.give t h c = L'.give t h c) →
            (∀ (t : Nat) (h : F), source t h → S_src ≤ t) →
              ∀ (read : (Nat → C → Nat) → Obs),
                (∀ (l l' : Nat → C → Nat), W.AlikeThroughUpTo obs g_mon l l' D → read l = read l') →
                  (∀ (n s : Nat) (c : C),
                      s ≤ D →
                        Becoming.TimedResponse.CoupledIntoAt W obs g_mon s c →
                          Becoming.TimedResponse.Linked L L' W obs source n c → D < S_src + n) →
                    read W.level = read W'.level
