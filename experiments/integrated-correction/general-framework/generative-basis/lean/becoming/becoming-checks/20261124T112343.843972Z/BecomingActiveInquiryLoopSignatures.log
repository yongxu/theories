  (opComp : Θ → Becoming.OpenComposition.OpenComponent S_op Obs_op Dist_op Int_op Site) (opInit : Θ → S_op)
  (opContract : (θ : Θ) → Becoming.OpenComposition.InterfaceContract (opComp θ) (opInit θ)) {hat θ : Θ},
  hat = θ → (opContract θ).K (opInit hat) ∧ (opContract θ).eta (opInit hat) = (opContract θ).eta (opInit θ)
@Becoming.ActiveInquiryLoop.exploration_margin_sandwich_viable : ∀
  {Θ Probe Outcome S_op Obs_op Dist_op Int_op Site Env : Type}
  (W : Becoming.ActiveInquiryLoop.RegimeWorld Θ Probe Outcome Obs_op Site Env)
  (spec : Becoming.ActiveInquiryLoop.ActiveInquirySpec Θ Probe Outcome S_op Obs_op Dist_op Int_op Site) (θ : Θ)
  (channel : Bool → Nat → Env → Bool) (x_crit warnLevel H_safe x₀ : Site → Nat),
  (∀ (xs : Nat → Site → Nat),
      (∀ (t : Nat), t < spec.horizon → ∀ (site : Site), x_crit site ≤ xs t site) →
        spec.infer (Becoming.ActiveInquiryLoop.probeTranscript W spec.plan θ xs spec.horizon) = θ) →
    (∀ (x : Site → Nat) (site : Site), x site < warnLevel site → (spec.opContract θ).warnObs (W.opObs θ x)) →
      (∀ (load : Nat) (env : Env),
          W.jointAdm env → load ≤ (spec.opContract θ).maxSilence → channel true load env = true) →
        (∀ (site : Site),
            x_crit site ≤
              Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole (W.G θ) H_safe x_crit site) →
          (∀ (site : Site), (spec.opContract θ).postBudgetExt site + W.envCap site ≤ H_safe site) →
            (∀ (site : Site),
                x_crit site + ((spec.opContract θ).maxLag + 1) * ((spec.opContract θ).preCapExt site + W.envCap site) ≤
                  warnLevel site) →
              (∀ (site : Site),
                  x_crit site + spec.horizon * (spec.probeDraw site + W.envCap site) +
                      ((spec.opContract θ).maxLag + 1) * ((spec.opContract θ).preCapExt site + W.envCap site) ≤
                    x₀ site) →
                have proc :=
                  Becoming.PolyComposition.polyClosedProcess (Becoming.ActiveInquiryLoop.inquiryPolyComponent spec)
                    (fun x site => [site]) (Becoming.ActiveInquiryLoop.inquiryContract spec)
                    (Becoming.ActiveInquiryLoop.inquiryWorldObs W spec θ) channel (W.G θ) (W.envDraw θ) W.jointAdm;
                Becoming.Viability.Certificate proc
                    (Becoming.PolyComposition.polyClosedGuard (Becoming.ActiveInquiryLoop.inquiryPolyComponent spec)
                      (Becoming.ActiveInquiryLoop.inquiryContract spec) x_crit)
                    (Becoming.ActiveInquiryLoop.ExploreMarginInv W spec θ x_crit) ∧
                  Becoming.Viability.Kernel proc
                    (Becoming.PolyComposition.polyClosedGuard (Becoming.ActiveInquiryLoop.inquiryPolyComponent spec)
                      (Becoming.ActiveInquiryLoop.inquiryContract spec) x_crit)
                    (x₀, Becoming.ActiveInquiryLoop.inquiryInit spec)
@Becoming.ActiveInquiryLoop.exploration_untaken_silence_collapse : ∀ {S A I Q Obs P : Type}
  {C₁ : Becoming.CausalSystem S A I} (C₂ : Becoming.CausalSystem Q A Bool) {π : S → Q} {ω : I → Bool},
  C₂.obs = false →
    ω C₁.obs = false →
      (∃ j₀, ω j₀ = true) →
        ∀ (r : Becoming.Run C₁.passive) (r_benign : Becoming.Run C₂.passive),
          r_benign.state 0 = π (r.state 0) →
            (∀ (s : Nat), r_benign.act s = r.act s) →
              ∀ {t : Nat} {k_probe : Q} {a_probe : A},
                (∃ Proc, Becoming.Determined Proc ∧ r.StepsThrough π Proc t) →
                  ¬r.TakesThrough π t k_probe a_probe →
                    Becoming.Determined C₂.passive →
                      Becoming.Determined (C₂.proc true) →
                        Becoming.FactorsThrough C₁.passive π C₂.passive →
                          ∀ {κ₁ κ₂ : Q},
                            κ₁ ≠ κ₂ →
                              ∀ {Y H_pre H_safe y_safe n : Nat} (g_frag x_frag : Nat → Nat)
                                (policy : Nat → (Nat → Obs) → P) (draw : P → Nat),
                                (∀ (s : Nat) (o₁ o₂ : Nat → Obs),
                                    (∀ (j : Nat), j ≤ s → o₁ j = o₂ j) → policy s o₁ = policy s o₂) →
                                  ∀ (readObs : Q → Obs) (obsFrag : Nat → Obs),
                                    (∀ (s : Nat), H_safe + y_safe ≤ x_frag s → obsFrag s = readObs (π (r.state s))) →
                                      (∀ (s : Nat),
                                          x_frag (s + 1) =
                                            Becoming.RegimeMargin.step g_frag (draw (policy s obsFrag)) (x_frag s)) →
                                        Becoming.RegimeMargin.AtMost g_frag Y →
                                          Y < H_pre →
                                            Becoming.RegimeMargin.Short g_frag H_safe y_safe →
                                              Becoming.RegimeMargin.FromNothing g_frag →
                                                0 < H_safe + y_safe →
                                                  (∀ (s : Nat),
                                                      H_pre ≤ draw (policy s fun k => readObs (r_benign.state k))) →
                                                    (∀ (s : Nat),
                                                        x_frag s < H_safe + y_safe → H_safe ≤ draw (policy s obsFrag)) →
                                                      x_frag 0 < H_safe + y_safe + (H_pre - Y) * n →
                                                        ((¬∃ κ, r.FixesThrough π t k_probe a_probe κ) ∧
                                                            ∃ j₀ D₁ D₂,
                                                              ω j₀ = true ∧
                                                                (D₁.proc (ω j₀)).step k_probe a_probe κ₁ ∧
                                                                  (D₂.proc (ω j₀)).step k_probe a_probe κ₂ ∧
                                                                    r.StepsThrough π D₁.passive t ∧
                                                                      r.StepsThrough π D₂.passive t) ∧
                                                          ∃ T,
                                                            T ≤ n ∧
                                                              x_frag T < H_safe + y_safe ∧
                                                                (∀ (k : Nat), x_frag (T + k) < H_safe + y_safe) ∧
                                                                  x_frag (T + x_frag T) = 0 ∧
                                                                    ∀ (m : Nat), x_frag (T + x_frag T + m) = 0
@Becoming.ActiveInquiryLoop.learnable_passive_underdetermined : ∀ {S R V : Type} {next : S → S} {reg : S → R}
  {val : S → V} (pred : List R → Option V) {r r' : Becoming.Run (Becoming.Law.process next)},
  Becoming.Alike (Becoming.Law.frameBy next reg) (Becoming.Law.frameBy next reg) (r.state 0) (r'.state 0) →
    (∀ (T : Nat), ∃ t, T ≤ t ∧ val (r.state t) ≠ val (r'.state t)) →
      ∀ (g : Nat → Becoming.Run (Becoming.Law.process next) → Option V),
        Becoming.LearnableRuns.FixedThrough reg g →
          ¬(Becoming.LearnableRuns.Predicts reg val pred r ∧ Becoming.LearnableRuns.Predicts reg val pred r') ∧
            ¬(Becoming.Learnable.Predicts next reg val pred (r.state 0) ∧
                  Becoming.Learnable.Predicts next reg val pred (r'.state 0)) ∧
              ¬Becoming.Limit.Tracks g fun k run => some (val (run.state k))
@Becoming.ActiveInquiryLoop.limit_passive_delay_obstruction : ∀ {S A Θ P : Type} [inst : DecidableEq Θ]
  {Proc : Generative.Process S A} (g : Nat → Becoming.Run Proc → Option Θ) (H : Becoming.Run Proc → Θ),
  (Becoming.Limit.Identifies g fun r => some (H r)) →
    (∀ (k : Nat) (r r' : Becoming.Run Proc), Becoming.Run.AgreeUpTo k r r' → g k r = g k r') →
      ∀ {D : Nat} (r_benign r_frag : Becoming.Run Proc),
        Becoming.Run.AgreeUpTo D r_benign r_frag →
          ∀ (g_frag x_frag : Nat → Nat) (policy : Nat → Option Θ → P) (draw : P → Nat) {Y H_pre H_safe y_safe : Nat},
            (∀ (t : Nat),
                x_frag (t + 1) = Becoming.RegimeMargin.step g_frag (draw (policy t (g t r_frag))) (x_frag t)) →
              Becoming.RegimeMargin.AtMost g_frag Y →
                Y < H_pre →
                  Becoming.RegimeMargin.Short g_frag H_safe y_safe →
                    Becoming.RegimeMargin.FromNothing g_frag →
                      0 < H_safe + y_safe →
                        (∀ (t : Nat), t < D → H_pre ≤ draw (policy t (g t r_benign))) →
                          (∀ (t : Nat), x_frag t < H_safe + y_safe → H_safe ≤ draw (policy t (g t r_frag))) →
                            x_frag 0 < H_safe + y_safe + (H_pre - Y) * D →
                              (Becoming.Limit.Verifies (Becoming.Limit.says g (some (H r_benign))) fun r =>
                                  some (H r) = some (H r_benign)) ∧
                                (∀ (t : Nat), t ≤ D → g t r_frag = g t r_benign) ∧
                                  ∃ T,
                                    T ≤ D ∧
                                      x_frag T < H_safe + y_safe ∧
                                        x_frag (T + x_frag T) = 0 ∧ ∀ (m : Nat), x_frag (T + x_frag T + m) = 0
@Becoming.ActiveInquiryLoop.exploration_deadline_impossibility : ∀ {F C Obs P : Type} {L L' : Becoming.Flow F C}
  {W W' : Becoming.Web F C} {obs_web : F → C → Prop} {source : Nat → F → Prop} {g_mon : F} {D_probe : Nat},
  (∀ (t : Nat), t < D_probe → ∀ (c : C), W.level (t + 1) c + L.taken t c = W.level t c + L.given t c) →
    (∀ (t : Nat), t < D_probe → ∀ (c : C), W'.level (t + 1) c + L'.taken t c = W'.level t c + L'.given t c) →
      (∀ (t : Nat), t < D_probe → L.present t = L'.present t) →
        (∀ (c : C), W.level 0 c = W'.level 0 c) →
          (∀ (t : Nat),
              t < D_probe →
                ∀ (h : F),
                  ¬source t h →
                    W.AlikeThroughUpTo obs_web h W.level W'.level t →
                      ∀ (c : C), L.take t h c = L'.take t h c ∧ L.give t h c = L'.give t h c) →
            ∀ (readStep : (Nat → C → Nat) → Nat → Obs),
              (∀ (t : Nat),
                  t ≤ D_probe →
                    ∀ (l l' : Nat → C → Nat), W.AlikeThroughUpTo obs_web g_mon l l' t → readStep l t = readStep l' t) →
                ¬Becoming.TimedResponse.ReachedBy L L' W obs_web source g_mon D_probe →
                  ∀ (g_frag x_frag : Nat → Nat) (policy : Nat → Obs → P) (draw : P → Nat)
                    {Y H_explore H_safe y_safe : Nat},
                    (∀ (t : Nat),
                        x_frag (t + 1) =
                          Becoming.RegimeMargin.step g_frag (draw (policy t (readStep W'.level t))) (x_frag t)) →
                      Becoming.RegimeMargin.AtMost g_frag Y →
                        Y < H_explore →
                          Becoming.RegimeMargin.Short g_frag H_safe y_safe →
                            Becoming.RegimeMargin.FromNothing g_frag →
                              0 < H_safe + y_safe →
                                (∀ (t : Nat), t < D_probe → H_explore ≤ draw (policy t (readStep W.level t))) →
                                  (∀ (t : Nat), D_probe ≤ t → H_safe ≤ draw (policy t (readStep W'.level t))) →
                                    x_frag 0 < H_safe + y_safe + (H_explore - Y) * D_probe →
                                      (∀ (t : Nat), t ≤ D_probe → readStep W.level t = readStep W'.level t) ∧
                                        ∃ T,
                                          T ≤ D_probe ∧
                                            x_frag T < H_safe + y_safe ∧
                                              x_frag (T + x_frag T) = 0 ∧ ∀ (m : Nat), x_frag (T + x_frag T + m) = 0
