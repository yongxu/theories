                                                                  (Becoming.ActiveInquiryLoop.clockedPolyComponent
                                                                    C_comp)
                                                                  (fun x e => [e])
                                                                  (Becoming.ActiveInquiryLoop.clockedPolyContract c)
                                                                  (fun t x => readStep W'.level t) channel G envDraw
                                                                  jointAdm)
                                                                (Becoming.PolyComposition.polyClosedGuard
                                                                  (Becoming.ActiveInquiryLoop.clockedPolyComponent
                                                                    C_comp)
                                                                  (Becoming.ActiveInquiryLoop.clockedPolyContract c)
                                                                  x_crit)
                                                                (x₀, ⟨0, init⟩)
