@Becoming.ActiveInquiryLoop.varDraw_falls_or_bound_while : ∀ {x d gain : Nat → Nat} {Y H_min b n : Nat},
  (∀ (t : Nat), t < n → x (t + 1) = x t - d t + gain t) →
    (∀ (t : Nat), t < n → gain t ≤ Y) →
      (∀ (t : Nat), t < n → x t < d t → gain t = 0) →
        Y ≤ H_min →
          (∀ (t : Nat), t < n → (∀ (j : Nat), j ≤ t → b ≤ x j) → H_min ≤ d t) →
            0 < b →
              ∀ (m : Nat), m ≤ n → (∃ k, k ≤ m ∧ x k < b) ∨ x m + (H_min - Y) * m ≤ x 0 ∧ ∀ (j : Nat), j ≤ m → b ≤ x j
@Becoming.ActiveInquiryLoop.varDraw_falls_within_while : ∀ {x d gain : Nat → Nat} {Y H_min b : Nat},
  (∀ (t : Nat), x (t + 1) = x t - d t + gain t) →
    (∀ (t : Nat), gain t ≤ Y) →
      (∀ (t : Nat), x t < d t → gain t = 0) →
        Y ≤ H_min →
          ∀ (n : Nat),
            (∀ (t : Nat), t < n → (∀ (j : Nat), j ≤ t → b ≤ x j) → H_min ≤ d t) →
              0 < b → x 0 < b + (H_min - Y) * n → ∃ k, k ≤ n ∧ x k < b
@Becoming.ActiveInquiryLoop.varDraw_short_collapses : ∀ {x d gain : Nat → Nat} {b_nr T : Nat},
  (∀ (t : Nat), x (t + 1) = x t - d t + gain t) →
    0 < b_nr →
      (∀ (t : Nat), T ≤ t → x t < d t → x t < b_nr → gain t = 0) →
        (∀ (t : Nat), T ≤ t → d t ≤ x t → x t < b_nr → gain t < d t) →
          x T < b_nr →
            (∀ (k : Nat), x (T + k) < b_nr ∧ x (T + k) ≤ x T - k) ∧ x (T + x T) = 0 ∧ ∀ (m : Nat), x (T + x T + m) = 0
@Becoming.ActiveInquiryLoop.silent_drawdown_refutes_kernel : ∀ {S Obs Dist Int Ext Env : Type}
  (C : Becoming.OpenComposition.OpenComponent S Obs Dist Int Ext) {init : S}
  (c : Becoming.OpenComposition.InterfaceContract C init) (obs : (Ext → Nat) → Obs) (channel : Bool → Nat → Env → Bool)
  (G : Ext → (Ext → Nat) → Nat) (envDraw : Env → Ext → Nat) (jointAdm : Env → Prop) (x_crit x₀ : Ext → Nat)
  (site_crit : Ext) {Y H_pre n : Nat},
  (∀ (e : Ext → Nat), G site_crit e ≤ Y) →
    Becoming.RegimeMargin.Coupled.Indexed.DependsOn Becoming.RegimeMargin.Drawn.whole G site_crit site_crit →
      Y < H_pre →
        0 < x_crit site_crit →
          ∀ (env_adm : Env),
            jointAdm env_adm →
              ∀ (d₀ : Dist),
                (∀ (ob : Obs × Bool), c.tol ob d₀) →
                  (have orb :=
                      Becoming.Law.orbit
                        (fun st => Becoming.OpenComposition.closedStep C obs channel G envDraw st (env_adm, d₀))
                        (x₀, init);
                    ∀ (t : Nat),
                      t < n →
                        (∀ (j : Nat), j ≤ t → x_crit site_crit ≤ (orb j).fst site_crit) →
                          H_pre ≤ C.drawExt (orb t).snd site_crit) →
                    x₀ site_crit < x_crit site_crit + (H_pre - Y) * n →
                      ¬Becoming.Viability.Kernel
                          (Becoming.OpenComposition.closedProcess C c obs channel G envDraw jointAdm)
                          (Becoming.OpenComposition.closedGuard C c x_crit) (x₀, init)
@Becoming.ActiveInquiryLoop.probeTranscript_congr : ∀ {Θ Probe Outcome Obs_op Site Env : Type}
  (W : Becoming.ActiveInquiryLoop.RegimeWorld Θ Probe Outcome Obs_op Site Env) (plan : Nat → Probe) (θ : Θ)
  {xs₁ xs₂ : Nat → Site → Nat} (t : Nat),
