                        (Becoming.ActiveInquiryLoop.composeListObsIndexed obsFn head tail) channel G envDraw jointAdm)
                      (Becoming.OpenComposition.closedGuard
                        (Becoming.OpenComposition.composeListComponent comp head tail)
                        (Becoming.OpenComposition.composeListContract contract head tail) x_crit)
                      (x₀, Becoming.OpenComposition.composeListInit init head tail)
