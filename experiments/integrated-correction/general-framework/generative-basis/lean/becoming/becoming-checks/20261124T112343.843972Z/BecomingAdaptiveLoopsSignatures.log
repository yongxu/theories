          (Becoming.AdaptiveLoops.raceOrbit Becoming.AdaptiveLoops.tooSlowParams 5).stock < 5 ∧
            (Becoming.AdaptiveLoops.raceOrbit Becoming.AdaptiveLoops.tooSlowParams 7).stock = 0
@Becoming.AdaptiveLoops.paced_fast_succ_local : ∀ {S R : Type} (f : S → R → S) (h : S → R → R) (reads : Nat → Bool)
  (c : S × R) (t : Nat),
  (Becoming.Pace.paced f h reads c (t + 1)).fst =
    f (Becoming.Pace.paced f h reads c t).fst (Becoming.Pace.paced f h reads c t).snd
@Becoming.AdaptiveLoops.unread_orbit_le : ∀ {A R : Type} {f : A × Nat → R → A × Nat} {h : A × Nat → R → R}
  {reads : Nat → Bool} {gSub : Nat → Nat},
  (∀ (z₁ z₂ : Nat), z₁ ≤ z₂ → gSub z₁ ≤ gSub z₂) →
    ∀ (jointDraw : A → R → Nat),
      (∀ (a : A) (x : Nat) (r : R), (f (a, x) r).snd = Becoming.RegimeMargin.step gSub (jointDraw a r) x) →
        ∀ {a₀ : A} {r₀ : R} {b₀ H_joint : Nat},
          (∀ (t : Nat),
              H_joint ≤
                jointDraw (Becoming.Pace.paced f h reads ((a₀, b₀), r₀) t).fst.fst
                  (Becoming.Pace.paced f h reads ((a₀, b₀), r₀) t).snd) →
            ∀ (t : Nat),
              (Becoming.Pace.paced f h reads ((a₀, b₀), r₀) t).fst.snd ≤
                (Becoming.Law.run (Becoming.RegimeMargin.step gSub H_joint) b₀).state t
@Becoming.AdaptiveLoops.unread_adaptive_joint_collapse : ∀ {A R : Type} {f : A × Nat → R → A × Nat}
  {h : A × Nat → R → R} (reads : Nat → Bool),
  Becoming.ClosedCapture.Unread f h →
    ∀ {gSub : Nat → Nat},
      (∀ (z₁ z₂ : Nat), z₁ ≤ z₂ → gSub z₁ ≤ gSub z₂) →
        ∀ (jointDraw : A → R → Nat),
          (∀ (a : A) (x : Nat) (r : R), (f (a, x) r).snd = Becoming.RegimeMargin.step gSub (jointDraw a r) x) →
            ∀ (a₀ : A) (r₀ : R) (b₀ b_big H_joint Y y n : Nat),
              (∀ (t : Nat),
                  H_joint ≤
                    jointDraw (Becoming.Pace.paced f h reads ((a₀, b₀), r₀) t).fst.fst
                      (Becoming.Pace.paced f h reads ((a₀, b₀), r₀) t).snd) →
                Becoming.RegimeMargin.AtMost gSub Y →
                  Y ≤ H_joint →
                    Becoming.RegimeMargin.Short gSub H_joint y →
                      Becoming.RegimeMargin.FromNothing gSub →
                        b₀ < H_joint + y + (H_joint - Y) * n →
                          (∀ (t : Nat),
                              (Becoming.Pace.paced f h reads ((a₀, b₀), r₀) t).fst.fst =
