              (Becoming.AdaptiveLoops.raceOrbit Becoming.AdaptiveLoops.silencedParams t).rule = true) ∧
          (Becoming.AdaptiveLoops.raceOrbit Becoming.AdaptiveLoops.silencedParams 6).stock = 0
