@Becoming.AdaptiveLoops.assume_guarantee_joint_viable : ∀ {α ι Env : Type} {S Obs Dist : α → Type} (agents : List α)
  (sites : List ι),
  (∀ (j : ι), j ∈ sites) →
    ∀ (L : (i : α) → Becoming.AdaptiveLoops.OpenLoop (S i) (Obs i) (Dist i) ι) (init : (i : α) → S i)
      (certs : (i : α) → Becoming.AdaptiveLoops.LoopCertificate (L i) (init i)) (obs : (i : α) → (ι → Nat) → Obs i)
      (channel : (α → Bool) → (α → Nat) → Env → Bool) (G : ι → (ι → Nat) → Nat) (envDraw : Env → ι → Nat)
      (envCap : ι → Nat) (jointAdm : Env → Prop),
      (∀ (env : Env), jointAdm env → ∀ (j : ι), envDraw env j ≤ envCap j) →
        ∀ (x_crit warnLevel H_safe x₀ : ι → Nat) (monitored : α → ι → Prop),
          (∀ (i : α),
              i ∈ agents → ∀ (x : ι → Nat) (j : ι), monitored i j → x j < warnLevel j → (certs i).warnObs (obs i x)) →
            (∀ (j : ι), j ∈ sites → ∃ i, i ∈ agents ∧ monitored i j) →
              (∀ (emit : α → Bool) (load : α → Nat) (env : Env),
                  jointAdm env →
                    (∃ i, i ∈ agents ∧ emit i = true ∧ load i ≤ (certs i).maxSilence) →
                      (∀ (i : α), i ∈ agents → load i ≤ (certs i).maxSilence) → channel emit load env = true) →
                (∀ (i : ι), Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole (G i)) →
                  (∀ (j : ι),
                      x_crit j ≤
                        Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G H_safe x_crit
                          j) →
                    (∀ (j : ι),
                        Becoming.AdaptiveLoops.sumDraws agents (fun i => (certs i).postBudget) j + envCap j ≤
                          H_safe j) →
                      (∀ (j : ι),
                          x_crit j +
                              (Becoming.AdaptiveLoops.globalMaxLag agents certs + 1) *
                                Becoming.AdaptiveLoops.preTotal agents certs envCap j ≤
                            warnLevel j) →
                        (∀ (j : ι),
                            x_crit j +
                                Becoming.AdaptiveLoops.maxEta agents certs init *
                                  Becoming.AdaptiveLoops.preTotal agents certs envCap j ≤
                              x₀ j) →
                          Becoming.AdaptiveLoops.jointInv agents certs envCap x_crit (x₀, init) ∧
                            Becoming.Viability.Certificate
                              (Becoming.AdaptiveLoops.jointProcess agents L certs obs channel G envDraw jointAdm)
                              (Becoming.AdaptiveLoops.jointGuard agents L certs x_crit)
                              (Becoming.AdaptiveLoops.jointInv agents certs envCap x_crit)
@Becoming.AdaptiveLoops.assume_guarantee_joint_kernel : ∀ {α ι Env : Type} {S Obs Dist : α → Type} (agents : List α)
  (sites : List ι),
  (∀ (j : ι), j ∈ sites) →
    ∀ (L : (i : α) → Becoming.AdaptiveLoops.OpenLoop (S i) (Obs i) (Dist i) ι) (init : (i : α) → S i)
      (certs : (i : α) → Becoming.AdaptiveLoops.LoopCertificate (L i) (init i)) (obs : (i : α) → (ι → Nat) → Obs i)
      (channel : (α → Bool) → (α → Nat) → Env → Bool) (G : ι → (ι → Nat) → Nat) (envDraw : Env → ι → Nat)
      (envCap : ι → Nat) (jointAdm : Env → Prop),
      (∀ (env : Env), jointAdm env → ∀ (j : ι), envDraw env j ≤ envCap j) →
        ∀ (x_crit warnLevel H_safe x₀ : ι → Nat) (monitored : α → ι → Prop),
          (∀ (i : α),
              i ∈ agents → ∀ (x : ι → Nat) (j : ι), monitored i j → x j < warnLevel j → (certs i).warnObs (obs i x)) →
            (∀ (j : ι), j ∈ sites → ∃ i, i ∈ agents ∧ monitored i j) →
              (∀ (emit : α → Bool) (load : α → Nat) (env : Env),
                  jointAdm env →
                    (∃ i, i ∈ agents ∧ emit i = true ∧ load i ≤ (certs i).maxSilence) →
                      (∀ (i : α), i ∈ agents → load i ≤ (certs i).maxSilence) → channel emit load env = true) →
                (∀ (i : ι), Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole (G i)) →
                  (∀ (j : ι),
                      x_crit j ≤
                        Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G H_safe x_crit
                          j) →
                    (∀ (j : ι),
                        Becoming.AdaptiveLoops.sumDraws agents (fun i => (certs i).postBudget) j + envCap j ≤
                          H_safe j) →
                      (∀ (j : ι),
                          x_crit j +
                              (Becoming.AdaptiveLoops.globalMaxLag agents certs + 1) *
                                Becoming.AdaptiveLoops.preTotal agents certs envCap j ≤
                            warnLevel j) →
                        (∀ (j : ι),
                            x_crit j +
                                Becoming.AdaptiveLoops.maxEta agents certs init *
                                  Becoming.AdaptiveLoops.preTotal agents certs envCap j ≤
                              x₀ j) →
                          Becoming.Viability.Kernel
                            (Becoming.AdaptiveLoops.jointProcess agents L certs obs channel G envDraw jointAdm)
                            (Becoming.AdaptiveLoops.jointGuard agents L certs x_crit) (x₀, init)
