        Becoming.Web.MajorityHolds Becoming.AdaptiveLoops.raceMembers
          (Becoming.AdaptiveLoops.raceMemberRead K_silence loss)
          (Becoming.AdaptiveLoops.signalLevel Becoming.ReadingLoop.Untested.Value.mid)) ∧
