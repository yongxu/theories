    5 ≤ (Becoming.AdaptiveLoops.raceOrbit Becoming.AdaptiveLoops.goodParams t).stock) ∧
  ((∀ (t : Nat),
        Becoming.AdaptiveLoops.raceOrbit Becoming.AdaptiveLoops.noDiscParams t =
