@Becoming.withAct_self_next_pointwise : ∀ {F C : Type} (law : Becoming.ExchangeLaw F C) (present : Nat → List F)
  (part : F → Bool) (x : Nat × (Nat → C → Nat)),
  ((law.withAct part law).next present x).fst = (law.next present x).fst ∧
    ∀ (s : Nat) (c : C), ((law.withAct part law).next present x).snd s c = (law.next present x).snd s c
@Becoming.exactCausal_passive_factors : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4} {B : Type u_5}
  {J : Type u_6} {C₁ : Becoming.CausalSystem S A I} {C₂ : Becoming.CausalSystem Q B J} {π : S → Q} {φ : A → B}
  {ω : I → J}, Becoming.ExactCausalAbs C₁ C₂ π φ ω → Becoming.FactorsThroughMap C₁.passive C₂.passive π φ
@Becoming.exactCausal_trace_map : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4} {B : Type u_5}
  {J : Type u_6} {C₁ : Becoming.CausalSystem S A I} {C₂ : Becoming.CausalSystem Q B J} {π : S → Q} {φ : A → B}
  {ω : I → J},
  Becoming.ExactCausalAbs C₁ C₂ π φ ω →
    ∀ (i : I) {s s' : S} {w : List A},
      Generative.Trace (C₁.proc i) s w s' → Generative.Trace (C₂.proc (ω i)) (π s) (List.map φ w) (π s')
@Becoming.exactCausal_trace_exact_iff : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4} {B : Type u_5}
  {J : Type u_6} {C₁ : Becoming.CausalSystem S A I} {C₂ : Becoming.CausalSystem Q B J} {π : S → Q} {φ : A → B}
  {ω : I → J} (abs : Becoming.ExactCausalAbs C₁ C₂ π φ ω),
  abs.Lifts →
    ∀ (i : I) {s : S} {wQ : List B} {q' : Q},
      Generative.Trace (C₂.proc (ω i)) (π s) wQ q' ↔
        ∃ w s', List.map φ w = wQ ∧ Generative.Trace (C₁.proc i) s w s' ∧ π s' = q'
@Becoming.exactCausal_commuting_iff : ∀ {S : Type u_1} {I : Type u_2} {Q : Type u_3} {J : Type u_4}
  {next₁ : I → S → Unit → S} {next₂ : J → Q → Unit → Q} {obs₁ : I} {obs₂ : J} {π : S → Q} {φ : Unit → Unit} {ω : I → J},
  Becoming.ExactCausalAbs (Becoming.CausalSystem.ofMap next₁ obs₁) (Becoming.CausalSystem.ofMap next₂ obs₂) π φ ω ↔
    ω obs₁ = obs₂ ∧ ∀ (i : I), Becoming.ProjectedLaws.Commuting (next₁ i) (next₂ (ω i)) π
@Becoming.scheduledProcess_trace_block : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3}
  {C : Becoming.CausalSystem S A I} {σ : Nat → Nat},
  Becoming.Strict σ →
    ∀ (sched : Nat → I) {k t₀ : Nat} {s : S} {w : List A} {ts' : Nat × S},
      σ k ≤ t₀ →
        t₀ + w.length ≤ σ (k + 1) →
          Generative.Trace (C.scheduledProcess σ sched) (t₀, s) w ts' →
            ts'.fst = t₀ + w.length ∧ Generative.Trace (C.proc (sched k)) s w ts'.snd
@Becoming.laxCausal_openLoop_kernel_transfer : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4}
  {B : Type u_5} {J : Type u_6} {C₁ : Becoming.CausalSystem S A I} {C₂ : Becoming.CausalSystem Q B J} {π : S → Q}
  {ω : I → J} {σ : Nat → Nat} {M : Becoming.SlackDist Q} (lc : Becoming.LaxCausalAbs C₁ C₂ π ω σ M) (sched : Nat → I)
  {guardQ : Nat × Q → Prop} {guardS : Nat × S → Prop} (Δ : Nat),
  lc.α Δ + lc.ε ≤ Δ →
    (∀ (kq : Nat × Q) (u : Nat × S), guardQ kq → M.d (π u.snd) kq.snd ≤ lc.β Δ + lc.η → guardS u) →
      ∀ {s₀ : S},
        lc.Epoch (σ 0) s₀ →
          Becoming.Viability.Kernel (C₂.scheduledProcess id fun k => ω (sched k)) guardQ (0, π s₀) →
            Becoming.Viability.Kernel (C₁.scheduledProcess σ sched) guardS (σ 0, s₀)
@Becoming.laxCausal_openLoop_keptFor_linear : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4}
  {B : Type u_5} {J : Type u_6} {C₁ : Becoming.CausalSystem S A I} {C₂ : Becoming.CausalSystem Q B J} {π : S → Q}
  {ω : I → J} {σ : Nat → Nat} {M : Becoming.SlackDist Q} (lc : Becoming.LaxCausalAbs C₁ C₂ π ω σ M),
  lc.α = id →
    ∀ (sched : Nat → I) {guardQ : Nat × Q → Prop} {guardS : Nat × S → Prop} (N : Nat),
      0 < N →
        (∀ (kq : Nat × Q) (u : Nat × S), guardQ kq → M.d (π u.snd) kq.snd ≤ lc.β ((N - 1) * lc.ε) + lc.η → guardS u) →
          ∀ {s₀ : S},
            lc.Epoch (σ 0) s₀ →
              Becoming.Viability.Kernel (C₂.scheduledProcess id fun k => ω (sched k)) guardQ (0, π s₀) →
                ∀ (w : List A) (t : Nat × S),
                  w.length < σ N - σ 0 → Generative.Trace (C₁.scheduledProcess σ sched) (σ 0, s₀) w t → guardS t
@Becoming.exactCausal_feedback_trace_map : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4} {B : Type u_5}
  {J : Type u_6} {C₁ : Becoming.CausalSystem S A I} {C₂ : Becoming.CausalSystem Q B J} {π : S → Q} {φ : A → B}
  {ω : I → J},
  Becoming.ExactCausalAbs C₁ C₂ π φ ω →
    ∀ (κ : Q → I) {s s' : S} {w : List A},
      Generative.Trace (C₁.feedbackProcess fun x => κ (π x)) s w s' →
        Generative.Trace (C₂.feedbackProcess fun q => ω (κ q)) (π s) (List.map φ w) (π s')
@Becoming.exactCausal_feedback_kernel_transfer : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4}
  {B : Type u_5} {J : Type u_6} {C₁ : Becoming.CausalSystem S A I} {C₂ : Becoming.CausalSystem Q B J} {π : S → Q}
  {φ : A → B} {ω : I → J},
  Becoming.ExactCausalAbs C₁ C₂ π φ ω →
    ∀ (κ : Q → I) {guardQ : Q → Prop} {guardS : S → Prop},
      (∀ (s : S), guardQ (π s) → guardS s) →
        ∀ {s₀ : S},
          Becoming.Viability.Kernel (C₂.feedbackProcess fun q => ω (κ q)) guardQ (π s₀) →
            Becoming.Viability.Kernel (C₁.feedbackProcess fun s => κ (π s)) guardS s₀
@Becoming.laxCausal_feedback_kernel_transfer : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4}
  {B : Type u_5} {J : Type u_6} {C₁ : Becoming.CausalSystem S A I} {C₂ : Becoming.CausalSystem Q B J} {π : S → Q}
  {ω : I → J} {M : Becoming.SlackDist Q} (lc : Becoming.LaxCausalAbs C₁ C₂ π ω id M) (κ : Q → I) {guardQ K : Q → Prop}
  {guardS : S → Prop} (Δ : Nat),
  lc.α Δ + lc.ε ≤ Δ →
    (∀ (q : Q), K q → guardQ q) →
      (∀ (q₁ q₂ : Q) (b : B) (q₂' : Q), K q₂ → M.d q₁ q₂ ≤ Δ → (C₂.proc (ω (κ q₁))).step q₂ b q₂' → K q₂') →
        (∀ (q : Q) (u : S), guardQ q → M.d (π u) q ≤ lc.β Δ + lc.η → guardS u) →
          ∀ {s₀ : S},
            lc.Epoch 0 s₀ → K (π s₀) → Becoming.Viability.Kernel (C₁.feedbackProcess fun s => κ (π s)) guardS s₀
@Becoming.laxCausal_feedback_kernel_transfer_of_ball_invariant : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3}
  {Q : Type u_4} {B : Type u_5} {J : Type u_6} {C₁ : Becoming.CausalSystem S A I} {C₂ : Becoming.CausalSystem Q B J}
  {π : S → Q} {ω : I → J} {M : Becoming.SlackDist Q} (lc : Becoming.LaxCausalAbs C₁ C₂ π ω id M) (κ : Q → I)
  {guardQ K : Q → Prop} {guardS : S → Prop},
  Becoming.Viability.Certificate (C₂.feedbackProcess fun q => ω (κ q)) guardQ K →
    ∀ (Δ : Nat),
      lc.α Δ + lc.ε ≤ Δ →
        (∀ (q₁ q₂ : Q), K q₂ → M.d q₁ q₂ ≤ Δ → ω (κ q₁) = ω (κ q₂)) →
          (∀ (q : Q) (u : S), guardQ q → M.d (π u) q ≤ lc.β Δ + lc.η → guardS u) →
            ∀ {s₀ : S},
              lc.Epoch 0 s₀ → K (π s₀) → Becoming.Viability.Kernel (C₁.feedbackProcess fun s => κ (π s)) guardS s₀
@Becoming.laxCausal_feedback_keptFor_linear : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4}
  {B : Type u_5} {J : Type u_6} {C₁ : Becoming.CausalSystem S A I} {C₂ : Becoming.CausalSystem Q B J} {π : S → Q}
  {ω : I → J} {M : Becoming.SlackDist Q} (lc : Becoming.LaxCausalAbs C₁ C₂ π ω id M),
  lc.α = id →
    ∀ (κ : Q → I) {guardQ K : Q → Prop} {guardS : S → Prop} (N : Nat),
      0 < N →
        (∀ (q : Q), K q → guardQ q) →
          (∀ (q₁ q₂ : Q) (b : B) (q₂' : Q),
              K q₂ → M.d q₁ q₂ ≤ (N - 1) * lc.ε → (C₂.proc (ω (κ q₁))).step q₂ b q₂' → K q₂') →
            (∀ (q : Q) (u : S), guardQ q → M.d (π u) q ≤ lc.β ((N - 1) * lc.ε) + lc.η → guardS u) →
              ∀ {s₀ : S},
                lc.Epoch 0 s₀ →
                  K (π s₀) →
                    ∀ (w : List A) (t : S),
                      w.length < N → Generative.Trace (C₁.feedbackProcess fun s => κ (π s)) s₀ w t → guardS t
@Becoming.length_snoc : ∀ {α : Type u_1} (w : List α) (a : α), (w ++ [a]).length = w.length + 1
@Becoming.trace_snoc : ∀ {S : Type u_1} {A : Type u_2} {P : Generative.Process S A} {s t u : S} {w : List A} {a : A},
  Generative.Trace P s w t → P.step t a u → Generative.Trace P s (w ++ [a]) u
@Becoming.sampledFeedbackProcess_trace_block : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4}
  {C : Becoming.CausalSystem S A I} {σ : Nat → Nat},
  Becoming.Strict σ →
    ∀ (π : S → Q) (κ : Q → I) {k t₀ : Nat} {i₀ : I} {s : S} {w : List A} {st' : Nat × I × S},
      σ k ≤ t₀ →
        t₀ + w.length ≤ σ (k + 1) →
          Generative.Trace (Becoming.sampledFeedbackProcess C σ π κ) (t₀, i₀, s) w st' →
            st'.fst = t₀ + w.length ∧
              Generative.Trace (C.proc i₀) s w st'.snd.snd ∧
                (t₀ + w.length < σ (k + 1) → st'.snd.fst = i₀) ∧
                  (w ≠ [] → t₀ + w.length = σ (k + 1) → st'.snd.fst = κ (π st'.snd.snd))
@Becoming.laxCausal_sampledFeedback_kernel_transfer : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4}
  {B : Type u_5} {J : Type u_6} {C₁ : Becoming.CausalSystem S A I} {C₂ : Becoming.CausalSystem Q B J} {π : S → Q}
  {ω : I → J} {σ : Nat → Nat} {M : Becoming.SlackDist Q} (lc : Becoming.LaxCausalAbs C₁ C₂ π ω σ M) (κ : Q → I)
  {guardQ K : Q → Prop} {guardS : S → Prop} (Δ : Nat),
  lc.α Δ + lc.ε ≤ Δ →
    (∀ (q : Q), K q → guardQ q) →
      (∀ (q₁ q₂ : Q) (b : B) (q₂' : Q), K q₂ → M.d q₁ q₂ ≤ Δ → (C₂.proc (ω (κ q₁))).step q₂ b q₂' → K q₂') →
        (∀ (q : Q) (u : S), guardQ q → M.d (π u) q ≤ lc.β Δ + lc.η → guardS u) →
          ∀ {s₀ : S},
            lc.Epoch (σ 0) s₀ →
              K (π s₀) →
                Becoming.Viability.Kernel (Becoming.sampledFeedbackProcess C₁ σ π κ) (fun st => guardS st.snd.snd)
                  (σ 0, κ (π s₀), s₀)
