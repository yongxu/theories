    (Becoming.CausalGoodhartWitness.π Becoming.CausalGoodhartWitness.s₀) ∧
  (Becoming.CausalGoodhartWitness.π Becoming.CausalGoodhartWitness.s₀).toNat <
    (Becoming.CausalGoodhartWitness.stepMacro true
        (Becoming.CausalGoodhartWitness.π Becoming.CausalGoodhartWitness.s₀)).toNat
Becoming.CausalGoodhartWitness.micro_boost_guardS_collapses : ∃ s₂,
  Generative.Trace (Becoming.CausalGoodhartWitness.micro.proc true) Becoming.CausalGoodhartWitness.s₀ [(), ()] s₂ ∧
    ¬Becoming.CausalGoodhartWitness.guardS s₂ ∧
      Becoming.CausalGoodhartWitness.guardQ (Becoming.CausalGoodhartWitness.π s₂)
Becoming.CausalGoodhartWitness.micro_boost_proxy_collapses : ∃ s₃,
  Generative.Trace (Becoming.CausalGoodhartWitness.micro.proc true) Becoming.CausalGoodhartWitness.s₀ [(), (), ()] s₃ ∧
    ¬Becoming.CausalGoodhartWitness.guardQ (Becoming.CausalGoodhartWitness.π s₃)
Becoming.CausalGoodhartWitness.no_exact_causal_abs_any_omega : ∀ (φ : Unit → Unit) (ω : Bool → Bool),
  ¬Becoming.ExactCausalAbs Becoming.CausalGoodhartWitness.micro Becoming.CausalGoodhartWitness.macroSys
      Becoming.CausalGoodhartWitness.π φ ω
@Becoming.CausalGoodhartWitness.no_zero_slack_lax_causal_abs : ∀ {ω : Bool → Bool} {σ : Nat → Nat},
  σ 0 = 0 →
    ∀
      (lc :
        Becoming.LaxCausalAbs Becoming.CausalGoodhartWitness.micro Becoming.CausalGoodhartWitness.macroSys
          Becoming.CausalGoodhartWitness.π ω σ Becoming.CausalGoodhartWitness.levelDist),
      ¬(lc.Epoch 0 Becoming.CausalGoodhartWitness.s₀ ∧ lc.α 0 = 0 ∧ lc.ε = 0)
@Becoming.CausalGoodhartWitness.no_small_slack_lax_causal_abs : ∀ {ω : Bool → Bool}
  (lc :
    Becoming.LaxCausalAbs Becoming.CausalGoodhartWitness.micro Becoming.CausalGoodhartWitness.macroSys
      Becoming.CausalGoodhartWitness.π ω id Becoming.CausalGoodhartWitness.levelDist),
  ¬((∀ (s : Becoming.CausalGoodhartWitness.Level × Becoming.CausalGoodhartWitness.Level), lc.Epoch 0 s) ∧
      lc.α 0 + lc.ε ≤ 1)
@Becoming.«因像定当且仅当因同行» : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4} {J : Type u_5}
  (C : Becoming.CausalSystem S A I) (π : S → Q) (ω : I → J),
  (∀ (j : J), Becoming.Determined ((Becoming.CausalImage C π ω).proc j)) ↔ Becoming.CausalGoAlike C π ω
@Becoming.exactCausal_exists_iff_causalGoAlike : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4}
  {J : Type u_5} (C : Becoming.CausalSystem S A I) (π : S → Q) (ω : I → J),
  (∃ D, (∀ (j : J), Becoming.Determined (D.proc j)) ∧ Becoming.ExactCausalAbs C D π id ω) ↔ Becoming.CausalGoAlike C π ω
@Becoming.imageMap_iff_grammar : ∀ {S : Type u_1} {A : Type u_2} {Q : Type u_3} {B : Type u_4}
  (P : Generative.Process S A) (π : S → Q) (φ : A → B) (q q' : Q) (b : B),
  (Becoming.ImageMap P π φ).step q b q' ↔ Becoming.«像» π (fun s s' => ∃ a, φ a = b ∧ P.step s a s') q q'
@Becoming.exactCausalMap_exists_iff : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4} {B : Type u_5}
  {J : Type u_6} (C : Becoming.CausalSystem S A I) (π : S → Q) (φ : A → B) (ω : I → J),
  (∃ D, (∀ (j : J), Becoming.Determined (D.proc j)) ∧ Becoming.ExactCausalAbs C D π φ ω) ↔
    Becoming.CausalGoAlikeMap C π φ ω
@Becoming.keepRow_eq_iff : ∀ {C : Type} (keep : C → Bool) (r r' : C → Nat) (cs : List C),
  Becoming.keepRow keep r cs = Becoming.keepRow keep r' cs ↔ ∀ (c : C), c ∈ cs → keep c = true → r c = r' c
@Becoming.keepHist_eq_iff : ∀ {C : Type} (keep : C → Bool) (cs : List C) (l l' : Nat → C → Nat) (t : Nat),
  Becoming.keepHist keep cs l t = Becoming.keepHist keep cs l' t ↔
    ∀ (s : Nat), s ≤ t → ∀ (c : C), c ∈ cs → keep c = true → l s c = l' s c
@Becoming.projectHistList_eq_iff : ∀ {C : Type} (keep : C → Bool) (cs : List C) (x x' : Nat × (Nat → C → Nat)),
  Becoming.projectHistList keep cs x = Becoming.projectHistList keep cs x' ↔
    x.fst = x'.fst ∧ ∀ (s : Nat), s ≤ x.fst → ∀ (c : C), c ∈ cs → keep c = true → x.snd s c = x'.snd s c
@Becoming.withAct_sensitive_iff : ∀ {F C : Type} (law act : Becoming.ExchangeLaw F C) (part : F → Bool) {h : F} {c : C},
  (law.withAct part act).Sensitive h c ↔ part h = false ∧ law.Sensitive h c ∨ part h = true ∧ act.Sensitive h c
@Becoming.exchange_givesAlike_iff_sensitive_in : ∀ {F C : Type} [DecidableEq C] (law : Becoming.ExchangeLaw F C),
  law.Nonanticipating →
    ∀ (cs : List C),
      (∀ (c : C), c ∈ cs) →
        ∀ (keep : C → Bool) (h : F),
          (∀ (t : Nat) (l l' : Nat → C → Nat),
              Becoming.keepHist keep cs l t = Becoming.keepHist keep cs l' t → law.GivesAlike t h l l') ↔
            ∀ (c : C), law.Sensitive h c → keep c = true
@Becoming.exactCausal_of_exchange_sensitive_in : ∀ {F C : Type} [DecidableEq C] (law : Becoming.ExchangeLaw F C)
  (present : Nat → List F) (part : F → Bool) (cs : List C),
  (∀ (c : C), c ∈ cs) →
    ∀ (keep : C → Bool) (ω : Option (Becoming.ExchangeLaw F C) → Option (Becoming.ExchangeLaw F C)),
      (∀ (j : Option (Becoming.ExchangeLaw F C)), (Becoming.effectiveLaw law part (ω j)).Nonanticipating) →
        (∀ (j : Option (Becoming.ExchangeLaw F C)) (t : Nat) (h : F) (l : Nat → C → Nat) (c : C),
            h ∈ present t →
              (Becoming.effectiveLaw law part j).take t h l c = (Becoming.effectiveLaw law part (ω j)).take t h l c ∧
                (Becoming.effectiveLaw law part j).give t h l c = (Becoming.effectiveLaw law part (ω j)).give t h l c) →
          (∀ (j : Option (Becoming.ExchangeLaw F C)) (t : Nat) (h : F) (c : C),
              h ∈ present t → (Becoming.effectiveLaw law part (ω j)).Sensitive h c → keep c = true) →
            ∃ D,
              (∀ (j : Option (Becoming.ExchangeLaw F C)), Becoming.Determined (D.proc j)) ∧
                Becoming.ExactCausalAbs (Becoming.CausalSystem.ofExchangeLaw law present part) D
                  (Becoming.projectHistList keep cs) id ω
@Becoming.withAct_self_next_projectHistList : ∀ {F C : Type} (law : Becoming.ExchangeLaw F C) (present : Nat → List F)
  (part : F → Bool) (keep : C → Bool) (cs : List C) (x : Nat × (Nat → C → Nat)),
  Becoming.projectHistList keep cs ((law.withAct part law).next present x) =
    Becoming.projectHistList keep cs (law.next present x)
@Becoming.sensitive_in_of_through : ∀ {F C : Type} {law : Becoming.ExchangeLaw F C} {W : Becoming.Web F C}
  {obs : F → C → Prop} {part : F → Bool},
  law.Through W obs part →
    ∀ {h : F},
      part h = false →
        ∀ (keep : C → Bool),
          (∀ (c : C), W.CoupledInto obs h c → keep c = true) → ∀ (c : C), law.Sensitive h c → keep c = true
@Becoming.causal_underdetermined_of_untaken : ∀ {S : Type u_1} {A : Type u_2} {I : Type u_3} {Q : Type u_4}
  {C₁ : Becoming.CausalSystem S A I} (C₂ : Becoming.CausalSystem Q A Bool) {π : S → Q} {ω : I → Bool},
  C₂.obs = false →
    ω C₁.obs = false →
      (∃ j₀, ω j₀ = true) →
        ∀ (r : Becoming.Run C₁.passive) {t : Nat} {k : Q} {a : A},
          (∃ P, Becoming.Determined P ∧ r.StepsThrough π P t) →
            ¬r.TakesThrough π t k a →
              Becoming.Determined C₂.passive →
                Becoming.Determined (C₂.proc true) →
                  Becoming.FactorsThrough C₁.passive π C₂.passive →
                    ∀ {κ₁ κ₂ : Q},
                      κ₁ ≠ κ₂ →
                        (¬∃ κ, r.FixesThrough π t k a κ) ∧
                          ∃ j₀ D₁ D₂,
                            ω j₀ = true ∧
                              (∀ (j : Bool), Becoming.Determined (D₁.proc j)) ∧
                                (∀ (j : Bool), Becoming.Determined (D₂.proc j)) ∧
                                  Becoming.FactorsThrough C₁.passive π D₁.passive ∧
                                    Becoming.FactorsThrough C₁.passive π D₂.passive ∧
                                      r.StepsThrough π D₁.passive t ∧
                                        r.StepsThrough π D₂.passive t ∧
                                          (D₁.proc (ω j₀)).step k a κ₁ ∧
                                            (D₂.proc (ω j₀)).step k a κ₂ ∧ ω C₁.obs = D₁.obs ∧ ω C₁.obs = D₂.obs
@Becoming.mechanism_intervention_underdetermined : ∀ {X : Type u_1} {U : Type u_2} {E : Type u_3} (F : X → U → E → X)
  (r : Becoming.Run (Becoming.CausalSystem.ofMechanism F).passive) {t : Nat} {x : X} {u' : U} {e' : E},
  ¬r.Takes t x (u', e') →
    ∀ {y z : X},
      y ≠ z →
        (¬∃ w, r.Fixes t x (u', e') w) ∧
          ((Becoming.CausalSystem.ofMechanism F).proc (some u')).step x (u', e') (F x u' e') ∧
            ∀ (w : X), ((Becoming.CausalSystem.ofMechanism F).proc (some u')).step x (u', e') w → w = F x u' e'
@Becoming.exactCausal_refuted_of_confound_varied : ∀ {J : Type u_1}
  (D : Becoming.CausalSystem Bool Becoming.Confound.Move J),
  (∀ (j : J), Becoming.Determined (D.proc j)) →
    ∀ (ω : Unit → J),
      (∀ (t : Nat),
          (Becoming.Confound.run Becoming.Confound.aligned).StepsThrough Becoming.Confound.outcome
            Becoming.Confound.moveDecides t) ∧
        ¬Becoming.ExactCausalAbs { proc := fun x => Becoming.Confound.process, obs := () } D Becoming.Confound.outcome
            id ω
Becoming.PositiveCoupledFeedbackWitness.no_exact_causal_abs : ∀ (φ : Unit → Unit) (ω : Bool → Bool),
  ¬Becoming.ExactCausalAbs Becoming.PositiveCoupledFeedbackWitness.micro
      Becoming.PositiveCoupledFeedbackWitness.macroSys Becoming.PositiveCoupledFeedbackWitness.π φ ω
Becoming.PositiveCoupledFeedbackWitness.step_projection_err : ∀ (i : Bool) (s : Nat × Bool),
  Becoming.distNat ((Becoming.PositiveCoupledFeedbackWitness.nextMicro i s).fst / 2)
      (Becoming.PositiveCoupledFeedbackWitness.nextMacro i (Becoming.PositiveCoupledFeedbackWitness.π s)) ≤
    1
Becoming.PositiveCoupledFeedbackWitness.feedback_viability_kernel : Becoming.Viability.Kernel
  (Becoming.PositiveCoupledFeedbackWitness.micro.feedbackProcess fun s =>
    Becoming.PositiveCoupledFeedbackWitness.κ (Becoming.PositiveCoupledFeedbackWitness.π s))
  Becoming.PositiveCoupledFeedbackWitness.guardS Becoming.PositiveCoupledFeedbackWitness.s₀
Becoming.PositiveCoupledFeedbackWitness.openLoop_viability_kernel : Becoming.Viability.Kernel
  (Becoming.PositiveCoupledFeedbackWitness.micro.scheduledProcess id fun x => true)
  (fun ts => Becoming.PositiveCoupledFeedbackWitness.guardS ts.snd) (0, Becoming.PositiveCoupledFeedbackWitness.s₀)
