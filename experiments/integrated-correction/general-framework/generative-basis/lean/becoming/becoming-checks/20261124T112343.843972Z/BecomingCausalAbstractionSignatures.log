@Becoming.ofOpenComposite_step_iff : ∀ {S₁ S₂ Obs₁ Obs₂ Dist₁ Dist₂ Int₁ Int₂ Ext : Type}
  (A : Becoming.OpenComposition.OpenComponent S₁ Obs₁ Dist₁ Int₁ Ext)
  (B : Becoming.OpenComposition.OpenComponent S₂ Obs₂ Dist₂ Int₂ Ext) (tol₁ : Obs₁ × Bool → Dist₁ → Prop)
  (tol₂ : Obs₂ × Bool → Dist₂ → Prop) (ov : (Option Obs₁ × Option Obs₂) × Option Bool) (s s' : S₁ × S₂)
  (m : ((Obs₁ × Obs₂) × Bool) × Dist₁ × Dist₂),
  ((Becoming.CausalSystem.ofOpenComposite A B tol₁ tol₂).proc ov).step s m s' ↔
    ((Becoming.CausalSystem.ofOpenComponent A tol₁).proc (ov.fst.fst, ov.snd)).step s.fst
        ((m.fst.fst.fst, m.fst.snd), m.snd.fst) s'.fst ∧
      ((Becoming.CausalSystem.ofOpenComponent B tol₂).proc (ov.fst.snd, ov.snd)).step s.snd
        ((m.fst.fst.snd, m.fst.snd), m.snd.snd) s'.snd
@Becoming.ofOpenComposite_boundary_local : ∀ {S₁ S₂ Obs₁ Obs₂ Dist₁ Dist₂ Int₁ Int₂ Ext : Type}
  (A : Becoming.OpenComposition.OpenComponent S₁ Obs₁ Dist₁ Int₁ Ext)
  (B : Becoming.OpenComposition.OpenComponent S₂ Obs₂ Dist₂ Int₂ Ext) (tol₁ : Obs₁ × Bool → Dist₁ → Prop)
  (tol₂ : Obs₂ × Bool → Dist₂ → Prop) (ov₂ : Option Obs₂) (s s' : S₁ × S₂) (m : ((Obs₁ × Obs₂) × Bool) × Dist₁ × Dist₂),
  ((Becoming.CausalSystem.ofOpenComposite A B tol₁ tol₂).proc ((none, ov₂), none)).step s m s' →
    (A.process tol₁).step s.fst ((m.fst.fst.fst, m.fst.snd), m.snd.fst) s'.fst
@Becoming.ExactCausalAbs.composeOpen : ∀
  {S₁ S₂ Obs₁ Obs₂ Dist₁ Dist₂ Int₁ Int₂ Ext S₁' S₂' Obs₁' Obs₂' Dist₁' Dist₂' Int₁' Int₂' Ext' : Type}
  {A₁ : Becoming.OpenComposition.OpenComponent S₁ Obs₁ Dist₁ Int₁ Ext}
  {A₂ : Becoming.OpenComposition.OpenComponent S₂ Obs₂ Dist₂ Int₂ Ext}
  {B₁ : Becoming.OpenComposition.OpenComponent S₁' Obs₁' Dist₁' Int₁' Ext'}
  {B₂ : Becoming.OpenComposition.OpenComponent S₂' Obs₂' Dist₂' Int₂' Ext'} {tol₁ : Obs₁ × Bool → Dist₁ → Prop}
  {tol₂ : Obs₂ × Bool → Dist₂ → Prop} {tol₁' : Obs₁' × Bool → Dist₁' → Prop} {tol₂' : Obs₂' × Bool → Dist₂' → Prop}
  {π₁ : S₁ → S₁'} {π₂ : S₂ → S₂'} {φ₁ : (Obs₁ × Bool) × Dist₁ → (Obs₁' × Bool) × Dist₁'}
  {φ₂ : (Obs₂ × Bool) × Dist₂ → (Obs₂' × Bool) × Dist₂'} {ω₁ : Option Obs₁ × Option Bool → Option Obs₁' × Option Bool}
  {ω₂ : Option Obs₂ × Option Bool → Option Obs₂' × Option Bool},
  Becoming.ExactCausalAbs (Becoming.CausalSystem.ofOpenComponent A₁ tol₁)
      (Becoming.CausalSystem.ofOpenComponent B₁ tol₁') π₁ φ₁ ω₁ →
    Becoming.ExactCausalAbs (Becoming.CausalSystem.ofOpenComponent A₂ tol₂)
        (Becoming.CausalSystem.ofOpenComponent B₂ tol₂') π₂ φ₂ ω₂ →
      ∀ (ω : (Option Obs₁ × Option Obs₂) × Option Bool → (Option Obs₁' × Option Obs₂') × Option Bool),
        (∀ (ov : (Option Obs₁ × Option Obs₂) × Option Bool), ((ω ov).fst.fst, (ω ov).snd) = ω₁ (ov.fst.fst, ov.snd)) →
          (∀ (ov : (Option Obs₁ × Option Obs₂) × Option Bool), ((ω ov).fst.snd, (ω ov).snd) = ω₂ (ov.fst.snd, ov.snd)) →
            (∀ (o₁ : Obs₁) (o₂ : Obs₂) (al : Bool) (d₁ : Dist₁) (d₂ : Dist₂),
                (φ₁ ((o₁, al), d₁)).fst.snd = (φ₂ ((o₂, al), d₂)).fst.snd) →
              Becoming.ExactCausalAbs (Becoming.CausalSystem.ofOpenComposite A₁ A₂ tol₁ tol₂)
                (Becoming.CausalSystem.ofOpenComposite B₁ B₂ tol₁' tol₂') (fun s => (π₁ s.fst, π₂ s.snd))
                (fun m =>
                  have b₁ := φ₁ ((m.fst.fst.fst, m.fst.snd), m.snd.fst);
                  have b₂ := φ₂ ((m.fst.fst.snd, m.fst.snd), m.snd.snd);
                  (((b₁.fst.fst, b₂.fst.fst), b₁.fst.snd), b₁.snd, b₂.snd))
                ω
