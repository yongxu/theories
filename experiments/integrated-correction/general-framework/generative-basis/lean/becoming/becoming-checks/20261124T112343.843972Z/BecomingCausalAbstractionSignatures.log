@Becoming.ExactCausalAbs.prod : ∀ {S₁ : Type u_1} {A₁ : Type u_2} {I₁ : Type u_3} {S₂ : Type u_4} {A₂ : Type u_5}
  {I₂ : Type u_6} {Q₁ : Type u_7} {B₁ : Type u_8} {J₁ : Type u_9} {Q₂ B₂ J₂ : Type}
  {C₁ : Becoming.CausalSystem S₁ A₁ I₁} {C₂ : Becoming.CausalSystem S₂ A₂ I₂} {D₁ : Becoming.CausalSystem Q₁ B₁ J₁}
  {D₂ : Becoming.CausalSystem Q₂ B₂ J₂} {π₁ : S₁ → Q₁} {φ₁ : A₁ → B₁} {ω₁ : I₁ → J₁} {π₂ : S₂ → Q₂} {φ₂ : A₂ → B₂}
