@Becoming.EvolutionaryDrawdown.multiSite_overdraw_separation : ∀ {S Obs Dist Int Ext Env : Type}
  (C : Becoming.OpenComposition.OpenComponent S Obs Dist Int Ext) (obs : (Ext → Nat) → Obs)
  (channel : Bool → Nat → Env → Bool) (G : Ext → (Ext → Nat) → Nat) (envDraw : Env → Ext → Nat)
  {st : Nat → (Ext → Nat) × S} {env : Nat → Env} {dist : Nat → Dist},
  (∀ (t : Nat), st (t + 1) = Becoming.OpenComposition.closedStep C obs channel G envDraw (st t) (env t, dist t)) →
    ∀ {sites : List Ext} {tStar : Nat} {kStar : Ext},
      kStar ∈ sites →
        (∀ (t : Nat),
            t < tStar →
              ∀ (k : Ext),
                k ∈ sites → Becoming.EvolutionaryDrawdown.multiSiteDrawAt C envDraw st env t k ≤ (st t).fst k) →
          (st tStar).fst kStar < Becoming.EvolutionaryDrawdown.multiSiteDrawAt C envDraw st env tStar kStar →
            (∀ (k : Ext),
                k ∈ sites →
                  k ≠ kStar →
                    Becoming.EvolutionaryDrawdown.multiSiteDrawAt C envDraw st env tStar k ≤ (st tStar).fst k) →
              have H := Becoming.EvolutionaryDrawdown.multiSiteDrawAt C envDraw st env;
              have L := Becoming.EvolutionaryDrawdown.multiSiteFlow C G envDraw st env;
              have W := Becoming.EvolutionaryDrawdown.multiSiteWeb C G envDraw st env;
              (∀ (t : Nat),
                  t < tStar → L.BalancesOn W (List.map Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site sites) t) ∧
                (∀ (k : Ext),
                    k ∈ sites →
                      k ≠ kStar →
                        W.level (tStar + 1) (Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site k) +
                            L.taken tStar (Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site k) =
                          W.level tStar (Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site k) +
                            L.given tStar (Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site k)) ∧
                  ((st (tStar + 1)).fst kStar + H tStar kStar =
                        (st tStar).fst kStar +
                            L.given tStar (Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site kStar) +
                          (H tStar kStar - (st tStar).fst kStar) ∧
                      0 < H tStar kStar - (st tStar).fst kStar) ∧
                    W.level tStar (Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site kStar) +
                          L.given tStar (Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site kStar) <
                        W.level (tStar + 1) (Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site kStar) +
                          L.taken tStar (Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site kStar) ∧
                      W.level (tStar + 1) (Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site kStar) +
                            L.taken tStar (Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site kStar) =
                          W.level tStar (Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site kStar) +
                              L.given tStar (Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site kStar) +
                            (H tStar kStar - (st tStar).fst kStar) ∧
                        ¬L.BalancesOn W (List.map Becoming.EvolutionaryDrawdown.MultiSiteRelatum.site sites) tStar ∧
                          ¬L.Balances W ∧
                            ¬(Becoming.EvolutionaryDrawdown.multiSiteRel C G envDraw st env).Runs
                                Becoming.EvolutionaryDrawdown.multiSitePresent
                                (Becoming.EvolutionaryDrawdown.multiSiteLevel st) L
@Becoming.EvolutionaryDrawdown.unintegrated_confined_takeover_ends : ∀ {X : Type} {L : Becoming.Flow X X}
  {W : Becoming.Web X X},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {G : Becoming.SelectionTerm.Generations X} {h h_fast ds_h : List X} {m T n : Nat},
          Becoming.Founding.Flow.ConfinedRise L W G h_fast ds_h m T n →
            Becoming.SelectionTerm.Flow.Descended L W G →
