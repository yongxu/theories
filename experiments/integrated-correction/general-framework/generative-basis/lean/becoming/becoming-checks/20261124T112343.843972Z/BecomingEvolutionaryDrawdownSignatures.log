@Becoming.EvolutionaryDrawdown.derived_regime_exhausts_within : ∀ {X : Type} {L : Becoming.Flow X X}
  {W : Becoming.Web X X} {G : Becoming.SelectionTerm.Generations X} {ds : List X} {m hi T : Nat},
  Becoming.EvolutionaryDrawdown.EmbodiedConversion L W G ds m →
    ∀ {giving x : Nat → Nat},
      (∀ (t : Nat), x (t + 1) = Becoming.RegimeMargin.step giving (L.uptake ds t) (x t)) →
        Becoming.RegimeMargin.FromNothing giving →
          Becoming.RegimeMargin.Keeps giving 0 hi →
            x T ≤ hi →
              (∀ (j : Nat), j ≤ hi → G.size (T + j) < G.size (T + j + 1)) →
                x (T + hi + 1) = 0 ∧ ∃ j, j ≤ hi ∧ x (T + j) ≤ L.uptake ds (T + j)
@Becoming.EvolutionaryDrawdown.derived_line_grows_and_ends : ∀ {U : Type} {need : U → Nat} {kids : U → List U}
  {giving : Nat → Nat} {use : U → Nat} {m hi : Nat},
  (∀ (u v : U), v ∈ kids u → m ≤ use v) →
    (∀ (u : U), use u < (kids u).length * m) →
      Becoming.RegimeMargin.FromNothing giving →
        Becoming.RegimeMargin.Keeps giving 0 hi →
          (∀ (u : U), 0 < need u) →
            (∀ (u v : U), v ∈ kids u → need v ≤ need u) →
              ∀ {w : List U} {x : Nat},
                x ≤ hi →
                  (∀ (u : U), use u < Becoming.LineOnAStock.taken use (kids u)) ∧
                    (∃ n,
                        ¬Becoming.LineOnAStock.Goes need (Becoming.LineOnAStock.course need kids giving use (w, x) n)) ∧
                      ¬Becoming.«不穷» (Becoming.LineOnAStock.net need kids giving use) Becoming.«一» (w, x)
@Becoming.EvolutionaryDrawdown.embodied_selection_surplus_impossible_past : ∀ {X : Type} {L : Becoming.Flow X X}
  {W : Becoming.Web X X},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {G : Becoming.SelectionTerm.Generations X} {ds : List X} {m R T : Nat},
          Becoming.EvolutionaryDrawdown.EmbodiedConversion L W G ds m →
            (∀ (t : Nat), L.replenishment ds t ≤ R) →
              G.size 0 ≤ G.size 1 →
                G.size 0 * G.sum T ≠ G.size T * G.sum 0 →
                  have T_ex := T + (R + 1);
                  ¬∀ (t : Nat),
                      t ≤ T_ex + W.stock ds T_ex →
                        (∀ (p : X), p ∈ G.family t → G.amount t p = G.offspringNumber t p) ∧
                          (∀ (p : X),
                              p ∈ G.family t →
                                W.Supported t p → ∀ (q : X), q ∈ G.family t → G.amount t q ≤ G.amount t p) ∧
                            Becoming.SelectionTerm.Exact (G.family t) (G.kids t) (G.amount t) (G.amount (t + 1))
@Becoming.EvolutionaryDrawdown.derived_surplus_drawdown_collapse : ∀ {X : Type} {L : Becoming.Flow X X}
  {W : Becoming.Web X X},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {G : Becoming.SelectionTerm.Generations X} {ds : List X} {m R m_need T n : Nat},
          (∀ (t : Nat), L.replenishment ds t ≤ R) →
            (∀ (p : X),
                p ∈ G.family (T + (R + 1) + n) →
                  W.active (T + (R + 1) + n) p →
                    ∃ e, e ∈ ds ∧ W.requires (T + (R + 1) + n) p e ∧ m_need ≤ W.need (T + (R + 1) + n) p e) →
              Becoming.EvolutionaryDrawdown.EmbodiedConversion L W G ds m →
                (∀ (t : Nat), t < T + (R + 1) → ∀ (p : X), p ∈ G.family t → G.amount t p = G.offspringNumber t p) →
                  (∀ (t : Nat),
                      t < T + (R + 1) →
                        ∀ (p : X),
                          p ∈ G.family t → W.Supported t p → ∀ (q : X), q ∈ G.family t → G.amount t q ≤ G.amount t p) →
                    (∀ (t : Nat),
                        t < T + (R + 1) →
                          Becoming.SelectionTerm.Exact (G.family t) (G.kids t) (G.amount t) (G.amount (t + 1))) →
                      G.size 0 ≤ G.size 1 →
                        G.size 0 * G.sum T ≠ G.size T * G.sum 0 →
                          (∀ (k : Nat), k < n → R + 1 ≤ G.size (T + (R + 1) + k + 1)) →
                            W.stock ds (T + (R + 1)) < n + m_need →
                              have T_ex := T + (R + 1);
                              (∃ t, t < T ∧ G.discordAt t < G.concordAt t) ∧
                                R + 2 ≤ G.size T_ex ∧
                                  (∀ (k : Nat), k < n → L.replenishment ds (T_ex + k) < L.uptake ds (T_ex + k)) ∧
                                    W.stock ds (T_ex + n) < m_need ∧
                                      (∀ (p : X), p ∈ G.family (T_ex + n) → ¬W.active (T_ex + n) p) ∧
                                        G.size (T_ex + n + 1) = 0
