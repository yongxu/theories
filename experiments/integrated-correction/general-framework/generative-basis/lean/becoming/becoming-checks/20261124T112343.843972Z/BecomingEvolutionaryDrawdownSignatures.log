@Becoming.EvolutionaryDrawdown.derived_surplus_of_selection_within : ∀ {X : Type} {L : Becoming.Flow X X}
  {W : Becoming.Web X X},
  L.Acting W →
    W.Dependent →
      ∀ {G : Becoming.SelectionTerm.Generations X},
        Becoming.SelectionTerm.Flow.Descended L W G →
          ∀ {T K : Nat},
            T < K →
              (∀ (t : Nat), t < K → ∀ (p : X), p ∈ G.family t → G.amount t p = G.offspringNumber t p) →
                (∀ (t : Nat),
                    t < K →
                      ∀ (p : X),
                        p ∈ G.family t → W.Supported t p → ∀ (q : X), q ∈ G.family t → G.amount t q ≤ G.amount t p) →
                  (∀ (t : Nat),
                      t < K → Becoming.SelectionTerm.Exact (G.family t) (G.kids t) (G.amount t) (G.amount (t + 1))) →
                    G.size 0 ≤ G.size 1 →
                      G.size 0 * G.sum T ≠ G.size T * G.sum 0 →
                        (∃ t, t < T ∧ G.discordAt t < G.concordAt t) ∧
                          0 < G.size T ∧
                            (∀ (s : Nat), T ≤ s → s < K → G.size s < G.size (s + 1)) ∧
                              ∀ (k : Nat), T + k ≤ K → G.size T + k ≤ G.size (T + k)
@Becoming.EvolutionaryDrawdown.derived_surplus_of_selection : ∀ {X : Type} {L : Becoming.Flow X X}
  {W : Becoming.Web X X},
  L.Acting W →
    W.Dependent →
      ∀ {G : Becoming.SelectionTerm.Generations X},
        Becoming.SelectionTerm.Flow.Descended L W G →
          Becoming.Reproduction.Generations.ByNumber G →
            (∀ (t : Nat) (p : X),
                p ∈ G.family t → W.Supported t p → ∀ (q : X), q ∈ G.family t → G.amount t q ≤ G.amount t p) →
              (∀ (t : Nat), Becoming.SelectionTerm.Exact (G.family t) (G.kids t) (G.amount t) (G.amount (t + 1))) →
                G.size 0 ≤ G.size 1 →
                  ∀ {T : Nat},
                    G.size 0 * G.sum T ≠ G.size T * G.sum 0 →
                      (∃ t, t < T ∧ G.discordAt t < G.concordAt t) ∧
                        (∀ (s : Nat), T ≤ s → G.size s < G.size (s + 1)) ∧ ∀ (k : Nat), G.size T + k ≤ G.size (T + k)
@Becoming.EvolutionaryDrawdown.derived_uptake_floor_rises : ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X}
  {G : Becoming.SelectionTerm.Generations X} {ds : List X} {m : Nat},
  Becoming.EvolutionaryDrawdown.EmbodiedConversion L W G ds m →
    ∀ {t : Nat},
