@Becoming.PolyComposition.sumPortDraws_cons : ∀ {α : Type} (a : α) (f : α → Nat) (rest : List α),
  Becoming.PolyComposition.sumPortDraws (a :: rest) f = f a + Becoming.PolyComposition.sumPortDraws rest f
@Becoming.PolyComposition.sumPortDraws_le : ∀ {α : Type} {f g : α → Nat} {ports : List α},
  (∀ (a : α), a ∈ ports → f a ≤ g a) →
    Becoming.PolyComposition.sumPortDraws ports f ≤ Becoming.PolyComposition.sumPortDraws ports g
@Becoming.PolyComposition.sumPortDraws_map : ∀ {α β : Type} (g : α → β) (f : β → Nat) (ports : List α),
  Becoming.PolyComposition.sumPortDraws (List.map g ports) f =
    Becoming.PolyComposition.sumPortDraws ports fun a => f (g a)
@Becoming.PolyComposition.sumPortDraws_append : ∀ {α : Type} (f : α → Nat) (xs ys : List α),
  Becoming.PolyComposition.sumPortDraws (xs ++ ys) f =
    Becoming.PolyComposition.sumPortDraws xs f + Becoming.PolyComposition.sumPortDraws ys f
@Becoming.PolyComposition.le_sumPortDraws_of_mem : ∀ {α : Type} {a : α} (f : α → Nat) {ports : List α},
  a ∈ ports → f a ≤ Becoming.PolyComposition.sumPortDraws ports f
Becoming.PolyComposition.mul_add_nat : ∀ (a b c : Nat), a * (b + c) = a * b + a * c
@Becoming.PolyComposition.div_mono_nat : ∀ {a b : Nat}, a ≤ b → ∀ (k : Nat), a / k ≤ b / k
Becoming.PolyComposition.sub_add_le_add_sub_nat : ∀ (a b c d : Nat), a + c - (b + d) ≤ a - b + (c - d)
Becoming.PolyComposition.distNat_add_le : ∀ (a b c d : Nat),
  Becoming.distNat (a + c) (b + d) ≤ Becoming.distNat a b + Becoming.distNat c d
Becoming.PolyComposition.sub_sub_le_add_sub_nat : ∀ (a b c d : Nat), a - c - (b - d) ≤ a - b + (d - c)
Becoming.PolyComposition.distNat_sub_le : ∀ (a b c d : Nat),
  Becoming.distNat (a - c) (b - d) ≤ Becoming.distNat a b + Becoming.distNat c d
Becoming.PolyComposition.const_add_sub : ∀ (c a b : Nat), c + a - (c + b) = a - b
Becoming.PolyComposition.distNat_const_add : ∀ (c a b : Nat), Becoming.distNat (c + a) (c + b) = Becoming.distNat a b
Becoming.PolyComposition.natMin_sub_le : ∀ (a b c d : Nat),
  Becoming.CoreHelpers.natMin a c - Becoming.CoreHelpers.natMin b d ≤ Becoming.CoreHelpers.natMax (a - b) (c - d)
Becoming.PolyComposition.distNat_natMin_le : ∀ (a b c d : Nat),
