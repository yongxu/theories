Becoming.PolyComposition.distNat_natMax_const_le : ∀ (m a b : Nat),
  Becoming.distNat (Becoming.CoreHelpers.natMax m a) (Becoming.CoreHelpers.natMax m b) ≤ Becoming.distNat a b
@Becoming.PolyComposition.add_div_le_nat : ∀ {k : Nat}, 0 < k → ∀ (b d : Nat), (b + d) / k ≤ b / k + (d + (k - 1)) / k
@Becoming.PolyComposition.div_sub_le_nat : ∀ {k : Nat},
  0 < k → ∀ {a b : Nat}, b ≤ a → a / k - b / k ≤ (a - b + (k - 1)) / k
Becoming.PolyComposition.distNat_div_le : ∀ (a b k : Nat),
  Becoming.distNat (a / k) (b / k) ≤ (Becoming.distNat a b + (k - 1)) / k
@Becoming.PolyComposition.ofOpenState_toOpenState : ∀ {S Ext : Type} (st : (Ext → Nat) × (_ : Unit) × S),
  Becoming.PolyComposition.ofOpenState (Becoming.PolyComposition.toOpenState st) = st
@Becoming.PolyComposition.ofOpenComponent_closedStep_eq : ∀ {S Obs Dist Int Ext Env : Type}
  (C : Becoming.OpenComposition.OpenComponent S Obs Dist Int Ext) (obs : (Ext → Nat) → Obs)
  (channel : Bool → Nat → Env → Bool) (G : Ext → (Ext → Nat) → Nat) (envDraw : Env → Ext → Nat) (st : (Ext → Nat) × S)
  (act : Env × Dist),
  Becoming.PolyComposition.polyClosedStep (Becoming.PolyComposition.PolyComponent.ofOpenComponent C) (fun x k => [k])
      (fun x => obs) channel G envDraw (Becoming.PolyComposition.ofOpenState st) act =
    Becoming.PolyComposition.ofOpenState (Becoming.OpenComposition.closedStep C obs channel G envDraw st act)
@Becoming.PolyComposition.ofOpenComponent_closedProcess_step_iff : ∀ {S Obs Dist Int Ext Env : Type}
  (C : Becoming.OpenComposition.OpenComponent S Obs Dist Int Ext) {init : S}
  (c : Becoming.OpenComposition.InterfaceContract C init) (obs : (Ext → Nat) → Obs) (channel : Bool → Nat → Env → Bool)
  (G : Ext → (Ext → Nat) → Nat) (envDraw : Env → Ext → Nat) (jointAdm : Env → Prop)
  (st st' : (Ext → Nat) × (_ : Unit) × S) (act : Env × (_ : Unit) × Dist),
  (Becoming.PolyComposition.polyClosedProcess (Becoming.PolyComposition.PolyComponent.ofOpenComponent C)
          (fun x k => [k]) (Becoming.PolyComposition.PolyContract.ofInterfaceContract c) (fun x => obs) channel G
          envDraw jointAdm).step
      st act st' ↔
    (Becoming.OpenComposition.closedProcess C c obs channel G envDraw jointAdm).step
      (Becoming.PolyComposition.toOpenState st) (act.fst, act.snd.snd) (Becoming.PolyComposition.toOpenState st')
@Becoming.PolyComposition.ofOpenComponent_trace_to_poly : ∀ {S Obs Dist Int Ext Env : Type}
  (C : Becoming.OpenComposition.OpenComponent S Obs Dist Int Ext) {init : S}
  (c : Becoming.OpenComposition.InterfaceContract C init) (obs : (Ext → Nat) → Obs) (channel : Bool → Nat → Env → Bool)
  (G : Ext → (Ext → Nat) → Nat) (envDraw : Env → Ext → Nat) (jointAdm : Env → Prop) {st st' : (Ext → Nat) × S}
  {w : List (Env × Dist)},
  Generative.Trace (Becoming.OpenComposition.closedProcess C c obs channel G envDraw jointAdm) st w st' →
    Generative.Trace
      (Becoming.PolyComposition.polyClosedProcess (Becoming.PolyComposition.PolyComponent.ofOpenComponent C)
        (fun x k => [k]) (Becoming.PolyComposition.PolyContract.ofInterfaceContract c) (fun x => obs) channel G envDraw
        jointAdm)
      (Becoming.PolyComposition.ofOpenState st) (List.map (fun a => (a.fst, ⟨(), a.snd⟩)) w)
      (Becoming.PolyComposition.ofOpenState st')
@Becoming.PolyComposition.ofOpenComponent_trace_from_poly : ∀ {S Obs Dist Int Ext Env : Type}
  (C : Becoming.OpenComposition.OpenComponent S Obs Dist Int Ext) {init : S}
  (c : Becoming.OpenComposition.InterfaceContract C init) (obs : (Ext → Nat) → Obs) (channel : Bool → Nat → Env → Bool)
  (G : Ext → (Ext → Nat) → Nat) (envDraw : Env → Ext → Nat) (jointAdm : Env → Prop)
  {st st' : (Ext → Nat) × (_ : Unit) × S} {w : List (Env × (_ : Unit) × Dist)},
  Generative.Trace
      (Becoming.PolyComposition.polyClosedProcess (Becoming.PolyComposition.PolyComponent.ofOpenComponent C)
        (fun x k => [k]) (Becoming.PolyComposition.PolyContract.ofInterfaceContract c) (fun x => obs) channel G envDraw
        jointAdm)
      st w st' →
    Generative.Trace (Becoming.OpenComposition.closedProcess C c obs channel G envDraw jointAdm)
      (Becoming.PolyComposition.toOpenState st) (List.map (fun a => (a.fst, a.snd.snd)) w)
      (Becoming.PolyComposition.toOpenState st')
@Becoming.PolyComposition.ofOpenComponent_trace_iff : ∀ {S Obs Dist Int Ext Env : Type}
  (C : Becoming.OpenComposition.OpenComponent S Obs Dist Int Ext) {init : S}
  (c : Becoming.OpenComposition.InterfaceContract C init) (obs : (Ext → Nat) → Obs) (channel : Bool → Nat → Env → Bool)
  (G : Ext → (Ext → Nat) → Nat) (envDraw : Env → Ext → Nat) (jointAdm : Env → Prop) (st st' : (Ext → Nat) × S)
  (w : List (Env × Dist)),
  Generative.Trace (Becoming.OpenComposition.closedProcess C c obs channel G envDraw jointAdm) st w st' ↔
    Generative.Trace
      (Becoming.PolyComposition.polyClosedProcess (Becoming.PolyComposition.PolyComponent.ofOpenComponent C)
        (fun x k => [k]) (Becoming.PolyComposition.PolyContract.ofInterfaceContract c) (fun x => obs) channel G envDraw
        jointAdm)
      (Becoming.PolyComposition.ofOpenState st) (List.map (fun a => (a.fst, ⟨(), a.snd⟩)) w)
      (Becoming.PolyComposition.ofOpenState st')
@Becoming.PolyComposition.ofOpenComponent_guard_iff : ∀ {S Obs Dist Int Ext : Type}
  (C : Becoming.OpenComposition.OpenComponent S Obs Dist Int Ext) {init : S}
  (c : Becoming.OpenComposition.InterfaceContract C init) (x_crit : Ext → Nat) (st : (Ext → Nat) × (_ : Unit) × S),
  Becoming.PolyComposition.polyClosedGuard (Becoming.PolyComposition.PolyComponent.ofOpenComponent C)
      (Becoming.PolyComposition.PolyContract.ofInterfaceContract c) x_crit st ↔
    Becoming.OpenComposition.closedGuard C c x_crit (Becoming.PolyComposition.toOpenState st)
@Becoming.PolyComposition.ofOpenComponent_kernel_iff : ∀ {S Obs Dist Int Ext Env : Type}
  (C : Becoming.OpenComposition.OpenComponent S Obs Dist Int Ext) {init : S}
  (c : Becoming.OpenComposition.InterfaceContract C init) (obs : (Ext → Nat) → Obs) (channel : Bool → Nat → Env → Bool)
  (G : Ext → (Ext → Nat) → Nat) (envDraw : Env → Ext → Nat) (jointAdm : Env → Prop) (x_crit : Ext → Nat)
  (st : (Ext → Nat) × S),
  Becoming.Viability.Kernel (Becoming.OpenComposition.closedProcess C c obs channel G envDraw jointAdm)
      (Becoming.OpenComposition.closedGuard C c x_crit) st ↔
    Becoming.Viability.Kernel
      (Becoming.PolyComposition.polyClosedProcess (Becoming.PolyComposition.PolyComponent.ofOpenComponent C)
        (fun x k => [k]) (Becoming.PolyComposition.PolyContract.ofInterfaceContract c) (fun x => obs) channel G envDraw
        jointAdm)
      (Becoming.PolyComposition.polyClosedGuard (Becoming.PolyComposition.PolyComponent.ofOpenComponent C)
        (Becoming.PolyComposition.PolyContract.ofInterfaceContract c) x_crit)
      (Becoming.PolyComposition.ofOpenState st)
@Becoming.PolyComposition.polySiteDraw_compose : ∀ {Mode₁ Mode₂ : Type} {S₁ Obs₁ Dist₁ Int₁ Ext₁ : Mode₁ → Type}
  {S₂ Obs₂ Dist₂ Int₂ Ext₂ : Mode₂ → Type} {Site : Type}
  (A : Becoming.PolyComposition.PolyComponent Mode₁ S₁ Obs₁ Dist₁ Int₁ Ext₁)
  (B : Becoming.PolyComposition.PolyComponent Mode₂ S₂ Obs₂ Dist₂ Int₂ Ext₂)
  (route₁ : (m₁ : Mode₁) → Site → List (Ext₁ m₁)) (route₂ : (m₂ : Mode₂) → Site → List (Ext₂ m₂)) (m : Mode₁ × Mode₂)
  (s : S₁ m.fst × S₂ m.snd) (site : Site),
  Becoming.PolyComposition.polySiteDraw (A.compose B) (Becoming.PolyComposition.composeRoute route₁ route₂) ⟨m, s⟩
      site =
    Becoming.PolyComposition.polySiteDraw A route₁ ⟨m.fst, s.fst⟩ site +
      Becoming.PolyComposition.polySiteDraw B route₂ ⟨m.snd, s.snd⟩ site
@Becoming.PolyComposition.poly_close_viable_on_K : ∀ {Mode : Type} {S Obs Dist Int Ext : Mode → Type} {Site Env : Type}
  (C : Becoming.PolyComposition.PolyComponent Mode S Obs Dist Int Ext) (route : (m : Mode) → Site → List (Ext m))
  {init : (m : Mode) × S m} (c : Becoming.PolyComposition.PolyContract C init) (obs : (m : Mode) → (Site → Nat) → Obs m)
  (channel : Bool → Nat → Env → Bool) (G : Site → (Site → Nat) → Nat) (envDraw : Env → Site → Nat) (envCap : Site → Nat)
  (jointAdm : Env → Prop),
  (∀ (env : Env), jointAdm env → ∀ (site : Site), envDraw env site ≤ envCap site) →
    ∀ (sitePreCap sitePostCap : Site → Nat) (maxLagEnv maxSilenceEnv : Nat),
      (∀ (m : Mode) (s : S m) (site : Site),
          c.K ⟨m, s⟩ → Becoming.PolyComposition.sumPortDraws (route m site) (c.preCapExt m) ≤ sitePreCap site) →
        (∀ (m : Mode) (s : S m) (site : Site),
            c.K ⟨m, s⟩ →
              Becoming.PolyComposition.sumPortDraws (route m site) (c.postAllowanceExt m) ≤ sitePostCap site) →
          (∀ (m : Mode) (s : S m), c.K ⟨m, s⟩ → c.maxLag m ≤ maxLagEnv) →
            (∀ (m : Mode) (s : S m), c.K ⟨m, s⟩ → c.maxSilence m ≤ maxSilenceEnv) →
              ∀ (x_crit warnLevel H_safe x₀ : Site → Nat) (ModeGuard : (Site → Nat) → Mode → Prop),
                ModeGuard x₀ init.fst →
                  (∀ (x : Site → Nat) (p : (m : Mode) × S m) (env : Env) (d : Dist p.fst),
                      Becoming.PolyComposition.polyClosedInv c sitePreCap envCap x_crit (x, p) →
                        ModeGuard x p.fst →
                          jointAdm env →
                            (∀ (ob : Obs p.fst × Bool), c.tol p.fst ob d) →
                              have st' :=
                                Becoming.PolyComposition.polyClosedStep C route obs channel G envDraw (x, p) (env, d);
                              ModeGuard st'.fst st'.snd.fst) →
                    (∀ (m : Mode) (s : S m) (x : Site → Nat) (site : Site),
                        c.K ⟨m, s⟩ → ModeGuard x m → x site < warnLevel site → c.warnObs m (obs m x)) →
                      (∀ (load : Nat) (env : Env), jointAdm env → load ≤ maxSilenceEnv → channel true load env = true) →
                        (∀ (site : Site),
                            Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole (G site)) →
                          (∀ (site : Site),
                              x_crit site ≤
                                Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G H_safe
                                  x_crit site) →
                            (∀ (site : Site), sitePostCap site + envCap site ≤ H_safe site) →
                              (∀ (site : Site),
                                  x_crit site + (maxLagEnv + 1) * (sitePreCap site + envCap site) ≤ warnLevel site) →
                                (∀ (site : Site),
                                    x_crit site + c.eta init * (sitePreCap site + envCap site) ≤ x₀ site) →
                                  Becoming.PolyComposition.polyClosedInv c sitePreCap envCap x_crit (x₀, init) ∧
                                    ModeGuard x₀ init.fst ∧
                                      Becoming.Viability.Certificate
                                        (Becoming.PolyComposition.polyClosedProcess C route c obs channel G envDraw
                                          jointAdm)
                                        (Becoming.PolyComposition.polyClosedGuard C c x_crit) fun st =>
                                        Becoming.PolyComposition.polyClosedInv c sitePreCap envCap x_crit st ∧
                                          ModeGuard st.fst st.snd.fst
@Becoming.PolyComposition.poly_close_viable : ∀ {Mode : Type} {S Obs Dist Int Ext : Mode → Type} {Site Env : Type}
  (C : Becoming.PolyComposition.PolyComponent Mode S Obs Dist Int Ext) (route : (m : Mode) → Site → List (Ext m))
  {init : (m : Mode) × S m} (c : Becoming.PolyComposition.PolyContract C init) (obs : (m : Mode) → (Site → Nat) → Obs m)
  (channel : Bool → Nat → Env → Bool) (G : Site → (Site → Nat) → Nat) (envDraw : Env → Site → Nat) (envCap : Site → Nat)
  (jointAdm : Env → Prop),
  (∀ (env : Env), jointAdm env → ∀ (site : Site), envDraw env site ≤ envCap site) →
    ∀ (sitePreCap sitePostCap : Site → Nat) (maxLagEnv maxSilenceEnv : Nat),
      (∀ (m : Mode) (site : Site),
          Becoming.PolyComposition.sumPortDraws (route m site) (c.preCapExt m) ≤ sitePreCap site) →
        (∀ (m : Mode) (site : Site),
            Becoming.PolyComposition.sumPortDraws (route m site) (c.postAllowanceExt m) ≤ sitePostCap site) →
          (∀ (m : Mode), c.maxLag m ≤ maxLagEnv) →
            (∀ (m : Mode), c.maxSilence m ≤ maxSilenceEnv) →
              ∀ (x_crit warnLevel H_safe x₀ : Site → Nat) (ModeGuard : (Site → Nat) → Mode → Prop),
                ModeGuard x₀ init.fst →
                  (∀ (x : Site → Nat) (p : (m : Mode) × S m) (env : Env) (d : Dist p.fst),
                      Becoming.PolyComposition.polyClosedInv c sitePreCap envCap x_crit (x, p) →
                        ModeGuard x p.fst →
                          jointAdm env →
                            (∀ (ob : Obs p.fst × Bool), c.tol p.fst ob d) →
                              have st' :=
                                Becoming.PolyComposition.polyClosedStep C route obs channel G envDraw (x, p) (env, d);
                              ModeGuard st'.fst st'.snd.fst) →
                    (∀ (m : Mode) (s : S m) (x : Site → Nat) (site : Site),
                        c.K ⟨m, s⟩ → ModeGuard x m → x site < warnLevel site → c.warnObs m (obs m x)) →
                      (∀ (load : Nat) (env : Env), jointAdm env → load ≤ maxSilenceEnv → channel true load env = true) →
                        (∀ (site : Site),
                            Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole (G site)) →
                          (∀ (site : Site),
                              x_crit site ≤
                                Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G H_safe
                                  x_crit site) →
                            (∀ (site : Site), sitePostCap site + envCap site ≤ H_safe site) →
                              (∀ (site : Site),
                                  x_crit site + (maxLagEnv + 1) * (sitePreCap site + envCap site) ≤ warnLevel site) →
                                (∀ (site : Site),
                                    x_crit site + c.eta init * (sitePreCap site + envCap site) ≤ x₀ site) →
                                  Becoming.PolyComposition.polyClosedInv c sitePreCap envCap x_crit (x₀, init) ∧
                                    ModeGuard x₀ init.fst ∧
                                      Becoming.Viability.Certificate
                                        (Becoming.PolyComposition.polyClosedProcess C route c obs channel G envDraw
                                          jointAdm)
                                        (Becoming.PolyComposition.polyClosedGuard C c x_crit) fun st =>
                                        Becoming.PolyComposition.polyClosedInv c sitePreCap envCap x_crit st ∧
                                          ModeGuard st.fst st.snd.fst
