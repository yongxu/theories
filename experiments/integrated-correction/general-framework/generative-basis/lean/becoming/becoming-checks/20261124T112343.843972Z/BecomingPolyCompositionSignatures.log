@Becoming.PolyComposition.coupled_closed_lax_kernel : ∀
  {Ext Env QX BX SA ObsA DistA IntA QA BA SB ObsB DistB IntB QB BB : Type} {G : Ext → (Ext → Nat) → Nat}
  {envDraw : Env → Ext → Nat} {jointAdm : Env → Prop} {RX : Generative.Process QX ((Ext → Nat) × BX)}
  {πX : (Ext → Nat) → QX} {σ : Nat → Nat} (strict_σ : Becoming.Strict σ) (Mstride : Nat)
  (stride_le : ∀ (k : Nat), σ (k + 1) - σ k ≤ Mstride) {MX : Becoming.SlackDist QX}
  {A : Becoming.OpenComposition.OpenComponent SA ObsA DistA IntA Ext} {initA : SA}
  (cA : Becoming.OpenComposition.InterfaceContract A initA) (obsA : (Ext → Nat) → ObsA)
  {RA : Generative.Process QA (QX × BA)} {πA : SA → QA} {drawQA : QA → Ext → Nat} {MA : Becoming.SlackDist QA}
  {B : Becoming.OpenComposition.OpenComponent SB ObsB DistB IntB Ext} {initB : SB}
  (cB : Becoming.OpenComposition.InterfaceContract B initB) (obsB : (Ext → Nat) → ObsB)
  {RB : Generative.Process QB (QX × BB)} {πB : SB → QB} {drawQB : QB → Ext → Nat} {MB : Becoming.SlackDist QB}
  (channel : Bool → Nat → Env → Bool) (simX : Becoming.PolyComposition.SubstrateLaxSim G envDraw jointAdm RX πX σ MX)
  (simA : Becoming.PolyComposition.OpenSubLaxSim A cA.tol obsA RA πA drawQA σ MA MX πX simX.EpochX simX.EpochQX)
  (simB : Becoming.PolyComposition.OpenSubLaxSim B cB.tol obsB RB πB drawQB σ MB MX πX simX.EpochX simX.EpochQX)
  {guardQ KQ : QX × QA × QB → Prop},
  Becoming.Viability.Certificate (Becoming.PolyComposition.coupledMacroProcess RX RA RB drawQA drawQB) guardQ KQ →
    ∀ (x_crit : Ext → Nat) (Δ : Nat),
      (Becoming.PolyComposition.coupled_closed_laxSim strict_σ Mstride stride_le cA obsA cB obsB channel simX simA
                  simB).α
              Δ +
            (Becoming.PolyComposition.coupled_closed_laxSim strict_σ Mstride stride_le cA obsA cB obsB channel simX simA
                simB).ε ≤
          Δ →
        (∀ (q : QX × QA × QB) (u : (Ext → Nat) × SA × SB),
            guardQ q →
              (Becoming.OpenComposition.SlackDist.max MX (Becoming.OpenComposition.SlackDist.max MA MB)).d
                    (πX u.fst, πA u.snd.fst, πB u.snd.snd) q ≤
                  (Becoming.PolyComposition.coupled_closed_laxSim strict_σ Mstride stride_le cA obsA cB obsB channel
                          simX simA simB).β
                      Δ +
                    (Becoming.PolyComposition.coupled_closed_laxSim strict_σ Mstride stride_le cA obsA cB obsB channel
                        simX simA simB).η →
                ∀ (k : Ext), x_crit k ≤ u.fst k) →
          ∀ {x₀ : Ext → Nat},
            simX.EpochX (σ 0) x₀ →
              simA.Epoch (σ 0) initA →
                simB.Epoch (σ 0) initB →
                  KQ (πX x₀, πA initA, πB initB) →
                    Becoming.Viability.Kernel
                      (Becoming.OpenComposition.closedProcess (A.compose B)
                        (Becoming.OpenComposition.composeContract cA cB) (fun x => (obsA x, obsB x)) channel G envDraw
                        jointAdm)
                      (Becoming.OpenComposition.closedGuard (A.compose B)
                        (Becoming.OpenComposition.composeContract cA cB) x_crit)
                      (x₀, initA, initB)
