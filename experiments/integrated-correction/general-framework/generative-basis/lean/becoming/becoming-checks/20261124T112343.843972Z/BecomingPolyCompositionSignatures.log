Becoming.PolyComposition.distNat_natMin_const_le : ∀ (m a b : Nat),
  Becoming.distNat (Becoming.CoreHelpers.natMin m a) (Becoming.CoreHelpers.natMin m b) ≤ Becoming.distNat a b
Becoming.PolyComposition.natMax_sub_le : ∀ (a b c d : Nat),
  Becoming.CoreHelpers.natMax a c - Becoming.CoreHelpers.natMax b d ≤ Becoming.CoreHelpers.natMax (a - b) (c - d)
Becoming.PolyComposition.distNat_natMax_le : ∀ (a b c d : Nat),
