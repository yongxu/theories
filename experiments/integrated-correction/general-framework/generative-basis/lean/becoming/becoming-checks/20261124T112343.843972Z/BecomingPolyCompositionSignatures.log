  (simB : Becoming.PolyComposition.OpenSubLaxSim B cB.tol obsB RB πB drawQB σ MB MX πX simX.EpochX simX.EpochQX)
  (channel : Bool → Nat → Env → Bool) {k t : Nat} {q : QX × QA × QB},
  simX.EpochQX k q.fst →
    simA.EpochQ k q.snd.fst →
      simB.EpochQ k q.snd.snd →
        ∀ {st st' : (Ext → Nat) × SA × SB} {w : List (Env × DistA × DistB)} {r : Nat},
