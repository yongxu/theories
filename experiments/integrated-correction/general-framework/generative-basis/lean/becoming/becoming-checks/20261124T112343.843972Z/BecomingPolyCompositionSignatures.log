@Becoming.PolyComposition.poly_poolRead_absent_invariant : ∀ {Mode A B R : Type} {S Obs Dist Int Ext : Mode → Type}
  {present : A × B → Prop} {hA : A → R → R} {h : A × B → R → R},
  Becoming.PoolFromCourse.ReadsThroughPresent present hA h →
    ∀ (C : Becoming.PolyComposition.PolyComponent Mode S Obs Dist Int Ext) (emit : Mode → R → Bool)
      (cfg : (m : Mode) → S m → (A × B) × R),
      (∀ (m : Mode) (s : S m) (o : Obs m), C.emitAlarm m s o = emit m (h (cfg m s).fst (cfg m s).snd)) →
        ∀ {m : Mode} {s s' : S m} {p q : A × B} {g : R},
          cfg m s = (p, g) →
            cfg m s' = (q, g) →
              ¬present p →
                ¬present q → p.fst = q.fst → h p g = h q g ∧ ∀ (o o' : Obs m), C.emitAlarm m s o = C.emitAlarm m s' o'
@Becoming.PolyComposition.poly_poolWindow_unregistered_stays_blind : ∀ {Mode A R : Type}
  {S Obs Dist Int Ext : Mode → Type} {fA : A → R → A} {fB : A × Nat → R → Nat} {hA : A → R → R} {hL : A × Nat → R → R}
  {reads : Nat → Bool} {N K : Nat},
  Becoming.ClosedCapture.Accrues fB →
    ∀ {c : (A × Nat) × R},
      K ≤ c.fst.snd →
        ∀ (C : Becoming.PolyComposition.PolyComponent Mode S Obs Dist Int Ext) {m₀ : Mode} (mk : (A × Nat) × R → S m₀)
          (emit : R → Bool),
          (∀ (st : (A × Nat) × R) (o : Obs m₀), C.emitAlarm m₀ (mk st) o = emit st.snd) →
            emit c.snd = false →
              (∀ (a : A) (g : R), emit (hA a g) = false) →
                ∀ (t : Nat),
                  c.fst.snd + t ≤
                      (Becoming.Pace.paced (Becoming.ClosedCapture.join fA fB)
                            (Becoming.PoolFromCourse.windowRead hA hL N K) reads c t).fst.snd ∧
                    ¬Becoming.PoolFromCourse.Stands K
                          (Becoming.Pace.paced (Becoming.ClosedCapture.join fA fB)
                              (Becoming.PoolFromCourse.windowRead hA hL N K) reads c t).fst ∧
                      Becoming.PoolFromCourse.windowRead hA hL N K
                            (Becoming.Pace.paced (Becoming.ClosedCapture.join fA fB)
                                (Becoming.PoolFromCourse.windowRead hA hL N K) reads c t).fst
                            (Becoming.Pace.paced (Becoming.ClosedCapture.join fA fB)
                                (Becoming.PoolFromCourse.windowRead hA hL N K) reads c t).snd =
                          hA
                            (Becoming.Pace.paced (Becoming.ClosedCapture.join fA fB)
                                  (Becoming.PoolFromCourse.windowRead hA hL N K) reads c t).fst.fst
                            (Becoming.Pace.paced (Becoming.ClosedCapture.join fA fB)
                                (Becoming.PoolFromCourse.windowRead hA hL N K) reads c t).snd ∧
                        emit
                              (Becoming.Pace.paced (Becoming.ClosedCapture.join fA fB)
                                  (Becoming.PoolFromCourse.windowRead hA hL N K) reads c t).snd =
                            false ∧
                          ∀ (o : Obs m₀),
                            C.emitAlarm m₀
                                (mk
                                  (Becoming.Pace.paced (Becoming.ClosedCapture.join fA fB)
                                    (Becoming.PoolFromCourse.windowRead hA hL N K) reads c t))
                                o =
                              false
@Becoming.PolyComposition.anchored_selfMod_viable : ∀ {Mode : Type} {S Obs Dist Int Ext : Mode → Type} {Site Env : Type}
  (base : Becoming.PolyComposition.AnchoredBase Mode S Obs Dist Int Ext) {init : (m : Mode) × S m}
  (hInit : Becoming.PolyComposition.AnchoredInit base init)
  (admitDec : (m : Mode) × S m → (m : Mode) × S m → Bool → Bool)
  (fallback : (p : (m : Mode) × S m) → Obs p.fst × Bool → Dist p.fst → (m' : Mode) × S m')
  (hAdmit : Becoming.PolyComposition.AnchoredModeAdmit base admitDec fallback)
  (propose : (p : (m : Mode) × S m) → Obs p.fst × Bool → Dist p.fst → (m' : Mode) × S m')
  (route : (m : Mode) → Site → List (Ext m)) (obs : (m : Mode) → (Site → Nat) → Obs m)
  (channel : Bool → Nat → Env → Bool) (G : Site → (Site → Nat) → Nat) (envDraw : Env → Site → Nat) (envCap : Site → Nat)
  (jointAdm : Env → Prop),
  (∀ (env : Env), jointAdm env → ∀ (site : Site), envDraw env site ≤ envCap site) →
    ∀ (sitePreCap sitePostCap : Site → Nat) (maxLagEnv maxSilenceEnv : Nat),
      (∀ (m : Mode) (site : Site),
          Becoming.PolyComposition.sumPortDraws (route m site) (base.preCapExt m) ≤ sitePreCap site) →
        (∀ (m : Mode) (site : Site),
            Becoming.PolyComposition.sumPortDraws (route m site) (base.postAllowanceExt m) ≤ sitePostCap site) →
          (∀ (m : Mode), base.maxLag m ≤ maxLagEnv) →
            (∀ (m : Mode), base.maxSilence m ≤ maxSilenceEnv) →
              ∀ (x_crit warnLevel H_safe x₀ : Site → Nat),
                (∀ (m : Mode) (s : S m) (x : Site → Nat) (site : Site),
                    base.K ⟨m, s⟩ → x site < warnLevel site → base.warnObs m (obs m x)) →
                  (∀ (load : Nat) (env : Env), jointAdm env → load ≤ maxSilenceEnv → channel true load env = true) →
                    (∀ (site : Site),
                        Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole (G site)) →
                      (∀ (site : Site),
                          x_crit site ≤
                            Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G H_safe x_crit
                              site) →
                        (∀ (site : Site), sitePostCap site + envCap site ≤ H_safe site) →
                          (∀ (site : Site),
                              x_crit site + (maxLagEnv + 1) * (sitePreCap site + envCap site) ≤ warnLevel site) →
                            (∀ (site : Site), x_crit site + base.eta init * (sitePreCap site + envCap site) ≤ x₀ site) →
                              Becoming.Viability.Kernel
                                (Becoming.PolyComposition.polyClosedProcess
                                  (Becoming.PolyComposition.anchoredSelfModComponent base admitDec fallback propose)
                                  route
                                  (Becoming.PolyComposition.anchoredSelfModContract base hInit admitDec fallback hAdmit
                                    propose)
                                  obs channel G envDraw jointAdm)
                                (Becoming.PolyComposition.polyClosedGuard
                                  (Becoming.PolyComposition.anchoredSelfModComponent base admitDec fallback propose)
                                  (Becoming.PolyComposition.anchoredSelfModContract base hInit admitDec fallback hAdmit
                                    propose)
                                  x_crit)
                                (x₀, init)
