@Becoming.PolyComposition.serialReconfig_viable : ∀ {Mode₁ Mode₂ : Type} {S₁ Obs₁ Dist₁ Int₁ Ext₁ : Mode₁ → Type}
  {S₂ Obs₂ Dist₂ Int₂ Ext₂ : Mode₂ → Type} {Site Env : Type}
  (A : Becoming.PolyComposition.PolyComponent Mode₁ S₁ Obs₁ Dist₁ Int₁ Ext₁)
  (routeA : (m : Mode₁) → Site → List (Ext₁ m)) {init₁ : (m : Mode₁) × S₁ m}
  (cA : Becoming.PolyComposition.PolyContract A init₁)
  (B : Becoming.PolyComposition.PolyComponent Mode₂ S₂ Obs₂ Dist₂ Int₂ Ext₂)
  (routeB : (m : Mode₂) → Site → List (Ext₂ m)) {init₂ : (m : Mode₂) × S₂ m}
  (cB : Becoming.PolyComposition.PolyContract B init₂) (sitePreCap₁ sitePreCap₂ postLimit envCap : Site → Nat)
  (obs₁ : (m : Mode₁) → (Site → Nat) → Obs₁ m) (obs₂ : (m : Mode₂) → (Site → Nat) → Obs₂ m)
  (channel : Bool → Nat → Env → Bool) (G : Site → (Site → Nat) → Nat) (envDraw : Env → Site → Nat)
  (jointAdm : Env → Prop),
  (∀ (env : Env), jointAdm env → ∀ (site : Site), envDraw env site ≤ envCap site) →
    ∀ (maxLag₁ maxLag₂ maxSilence₁ maxSilence₂ : Nat) (x_crit warnLevel H_safe : Site → Nat),
      (∀ (m₁ : Mode₁) (s₁ : S₁ m₁), cA.K ⟨m₁, s₁⟩ → cA.maxLag m₁ ≤ maxLag₁) →
        (∀ (m₂ : Mode₂) (s₂ : S₂ m₂), cB.K ⟨m₂, s₂⟩ → cB.maxLag m₂ ≤ maxLag₂) →
          (∀ (m₁ : Mode₁) (s₁ : S₁ m₁), cA.K ⟨m₁, s₁⟩ → cA.maxSilence m₁ ≤ maxSilence₁) →
            (∀ (m₂ : Mode₂) (s₂ : S₂ m₂), cB.K ⟨m₂, s₂⟩ → cB.maxSilence m₂ ≤ maxSilence₂) →
              (∀ (m₁ : Mode₁) (s₁ : S₁ m₁) (x : Site → Nat) (site : Site),
                  cA.K ⟨m₁, s₁⟩ → x site < warnLevel site → cA.warnObs m₁ (obs₁ m₁ x)) →
                (∀ (m₂ : Mode₂) (s₂ : S₂ m₂) (x : Site → Nat) (site : Site),
                    cB.K ⟨m₂, s₂⟩ → x site < warnLevel site → cB.warnObs m₂ (obs₂ m₂ x)) →
                  (∀ (m₁ : Mode₁) (s₁ : S₁ m₁) (ob₁ : Obs₁ ⟨m₁, s₁⟩.fst × Bool) (d₁ : Dist₁ m₁) (site : Site),
                      cA.K ⟨m₁, s₁⟩ →
                        (∀ (o : Obs₁ m₁ × Bool), cA.tol m₁ o d₁) →
                          Becoming.PolyComposition.sumPortDraws (routeA (A.next ⟨m₁, s₁⟩ ob₁ d₁).fst site)
                              (cA.preCapExt (A.next ⟨m₁, s₁⟩ ob₁ d₁).fst) ≤
                            Becoming.PolyComposition.sumPortDraws (routeA m₁ site) (cA.preCapExt m₁)) →
                    (∀ (m₁ : Mode₁) (s₁ : S₁ m₁) (ob₁ : Obs₁ ⟨m₁, s₁⟩.fst × Bool) (d₁ : Dist₁ m₁) (site : Site),
                        cA.K ⟨m₁, s₁⟩ →
                          (∀ (o : Obs₁ m₁ × Bool), cA.tol m₁ o d₁) →
                            Becoming.PolyComposition.sumPortDraws (routeA (A.next ⟨m₁, s₁⟩ ob₁ d₁).fst site)
                                (cA.postAllowanceExt (A.next ⟨m₁, s₁⟩ ob₁ d₁).fst) ≤
                              Becoming.PolyComposition.sumPortDraws (routeA m₁ site) (cA.postAllowanceExt m₁)) →
                      (∀ (m₂ : Mode₂) (s₂ : S₂ m₂) (ob₂ : Obs₂ ⟨m₂, s₂⟩.fst × Bool) (d₂ : Dist₂ m₂) (site : Site),
                          cB.K ⟨m₂, s₂⟩ →
                            (∀ (o : Obs₂ m₂ × Bool), cB.tol m₂ o d₂) →
                              Becoming.PolyComposition.sumPortDraws (routeB (B.next ⟨m₂, s₂⟩ ob₂ d₂).fst site)
                                  (cB.preCapExt (B.next ⟨m₂, s₂⟩ ob₂ d₂).fst) ≤
                                Becoming.PolyComposition.sumPortDraws (routeB m₂ site) (cB.preCapExt m₂)) →
                        (∀ (m₂ : Mode₂) (s₂ : S₂ m₂) (ob₂ : Obs₂ ⟨m₂, s₂⟩.fst × Bool) (d₂ : Dist₂ m₂) (site : Site),
                            cB.K ⟨m₂, s₂⟩ →
                              (∀ (o : Obs₂ m₂ × Bool), cB.tol m₂ o d₂) →
                                Becoming.PolyComposition.sumPortDraws (routeB (B.next ⟨m₂, s₂⟩ ob₂ d₂).fst site)
                                    (cB.postAllowanceExt (B.next ⟨m₂, s₂⟩ ob₂ d₂).fst) ≤
                                  Becoming.PolyComposition.sumPortDraws (routeB m₂ site) (cB.postAllowanceExt m₂)) →
                          (∀ (load : Nat) (env : Env),
                              jointAdm env → load ≤ maxSilence₁ + maxSilence₂ → channel true load env = true) →
                            (∀ (site : Site),
                                Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole
                                  (G site)) →
                              (∀ (site : Site),
                                  x_crit site ≤
                                    Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G
                                      H_safe x_crit site) →
                                (∀ (site : Site), postLimit site + envCap site ≤ H_safe site) →
                                  (∀ (site : Site),
                                      x_crit site +
                                          (Becoming.CoreHelpers.natMax maxLag₁ maxLag₂ + 1) *
                                            (sitePreCap₁ site + sitePreCap₂ site + envCap site) ≤
                                        warnLevel site) →
                                    Becoming.Viability.Certificate
                                      (Becoming.PolyComposition.SerialReconfigProcess A routeA cA B routeB cB
                                        sitePreCap₁ sitePreCap₂ postLimit obs₁ obs₂ channel G envDraw jointAdm)
                                      (Becoming.PolyComposition.serialReconfigGuard A routeA cA B routeB cB postLimit
                                        x_crit)
                                      (Becoming.PolyComposition.serialReconfigInv routeA cA routeB cB sitePreCap₁
                                        sitePreCap₂ envCap postLimit x_crit)
