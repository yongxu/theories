      (Becoming.Transactions.guardedExecute Becoming.Reconfiguration.repaired4.roster
                  (Becoming.Reconfiguration.envelope Becoming.Reconfiguration.repaired4)
                  (Becoming.Reconfiguration.envelope Becoming.Reconfiguration.repaired4) next.installation
                  Becoming.Reconfiguration.renewedRequest Becoming.Reconfiguration.survivingReads
                  Becoming.Reconfiguration.survivingApprovals).installation.state.running =
          false ∧
        (Becoming.Transactions.guardedExecute Becoming.Reconfiguration.repaired4.roster
                    (Becoming.Reconfiguration.envelope Becoming.Reconfiguration.repaired4)
                    (Becoming.Reconfiguration.envelope Becoming.Reconfiguration.repaired4) next.installation
                    Becoming.Reconfiguration.renewedRequest Becoming.Reconfiguration.survivingReads
                    Becoming.Reconfiguration.survivingApprovals).installation.state.drawn =
            13 ∧
          (Becoming.Transactions.guardedExecute Becoming.Reconfiguration.repaired4.roster
                      (Becoming.Reconfiguration.envelope Becoming.Reconfiguration.repaired4)
                      (Becoming.Reconfiguration.envelope Becoming.Reconfiguration.repaired4) next.installation
                      Becoming.Reconfiguration.renewedRequest Becoming.Reconfiguration.survivingReads
                      Becoming.Reconfiguration.survivingApprovals).installation.state.reserve =
              7 ∧
            (Becoming.Transactions.guardedExecute Becoming.Reconfiguration.repaired4.roster
                    (Becoming.Reconfiguration.envelope Becoming.Reconfiguration.repaired4)
                    (Becoming.Reconfiguration.envelope Becoming.Reconfiguration.repaired4) next.installation
                    Becoming.Reconfiguration.renewedRequest Becoming.Reconfiguration.survivingReads
                    Becoming.Reconfiguration.survivingApprovals).installation.serial =
              2
@Becoming.Reconfiguration.faultEnvelope_channel_viable : ∀ {S Obs Dist Int Ext Env : Type}
  (C : Becoming.OpenComposition.OpenComponent S Obs Dist Int Ext) {init : S}
  (c : Becoming.OpenComposition.InterfaceContract C init) (a : Becoming.Reconfiguration.Arrangement)
  (actual : Env → List Nat) (report : Bool → Nat → Env → Becoming.FaultEnvelopes.Domain → Bool)
  (obs : (Ext → Nat) → Obs) (G : Ext → (Ext → Nat) → Nat) (envDraw : Env → Ext → Nat) (envCap : Ext → Nat)
  (jointAdm : Env → Prop),
  (∀ (env : Env), jointAdm env → ∀ (k : Ext), envDraw env k ≤ envCap k) →
    ∀ (x_crit warnLevel H_safe x₀ : Ext → Nat),
      Becoming.Reconfiguration.ready a = true →
        (∀ (env : Env), jointAdm env → Becoming.Reconfiguration.Covered a (actual env)) →
          (∀ (load : Nat) (env : Env) (d : Becoming.FaultEnvelopes.Domain),
              jointAdm env →
                load ≤ c.maxSilence →
                  d ∈ a.roster →
                    Becoming.Reconfiguration.fails (a.vulnerability d) (actual env) = false →
                      report true load env d = true) →
            (∀ (x : Ext → Nat) (k : Ext), x k < warnLevel k → c.warnObs (obs x)) →
              (∀ (k : Ext), Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole (G k)) →
                (∀ (k : Ext),
                    x_crit k ≤
                      Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G H_safe x_crit k) →
                  (∀ (k : Ext), c.postBudgetExt k + envCap k ≤ H_safe k) →
                    (∀ (k : Ext), x_crit k + (c.maxLag + 1) * (c.preCapExt k + envCap k) ≤ warnLevel k) →
                      (∀ (k : Ext), x_crit k + c.eta init * (c.preCapExt k + envCap k) ≤ x₀ k) →
                        Becoming.Viability.Kernel
                            (Becoming.OpenComposition.closedProcess C c obs
                              (Becoming.Reconfiguration.envelopeChannel a report) G envDraw jointAdm)
                            (Becoming.OpenComposition.closedGuard C c x_crit) (x₀, init) ∧
                          ∀ (em : Bool) (load : Nat) (env : Env) (P : Prop),
                            jointAdm env →
                              (∀ (d : Becoming.FaultEnvelopes.Domain),
                                  d ∈ a.roster →
                                    Becoming.Reconfiguration.fails (a.vulnerability d) (actual env) = false →
                                      report em load env d = true → P) →
                                Becoming.Reconfiguration.envelopeChannel a report em load env = true → P
Becoming.Reconfiguration.correlated_faults_break_envelope_channel : ∀ (extra : List Becoming.FaultEnvelopes.Domain)
  (vuln : Becoming.FaultEnvelopes.Domain → Becoming.Reconfiguration.FaultFormula)
  (report : Bool → Nat → Unit → Becoming.FaultEnvelopes.Domain → Bool),
  (∀ (d : Becoming.FaultEnvelopes.Domain),
      d ∈ Becoming.Reconfiguration.merged3.roster → vuln d = Becoming.Reconfiguration.merged3.vulnerability d) →
    (∀ (e : Becoming.FaultEnvelopes.Domain),
        e ∈ extra →
          ∃ d,
            d ∈ Becoming.Reconfiguration.merged3.roster ∧
              (∀ (em : Bool), report em 0 () e = report em 0 () d) ∧
                vuln e = Becoming.Reconfiguration.merged3.vulnerability d) →
      (∀ (em : Bool) (d : Becoming.FaultEnvelopes.Domain),
          d ∈ Becoming.Reconfiguration.merged3.roster →
            Becoming.Reconfiguration.fails (Becoming.Reconfiguration.merged3.vulnerability d) [0] = true →
              report em 0 () d = false) →
        let comp :=
          Becoming.OpenComposition.WideningWitness.widenedAgent.compose
            Becoming.OpenComposition.WideningWitness.widenedAgent;
        have cont :=
          Becoming.OpenComposition.composeContract (Becoming.OpenComposition.WideningWitness.widenedContract true)
            (Becoming.OpenComposition.WideningWitness.widenedContract true);
        have obs := fun x => ((x ()).blt 8, (x ()).blt 8);
        have mergedCopied :=
          { roster := extra ++ Becoming.Reconfiguration.merged3.roster, vulnerability := vuln,
            rootFaults := Becoming.Reconfiguration.merged3.rootFaults };
        have stepBad := fun st =>
          Becoming.OpenComposition.closedStep comp obs (Becoming.Reconfiguration.envelopeChannel mergedCopied report)
            Becoming.OpenComposition.WideningWitness.gShared (fun x x_1 => 0) st ((), (), ());
        Becoming.Viability.Kernel
            (Becoming.OpenComposition.closedProcess comp cont obs
              (Becoming.Reconfiguration.envelopeChannel Becoming.Reconfiguration.repaired4 fun em x x_1 d =>
                em && decide (2 ≤ d))
              Becoming.OpenComposition.WideningWitness.gShared (fun x x_1 => 0) fun x => True)
            (Becoming.OpenComposition.closedGuard comp cont fun x => 3) (fun x => 6, true, true) ∧
          (Becoming.Law.orbit stepBad (fun x => 6, true, true) 6).fst () = 0 ∧
            ¬Becoming.Viability.Kernel
                (Becoming.OpenComposition.closedProcess comp cont obs
                  (Becoming.Reconfiguration.envelopeChannel mergedCopied report)
                  Becoming.OpenComposition.WideningWitness.gShared (fun x x_1 => 0) fun x => True)
                (Becoming.OpenComposition.closedGuard comp cont fun x => 3) (fun x => 6, true, true)
@Becoming.Reconfiguration.reconfig_step_induces_live_swap : ∀ {S₁ S₁' Obs₁ Obs₁' Dist₁ Dist₁' Int₁ Int₁' Ext Env : Type}
  {old new : Becoming.Reconfiguration.Managed} {m : Becoming.Reconfiguration.Rearrangement},
  Becoming.Reconfiguration.process.step old m new →
    Becoming.Reconfiguration.ready old.arrangement = true →
      ∀ (A : Becoming.OpenComposition.OpenComponent S₁ Obs₁ Dist₁ Int₁ Ext)
        (A' : Becoming.OpenComposition.OpenComponent S₁' Obs₁' Dist₁' Int₁' Ext) {init₁ : S₁} {init₁' : S₁'}
        (cA : Becoming.OpenComposition.InterfaceContract A init₁)
        (cA' : Becoming.OpenComposition.InterfaceContract A' init₁') (obs₁ : (Ext → Nat) → Obs₁)
        (obs₁' : (Ext → Nat) → Obs₁') (actual : List Nat),
        Becoming.Reconfiguration.Covered old.arrangement actual →
          Becoming.Reconfiguration.Covered new.arrangement actual →
            ∀ (rep₁ rep₂ : (Ext → Nat) → Becoming.FaultEnvelopes.Domain → Bool),
              (∀ (x : Ext → Nat) (d : Becoming.FaultEnvelopes.Domain),
                  d ∈ old.arrangement.roster →
                    Becoming.Reconfiguration.fails (old.arrangement.vulnerability d) actual = false → rep₁ x d = true) →
                (∀ (x : Ext → Nat) (d : Becoming.FaultEnvelopes.Domain),
                    d ∈ new.arrangement.roster →
                      Becoming.Reconfiguration.fails (new.arrangement.vulnerability d) actual = false →
                        rep₂ x d = true) →
                  ∀ (channel : Bool → Nat → Env → Bool) (G : Ext → (Ext → Nat) → Nat) (envDraw : Env → Ext → Nat)
                    (envCap : Ext → Nat) (jointAdm : Env → Prop),
                    (∀ (env : Env), jointAdm env → ∀ (k : Ext), envDraw env k ≤ envCap k) →
                      ∀ (x_crit warnLevel H_safe x₀ : Ext → Nat),
                        (∀ (k : Ext), cA'.preCapExt k ≤ cA.preCapExt k) →
                          (∀ (k : Ext), cA'.postBudgetExt k ≤ cA.postBudgetExt k) →
                            cA'.maxSilence ≤ cA.maxSilence →
                              cA'.maxLag ≤ cA.maxLag →
                                (∀ (x : Ext → Nat) (k : Ext), x k < warnLevel k → cA.warnObs (obs₁ x)) →
                                  (∀ (x : Ext → Nat) (k : Ext), x k < warnLevel k → cA'.warnObs (obs₁' x)) →
                                    (∀ (load : Nat) (env : Env),
                                        jointAdm env → load ≤ cA.maxSilence → channel true load env = true) →
                                      (∀ (k : Ext),
                                          Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole
                                            (G k)) →
                                        (∀ (k : Ext),
                                            x_crit k ≤
                                              Becoming.RegimeMargin.Coupled.Indexed.step
                                                Becoming.RegimeMargin.Drawn.whole G H_safe x_crit k) →
                                          (∀ (k : Ext), cA.postBudgetExt k + envCap k ≤ H_safe k) →
                                            (∀ (k : Ext),
                                                x_crit k + (cA.maxLag + 1) * (cA.preCapExt k + envCap k) ≤
                                                  warnLevel k) →
                                              (∀ (k : Ext),
                                                  x_crit k + cA.eta init₁ * (cA.preCapExt k + envCap k) ≤ x₀ k) →
                                                Becoming.Reconfiguration.ready new.arrangement = true ∧
                                                  Becoming.FaultEnvelopes.separated new.arrangement.roster
                                                      (Becoming.Reconfiguration.envelope new.arrangement) ∧
                                                    (∀ (p : Becoming.Transactions.Request),
                                                        p.epoch = old.installation.state.epoch →
                                                          Becoming.Transactions.fresh new.installation p = false) ∧
                                                      Becoming.Viability.Kernel
                                                        (Becoming.OpenComposition.ReconfigProcess
                                                          (Becoming.Reconfiguration.guardedByArrangement A
                                                            old.arrangement)
                                                          (Becoming.Reconfiguration.guardedByArrangement A'
                                                            new.arrangement)
                                                          (Becoming.Reconfiguration.guardedEnvelopeContract cA
                                                            old.arrangement.roster
                                                            (Becoming.Reconfiguration.envelope old.arrangement))
                                                          (Becoming.Reconfiguration.guardedEnvelopeContract cA'
                                                            new.arrangement.roster
                                                            (Becoming.Reconfiguration.envelope new.arrangement))
                                                          (fun x => (obs₁ x, rep₁ x)) (fun x => (obs₁' x, rep₂ x))
                                                          channel G envDraw jointAdm)
                                                        (fun st =>
                                                          match st with
                                                          | Sum.inl st₁ =>
                                                            Becoming.OpenComposition.closedGuard
                                                              (Becoming.Reconfiguration.guardedByArrangement A
                                                                old.arrangement)
                                                              (Becoming.Reconfiguration.guardedEnvelopeContract cA
                                                                old.arrangement.roster
                                                                (Becoming.Reconfiguration.envelope old.arrangement))
                                                              x_crit st₁
                                                          | Sum.inr st₂ =>
                                                            Becoming.OpenComposition.closedGuard
                                                              (Becoming.Reconfiguration.guardedByArrangement A'
                                                                new.arrangement)
                                                              (Becoming.Reconfiguration.guardedEnvelopeContract cA'
                                                                new.arrangement.roster
                                                                (Becoming.Reconfiguration.envelope new.arrangement))
                                                              x_crit st₂)
                                                        (Sum.inl (x₀, init₁))
@Becoming.Reconfiguration.stronger_envelope_contract_refines : ∀ {S Obs Dist Int Ext : Type}
  {C : Becoming.OpenComposition.OpenComponent S Obs Dist Int Ext} {init : S}
  (c : Becoming.OpenComposition.InterfaceContract C init) (roster : List Becoming.FaultEnvelopes.Domain)
  (env₁ env₂ : Becoming.FaultEnvelopes.Envelope),
  env₂ ≠ [] →
    (∀ (b : List Becoming.FaultEnvelopes.Domain),
        b ∈ env₂ → ∃ f, f ∈ env₁ ∧ ∀ (d : Becoming.FaultEnvelopes.Domain), d ∈ b → d ∈ f) →
      ∀ (obs : (Ext → Nat) → Obs) (rep : (Ext → Nat) → Becoming.FaultEnvelopes.Domain → Bool) (warnLevel : Ext → Nat),
        Becoming.OpenComposition.ContractRefines (Becoming.Reconfiguration.guardedEnvelopeContract c roster env₁)
          (Becoming.Reconfiguration.guardedEnvelopeContract c roster env₂) (fun x => (obs x, rep x))
          (fun x => (obs x, rep x)) warnLevel
@Becoming.Reconfiguration.stronger_envelope_replace_left_viable : ∀
  {S₁ S₂ Obs₁ Obs₂ Dist₁ Dist₂ Int₁ Int₂ Ext Env : Type}
  (A : Becoming.OpenComposition.OpenComponent S₁ Obs₁ Dist₁ Int₁ Ext)
  (B : Becoming.OpenComposition.OpenComponent S₂ Obs₂ Dist₂ Int₂ Ext) {init₁ : S₁} {init₂ : S₂}
  (cA : Becoming.OpenComposition.InterfaceContract A init₁) (cB : Becoming.OpenComposition.InterfaceContract B init₂)
  (roster : List Becoming.FaultEnvelopes.Domain) (env₁ env₂ : Becoming.FaultEnvelopes.Envelope),
  env₂ ≠ [] →
    (∀ (b : List Becoming.FaultEnvelopes.Domain),
        b ∈ env₂ → ∃ f, f ∈ env₁ ∧ ∀ (d : Becoming.FaultEnvelopes.Domain), d ∈ b → d ∈ f) →
      ∀ (obs₁ : (Ext → Nat) → Obs₁) (rep : (Ext → Nat) → Becoming.FaultEnvelopes.Domain → Bool)
        (obs₂ : (Ext → Nat) → Obs₂) (channel : Bool → Nat → Env → Bool) (G : Ext → (Ext → Nat) → Nat)
        (envDraw : Env → Ext → Nat) (envCap : Ext → Nat) (jointAdm : Env → Prop),
        (∀ (env : Env), jointAdm env → ∀ (k : Ext), envDraw env k ≤ envCap k) →
          ∀ (x_crit warnLevel H_safe x₀ : Ext → Nat),
            (∀ (x : Ext → Nat) (k : Ext),
                x k < warnLevel k →
                  cA.warnObs (obs₁ x) ∧ Becoming.FaultEnvelopes.certificate roster env₁ (rep x) = true ∨
                    cB.warnObs (obs₂ x)) →
              (∀ (load : Nat) (env : Env),
                  jointAdm env → load ≤ cA.maxSilence + cB.maxSilence → channel true load env = true) →
                (∀ (k : Ext), Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole (G k)) →
                  (∀ (k : Ext),
                      x_crit k ≤
                        Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G H_safe x_crit
                          k) →
                    (∀ (k : Ext), cA.postBudgetExt k + cB.postBudgetExt k + envCap k ≤ H_safe k) →
                      (∀ (k : Ext),
                          x_crit k +
                              (Becoming.CoreHelpers.natMax cA.maxLag cB.maxLag + 1) *
                                (cA.preCapExt k + cB.preCapExt k + envCap k) ≤
                            warnLevel k) →
                        (∀ (k : Ext),
                            x_crit k +
                                Becoming.CoreHelpers.natMax (cA.eta init₁) (cB.eta init₂) *
                                  (cA.preCapExt k + cB.preCapExt k + envCap k) ≤
                              x₀ k) →
                          Becoming.Viability.Kernel
                            (Becoming.OpenComposition.closedProcess
                              ((Becoming.Reconfiguration.guardedByEnvelope A roster env₂).compose B)
                              (Becoming.OpenComposition.composeContract
                                (Becoming.Reconfiguration.guardedEnvelopeContract cA roster env₂) cB)
                              (fun x => ((obs₁ x, rep x), obs₂ x)) channel G envDraw jointAdm)
                            (Becoming.OpenComposition.closedGuard
                              ((Becoming.Reconfiguration.guardedByEnvelope A roster env₂).compose B)
                              (Becoming.OpenComposition.composeContract
                                (Becoming.Reconfiguration.guardedEnvelopeContract cA roster env₂) cB)
                              x_crit)
                            (x₀, init₁, init₂)
