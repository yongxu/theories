                                                (CR.web d₀ d₀).Admits ((CR.web d₀ d₀).level t) t CR.form₂)) →
                                        (∀ (t : Nat),
                                            T_rd < t →
                                              ¬((CR.web r₀ d₀).active t CR.form₁ ∧
                                                  (CR.web r₀ d₀).Admits ((CR.web r₀ d₀).level t) t CR.form₁)) →
                                          (∀ (t : Nat),
                                              T_dr < t →
                                                ¬((CR.web d₀ r₀).active t CR.form₂ ∧
                                                    (CR.web d₀ r₀).Admits ((CR.web d₀ r₀).level t) t CR.form₂)) →
                                            (T_rd + 1) * CR.stepYield₁ r₀ < (T_c + 1) * CR.stepYield₁ d₀ →
                                              (T_dr + 1) * CR.stepYield₂ r₀ < (T_c + 1) * CR.stepYield₂ d₀ →
                                                (T_c + 1) * CR.stepYield₁ d₀ < (CR.horizon + 1) * CR.stepYield₁ r₀ →
                                                  (T_c + 1) * CR.stepYield₂ d₀ < (CR.horizon + 1) * CR.stepYield₂ r₀ →
                                                    Becoming.Weighting.WidensOn acts wide narrow ∧
                                                      (∀ (x y : Act),
                                                          Becoming.EndogenousOrder.PureNash CR.rank₁ CR.rank₂ narrow
                                                              narrow x y ↔
                                                            x = r₀ ∧ y = r₀) ∧
                                                        (∀ (x y : Act),
                                                            Becoming.EndogenousOrder.PureNash CR.rank₁ CR.rank₂ wide
                                                                wide x y ↔
                                                              x = d₀ ∧ y = d₀) ∧
                                                          CR.rank₁ d₀ d₀ < CR.rank₁ r₀ r₀ ∧
                                                            CR.rank₂ d₀ d₀ < CR.rank₂ r₀ r₀
