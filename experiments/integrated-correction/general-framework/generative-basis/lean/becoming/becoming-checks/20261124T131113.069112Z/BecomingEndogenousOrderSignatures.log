    ∀ {dec : (Nat → C → Nat) → Nat × F → Bool},
      W.DecidesAdmission dec →
        ∀ (l₁ l₂ : Nat → C → Nat),
          ((∀ (t : Nat) (f : F), t ≤ H → W.Admits (l₂ t) t f → W.Admits (l₁ t) t f) ∧
              ∃ t f, t ≤ H ∧ W.Admits (l₁ t) t f ∧ ¬W.Admits (l₂ t) t f) ↔
            ∀ (w : Nat × F → Nat),
              Becoming.Weighting.Positive (Becoming.EndogenousOrder.horizonPairs H forms) w →
                Becoming.Weighting.weighed (Becoming.EndogenousOrder.horizonPairs H forms) w
                    (Becoming.EndogenousOrder.boundedAdmittedBool H dec l₂) <
                  Becoming.Weighting.weighed (Becoming.EndogenousOrder.horizonPairs H forms) w
