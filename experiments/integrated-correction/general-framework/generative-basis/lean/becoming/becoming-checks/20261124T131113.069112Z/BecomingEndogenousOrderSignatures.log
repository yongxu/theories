@Becoming.EndogenousOrder.macroAdmits_restores_comparability : ∀ {F C K : Type} {W : Becoming.Web F C} (H : Nat)
  (cap : F → K) (caps : List K),
  (∀ (k : K), k ∈ caps) →
    ∀ {macroDec : (C → Nat) → Nat → K → Bool},
      (∀ (l : C → Nat) (t : Nat) (k : K), macroDec l t k = true ↔ W.MacroAdmits cap l t k) →
        ∀ (l₁ l₂ : Nat → C → Nat),
          (∀ (t : Nat),
