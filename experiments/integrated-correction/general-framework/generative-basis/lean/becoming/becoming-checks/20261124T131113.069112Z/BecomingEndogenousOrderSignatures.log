@Becoming.EndogenousOrder.falls_iff_kept : ∀ {α : Type} (gs : List (List α)) (w a : α → Nat) {B s q K m : Nat},
  (∀ (g : List α), g ∈ gs → g.length = m) →
    (∀ (g : List α), g ∈ gs → ∀ (p : α), p ∈ g → w p + K * a p = B + s * a p + q * Becoming.total g a) →
      (Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) w a <
          Becoming.SelectionTerm.discord (Becoming.SelectionLevels.whole gs) w a ↔
        s * Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) a a +
            m * q * Becoming.SelectionLevels.concordAmong gs a a <
          K * Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) a a)
@Becoming.EndogenousOrder.assorted_wide_scope_emerges : ∀ {α F_n C_n K_n F_w C_w K_w X Y : Type} (gs : List (List α))
  (w a : α → Nat) {B s q K m : Nat},
  (∀ (g : List α), g ∈ gs → g.length = m) →
    (∀ (g : List α), g ∈ gs → ∀ (p : α), p ∈ g → w p + K * a p = B + s * a p + q * Becoming.total g a) →
      K * Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) a a <
          s * Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) a a +
            m * q * Becoming.SelectionLevels.concordAmong gs a a →
        ∀ {L : Becoming.Flow X X} {W : Becoming.Web X X},
          L.Acting W →
            ∀ {G : Becoming.SelectionTerm.Generations X},
              Becoming.SelectionTerm.Flow.Descended L W G →
                ∀ {lgs : List (List X)},
                  Becoming.SelectionLevels.whole lgs = G.family 0 →
                    (∀ (t : Nat),
                        Becoming.SelectionTerm.Exact (G.family t) (G.kids t) (G.amount t) (G.amount (t + 1))) →
                      ∀ {v : List X → Nat},
                        (∀ (g : List X), g ∈ lgs → ∀ (p : X), p ∈ g → G.amount 0 p = v g) →
                          ∀ {t : Nat},
                            (∀ (g h : List X),
                                g ∈ lgs →
                                  h ∈ lgs →
                                    v h < v g → ∀ (p : X), p ∈ Becoming.SelectionLevels.lineage G h t → ¬W.active t p) →
                              ∀ {g h : List X},
                                g ∈ lgs →
                                  h ∈ lgs →
                                    v h < v g →
                                      ∀ {p q' : X},
                                        p ∈ Becoming.SelectionLevels.lineage G g t →
                                          q' ∈ Becoming.SelectionLevels.lineage G h t →
                                            0 < G.offspringNumber t p →
                                              ∀
                                                (sys :
                                                  Becoming.ScopeDynamics.MutualFateSystem F_n C_n K_n F_w C_w K_w Y),
                                                Becoming.SelectionTerm.discord (Becoming.SelectionLevels.whole gs) w a <
                                                    Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) w
                                                      a ∧
                                                  G.Raises t ∧
                                                    (∀ (k : Nat) (y : Y),
                                                        ¬y ∈
                                                            sys.narrowLin.G.family
                                                              (sys.narrowLin.T + sys.narrowLin.n + k + 1)) ∧
                                                      ∀ (s' : Nat),
                                                        sys.wide.S_safe ≤ sys.wide.sub.level s' ∧
                                                          sys.wide.sub.level s' ≤ sys.wide.hi
@Becoming.EndogenousOrder.unassorted_myopic_trap : ∀ {α F_n C_n K_n X : Type} (gs : List (List α)) (w a : α → Nat)
  {B s q K m : Nat},
  (∀ (g : List α), g ∈ gs → g.length = m) →
    (∀ (g : List α), g ∈ gs → ∀ (p : α), p ∈ g → w p + K * a p = B + s * a p + q * Becoming.total g a) →
      s * Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) a a +
            m * q * Becoming.SelectionLevels.concordAmong gs a a <
          K * Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) a a →
        ∀ (nc : Becoming.ScopeDynamics.NarrowCoalition F_n C_n K_n)
          (nl : Becoming.ScopeDynamics.NarrowLineage X nc.sub),
          Becoming.SelectionTerm.concord (Becoming.SelectionLevels.whole gs) w a <
              Becoming.SelectionTerm.discord (Becoming.SelectionLevels.whole gs) w a ∧
            (∃ T_end,
                (∀ (t : Nat), T_end ≤ t → nc.sub.level t = 0) ∧
                  ∀ (t : Nat), T_end ≤ t → ∀ (k : K_n), ¬nc.W.MacroAdmits nc.cap (nc.W.level t) t k) ∧
              ∀ (k : Nat) (y : X), ¬y ∈ nl.G.family (nl.T + nl.n + k + 1)
