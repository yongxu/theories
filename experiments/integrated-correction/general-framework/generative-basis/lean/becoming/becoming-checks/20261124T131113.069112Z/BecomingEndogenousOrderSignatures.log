                                    ∀ (t : Nat),
                                      T ≤ t →
                                        U.ranksAt feedback t (Becoming.EndogenousOrder.boundedAdmittedBool H dec l₂)
                                          (Becoming.EndogenousOrder.boundedAdmittedBool H dec l₁)
