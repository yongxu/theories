@Becoming.EndogenousOrder.adaptive_order_joins_coupledEnding : ∀ {X Pos : Type} {L : Becoming.Flow X X}
  {W : Becoming.Web X X},
  L.Balances W →
    L.Acting W →
      W.Dependent →
        ∀ {G : Becoming.SelectionTerm.Generations X},
          Becoming.SelectionTerm.Flow.Descended L W G →
            ∀ {ds : List X} {m : Nat},
              (∀ (s : Nat) (f : X),
                  f ∈ L.present s →
                    ∀ (d : X), d ∈ ds → 0 < L.give s f d → ∃ e, e ∈ ds ∧ W.requires s f e ∧ m ≤ W.need s f e) →
                ∀ {T_end n : Nat},
                  (∀ (k : Nat), k < n → L.replenishment ds (T_end + k) < L.uptake ds (T_end + k)) →
                    W.stock ds T_end < n + m →
                      (∀ (k : Nat) (q : X),
                          q ∈ G.family (T_end + n + k) →
                            ∃ e, e ∈ ds ∧ W.requires (T_end + n + k) q e ∧ m ≤ W.need (T_end + n + k) q e) →
                        ∀ (U : Becoming.EndogenousOrder.OrderUpdater (Nat × X)) (feedback : Nat → Nat × X → Bool)
                          {B K T : Nat},
                          (∀ (x : Nat × X), x ∈ U.items → U.own x = true → U.base x ≤ B) →
                            (∀ (y : Nat × X), y ∈ U.items → U.own y = false → U.base y ≤ U.initPos y) →
                              (∀ (x : Nat × X),
                                  x ∈ U.items → U.own x = true → K ≤ Becoming.EndogenousOrder.hitCount feedback T x) →
                                B < K * U.stepGain →
                                  ∀ {a b : Nat × X → Bool},
                                    (∀ (x : Nat × X), x ∈ U.items → b x = true → x.snd ∈ G.family x.fst) →
                                      (∀ (x : Nat × X), x ∈ U.items → x.fst ≤ T_end + n → a x = b x) →
                                        ∀ (own : Pos → Nat × X → Bool) (p : Pos),
                                          U.own = own p →
                                            Becoming.Weighting.AddsOwn U.items (own p) a b →
                                              ∀ (t : Nat), T ≤ t → U.ranksAt feedback t b a
