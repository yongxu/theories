            ((W.MacroIncludes cap l₁ l₂ ∧ ∃ t k, t ≤ H ∧ W.MacroAdmits cap (l₁ t) t k ∧ ¬W.MacroAdmits cap (l₂ t) t k) →
              ∀ (w : Nat × K → Nat),
                Becoming.Weighting.Positive (Becoming.EndogenousOrder.horizonPairs H caps) w →
                  Becoming.Weighting.weighed (Becoming.EndogenousOrder.horizonPairs H caps) w
