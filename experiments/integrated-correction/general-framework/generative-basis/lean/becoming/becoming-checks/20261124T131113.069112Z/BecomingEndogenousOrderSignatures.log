            run.state 0 = (fun x => x₀, ⟨Becoming.EndogenousOrder.ScopeMode.narrowUnmonitored, initLag⟩) →
              ∀ {X : Type} {L : Becoming.Flow X X} {W : Becoming.Web X X},
                L.Acting W →
                  ∀ {G : Becoming.SelectionTerm.Generations X},
                    Becoming.SelectionTerm.Flow.Descended L W G →
                      ∀ {lgs : List (List X)},
                        Becoming.SelectionLevels.whole lgs = G.family 0 →
                          (∀ (t : Nat),
                              Becoming.SelectionTerm.Exact (G.family t) (G.kids t) (G.amount t) (G.amount (t + 1))) →
                            ∀ {v : List X → Nat},
                              (∀ (g : List X), g ∈ lgs → ∀ (p : X), p ∈ g → G.amount 0 p = v g) →
                                ∀ {t : Nat},
                                  (∀ (g h : List X),
                                      g ∈ lgs →
                                        h ∈ lgs →
                                          v h < v g →
                                            ∀ (p : X), p ∈ Becoming.SelectionLevels.lineage G h t → ¬W.active t p) →
                                    ∀ {g h : List X},
                                      g ∈ lgs →
                                        h ∈ lgs →
                                          v h < v g →
                                            ∀ {p q' : X},
                                              p ∈ Becoming.SelectionLevels.lineage G g t →
                                                q' ∈ Becoming.SelectionLevels.lineage G h t →
                                                  ∀ (c_sub : X),
                                                    (∀ (s : Nat), (run.state s).fst () ≤ W.level s c_sub) →
                                                      (x_crit ≤ W.level t c_sub → 0 < G.offspringNumber t p) →
                                                        Becoming.Viability.Kernel
                                                            (Becoming.PolyComposition.polyClosedProcess
                                                              (Becoming.PolyComposition.anchoredSelfModComponent
                                                                (Becoming.EndogenousOrder.scopeBase preDraw coopDraw
                                                                  maxLagN coop_le_pre)
                                                                (Becoming.EndogenousOrder.scopeAdmitDec maxLagN)
                                                                Becoming.EndogenousOrder.scopeFallback propose)
                                                              Becoming.EndogenousOrder.scopeRoute
                                                              (Becoming.PolyComposition.anchoredSelfModContract
                                                                (Becoming.EndogenousOrder.scopeBase preDraw coopDraw
                                                                  maxLagN coop_le_pre)
                                                                ⋯ (Becoming.EndogenousOrder.scopeAdmitDec maxLagN)
                                                                Becoming.EndogenousOrder.scopeFallback ⋯ propose)
                                                              (Becoming.EndogenousOrder.scopeObs warnLevel)
                                                              Becoming.EndogenousOrder.scopeChannel
                                                              (fun x e => G_sub (e ())) (fun x x_1 => envCap) fun x =>
                                                              True)
                                                            (Becoming.PolyComposition.polyClosedGuard
                                                              (Becoming.PolyComposition.anchoredSelfModComponent
                                                                (Becoming.EndogenousOrder.scopeBase preDraw coopDraw
                                                                  maxLagN coop_le_pre)
                                                                (Becoming.EndogenousOrder.scopeAdmitDec maxLagN)
                                                                Becoming.EndogenousOrder.scopeFallback propose)
                                                              (Becoming.PolyComposition.anchoredSelfModContract
                                                                (Becoming.EndogenousOrder.scopeBase preDraw coopDraw
                                                                  maxLagN coop_le_pre)
                                                                ⋯ (Becoming.EndogenousOrder.scopeAdmitDec maxLagN)
                                                                Becoming.EndogenousOrder.scopeFallback ⋯ propose)
                                                              fun x => x_crit)
                                                            (fun x => x₀,
                                                              ⟨Becoming.EndogenousOrder.ScopeMode.narrowUnmonitored,
                                                                initLag⟩) ∧
