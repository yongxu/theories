@Becoming.EndogenousOrder.adaptive_order_ranks_horizon : ∀ {F C : Type} {W : Becoming.Web F C} (H : Nat)
  (forms : List F),
  (∀ (f : F), f ∈ forms) →
    ∀ {dec : (Nat → C → Nat) → Nat × F → Bool},
      W.DecidesAdmission dec →
        ∀ (U : Becoming.EndogenousOrder.OrderUpdater (Nat × F)),
          U.items = Becoming.EndogenousOrder.horizonPairs H forms →
            ∀ (feedback : Nat → Nat × F → Bool) {B K T : Nat},
              (∀ (x : Nat × F), x ∈ U.items → U.own x = true → U.base x ≤ B) →
                (∀ (y : Nat × F), y ∈ U.items → U.own y = false → U.base y ≤ U.initPos y) →
                  (∀ (x : Nat × F), x ∈ U.items → U.own x = true → K ≤ Becoming.EndogenousOrder.hitCount feedback T x) →
                    B < K * U.stepGain →
                      ∀ {l₁ l₂ : Nat → C → Nat},
                        (∀ (t : Nat) (f : F), t ≤ H → W.Admits (l₂ t) t f → W.Admits (l₁ t) t f) →
