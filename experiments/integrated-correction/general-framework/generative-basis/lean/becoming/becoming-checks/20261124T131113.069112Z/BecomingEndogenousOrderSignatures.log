@Becoming.EndogenousOrder.online_off_support_reversal : ∀ {X O : Type} (U : Becoming.EndogenousOrder.OrderUpdater X)
  (feedback : Nat → X → Bool) {B K T : Nat} (probe : X → Bool) (ch : Becoming.ChoiceOccasions (X → Bool) O),
  (∀ (a b : X → Bool), ch.Met a b → ∀ (z : X), z ∈ U.items → probe z = false → a z = b z) →
    (∀ (x : X), x ∈ U.items → U.own x = true → probe x = true → U.base x ≤ B) →
      (∀ (y : X), y ∈ U.items → U.own y = false → probe y = true → U.base y ≤ U.initPos y) →
        (∀ (x : X),
            x ∈ U.items → U.own x = true → probe x = true → K ≤ Becoming.EndogenousOrder.hitCount feedback T x) →
          B < K * U.stepGain →
            (ch.Accords fun x y => U.ranksAt feedback T y x) →
              ∀ {a b : X → Bool},
                ch.Unmet a →
                  Becoming.Weighting.WidensOn U.items a b →
                    Becoming.Weighting.AddsOwn U.items U.own a b →
                      ∃ P,
                        (∀ (x : X → Bool), ¬P x x) ∧
                          (∀ (x y z : X → Bool), P x y → P y z → P x z) ∧
                            ch.Accords P ∧
                              (Becoming.Weighting.IncreasingInOwnOn ch.Met U.items U.own fun y x => P x y) ∧
                                P b a ∧ ¬Becoming.Weighting.IncreasingInOwn U.items U.own fun y x => P x y
@Becoming.EndogenousOrder.online_weight_learner_reverses_off_support : ∀ {X : Type}
  (U : Becoming.EndogenousOrder.OrderUpdater X) (feedback : Nat → X → Bool) {B K T : Nat} (probe : X → Bool),
  (∀ (x : X), x ∈ U.items → U.own x = true → probe x = true → U.base x ≤ B) →
    (∀ (y : X), y ∈ U.items → U.own y = false → probe y = true → U.base y ≤ U.initPos y) →
      (∀ (x : X), x ∈ U.items → U.own x = true → probe x = true → K ≤ Becoming.EndogenousOrder.hitCount feedback T x) →
        B < K * U.stepGain →
          ∀ {u : X},
            (∀ (s : Nat), s < T → feedback s u = false) →
              U.initPos u < U.base u →
                ∀ {a b : X → Bool},
                  Becoming.Weighting.WidensBy U.items u a b →
                    Becoming.Weighting.IncreasingInOwnOn
                        (fun c d => ∀ (z : X), z ∈ U.items → probe z = false → c z = d z) U.items U.own
                        (U.ranksAt feedback T) ∧
                      U.ranksAt feedback T a b ∧
                        ¬U.ranksAt feedback T b a ∧
                          (U.own u = true → ¬Becoming.Weighting.IncreasingInOwn U.items U.own (U.ranksAt feedback T))
