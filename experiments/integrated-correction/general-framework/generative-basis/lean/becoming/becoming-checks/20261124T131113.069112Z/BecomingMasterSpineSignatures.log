@Becoming.MasterSpine.postProbe_step_lemma : ∀ {Θ Probe Outcome S_op Obs_op Dist_op Int_op Site Env : Type}
  (W : Becoming.ActiveInquiryLoop.RegimeWorld Θ Probe Outcome Obs_op Site Env)
  (spec : Becoming.ActiveInquiryLoop.ActiveInquirySpec Θ Probe Outcome S_op Obs_op Dist_op Int_op Site) (θ : Θ)
  (channel : Bool → Nat → Env → Bool) (fallbackS : S_op) (fallbackD : Dist_op)
  (st st' :
    (Site → Nat) ×
      (m : Becoming.ActiveInquiryLoop.InquiryMode Θ Unit) × Becoming.ActiveInquiryLoop.inquiryS Probe Outcome S_op Θ m)
  (act :
    Env × (m : Becoming.ActiveInquiryLoop.InquiryMode Θ Unit) × Becoming.ActiveInquiryLoop.inquiryDist Dist_op Θ m),
  (Becoming.PolyComposition.polyClosedProcess (Becoming.ActiveInquiryLoop.inquiryPolyComponent spec)
          (fun x site => [site]) (Becoming.ActiveInquiryLoop.inquiryContract spec)
          (Becoming.ActiveInquiryLoop.inquiryWorldObs W spec θ) channel (W.G θ) (W.envDraw θ) W.jointAdm).step
      st act st' →
    Becoming.MasterSpine.IsOpTheta θ st.snd →
      (Becoming.OpenComposition.closedProcess (spec.opComp θ) (spec.opContract θ) (W.opObs θ) channel (W.G θ)
            (W.envDraw θ) W.jointAdm).step
        (st.fst, Becoming.MasterSpine.extractOpState fallbackS st.snd)
        (act.fst, Becoming.MasterSpine.extractOpDist fallbackD act.snd)
        (st'.fst, Becoming.MasterSpine.extractOpState fallbackS st'.snd)
@Becoming.MasterSpine.postProbeRun_opInvariants : ∀ {Θ Probe Outcome S_op Obs_op Dist_op Int_op Site Env : Type}
  (W : Becoming.ActiveInquiryLoop.RegimeWorld Θ Probe Outcome Obs_op Site Env)
  (spec : Becoming.ActiveInquiryLoop.ActiveInquirySpec Θ Probe Outcome S_op Obs_op Dist_op Int_op Site) (θ : Θ)
  (channel : Bool → Nat → Env → Bool) (fallbackS : S_op) (fallbackD : Dist_op) (x_crit : Site → Nat)
  (r_inq :
    Becoming.Run
      (Becoming.PolyComposition.polyClosedProcess (Becoming.ActiveInquiryLoop.inquiryPolyComponent spec)
        (fun x site => [site]) (Becoming.ActiveInquiryLoop.inquiryContract spec)
        (Becoming.ActiveInquiryLoop.inquiryWorldObs W spec θ) channel (W.G θ) (W.envDraw θ) W.jointAdm)),
  (∀ (n : Nat),
      (n < spec.horizon → Becoming.MasterSpine.IsProbeAt n (r_inq.state n).snd) ∧
        (spec.horizon ≤ n → Becoming.MasterSpine.IsOpState (r_inq.state n).snd) ∧
          (n = spec.horizon → Becoming.MasterSpine.IsOpWithInit spec (r_inq.state n).snd)) →
    (∀ (t : Nat), Becoming.ActiveInquiryLoop.ExploreMarginInv W spec θ x_crit (r_inq.state t)) →
      ∀ (hOpAll : ∀ (k : Nat), Becoming.MasterSpine.IsOpTheta θ (r_inq.state (spec.horizon + k)).snd),
        have rOp := Becoming.MasterSpine.postProbeRun W spec θ channel fallbackS fallbackD r_inq hOpAll;
        (rOp.state 0).snd = spec.opInit θ ∧
          (∀ (k : Nat), (spec.opContract θ).K (rOp.state k).snd) ∧
            (∀ (k : Nat),
                Becoming.OpenComposition.closedGuard (spec.opComp θ) (spec.opContract θ) x_crit (rOp.state k)) ∧
              ∀ (site : Site),
                x_crit site +
                    (spec.opContract θ).eta (spec.opInit θ) * ((spec.opContract θ).preCapExt site + W.envCap site) ≤
                  (rOp.state 0).fst site
