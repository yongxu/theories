  {spec : Becoming.ActiveInquiryLoop.ActiveInquirySpec Θ Probe Outcome S_op Obs_op Dist_op Int_op Site} {θ : Θ}
  {channel : Bool → Nat → Env → Bool}
  {st st' :
    (Site → Nat) ×
      (m : Becoming.ActiveInquiryLoop.InquiryMode Θ Unit) × Becoming.ActiveInquiryLoop.inquiryS Probe Outcome S_op Θ m}
  {act :
    Env × (m : Becoming.ActiveInquiryLoop.InquiryMode Θ Unit) × Becoming.ActiveInquiryLoop.inquiryDist Dist_op Θ m},
  (Becoming.PolyComposition.polyClosedProcess (Becoming.ActiveInquiryLoop.inquiryPolyComponent spec)
          (fun x site => [site]) (Becoming.ActiveInquiryLoop.inquiryContract spec)
          (Becoming.ActiveInquiryLoop.inquiryWorldObs W spec θ) channel (W.G θ) (W.envDraw θ) W.jointAdm).step
      st act st' →
    (∀ (n : Nat),
        Becoming.MasterSpine.IsProbeAt n st.snd →
          n < spec.horizon →
            (n + 1 < spec.horizon → Becoming.MasterSpine.IsProbeAt (n + 1) st'.snd) ∧
              (¬n + 1 < spec.horizon →
                Becoming.MasterSpine.IsOpState st'.snd ∧ Becoming.MasterSpine.IsOpWithInit spec st'.snd)) ∧
      (Becoming.MasterSpine.IsOpState st.snd → Becoming.MasterSpine.IsOpState st'.snd)
