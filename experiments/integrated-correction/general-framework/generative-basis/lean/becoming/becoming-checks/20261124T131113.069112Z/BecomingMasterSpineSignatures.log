@Becoming.MasterSpine.whole_architecture_scopeMode_bridge : ∀
  {Θ Probe Outcome Env I₁ S₁ A₁ Dist₁ I₂ S₂ A₂ Dist₂ ObsL ExtHide QX BX QA BA QB BB QCausal X_evo X_bad Pos_ord Act F_cr
    C_cr : Type}
  (preDraw coopDraw maxLagN initLag envCap_s : Nat) (coop_le_pre : coopDraw ≤ preDraw)
  (init_in_s : 0 < initLag ∧ initLag ≤ maxLagN)
  (propose :
    (p : (m : Becoming.EndogenousOrder.ScopeMode) × Becoming.EndogenousOrder.ScopeS m) →
      Becoming.EndogenousOrder.ScopeObs p.fst × Bool →
        Becoming.EndogenousOrder.ScopeDist p.fst →
          (m' : Becoming.EndogenousOrder.ScopeMode) × Becoming.EndogenousOrder.ScopeS m')
  (G_sub : Nat → Nat),
  (∀ (a b : Nat), a ≤ b → G_sub a ≤ G_sub b) →
    ∀ (x_crit_s warn_s x₀_s : Nat),
      x_crit_s ≤
          Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole (fun x e => G_sub (e ()))
            (fun x => coopDraw + envCap_s) (fun x => x_crit_s) () →
        x_crit_s + (maxLagN + 1) * (preDraw + envCap_s) ≤ warn_s →
          x_crit_s + initLag * (preDraw + envCap_s) ≤ x₀_s →
            ∀
              (r_scope :
                Becoming.Run
                  (Becoming.PolyComposition.polyClosedProcess
                    (Becoming.PolyComposition.anchoredSelfModComponent
                      (Becoming.EndogenousOrder.scopeBase preDraw coopDraw maxLagN coop_le_pre)
                      (Becoming.EndogenousOrder.scopeAdmitDec maxLagN) Becoming.EndogenousOrder.scopeFallback propose)
                    Becoming.EndogenousOrder.scopeRoute
                    (Becoming.PolyComposition.anchoredSelfModContract
                      (Becoming.EndogenousOrder.scopeBase preDraw coopDraw maxLagN coop_le_pre) ⋯
                      (Becoming.EndogenousOrder.scopeAdmitDec maxLagN) Becoming.EndogenousOrder.scopeFallback ⋯ propose)
                    (Becoming.EndogenousOrder.scopeObs warn_s) Becoming.EndogenousOrder.scopeChannel
                    (fun x e => G_sub (e ())) (fun x x_1 => envCap_s) fun x => True)),
              r_scope.state 0 = (fun x => x₀_s, ⟨Becoming.EndogenousOrder.ScopeMode.narrowUnmonitored, initLag⟩) →
                ∀
                  (A :
                    Becoming.MasterSpine.WholeArchitecture Θ Probe Outcome Env I₁ S₁ A₁ Dist₁ I₂ S₂ A₂ Dist₂ ObsL Unit
                      ExtHide Becoming.EndogenousOrder.ScopeMode Nat Bool Unit Empty QX BX QA BA QB BB QCausal X_evo
                      X_bad Pos_ord Act F_cr C_cr),
                  (∀ (t : Nat), A.W_evo.level t A.c_sub = (r_scope.state t).fst ()) →
                    (x_crit_s ≤ A.W_evo.level A.t_evo A.c_sub → 0 < A.G_evo.offspringNumber A.t_evo A.p_evo) →
                      Becoming.Viability.Kernel
                          (Becoming.PolyComposition.polyClosedProcess
                            (Becoming.PolyComposition.anchoredSelfModComponent
                              (Becoming.EndogenousOrder.scopeBase preDraw coopDraw maxLagN coop_le_pre)
                              (Becoming.EndogenousOrder.scopeAdmitDec maxLagN) Becoming.EndogenousOrder.scopeFallback
                              propose)
                            Becoming.EndogenousOrder.scopeRoute
                            (Becoming.PolyComposition.anchoredSelfModContract
                              (Becoming.EndogenousOrder.scopeBase preDraw coopDraw maxLagN coop_le_pre) ⋯
                              (Becoming.EndogenousOrder.scopeAdmitDec maxLagN) Becoming.EndogenousOrder.scopeFallback ⋯
                              propose)
                            (Becoming.EndogenousOrder.scopeObs warn_s) Becoming.EndogenousOrder.scopeChannel
                            (fun x e => G_sub (e ())) (fun x x_1 => envCap_s) fun x => True)
                          (Becoming.PolyComposition.polyClosedGuard
                            (Becoming.PolyComposition.anchoredSelfModComponent
                              (Becoming.EndogenousOrder.scopeBase preDraw coopDraw maxLagN coop_le_pre)
                              (Becoming.EndogenousOrder.scopeAdmitDec maxLagN) Becoming.EndogenousOrder.scopeFallback
                              propose)
                            (Becoming.PolyComposition.anchoredSelfModContract
                              (Becoming.EndogenousOrder.scopeBase preDraw coopDraw maxLagN coop_le_pre) ⋯
                              (Becoming.EndogenousOrder.scopeAdmitDec maxLagN) Becoming.EndogenousOrder.scopeFallback ⋯
                              propose)
                            fun x => x_crit_s)
                          (fun x => x₀_s, ⟨Becoming.EndogenousOrder.ScopeMode.narrowUnmonitored, initLag⟩) ∧
                        (∀ (s : Nat), x_crit_s ≤ A.W_evo.level s A.c_sub) ∧
                          A.G_evo.Raises A.t_evo ∧
                            Becoming.Viability.Kernel
                              (Becoming.OpenComposition.closedProcess A.compOp A.cOp (A.W.opObs A.θ_true) A.channel
                                (A.W.G A.θ_true) (A.W.envDraw A.θ_true) A.W.jointAdm)
                              (Becoming.OpenComposition.closedGuard A.compOp A.cOp A.x_crit) (A.rOp.state 0)
