          (Becoming.PolyComposition.polyClosedProcess (Becoming.ActiveInquiryLoop.inquiryPolyComponent spec)
            (fun x site => [site]) (Becoming.ActiveInquiryLoop.inquiryContract spec)
            (Becoming.ActiveInquiryLoop.inquiryWorldObs W spec θ) channel (W.G θ) (W.envDraw θ) W.jointAdm)),
      r_inq.state 0 = (x₀, Becoming.ActiveInquiryLoop.inquiryInit spec) →
        Becoming.ActiveInquiryLoop.ExploreMarginInv W spec θ x_crit (x₀, Becoming.ActiveInquiryLoop.inquiryInit spec) →
          ∀ (t : Nat), Becoming.ActiveInquiryLoop.ExploreMarginInv W spec θ x_crit (r_inq.state t)
@Becoming.MasterSpine.postProbe_isOpTheta : ∀ {Θ Probe Outcome S_op Obs_op Dist_op Int_op Site Env : Type}
  (W : Becoming.ActiveInquiryLoop.RegimeWorld Θ Probe Outcome Obs_op Site Env)
