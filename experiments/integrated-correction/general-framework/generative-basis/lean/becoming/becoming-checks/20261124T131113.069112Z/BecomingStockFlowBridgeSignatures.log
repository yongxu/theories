      levelFn T + Becoming.total (Becoming.steps T N) giveFn
@Becoming.StockFlowBridge.unitAccumulates_of_global_balances : ∀ {levelFn takeFn giveFn : Nat → Nat} {N : Nat},
  (Becoming.StockFlowBridge.unitFlow takeFn giveFn).Balances (Becoming.StockFlowBridge.unitWeb levelFn) →
