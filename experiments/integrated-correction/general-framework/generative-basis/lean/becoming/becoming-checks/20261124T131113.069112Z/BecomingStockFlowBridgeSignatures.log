  {P : Generative.Process S A} (r : Becoming.Run P) (σ : S → Nat) (draw replenish : A → Nat),
  (r.stockFlow draw replenish).Balances (r.stockWeb σ) ↔
    (Becoming.StockFlowBridge.unitFlow (fun t => draw (r.act t)) fun t => replenish (r.act t)).Balances
      (Becoming.StockFlowBridge.unitWeb fun t => σ (r.state t))
@Becoming.StockFlowBridge.stockProcess_step_of_le : ∀ {levelFn takeFn giving : Nat → Nat} {t : Nat},
  levelFn (t + 1) = Becoming.RegimeMargin.step giving (takeFn t) (levelFn t) →
    takeFn t ≤ levelFn t →
      (Becoming.Stock.process takeFn fun k => giving (levelFn k - takeFn k)).step (levelFn t) t (levelFn (t + 1))
@Becoming.StockFlowBridge.not_stockProcess_step_of_overdraw : ∀ {levelFn takeFn giving : Nat → Nat} {t m : Nat},
  levelFn t < takeFn t → ¬(Becoming.Stock.process takeFn fun k => giving (levelFn k - takeFn k)).step (levelFn t) t m
@Becoming.StockFlowBridge.stockProcess_trace_of_within : ∀ {levelFn takeFn giving : Nat → Nat} (N T : Nat),
  (∀ (t : Nat), T ≤ t → t < T + N → levelFn (t + 1) = Becoming.RegimeMargin.step giving (takeFn t) (levelFn t)) →
    (∀ (t : Nat), T ≤ t → t < T + N → takeFn t ≤ levelFn t) →
      Generative.Trace (Becoming.Stock.process takeFn fun k => giving (levelFn k - takeFn k)) (levelFn T)
        (Becoming.steps T N) (levelFn (T + N))
@Becoming.StockFlowBridge.stockCovered_of_within : ∀ {levelFn takeFn giving : Nat → Nat} {T N : Nat},
  (∀ (t : Nat), T ≤ t → t < T + N → levelFn (t + 1) = Becoming.RegimeMargin.step giving (takeFn t) (levelFn t)) →
    (∀ (t : Nat), T ≤ t → t < T + N → takeFn t ≤ levelFn t) →
      Becoming.Stock.Covered takeFn (fun k => giving (levelFn k - takeFn k)) (levelFn T) (Becoming.steps T N)
@Becoming.StockFlowBridge.stockPrefix_covered_of_within : ∀ {levelFn takeFn giving : Nat → Nat} {T N : Nat},
  (∀ (t : Nat), T ≤ t → t < T + N → levelFn (t + 1) = Becoming.RegimeMargin.step giving (takeFn t) (levelFn t)) →
    (∀ (t : Nat), T ≤ t → t < T + N → takeFn t ≤ levelFn t) →
      ∀ (u : List Nat) (a : Nat) (v : List Nat),
        Becoming.steps T N = u ++ a :: v →
          Becoming.total u takeFn + takeFn a ≤ levelFn T + Becoming.total u fun k => giving (levelFn k - takeFn k)
@Becoming.StockFlowBridge.unitBalances_of_stockRun : ∀ {levelFn takeFn giving : Nat → Nat},
