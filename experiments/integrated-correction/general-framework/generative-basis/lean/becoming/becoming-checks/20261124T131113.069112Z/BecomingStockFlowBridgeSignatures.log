        (Becoming.StockFlowBridge.unitWeb levelFn)
@Becoming.StockFlowBridge.clampedStep_balance_discrepancy : ∀ {x' x d u : Nat},
  x' = x - d + u → x' + d = x + u + (d - x)
@Becoming.StockFlowBridge.clampedStep_balance_iff_le : ∀ {x' x d u : Nat}, x' = x - d + u → (x' + d = x + u ↔ d ≤ x)
@Becoming.StockFlowBridge.list_clampedStep_imbalance_eq_sum_overdraw : ∀ {Site : Type} (x' x d u : Site → Nat),
  (∀ (k : Site), x' k = x k - d k + u k) →
    ∀ (ks : List Site),
      (Becoming.total ks fun k => x' k + d k) =
        (Becoming.total ks fun k => x k + u k) + Becoming.total ks fun k => d k - x k
@Becoming.StockFlowBridge.list_clampedStep_exact_balance_iff_all_covered : ∀ {Site : Type} (x' x d u : Site → Nat),
  (∀ (k : Site), x' k = x k - d k + u k) →
    ∀ (ks : List Site),
      ((Becoming.total ks fun k => x' k + d k) = Becoming.total ks fun k => x k + u k) ↔
        ∀ (k : Site), k ∈ ks → d k ≤ x k
@Becoming.StockFlowBridge.unitBalancesOn_of_le : ∀ {levelFn takeFn giving : Nat → Nat} {t : Nat},
