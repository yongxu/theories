@Becoming.StockFlowBridge.stockRun_never_returns_below_within : ∀ {S : Type u_1} {A : Type} {P : Generative.Process S A}
  {σ : S → Nat} {draw replenish : A → Nat},
  Becoming.Stock.Balanced P σ draw replenish →
    ∀ (r : Becoming.Run P) {m T N : Nat},
      (∀ (t : Nat), T ≤ t → t < T + N → σ (r.state t) < m → replenish (r.act t) ≤ draw (r.act t)) →
        σ (r.state T) < m → ∀ (n : Nat), n ≤ N → σ (r.state (T + n)) < m
Becoming.StockFlowBridge.coupled_indexed_step_whole_eq : ∀ (giving : Nat → Nat) (h z : Nat),
  Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole (fun x e => giving (e ())) (fun x => h)
      (fun x => z) () =
    Becoming.RegimeMargin.step giving h z
@Becoming.StockFlowBridge.line_taken_const_of_even_met : ∀ {U : Type} {need : U → Nat} {kids : U → List U}
  {giving : Nat → Nat} {use : U → Nat} {w₀ : List U} {z₀ : Nat},
  (∀ (u : U), Becoming.LineOnAStock.taken use (kids u) = use u) →
    ∀ (k : Nat),
      (∀ (j : Nat),
          j < k →
            ∀ (u : U),
              u ∈ (Becoming.LineOnAStock.course need kids giving use (w₀, z₀) j).fst →
                need u ≤ (Becoming.LineOnAStock.course need kids giving use (w₀, z₀) j).snd) →
        Becoming.LineOnAStock.taken use (Becoming.LineOnAStock.course need kids giving use (w₀, z₀) k).fst =
          Becoming.LineOnAStock.taken use w₀
@Becoming.StockFlowBridge.line_coupled_indexed_correspondence : ∀ {U : Type} {need : U → Nat} {kids : U → List U}
  {giving : Nat → Nat} {use : U → Nat} {w₀ : List U} {z₀ : Nat},
  (∀ (u : U), Becoming.LineOnAStock.taken use (kids u) = use u) →
    ∀ (k : Nat),
      (∀ (j : Nat),
          j < k →
            ∀ (u : U),
              u ∈ (Becoming.LineOnAStock.course need kids giving use (w₀, z₀) j).fst →
                need u ≤ (Becoming.LineOnAStock.course need kids giving use (w₀, z₀) j).snd) →
        (Becoming.LineOnAStock.course need kids giving use (w₀, z₀) k).snd =
          (Becoming.Law.run
                (Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole (fun x e => giving (e ()))
                  fun x => Becoming.LineOnAStock.taken use w₀)
                fun x => z₀).state
            k ()
@Becoming.StockFlowBridge.way_taken_const_of_met : ∀ {U R : Type} {need : U → Nat} {kids : R → U → List U}
  {next : List U → R → R} {giving : Nat → Nat} {use : U → Nat} {w₀ : List U} {g₀ : R} {z₀ : Nat} (k : Nat),
  (∀ (j : Nat),
      j < k →
        ∀ (u : U),
          u ∈ (Becoming.WayUnderARule.course need kids next giving use ((w₀, g₀), z₀) j).fst.fst →
            need u ≤ (Becoming.WayUnderARule.course need kids next giving use ((w₀, g₀), z₀) j).snd) →
    (∀ (j : Nat),
        j < k →
          ∀ (u : U),
            Becoming.LineOnAStock.taken use
                (kids (Becoming.WayUnderARule.course need kids next giving use ((w₀, g₀), z₀) j).fst.snd u) =
              use u) →
      Becoming.LineOnAStock.taken use
          (Becoming.WayUnderARule.course need kids next giving use ((w₀, g₀), z₀) k).fst.fst =
        Becoming.LineOnAStock.taken use w₀
