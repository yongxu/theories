                  (Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole
                    (fun x e => giving (e ())) fun x => Becoming.LineOnAStock.taken use w₀)
                  fun x => z₀).state
              k ()
