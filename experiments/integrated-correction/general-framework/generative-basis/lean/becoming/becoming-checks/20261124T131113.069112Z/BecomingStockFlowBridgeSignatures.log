@Becoming.StockFlowBridge.way_coupled_indexed_of_unfavoured : ∀ {U R : Type} {need : U → Nat} {kids : R → U → List U}
  {next : List U → R → R} {giving : Nat → Nat} {use : U → Nat} {favours : R → Prop} {w₀ : List U} {g₀ : R} {z₀ : Nat},
  (∀ (g : R), ¬favours g → ∀ (u : U), Becoming.LineOnAStock.taken use (kids g u) = use u) →
    ∀ (k : Nat),
