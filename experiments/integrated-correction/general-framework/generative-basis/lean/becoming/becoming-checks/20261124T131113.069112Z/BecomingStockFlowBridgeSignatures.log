        ((Becoming.WayUnderARule.course need kids next giving use s N).snd +
            Becoming.total (Becoming.steps 0 N) fun t =>
              Becoming.LineOnAStock.taken use (Becoming.WayUnderARule.course need kids next giving use s t).fst.fst) =
          s.snd +
            Becoming.total (Becoming.steps 0 N) fun t =>
              giving
                ((Becoming.WayUnderARule.course need kids next giving use s t).snd -
                  Becoming.LineOnAStock.taken use (Becoming.WayUnderARule.course need kids next giving use s t).fst.fst)
@Becoming.StockFlowBridge.way_account_unending : ∀ {U R : Type} {need : U → Nat} {kids : R → U → List U}
  {next : List U → R → R} {giving : Nat → Nat} {use : U → Nat} {s : (List U × R) × Nat},
  Becoming.RegimeMargin.FromNothing giving →
    Becoming.WayUnderARule.Needing need kids s.fst.fst →
      Becoming.«不穷» (Becoming.WayUnderARule.net need kids next giving use) Becoming.«一» s →
        ∀ (N : Nat),
          ((Becoming.WayUnderARule.course need kids next giving use s N).snd +
              Becoming.total (Becoming.steps 0 N) fun t =>
                Becoming.LineOnAStock.taken use (Becoming.WayUnderARule.course need kids next giving use s t).fst.fst) =
            s.snd +
              Becoming.total (Becoming.steps 0 N) fun t =>
                giving
                  ((Becoming.WayUnderARule.course need kids next giving use s t).snd -
                    Becoming.LineOnAStock.taken use
                      (Becoming.WayUnderARule.course need kids next giving use s t).fst.fst)
@Becoming.StockFlowBridge.way_never_returns_below_within_of_within : ∀ {U R : Type} {need : U → Nat}
  {kids : R → U → List U} {next : List U → R → R} {giving : Nat → Nat} {use : U → Nat} {s : (List U × R) × Nat}
  {m T N : Nat},
  (∀ (t : Nat),
      T ≤ t →
        t < T + N →
          Becoming.LineOnAStock.taken use (Becoming.WayUnderARule.course need kids next giving use s t).fst.fst ≤
            (Becoming.WayUnderARule.course need kids next giving use s t).snd) →
    (∀ (t : Nat),
        T ≤ t →
          t < T + N →
            (Becoming.StockFlowBridge.wayWeb need kids next giving use s).level t () < m →
              (Becoming.StockFlowBridge.wayFlow need kids next giving use s).given t () ≤
                (Becoming.StockFlowBridge.wayFlow need kids next giving use s).taken t ()) →
      (Becoming.StockFlowBridge.wayWeb need kids next giving use s).level T () < m →
        ∀ (n : Nat), n ≤ N → (Becoming.StockFlowBridge.wayWeb need kids next giving use s).level (T + n) () < m
@Becoming.StockFlowBridge.way_never_returns_below_within : ∀ {U R : Type} {need : U → Nat} {kids : R → U → List U}
  {next : List U → R → R} {giving : Nat → Nat} {use : U → Nat} {s : (List U × R) × Nat} {m T N : Nat},
  Becoming.RegimeMargin.FromNothing giving →
    Becoming.WayUnderARule.Needing need kids s.fst.fst →
      (∀ (t : Nat),
          T ≤ t →
            t ≤ T + N →
              Becoming.WayUnderARule.Goes need (Becoming.WayUnderARule.course need kids next giving use s t)) →
        (∀ (t : Nat),
            T ≤ t →
              t < T + N →
                (Becoming.StockFlowBridge.wayWeb need kids next giving use s).level t () < m →
                  (Becoming.StockFlowBridge.wayFlow need kids next giving use s).given t () ≤
                    (Becoming.StockFlowBridge.wayFlow need kids next giving use s).taken t ()) →
          (Becoming.StockFlowBridge.wayWeb need kids next giving use s).level T () < m →
            ∀ (n : Nat), n ≤ N → (Becoming.StockFlowBridge.wayWeb need kids next giving use s).level (T + n) () < m
@Becoming.StockFlowBridge.line_replenishes_of_draws : ∀ {U : Type} {need : U → Nat} {kids : U → List U}
  {giving : Nat → Nat} {use : U → Nat} {s : List U × Nat},
  Becoming.RegimeMargin.FromNothing giving →
    Becoming.LineOnAStock.Needing need kids s.fst →
      Becoming.«不穷» (Becoming.LineOnAStock.net need kids giving use) Becoming.«一» s →
        (∀ (N : Nat),
