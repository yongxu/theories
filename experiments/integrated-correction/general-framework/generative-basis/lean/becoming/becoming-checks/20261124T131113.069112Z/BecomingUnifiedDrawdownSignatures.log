                Becoming.UnifiedDrawdown.CadenceErasureWitness.need Becoming.UnifiedDrawdown.CadenceErasureWitness.kids
                Becoming.UnifiedDrawdown.CadenceErasureWitness.giving Becoming.UnifiedDrawdown.CadenceErasureWitness.use
                Becoming.UnifiedDrawdown.CadenceErasureWitness.h
                Becoming.UnifiedDrawdown.CadenceErasureWitness.readsFine
                Becoming.UnifiedDrawdown.CadenceErasureWitness.startConfig t).fst.snd) ∧
      (Becoming.PacedStock.pacedCourse Becoming.UnifiedDrawdown.CadenceErasureWitness.fA
                  Becoming.UnifiedDrawdown.CadenceErasureWitness.need
                  Becoming.UnifiedDrawdown.CadenceErasureWitness.kids
                  Becoming.UnifiedDrawdown.CadenceErasureWitness.giving
                  Becoming.UnifiedDrawdown.CadenceErasureWitness.use Becoming.UnifiedDrawdown.CadenceErasureWitness.h
                  Becoming.UnifiedDrawdown.CadenceErasureWitness.readsCoarse
                  Becoming.UnifiedDrawdown.CadenceErasureWitness.startConfig 6).fst.snd.snd =
          0 ∧
        ¬Becoming.LineOnAStock.Goes Becoming.UnifiedDrawdown.CadenceErasureWitness.need
            (Becoming.PacedStock.pacedCourse Becoming.UnifiedDrawdown.CadenceErasureWitness.fA
