          Becoming.UnifiedDrawdown.CadenceErasureWitness.giving Becoming.UnifiedDrawdown.CadenceErasureWitness.use
          Becoming.UnifiedDrawdown.CadenceErasureWitness.h Becoming.UnifiedDrawdown.CadenceErasureWitness.readsCoarse
          Becoming.UnifiedDrawdown.CadenceErasureWitness.startConfig t).snd =
      false
Becoming.UnifiedDrawdown.CadenceErasureWitness.witness_bundle : Becoming.UnifiedDrawdown.ReadsAt Becoming.Strobe.twice
    Becoming.UnifiedDrawdown.CadenceErasureWitness.readsCoarse ∧
  Becoming.PacedStock.ReadAtSpanEnd Becoming.UnifiedDrawdown.sigmaOdd
      Becoming.UnifiedDrawdown.CadenceErasureWitness.readsCoarse ∧
    (∀ (t : Nat),
        Becoming.LineOnAStock.Goes Becoming.UnifiedDrawdown.CadenceErasureWitness.need
