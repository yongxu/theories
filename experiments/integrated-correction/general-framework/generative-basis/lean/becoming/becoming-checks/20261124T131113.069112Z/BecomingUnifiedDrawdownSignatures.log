@Becoming.UnifiedDrawdown.sampled_break_concealment : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop}
  {g f_dep : F} {c : C} {σ : Nat → Nat},
  Becoming.Strict σ →
    ∀ {j J m : Nat} {l_break l_safe : Nat → C → Nat},
      (∀ (t : Nat), W.need t f_dep c = m) →
        (∀ (t : Nat), m ≤ l_safe t c) →
          σ j + 2 ≤ σ (j + 1) →
            W.requires (σ j) f_dep c ∧ m ≤ l_break (σ j) c ∧ l_break (σ j + 1) c < m →
              m ≤ l_break (σ (j + 1)) c →
                (∀ (s : Nat), s ≤ J → W.AlikeThrough obs g l_break l_safe (σ s)) →
                  (σ j < σ j + 1 ∧ σ j + 1 < σ (j + 1)) ∧
                    (W.withLevel l_break).Broken (σ j) f_dep c ∧
                      (∀ (t : Nat), ¬(W.withLevel l_safe).Broken t f_dep c) ∧
                        ¬((W.withLevel l_break).sample σ).Broken j f_dep c ∧
                          ∀ (select : (Nat → C → Nat) → Prop),
                            (W.sample σ).SelectsThrough obs g J select →
                              (select (Becoming.atTimes σ l_break) ↔ select (Becoming.atTimes σ l_safe))
