  {kids : R → U → List U} {giving : Nat → Nat} {use : U → Nat} {Y H_bad H_min y₂ L : Nat} {r_bad : R} {a₀ : A}
  {w₀ : List U} {x₀ : Nat},
  Becoming.RegimeMargin.FromNothing giving →
