@Becoming.UnifiedDrawdown.sampled_deadline_impossibility : ∀ {A U R F C : Type} {fA : A → R → A} {need : U → Nat}
  {kids : R → U → List U} {giving : Nat → Nat} {use : U → Nat} {σ : Nat → Nat},
  Becoming.Strict σ →
    σ 0 = 0 →
      ∀ {δ Y H_bad H_min y₂ : Nat} {r_bad : R} {a₀ : A} {w₀ : List U} {x₀ : Nat},
        Becoming.RegimeMargin.FromNothing giving →
          Becoming.RegimeMargin.AtMost giving Y →
            Y < H_bad →
              H_bad ≤ H_min + y₂ →
                Becoming.RegimeMargin.Short giving H_min y₂ →
                  (∀ (u : U), 0 < need u ∧ need u ≤ H_min + y₂) →
                    (∀ (w : List U), w ≠ [] → H_min ≤ Becoming.LineOnAStock.taken use w) →
                      x₀ < H_min + y₂ + (H_bad - Y) * (σ 1 - σ 0 + δ) →
                        ∀ {W : Becoming.Web F C} {group : F → Prop} {feasible keeps : (Nat → C → Nat) → Prop}
                          {l_bad l_safe : Nat → C → Nat} {N_ret : Nat},
                          Becoming.NoReturnAt feasible keeps l_bad N_ret →
                            have L := σ 1 - σ 0;
                            have c₀ := ((a₀, w₀, x₀), r_bad);
                            (∀ (reads : Nat → Bool) (h : Becoming.PacedStock.StockState A U → R → R),
                                Becoming.UnifiedDrawdown.PacedLowerDrawWhileMet H_bad fA need kids giving use h reads c₀
                                    0 (L + δ) →
                                  ((∀ (t : Nat),
                                        t < L + δ →
                                          Becoming.LineOnAStock.Goes need
                                            (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀
                                                  t).fst.snd) →
                                      (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀
                                                (L + δ)).fst.snd.snd <
                                        H_min + y₂) ∧
                                    ∃ t,
                                      ¬Becoming.LineOnAStock.Goes need
                                          (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀
                                                t).fst.snd) ∧
                              (∀ (j : Nat) (reads : Nat → Bool) (h : Becoming.PacedStock.StockState A U → R → R),
                                  have L_j := σ (j + 1) - σ j;
                                  Becoming.UnifiedDrawdown.PacedLowerDrawWhileMet H_bad fA need kids giving use h reads
                                      c₀ (σ j) (L_j + δ) →
                                    (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀
                                                (σ j)).fst.snd.snd <
                                        H_min + y₂ + (H_bad - Y) * (L_j + δ) →
                                      ((∀ (t : Nat),
                                            σ j ≤ t →
                                              t < σ j + (L_j + δ) →
                                                Becoming.LineOnAStock.Goes need
                                                  (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀
                                                        t).fst.snd) →
                                          (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀
                                                    (σ j + (L_j + δ))).fst.snd.snd <
                                            H_min + y₂) ∧
                                        ∃ t,
                                          ¬Becoming.LineOnAStock.Goes need
                                              (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀
                                                    t).fst.snd) ∧
                                (N_ret ≤ L + δ → ¬Becoming.Recoverable feasible keeps l_bad (L + δ)) ∧
                                  (N_ret ≤ σ 1 →
                                    ¬Becoming.Recoverable feasible keeps l_bad (σ 1) ∧
                                      ((∀ (g : F),
                                          group g →
                                            ∀ (t : Nat), t ≤ σ 1 → (W.Admits (l_bad t) t g ↔ W.Admits (l_safe t) t g)) →
                                        ¬W.ReadableInTime group feasible keeps l_bad l_safe ∧
                                          ∀ (sel : Nat → (Nat → C → Nat) → Prop),
                                            (∀ (s : Nat), W.SelectsThroughAll Becoming.thresholdOnly group s (sel s)) →
                                              ¬Becoming.Web.ReadsInTime sel feasible keeps l_bad l_safe))
@Becoming.UnifiedDrawdown.unrecoverable_cadence_bridge : ∀ {A U R O F C : Type} {fA : A → R → A} {need : U → Nat}
  {kids : R → U → List U} {giving : Nat → Nat} {use : U → Nat} {N Y H_bad H_min y₂ : Nat} {x_o y_o : O},
  2 ≤ N →
    x_o ≠ y_o →
      Becoming.RegimeMargin.FromNothing giving →
        Becoming.RegimeMargin.AtMost giving Y →
          Y < H_bad →
            H_bad ≤ H_min + y₂ →
              Becoming.RegimeMargin.Short giving H_min y₂ →
                (∀ (u : U), 0 < need u ∧ need u ≤ H_min + y₂) →
                  ∀ {r_bad : R} {w₀ : List U} {x₀ : Nat},
                    Becoming.PacedStock.LowerDrawWhileMet H_bad need kids giving use r_bad w₀ x₀ (2 * N - 1) →
                      (∀ (w : List U), w ≠ [] → H_min ≤ Becoming.LineOnAStock.taken use w) →
                        x₀ < H_min + y₂ + (H_bad - Y) * (2 * N - 1) →
                          (∀ (L : Nat), L < 2 * N - 1 → ¬Becoming.Pace.StretchFixes O N L) ∧
                            (∀ (L : Nat) (σ : Nat → Nat) (reads : Nat → Bool)
                                (h : Becoming.PacedStock.StockState A U → R → R) (a₀ : A),
                                2 * N - 1 ≤ L →
                                  σ 0 = 0 →
                                    σ 1 = L →
                                      Becoming.Strict σ →
                                        Becoming.PacedStock.ReadAtSpanEnd σ reads →
                                          have c₀ := ((a₀, w₀, x₀), r_bad);
                                          ((∀ (t : Nat),
                                                t < L →
                                                  Becoming.LineOnAStock.Goes need
                                                    (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀
                                                          t).fst.snd) →
                                              (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀
                                                        L).fst.snd.snd <
                                                H_min + y₂) ∧
                                            ∃ t,
                                              ¬Becoming.LineOnAStock.Goes need
                                                  (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀
                                                        t).fst.snd) ∧
                              ∀ (L δ N_ret : Nat) {feasible keeps : (Nat → C → Nat) → Prop} {l_bad : Nat → C → Nat}
                                {W : Becoming.Web F C} {group : F → Prop} {l_safe : Nat → C → Nat},
                                Becoming.NoReturnAt feasible keeps l_bad N_ret →
                                  N_ret ≤ L + δ →
                                    ¬Becoming.Recoverable feasible keeps l_bad (L + δ) ∧
                                      (N_ret ≤ L →
                                        (∀ (g : F),
                                            group g →
                                              ∀ (t : Nat), t ≤ L → (W.Admits (l_bad t) t g ↔ W.Admits (l_safe t) t g)) →
                                          ¬W.ReadableInTime group feasible keeps l_bad l_safe)
