@Becoming.Flow.deficit_lowers_at : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {ds : List C}
  {t d : Nat}, L.BalancesOn W ds t → L.replenishment ds t + d ≤ L.uptake ds t → W.stock ds (t + 1) + d ≤ W.stock ds t
@Becoming.Flow.deficit_bounded_prefix : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {ds : List C}
  {T d : Nat} (n : Nat),
  (∀ (k : Nat), k < n → L.BalancesOn W ds (T + k)) →
    (∀ (k : Nat), k < n → L.replenishment ds (T + k) + d ≤ L.uptake ds (T + k)) →
      W.stock ds (T + n) + n * d ≤ W.stock ds T
@Becoming.Flow.deficit_bounded_within : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {ds : List C}
  {T n d : Nat},
  (∀ (k : Nat), k < n → L.BalancesOn W ds (T + k)) →
    (∀ (k : Nat), k < n → L.replenishment ds (T + k) + d ≤ L.uptake ds (T + k)) →
      W.stock ds (T + n) + n * d ≤ W.stock ds T ∧
        ∀ (j₁ j₂ : Nat), j₁ ≤ j₂ → j₂ ≤ n → W.stock ds (T + j₂) + (j₂ - j₁) * d ≤ W.stock ds (T + j₁)
@Becoming.Flow.below_of_deficit_within : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {ds : List C}
  {m T n d : Nat},
  (∀ (k : Nat), k < n → L.BalancesOn W ds (T + k)) →
    (∀ (k : Nat), k < n → L.replenishment ds (T + k) + d ≤ L.uptake ds (T + k)) →
      W.stock ds T < n * d + m → W.stock ds (T + n) < m
@Becoming.Flow.below_of_excess_within : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {ds : List C}
  {m T n : Nat},
  (∀ (k : Nat), k < n → L.BalancesOn W ds (T + k)) →
    (∀ (k : Nat), k < n → L.replenishment ds (T + k) < L.uptake ds (T + k)) →
      W.stock ds T < n + m → W.stock ds (T + n) < m
@Becoming.Flow.family_deficit_ends_within : ∀ {F C : Type} {L : Becoming.Flow F C} {W : Becoming.Web F C} {ds : List C}
  {m T n k d : Nat} {g : F} {e : C},
  (∀ (j : Nat), j < n + k → L.BalancesOn W ds (T + j)) →
    (∀ (j : Nat) (f : F),
        j < n + k →
          f ∈ L.present (T + j) →
            ∀ (d' : C),
              d' ∈ ds → 0 < L.give (T + j) f d' → ∃ e', e' ∈ ds ∧ W.requires (T + j) f e' ∧ m ≤ W.need (T + j) f e') →
      (∀ (j : Nat), j < n + k → ∀ (d' : C), d' ∈ ds → L.GiversSupported W (T + j) d') →
        (∀ (j : Nat), j < n → L.replenishment ds (T + j) + d ≤ L.uptake ds (T + j)) →
          W.stock ds T < n * d + m →
            (W.active (T + n + k) g → W.Supported (T + n + k) g) →
              e ∈ ds → W.requires (T + n + k) g e → m ≤ W.need (T + n + k) g e → ¬W.active (T + n + k) g
@Becoming.Flow.held_excess_ends_within : ∀ {F C : Type} [DecidableEq F] {L : Becoming.Flow F C} {W : Becoming.Web F C}
  {c : C} {m T n k d : Nat} {g : F},
  0 < d →
    ∀ {holders : F → Bool} {fam : F → List C} {lose : Nat → F → Nat},
      (∀ (j : Nat), j < n + k → L.BalancesOn W [c] (T + j)) →
        (∀ (j : Nat), j < n → ∀ (h : F), h ∈ L.present (T + j) → holders h = true → L.BalancesOn W (fam h) (T + j)) →
          (∀ (j : Nat) (f : F),
              j < n + k →
                f ∈ L.present (T + j) → 0 < L.give (T + j) f c → W.requires (T + j) f c ∧ m ≤ W.need (T + j) f c) →
            (∀ (j : Nat), j < n + k → L.GiversSupported W (T + j) c) →
              (∀ (j : Nat), j < n → Becoming.Distinct (L.present (T + j))) →
                (∀ (j : Nat),
                    j < n →
                      ∀ (h : F),
                        h ∈ L.present (T + j) →
                          holders h = true →
                            ∀ (q : F),
                              q ∈ L.present (T + j) →
                                ¬q = h → ∀ (x : C), x ∈ fam h → L.take (T + j) q x = 0 ∧ L.give (T + j) q x = 0) →
                  (∀ (j : Nat),
                      j < n →
                        ∀ (h : F),
                          h ∈ L.present (T + j) →
                            holders h = true → W.stock (fam h) (T + j + 1) = W.stock (fam h) (T + j)) →
                    (∀ (j : Nat),
                        j < n →
                          ∀ (h : F),
                            h ∈ L.present (T + j) →
                              holders h = true →
                                lose (T + j) h + Becoming.total (fam h) (L.give (T + j) h) + L.give (T + j) h c ≤
                                  Becoming.total (fam h) (L.take (T + j) h) + L.take (T + j) h c) →
                      (∀ (j : Nat),
                          j < n →
                            L.restGiven holders (T + j) c + d ≤
                              Becoming.total (L.present (T + j)) fun h => bif holders h then lose (T + j) h else 0) →
                        W.level T c < n * d + m →
                          (W.active (T + n + k) g → W.Supported (T + n + k) g) →
                            W.requires (T + n + k) g c →
                              m ≤ W.need (T + n + k) g c →
                                ∀ {obs : F → C → Prop},
                                  (∀ (h : F) (x : C), holders h = true → W.CoupledInto obs h x → x ∈ fam h) →
                                    (∀ (h : F), holders h = true → ¬c ∈ fam h) →
                                      ¬W.active (T + n + k) g ∧
                                        W.level (T + n) c < m ∧
                                          (∀ (j₁ j₂ : Nat),
                                              j₁ ≤ j₂ →
                                                j₂ ≤ n → W.level (T + j₂) c + (j₂ - j₁) * d ≤ W.level (T + j₁) c) ∧
                                            (∀ (j₁ j₂ : Nat),
                                                j₁ < j₂ → j₂ ≤ n → W.level (T + j₂) c < W.level (T + j₁) c) ∧
                                              ∀ (h : F), holders h = true → ¬W.CoupledInto obs h c
@Becoming.UnifiedDrawdown.mem_eraseOne_of_ne : ∀ {F : Type} [inst : DecidableEq F] {a x : F},
  a ≠ x → ∀ {l : List F}, a ∈ l → a ∈ Becoming.UnifiedDrawdown.eraseOne x l
@Becoming.UnifiedDrawdown.total_eraseOne : ∀ {F : Type} [inst : DecidableEq F] (q : F → Nat) {x : F} {l : List F},
  x ∈ l → Becoming.total (Becoming.UnifiedDrawdown.eraseOne x l) q + q x = Becoming.total l q
@Becoming.UnifiedDrawdown.total_map_le : ∀ {α F : Type} [DecidableEq F] {agents : List α},
  Becoming.Distinct agents →
    ∀ {P : List F} {toF : α → F},
      (∀ (i j : α), i ∈ agents → j ∈ agents → toF i = toF j → i = j) →
        (∀ (i : α), i ∈ agents → toF i ∈ P) →
          ∀ (q : F → Nat), (Becoming.total agents fun i => q (toF i)) ≤ Becoming.total P q
@Becoming.UnifiedDrawdown.total_only_eq : ∀ {α : Type} [DecidableEq α] {q : α → Nat} {a : α} {l : List α},
  Becoming.Distinct l → a ∈ l → (∀ (b : α), b ∈ l → ¬b = a → q b = 0) → Becoming.total l q = q a
@Becoming.UnifiedDrawdown.lookupBy_eq_of_mem : ∀ {α F : Type} [inst : DecidableEq F] {toF : α → F} (val : α → Nat)
  {agents : List α},
  (∀ (i j : α), i ∈ agents → j ∈ agents → toF i = toF j → i = j) →
    ∀ {i : α}, i ∈ agents → Becoming.UnifiedDrawdown.lookupBy toF val agents (toF i) = val i
@Becoming.UnifiedDrawdown.sumDraws_eq_total : ∀ {α : Type} (agents : List α) (f : α → Nat),
  Becoming.AdaptiveLoops.sumDraws agents (fun i x => f i) () = Becoming.total agents f
@Becoming.UnifiedDrawdown.holdersOf_true_iff : ∀ {α F : Type} [inst : DecidableEq F] {agents : List α} {toF : α → F}
  {f : F}, Becoming.UnifiedDrawdown.holdersOf agents toF f = true ↔ ∃ i, i ∈ agents ∧ toF i = f
@Becoming.UnifiedDrawdown.holdersOf_mem : ∀ {α F : Type} [inst : DecidableEq F] {agents : List α} {toF : α → F} {i : α},
  i ∈ agents → Becoming.UnifiedDrawdown.holdersOf agents toF (toF i) = true
@Becoming.UnifiedDrawdown.dec_all_or_exists : ∀ {P : Nat → Prop},
  (∀ (t : Nat), P t ∨ ¬P t) → ∀ (n : Nat), (∀ (t : Nat), t < n → P t) ∨ ∃ t, t < n ∧ ¬P t
@Becoming.UnifiedDrawdown.parametric_local_accounts_depletion : ∀ {α F C : Type} [inst : DecidableEq F]
  {L : Becoming.Flow F C} {W : Becoming.Web F C} {obs : F → C → Prop} {agents : List α},
  Becoming.Distinct agents →
    ∀ (toF : α → F),
      (∀ (i j : α), i ∈ agents → j ∈ agents → toF i = toF j → i = j) →
        ∀ (fam : α → List C) (cSub : C) (lose : α → Nat)
          (model : α → Becoming.FreeEnergyGuarantees.RiskAndNeeds.Chooser Nat) {n k m d : Nat} {g : F},
          0 < d →
            (∀ (t : Nat), t < n → ∀ (i : α), i ∈ agents → toF i ∈ L.present t) →
              (∀ (t : Nat), t < n → Becoming.Distinct (L.present t)) →
                (∀ (j : Nat), j < n + k → L.BalancesOn W [cSub] j) →
                  (∀ (t : Nat), t < n → ∀ (i : α), i ∈ agents → L.BalancesOn W (fam i) t) →
                    (∀ (j : Nat) (f : F),
                        j < n + k → f ∈ L.present j → 0 < L.give j f cSub → W.requires j f cSub ∧ m ≤ W.need j f cSub) →
                      (∀ (j : Nat), j < n + k → L.GiversSupported W j cSub) →
                        (∀ (t : Nat),
                            t < n →
                              ∀ (i : α),
                                i ∈ agents →
                                  ∀ (q : F),
                                    q ∈ L.present t →
                                      ¬q = toF i → ∀ (x : C), x ∈ fam i → L.take t q x = 0 ∧ L.give t q x = 0) →
                          (∀ (t : Nat), t < n → ∀ (i : α), i ∈ agents → W.stock (fam i) (t + 1) = W.stock (fam i) t) →
                            (∀ (t : Nat), t < n → ∀ (i : α), i ∈ agents → L.give t (toF i) cSub = 0) →
                              (∀ (t : Nat),
                                  t < n →
                                    ∀ (i : α),
                                      i ∈ agents →
                                        lose i + Becoming.total (fam i) (L.give t (toF i)) + L.give t (toF i) cSub =
                                          Becoming.total (fam i) (L.take t (toF i)) + L.take t (toF i) cSub) →
                                (∀ (i : α) (s a : Nat), (model i).predict s a = s + a - lose i) →
                                  (∀ (t : Nat),
                                      t < n →
                                        ∀ (i : α),
                                          i ∈ agents → L.take t (toF i) cSub = (model i).chosen (W.stock (fam i) t)) →
                                    (∀ (t : Nat),
                                        t < n → ∀ (i : α), i ∈ agents → (model i).preferred = W.stock (fam i) t) →
                                      (∀ (i : α), i ∈ agents → lose i = (model i).first ∨ lose i ∈ (model i).others) →
                                        (∀ (t : Nat),
                                            t < n → ∀ (i : α), i ∈ agents → L.take t (toF i) cSub ≤ L.given t cSub) →
                                          (∀ (t : Nat),
                                              t < n →
                                                ∀ (q : F),
                                                  q ∈ L.present t →
                                                    (∀ (i : α), i ∈ agents → q ≠ toF i) →
                                                      L.take t q cSub ≤ L.given t cSub) →
                                            (∀ (t : Nat),
                                                t < n →
                                                  L.restGiven (Becoming.UnifiedDrawdown.holdersOf agents toF) t cSub +
                                                      d ≤
                                                    Becoming.AdaptiveLoops.sumDraws agents (fun i x => lose i) ()) →
                                              W.level 0 cSub < n * d + m →
                                                (W.active (n + k) g → W.Supported (n + k) g) →
                                                  W.requires (n + k) g cSub →
                                                    m ≤ W.need (n + k) g cSub →
                                                      (∀ (i : α) (x : C),
                                                          i ∈ agents → W.CoupledInto obs (toF i) x → x ∈ fam i) →
                                                        (∀ (i : α), i ∈ agents → ¬cSub ∈ fam i) →
                                                          (∀ (t : Nat),
                                                              t < n →
                                                                ∀ (i : α),
                                                                  i ∈ agents →
                                                                    W.stock (fam i) (t + 1) =
                                                                        W.stock (fam i) t + L.take t (toF i) cSub -
                                                                          lose i ∧
                                                                      L.take t (toF i) cSub = lose i ∧
                                                                        Becoming.UnifiedDrawdown.localError (model i)
                                                                              (fun u => W.stock (fam i) u)
                                                                              (fun u => L.take u (toF i) cSub) t =
                                                                            0 ∧
                                                                          (model i).risk (W.stock (fam i) t)
                                                                              (L.take t (toF i) cSub) =
                                                                            0) ∧
                                                            (∀ (t : Nat),
                                                                t < n → L.WithinOwn t cSub ∧ ¬L.WithinJoint t cSub) ∧
                                                              (∀ (i : α),
                                                                  i ∈ agents → ¬W.CoupledInto obs (toF i) cSub) ∧
                                                                (∀ (l_safe : Nat → C → Nat),
                                                                    (∀ (s : Nat),
                                                                        s ≤ n →
                                                                          ∀ (i : α),
                                                                            i ∈ agents →
                                                                              ∀ (x : C),
                                                                                x ∈ fam i → l_safe s x = W.level s x) →
                                                                      W.AlikeThroughAll obs
                                                                          (fun f =>
                                                                            Becoming.UnifiedDrawdown.holdersOf agents
                                                                                toF f =
                                                                              true)
                                                                          W.level l_safe n ∧
                                                                        ∀ (select : (Nat → C → Nat) → Prop),
                                                                          W.SelectsThroughAll obs
                                                                              (fun f =>
                                                                                Becoming.UnifiedDrawdown.holdersOf
                                                                                    agents toF f =
                                                                                  true)
                                                                              n select →
                                                                            (select W.level ↔ select l_safe)) ∧
                                                                  W.level n cSub < m ∧
                                                                    (∀ (t₁ t₂ : Nat),
                                                                        t₁ ≤ t₂ →
                                                                          t₂ ≤ n →
                                                                            W.level t₂ cSub + (t₂ - t₁) * d ≤
                                                                              W.level t₁ cSub) ∧
                                                                      (∀ (t₁ t₂ : Nat),
                                                                          t₁ < t₂ →
                                                                            t₂ ≤ n →
                                                                              W.level t₂ cSub < W.level t₁ cSub) ∧
                                                                        ¬W.active (n + k) g
Becoming.UnifiedDrawdown.heldPair_as_parametric_instance : (∀ (t : Nat),
    t < 2 →
      Becoming.Optimum.HeldPair.flow.WithinOwn t Becoming.Optimum.HeldPair.Spot.pool ∧
        ¬Becoming.Optimum.HeldPair.flow.WithinJoint t Becoming.Optimum.HeldPair.Spot.pool ∧
          Becoming.UnifiedDrawdown.localError Becoming.FreeEnergyGuarantees.SharedModels.holder
                (fun u =>
                  Becoming.Optimum.HeldPair.web.stock (Becoming.Optimum.HeldPair.store Becoming.Witnesses.Member.first)
                    u)
                (fun u =>
                  Becoming.Optimum.HeldPair.flow.take u Becoming.Witnesses.Member.first
                    Becoming.Optimum.HeldPair.Spot.pool)
                t =
              0 ∧
            Becoming.UnifiedDrawdown.localError Becoming.FreeEnergyGuarantees.SharedModels.holder
                  (fun u =>
                    Becoming.Optimum.HeldPair.web.stock
                      (Becoming.Optimum.HeldPair.store Becoming.Witnesses.Member.second) u)
                  (fun u =>
                    Becoming.Optimum.HeldPair.flow.take u Becoming.Witnesses.Member.second
                      Becoming.Optimum.HeldPair.Spot.pool)
                  t =
                0 ∧
              Becoming.FreeEnergyGuarantees.SharedModels.holder.risk
                    (Becoming.Optimum.HeldPair.web.stock
                      (Becoming.Optimum.HeldPair.store Becoming.Witnesses.Member.first) t)
                    (Becoming.Optimum.HeldPair.flow.take t Becoming.Witnesses.Member.first
                      Becoming.Optimum.HeldPair.Spot.pool) =
                  0 ∧
                Becoming.FreeEnergyGuarantees.SharedModels.holder.risk
                    (Becoming.Optimum.HeldPair.web.stock
                      (Becoming.Optimum.HeldPair.store Becoming.Witnesses.Member.second) t)
                    (Becoming.Optimum.HeldPair.flow.take t Becoming.Witnesses.Member.second
                      Becoming.Optimum.HeldPair.Spot.pool) =
                  0) ∧
  (∀ (k : Nat) (g : Becoming.Optimum.HeldPair.Member),
      Becoming.Optimum.HeldPair.web.requires (0 + 2 + k) g Becoming.Optimum.HeldPair.Spot.pool →
        1 ≤ Becoming.Optimum.HeldPair.web.need (0 + 2 + k) g Becoming.Optimum.HeldPair.Spot.pool →
          ¬Becoming.Optimum.HeldPair.web.active (0 + 2 + k) g) ∧
    ∀ (h : Becoming.Optimum.HeldPair.Member),
      Becoming.Optimum.HeldPair.holders h = true →
        ¬Becoming.Optimum.HeldPair.web.CoupledInto Becoming.Optimum.HeldPair.observes h
            Becoming.Optimum.HeldPair.Spot.pool
@Becoming.UnifiedDrawdown.firstApart_of_monitor : ∀ {F C : Type} {W : Becoming.Web F C} {group : F → Prop}
  {l_drain l_safe : Nat → C → Nat} {mon : F} {T_warn : Nat},
  group mon →
    ¬(W.Admits (l_drain T_warn) T_warn mon ↔ W.Admits (l_safe T_warn) T_warn mon) →
      (∀ (g : F), group g → ∀ (t : Nat), t < T_warn → (W.Admits (l_drain t) t g ↔ W.Admits (l_safe t) t g)) →
        W.FirstApart group l_drain l_safe T_warn
@Becoming.UnifiedDrawdown.pooled_detects_before_collapse : ∀ {F C : Type} {W : Becoming.Web F C}
  {obs pooledObs : F → C → Prop} {isAgent pooledGroup : F → Prop} {feasible keeps : (Nat → C → Nat) → Prop}
  {l_drain l_safe : Nat → C → Nat} {N_ret T_warn : Nat} {mon : F},
  Becoming.NoReturnAt feasible keeps l_drain N_ret →
    W.AlikeThroughAll obs isAgent l_drain l_safe N_ret →
      T_warn < N_ret →
        pooledGroup mon →
          ¬W.AlikeThroughUpTo pooledObs mon l_drain l_safe T_warn →
            W.FirstApart pooledGroup l_drain l_safe T_warn →
              (¬W.ReadableInTime isAgent feasible keeps l_drain l_safe ∧
                  (∀ (sel : Nat → (Nat → C → Nat) → Prop),
                      (∀ (s : Nat), W.SelectsThroughAll Becoming.thresholdOnly isAgent s (sel s)) →
                        ¬Becoming.Web.ReadsInTime sel feasible keeps l_drain l_safe) ∧
                    ∀ (select : (Nat → C → Nat) → Prop),
                      W.SelectsThroughAll obs isAgent N_ret select → (select l_drain ↔ select l_safe)) ∧
                (∃ select,
                    W.SelectsThrough pooledObs mon T_warn select ∧
                      W.SelectsThroughAll pooledObs pooledGroup T_warn select ∧ select l_drain ∧ ¬select l_safe) ∧
                  W.ReadableInTime pooledGroup feasible keeps l_drain l_safe ∧
                    Becoming.Recoverable feasible keeps l_drain T_warn
@Becoming.UnifiedDrawdown.pooled_restraint_restores_viability : ∀ {α Env : Type} {S Obs Dist : α → Type}
  (agents : List α) (L : (i : α) → Becoming.AdaptiveLoops.OpenLoop (S i) (Obs i) (Dist i) Unit) (init : (i : α) → S i)
  (certs : (i : α) → Becoming.AdaptiveLoops.LoopCertificate (L i) (init i)) (obs : (i : α) → (Unit → Nat) → Obs i)
  (channel : (α → Bool) → (α → Nat) → Env → Bool) (G : Unit → (Unit → Nat) → Nat) (envDraw : Env → Unit → Nat)
  (envCap : Unit → Nat) (jointAdm : Env → Prop),
  (∀ (env : Env), jointAdm env → ∀ (j : Unit), envDraw env j ≤ envCap j) →
    ∀ (x_crit warnLevel H_safe x₀ : Unit → Nat) (monitored : α → Unit → Prop),
      (∀ (i : α),
          i ∈ agents → ∀ (x : Unit → Nat) (j : Unit), monitored i j → x j < warnLevel j → (certs i).warnObs (obs i x)) →
        (∃ i, i ∈ agents ∧ monitored i ()) →
          (∀ (emit : α → Bool) (load : α → Nat) (env : Env),
              jointAdm env →
                (∃ i, i ∈ agents ∧ emit i = true ∧ load i ≤ (certs i).maxSilence) →
                  (∀ (i : α), i ∈ agents → load i ≤ (certs i).maxSilence) → channel emit load env = true) →
            Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole (G ()) →
              x_crit () ≤
                  Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G H_safe x_crit () →
                Becoming.AdaptiveLoops.sumDraws agents (fun i => (certs i).postBudget) () + envCap () ≤ H_safe () →
                  x_crit () +
                        (Becoming.AdaptiveLoops.globalMaxLag agents certs + 1) *
                          Becoming.AdaptiveLoops.preTotal agents certs envCap () ≤
                      warnLevel () →
                    x_crit () +
                          Becoming.AdaptiveLoops.maxEta agents certs init *
                            Becoming.AdaptiveLoops.preTotal agents certs envCap () ≤
                        x₀ () →
                      Becoming.AdaptiveLoops.jointInv agents certs envCap x_crit (x₀, init) ∧
                        Becoming.Viability.Certificate
                            (Becoming.AdaptiveLoops.jointProcess agents L certs obs channel G envDraw jointAdm)
                            (Becoming.AdaptiveLoops.jointGuard agents L certs x_crit)
                            (Becoming.AdaptiveLoops.jointInv agents certs envCap x_crit) ∧
                          ∀
                            (r :
                              Becoming.Run
                                (Becoming.AdaptiveLoops.jointProcess agents L certs obs channel G envDraw jointAdm)),
                            r.state 0 = (x₀, init) → ∀ (t : Nat), x_crit () ≤ (r.state t).fst ()
@Becoming.UnifiedDrawdown.restraint_adapter_restores_viability : ∀ {α Env : Type} (agents : List α)
  (specs : α → Becoming.UnifiedDrawdown.RestraintAgentSpec) (channel : (α → Bool) → (α → Nat) → Env → Bool)
  (G : Unit → (Unit → Nat) → Nat) (envDraw : Env → Unit → Nat) (envCap : Unit → Nat) (jointAdm : Env → Prop),
  (∀ (env : Env), jointAdm env → ∀ (j : Unit), envDraw env j ≤ envCap j) →
    ∀ (x_crit warnLevel H_safe x₀ : Nat) (monitored : α → Prop),
      (∃ i, i ∈ agents ∧ monitored i) →
        (∀ (emit : α → Bool) (load : α → Nat) (env : Env),
            jointAdm env →
              (∃ i, i ∈ agents ∧ emit i = true ∧ load i ≤ (specs i).maxSilence) →
                (∀ (i : α), i ∈ agents → load i ≤ (specs i).maxSilence) → channel emit load env = true) →
          Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole (G ()) →
            x_crit ≤
                Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G (fun x => H_safe)
                  (fun x => x_crit) () →
              Becoming.AdaptiveLoops.sumDraws agents (fun i x => (specs i).postCap) () + envCap () ≤ H_safe →
                x_crit +
                      ((Becoming.AdaptiveLoops.foldNatMax agents fun i => (specs i).lag) + 1) *
                        (Becoming.AdaptiveLoops.sumDraws agents (fun i x => (specs i).preCap) () + envCap ()) ≤
                    warnLevel →
                  x_crit +
                        (Becoming.AdaptiveLoops.foldNatMax agents fun i => (specs i).lag) *
                          (Becoming.AdaptiveLoops.sumDraws agents (fun i x => (specs i).preCap) () + envCap ()) ≤
                      x₀ →
                    ∀
                      (r :
                        Becoming.Run
                          (Becoming.AdaptiveLoops.jointProcess agents
                            (fun i => Becoming.UnifiedDrawdown.restraintLoop (specs i) warnLevel)
                            (fun i => Becoming.UnifiedDrawdown.restraintCert (specs i) warnLevel) (fun x x_1 => x_1 ())
                            channel G envDraw jointAdm)),
                      r.state 0 = (fun x => x₀, fun i => (specs i).lag) → ∀ (t : Nat), x_crit ≤ (r.state t).fst ()
