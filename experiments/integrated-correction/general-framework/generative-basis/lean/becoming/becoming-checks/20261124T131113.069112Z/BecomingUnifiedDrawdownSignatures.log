@Becoming.UnifiedDrawdown.pacedCourse_envelope_upper : ∀ {A U R : Type} {fA : A → R → A} {need : U → Nat}
  {kids : R → U → List U} {giving : Nat → Nat} {use : U → Nat} {h : Becoming.PacedStock.StockState A U → R → R}
  {reads : Nat → Bool} {c₀ : Becoming.PacedStock.StockState A U × R} {Y H_bad T N : Nat},
  Becoming.RegimeMargin.AtMost giving Y →
    Becoming.UnifiedDrawdown.PacedLowerDrawWhileMet H_bad fA need kids giving use h reads c₀ T N →
      (∀ (t : Nat),
          T ≤ t →
            t < T + N →
              ∀ (u : U),
                u ∈ (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀ t).fst.snd.fst →
                  need u ≤ (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀ t).fst.snd.snd) →
        ∀ (k : Nat),
          k ≤ N →
            (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀ (T + k)).fst.snd.snd ≤
              Becoming.Law.orbit (Becoming.RegimeMargin.step (fun x => Y) H_bad)
                (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀ T).fst.snd.snd k
