  {kids : R → U → List U} {giving : Nat → Nat} {use : U → Nat} {h : Becoming.PacedStock.StockState A U → R → R}
  {reads : Nat → Bool} (c₀ : Becoming.PacedStock.StockState A U × R) (t : Nat),
  (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀ (t + 1)).fst.snd.snd =
