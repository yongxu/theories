  1 < v →
    ∀ {x : Nat → Nat},
      Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse Becoming.Optimum.Holding.logistic 2 2)
          (Becoming.Optimum.byDrawnLeftAt Becoming.Optimum.Holding.logistic v (n + 1)) x →
        ∀ (σ : Nat → Nat),
          Becoming.Strict σ →
            σ 0 = 0 →
              σ 1 = n + 2 →
                have l_break := Becoming.Optimum.Holding.onSource x;
                have l_safe := Becoming.Optimum.Holding.onSource fun x => 2;
                (σ 0 < 1 ∧ 1 < σ 1) ∧
                  (Becoming.Diversion.web l_break).Broken 0 Becoming.Diversion.Formation.dweller
                      Becoming.Diversion.Place.source ∧
                    (∀ (t : Nat),
                        t < n + 1 →
                          (Becoming.Diversion.web l_break).level (t + 1) Becoming.Diversion.Place.source < 2) ∧
                      (∀ (t : Nat),
                          ¬(Becoming.Diversion.web l_safe).Broken t Becoming.Diversion.Formation.dweller
                              Becoming.Diversion.Place.source) ∧
                        ¬((Becoming.Diversion.web l_break).sample σ).Broken 0 Becoming.Diversion.Formation.dweller
                              Becoming.Diversion.Place.source ∧
                          ∀ (obs : Becoming.Diversion.Formation → Becoming.Diversion.Place → Prop)
                            (g : Becoming.Diversion.Formation) (select : (Nat → Becoming.Diversion.Place → Nat) → Prop),
                            ((Becoming.Diversion.web l_break).sample σ).SelectsThrough obs g 1 select →
                              (select (Becoming.atTimes σ l_break) ↔ select (Becoming.atTimes σ l_safe))
Becoming.UnifiedDrawdown.cyclePair_spec : ∀ (m : Nat),
  0 < m →
    ∀ (t : Nat),
      m * (Becoming.UnifiedDrawdown.cyclePair m t).fst + (Becoming.UnifiedDrawdown.cyclePair m t).snd = t ∧
        (Becoming.UnifiedDrawdown.cyclePair m t).snd < m
@Becoming.UnifiedDrawdown.cycle_euclid_unique : ∀ {m q₁ r₁ q₂ r₂ : Nat},
  r₁ < m → r₂ < m → m * q₁ + r₁ = m * q₂ + r₂ → q₁ = q₂ ∧ r₁ = r₂
Becoming.UnifiedDrawdown.cycleRem_mul_add : ∀ (m q r : Nat), r < m → Becoming.UnifiedDrawdown.cycleRem m (m * q + r) = r
Becoming.UnifiedDrawdown.cycleRem_mul : ∀ (m q : Nat), 0 < m → Becoming.UnifiedDrawdown.cycleRem m (m * q) = 0
@Becoming.UnifiedDrawdown.cycleRem_of_lt : ∀ {m r : Nat}, r < m → Becoming.UnifiedDrawdown.cycleRem m r = r
Becoming.UnifiedDrawdown.cycleRem_self : ∀ (m : Nat), 0 < m → Becoming.UnifiedDrawdown.cycleRem m m = 0
Becoming.UnifiedDrawdown.cyclicCourse_openCourse : ∀ (n v : Nat),
  1 < v →
    ∀ {x : Nat → Nat},
      Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse Becoming.Optimum.Holding.logistic 2 2)
          (Becoming.Optimum.byDrawnLeftAt Becoming.Optimum.Holding.logistic v (n + 1)) x →
        Becoming.Optimum.OpenCourse Becoming.Optimum.Holding.logistic 2 2 (Becoming.UnifiedDrawdown.cyclicCourse x n)
Becoming.UnifiedDrawdown.cyclicCourse_frontier : ∀ (n v : Nat),
  1 < v →
    ∀ {x : Nat → Nat},
      Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse Becoming.Optimum.Holding.logistic 2 2)
          (Becoming.Optimum.byDrawnLeftAt Becoming.Optimum.Holding.logistic v (n + 1)) x →
        Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse Becoming.Optimum.Holding.logistic 2 2)
          (Becoming.Optimum.byDrawnLeftAt Becoming.Optimum.Holding.logistic v (n + 1))
          (Becoming.UnifiedDrawdown.cyclicCourse x n)
Becoming.UnifiedDrawdown.logistic_periodic_sampled_break_concealment : ∀ (n v : Nat),
  1 < v →
    ∀ {x : Nat → Nat},
      Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse Becoming.Optimum.Holding.logistic 2 2)
          (Becoming.Optimum.byDrawnLeftAt Becoming.Optimum.Holding.logistic v (n + 1)) x →
        have σ := fun j => (n + 2) * j;
        have l_per := Becoming.Optimum.Holding.onSource (Becoming.UnifiedDrawdown.cyclicCourse x n);
        have l_safe := Becoming.Optimum.Holding.onSource fun x => 2;
        Becoming.Strict σ ∧
          Becoming.Requirement.Frontier (Becoming.Optimum.OpenCourse Becoming.Optimum.Holding.logistic 2 2)
              (Becoming.Optimum.byDrawnLeftAt Becoming.Optimum.Holding.logistic v (n + 1))
              (Becoming.UnifiedDrawdown.cyclicCourse x n) ∧
            (∀ (j : Nat),
                (Becoming.Diversion.web l_per).Broken (σ j) Becoming.Diversion.Formation.dweller
                    Becoming.Diversion.Place.source ∧
                  (∀ (k : Nat),
                      k < n + 1 →
                        (Becoming.Diversion.web l_per).level (σ j + k + 1) Becoming.Diversion.Place.source < 2) ∧
                    ¬((Becoming.Diversion.web l_per).sample σ).Broken j Becoming.Diversion.Formation.dweller
                        Becoming.Diversion.Place.source) ∧
              ∀ (K : Nat) (obs : Becoming.Diversion.Formation → Becoming.Diversion.Place → Prop)
                (g : Becoming.Diversion.Formation) (select : (Nat → Becoming.Diversion.Place → Nat) → Prop),
                ((Becoming.Diversion.web l_per).sample σ).SelectsThrough obs g K select →
                  (select (Becoming.atTimes σ l_per) ↔ select (Becoming.atTimes σ l_safe))
@Becoming.UnifiedDrawdown.sampled_recovery_hides_fragility : ∀ {F C : Type} {W : Becoming.Web F C} {obs : F → C → Prop}
  {g f_dep : F} {c cFrag : C} {σ : Nat → Nat},
  Becoming.Strict σ →
    ∀ {K dmg F₀ m_frag m : Nat} {l_break l_safe : Nat → C → Nat},
      ¬W.CoupledInto obs g cFrag →
        (∀ (t : Nat), W.need t f_dep c = m) →
          (∀ (j : Nat),
              j < K → σ j + 2 ≤ σ (j + 1) ∧ W.requires (σ j) f_dep c ∧ m ≤ l_break (σ j) c ∧ l_break (σ j + 1) c < m) →
            (∀ (s : Nat), s ≤ K → ∀ (d : C), W.CoupledInto obs g d → l_break (σ s) d = l_safe (σ s) d) →
              (∀ (j : Nat), j < K → l_break (σ (j + 1)) cFrag + dmg ≤ l_break (σ j) cFrag) →
                l_break (σ 0) cFrag ≤ F₀ →
                  F₀ < K * dmg + m_frag →
                    (∀ (j : Nat), j < K → (W.withLevel l_break).Broken (σ j) f_dep c ∧ σ j + 1 < σ (j + 1)) ∧
                      (∀ (select : (Nat → C → Nat) → Prop),
                          (W.sample σ).SelectsThrough obs g K select →
                            (select (Becoming.atTimes σ l_break) ↔ select (Becoming.atTimes σ l_safe))) ∧
                        (∀ (j₁ j₂ : Nat),
                            j₁ ≤ j₂ → j₂ ≤ K → l_break (σ j₂) cFrag + (j₂ - j₁) * dmg ≤ l_break (σ j₁) cFrag) ∧
                          l_break (σ K) cFrag + K * dmg ≤ F₀ ∧ l_break (σ K) cFrag < m_frag
Becoming.UnifiedDrawdown.sigmaOdd_strict : Becoming.Strict Becoming.UnifiedDrawdown.sigmaOdd
Becoming.UnifiedDrawdown.flick_eq_true_odd : ∀ (j : Nat), Becoming.Strobe.flick (2 * j + 1) = true
Becoming.UnifiedDrawdown.flick_eq_false_even : ∀ (j : Nat), Becoming.Strobe.flick (2 * j) = false
Becoming.UnifiedDrawdown.mod2_cases : ∀ (t : Nat),
  (∃ j, t = Becoming.Strobe.twice j) ∨ ∃ j, t = Becoming.Strobe.twice j + 1
Becoming.UnifiedDrawdown.strobe_readsAt : Becoming.UnifiedDrawdown.ReadsAt Becoming.Strobe.twice fun t =>
  !Becoming.Strobe.flick t
Becoming.UnifiedDrawdown.strobe_readAtSpanEnd : Becoming.PacedStock.ReadAtSpanEnd Becoming.UnifiedDrawdown.sigmaOdd
  fun t => !Becoming.Strobe.flick t
@Becoming.UnifiedDrawdown.cadence_erases_timely_recovery : ∀ {A U R : Type} {fA : A → R → A} {need : U → Nat}
  {kids : R → U → List U} {giving : Nat → Nat} {use : U → Nat} {h : Becoming.PacedStock.StockState A U → R → R}
  {reads_fine reads_coarse : Nat → Bool} {sig : Becoming.PacedStock.StockState A U → Bool} {r_bad r_safe : R} {a₀ : A}
  {w₀ : List U} {x₀ T_end : Nat},
  Becoming.RegimeMargin.FromNothing giving →
    Becoming.LineOnAStock.Needing need (kids r_bad) w₀ →
      (∀ (s : Becoming.PacedStock.StockState A U), sig s = true → h s r_bad = r_safe) →
        (∀ (s : Becoming.PacedStock.StockState A U), h s r_safe = r_safe) →
          (∀ (s : Becoming.PacedStock.StockState A U) (r : R), sig s = false → h s r = r) →
            ∀ (Inv : Becoming.PacedStock.StockState A U → Prop),
              (∀ (s : Becoming.PacedStock.StockState A U), Inv s → Becoming.LineOnAStock.Goes need s.snd) →
                (∀ (s : Becoming.PacedStock.StockState A U),
                    Inv s → Inv (Becoming.PacedStock.fineStep fA need kids giving use s r_safe)) →
                  (∃ t_sig,
                      reads_fine t_sig = true ∧
                        sig
                              (Becoming.PacedStock.pacedCourse fA need kids giving use h reads_fine
                                  ((a₀, w₀, x₀), r_bad) t_sig).fst =
                            true ∧
                          (∀ (t : Nat),
                              t < t_sig →
                                reads_fine t = true →
                                  sig
                                      (Becoming.PacedStock.pacedCourse fA need kids giving use h reads_fine
                                          ((a₀, w₀, x₀), r_bad) t).fst =
                                    false) ∧
                            (∀ (t : Nat),
                                t ≤ t_sig →
                                  Becoming.LineOnAStock.Goes need
                                    (Becoming.PacedStock.pacedCourse fA need kids giving use h reads_fine
                                          ((a₀, w₀, x₀), r_bad) t).fst.snd) ∧
                              Inv
                                (Becoming.PacedStock.fineStep fA need kids giving use
                                  (Becoming.PacedStock.pacedCourse fA need kids giving use h reads_fine
                                      ((a₀, w₀, x₀), r_bad) t_sig).fst
                                  r_bad)) →
                    (∀ (t : Nat),
                        t < T_end →
                          reads_coarse t = true →
                            sig
                                (Becoming.PacedStock.pacedCourse fA need kids giving use h reads_coarse
                                    ((a₀, w₀, x₀), r_bad) t).fst =
                              false) →
                      (∀ (k : Nat),
                          k < T_end →
                            Becoming.LineOnAStock.Goes need
                                (Becoming.LineOnAStock.course need (kids r_bad) giving use (w₀, x₀) k) →
                              giving
                                  ((Becoming.LineOnAStock.course need (kids r_bad) giving use (w₀, x₀) k).snd -
                                    Becoming.LineOnAStock.taken use
                                      (Becoming.LineOnAStock.course need (kids r_bad) giving use (w₀, x₀) k).fst) <
                                Becoming.LineOnAStock.taken use
                                  (Becoming.LineOnAStock.course need (kids r_bad) giving use (w₀, x₀) k).fst) →
                        x₀ < T_end + 1 →
                          have c₀ := ((a₀, w₀, x₀), r_bad);
                          (∀ (t : Nat),
                              Becoming.LineOnAStock.Goes need
                                (Becoming.PacedStock.pacedCourse fA need kids giving use h reads_fine c₀ t).fst.snd) ∧
                            ∃ T,
                              T ≤ T_end ∧
                                ¬Becoming.LineOnAStock.Goes need
                                    (Becoming.PacedStock.pacedCourse fA need kids giving use h reads_coarse c₀
                                          T).fst.snd
@Becoming.UnifiedDrawdown.strobe_schedule_erases_window : ∀ {X C : Type} [DecidableEq X] [DecidableEq C] {name : C → X}
  {c : C} {other : X},
  other ≠ name c →
    ∀ {ℓ d m : Nat},
      (1 + ℓ) * d ≤ m →
        m < (2 + ℓ) * d →
          have s_fine := fun x => name c;
          have s_coarse := fun t => if Becoming.Strobe.flick t = true then other else name c;
          Becoming.ReadingSchedule.Keeps s_fine name c ℓ d m ∧
            ¬Becoming.ReadingSchedule.Keeps s_coarse name c ℓ d m ∧
              ∀ (t : Nat), s_coarse t = name c ↔ ∃ s, t = Becoming.Strobe.twice s
Becoming.UnifiedDrawdown.CadenceErasureWitness.witness_giving_fromNothing : Becoming.RegimeMargin.FromNothing
