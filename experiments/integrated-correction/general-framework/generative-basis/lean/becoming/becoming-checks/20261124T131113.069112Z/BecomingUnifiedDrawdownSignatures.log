                  Becoming.UnifiedDrawdown.CadenceErasureWitness.readsCoarse
                  Becoming.UnifiedDrawdown.CadenceErasureWitness.startConfig 6).fst.snd
@Becoming.UnifiedDrawdown.pacedCourse_span0_matches : ∀ {A U R : Type} {fA : A → R → A} {need : U → Nat}
  {kids : R → U → List U} {giving : Nat → Nat} {use : U → Nat} {h : Becoming.PacedStock.StockState A U → R → R}
  {reads : Nat → Bool} {σ : Nat → Nat} {L : Nat},
  σ 0 = 0 →
    σ 1 = L →
      Becoming.Strict σ →
        Becoming.PacedStock.ReadAtSpanEnd σ reads →
          ∀ {a₀ : A} {w₀ : List U} {x₀ : Nat} {r_bad : R} (t : Nat),
            t ≤ L →
              (Becoming.PacedStock.pacedCourse fA need kids giving use h reads ((a₀, w₀, x₀), r_bad) t).fst.snd =
                Becoming.LineOnAStock.course need (kids r_bad) giving use (w₀, x₀) t
