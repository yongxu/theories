                (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c₀ (T + N)).fst.snd.snd < H_min + y₂
@Becoming.UnifiedDrawdown.pacedCourse_ends_step_pub : ∀ {A U R : Type} {fA : A → R → A} {need : U → Nat}
  {kids : R → U → List U} {giving : Nat → Nat} {use : U → Nat} {h : Becoming.PacedStock.StockState A U → R → R}
  {reads : Nat → Bool} {H_min y₂ : Nat},
  Becoming.RegimeMargin.FromNothing giving →
    Becoming.RegimeMargin.Short giving H_min y₂ →
      (∀ (u : U), 0 < need u) →
        (∀ (w : List U), w ≠ [] → H_min ≤ Becoming.LineOnAStock.taken use w) →
          ∀ (c : Becoming.PacedStock.StockState A U × R) (t : Nat),
            (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c t).fst.snd.snd < H_min + y₂ →
              (∃ n,
                  ¬Becoming.LineOnAStock.Goes need
                      (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c n).fst.snd) ∨
                (Becoming.PacedStock.pacedCourse fA need kids giving use h reads c (t + 1)).fst.snd.snd <
