  (∀ (x : Nat) (a : Becoming.EndogenousEmergence.EmergenceAct), W.xCrit ≤ x → W.sense x a = plateau a) →
    ∀ (T : Nat),
      (∀ (t : Nat), t < T → W.xCrit ≤ (Becoming.EndogenousEmergence.closedOrbit W L x₀ (t + 1)).fst) →
        (Becoming.EndogenousEmergence.closedOrbit W L x₀ T).snd =
            (Becoming.EndogenousEmergence.closedOrbit (Becoming.EndogenousEmergence.plateauWorld plateau) L x₀ T).snd ∧
          L.act (Becoming.EndogenousEmergence.closedOrbit W L x₀ T).snd =
            L.act
              (Becoming.EndogenousEmergence.closedOrbit (Becoming.EndogenousEmergence.plateauWorld plateau) L x₀ T).snd
@Becoming.EndogenousEmergence.closedOrbit_eq_pureExtract_upto : ∀ {S : Type}
  (L : Becoming.EndogenousEmergence.UnguidedLoop S Nat Becoming.EndogenousEmergence.EmergenceAct)
  (W : Becoming.EndogenousEmergence.StrainWorld) (plateau : Becoming.EndogenousEmergence.EmergenceAct → Nat) (x₀ : Nat),
  (∀ (x : Nat) (a : Becoming.EndogenousEmergence.EmergenceAct), W.xCrit ≤ x → W.sense x a = plateau a) →
