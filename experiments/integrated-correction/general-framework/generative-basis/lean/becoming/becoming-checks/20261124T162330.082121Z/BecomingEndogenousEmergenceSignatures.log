Becoming.EndogenousEmergence.endogenous_emergence_sufficiency : ((Becoming.EndogenousEmergence.emergenceUpdater
          Becoming.EndogenousEmergence.worldOwnEndo).ranksAt
      (Becoming.EndogenousEmergence.endogFeedback Becoming.EndogenousEmergence.wEndo 14) 0
      Becoming.EndogenousEmergence.cSafe Becoming.EndogenousEmergence.cExt ∧
    Becoming.EndogenousEmergence.emergentLoop.act
          (Becoming.EndogenousEmergence.closedOrbit Becoming.EndogenousEmergence.wEndo
              Becoming.EndogenousEmergence.emergentLoop 14 0).snd =
        Becoming.EndogenousEmergence.EmergenceAct.extract ∧
      (Becoming.EndogenousEmergence.closedOrbit Becoming.EndogenousEmergence.wEndo
                Becoming.EndogenousEmergence.emergentLoop 14 0).snd.ownHat
          Becoming.EndogenousEmergence.EmergenceItem.sustainedContinuation =
        false) ∧
  (Becoming.EndogenousEmergence.obsAt Becoming.EndogenousEmergence.wEndo Becoming.EndogenousEmergence.emergentLoop 14
          0 =
        16 ∧
      Becoming.EndogenousEmergence.obsAt Becoming.EndogenousEmergence.wEndo Becoming.EndogenousEmergence.emergentLoop 14
            1 =
          14 ∧
        (Becoming.EndogenousEmergence.closedOrbit Becoming.EndogenousEmergence.wEndo
                  Becoming.EndogenousEmergence.emergentLoop 14 1).snd.phase =
            Becoming.EndogenousEmergence.LearnerPhase.coarse (some 16) ∧
          (Becoming.EndogenousEmergence.closedOrbit Becoming.EndogenousEmergence.wEndo
                  Becoming.EndogenousEmergence.emergentLoop 14 2).snd.phase =
            Becoming.EndogenousEmergence.LearnerPhase.probingSafe 14) ∧
    (∀ (t : Nat),
        4 ≤ t →
          (∀ (i : Becoming.EndogenousEmergence.EmergenceItem),
              (Becoming.EndogenousEmergence.closedOrbit Becoming.EndogenousEmergence.wEndo
                        Becoming.EndogenousEmergence.emergentLoop 14 t).snd.ownHat
                  i =
                Becoming.EndogenousEmergence.worldOwnEndo i) ∧
            Becoming.Weighting.IncreasingInOwn Becoming.EndogenousEmergence.emergenceItems
                Becoming.EndogenousEmergence.worldOwnEndo
                ((Becoming.EndogenousEmergence.emergenceUpdater Becoming.EndogenousEmergence.worldOwnEndo).ranksAt
                  (Becoming.EndogenousEmergence.endogFeedback Becoming.EndogenousEmergence.wEndo 14) t) ∧
              (Becoming.EndogenousEmergence.emergenceUpdater Becoming.EndogenousEmergence.worldOwnEndo).ranksAt
                  (Becoming.EndogenousEmergence.endogFeedback Becoming.EndogenousEmergence.wEndo 14) t
                  Becoming.EndogenousEmergence.cExt Becoming.EndogenousEmergence.cSafe ∧
                Becoming.EndogenousEmergence.emergentLoop.act
                      (Becoming.EndogenousEmergence.closedOrbit Becoming.EndogenousEmergence.wEndo
                          Becoming.EndogenousEmergence.emergentLoop 14 t).snd =
                    Becoming.EndogenousEmergence.EmergenceAct.safe ∧
                  (Becoming.EndogenousEmergence.closedOrbit Becoming.EndogenousEmergence.wEndo
                        Becoming.EndogenousEmergence.emergentLoop 14 t).fst =
                    10) ∧
      Becoming.Viability.Kernel
        (Becoming.EndogenousEmergence.loopProcess Becoming.EndogenousEmergence.wEndo
          Becoming.EndogenousEmergence.emergentLoop)
        (Becoming.EndogenousEmergence.viableStockGuard Becoming.EndogenousEmergence.wEndo)
        (14, Becoming.EndogenousEmergence.emergentLoop.init)
