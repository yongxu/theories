@Becoming.EndogenousEmergence.closedOrbit_succ_snd : ∀ {S : Type} (W : Becoming.EndogenousEmergence.StrainWorld)
  (L : Becoming.EndogenousEmergence.UnguidedLoop S Nat Becoming.EndogenousEmergence.EmergenceAct) (x₀ t : Nat),
  (Becoming.EndogenousEmergence.closedOrbit W L x₀ (t + 1)).snd =
