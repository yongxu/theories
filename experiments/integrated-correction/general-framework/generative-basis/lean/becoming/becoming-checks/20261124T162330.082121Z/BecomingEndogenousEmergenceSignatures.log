                    T).snd)
@Becoming.EndogenousEmergence.silent_cliff_universal_collapse : ∀ {S : Type}
  (L : Becoming.EndogenousEmergence.UnguidedLoop S Nat Becoming.EndogenousEmergence.EmergenceAct)
  (W : Becoming.EndogenousEmergence.StrainWorld) (plateau : Becoming.EndogenousEmergence.EmergenceAct → Nat)
  (x₀ T : Nat),
  (∀ (x : Nat) (a : Becoming.EndogenousEmergence.EmergenceAct), W.xCrit ≤ x → W.sense x a = plateau a) →
    (∀ (t : Nat),
        t < T + 1 →
          L.act
              (Becoming.EndogenousEmergence.closedOrbit (Becoming.EndogenousEmergence.plateauWorld plateau) L x₀
                  t).snd =
            Becoming.EndogenousEmergence.EmergenceAct.extract) →
      (∀ (t : Nat), t < T → W.xCrit ≤ Becoming.EndogenousEmergence.pureExtractStock W x₀ (t + 1)) →
        Becoming.EndogenousEmergence.pureExtractStock W x₀ (T + 1) < W.xCrit →
          (Becoming.EndogenousEmergence.closedOrbit W L x₀ (T + 1)).fst < W.xCrit ∧
            (Becoming.EndogenousEmergence.closedOrbit W L x₀ T).snd =
                (Becoming.EndogenousEmergence.closedOrbit (Becoming.EndogenousEmergence.plateauWorld plateau) L x₀
                    T).snd ∧
              ¬Becoming.Viability.Kernel (Becoming.EndogenousEmergence.loopProcess W L)
                  (Becoming.EndogenousEmergence.viableStockGuard W) (x₀, L.init)
