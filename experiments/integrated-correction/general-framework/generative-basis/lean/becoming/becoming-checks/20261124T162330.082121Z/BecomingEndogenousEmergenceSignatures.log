        Becoming.EndogenousEmergence.wThinStrain.sense 6 Becoming.EndogenousEmergence.EmergenceAct.extract <
          Becoming.EndogenousEmergence.wThinStrain.sense 7 Becoming.EndogenousEmergence.EmergenceAct.extract) ∧
      (Becoming.EndogenousEmergence.closedOrbit Becoming.EndogenousEmergence.wThinStrain L 13 4).fst = 4 ∧
        (Becoming.EndogenousEmergence.closedOrbit Becoming.EndogenousEmergence.wThinStrain L 13 3).snd =
            (Becoming.EndogenousEmergence.closedOrbit
                (Becoming.EndogenousEmergence.plateauWorld fun a =>
                  match a with
                  | Becoming.EndogenousEmergence.EmergenceAct.extract => 11
                  | Becoming.EndogenousEmergence.EmergenceAct.safe => 8)
                L 13 3).snd ∧
          ¬Becoming.Viability.Kernel
              (Becoming.EndogenousEmergence.loopProcess Becoming.EndogenousEmergence.wThinStrain L)
              (Becoming.EndogenousEmergence.viableStockGuard Becoming.EndogenousEmergence.wThinStrain) (13, L.init)
