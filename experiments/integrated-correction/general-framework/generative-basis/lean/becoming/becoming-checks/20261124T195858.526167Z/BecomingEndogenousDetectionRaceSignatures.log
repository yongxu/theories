    w.carrier = u.other →
      w.other = u.carrier →
        u.other < u.carrier →
          ∀ (seq : Nat → Nat),
            τ ≤ seq 0 →
              (∀ (n : Nat), seq n < seq (n + 1)) →
                (∀ (n : Nat), reads (seq n) = true) →
