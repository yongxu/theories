                                      Becoming.RuleCapture.CarrierCounts.favours
                                      (Becoming.ClosedCapture.Drawn.poolRead u w)
                                      ((M (seq (2 * m + 2) + 1 + k)).fst.fst, (M (seq (2 * m + 2) + 1 + k)).snd) ∧
                                    Becoming.EndogenousDetectionRace.admits (M (seq (2 * m + 2) + 1 + k)).fst.fst =
                                      false) ∨
                            (∀ (m : Nat),
                                2 * m ≤ n →
                                  Becoming.EndogenousDetectionRace.MiddleMinus
                                    ((M (seq (2 * m))).fst.fst, (M (seq (2 * m))).snd)) ∧
                              ∀ (m : Nat),
