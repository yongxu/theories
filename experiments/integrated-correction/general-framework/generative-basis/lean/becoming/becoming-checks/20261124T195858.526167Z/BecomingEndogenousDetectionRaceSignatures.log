                              (seq 0)).snd) →
                      have M := Becoming.EndogenousDetectionRace.markCourse fB mark u v w reads ((s₀, b₀), g₀);
                      ∀ (n : Nat),
                        (∃ m,
                            2 * m + 1 ≤ n ∧
                              ∀ (k : Nat),
                                Becoming.RuleCapture.Locked
                                    (Becoming.RuleCapture.reverse Becoming.RuleCapture.CarrierCounts.order)
                                    Becoming.RuleCapture.CarrierCounts.disfavours
                                    (Becoming.ClosedCapture.Drawn.poolRead u w)
                                    ((M (seq (2 * m + 1) + 1 + k)).fst.fst, (M (seq (2 * m + 1) + 1 + k)).snd) ∧
                                  (M (seq (2 * m + 1) + 1 + k)).snd.disfavours ∧
                                    Becoming.EndogenousDetectionRace.admits (M (seq (2 * m + 1) + 1 + k)).fst.fst =
                                      true) ∨
                          (∃ m,
                              2 * m + 2 ≤ n ∧
