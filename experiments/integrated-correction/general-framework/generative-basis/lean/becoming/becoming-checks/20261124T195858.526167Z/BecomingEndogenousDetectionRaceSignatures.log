  (∀ (θ : Nat → Bool),
      Becoming.EndogenousDetectionRace.feed L_A (Becoming.EndogenousDetectionRace.viewA θ) T =
        Becoming.EndogenousDetectionRace.feed L_A (Becoming.EndogenousDetectionRace.viewA θ) T) ∧
    (∀ (θ : Nat → Bool),
        Becoming.EndogenousDetectionRace.feed L_B (Becoming.EndogenousDetectionRace.viewB dD θ) T =
          Becoming.EndogenousDetectionRace.feed L_B
            (Becoming.EndogenousDetectionRace.viewB dS fun k =>
              Becoming.EndogenousDetectionRace.mask (Becoming.EndogenousDetectionRace.retag dD θ k) (dS k))
            T) ∧
      (∀ (alarm : S_A → Bool),
          ¬((∀ (θ : Nat → Bool),
                alarm (Becoming.EndogenousDetectionRace.feed L_A (Becoming.EndogenousDetectionRace.viewA θ) T) = true) ∧
              ∀ (θ : Nat → Bool),
                alarm (Becoming.EndogenousDetectionRace.feed L_A (Becoming.EndogenousDetectionRace.viewA θ) T) =
                  false)) ∧
        ∀ (alarm : S_B → Bool),
          ¬((∀ (θ : Nat → Bool),
                alarm (Becoming.EndogenousDetectionRace.feed L_B (Becoming.EndogenousDetectionRace.viewB dD θ) T) =
                  true) ∧
              ∀ (θ : Nat → Bool),
                alarm (Becoming.EndogenousDetectionRace.feed L_B (Becoming.EndogenousDetectionRace.viewB dS θ) T) =
                  false)
@Becoming.EndogenousDetectionRace.silencing_consensus : ∀ {S_A S_B : Type}
  (L_A : Becoming.EndogenousEmergence.UnguidedLoop S_A Bool Becoming.EndogenousEmergence.EmergenceAct)
  (L_B : Becoming.EndogenousEmergence.UnguidedLoop S_B Bool Becoming.EndogenousEmergence.EmergenceAct)
  (alarmA : S_A → Bool) (alarmB : S_B → Bool) (c : Bool → Bool → Bool),
  c false false = false →
    ∀ (dD dS : Nat → Bool) (T : Nat),
      (∀ (θ : Nat → Bool),
          alarmA (Becoming.EndogenousDetectionRace.feed L_A (Becoming.EndogenousDetectionRace.viewA θ) T) = false) →
        (∀ (θ : Nat → Bool),
            alarmB (Becoming.EndogenousDetectionRace.feed L_B (Becoming.EndogenousDetectionRace.viewB dS θ) T) =
              false) →
          ∀ (θ : Nat → Bool),
            c (alarmA (Becoming.EndogenousDetectionRace.feed L_A (Becoming.EndogenousDetectionRace.viewA θ) T))
                (alarmB (Becoming.EndogenousDetectionRace.feed L_B (Becoming.EndogenousDetectionRace.viewB dD θ) T)) =
              false
Becoming.EndogenousDetectionRace.verdict_leak : ∀ (d θ : Nat → Bool) (t : Nat),
  have L_A :=
    { init := false, act := fun x => Becoming.EndogenousEmergence.EmergenceAct.extract, update := fun x o => o };
  have L_B :=
    { init := false, act := fun x => Becoming.EndogenousEmergence.EmergenceAct.extract, update := fun x o => o };
  Becoming.EndogenousDetectionRace.exchange
      (Becoming.EndogenousDetectionRace.feed L_A (Becoming.EndogenousDetectionRace.viewA θ) (t + 1))
      (Becoming.EndogenousDetectionRace.feed L_B (Becoming.EndogenousDetectionRace.viewB d θ) (t + 1)) =
    d t
Becoming.EndogenousDetectionRace.exchange_detects : ∀ (d θ : Nat → Bool) (t : Nat),
  Becoming.EndogenousDetectionRace.exchange (Becoming.EndogenousDetectionRace.viewA θ t)
      (Becoming.EndogenousDetectionRace.viewB d θ t) =
    d t
@Becoming.EndogenousDetectionRace.markCourse_feedStep_eq : ∀ {S Obs Act : Type}
  (L : Becoming.EndogenousEmergence.UnguidedLoop S Obs Act) (obs : Nat → Obs) (mark : S → Bool)
  (u v w : Becoming.RuleCapture.CarrierCounts) (reads : Nat → Bool) (s₀ g₀ : Becoming.RuleCapture.CarrierCounts)
  (t : Nat),
  (Becoming.EndogenousDetectionRace.markCourse (Becoming.EndogenousDetectionRace.feedStep L obs) (fun b => mark b.snd) u
          v w reads ((s₀, 0, L.init), g₀) t).fst.snd =
    (t, Becoming.EndogenousDetectionRace.feed L obs t)
@Becoming.EndogenousDetectionRace.feed_pairLoop : ∀ {S_A S_B : Type}
  (L_A : Becoming.EndogenousEmergence.UnguidedLoop S_A Bool Becoming.EndogenousEmergence.EmergenceAct)
  (L_B : Becoming.EndogenousEmergence.UnguidedLoop S_B Bool Becoming.EndogenousEmergence.EmergenceAct)
  (oA oB : Nat → Bool) (t : Nat),
  Becoming.EndogenousDetectionRace.feed (Becoming.EndogenousDetectionRace.pairLoop L_A L_B) (fun k => (oA k, oB k)) t =
    (Becoming.EndogenousDetectionRace.feed L_A oA t, Becoming.EndogenousDetectionRace.feed L_B oB t)
Becoming.EndogenousDetectionRace.exchangeLoop_eq_of_d01 : ∀ (d θ : Nat → Bool),
  d 0 = false →
    d 1 = true →
      ∀ (t : Nat),
        Becoming.EndogenousDetectionRace.feed Becoming.EndogenousDetectionRace.exchangeLoop
              (fun k => (Becoming.EndogenousDetectionRace.viewA θ k, Becoming.EndogenousDetectionRace.viewB d θ k)) t =
            true ↔
          2 ≤ t
Becoming.EndogenousDetectionRace.exchangeLoop_never_of_safe : ∀ (dS θ : Nat → Bool),
  (∀ (t : Nat), dS t = false) →
    ∀ (t : Nat),
      Becoming.EndogenousDetectionRace.feed Becoming.EndogenousDetectionRace.exchangeLoop
          (fun k => (Becoming.EndogenousDetectionRace.viewA θ k, Becoming.EndogenousDetectionRace.viewB dS θ k)) t =
        false
@Becoming.EndogenousDetectionRace.split_silenced_trapped : ∀ {S_A S_B : Type}
  (L_A : Becoming.EndogenousEmergence.UnguidedLoop S_A Bool Becoming.EndogenousEmergence.EmergenceAct)
  (L_B : Becoming.EndogenousEmergence.UnguidedLoop S_B Bool Becoming.EndogenousEmergence.EmergenceAct)
  (alarmA : S_A → Bool) (alarmB : S_B → Bool) (c : Bool → Bool → Bool),
  c false false = false →
    ∀ (dD dS : Nat → Bool),
      (∀ (t : Nat) (θ : Nat → Bool),
          alarmA (Becoming.EndogenousDetectionRace.feed L_A (Becoming.EndogenousDetectionRace.viewA θ) t) = false) →
        (∀ (t : Nat) (θ : Nat → Bool),
            alarmB (Becoming.EndogenousDetectionRace.feed L_B (Becoming.EndogenousDetectionRace.viewB dS θ) t) =
              false) →
          ∀ (u v w s₀ g₀ : Becoming.RuleCapture.CarrierCounts) (reads : Nat → Bool),
            Becoming.RuleCapture.CarrierCounts.order.le v u →
              u.favours →
                v.favours →
                  ∀ {r r' : Nat},
                    reads r = true →
                      reads r' = true →
                        r < r' →
                          ∀ (loss₀ : Nat) (θ : Nat → Bool),
                            have pair := Becoming.EndogenousDetectionRace.pairLoop L_A L_B;
                            have mark := fun s => c (alarmA s.fst) (alarmB s.snd);
                            have M :=
                              Becoming.EndogenousDetectionRace.markCourse
                                (Becoming.EndogenousDetectionRace.feedStep pair fun k =>
                                  (Becoming.EndogenousDetectionRace.viewA θ k,
                                    Becoming.EndogenousDetectionRace.viewB dD θ k))
                                (fun b => mark b.snd) u v w reads ((s₀, 0, pair.init), g₀);
                            (∀ (t : Nat), mark (M t).fst.snd.snd = false) ∧
                              (∀ (t : Nat),
                                  (M t).fst.fst =
                                      (Becoming.Pace.paced Becoming.RuleCapture.CarrierCounts.select
                                          (Becoming.ClosedCapture.Drawn.poolRead u v) reads (s₀, g₀) t).fst ∧
                                    (M t).snd =
                                      (Becoming.Pace.paced Becoming.RuleCapture.CarrierCounts.select
                                          (Becoming.ClosedCapture.Drawn.poolRead u v) reads (s₀, g₀) t).snd) ∧
                                (∀ (k : Nat),
                                    Becoming.RuleCapture.Locked Becoming.RuleCapture.CarrierCounts.order
                                      Becoming.RuleCapture.CarrierCounts.favours
                                      (Becoming.ClosedCapture.Drawn.poolRead u v)
                                      ((M (r' + 1 + k)).fst.fst, (M (r' + 1 + k)).snd)) ∧
                                  ∀ (k : Nat),
                                    loss₀ + k ≤
                                      (Becoming.Pace.paced
                                            (Becoming.ClosedCapture.join Becoming.RuleCapture.CarrierCounts.select
                                              Becoming.ClosedCapture.Beyond.lossStep)
                                            (Becoming.ClosedCapture.joinRead
                                              (Becoming.ClosedCapture.Drawn.poolRead u v))
                                            (fun j => reads (r' + 1 + j))
                                            (((M (r' + 1)).fst.fst, loss₀), (M (r' + 1)).snd) k).fst.snd
Becoming.EndogenousDetectionRace.split_exchange_turns : ∀ (dD dS : Nat → Bool),
  dD 0 = false →
    dD 1 = true →
      (∀ (t : Nat), dS t = false) →
        ∀ (θ : Nat → Bool),
          have MD :=
            Becoming.EndogenousDetectionRace.markCourse
              (Becoming.EndogenousDetectionRace.feedStep Becoming.EndogenousDetectionRace.exchangeLoop fun k =>
                (Becoming.EndogenousDetectionRace.viewA θ k, Becoming.EndogenousDetectionRace.viewB dD θ k))
              (fun b => b.snd) Becoming.RuleCapture.CarrierCounts.hi Becoming.RuleCapture.Second.oneToOne
              Becoming.RuleCapture.CarrierCounts.lo (fun x => true)
              ((Becoming.EndogenousDetectionRace.s20, 0, false), Becoming.RuleCapture.CarrierCounts.hi);
          have MS :=
            Becoming.EndogenousDetectionRace.markCourse
              (Becoming.EndogenousDetectionRace.feedStep Becoming.EndogenousDetectionRace.exchangeLoop fun k =>
                (Becoming.EndogenousDetectionRace.viewA θ k, Becoming.EndogenousDetectionRace.viewB dS θ k))
              (fun b => b.snd) Becoming.RuleCapture.CarrierCounts.hi Becoming.RuleCapture.Second.oneToOne
              Becoming.RuleCapture.CarrierCounts.lo (fun x => true)
              ((Becoming.EndogenousDetectionRace.s20, 0, false), Becoming.RuleCapture.CarrierCounts.hi);
          (∀ (t : Nat),
              (MD t).fst.fst = (Becoming.EndogenousDetectionRace.thinnedExchange t).fst.fst ∧
                (MD t).snd = (Becoming.EndogenousDetectionRace.thinnedExchange t).snd) ∧
            (∀ (k : Nat),
                (MD (3 + k)).snd.disfavours ∧ Becoming.EndogenousDetectionRace.admits (MD (3 + k)).fst.fst = true) ∧
              ∀ (t : Nat), (MS t).fst.snd.snd = false ∧ (MS t).snd.favours
Becoming.EndogenousDetectionRace.split_witness_endo : Becoming.EndogenousDetectionRace.dEndo 0 = false ∧
  Becoming.EndogenousDetectionRace.dEndo 1 = true ∧
    (∀ {S : Type} (L : Becoming.EndogenousEmergence.UnguidedLoop S Bool Becoming.EndogenousEmergence.EmergenceAct)
        (s : S) (alarm : S → Bool) (T : Nat),
        (Becoming.EndogenousDetectionRace.countTags T fun θ =>
            alarm
              (Becoming.EndogenousDetectionRace.feedList L s
                (Becoming.EndogenousDetectionRace.viewBList Becoming.EndogenousDetectionRace.dEndo θ))) =
          Becoming.EndogenousDetectionRace.countTags T fun θ =>
            alarm
              (Becoming.EndogenousDetectionRace.feedList L s
                (Becoming.EndogenousDetectionRace.viewBList Becoming.EndogenousDetectionRace.dSafe θ))) ∧
      (∀ {S_A S_B : Type}
          (L_A : Becoming.EndogenousEmergence.UnguidedLoop S_A Bool Becoming.EndogenousEmergence.EmergenceAct)
          (L_B : Becoming.EndogenousEmergence.UnguidedLoop S_B Bool Becoming.EndogenousEmergence.EmergenceAct)
          (alarmA : S_A → Bool) (alarmB : S_B → Bool) (c : Bool → Bool → Bool),
          c false false = false →
            (∀ (t : Nat) (θ : Nat → Bool),
                alarmA (Becoming.EndogenousDetectionRace.feed L_A (Becoming.EndogenousDetectionRace.viewA θ) t) =
                  false) →
              (∀ (t : Nat) (θ : Nat → Bool),
                  alarmB
                      (Becoming.EndogenousDetectionRace.feed L_B
                        (Becoming.EndogenousDetectionRace.viewB Becoming.EndogenousDetectionRace.dSafe θ) t) =
                    false) →
                ∀ (θ : Nat → Bool) (k : Nat),
                  have pair := Becoming.EndogenousDetectionRace.pairLoop L_A L_B;
                  have mark := fun s => c (alarmA s.fst) (alarmB s.snd);
                  have M :=
                    Becoming.EndogenousDetectionRace.markCourse
                      (Becoming.EndogenousDetectionRace.feedStep pair fun j =>
                        (Becoming.EndogenousDetectionRace.viewA θ j,
                          Becoming.EndogenousDetectionRace.viewB Becoming.EndogenousDetectionRace.dEndo θ j))
                      (fun b => mark b.snd) Becoming.RuleCapture.CarrierCounts.hi Becoming.RuleCapture.Second.oneToOne
                      Becoming.RuleCapture.CarrierCounts.lo (fun x => true)
                      ((Becoming.EndogenousDetectionRace.s20, 0, pair.init), Becoming.RuleCapture.CarrierCounts.hi);
                  Becoming.RuleCapture.Locked Becoming.RuleCapture.CarrierCounts.order
                    Becoming.RuleCapture.CarrierCounts.favours
                    (Becoming.ClosedCapture.Drawn.poolRead Becoming.RuleCapture.CarrierCounts.hi
                      Becoming.RuleCapture.Second.oneToOne)
                    ((M (2 + k)).fst.fst, (M (2 + k)).snd)) ∧
        ∀ (θ : Nat → Bool) (k : Nat),
          have MD :=
            Becoming.EndogenousDetectionRace.markCourse
              (Becoming.EndogenousDetectionRace.feedStep Becoming.EndogenousDetectionRace.exchangeLoop fun j =>
                (Becoming.EndogenousDetectionRace.viewA θ j,
                  Becoming.EndogenousDetectionRace.viewB Becoming.EndogenousDetectionRace.dEndo θ j))
              (fun b => b.snd) Becoming.RuleCapture.CarrierCounts.hi Becoming.RuleCapture.Second.oneToOne
              Becoming.RuleCapture.CarrierCounts.lo (fun x => true)
              ((Becoming.EndogenousDetectionRace.s20, 0, false), Becoming.RuleCapture.CarrierCounts.hi);
          (MD (3 + k)).snd.disfavours ∧ Becoming.EndogenousDetectionRace.admits (MD (3 + k)).fst.fst = true
