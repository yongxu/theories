@Becoming.OpenEndedComposition.scoped_substrate_margin_step : ∀ {Site : Type} {G : Site → (Site → Nat) → Nat},
  (∀ (j : Site), Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole (G j)) →
    ∀ (scope : Site → Bool) {H preTotal H_safe x_crit warnLevel x : Site → Nat} {curLag nextEta maxLag : Nat},
      (∀ (j : Site), scope j = true → H j ≤ preTotal j) →
        nextEta ≤ maxLag →
          (∀ (j : Site),
              Becoming.OpenEndedComposition.effCrit scope x_crit j ≤
                Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G H_safe
                  (Becoming.OpenEndedComposition.effCrit scope x_crit) j) →
            (∀ (j : Site), scope j = true → x_crit j + (maxLag + 1) * preTotal j ≤ warnLevel j) →
              (∀ (j : Site), scope j = true → x_crit j + curLag * preTotal j ≤ x j) →
                ∀ (j : Site),
                  scope j = true →
                    (x j < warnLevel j →
                        (curLag = 0 → nextEta = 0 ∧ ∀ (k : Site), H k ≤ H_safe k) ∧
                          (0 < curLag → nextEta + 1 ≤ curLag)) →
                      x_crit j + nextEta * preTotal j ≤
                        Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G H x j
@Becoming.OpenEndedComposition.unscoped_recovers_substrate_margin_step : ∀ {ι : Type} {G : ι → (ι → Nat) → Nat},
  (∀ (j : ι), Becoming.RegimeMargin.Coupled.Indexed.Rises Becoming.RegimeMargin.Drawn.whole (G j)) →
    ∀ {H preTotal H_safe x_crit warnLevel x : ι → Nat} {curLag nextEta maxLag : Nat},
      (∀ (j : ι), H j ≤ preTotal j) →
        nextEta ≤ maxLag →
          (∀ (j : ι),
              x_crit j ≤
                Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G H_safe x_crit j) →
            (∀ (j : ι), x_crit j + (maxLag + 1) * preTotal j ≤ warnLevel j) →
              (∀ (j : ι), x_crit j + curLag * preTotal j ≤ x j) →
                ∀ (j : ι),
                  (x j < warnLevel j →
                      (curLag = 0 → nextEta = 0 ∧ ∀ (k : ι), H k ≤ H_safe k) ∧ (0 < curLag → nextEta + 1 ≤ curLag)) →
                    x_crit j + nextEta * preTotal j ≤
                      Becoming.RegimeMargin.Coupled.Indexed.step Becoming.RegimeMargin.Drawn.whole G H x j
