  (channel : Bool → Nat → Env → Bool) (G : Site → (Site → Nat) → Nat) (envDraw : Env → Site → Nat) (envCap : Site → Nat)
  (jointAdm : Env → Prop) (x_crit warnLevel H_safe sitePreCap sitePostCap : Site → Nat) (maxLagEnv maxSilenceEnv : Nat)
  (AllowUpgrade : Unit → Unit → Prop) (anchored : Bool) {s₀ s₁ : (Site → Nat) × (m : Mode) × S m},
