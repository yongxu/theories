import Becoming.RelSpan
import EncounterEntry

/-!
# Held-Out External Adapter: `Becoming.RelSpan` on `EncounterEntry` Branching Choices

AI-written (`Wave 3` Track A3, 25 November 2026). Strictly external to `Becoming`'s core
(`experiments/.../lean/encounter-entry/`), compiling on Lean `v4.29.1` with `0` axioms on all
source declarations & transitive closures (`0` `sorry`/`private`; unused `ExitOcc.mk.injEq` `[propext]` generated by `structure`).

Constructs the held-out negative test pairing `EncounterEntry.pathCount_eq` with
`EncounterEntry.sysB_branch_stuck`:
* Defines `Mid sys := { m : BranchState // m ∈ sys.edges .entry .stepX }` and indexed
  exit-occurrence witnesses `ExitOcc sys q` over `q : Mid sys × PostReq`.
* Proves forgetting the occurrence index `forgetIdx sys : ExitWitness sys → Mid sys × PostReq`
  is surjective IF AND ONLY IF `CompletesPostBranch sys` (`proj_surjective_iff_completesPostBranch`).
* Separates `sysA` (`sysA_proj_surjective`) from `sysB` (`sysB_leftMid_reqB_empty_fiber` and
  `sysB_branch_stuck`) despite `EncounterEntry.pathCount_eq` equating every entry-to-exit count.
* Instantiates `Becoming.RelSpan.mapTrace` on `BranchSys` processes (`branchProcess_mapTrace`).
-/

namespace RelSpanEncounterAdapter

open EncounterEntry

/-! ## Part 0: Zero-Axiom Indexed List Lookup Helpers -/

/-- Zero-axiom partial indexing into a list. -/
def listNth? {α : Type} : List α → Nat → Option α
  | [], _ => none
  | a :: _, 0 => some a
  | _ :: as, n + 1 => listNth? as n

theorem mem_of_listNth?_eq_some {α : Type} :
    ∀ {xs : List α} {i : Nat} {a : α}, listNth? xs i = some a → a ∈ xs
  | _ :: _, 0, _, h => by cases h; exact .head _
  | _ :: _, _ + 1, _, h => .tail _ (mem_of_listNth?_eq_some h)

theorem exists_listNth?_eq_some_of_mem {α : Type} :
    ∀ {xs : List α} {a : α}, a ∈ xs → ∃ i : Nat, listNth? xs i = some a
  | _ :: _, _, .head _ => ⟨0, rfl⟩
  | _ :: _, _, .tail _ hm =>
    let ⟨i, hi⟩ := exists_listNth?_eq_some_of_mem hm
    ⟨i + 1, hi⟩

/-! ## Part 1: Occurrence-Indexed Post-Branch Fibers (`Mid × PostReq`) -/

/-- Intermediate nodes reachable from `.entry` under `.stepX`. -/
def Mid (sys : BranchSys) : Type :=
  { m : BranchState // m ∈ sys.edges .entry .stepX }

/-- Explicit occurrence-index witness selecting an `.exitDone` edge out of `(m, r)`. -/
structure ExitOcc (sys : BranchSys) (q : Mid sys × PostReq) where
  idx : Nat
  atIdx : listNth? (sys.edges q.1.val (postLabel q.2)) idx = some .exitDone

/-- Total occurrence-witness space bundled over `(mid, post-req)` queries. -/
def ExitWitness (sys : BranchSys) : Type :=
  Σ q : Mid sys × PostReq, ExitOcc sys q

/-- Projection forgetting the edge occurrence index, leaving only `(mid, req)`. -/
def forgetIdx (sys : BranchSys) : ExitWitness sys → Mid sys × PostReq
  | ⟨q, _⟩ => q

/-- Forgetting the occurrence index is surjective iff `CompletesPostBranch sys` holds. -/
theorem proj_surjective_iff_completesPostBranch (sys : BranchSys) :
    (∀ q : Mid sys × PostReq, ∃ w : ExitWitness sys, forgetIdx sys w = q) ↔
      CompletesPostBranch sys := by
  constructor
  · intro hSurj m hm r
    obtain ⟨⟨q', occ⟩, hEq⟩ := hSurj (⟨m, hm⟩, r)
    cases hEq
    exact ⟨.exitDone, mem_of_listNth?_eq_some occ.atIdx, rfl⟩
  · intro hComp ⟨⟨m, hm⟩, r⟩
    obtain ⟨tgt, hMem, hTgt⟩ := hComp m hm r
    subst hTgt
    obtain ⟨i, hi⟩ := exists_listNth?_eq_some_of_mem hMem
    exact ⟨⟨(⟨m, hm⟩, r), ⟨i, hi⟩⟩, rfl⟩

/-- `sysA` (`sysA_completes_all`) has surjective post-branch projection. -/
theorem sysA_proj_surjective :
    ∀ q : Mid sysA × PostReq, ∃ w : ExitWitness sysA, forgetIdx sysA w = q :=
  (proj_surjective_iff_completesPostBranch sysA).mpr sysA_completes_all

/-- `sysB` has an empty fiber over `(⟨.leftMid, .head _⟩, .reqB)` despite duplicate `.reqA` exits. -/
theorem sysB_leftMid_reqB_empty_fiber :
    ¬ ∃ w : ExitWitness sysB, forgetIdx sysB w = (⟨.leftMid, .head _⟩, .reqB) := by
  intro ⟨⟨q, occ⟩, hw⟩
  cases hw
  cases occ.atIdx

/-- Held-out external negative test: `pathCount_eq` preserves every path count while `forgetIdx`
is surjective on `sysA` and has an empty branch fiber on `sysB` (`sysB_branch_stuck`). -/
theorem heldout_pathCount_vs_branch_fiber_separation :
    (∀ w : List BranchLabel, entryToExitCount sysA w = entryToExitCount sysB w) ∧
    (∀ q : Mid sysA × PostReq, ∃ w : ExitWitness sysA, forgetIdx sysA w = q) ∧
    (¬ ∃ w : ExitWitness sysB, forgetIdx sysB w = (⟨.leftMid, .head _⟩, .reqB)) ∧
    ¬ CompletesPostBranch sysB :=
  ⟨pathCount_eq, sysA_proj_surjective, sysB_leftMid_reqB_empty_fiber, sysB_branch_stuck⟩

/-! ## Part 2: `Becoming.RelSpan.mapTrace` Instance on `BranchSys` -/

/-- Labeled transition `Generative.Process` induced by a `BranchSys`. -/
def branchProcess (sys : BranchSys) : Generative.Process BranchState BranchLabel where
  step s a t := t ∈ sys.edges s a

/-- Generic forward trace transport instantiated via `Becoming.RelSpan.mapTrace`. -/
theorem branchProcess_mapTrace
    (sys₁ sys₂ : BranchSys) (π : BranchState → BranchState) (φ : BranchLabel → BranchLabel)
    (hStep : ∀ s a t, t ∈ sys₁.edges s a → π t ∈ sys₂.edges (π s) (φ a))
    {s t : BranchState} {w : List BranchLabel}
    (tr : Generative.Trace (branchProcess sys₁) s w t) :
    Generative.Trace (branchProcess sys₂) (π s) (w.map φ) (π t) :=
  Becoming.RelSpan.mapTrace tr hStep

end RelSpanEncounterAdapter
