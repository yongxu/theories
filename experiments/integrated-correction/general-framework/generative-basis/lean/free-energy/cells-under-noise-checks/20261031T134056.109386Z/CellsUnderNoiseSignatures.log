  Becoming.CellsUnderNoise.weightsAt (fun x => Becoming.CellsUnderNoise.Witness.toParted)
        (Becoming.CellsUnderNoise.pointMass fun x => b) 1 ![true, false] =
      1 / 2 ∧
    Becoming.CellsUnderNoise.weightsAt (fun x => Becoming.CellsUnderNoise.Witness.toParted)
        (Becoming.CellsUnderNoise.pointMass fun x => b) 1 ![false, true] =
      1 / 2
