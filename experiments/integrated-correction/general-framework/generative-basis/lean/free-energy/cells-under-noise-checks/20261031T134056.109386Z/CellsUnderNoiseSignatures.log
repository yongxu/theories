    (∀ (k : ℕ) (x : S) (z : γ), ∑ s', r k x z s' = 1) →
      ∀ (a : S) (n : ℕ),
        ∃ b,
          0 <
            Becoming.CellsUnderNoise.weightsAt (fun k => Becoming.CellsUnderNoise.noisyDescent (r k) field)
