    ∀ (c : Becoming.CellsUnderNoise.Witness.Two),
      Becoming.CellsUnderNoise.Witness.partedUniform c = w 0 (c 0) * w 1 (c 1)
Becoming.CellsUnderNoise.Witness.parted_rearranged : ∀ (σ : Equiv.Perm (Fin 2))
  (c : Becoming.CellsUnderNoise.Witness.Two), c (σ 0) ≠ c (σ 1) ↔ c 0 ≠ c 1
