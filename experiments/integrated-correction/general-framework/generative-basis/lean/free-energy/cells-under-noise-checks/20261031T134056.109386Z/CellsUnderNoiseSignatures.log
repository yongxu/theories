  Becoming.CellsUnderNoise.Witness.partedUniform
Becoming.CellsUnderNoise.Witness.firstCell_not_exchangeable : ¬Becoming.FreeEnergyGuarantees.IdenticalCells.Exchangeable
    Becoming.CellsUnderNoise.Witness.firstCell
Becoming.CellsUnderNoise.Witness.firstCell_assigns : Becoming.CellsUnderNoise.weightsAt
      (fun x =>
        Becoming.CellsUnderNoise.noisy
          (Becoming.CellsUnderNoise.cellwise Becoming.CellsUnderNoise.Witness.flipBy
            Becoming.CellsUnderNoise.Witness.firstCell)
          Becoming.CellsUnderNoise.noiseless)
      Becoming.CellsUnderNoise.Witness.partedUniform 1 ![false, true] =
    1 ∧
  Becoming.CellsUnderNoise.marginal
        (Becoming.CellsUnderNoise.weightsAt
          (fun x =>
            Becoming.CellsUnderNoise.noisy
              (Becoming.CellsUnderNoise.cellwise Becoming.CellsUnderNoise.Witness.flipBy
                Becoming.CellsUnderNoise.Witness.firstCell)
              Becoming.CellsUnderNoise.noiseless)
          Becoming.CellsUnderNoise.Witness.partedUniform 1)
        0 false =
      1 ∧
    Becoming.CellsUnderNoise.marginal
