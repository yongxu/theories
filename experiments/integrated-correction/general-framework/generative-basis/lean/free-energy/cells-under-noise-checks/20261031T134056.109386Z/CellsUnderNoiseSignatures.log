  (q : Bool → Bool → ℝ), Becoming.CellsUnderNoise.Witness.toParted ≠ Becoming.CellsUnderNoise.noisy f q
@Becoming.CellsUnderNoise.Witness.toParted_not_noisyDescent : ∀ {γ : Type} (r : Bool → γ → Bool → ℝ)
  (field : Bool → List Bool → γ),
  Becoming.CellsUnderNoise.Witness.toParted ≠ Becoming.CellsUnderNoise.noisyDescent r field
Becoming.CellsUnderNoise.Witness.assign_not_commutes : ¬∀ (c : Becoming.CellsUnderNoise.Witness.Two),
    Becoming.CellsUnderNoise.Witness.assign (c ∘ ⇑(Equiv.swap 0 1)) =
      Becoming.CellsUnderNoise.Witness.assign c ∘ ⇑(Equiv.swap 0 1)
Becoming.CellsUnderNoise.Witness.toParted_eq_mixture : ∀ (c c' : Becoming.CellsUnderNoise.Witness.Two),
  Becoming.CellsUnderNoise.Witness.toParted c c' =
    1 / 2 *
        Becoming.CellsUnderNoise.noisy Becoming.CellsUnderNoise.Witness.assign Becoming.CellsUnderNoise.noiseless c c' +
      1 / 2 *
        Becoming.CellsUnderNoise.noisy (fun c => Becoming.CellsUnderNoise.Witness.assign c ∘ ⇑(Equiv.swap 0 1))
          Becoming.CellsUnderNoise.noiseless c c'
Becoming.CellsUnderNoise.Witness.independentNoise_parts : Becoming.CellsUnderNoise.weightsAt
    (fun x => Becoming.CellsUnderNoise.noisyDescent (fun x x_1 x_2 => 1 / 2) fun x x_1 => ())
    (Becoming.CellsUnderNoise.pointMass fun x => false) 1 ![false, true] =
  1 / 4
Becoming.CellsUnderNoise.Witness.toParted_once : ∀ (b : Bool),
  Becoming.CellsUnderNoise.weightsAt (fun x => Becoming.CellsUnderNoise.Witness.toParted)
      (Becoming.CellsUnderNoise.pointMass fun x => b) 1 =
    Becoming.CellsUnderNoise.Witness.partedUniform
Becoming.CellsUnderNoise.Witness.alike_none : ∀ (b b' : Bool),
  (Becoming.CellsUnderNoise.weightsAt (fun x => Becoming.CellsUnderNoise.Witness.toParted)
      (Becoming.CellsUnderNoise.pointMass fun x => b) 1 fun x => b') =
    0
