        Becoming.ExpectedFreeEnergy.courseWeight S Q' (fun e s => B e (π s))
          (Becoming.ExpectedFreeEnergy.efeChoice (Becoming.ExpectedFreeEnergy.softmax γ) S O Q' (fun e s => B e (π s))
            P)
          c
