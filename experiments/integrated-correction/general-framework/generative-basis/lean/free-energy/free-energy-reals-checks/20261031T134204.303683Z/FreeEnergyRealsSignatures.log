                      (Becoming.ConditionalWeights.restrict (fun c => rec c.2)
                        (Becoming.ConditionalWeights.pairWeight prior lik))
                      fun c => decide (c.1 = h)).toReal)
@Becoming.FreeEnergy.surprisal_product : ∀ {α : Type u_1} {β : Type u_2} (w₁ : α → ℕ) (w₂ : β → ℕ) (e₁ : α → Bool)
  (e₂ : β → Bool) (xs : List α) (ys : List β),
