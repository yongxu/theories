  (∀ h ∈ hs, a h = 0 → n h = 0) → 0 < Becoming.FreeEnergyCounting.powerProduct a n hs
@Becoming.FreeEnergy.countBelief_nonneg : ∀ {α : Type} (hs : List α) (n : α → ℕ) (h : α),
  0 ≤ Becoming.FreeEnergy.countBelief hs n h
@Becoming.FreeEnergy.sum_countBelief : ∀ {α : Type} [inst : DecidableEq α] (n : α → ℕ) {hs : List α},
  Becoming.Distinct hs → 0 < Becoming.total hs n → ∑ h ∈ hs.toFinset, Becoming.FreeEnergy.countBelief hs n h = 1
@Becoming.FreeEnergy.countBelief_support : ∀ {α : Type} [inst : DecidableEq α] (n a : α → ℕ) {hs : List α},
  (∀ h ∈ hs, a h = 0 → n h = 0) → ∀ h ∈ hs.toFinset, ↑(a h) = 0 → Becoming.FreeEnergy.countBelief hs n h = 0
Becoming.FreeEnergy.self_pow_ne_zero : ∀ (k : ℕ), ↑k ^ k ≠ 0
@Becoming.FreeEnergy.gap_counts : ∀ {α : Type} [inst : DecidableEq α] (n a : α → ℕ) {hs : List α},
