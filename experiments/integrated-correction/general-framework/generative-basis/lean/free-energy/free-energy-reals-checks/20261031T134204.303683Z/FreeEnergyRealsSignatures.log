Becoming.ConditionalWeights.Share.toReal_nonneg : ∀ (a : Becoming.ConditionalWeights.Share), 0 ≤ a.toReal
@Becoming.FreeEnergy.share_toReal_pos : ∀ {Ω : Type u_1} (l : List Ω) (w : Ω → ℕ) (e : Ω → Bool),
