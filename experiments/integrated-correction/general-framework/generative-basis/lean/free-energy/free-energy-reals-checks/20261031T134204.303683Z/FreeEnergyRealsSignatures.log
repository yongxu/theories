            ↑(Becoming.total [true, false] Becoming.FreeEnergyCounting.Witness.secondOnly ^
                  Becoming.total [true, false] Becoming.FreeEnergyCounting.Witness.even *
                Becoming.FreeEnergyCounting.powerProduct Becoming.FreeEnergyCounting.Witness.even
                  Becoming.FreeEnergyCounting.Witness.even [true, false]) -
