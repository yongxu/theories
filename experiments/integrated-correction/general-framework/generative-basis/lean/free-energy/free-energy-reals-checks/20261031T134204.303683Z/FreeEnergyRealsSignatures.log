                  (Becoming.ConditionalWeights.share (Becoming.openSteps hs os)
                      (Becoming.ConditionalWeights.pairWeight prior lik) fun c => decide (c.1 = h) && rec c.2).toReal) -
                Becoming.FreeEnergy.surprisal
                  (Becoming.ConditionalWeights.share (Becoming.openSteps hs os)
                      (Becoming.ConditionalWeights.pairWeight prior lik) fun c => rec c.2).toReal) =
            Real.log
                ↑((Becoming.mass (Becoming.openSteps hs os) (Becoming.ConditionalWeights.pairWeight prior lik) fun c =>
                        rec c.2) ^
                      Becoming.total hs n *
                    Becoming.FreeEnergyCounting.powerProduct n n hs) -
              Real.log
                ↑(Becoming.total hs n ^ Becoming.total hs n *
                    Becoming.FreeEnergyCounting.powerProduct (Becoming.FreeEnergyCounting.joint prior lik os rec) n hs)
