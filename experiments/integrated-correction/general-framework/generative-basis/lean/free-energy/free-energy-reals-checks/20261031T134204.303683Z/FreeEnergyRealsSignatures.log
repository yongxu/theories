    0 < Becoming.mass ys w₂ e₂ →
      Becoming.FreeEnergy.surprisal
          (Becoming.ConditionalWeights.share (Becoming.openSteps xs ys) (fun c => w₁ c.1 * w₂ c.2) fun c =>
