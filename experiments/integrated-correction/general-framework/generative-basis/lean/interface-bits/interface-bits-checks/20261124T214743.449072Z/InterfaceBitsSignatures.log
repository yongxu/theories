@Becoming.InterfaceBits.cc_sandwich : ∀ {V : Type u_1} [Fintype V] (G : Becoming.InterfaceBits.Conf V),
  Becoming.InterfaceBits.chiCC2 G ≤ Becoming.InterfaceBits.chi G ∧
    Becoming.InterfaceBits.chi G ≤ 2 * Becoming.InterfaceBits.chiCC2 G
@Becoming.InterfaceBits.cc_pow_log_gap : ∀ {V : Type u_1} [Fintype V] [Nonempty V] (G : Becoming.InterfaceBits.Conf V)
  {n : ℕ},
  0 < n →
    0 ≤
        Becoming.InterfaceBits.log2 ↑(Becoming.InterfaceBits.chi (Becoming.InterfaceBits.strongPow G n)) / ↑n -
          Becoming.InterfaceBits.log2 ↑(Becoming.InterfaceBits.chiCC2 (Becoming.InterfaceBits.strongPow G n)) / ↑n ∧
      Becoming.InterfaceBits.log2 ↑(Becoming.InterfaceBits.chi (Becoming.InterfaceBits.strongPow G n)) / ↑n -
          Becoming.InterfaceBits.log2 ↑(Becoming.InterfaceBits.chiCC2 (Becoming.InterfaceBits.strongPow G n)) / ↑n ≤
        1 / ↑n
@Becoming.InterfaceBits.indep_strongProd_K2 : ∀ {V : Type u_1} [inst : Fintype V] (G : Becoming.InterfaceBits.Conf V),
  Becoming.InterfaceBits.indepNum (Becoming.InterfaceBits.strongProd G Becoming.InterfaceBits.K2) =
    Becoming.InterfaceBits.indepNum G
@Becoming.InterfaceBits.chi_le_of_equiv : ∀ {U : Type u_1} {V : Type u_2} [Fintype V]
  (G : Becoming.InterfaceBits.Conf U) (H : Becoming.InterfaceBits.Conf V) (e : U ≃ V),
  (∀ (x y : U), G.R x y ↔ H.R (e x) (e y)) → Becoming.InterfaceBits.chi G ≤ Becoming.InterfaceBits.chi H
@Becoming.InterfaceBits.chiK3Free_le_of_equiv : ∀ {U : Type u_1} {V : Type u_2} [Fintype V]
  (G : Becoming.InterfaceBits.Conf U) (H : Becoming.InterfaceBits.Conf V) (e : U ≃ V),
  (∀ (x y : U), G.R x y ↔ H.R (e x) (e y)) → Becoming.InterfaceBits.chiK3Free G ≤ Becoming.InterfaceBits.chiK3Free H
