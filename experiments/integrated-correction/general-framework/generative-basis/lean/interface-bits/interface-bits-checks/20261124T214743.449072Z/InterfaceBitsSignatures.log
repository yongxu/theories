  (∀ (i : Fin k), {v | c v = i}.card ≤ m) → Fintype.card V ≤ k * m
@Becoming.InterfaceBits.indep_strongProd : ∀ {U : Type u_1} {V : Type u_2} {G : Becoming.InterfaceBits.Conf U}
  {H : Becoming.InterfaceBits.Conf V} {A : Finset U} {B : Finset V},
  Becoming.InterfaceBits.IsIndepSet G A →
    Becoming.InterfaceBits.IsIndepSet H B →
      Becoming.InterfaceBits.IsIndepSet (Becoming.InterfaceBits.strongProd G H) (A ×ˢ B)
