Becoming.InterfaceBits.c7SqColor_offsets : ∀ (i j : Fin 7) (d₁ d₂ : Fin 3),
  (d₁, d₂) ≠ (0, 0) →
    Becoming.InterfaceBits.c7SqColorVec i j ≠
      Becoming.InterfaceBits.c7SqColorVec (i + Becoming.InterfaceBits.c7Diffs d₁)
        (j + Becoming.InterfaceBits.c7Diffs d₂)
Becoming.InterfaceBits.c7SqCC2_offsets : ∀ (i j : Fin 7) (a₁ a₂ b₁ b₂ : Fin 3),
  (a₁, a₂) ≠ (0, 0) →
    (b₁, b₂) ≠ (0, 0) →
      (a₁, a₂) ≠ (b₁, b₂) →
        Becoming.InterfaceBits.c7SqCC2Vec (i + Becoming.InterfaceBits.c7Diffs a₁)
              (j + Becoming.InterfaceBits.c7Diffs a₂) =
            Becoming.InterfaceBits.c7SqCC2Vec i j →
          Becoming.InterfaceBits.c7SqCC2Vec (i + Becoming.InterfaceBits.c7Diffs b₁)
                (j + Becoming.InterfaceBits.c7Diffs b₂) =
              Becoming.InterfaceBits.c7SqCC2Vec i j →
            False
