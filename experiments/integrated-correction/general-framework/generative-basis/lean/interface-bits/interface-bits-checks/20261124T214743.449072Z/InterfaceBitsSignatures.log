@Becoming.InterfaceBits.c7Pow_log_rate_le : ∀ {n : ℕ},
  0 < n →
    Becoming.InterfaceBits.log2
          ↑(Becoming.InterfaceBits.chi (Becoming.InterfaceBits.strongPow Becoming.InterfaceBits.C7 n)) /
        ↑n ≤
      1 / 2 * Becoming.InterfaceBits.log2 5 + Becoming.InterfaceBits.log2 3 / ↑n
Becoming.InterfaceBits.powTwo_eq : ∀ (n : ℕ), Becoming.OplaxHistory.powTwo n = 2 ^ n
Becoming.InterfaceBits.c2_collapse_clique : ∀ (n : ℕ),
  Function.Injective (Becoming.InterfaceBits.rep n) ∧
    Becoming.InterfaceBits.IsClique (Becoming.InterfaceBits.strongPow Becoming.InterfaceBits.K2 n)
        (Finset.image (Becoming.InterfaceBits.rep n) Finset.univ) ∧
      (Finset.image (Becoming.InterfaceBits.rep n) Finset.univ).card = 2 ^ n ∧
        ∀ (i j : Fin (Becoming.OplaxHistory.powTwo n)),
          Becoming.OplaxHistory.C2RelativeLossWitness.c2ChainChi n
              (Becoming.OplaxHistory.C2RelativeLossWitness.nthBits n ↑i) =
            Becoming.OplaxHistory.C2RelativeLossWitness.c2ChainChi n
              (Becoming.OplaxHistory.C2RelativeLossWitness.nthBits n ↑j)
