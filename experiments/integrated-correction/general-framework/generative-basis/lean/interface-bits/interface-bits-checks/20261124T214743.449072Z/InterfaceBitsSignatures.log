Becoming.InterfaceBits.c7BitVal_adj : ∀ (a : Fin 7) (x y : Fin 2),
  Becoming.InterfaceBits.C7.R (a + Becoming.InterfaceBits.c7BitVal x) (a + Becoming.InterfaceBits.c7BitVal y)
