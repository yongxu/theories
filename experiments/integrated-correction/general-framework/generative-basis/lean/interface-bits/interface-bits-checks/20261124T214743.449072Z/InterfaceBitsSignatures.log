  {H : Becoming.InterfaceBits.Conf V} {A : Finset U} {B : Finset V},
  Becoming.InterfaceBits.IsClique G A →
    Becoming.InterfaceBits.IsClique H B →
      Becoming.InterfaceBits.IsClique (Becoming.InterfaceBits.strongProd G H) (A ×ˢ B)
@Becoming.InterfaceBits.coloring_strongProd : ∀ {U : Type u_1} {V : Type u_2} {G : Becoming.InterfaceBits.Conf U}
  {H : Becoming.InterfaceBits.Conf V} {k m : ℕ} {c : U → Fin k} {e : V → Fin m},
  Becoming.InterfaceBits.IsColoring G c →
    Becoming.InterfaceBits.IsColoring H e →
      Becoming.InterfaceBits.IsColoring (Becoming.InterfaceBits.strongProd G H) fun p => finProdFinEquiv (c p.1, e p.2)
@Becoming.InterfaceBits.chi_strongProd_le : ∀ {U : Type u_1} {V : Type u_2} [Fintype U] [Fintype V]
  (G : Becoming.InterfaceBits.Conf U) (H : Becoming.InterfaceBits.Conf V),
  Becoming.InterfaceBits.chi (Becoming.InterfaceBits.strongProd G H) ≤
    Becoming.InterfaceBits.chi G * Becoming.InterfaceBits.chi H
@Becoming.InterfaceBits.indep_times_triangleFree : ∀ {U : Type u_1} {V : Type u_2} {G : Becoming.InterfaceBits.Conf U}
  {H : Becoming.InterfaceBits.Conf V} {A : Finset U},
  Becoming.InterfaceBits.IsIndepSet G A →
    (∀ (x y z : V), H.R x y → H.R x z → H.R y z → x = y ∨ x = z ∨ y = z) →
      ∀ {p q r : U × V},
        p.1 ∈ A →
          q.1 ∈ A →
            r.1 ∈ A →
              (Becoming.InterfaceBits.strongProd G H).R p q →
                (Becoming.InterfaceBits.strongProd G H).R p r →
                  (Becoming.InterfaceBits.strongProd G H).R q r → p = q ∨ p = r ∨ q = r
@Becoming.InterfaceBits.k3free_strongProd : ∀ {U : Type u_1} {V : Type u_2} {G : Becoming.InterfaceBits.Conf U}
  {H : Becoming.InterfaceBits.Conf V} {k m : ℕ} {c : U → Fin k} {h : V → Fin m},
  Becoming.InterfaceBits.IsColoring G c →
    Becoming.InterfaceBits.IsK3FreePartition H h →
      Becoming.InterfaceBits.IsK3FreePartition (Becoming.InterfaceBits.strongProd G H) fun p =>
        finProdFinEquiv (c p.1, h p.2)
@Becoming.InterfaceBits.cc2_is_two_colorable : ∀ {V : Type u_1} [Fintype V] {G : Becoming.InterfaceBits.Conf V} {k : ℕ}
  {c : V → Fin k},
