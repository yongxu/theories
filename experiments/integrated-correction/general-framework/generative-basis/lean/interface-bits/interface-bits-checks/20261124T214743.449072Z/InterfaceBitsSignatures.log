  [inst_2 : AddCommGroup V] (A B : Finset V) (m : ℕ),
  (∀ (v : V), {b ∈ B | v + b ∈ A}.card ≤ m) → B.card * A.card ≤ Fintype.card V * m
@Becoming.InterfaceBits.c7_indep_adjacent_bound : ∀ {W : Type u_1} [inst : Fintype W]
  (H : Becoming.InterfaceBits.Conf W) (I : Finset (Fin 7 × W)),
  Becoming.InterfaceBits.IsIndepSet (Becoming.InterfaceBits.strongProd Becoming.InterfaceBits.C7 H) I →
    2 * I.card ≤ 7 * Becoming.InterfaceBits.indepNum H
Becoming.InterfaceBits.c7Pow_k3free_card_bound : ∀ (n : ℕ) {A : Finset (Fin n → Fin 7)},
  (∀ x ∈ A,
      ∀ y ∈ A,
        ∀ z ∈ A,
          (Becoming.InterfaceBits.strongPow Becoming.InterfaceBits.C7 n).R x y →
            (Becoming.InterfaceBits.strongPow Becoming.InterfaceBits.C7 n).R x z →
              (Becoming.InterfaceBits.strongPow Becoming.InterfaceBits.C7 n).R y z → x = y ∨ x = z ∨ y = z) →
    2 ^ n * A.card ≤ 7 ^ n * 2
Becoming.InterfaceBits.c7_indepNum_eq : Becoming.InterfaceBits.indepNum Becoming.InterfaceBits.C7 = 3
