Becoming.InterfaceBits.c7CC2_ok : Becoming.InterfaceBits.IsCC2Partition Becoming.InterfaceBits.C7
  Becoming.InterfaceBits.c7CC2
Becoming.InterfaceBits.c7_triangleFree : ∀ (x y z : Fin 7),
  Becoming.InterfaceBits.C7.R x y →
    Becoming.InterfaceBits.C7.R x z → Becoming.InterfaceBits.C7.R y z → x = y ∨ x = z ∨ y = z
Becoming.InterfaceBits.c7SqPts_nodup : Becoming.InterfaceBits.c7SqPts.Nodup
