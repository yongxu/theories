@Becoming.MachineInstances.encounter_records : ∀ {s : Generative.AcquiredBinding.Lexicon},
  Becoming.MachineInstances.Groups s.percept.log →
    ∀ (b : Bool) (offered : List Generative.CompositionalAcquisition.Expr) (origin : Nat),
      (Generative.AcquiredBinding.encounter (Generative.AcquiredSegmentation.word b) offered origin s).records =
        if 1 ≤ s.percept.machine.support then
          s.records ++ [{ form := Generative.AcquiredSegmentation.word b, offered := offered, origin := origin }]
        else s.records
