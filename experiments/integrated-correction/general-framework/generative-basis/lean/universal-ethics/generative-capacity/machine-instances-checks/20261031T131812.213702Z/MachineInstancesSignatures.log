Becoming.MachineInstances.encounter_support : ∀ (raw : List Generative.AcquiredSegmentation.Sound)
  (offered : List Generative.CompositionalAcquisition.Expr) (origin : Nat) (s : Generative.AcquiredBinding.Lexicon),
  (Generative.AcquiredBinding.encounter raw offered origin s).percept.machine.support = s.percept.machine.support - 1
Becoming.MachineInstances.speak_records : ∀ (offered es : List Generative.CompositionalAcquisition.Expr)
  (s : Generative.AcquiredBinding.Lexicon),
  Becoming.MachineInstances.Groups s.percept.log →
    es.length ≤ s.percept.machine.support →
      (Generative.EncounterChoice.speak es offered s).records =
          s.records ++ Becoming.MachineInstances.namedRecords offered es ∧
        (Generative.EncounterChoice.speak es offered s).percept.log = s.percept.log ∧
          (Generative.EncounterChoice.speak es offered s).repertoire = s.repertoire ∧
            (Generative.EncounterChoice.speak es offered s).excluded = s.excluded
Becoming.MachineInstances.word_eq_iff : ∀ (c b : Bool),
  Generative.AcquiredSegmentation.word c = Generative.AcquiredSegmentation.word b ↔ c = b
Becoming.MachineInstances.stands_named : ∀ (excluded : List Nat),
  ¬0 ∈ excluded →
    ∀ (b : Bool) (offered : List Generative.CompositionalAcquisition.Expr)
      (e : Generative.CompositionalAcquisition.Expr) (es : List Generative.CompositionalAcquisition.Expr),
      Becoming.CrossSituational.stands
          (Becoming.MachineInstances.bearsOn excluded (Generative.AcquiredSegmentation.word b))
          Becoming.MachineInstances.offersOf (Becoming.MachineInstances.namedRecords offered es) e =
        (!decide (Generative.CompositionalAcquisition.Expr.atom b ∈ es) || decide (e ∈ offered))
@Becoming.MachineInstances.naming_narrows : ∀ {s : Generative.AcquiredBinding.Lexicon},
  Becoming.MachineInstances.Groups s.percept.log →
    ¬0 ∈ s.excluded →
      ∀ {offered : List Generative.CompositionalAcquisition.Expr},
        offered.length ≤ s.percept.machine.support →
          ∀ (b : Bool),
            Generative.AcquiredBinding.candidates (Generative.EncounterChoice.speak offered offered s)
                (Generative.AcquiredSegmentation.word b) =
              if Generative.CompositionalAcquisition.Expr.atom b ∈ offered then
                List.filter (fun e => decide (e ∈ offered))
                  (Generative.AcquiredBinding.candidates s (Generative.AcquiredSegmentation.word b))
              else Generative.AcquiredBinding.candidates s (Generative.AcquiredSegmentation.word b)
Becoming.MachineInstances.local_naming_narrows : ∀ (a : Generative.EncounterChoice.Activity),
  Becoming.MachineInstances.Groups a.situation.lexicon.percept.log →
    ¬0 ∈ a.situation.lexicon.excluded →
      (Generative.EnactedScene.visible a.situation).length ≤ a.situation.lexicon.percept.machine.support →
        ∀ (b : Bool),
          Generative.AcquiredBinding.candidates (Generative.EncounterChoice.localNaming a).situation.lexicon
              (Generative.AcquiredSegmentation.word b) =
            if Generative.CompositionalAcquisition.Expr.atom b ∈ Generative.EnactedScene.visible a.situation then
              List.filter (fun e => decide (e ∈ Generative.EnactedScene.visible a.situation))
                (Generative.AcquiredBinding.candidates a.situation.lexicon (Generative.AcquiredSegmentation.word b))
            else Generative.AcquiredBinding.candidates a.situation.lexicon (Generative.AcquiredSegmentation.word b)
Becoming.MachineInstances.acquired_repertoire : (Generative.EncounterChoice.acquired 51).situation.lexicon.repertoire =
  [Generative.CompositionalAcquisition.p0, Generative.CompositionalAcquisition.p1, Generative.AcquiredBinding.extra]
Becoming.MachineInstances.acquired_distinct : Becoming.Distinct
  (Generative.EncounterChoice.acquired 51).situation.lexicon.repertoire
Becoming.MachineInstances.acquired_separated : ∀ (b : Bool),
  Becoming.MachineInstances.Separated (Generative.EncounterChoice.acquired 51).situation.lexicon.repertoire
    (Generative.EncounterChoice.acquired 51).situation.lexicon.excluded
    (Generative.EncounterChoice.acquired 51).situation.lexicon.records b
Becoming.MachineInstances.acquired_from_separation : ∀ (ws : List Bool),
  Generative.AcquiredBinding.interpret (Generative.EncounterChoice.acquired 51).situation.lexicon
      (Generative.AcquiredSegmentation.encode ws) =
    Generative.AcquiredSegmentation.assembleMessage (List.map Generative.CompositionalAcquisition.Expr.atom ws)
Becoming.MachineInstances.mem_alternatives : ∀ (rs : List Generative.SourceReliance.Route)
  (faults : List Generative.SourceReliance.Faults) (reports : Generative.SourceReliance.Reports)
  (e : Generative.CompositionalAcquisition.Expr),
  e ∈ Generative.RetrospectiveBinding.alternatives rs faults reports ↔
    ∃ w,
      (w.route ∈ rs ∧ w.faults ∈ faults) ∧
        Generative.CompositionalAcquisition.Expr.atom w.target = e ∧ Generative.SourceReliance.view w = reports
Becoming.MachineInstances.view_candidates : ∀ (s : Generative.RetrospectiveBinding.Memory)
  (faults : List Generative.SourceReliance.Faults) (form : List Generative.AcquiredSegmentation.Sound),
  Generative.AcquiredBinding.candidates (Generative.RetrospectiveBinding.bindingView s faults) form =
    Becoming.CrossSituational.candidates (fun p => decide (p.form = form))
      (fun p e =>
        decide
          (e ∈
            Generative.RetrospectiveBinding.alternatives (Generative.RetrospectiveBinding.routes s) faults p.reports))
      s.base.repertoire s.packets
Becoming.MachineInstances.retrospective_resolves_iff : ∀ (s : Generative.RetrospectiveBinding.Memory)
  (faults : List Generative.SourceReliance.Faults),
  Becoming.Distinct s.base.repertoire →
    ∀ (form : List Generative.AcquiredSegmentation.Sound) (b : Bool),
      Generative.CompositionalAcquisition.Expr.atom b ∈ s.base.repertoire →
        (∀ (p : Generative.RetrospectiveBinding.Packet),
            p ∈ s.packets →
              p.form = form →
                ∃ w,
                  (w.route ∈ Generative.RetrospectiveBinding.routes s ∧ w.faults ∈ faults) ∧
                    w.target = b ∧ Generative.SourceReliance.view w = p.reports) →
          (Generative.AcquiredBinding.resolve (Generative.RetrospectiveBinding.bindingView s faults) form =
              some (Generative.CompositionalAcquisition.Expr.atom b) ↔
            ∀ (m : Generative.CompositionalAcquisition.Expr),
              m ∈ s.base.repertoire →
                m ≠ Generative.CompositionalAcquisition.Expr.atom b →
                  ∃ p,
                    p ∈ s.packets ∧
                      p.form = form ∧
                        ∀ (w : Generative.SourceReliance.World),
                          w.route ∈ Generative.RetrospectiveBinding.routes s ∧ w.faults ∈ faults →
                            Generative.CompositionalAcquisition.Expr.atom w.target = m →
                              Generative.SourceReliance.view w ≠ p.reports)
Becoming.MachineInstances.produced_of_calibration : ∀ (s : Generative.RetrospectiveBinding.Memory)
  (r : Generative.SourceReliance.Route) (reversed : Bool) (ps : List Generative.SourceReliance.Probe)
  (faults : List Generative.SourceReliance.Faults) (form : List Generative.AcquiredSegmentation.Sound) (target : Bool),
  s.calibration = Generative.SourceReliance.acquire r reversed ps →
    (∀ (p : Generative.RetrospectiveBinding.Packet),
        p ∈ s.packets →
          p.form = form →
            ∃ f,
              f ∈ faults ∧
                p.reports =
                  Generative.SourceReliance.emit r { target := target, localFault := f.fst, commonFault := f.snd }) →
      ∀ (p : Generative.RetrospectiveBinding.Packet),
        p ∈ s.packets →
          p.form = form →
            ∃ w,
              (w.route ∈ Generative.RetrospectiveBinding.routes s ∧ w.faults ∈ faults) ∧
                w.target = target ∧ Generative.SourceReliance.view w = p.reports
Becoming.MachineInstances.coverage_from_law : ∀ (s : Generative.RetrospectiveBinding.Memory)
  (r : Generative.SourceReliance.Route) (reversed : Bool) (ps : List Generative.SourceReliance.Probe)
  (faults : List Generative.SourceReliance.Faults) (form : List Generative.AcquiredSegmentation.Sound) (target : Bool)
  (answer : Generative.CompositionalAcquisition.Expr),
  s.calibration = Generative.SourceReliance.acquire r reversed ps →
    Generative.CompositionalAcquisition.Expr.atom target ∈ s.base.repertoire →
      (∀ (p : Generative.RetrospectiveBinding.Packet),
          p ∈ s.packets →
            p.form = form →
              ∃ f,
                f ∈ faults ∧
                  p.reports =
                    Generative.SourceReliance.emit r { target := target, localFault := f.fst, commonFault := f.snd }) →
        Generative.AcquiredBinding.resolve (Generative.RetrospectiveBinding.bindingView s faults) form = some answer →
          answer = Generative.CompositionalAcquisition.Expr.atom target
Becoming.MachineInstances.retrospective_repertoire : (Generative.RetrospectiveBinding.bindingView
      (Generative.RetrospectiveBinding.retrospective 36) Generative.SourceReliance.allFaults).repertoire =
  [Generative.CompositionalAcquisition.p0, Generative.CompositionalAcquisition.p1, Generative.AcquiredBinding.extra]
Becoming.MachineInstances.retrospective_distinct : Becoming.Distinct
  (Generative.RetrospectiveBinding.bindingView (Generative.RetrospectiveBinding.retrospective 36)
      Generative.SourceReliance.allFaults).repertoire
Becoming.MachineInstances.retrospective_separated : ∀ (b : Bool),
  Becoming.MachineInstances.Separated
    (Generative.RetrospectiveBinding.bindingView (Generative.RetrospectiveBinding.retrospective 36)
        Generative.SourceReliance.allFaults).repertoire
    (Generative.RetrospectiveBinding.bindingView (Generative.RetrospectiveBinding.retrospective 36)
        Generative.SourceReliance.allFaults).excluded
    (Generative.RetrospectiveBinding.bindingView (Generative.RetrospectiveBinding.retrospective 36)
        Generative.SourceReliance.allFaults).records
    b
Becoming.MachineInstances.retrospective_from_separation : ∀ (ws : List Bool),
  Generative.AcquiredBinding.interpret
      (Generative.RetrospectiveBinding.bindingView (Generative.RetrospectiveBinding.retrospective 36)
        Generative.SourceReliance.allFaults)
      (Generative.AcquiredSegmentation.encode ws) =
    Generative.AcquiredSegmentation.assembleMessage (List.map Generative.CompositionalAcquisition.Expr.atom ws)
Becoming.MachineInstances.changed_route_unproduced : ¬Generative.CompositionalAcquisition.Expr.atom true ∈
    Generative.RetrospectiveBinding.alternatives
      (Generative.RetrospectiveBinding.routes Generative.RetrospectiveBinding.changedRouteHistory)
      Generative.SourceReliance.allFaults
      (Generative.SourceReliance.emit { copiesFirst := false, sharesDisturbance := true }
        { target := true, localFault := false, commonFault := true })
Becoming.MachineInstances.better_iff : ∀ (c : GoalFormationRevision.Conditions),
  PracticalJudgment.Better (GoalFormationRevision.protects c) (GoalFormationRevision.gains c)
      GoalFormationRevision.Practice.learning GoalFormationRevision.Practice.attendance ↔
    c.accessLoss = true ∧ c.transitionLoss = false
Becoming.MachineInstances.completed_iff_better : ∀ (c : GoalFormationRevision.Conditions),
  (GoalFormationRevision.completed c).isSome = true ↔
    PracticalJudgment.Better (GoalFormationRevision.protects c) (GoalFormationRevision.gains c)
      GoalFormationRevision.Practice.learning GoalFormationRevision.Practice.attendance
Becoming.MachineInstances.apply_false : ∀ (m : Bool), JointPracticeContinuation.applyMethod m false = m
Becoming.MachineInstances.infer_false : ∀ (m : Bool), JointPracticeContinuation.inferMethod false m = m
Becoming.MachineInstances.round_iff : ∀ (s t : JointPracticeContinuation.State) (r w : Nat),
  JointPracticeContinuation.run s (JointPracticeContinuation.practice r w) = some t ↔
    (w ∈ s.org.present ∧
        r ∈ s.org.roster ∧ r ∈ s.org.present ∧ r ≠ w ∧ JointPracticeContinuation.methodAt s r = s.context) ∧
      t = Becoming.MachineInstances.afterRound s r w
@Becoming.MachineInstances.round_trains : ∀ {s t : JointPracticeContinuation.State} {r w : Nat},
  JointPracticeContinuation.run s (JointPracticeContinuation.practice r w) = some t →
    JointPracticeContinuation.methodAt t w = t.context
Becoming.MachineInstances.trained_round_iff : ∀ (u x : JointPracticeContinuation.State) (w v : Nat),
  JointPracticeContinuation.methodAt u w = u.context →
    (JointPracticeContinuation.run u (JointPracticeContinuation.practice w v) = some x ↔
      (v ∈ u.org.present ∧ w ∈ u.org.roster ∧ w ∈ u.org.present ∧ w ≠ v) ∧
        x = Becoming.MachineInstances.afterRound u w v)
@Becoming.MachineInstances.trained_along : ∀ {s t : JointPracticeContinuation.State}
  {es : List JointPracticeContinuation.Event} {w : Nat},
  Generative.Trace JointPracticeContinuation.process s es t →
    (∀ (e : JointPracticeContinuation.Event), e ∈ es → Becoming.MachineInstances.revises e = false) →
      t.context = s.context →
        JointPracticeContinuation.methodAt s w = s.context → JointPracticeContinuation.methodAt t w = t.context
Becoming.MachineInstances.complete_history_rounds : JointPracticeContinuation.run JointPracticeContinuation.initial
      (JointPracticeContinuation.practice 0 1) =
    some (Becoming.MachineInstances.afterRound JointPracticeContinuation.initial 0 1) ∧
  JointPracticeContinuation.run JointPracticeContinuation.first (JointPracticeContinuation.practice 1 2) =
      some (Becoming.MachineInstances.afterRound JointPracticeContinuation.first 1 2) ∧
    JointPracticeContinuation.run
        (JointPracticeContinuation.after JointPracticeContinuation.second
          [JointPracticeContinuation.Event.organizational
              (OrganizationalRuleInheritance.Event.handoff [1, 2, 3, 4, 5])])
        (JointPracticeContinuation.practice 1 3) =
      some
        (Becoming.MachineInstances.afterRound
          (JointPracticeContinuation.after JointPracticeContinuation.second
            [JointPracticeContinuation.Event.organizational
                (OrganizationalRuleInheritance.Event.handoff [1, 2, 3, 4, 5])])
          1 3)
