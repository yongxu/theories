@Becoming.ProtocolInstances.mediated_history_cons : ∀ {e : MediatedControl.Event} {s m t : MediatedControl.Machine},
  Becoming.ProtocolInstances.mediated.step s e m → MediatedControl.History m t → MediatedControl.History s t
@Becoming.ProtocolInstances.mediated_history_iff : ∀ {s t : MediatedControl.Machine},
  MediatedControl.History s t ↔ Becoming.Reach Becoming.ProtocolInstances.mediated s t
Becoming.ProtocolInstances.coverage_along : ∀ (s t : MediatedControl.Machine),
  Becoming.Reach Becoming.ProtocolInstances.mediated s t →
    TemporalInspection.Known s.tracked → TemporalInspection.Known t.tracked
@Becoming.ProtocolInstances.mediated_history_instance : ∀ {s t : MediatedControl.Machine},
  MediatedControl.History s t → TemporalInspection.Known s.tracked → TemporalInspection.Known t.tracked
@Becoming.ProtocolInstances.recoverable_history_cons : ∀ {e : RecoverableControl.Event}
  {s m t : RecoverableControl.Device},
  Becoming.ProtocolInstances.recoverable.step s e m → RecoverableControl.History m t → RecoverableControl.History s t
@Becoming.ProtocolInstances.recoverable_history_iff : ∀ {s t : RecoverableControl.Device},
  RecoverableControl.History s t ↔ Becoming.Reach Becoming.ProtocolInstances.recoverable s t
Becoming.ProtocolInstances.safety_along : ∀ (s t : RecoverableControl.Device),
  Becoming.Reach Becoming.ProtocolInstances.recoverable s t → RecoverableControl.Safe s → RecoverableControl.Safe t
@Becoming.ProtocolInstances.interrupted_history_instance : ∀ {s t : RecoverableControl.Device},
  RecoverableControl.History s t → RecoverableControl.Safe s → RecoverableControl.Safe t
Becoming.ProtocolInstances.unit_drawn : ∀ (r : RecoverableControl.Pending),
  1 ≤ r.target.tracked.installation.state.reserve →
    r.target.tracked.installation.state.time + 1 ≤ r.target.tracked.installation.state.deadline →
      RecoverableControl.charge r = some (Becoming.ProtocolInstances.afterUnit r)
Becoming.ProtocolInstances.stalls_unsupported : ∀ (r : RecoverableControl.Pending),
  min r.target.tracked.installation.state.reserve
        (r.target.tracked.installation.state.deadline - r.target.tracked.installation.state.time) =
      0 →
    RecoverableControl.charge r = none
Becoming.ProtocolInstances.counts : Becoming.Countdown.CountedWork RecoverableControl.tick
  Becoming.ProtocolInstances.busy Becoming.ProtocolInstances.done Becoming.ProtocolInstances.work
  Becoming.ProtocolInstances.fuel
Becoming.ProtocolInstances.resumeSteps_eq : ∀ (n : Nat) (d : RecoverableControl.Device),
  RecoverableControl.resumeSteps n d = Becoming.Countdown.ticks RecoverableControl.tick n d
Becoming.ProtocolInstances.publishes_iff : ∀ (r : RecoverableControl.Pending),
  (∃ m,
      RecoverableControl.resumeSteps (r.todo.length + 1) (RecoverableControl.Device.busy r) =
        some (RecoverableControl.Device.ready m)) ↔
    r.todo.length + 1 ≤ r.target.tracked.installation.state.reserve ∧
      r.target.tracked.installation.state.time + r.todo.length + 1 ≤ r.target.tracked.installation.state.deadline
Becoming.ProtocolInstances.pending_until_published : ∀ (r : RecoverableControl.Pending) {k : Nat}
  {d : RecoverableControl.Device},
  k ≤ r.todo.length →
    RecoverableControl.resumeSteps k (RecoverableControl.Device.busy r) = some d →
      Becoming.ProtocolInstances.busy d ∧ Becoming.ProtocolInstances.work d + k = r.todo.length
Becoming.ProtocolInstances.reserved : ∀ (g : ReservedShutdown.Grant) (bound : Nat),
  Becoming.Countdown.Reserved (fun s a => ReservedShutdown.cycle a s) (ReservedShutdown.admissible bound)
    (Becoming.ProtocolInstances.valid g bound) Becoming.ProtocolInstances.exit Becoming.ProtocolInstances.margin
Becoming.ProtocolInstances.run_eq : ∀ (events : List ReservedShutdown.Attempt) (s : ReservedShutdown.Supervisor),
  ReservedShutdown.run events s = Becoming.Assurance.runPartial (fun s a => ReservedShutdown.cycle a s) s events
Becoming.ProtocolInstances.schedule_valid : ∀ (g : ReservedShutdown.Grant) (bound : Nat)
  (d : RecoverableControl.Device),
  ReservedShutdown.Armed g d →
    ∀ (events : List ReservedShutdown.Attempt),
      (∀ (a : ReservedShutdown.Attempt), a ∈ events → ReservedShutdown.admissible bound a) →
        ∃ s,
          ReservedShutdown.run events (ReservedShutdown.Supervisor.active g bound d) = some s ∧
            Becoming.ProtocolInstances.valid g bound s
Becoming.ProtocolInstances.schedule_stops : ∀ (g : ReservedShutdown.Grant) (bound : Nat)
  (d : RecoverableControl.Device),
  ReservedShutdown.Armed g d →
    ∀ (events : List ReservedShutdown.Attempt),
      (∀ (a : ReservedShutdown.Attempt), a ∈ events → ReservedShutdown.admissible bound a) →
        (ReservedShutdown.state d).reserve - 3 < events.length →
          ∃ out,
            ReservedShutdown.run events (ReservedShutdown.Supervisor.active g bound d) =
                some (ReservedShutdown.Supervisor.stopped out) ∧
              RecoverableControl.Safe out ∧ ReservedShutdown.Stopped out
Becoming.ProtocolInstances.supported_schedule_instance : ∀ (events : List ReservedShutdown.Attempt)
  (g : ReservedShutdown.Grant) (bound : Nat) (d : RecoverableControl.Device),
  ReservedShutdown.Armed g d →
    (∀ (a : ReservedShutdown.Attempt), a ∈ events → ReservedShutdown.admissible bound a) →
      (ReservedShutdown.state d).reserve ≤ events.length + 2 →
        ∃ out,
          ReservedShutdown.run events (ReservedShutdown.Supervisor.active g bound d) =
              some (ReservedShutdown.Supervisor.stopped out) ∧
            RecoverableControl.Safe out ∧ ReservedShutdown.Stopped out
