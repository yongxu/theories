@Becoming.IdealsCorrespondence.finiteOnly_wordIdeal_iff : ∀ {A : Type u_1}
  (J : Becoming.Ideals.Ideal (Becoming.HistoryIdeals.prefixOrder A)),
  CompletionWarrant.HistoryIdeals.FiniteOnly (Becoming.IdealsCorrespondence.wordIdeal J) ↔
