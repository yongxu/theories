@Becoming.IdealsCorrespondence.trace_wordIdeal_iff : ∀ {A : Type u_1}
  (J : Becoming.Ideals.Ideal (Becoming.HistoryIdeals.prefixOrder A)) (a : Nat → A),
  Becoming.IdealsCorrespondence.wordIdeal J = CompletionWarrant.HistoryIdeals.traceIdeal a ↔
    J.Same (Becoming.HistoryIdeals.traceIdeal a)
@Becoming.IdealsCorrespondence.propertyClass_wordIdeal_iff : ∀ {A : Type u_1} (K : (Nat → A) → Prop)
  (J : Becoming.Ideals.Ideal (Becoming.HistoryIdeals.prefixOrder A)),
