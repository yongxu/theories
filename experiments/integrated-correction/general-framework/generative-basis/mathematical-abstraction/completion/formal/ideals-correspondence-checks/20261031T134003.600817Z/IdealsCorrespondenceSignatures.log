  (Becoming.IdealsCorrespondence.listIdeal (CompletionWarrant.HistoryIdeals.historyIdeal h)).Same
    (Becoming.HistoryIdeals.historyIdeal (Becoming.IdealsCorrespondence.ofHistory h))
@Becoming.IdealsCorrespondence.settles_of_bounded : ∀ {A : Type u_1}
  (I : Becoming.Ideals.Ideal (Becoming.HistoryIdeals.prefixOrder A)) (n : Nat),
  (∀ (w : List A), I.mem w → w.length ≤ n) → Becoming.HistoryIdeals.HasLongest I
@Becoming.IdealsCorrespondence.decided_classical : ∀ {A : Type u_1}
  (I : Becoming.Ideals.Ideal (Becoming.HistoryIdeals.prefixOrder A)),
  Becoming.HistoryIdeals.HasLongest I ∨ ∃ pick, (∀ (n : Nat), I.mem (pick n)) ∧ ∀ (n : Nat), n < (pick n).length
@Becoming.IdealsCorrespondence.ideal_classification_by_core : ∀ {A : Type u_1}
  (I : CompletionWarrant.Ideal CompletionWarrant.HistoryIdeals.wordPoset),
  (∃ w, I = CompletionWarrant.principal CompletionWarrant.HistoryIdeals.wordPoset w) ∨
    ∃ a, I = CompletionWarrant.HistoryIdeals.traceIdeal a
@Becoming.IdealsCorrespondence.historyPrefix_iff : ∀ {A : Type u_1} (h k : CompletionWarrant.HistoryIdeals.History A),
  Becoming.HistoryIdeals.HistoryPrefix (Becoming.IdealsCorrespondence.ofHistory h)
      (Becoming.IdealsCorrespondence.ofHistory k) ↔
    CompletionWarrant.HistoryIdeals.HistoryPrefix h k
@Becoming.IdealsCorrespondence.history_order_iff_by_core : ∀ {A : Type u_1}
  (h k : CompletionWarrant.HistoryIdeals.History A),
  (CompletionWarrant.HistoryIdeals.historyIdeal h).LE (CompletionWarrant.HistoryIdeals.historyIdeal k) ↔
    CompletionWarrant.HistoryIdeals.HistoryPrefix h k
@Becoming.IdealsCorrespondence.historyIdeal_injective_by_core : ∀ {A : Type u_1}
  {h k : CompletionWarrant.HistoryIdeals.History A},
  CompletionWarrant.HistoryIdeals.historyIdeal h = CompletionWarrant.HistoryIdeals.historyIdeal k → h = k
@Becoming.IdealsCorrespondence.refutable_of_wordIdeal : ∀ {A : Type u_1}
  {C : CompletionWarrant.Ideal CompletionWarrant.HistoryIdeals.wordPoset → Prop}
  {C' : Becoming.Ideals.Ideal (Becoming.HistoryIdeals.prefixOrder A) → Prop},
  (∀ (J : Becoming.Ideals.Ideal (Becoming.HistoryIdeals.prefixOrder A)),
      C (Becoming.IdealsCorrespondence.wordIdeal J) ↔ C' J) →
