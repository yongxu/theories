  "premises": {
    "about": "K3. Each premise a central statement may use, the pattern that finds it in a statement, and its witnesses: declarations exhibiting worlds or models that meet it and fail it. A premise with no witnesses listed is reported. A logical premise (kind logical: decidedness) is one no world can be shown to fail, since no proposition is refuted to be decided; it lists instead a witness meeting it (meets), the proof that it is never refuted (unrefuted), and a calibration: what asking it of every case amounts to (calibration).",
    "items": [
      {
        "name": "balance",
        "pattern": "Flow\\.Balances(On)?\\b|World\\.Balanced|\\bBalances(On)?\\b",
        "witnesses": [
          "Becoming.World.contingent",
          "Becoming.World.independent"
        ]
      },
      {
        "name": "dissipation",
        "pattern": "\\bDissipative\\b|\\bDissipatesOn\\b",
        "witnesses": [
          "Becoming.World.contingent",
          "Becoming.World.independent"
        ]
      },
      {
