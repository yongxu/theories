      {
        "name": "decided",
        "pattern": "\\bDecidable(Eq)?\\b",
        "witnesses": [],
        "note": "a count exists exactly where what it counts is decided (counts_iff_decided); over a finite stretch whatever is decided at each step is decided (meets); no proposition is refuted to be decided, so no world fails it (unrefuted); asked of every run, settling or going on is exactly LPO (calibration)",
        "kind": "logical",
        "meets": [
          "Becoming.Decided.exists_below"
        ],
        "unrefuted": [
          "Becoming.not_not_decided"
        ],
        "calibration": [
          "Becoming.HistoryIdeals.cut_decided_iff_lpo"
