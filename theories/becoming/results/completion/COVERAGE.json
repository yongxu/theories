        "pattern": "\\bDependent\\b",
        "witnesses": [
          "Becoming.World.contingent",
          "Becoming.World.independent"
        ]
      },
      {
        "name": "only active relata give",
        "pattern": "\\bActing\\b",
        "witnesses": [
          "Becoming.World.contingent",
          "Becoming.World.independent"
        ]
      },
      {
        "name": "only active relata take",
        "pattern": "\\bTaking\\b",
