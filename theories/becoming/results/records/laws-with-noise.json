{
  "schema_version": 2,
  "id": "laws-with-noise",
  "title": {
    "en": "Laws with noise: path by path, and in expectation",
    "zh": "带噪声的规律：逐路径与取期望"
  },
  "kind": "theorem",
  "status": "recorded-checked",
  "family": "F01",
  "reviewed_at_utc": "2026-10-22T15:13:45+00:00",
  "statement": {
    "en": "A law of exchange with noise is a relation of exchange, every realization's course a run of it, so the laws hold path by path; balance passes to the expectation, and rest does not.",
    "zh": "带噪声的交换之律是交换关系，每个实现的进程是其运行，所以规律逐路径成立；平衡传到期望，停息则不然。"
  },
  "laws": [
    {
      "en": "A law with noise is the relation of exchange opening what some noise value gives; along every realization its course is a run, and the world read off it a world read off a relation of exchange.",
      "zh": "带噪声的律是打开某个噪声值所给者的交换关系；沿每个实现，其进程是运行，从它读出的世界是从交换关系读出的世界。",
      "declarations": [
        "Becoming.NoisyLaw",
        "Becoming.NoisyLaw.course_runs",
        "Becoming.NoisyLaw.readOffExchange",
        "Becoming.NoisyLaw.realize",
        "Becoming.NoisyLaw.relation"
      ]
    },
    {
      "en": "Balance holds in expectation over any distribution of the noise with integrable amounts; a condition ending at a random step rests along every realization while its expected level falls at every step.",
      "zh": "对噪声的任何分布、量可积时，平衡在期望上成立；在随机一步终结的条件沿每个实现停息，而其期望水平每步都下降。",
      "declarations": [
        "Becoming.Representation.RandomEnd.expected",
        "Becoming.Representation.RandomEnd.level",
        "Becoming.Representation.RandomEnd.rest_not_in_expectation",
        "Becoming.Representation.RandomEnd.rests",
        "Becoming.Representation.RandomEnd.summable_weighted",
        "Becoming.Representation.RandomEnd.weight",
        "Becoming.Representation.expected_balance"
      ]
    }
  ],
  "hypotheses": [
    {
      "en": "No premise in the core declarations; the periphery uses Lean's standard axioms through Mathlib and names integrability where it enters.",
      "zh": "核心声明不加前提；外围经 Mathlib 使用 Lean 的标准公理，可积性在其进入处写明。"
    }
  ],
  "does_not_show": [
    {
      "en": "Laws reading a distribution of exchanges rather than a realization; that an actual noise is a value read at each step.",
      "zh": "读交换之分布而非某一实现的规律；实际噪声是每步读取的一个值。",
      "kind": "scope"
    }
  ],
  "counterexamples": [
