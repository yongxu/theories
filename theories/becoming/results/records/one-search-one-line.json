  "statement": {
    "en": "On three lines, a line is the sole one differing from the others exactly where the three are 乾 or 坤 with the line at that height turned: 震, 坎, 艮 are 坤 searched at the bottom, middle and top, and 巽, 離, 兌 乾 so searched.",
    "zh": "三线之上，一线独异恰在其为乾或坤在该高度变一线之时：震、坎、艮为坤之一索、再索、三索，巽、离、兑为乾之。"
  },
  "laws": [
    {
      "en": "Turning the line at a height of three, and the sole line at that height, are defined; at each height the line is sole exactly where the three are 乾 or 坤 so turned, and the six searched trigrams are 震, 坎, 艮, 巽, 離, 兌.",
      "zh": "定义三线中在一高度变线与在该高度之独异之线；每一高度上该线独异恰在其为乾或坤如此变之时，六个所索之卦为震、坎、艮、巽、离、兑。",
      "declarations": [
        "Becoming.Hexagram.Trigram.flip3",
        "Becoming.Hexagram.Trigram.soleAt",
        "Becoming.Hexagram.Trigram.sole_iff_searched",
        "Becoming.Hexagram.Trigram.searched"
      ]
    }
  ],
  "hypotheses": [
    {
      "en": "No axiom; trigrams as triples of Boolean lines, bottom first.",
      "zh": "不加公理；三画卦为三个布尔之线，自下而上。"
    }
  ],
