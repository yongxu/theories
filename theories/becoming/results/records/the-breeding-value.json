{
  "schema_version": 2,
  "id": "the-breeding-value",
  "title": {
    "en": "The breeding value",
    "zh": "育种值"
  },
  "kind": "theorem",
  "status": "recorded-checked",
  "family": "F01",
  "reviewed_at_utc": "2026-10-22T14:52:46+00:00",
  "statement": {
    "en": "An amount combining carried amounts that reproduces offspring number's covariation with each has its covariation with offspring number equal to its own spread, at most the whole; with exact transmission its mean rises by that spread: Fisher's fundamental theorem with breeding values.",
    "zh": "组合所载之量、与每一量的协变同于后代数的量，其与后代数的协变等于其自身离散，至多为全部；传递精确时其均值以该离散上升：以育种值陈述的 Fisher 基本定理。"
  },
  "laws": [
    {
      "en": "The counted covariance is linear in the amount: sums, multiples and a common shift, and so any two-sided combination of carried amounts with natural coefficients.",
      "zh": "计数协方差对该量是线性的：和、倍数与共同平移，故对所载之量以自然数系数的两侧组合亦然。",
      "declarations": [
        "Becoming.Reproduction.Breeding.covPair",
        "Becoming.Reproduction.Breeding.covPair_same",
        "Becoming.Reproduction.Breeding.covPair_congr",
        "Becoming.Reproduction.Breeding.covariance_add",
        "Becoming.Reproduction.Breeding.covPair_add",
        "Becoming.Reproduction.Breeding.excess_mul",
        "Becoming.Reproduction.Breeding.concord_mul",
        "Becoming.Reproduction.Breeding.discord_mul",
        "Becoming.Reproduction.Breeding.covPair_mul",
        "Becoming.Reproduction.Breeding.covPair_const",
        "Becoming.Reproduction.Breeding.combine",
        "Becoming.Reproduction.Breeding.combined",
        "Becoming.Reproduction.Breeding.covPair_combine"
      ]
    },
    {
      "en": "A breeding value, a combination reproducing d times offspring number's covariation with each carried amount, has d times its covariation with offspring number equal to its own spread, at most d squared times offspring number's.",
      "zh": "育种值，即与每一所载之量的协变为后代数之 d 倍的组合，d 乘其与后代数的协变等于其自身离散，至多为后代数离散的 d 平方倍。",
      "declarations": [
        "Becoming.Reproduction.Breeding.Combination",
        "Becoming.Reproduction.Breeding.Normal",
        "Becoming.Reproduction.Breeding.covPair_combination",
        "Becoming.Reproduction.Breeding.combined_normal",
        "Becoming.Reproduction.Breeding.breeding_balance",
        "Becoming.Reproduction.Breeding.additive_part_le",
        "Becoming.Reproduction.Breeding.normal_append",
        "Becoming.Reproduction.Breeding.one_amount"
      ]
    },
    {
      "en": "With exact transmission, d times the cross-multiplied rise of its mean is that spread: it never falls and rises exactly where it varies. Fisher's fundamental theorem with breeding values.",
      "zh": "传递精确时，d 乘其均值交叉相乘的上升即该离散：从不下降，恰在其有差异时上升。以育种值陈述的 Fisher 基本定理。",
      "declarations": [
        "Becoming.Reproduction.Breeding.response",
        "Becoming.Reproduction.Breeding.response_rises_iff"
      ]
    },
    {
      "en": "Witnesses: offspring number additive in two amounts, the additive part the whole; offspring number their product, a part no combination carries (32 against 48).",
      "zh": "见证：后代数在两量上可加时，加性部分即全部；后代数为其乘积时，留下任何组合都不携带的部分（32 对 48）。",
      "declarations": [
        "Becoming.Reproduction.Additive.normal",
        "Becoming.Reproduction.Additive.additive",
        "Becoming.Reproduction.Interaction.normal",
        "Becoming.Reproduction.Interaction.interaction"
      ]
    }
  ],
  "hypotheses": [
    {
      "en": "No axiom. The breeding value is given as a combination with natural coefficients on each side satisfying the normal equations scaled by d; exact transmission for the response.",
      "zh": "不加公理。育种值作为两侧自然数系数的组合给出，满足乘以 d 的正规方程；响应需传递精确。"
    }
  ],
  "does_not_show": [
    {
      "en": "That the normal equations have such a solution: solving them is given.",
      "zh": "正规方程有此种解：其求解是给定的。",
      "kind": "scope"
    },
    {
      "en": "Inexact transmission of the breeding value, where Fisher's environment term enters.",
      "zh": "育种值不精确的传递，即 Fisher 的环境项进入之处。",
      "kind": "scope"
    },
    {
      "en": "That a larger additive part is better: the counts read spreads; ranking goes through the comparison C.",
      "zh": "加性部分更大更好：计数读的是离散；排序经由比较 C。",
      "kind": "non-implication"
    }
  ],
  "counterexamples": [
